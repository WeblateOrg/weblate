msgid "Extended list of options for import_project."
msgstr "Utökad lista över alternativ för import_project."

msgid "Improved targeting for whiteboard messages."
msgstr "Förbättrad inriktning för whiteboardmeddelanden."

msgid "Support for automatic translation across projects."
msgstr "Stöd för automatisk översättning mellan projekt."

msgid "Optimized fulltext search index."
msgstr "Optimerat index för fulltextsökning."

msgid "Added management command for auto translation."
msgstr "Lagt till kommando för automatisk översättning."

msgid "Added placeables highlighting."
msgstr "Lagt till markering av placerbara objekt."

msgid ""
"Added keyboard shortcuts for placeables, checks and machine translations."
msgstr ""
"Lagt till kortkommandon för placerbara objekt, kontroller och "
