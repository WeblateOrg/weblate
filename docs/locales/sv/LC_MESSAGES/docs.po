msgstr "Lagt till XLIFF- och gettext PO-export för alla översättningar."

msgid "Added support for configurable automatic group assignments."
msgstr "Lagt till stöd för konfigurerbara automatiska grupptilldelningar."

msgid "Improved adding of new translations."
msgstr "Förbättrad tillägg av nya översättningar."

msgid "Weblate 2.4"
msgstr "Weblate 2.4"

msgid "*Released on Sep 20th 2015.*"
msgstr "*Släppt den 20 september 2015.*"

msgid "Improved support for PHP files."
msgstr "Förbättrat stöd för PHP-filer."

msgid "Ability to add ACL to anonymous user."
msgstr "Möjlighet att lägga till ACL till anonym användare."

msgid "Improved configurability of import_project command."
msgstr "Förbättrad konfigurerbarhet för kommandot import_project."

msgid "Added CSV dump of history."
msgstr "Lagt till CSV-dump av historik."

