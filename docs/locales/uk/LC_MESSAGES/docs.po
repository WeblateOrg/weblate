msgid "`C printf format <https://en.wikipedia.org/wiki/Printf_format_string>`_"
msgstr ""
"`Формат printf на C <https://en.wikipedia.org/wiki/Printf_format_string>`_"

msgid "C# format"
msgstr "Формат C#"

msgid "C# format string does not match source."
msgstr "Рядок формату C# не відповідає джерелу."

msgid "``c-sharp-format``, ``csharp-format``"
msgstr "``c-sharp-format``, ``csharp-format``"

msgid ""
"`C# String Format <https://learn.microsoft.com/en-us/dotnet/api/"
"system.string.format?view=netframework-4.7.2>`_"
msgstr ""
