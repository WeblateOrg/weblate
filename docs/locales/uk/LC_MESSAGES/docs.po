msgstr "Weblate 5.12.1"

msgid "*Released on June 16th 2025.*"
msgstr "*Випущено 16 червня 2025 року.*"

msgid ":ref:`sbom` now includes serial number."
msgstr ":ref:`sbom` тепер містить серійний номер."

msgid ""
