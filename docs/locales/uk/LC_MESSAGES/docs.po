msgstr "Зупинення контейнера Weblate:"

msgid "Backup the database:"
msgstr "Резервне копіювання бази даних:"

msgid "Stop the database container:"
msgstr "Зупинення контейнера бази даних:"

msgid "Remove the PostgreSQL volume:"
msgstr "Вилучення тому PostgreSQL:"

