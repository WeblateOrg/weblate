msgid "Database setup for Weblate"
msgstr "Adatbázis beállítása Weblate-hez"

msgid "It is recommended to run Weblate with a PostgreSQL database server."
msgstr "Ajánlott a Weblate-et PostgreSQL adatbázis-kiszolgálóval futtatni."

