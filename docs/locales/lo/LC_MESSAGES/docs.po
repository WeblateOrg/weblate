msgid "Enables Microsoft Entra ID authentication, see :ref:`entra-auth`."
msgstr "ເປີດໃຊ້ການຢັ້ງຢືນຕົວຕົນ Microsoft Entra ID, ເບິ່ງ :ref:`entra-auth`."

msgid "Microsoft Entra ID with Tenant support"
msgstr "Microsoft Entra ID ພ້ອມການຮອງຮັບ Tenant"

msgid ""
"Enables Microsoft Entra ID authentication with Tenant support, "
"see :ref:`entra-auth`."
msgstr ""
"ເປີດໃຊ້ການຢັ້ງຢືນຕົວຕົນ Microsoft Entra ID ພ້ອມການຮອງຮັບ Tenant, ເບິ່ງ :ref:`entra-"
"auth`."

msgid "Keycloak"
msgstr "Keycloak"

msgid "Enables Keycloak authentication, see :doc:`psa:backends/keycloak`."
msgstr "ເປີດໃຊ້ການຢັ້ງຢືນຕົວຕົນ Keycloak, ເບິ່ງ :doc:`psa:backends/keycloak`."

msgid ""
"Configures which claim is used as the unique user identifier from Keycloak. "
"Defaults to ``email``."
msgstr ""
"ຕັ້ງຄ່າວ່າການອ້າງສິດ (claim) ໃດຖືກໃຊ້ເປັນຕົວລະບຸຜູ້ໃຊ້ທີ່ບໍ່ຊໍ້ກັນຈາກ Keycloak. ຄ່າເລີ່ມຕົ້ນແມ່ນ "
"``email``."

msgid ""
"When Keycloak is configured to abstract third-party IDP, you will need to "
"configure :envvar:`WEBLATE_CSP_FORM_SRC` for the third-party IDP domain."
msgstr ""
"ເມື່ອ Keycloak ຖືກຕັ້ງຄ່າໃຫ້ເປັນຕົວແທນ (abstract) ໃຫ້ກັບ IDP ຂອງພາກສ່ວນທີສາມ, "
"ທ່ານຈະຕ້ອງຕັ້ງຄ່າ :envvar:`WEBLATE_CSP_FORM_SRC` ສຳລັບໂດເມນ IDP ຂອງພາກສ່ວນທີສາມນັ້ນ."

msgid "Example when Keycloak is passing authentication to Microsoft."
msgstr "ຕົວຢ່າງເມື່ອ Keycloak ສົ່ງຕໍ່ການຢັ້ງຢືນຕົວຕົນໄປຍັງ Microsoft."

msgid "Linux vendors"
msgstr "ຜູ້ໃຫ້ບໍລິການ Linux"

msgid ""
"You can enable authentication using Linux vendors authentication services by "
"setting following variables to any value."
msgstr ""
"ທ່ານສາມາດເປີດໃຊ້ການຢັ້ງຢືນຕົວຕົນໂດຍໃຊ້ບໍລິການຢັ້ງຢືນຕົວຕົນຂອງຜູ້ໃຫ້ບໍລິການ Linux ໄດ້ "
"ໂດຍການຕັ້ງຄ່າຕົວແປຕໍ່ໄປນີ້ໃຫ້ເປັນຄ່າໃດກໍໄດ້."

msgid "Enables Slack authentication, see :ref:`slack-auth`."
msgstr "ເປີດໃຊ້ການຢັ້ງຢືນຕົວຕົນ Slack, ເບິ່ງ :ref:`slack-auth`."

msgid "OpenID Connect"
msgstr "OpenID Connect"

msgid "Configures generic OpenID Connect integration."
msgstr "ຕັ້ງຄ່າການເຊື່ອມຕໍ່ OpenID Connect ທົ່ວໄປ."

msgid "Fedora OpenID Connect"
msgstr "Fedora OpenID Connect"

msgid "Configures Fedora OpenID Connect integration."
msgstr "ຕັ້ງຄ່າການເຊື່ອມຕໍ່ Fedora OpenID Connect."

msgid "SAML"
msgstr "SAML"

msgid ""
"Self-signed SAML keys are automatically generated on first container "
"startup. In case you want to use own keys, place the certificate and private "
"key in :file:`/app/data/ssl/saml.crt` and :file:`/app/data/ssl/saml.key`."
msgstr ""
"ຄີ SAML ແບບ Self-signed ຈະຖືກສ້າງຂຶ້ນອັດຕະໂນມັດເມື່ອເລີ່ມຕົ້ນຄອນເທນເນີເປັນຄັ້ງທຳອິດ. "
"ໃນກໍລະນີທີ່ທ່ານຕ້ອງການໃຊ້ຄີຂອງຕົນເອງ, ໃຫ້ວາງໄຟລ໌ໃບຢັ້ງຢືນ ແລະ ໄຟລ໌ຄີສ່ວນຕົວໄວ້ໃນ :file:`/app/"
"data/ssl/saml.crt` ແລະ :file:`/app/data/ssl/saml.key`."

msgid "SAML Identity Provider settings, see :ref:`saml-auth`."
msgstr "ການຕັ້ງຄ່າ SAML Identity Provider, ເບິ່ງ :ref:`saml-auth`."

msgid ""
"SAML security configuration as a JSON object, passed to "
"``SOCIAL_AUTH_SAML_SECURITY_CONFIG``. For example, to disable the "
"``requestedAuthnContext`` (needed for some identity providers such as "
"Microsoft Entra ID with multi-factor authentication):"
msgstr ""
"ການຕັ້ງຄ່າຄວາມປອດໄພ SAML ໃນຮູບແບບ JSON object, ເຊິ່ງຈະຖືກສົ່ງໄປຍັງ "
"``SOCIAL_AUTH_SAML_SECURITY_CONFIG``. ຕົວຢ່າງ, ເພື່ອປິດການໃຊ້ງານ "
"``requestedAuthnContext`` (ທີ່ຈຳເປັນສຳລັບບາງ Identity Providers ເຊັ່ນ Microsoft "
"Entra ID ທີ່ມີການຢັ້ງຢືນຕົວຕົນຫຼາຍຂັ້ນຕອນ):"

msgid ""
"`python3-saml security settings <https://github.com/SAML-Toolkits/python3-"
"saml#settings>`_"
msgstr ""
"`ການຕັ້ງຄ່າຄວາມປອດໄພ python3-saml <https://github.com/SAML-Toolkits/python3-"
"saml#settings>`_"

msgid "SAML attributes mapping."
msgstr "ການຈັບຄູ່ຄຸນລັກສະນະ (attributes) ຂອງ SAML."

msgid "Other authentication settings"
msgstr "ການຕັ້ງຄ່າການຢັ້ງຢືນຕົວຕົນອື່ນໆ"

msgid ""
"Disables e-mail authentication when set to any value. See :ref:`disable-"
"email-auth`."
msgstr ""
"ປິດການຢັ້ງຢືນຕົວຕົນດ້ວຍອີເມວເມື່ອຖືກຕັ້ງຄ່າເປັນຄ່າໃດກໍໄດ້. ເບິ່ງ :ref:`disable-email-auth`."

msgid ""
"Minimal password score as evaluated by the `zxcvbn <https://github.com/"
"dwolfhub/zxcvbn-python>`_ password strength estimator. Defaults to 3, set to "
"0 to disable strength checking."
msgstr ""
"ຄະແນນຄວາມປອດໄພລະຫັດຜ່ານຂັ້ນຕ່ຳທີ່ປະເມີນໂດຍເຄື່ອງມືປະເມີນຄວາມແຂງແກ່ນຂອງລະຫັດຜ່ານ `zxcvbn "
"<https://github.com/dwolfhub/zxcvbn-python>`_. ຄ່າເລີ່ມຕົ້ນແມ່ນ 3, ຕັ້ງເປັນ 0 "
"ເພື່ອປິດການກວດສອບຄວາມແຂງແກ່ນ."

msgid "PostgreSQL database setup"
msgstr "ການຕັ້ງຄ່າຖານຂໍ້ມູນ PostgreSQL"

msgid ""
"The database is created by :file:`docker-compose.yml`, so these settings "
"affect both Weblate and PostgreSQL containers."
msgstr ""
"ຖານຂໍ້ມູນຖືກສ້າງຂຶ້ນໂດຍ :file:`docker-compose.yml`, "
"ດັ່ງນັ້ນການຕັ້ງຄ່າເຫຼົ່ານີ້ຈະສົ່ງຜົນຕໍ່ທັງຄອນເທນເນີ Weblate ແລະ PostgreSQL."

msgid "PostgreSQL password."
msgstr "ລະຫັດຜ່ານ PostgreSQL."

msgid "PostgreSQL username."
msgstr "ຊື່ຜູ້ໃຊ້ PostgreSQL."

msgid "PostgreSQL database name."
msgstr "ຊື່ຖານຂໍ້ມູນ PostgreSQL."

msgid "PostgreSQL server hostname or IP address. Defaults to ``database``."
msgstr "ຊື່ໂຮສຕ໌ ຫຼື ໄອພີແອັດເດຣສ໌ຂອງເຊີບເວີ PostgreSQL. ຄ່າເລີ່ມຕົ້ນແມ່ນ ``database``."

msgid "PostgreSQL server port. Defaults to none (uses the default value)."
msgstr "ພອດຂອງເຊີບເວີ PostgreSQL. ຄ່າເລີ່ມຕົ້ນແມ່ນບໍ່ມີ (ໃຊ້ຄ່າເລີ່ມຕົ້ນ)."

msgid ""
"Configure how PostgreSQL handles SSL in connection to the server, for "
"possible choices see `SSL Mode Descriptions <https://www.postgresql.org/docs/"
"11/libpq-ssl.html#LIBPQ-SSL-SSLMODE-STATEMENTS>`_."
msgstr ""
"ຕັ້ງຄ່າວິທີການທີ່ PostgreSQL ຈັດການ SSL ໃນການເຊື່ອມຕໍ່ກັບເຊີບເວີ, ສຳລັບທາງເລືອກທີ່ເປັນໄປໄດ້ໃຫ້ເບິ່ງ "
"`ຄຳອະທິບາຍໂໝດ SSL <https://www.postgresql.org/docs/11/libpq-ssl.html#LIBPQ-"
"SSL-SSLMODE-STATEMENTS>`_."

msgid ""
"Configures name of the PostgreSQL role to alter during the database "
"migration, see :ref:`config-postgresql`."
msgstr ""
"ຕັ້ງຄ່າຊື່ຂອງ PostgreSQL role ທີ່ຈະປ່ຽນແປງໃນລະຫວ່າງການຍົກລະດັບຖານຂໍ້ມູນ, ເບິ່ງ :ref:`config-"
"postgresql`."

msgid "Defaults to :envvar:`POSTGRES_USER`."
msgstr "ຄ່າເລີ່ມຕົ້ນແມ່ນ :envvar:`POSTGRES_USER`."

msgid ""
"The lifetime of a database connection, as an integer of seconds. Use 0 to "
"close database connections at the end of each request."
msgstr ""
"ໄລຍະເວລາຂອງການເຊື່ອມຕໍ່ຖານຂໍ້ມູນ, ເປັນຈຳນວນເຕັມຂອງວິນາທີ. ໃຊ້ 0 "
"ເພື່ອປິດການເຊື່ອມຕໍ່ຖານຂໍ້ມູນໃນຕອນທ້າຍຂອງແຕ່ລະຄຳຮ້ອງຂໍ."

msgid ""
"The default behavior is to have unlimited persistent database connections."
msgstr "ພຶດຕິກຳເລີ່ມຕົ້ນແມ່ນມີການເຊື່ອມຕໍ່ຖານຂໍ້ມູນແບບຖາວອນແບບບໍ່ຈຳກັດ."

msgid ""
"Enabling connection persistence will typically, cause more open connection "
"to the database. Please adjust your database configuration prior enabling."
msgstr ""
"ການເປີດໃຊ້ການເຊື່ອມຕໍ່ແບບຖາວອນ ໂດຍປົກກະຕິແລ້ວຈະເຮັດໃຫ້ມີການເຊື່ອມຕໍ່ທີ່ເປີດຢູ່ຫຼາຍຂຶ້ນກັບຖານຂໍ້ມູນ. "
"ກະລຸນາປັບການຕັ້ງຄ່າຖານຂໍ້ມູນຂອງທ່ານກ່ອນການເປີດໃຊ້ງານ."

msgid ""
"Disable server side cursors in the database. This is necessary in "
"some :command:`pgbouncer` setups."
msgstr ""
"ປິດການໃຊ້ງານ server side cursors ໃນຖານຂໍ້ມູນ. "
"ສິ່ງນີ້ຈຳເປັນໃນບາງການຕັ້ງຄ່າ :command:`pgbouncer`."

msgid ""
":setting:`DISABLE_SERVER_SIDE_CURSORS <django:DATABASE-"
"DISABLE_SERVER_SIDE_CURSORS>`"
msgstr ""
":setting:`DISABLE_SERVER_SIDE_CURSORS <django:DATABASE-"
"DISABLE_SERVER_SIDE_CURSORS>`"

msgid ""
"Set to false to disable environment based configuration of the database "
"connection. Use :ref:`docker-settings-override` to configure the database "
"connection manually."
msgstr ""
"ຕັ້ງເປັນ false ເພື່ອປິດການຕັ້ງຄ່າການເຊື່ອມຕໍ່ຖານຂໍ້ມູນໂດຍອີງໃສ່ສະພາບແວດລ້ອມ. ໃຊ້ :ref:`docker-"
"settings-override` ເພື່ອຕັ້ງຄ່າການເຊື່ອມຕໍ່ຖານຂໍ້ມູນດ້ວຍຕົນເອງ."

msgid "Database backup settings"
msgstr "ການຕັ້ງຄ່າການສຳຮອງຖານຂໍ້ມູນ"

msgid ""
"Configures the daily database dump using :setting:`DATABASE_BACKUP`. "
"Defaults to ``plain``."
msgstr ""
"ຕັ້ງຄ່າການດິມ (dump) ຖານຂໍ້ມູນປະຈຳວັນໂດຍໃຊ້ :setting:`DATABASE_BACKUP`. ຄ່າເລີ່ມຕົ້ນແມ່ນ "
"``plain``."

msgid "Datastore server setup"
msgstr "ການຕັ້ງຄ່າເຊີບເວີ Datastore"

msgid ""
"Using Valkey or Redis is required by the Weblate container and you have to "
"provide a connection parameters when running Weblate in Docker."
msgstr ""
"ການໃຊ້ Valkey ຫຼື Redis ແມ່ນຈຳເປັນສຳລັບຄອນເທນເນີ Weblate ແລະ "
"ທ່ານຕ້ອງໃຫ້ພາຣາມິເຕີການເຊື່ອມຕໍ່ເມື່ອຮັນ Weblate ໃນ Docker."

msgid "The datastore server hostname or IP address. Defaults to ``cache``."
msgstr "ຊື່ໂຮສຕ໌ ຫຼື ໄອພີແອັດເດຣສ໌ຂອງເຊີບເວີ Datastore. ຄ່າເລີ່ມຕົ້ນແມ່ນ ``cache``."

msgid "The datastore server port. Defaults to ``6379``."
msgstr "ພອດຂອງເຊີບເວີ Datastore. ຄ່າເລີ່ມຕົ້ນແມ່ນ ``6379``."

msgid "The datastore database number, defaults to ``1``."
msgstr "ເລກຖານຂໍ້ມູນ Datastore, ຄ່າເລີ່ມຕົ້ນແມ່ນ ``1``."

msgid "The datastore database user, not used by default."
msgstr "ຜູ້ໃຊ້ຖານຂໍ້ມູນ Datastore, ບໍ່ໄດ້ຖືກໃຊ້ໂດຍເລີ່ມຕົ້ນ."

msgid "The datastore server password, not used by default."
msgstr "ລະຫັດຜ່ານເຊີບເວີ Datastore, ບໍ່ໄດ້ຖືກໃຊ້ໂດຍເລີ່ມຕົ້ນ."

msgid "Enables using SSL for the datastore connection."
msgstr "ເປີດໃຊ້ການໃຊ້ SSL ສຳລັບການເຊື່ອມຕໍ່ Datastore."

msgid ""
"Can be used to disable SSL certificate verification for the datastore "
"connection."
msgstr "ສາມາດໃຊ້ເພື່ອປິດການຢັ້ງຢືນໃບຢັ້ງຢືນ SSL ສຳລັບການເຊື່ອມຕໍ່ Datastore."

msgid "Email server setup"
msgstr "ການຕັ້ງຄ່າເຊີບເວີອີເມວ"

msgid "To make outgoing e-mail work, you need to provide a mail server."
msgstr "ເພື່ອໃຫ້ການສົ່ງອີເມວອອກເຮັດວຽກໄດ້, ທ່ານຈຳເປັນຕ້ອງມີເຊີບເວີອີເມວ."

msgid "Example TLS configuration:"
msgstr "ຕົວຢ່າງການຕັ້ງຄ່າ TLS:"

msgid "Example SSL configuration:"
msgstr "ຕົວຢ່າງການຕັ້ງຄ່າ SSL:"

msgid "Mail server hostname or IP address."
msgstr "ຊື່ໂຮສຕ໌ ຫຼື ໄອພີແອັດເດຣສ໌ຂອງເຊີບເວີອີເມວ."

msgid "Mail server port, defaults to 25."
msgstr "ພອດຂອງເຊີບເວີອີເມວ, ຄ່າເລີ່ມຕົ້ນແມ່ນ 25."

msgid "E-mail authentication user."
msgstr "ຜູ້ໃຊ້ສຳລັບການຢັ້ງຢືນຕົວຕົນທາງອີເມວ."

msgid "E-mail authentication password."
msgstr "ລະຫັດຜ່ານສຳລັບການຢັ້ງຢືນຕົວຕົນທາງອີເມວ."

msgid ""
"Whether to use an implicit TLS (secure) connection when talking to the SMTP "
"server. In most e-mail documentation, this type of TLS connection is "
"referred to as SSL. It is generally used on port 465. If you are "
"experiencing problems, see the explicit TLS "
"setting :envvar:`WEBLATE_EMAIL_USE_TLS`."
msgstr ""
"ຈະໃຊ້ການເຊື່ອມຕໍ່ແບບ implicit TLS (ປອດໄພ) ເມື່ອຕິດຕໍ່ກັບເຊີບເວີ SMTP ຫຼືບໍ່. "
"ໃນເອກະສານອີເມວສ່ວນຫຼາຍ, ການເຊື່ອມຕໍ່ TLS ປະເພດນີ້ຖືກເອີ້ນວ່າ SSL. ໂດຍທົ່ວໄປແລ້ວມັນຈະໃຊ້ໃນພອດ "
"465. ຖ້າທ່ານພົບບັນຫາ, ໃຫ້ເບິ່ງການຕັ້ງຄ່າ explicit TLS "
"ທີ່ :envvar:`WEBLATE_EMAIL_USE_TLS`."

msgid ""
"The SSL/TLS support is automatically enabled based on "
"the :envvar:`WEBLATE_EMAIL_PORT`."
msgstr ""
"ການຮອງຮັບ SSL/TLS ຈະຖືກເປີດໃຊ້ງານໂດຍອັດຕະໂນມັດໂດຍອີງໃສ່ :envvar:`WEBLATE_EMAIL_PORT`."

msgid ""
"Whether to use a TLS (secure) connection when talking to the SMTP server. "
"This is used for explicit TLS connections, generally on port 587 or 25. If "
"you are experiencing connections that hang, see the implicit TLS "
"setting :envvar:`WEBLATE_EMAIL_USE_SSL`."
msgstr ""
"ຈະໃຊ້ການເຊື່ອມຕໍ່ TLS (ປອດໄພ) ເມື່ອຕິດຕໍ່ກັບເຊີບເວີ SMTP ຫຼືບໍ່. ນີ້ໃຊ້ສຳລັບການເຊື່ອມຕໍ່ແບບ explicit "
"TLS, ໂດຍທົ່ວໄປແລ້ວໃນພອດ 587 ຫຼື 25. ຖ້າທ່ານພົບການເຊື່ອມຕໍ່ທີ່ຄ້າງ, ໃຫ້ເບິ່ງການຕັ້ງຄ່າ implicit "
"TLS ທີ່ :envvar:`WEBLATE_EMAIL_USE_SSL`."

msgid "Configures Django back-end to use for sending e-mails."
msgstr "ຕັ້ງຄ່າ Django back-end ທີ່ຈະໃຊ້ສຳລັບການສົ່ງອີເມວ."

msgid "Set to ``django_ses.SESBackend`` to use AWS SES."
msgstr ""

msgid ""
"AWS region for SES (e.g. ``us-east-1``). Sets ``AWS_SES_REGION_NAME`` and "
"derives :envvar:`WEBLATE_AWS_SES_REGION_ENDPOINT` automatically unless that "
"variable is set explicitly. If not set, the region must be available through "
"the standard boto3 credential chain (e.g. ``AWS_DEFAULT_REGION`` or an AWS "
"profile)."
msgstr ""

msgid ""
"SES endpoint hostname. When set, it is passed to django-ses directly "
"regardless of :envvar:`WEBLATE_AWS_SES_REGION_NAME`. When not set "
"but :envvar:`WEBLATE_AWS_SES_REGION_NAME` is provided, defaults to ``email."
"<region>.amazonaws.com``. Override when using a VPC or custom endpoint."
msgstr ""

msgid ""
"Set to ``true`` to use the SES v2 API (``SendEmail``) instead of the legacy "
"``SendRawEmail`` call. Boolean setting (use ``\"true\"`` or ``\"false\"``)."
msgstr ""

msgid "Configures if and how Weblate should update repositories."
msgstr "ຕັ້ງຄ່າວ່າ Weblate ຄວນອັບເດດ repository ຫຼືບໍ່ ແລະ ຢ່າງໃດ."

msgid "This is a Boolean setting (use ``\"true\"`` or ``\"false\"``)."
msgstr "ນີ້ແມ່ນການຕັ້ງຄ່າແບບ Boolean (ໃຊ້ ``\"true\"`` ຫຼື ``\"false\"``)."

msgid "Site integration"
msgstr "ການເຊື່ອມໂຍງເວັບໄຊ"

msgid "Configures :setting:`GET_HELP_URL`."
msgstr "ຕັ້ງຄ່າ :setting:`GET_HELP_URL`."

msgid "Configures :setting:`STATUS_URL`."
msgstr "ຕັ້ງຄ່າ :setting:`STATUS_URL`."

msgid "Configures :setting:`LEGAL_URL`."
msgstr "ຕັ້ງຄ່າ :setting:`LEGAL_URL`."

msgid "Configures :setting:`PRIVACY_URL`."
msgstr "ຕັ້ງຄ່າ :setting:`PRIVACY_URL`."

msgid "Configures :setting:`PASSWORD_RESET_URL`."
msgstr "ຕັ້ງຄ່າ :setting:`PASSWORD_RESET_URL`."

msgid ""
"It is recommended to collect errors from the installation systematically, "
"see :ref:`collecting-errors`."
msgstr "ແນະນຳໃຫ້ເກັບກຳຂໍ້ຜິດພາດຈາກການຕິດຕັ້ງຢ່າງເປັນລະບົບ, ເບິ່ງ :ref:`collecting-errors`."

msgid "To enable support for Rollbar, set the following:"
msgstr "ເພື່ອເປີດໃຊ້ການຮອງຮັບ Rollbar, ໃຫ້ຕັ້ງຄ່າຕໍ່ໄປນີ້:"

msgid "Your Rollbar post server access token."
msgstr "Rollbar post server access token ຂອງທ່ານ."

msgid "Your Rollbar environment, defaults to ``production``."
msgstr "Rollbar environment ຂອງທ່ານ, ຄ່າເລີ່ມຕົ້ນແມ່ນ ``production``."

msgid "To enable support for Sentry, set following:"
msgstr "ເພື່ອເປີດໃຊ້ການຮອງຮັບ Sentry, ໃຫ້ຕັ້ງຄ່າຕໍ່ໄປນີ້:"

msgid "Your Sentry DSN, see :setting:`SENTRY_DSN`."
msgstr "Sentry DSN ຂອງທ່ານ, ເບິ່ງ :setting:`SENTRY_DSN`."

msgid ""
"Your Sentry Environment (optional), defaults "
"to :envvar:`WEBLATE_SITE_DOMAIN`."
msgstr ""
"Sentry Environment ຂອງທ່ານ (ທາງເລືອກ), "
"ຄ່າເລີ່ມຕົ້ນແມ່ນ :envvar:`WEBLATE_SITE_DOMAIN`."

msgid "Whether to monitor Celery Beat tasks with Sentry, defaults to ``True``."
msgstr "ຈະຕິດຕາມ Celery Beat tasks ດ້ວຍ Sentry ຫຼືບໍ່, ຄ່າເລີ່ມຕົ້ນແມ່ນ ``True``."

msgid "Configures :setting:`SENTRY_TRACES_SAMPLE_RATE`."
msgstr "ຕັ້ງຄ່າ :setting:`SENTRY_TRACES_SAMPLE_RATE`."

msgid "Configures :setting:`SENTRY_PROFILES_SAMPLE_RATE`."
msgstr "ຕັ້ງຄ່າ :setting:`SENTRY_PROFILES_SAMPLE_RATE`."

msgid "Configures :setting:`SENTRY_SEND_PII`."
msgstr "ຕັ້ງຄ່າ :setting:`SENTRY_SEND_PII`."

msgid "To enable support for Google Cloud Error Reporting, set following:"
msgstr "ເພື່ອເປີດໃຊ້ການຮອງຮັບ Google Cloud Error Reporting, ໃຫ້ຕັ້ງຄ່າຕໍ່ໄປນີ້:"

msgid "Enables :setting:`GOOGLE_CLOUD_ERROR_REPORTING`, defaults to ``False``."
msgstr "ເປີດໃຊ້ :setting:`GOOGLE_CLOUD_ERROR_REPORTING`, ຄ່າເລີ່ມຕົ້ນແມ່ນ ``False``."

msgid ""
"Google Cloud project to report errors to. If omitted, the Google client uses "
"application default credentials to detect the project."
msgstr ""
"ໂປຣເຈັກ Google Cloud ທີ່ຕ້ອງການລາຍງານຂໍ້ຜິດພາດ. ຖ້າລະເວັ້ນໄວ້, Google client ຈະໃຊ້ "
"application default credentials ເພື່ອກວດຫາໂປຣເຈັກນັ້ນ."

msgid ""
"Service name to use in Google Cloud Error Reporting, defaults to ``weblate``."
msgstr "ຊື່ການບໍລິການທີ່ຈະໃຊ້ໃນ Google Cloud Error Reporting, ຄ່າເລີ່ມຕົ້ນແມ່ນ ``weblate``."

msgid "To enable support for OpenTelemetry tracing, set following:"
msgstr "ເພື່ອເປີດໃຊ້ການຮອງຮັບ OpenTelemetry tracing, ໃຫ້ຕັ້ງຄ່າຕໍ່ໄປນີ້:"

msgid "Enables :setting:`OPENTELEMETRY_ENABLED`, defaults to ``False``."
msgstr "ເປີດໃຊ້ :setting:`OPENTELEMETRY_ENABLED`, ຄ່າເລີ່ມຕົ້ນແມ່ນ ``False``."

msgid "Configures :setting:`OPENTELEMETRY_EXPORTER_OTLP_ENDPOINT`."
msgstr "ຕັ້ງຄ່າ :setting:`OPENTELEMETRY_EXPORTER_OTLP_ENDPOINT`."

msgid ""
"Configures :setting:`OPENTELEMETRY_EXPORTER_OTLP_HEADERS` as a comma-"
"separated ``name:value`` mapping."
msgstr ""
"ຕັ້ງຄ່າ :setting:`OPENTELEMETRY_EXPORTER_OTLP_HEADERS` ເປັນການຈັບຄູ່ແບບ "
"``name:value`` ທີ່ແຍກດ້ວຍເຄື່ອງໝາຍຈຸດ."

msgid ""
"Configures :setting:`OPENTELEMETRY_EXTRA_RESOURCE_ATTRIBUTES` as a comma-"
"separated ``name:value`` mapping."
msgstr ""
"ຕັ້ງຄ່າ :setting:`OPENTELEMETRY_EXTRA_RESOURCE_ATTRIBUTES` ເປັນການຈັບຄູ່ແບບ "
"``name:value`` ທີ່ແຍກດ້ວຍເຄື່ອງໝາຍຈຸດ."

msgid "Configures :setting:`OPENTELEMETRY_SERVICE_NAME`."
msgstr "ຕັ້ງຄ່າ :setting:`OPENTELEMETRY_SERVICE_NAME`."

msgid "Configures :setting:`OPENTELEMETRY_TRACES_SAMPLE_RATE`."
msgstr "ຕັ້ງຄ່າ :setting:`OPENTELEMETRY_TRACES_SAMPLE_RATE`."

msgid "Localization CDN"
msgstr "Localization CDN"

msgid ""
"Configuration for CDN add-ons, including :ref:`addon-weblate.cdn.cdnjs` "
"and :ref:`addon-weblate.cdn.files`."
msgstr ""
"ການຕັ້ງຄ່າສຳລັບ CDN add-ons, ລວມທັງ :ref:`addon-weblate.cdn.cdnjs` "
"ແລະ :ref:`addon-weblate.cdn.files`."

msgid ""
"The :envvar:`WEBLATE_LOCALIZE_CDN_PATH` is path within the container. It "
"should be stored on the persistent volume and not in the transient storage."
msgstr ""
":envvar:`WEBLATE_LOCALIZE_CDN_PATH` ແມ່ນເສັ້ນທາງພາຍໃນຄອນເທນເນີ. "
"ມັນຄວນຈະຖືກຈັດເກັບໄວ້ໃນ persistent volume ບໍ່ແມ່ນໃນ transient storage."

msgid "One of possibilities is storing that inside the Weblate data dir:"
msgstr "ຄວາມເປັນໄປໄດ້ໜຶ່ງຄືການຈັດເກັບໄວ້ພາຍໃນໄດເລັກທໍຣີຂໍ້ມູນຂອງ Weblate:"

msgid ""
"You are responsible for setting up serving of the files generated by "
"Weblate, it only stores the files in configured location. See :ref:`cdn-"
"server-security` for secure serving guidance."
msgstr ""
"ທ່ານມີໜ້າທີ່ຮັບຜິດຊອບໃນການຕັ້ງຄ່າການໃຫ້ບໍລິການໄຟລ໌ທີ່ສ້າງຂຶ້ນໂດຍ Weblate, Weblate "
"ພຽງແຕ່ຈັດເກັບໄຟລ໌ໄວ້ໃນຕຳແໜ່ງທີ່ຕັ້ງຄ່າໄວ້ເທົ່ານັ້ນ. ເບິ່ງ :ref:`cdn-server-security` "
"ສຳລັບຄຳແນະນຳການໃຫ້ບໍລິການຢ່າງປອດໄພ."

msgid ""
"Changing enabled apps, checks, formats, add-ons, machinery, or autofixes"
msgstr "ການປ່ຽນແປງແອັບ, ການກວດສອບ, ຮູບແບບ, add-ons, ເຄື່ອງຈັກ, ຫຼື autofixes ທີ່ເປີດໃຊ້ງານ"

msgid ""
"The built-in configuration of enabled checks, file formats, add-ons, "
"machinery, or autofixes can be adjusted by the following variables:"
msgstr ""
"ການຕັ້ງຄ່າໃນຕົວຂອງການກວດສອບ, ຮູບແບບໄຟລ໌, add-ons, ເຄື່ອງຈັກ, ຫຼື autofixes ທີ່ເປີດໃຊ້ງານ "
"ສາມາດປັບປ່ຽນໄດ້ໂດຍຕົວແປຕໍ່ໄປນີ້:"

msgid "Container settings"
msgstr "ການຕັ້ງຄ່າຄອນເທນເນີ"

msgid ""
"Base number of worker processes running in the container. When not set it is "
"determined automatically on container startup based on number of CPU cores "
"available."
msgstr ""
"ຈຳນວນພື້ນຖານຂອງ worker processes ທີ່ແລ່ນຢູ່ໃນຄອນເທນເນີ. ເມື່ອບໍ່ໄດ້ຕັ້ງຄ່າ, "
"ມັນຈະຖືກກຳນົດອັດຕະໂນມັດເມື່ອເລີ່ມຕົ້ນຄອນເທນເນີໂດຍອີງໃສ່ຈຳນວນ CPU cores ທີ່ມີຢູ່."

msgid ""
"It is used to "
"determine :envvar:`CELERY_MAIN_OPTIONS`, :envvar:`CELERY_NOTIFY_OPTIONS`, :envvar:`CELERY_MEMORY_OPTIONS`, :envvar:`CELERY_TRANSLATE_OPTIONS`, :envvar:`CELERY_BACKUP_OPTIONS`, :envvar:`CELERY_BEAT_OPTIONS`, :envvar:`WEB_WORKERS`, "
"and :envvar:`WEB_BLOCKING_THREADS`. You can use these settings to fine-tune."
msgstr ""
"ມັນຖືກໃຊ້ເພື່ອ "
"ກຳນົດຄ່າ :envvar:`CELERY_MAIN_OPTIONS`, :envvar:`CELERY_NOTIFY_OPTIONS`, :envvar:`CELERY_MEMORY_OPTIONS`, :envvar:`CELERY_TRANSLATE_OPTIONS`, :envvar:`CELERY_BACKUP_OPTIONS`, :envvar:`CELERY_BEAT_OPTIONS`, :envvar:`WEB_WORKERS`, "
"ແລະ :envvar:`WEB_BLOCKING_THREADS`. ເຈົ້າສາມາດໃຊ້ການຕັ້ງຄ່າເຫຼົ່ານີ້ເພື່ອປັບແຕ່ງໃຫ້ລະອຽດຂຶ້ນ."

msgid ""
"These variables allow you to adjust Celery worker options. It can be useful "
"to adjust concurrency (``--concurrency 16``), prefetching (``--prefetch-"
"multiplier 4``), or use different pool implementation (``--pool=gevent``). "
"Command-line options take precedence over corresponding Celery settings, "
"allowing each worker category to use a different prefetch multiplier."
msgstr ""
"ຕົວປ່ຽນເຫຼົ່ານີ້ຊ່ວຍໃຫ້ເຈົ້າປັບແຕ່ງຕົວເລືອກຂອງ Celery worker ໄດ້. ມັນມີປະໂຫຍດໃນການປັບ "
"concurrency (``--concurrency 16``), prefetching (``--prefetch-multiplier "
"4``), ຫຼື ໃຊ້ການເຮັດວຽກຂອງ pool ແບບອື່ນ (``--pool=gevent``). ຕົວເລືອກຈາກຄຳສັ່ງ "
"(command-line) ຈະມີຄວາມສຳຄັນກວ່າການຕັ້ງຄ່າ Celery ທີ່ກົງກັນ, ເຊິ່ງເຮັດໃຫ້ worker "
"ແຕ່ລະປະເພດສາມາດໃຊ້ prefetch multiplier ທີ່ແຕກຕ່າງກັນໄດ້."

msgid ""
"By default, the number of concurrent workers is based "
"on :envvar:`WEBLATE_WORKERS`."
msgstr ""
"ໂດຍເລີ່ມຕົ້ນ, ຈຳນວນຂອງ concurrent workers ຈະອີງໃສ່ :envvar:`WEBLATE_WORKERS`."

msgid ":doc:`Celery worker options <celery:reference/celery.bin.worker>`"
msgstr ":doc:`ທາງເລືອກ Celery worker <celery:reference/celery.bin.worker>`"

msgid ""
"This variable can be set to ``1`` to run only one celery process. This "
"reduces memory usage but may impact Weblate performance."
msgstr ""
"ຕົວແປນີ້ສາມາດຕັ້ງເປັນ ``1`` ເພື່ອຮັນພຽງໜຶ່ງ celery process. ສິ່ງນີ້ຈະຊ່ວຍຫຼຸດການໃຊ້ງານໜ່ວຍຄວາມຈຳ "
"ແຕ່ອາດສົ່ງຜົນຕໍ່ປະສິດທິພາບຂອງ Weblate."

msgid ""
"Set to ``1`` to run the web application using ASGI instead of WSGI. This is "
"an opt-in setting intended for testing the transition to ASGI. WSGI remains "
"the default for now, but a future release will run ASGI only and remove this "
"setting."
msgstr ""
"ຕັ້ງເປັນ ``1`` ເພື່ອລັນເວັບແອັບພລິເຄຊັນດ້ວຍ ASGI ແທນ WSGI. ນີ້ແມ່ນການຕັ້ງຄ່າໃຫ້ເລືອກໃຊ້ "
"ເພື່ອທົດສອບການປ່ຽນຜ່ານໄປຫາ ASGI. ໃນຕອນນີ້ WSGI ຍັງຄົງເປັນຄ່າເລີ່ມຕົ້ນ, ແຕ່ໃນເວີຊັນອະນາຄົດ ຈະໃຊ້ "
"ASGI ເທົ່ານັ້ນ ແລະ ຈະເອົາການຕັ້ງຄ່ານີ້ອອກ."

msgid "Configure how many web application workers should be executed."
msgstr "ຕັ້ງຄ່າວ່າຄວນໃຫ້ມີເວັບແອັບພລິເຄຊັນ worker ຈຳນວນເທົ່າໃດທີ່ເຮັດວຽກ."

msgid ""
"It defaults to half of :envvar:`WEBLATE_WORKERS`, but is always at least 2."
msgstr "ຄ່າເລີ່ມຕົ້ນແມ່ນເຄິ່ງໜຶ່ງຂອງ :envvar:`WEBLATE_WORKERS`, ແຕ່ຢ່າງໜ້ອຍຕ້ອງເປັນ 2."

msgid ""
":envvar:`WEB_WORKERS` configures how many worker processes will be used "
"by :program:`granian`."
msgstr ""
":envvar:`WEB_WORKERS` ຕັ້ງຄ່າຈຳນວນຂະບວນການເຮັດວຽກ (worker processes) "
"ທີ່ຈະຖືກໃຊ້ໂດຍ :program:`granian`."

msgid ""
"Configure how many blocking WSGI threads each :program:`granian` worker can "
"use. It defaults to twice :envvar:`WEBLATE_WORKERS` and is ignored "
"when :envvar:`WEBLATE_ASGI` is enabled."
msgstr ""
"ຕັ້ງຄ່າວ່າແຕ່ລະ :program:`granian` worker ສາມາດໃຊ້ blocking WSGI threads "
"ໄດ້ຈຳນວນເທົ່າໃດ. ຄ່າເລີ່ມຕົ້ນແມ່ນສອງເທົ່າຂອງ :envvar:`WEBLATE_WORKERS` ແລະ "
"ຈະຖືກລະເວັ້ນເມື່ອເປີດໃຊ້ :envvar:`WEBLATE_ASGI`."

msgid ""
"The maximum number of simultaneous WSGI requests is "
"approximately :envvar:`WEB_WORKERS` multiplied "
"by :envvar:`WEB_BLOCKING_THREADS`. Each thread can hold its own database "
"connection, so keep the resulting total within the database connection limit."
msgstr ""
"ຈຳນວນສູງສຸດຂອງການຮ້ອງຂໍ WSGI ພ້ອມກັນແມ່ນປະມານ :envvar:`WEB_WORKERS` "
"ຄູນດ້ວຍ :envvar:`WEB_BLOCKING_THREADS`. ແຕ່ລະ thread "
"ສາມາດຖືການເຊື່ອມຕໍ່ຖານຂໍ້ມູນຂອງຕົນເອງໄດ້, "
"ດັ່ງນັ້ນຄວນຮັກສາຜົນລວມທັງໝົດໃຫ້ຢູ່ໃນຂີດຈຳກັດການເຊື່ອມຕໍ່ຖານຂໍ້ມູນ."

msgid ""
"Defines which services should be executed inside the container. Use this "
"for :ref:`docker-scaling`."
msgstr "ກຳນົດວ່າບໍລິການໃດຄວນຖືກປະຕິບັດພາຍໃນຄອນເທນເນີ. ໃຊ້ສິ່ງນີ້ສຳລັບ :ref:`docker-scaling`."

msgid "Following services are defined:"
msgstr "ມີການກຳນົດບໍລິການຕໍ່ໄປນີ້:"

msgid ""
"Celery task scheduler, only one instance should be running. This container "
"is also responsible for the database structure migrations and it should be "
"started prior others."
msgstr ""
"Celery task scheduler, ຄວນມີພຽງໜຶ່ງ instance ເທົ່ານັ້ນທີ່ແລ່ນຢູ່. "
"ຄອນເທນເນີນີ້ຍັງຮັບຜິດຊອບຕໍ່ການຍົກລະດັບໂຄງສ້າງຖານຂໍ້ມູນ ແລະ ຄວນຈະຖືກເລີ່ມຕົ້ນກ່ອນບໍລິການອື່ນໆ."

msgid "Celery worker for backups, only one instance should be running."
msgstr "Celery worker ສຳລັບການສຳຮອງຂໍ້ມູນ, ຄວນມີພຽງໜຶ່ງ instance ເທົ່ານັ້ນທີ່ແລ່ນຢູ່."

msgid "Generic Celery worker."
msgstr "Generic Celery worker."

msgid "Translation memory Celery worker."
msgstr "Celery worker ສຳລັບ translation memory."

msgid "Notifications Celery worker."
msgstr "Celery worker ສຳລັບການແຈ້ງເຕືອນ."

msgid "Automatic translation Celery worker."
msgstr "Celery worker ສຳລັບການແປອັດຕະໂນມັດ."

msgid "Web server."
msgstr "Web server."

msgid ""
"URL of `Anubis`_ server to handle subrequest authentication. This can be "
"useful to filter incoming HTTP requests using proof-of-work to stop AI "
"crawlers. You need to configure `Anubis for Subrequest Authentication`_ to "
"make it work."
msgstr ""
"URL ຂອງເຊີບເວີ `Anubis`_ ເພື່ອຈັດການການຢັ້ງຢືນຕົວຕົນແບບ subrequest. "
"ສິ່ງນີ້ສາມາດເປັນປະໂຫຍດໃນການກັ່ນຕອງຄຳຮ້ອງຂໍ HTTP ທີ່ເຂົ້າມາໂດຍໃຊ້ proof-of-work ເພື່ອຢຸດ AI "
"crawlers. ທ່ານຈຳເປັນຕ້ອງຕັ້ງຄ່າ `Anubis for Subrequest Authentication`_ "
"ເພື່ອເຮັດໃຫ້ມັນເຮັດວຽກໄດ້."

msgid "`Anubis`_"
msgstr "`Anubis`_"

msgid "Docker container volumes"
msgstr "Docker container volumes"

msgid ""
"There are two volumes (:file:`data` and :file:`cache`) exported by the "
"Weblate container."
msgstr ""
"ມີສອງ volumes (:file:`data` ແລະ :file:`cache`) ທີ່ຖືກສົ່ງອອກໂດຍຄອນເທນເນີ Weblate."

msgid ""
"The other service containers (such as PostgreSQL or Valkey) have their data "
"volumes as well and are required to maintain Weblate persistence."
msgstr ""
"ຄອນເທນເນີບໍລິການອື່ນໆ (ເຊັ່ນ PostgreSQL ຫຼື Valkey) ກໍມີ data volumes ຂອງຕົນເອງເຊັ່ນກັນ ແລະ "
"ຈຳເປັນເພື່ອຮັກສາຄວາມຖາວອນຂອງ Weblate."

msgid ""
"The PostgreSQL container stores the database in the :file:`/var/lib/"
"postgresql` volume and Valkey in the :file:`/data` volume. Valkey container "
"does not save the data by default and needs additional configuration to "
"enable persistence."
msgstr ""
"ຄອນເທນເນີ PostgreSQL ຈັດເກັບຖານຂໍ້ມູນໄວ້ໃນ volume :file:`/var/lib/postgresql` ແລະ "
"Valkey ໃນ volume :file:`/data`. ຄອນເທນເນີ Valkey ບໍ່ໄດ້ບັນທຶກຂໍ້ມູນໂດຍເລີ່ມຕົ້ນ ແລະ "
"ຕ້ອງການການຕັ້ງຄ່າເພີ່ມເຕີມເພື່ອເປີດໃຊ້ຄວາມຖາວອນ."

msgid ""
"Base your configuration on Weblate-provided examples or consult their "
"documentation for more information."
msgstr ""
"ໃຫ້ອີງໃສ່ການຕັ້ງຄ່າຂອງທ່ານຈາກຕົວຢ່າງທີ່ Weblate ໃຫ້ມາ ຫຼື ເບິ່ງເອກະສານຂອງພວກເຂົາສຳລັບຂໍ້ມູນເພີ່ມເຕີມ."

msgid ""
"The :file:`data` volume is mounted as :file:`/app/data` and is used to store "
"Weblate persistent data such as cloned repositories or to customize Weblate "
"installation. :setting:`DATA_DIR` describes in more detail what is stored "
"here."
msgstr ""
"Volume :file:`data` ຖືກເຊື່ອມຕໍ່ເປັນ :file:`/app/data` ແລະ ຖືກໃຊ້ເພື່ອເກັບຂໍ້ມູນຖາວອນຂອງ "
"Weblate ເຊັ່ນ ຄັງເກັບທີ່ໂຄລນມາ ຫຼື ເພື່ອປັບແຕ່ງການຕິດຕັ້ງ Weblate. :setting:`DATA_DIR` "
"ຈະອະທິບາຍລາຍລະອຽດເພີ່ມເຕີມກ່ຽວກັບສິ່ງທີ່ຖືກເກັບໄວ້ທີ່ນີ້."

msgid ""
"The :file:`data` volume is also place to store Weblate customization such "
"as :ref:`docker-settings-override`, :ref:`docker-static-override` "
"or :ref:`docker-python-override`."
msgstr ""
"Volume :file:`data` ຍັງເປັນບ່ອນສຳລັບເກັບການປັບແຕ່ງ Weblate ເຊັ່ນ :ref:`docker-"
"settings-override`, :ref:`docker-static-override` ຫຼື :ref:`docker-python-"
"override`."

msgid ""
"The placement of the Docker volume on host system depends on your Docker "
"configuration, but usually it is stored in :file:`/var/lib/docker/volumes/"
"weblate-docker_weblate-data/_data/` (the path consist of name of your docker-"
"compose directory, container, and volume names)."
msgstr ""
"ຕຳແໜ່ງຂອງ Docker volume ໃນລະບົບ host ຂຶ້ນກັບການຕັ້ງຄ່າ Docker ຂອງທ່ານ, "
"ແຕ່ໂດຍທົ່ວໄປແລ້ວມັນຈະຖືກຈັດເກັບໄວ້ໃນ :file:`/var/lib/docker/volumes/weblate-"
"docker_weblate-data/_data/` (ເສັ້ນທາງປະກອບດ້ວຍຊື່ໄດເລັກທໍຣີ docker-compose, "
"ຄອນເທນເນີ, ແລະ ຊື່ volume)."

msgid ""
"The :file:`cache` volume is mounted as :file:`/app/cache` and is used to "
"store static files and :setting:`CACHE_DIR`. Its content is recreated on "
"container startup and the volume can be mounted using ephemeral filesystem "
"such as `tmpfs`, but the mount has to allow execution because Weblate stores "
"generated helper files there."
msgstr ""
"Volume :file:`cache` ຖືກເຊື່ອມຕໍ່ເປັນ :file:`/app/cache` ແລະ ຖືກໃຊ້ເພື່ອເກັບໄຟລ໌ຄົງທີ່ "
"(static) ແລະ :setting:`CACHE_DIR`. ເນື້ອໃນຂອງມັນຈະຖືກສ້າງໃໝ່ທຸກຄັ້ງທີ່ container "
"ເລີ່ມເຮັດວຽກ ແລະ volume ສາມາດເຊື່ອມຕໍ່ໂດຍໃຊ້ລະບົບໄຟລ໌ຊົ່ວຄາວເຊັ່ນ `tmpfs` ໄດ້, ແຕ່ການເຊື່ອມຕໍ່ນັ້ນ "
"ຕ້ອງອະນຸຍາດໃຫ້ມີການລັນຄຳສັ່ງ (execution) ເພາະ Weblate ຈະເກັບໄຟລ໌ຊ່ວຍເຫຼືອທີ່ສ້າງຂຶ້ນໄວ້ທີ່ນັ້ນ."

msgid ""
"When mounting :file:`/app/cache` explicitly as ``tmpfs`` in Docker Compose, "
"enable execution:"
msgstr ""
"ເມື່ອ mount :file:`/app/cache` ຢ່າງຊັດເຈນເປັນ ``tmpfs`` ໃນ Docker Compose, "
"ໃຫ້ເປີດໃຊ້ execution:"

msgid "When also setting ownership options, keep the ``exec`` option:"
msgstr "ເມື່ອຕັ້ງຄ່າ ownership options, ໃຫ້ຮັກສາທາງເລືອກ ``exec`` ໄວ້:"

msgid ""
"When creating the volumes manually, the directories should be owned by UID "
"1000 as that is user used inside the container."
msgstr ""
"ເມື່ອສ້າງ volumes ດ້ວຍຕົນເອງ, ໄດເລັກທໍຣີຄວນຖືກເປັນເຈົ້າຂອງໂດຍ UID 1000 "
"ເພາະນັ້ນແມ່ນຜູ້ໃຊ້ທີ່ຖືກໃຊ້ພາຍໃນຄອນເທນເນີ."

msgid ""
"Weblate container can also be executed with a read-only root file system. In "
"this case, two additional ``tmpfs`` volumes should be mounted: :file:`/tmp` "
"and :file:`/run`."
msgstr ""
"ຄອນເທນເນີ Weblate ສາມາດຖືກປະຕິບັດດ້ວຍ read-only root file system ໄດ້ເຊັ່ນກັນ. "
"ໃນກໍລະນີນີ້, ຄວນ mount ສອງ ``tmpfs`` volumes ເພີ່ມເຕີມ: :file:`/tmp` ແລະ :file:`/"
"run`."

msgid ""
"`Docker volumes documentation <https://docs.docker.com/engine/storage/"
"volumes/>`_"
msgstr ""
"`ເອກະສານ Docker volumes <https://docs.docker.com/engine/storage/volumes/>`_"

msgid "Read-only root filesystem"
msgstr "Read-only root filesystem"

msgid ""
"When running the container with a read-only root filesystem, two additional "
"`tmpfs` volumes are required - :file:`/tmp` and :file:`/run`."
msgstr ""
"ເມື່ອຮັນຄອນເທນເນີດ້ວຍ read-only root filesystem, ຈຳເປັນຕ້ອງມີ `tmpfs` volumes "
"ເພີ່ມເຕີມສອງອັນ - :file:`/tmp` ແລະ :file:`/run`."

msgid "Configuration beyond environment variables"
msgstr "ການຕັ້ງຄ່ານອກເໜືອຈາກຕົວແປສະພາບແວດລ້ອມ"

msgid ""
":ref:`Docker environment variables <docker-environment>` are intended to "
"expose most :ref:`configuration settings <config>` of relevance for Weblate "
"installations."
msgstr ""
":ref:`ຕົວແປສະພາບແວດລ້ອມ Docker <docker-environment>` "
"ມີຈຸດປະສົງເພື່ອເປີດເຜີຍ :ref:`ການຕັ້ງຄ່າຕ່າງໆ <config>` ສ່ວນໃຫຍ່ທີ່ກ່ຽວຂ້ອງກັບການຕິດຕັ້ງ Weblate."

msgid ""
"If you find a setting that is not exposed as an environment variable, and "
"you believe that it should be, feel free to :ref:`ask for it to be exposed "
"in a future version of Weblate <report-issue>`."
msgstr ""
"ຖ້າທ່ານພົບການຕັ້ງຄ່າທີ່ບໍ່ໄດ້ຖືກເປີດເຜີຍເປັນຕົວແປສະພາບແວດລ້ອມ, ແລະ ທ່ານເຊື່ອວ່າມັນຄວນຈະເປັນ, "
"ຢ່າລັງເລທີ່ຈະ :ref:`ຮ້ອງຂໍໃຫ້ມີການເປີດເຜີຍໃນເວີຊັນອະນາຄົດຂອງ Weblate <report-issue>`."

msgid ""
"If you need to modify a setting that is not exposed as a Docker environment "
"variable, you can still do so, either :ref:`from the data volume <docker-"
"settings-override>` or :ref:`extending the Docker image <docker-custom-"
"settings>`."
msgstr ""
"ຖ້າທ່ານຈຳເປັນຕ້ອງແກ້ໄຂການຕັ້ງຄ່າທີ່ບໍ່ໄດ້ຖືກເປີດເຜີຍເປັນຕົວແປສະພາບແວດລ້ອມ Docker, "
"ທ່ານຍັງສາມາດເຮັດໄດ້, ໂດຍຜ່ານ :ref:`data volume <docker-settings-override>` "
"ຫຼື :ref:`ການຂະຫຍາຍ Docker image <docker-custom-settings>`."

msgid "Overriding settings from the data volume"
msgstr "ການປັບປ່ຽນການຕັ້ງຄ່າຈາກ data volume"

msgid ""
"You can create a file at :file:`/app/data/settings-override.py`, i.e. at the "
"root of the :ref:`data volume <docker-volume>`, to extend or override "
"settings defined through environment variables."
msgstr ""
"ທ່ານສາມາດສ້າງໄຟລ໌ທີ່ :file:`/app/data/settings-override.py`, ນັ້ນຄືທີ່ root "
"ຂອງ :ref:`data volume <docker-volume>`, ເພື່ອຂະຫຍາຍ ຫຼື "
"ປັບປ່ຽນການຕັ້ງຄ່າທີ່ກຳນົດໄວ້ຜ່ານຕົວແປສະພາບແວດລ້ອມ."

msgid "Overriding settings by extending the Docker image"
msgstr "ການປັບປ່ຽນການຕັ້ງຄ່າໂດຍການຂະຫຍາຍ Docker image"

msgid ""
"To override settings at the Docker image level instead of from the data "
"volume:"
msgstr "ເພື່ອປັບປ່ຽນການຕັ້ງຄ່າທີ່ລະດັບ Docker image ແທນທີ່ຈະເປັນຈາກ data volume:"

msgid ":ref:`Create a custom Python package <custom-module>`."
msgstr ":ref:`ສ້າງ Python package ແບບກຳນົດເອງ <custom-module>`."

msgid ""
"Add a module to your package that imports all settings from "
"``weblate.settings_docker``."
msgstr ""
"ເພີ່ມໂມດູນໃຫ້ກັບ package ຂອງທ່ານທີ່ນຳເຂົ້າການຕັ້ງຄ່າທັງໝົດຈາກ ``weblate.settings_docker``."

msgid ""
"For example, within the example package structure defined at :ref:`custom-"
"module`, you could create a file at ``weblate_customization/"
"weblate_customization/settings.py`` with the following initial code:"
msgstr ""
"ຕົວຢ່າງ, ພາຍໃນໂຄງສ້າງ package ຕົວຢ່າງທີ່ກຳນົດໄວ້ທີ່ :ref:`custom-module`, "
"ທ່ານສາມາດສ້າງໄຟລ໌ທີ່ ``weblate_customization/weblate_customization/settings.py`` "
"ດ້ວຍລະຫັດເລີ່ມຕົ້ນດັ່ງນີ້:"

msgid ""
"Create a custom ``Dockerfile`` that inherits from the official Weblate "
"Docker image, and then installs your package and points the "
"``DJANGO_SETTINGS_MODULE`` environment variable to your settings module:"
msgstr ""
"ສ້າງ ``Dockerfile`` ແບບກຳນົດເອງທີ່ສືບທອດມາຈາກ Weblate Docker image ທາງການ, "
"ແລ້ວຕິດຕັ້ງ package ຂອງທ່ານ ແລະ ຊີ້ຕົວແປສະພາບແວດລ້ອມ ``DJANGO_SETTINGS_MODULE`` "
"ໄປຍັງໂມດູນການຕັ້ງຄ່າຂອງທ່ານ:"

msgid ""
"Instead of using the official Weblate Docker image, build a custom image "
"from this ``Dockerfile`` file."
msgstr ""
"ແທນທີ່ຈະໃຊ້ Weblate Docker image ທາງການ, ໃຫ້ build image ແບບກຳນົດເອງຈາກໄຟລ໌ "
"``Dockerfile`` ນີ້."

msgid ""
"There is `no clean way <https://github.com/docker/compose/issues/7231>`__ to "
"do this with ``docker-compose.override.yml``. You *could* add ``build: .`` "
"to the ``weblate`` node in that file, but then your custom image will be "
"tagged as ``weblate/weblate`` in your system, which could be problematic."
msgstr ""
"ບໍ່ມີ `ວິທີທີ່ສະອາດ <https://github.com/docker/compose/issues/7231>`__ ທີ່ຈະເຮັດສິ່ງນີ້ດ້ວຍ "
"``docker-compose.override.yml``. ທ່ານ *ສາມາດ* ເພີ່ມ ``build: .`` ໃສ່ໂນດ "
"``weblate`` ໃນໄຟລ໌ນັ້ນ, ແຕ່ image ແບບກຳນົດເອງຂອງທ່ານຈະຖືກແທັກເປັນ ``weblate/weblate`` "
"ໃນລະບົບຂອງທ່ານ, ເຊິ່ງອາດເຮັດໃຫ້ເກີດບັນຫາ."

msgid ""
"So, instead of using the ``docker-compose.yml`` straight from the `official "
"repository <https://github.com/WeblateOrg/docker-compose>`__, unmodified, "
"and extending it through ``docker-compose.override.yml``, you may want to "
"make a copy of the official ``docker-compose.yml`` file, and edit your copy "
"to replace ``image: weblate/weblate`` with ``build: .``."
msgstr ""
"ດັ່ງນັ້ນ, ແທນທີ່ຈະໃຊ້ ``docker-compose.yml`` ໂດຍກົງຈາກ `repository ທາງການ <https://"
"github.com/WeblateOrg/docker-compose>`__, ໂດຍບໍ່ໄດ້ດັດແກ້, ແລະ ຂະຫຍາຍມັນຜ່ານ "
"``docker-compose.override.yml``, ທ່ານອາດຈະຕ້ອງການສຳເນົາໄຟລ໌ ``docker-"
"compose.yml`` ທາງການ, ແລະ ແກ້ໄຂສຳເນົາຂອງທ່ານເພື່ອປ່ຽນ ``image: weblate/weblate`` "
"ເປັນ ``build: .``."

msgid ""
"See the `Compose file build reference`_ for details on building images from "
"source when using ``docker-compose``."
msgstr ""
"ເບິ່ງ `Compose file build reference`_ ສຳລັບລາຍລະອຽດໃນການ build images ຈາກ "
"source ເມື່ອໃຊ້ ``docker-compose``."

msgid "Extend your custom settings module to define or redefine settings."
msgstr "ຂະຫຍາຍໂມດູນການຕັ້ງຄ່າແບບກຳນົດເອງຂອງທ່ານເພື່ອລະບຸ ຫຼື ກຳນົດການຕັ້ງຄ່າໃໝ່."

msgid ""
"You can define settings before or after the import statement above to "
"determine which settings take precedence. Settings defined before the import "
"statement can be overridden by environment variables and setting overrides "
"defined in the data volume. Setting defined after the import statement "
"cannot be overridden."
msgstr ""
"ທ່ານສາມາດລະບຸການຕັ້ງຄ່າກ່ອນ ຫຼື ຫຼັງຄຳສັ່ງ import ຂ້າງເທິງ ເພື່ອກຳນົດວ່າການຕັ້ງຄ່າໃດມີຄວາມສຳຄັນກວ່າ. "
"ການຕັ້ງຄ່າທີ່ລະບຸກ່ອນຄຳສັ່ງ import ສາມາດຖືກປັບປ່ຽນໂດຍຕົວແປສະພາບແວດລ້ອມ ແລະ "
"ການປັບປ່ຽນການຕັ້ງຄ່າທີ່ລະບຸໄວ້ໃນ data volume. ການຕັ້ງຄ່າທີ່ລະບຸຫຼັງຄຳສັ່ງ import "
"ຈະບໍ່ສາມາດປັບປ່ຽນໄດ້."

msgid ""
"You can also go further. For example, you can reproduce some of the things "
"that ``weblate.docker_settings`` `does <https://github.com/WeblateOrg/"
"weblate/blob/main/weblate/settings_docker.py>`__, such as exposing settings "
"as environment variables, or allow overriding settings from Python files in "
"the data volume."
msgstr ""
"ທ່ານຍັງສາມາດເຮັດໃຫ້ຫຼາຍກວ່ານັ້ນ. ຕົວຢ່າງ, ທ່ານສາມາດເຮັດຊ້ຳບາງສິ່ງທີ່ "
"``weblate.docker_settings`` `ເຮັດ <https://github.com/WeblateOrg/weblate/blob/"
"main/weblate/settings_docker.py>`__, ເຊັ່ນການເປີດເຜີຍການຕັ້ງຄ່າເປັນຕົວແປສະພາບແວດລ້ອມ, "
"ຫຼື ອະນຸຍາດໃຫ້ປັບປ່ຽນການຕັ້ງຄ່າຈາກໄຟລ໌ Python ໃນ data volume."

msgid "Replacing logo and other static files"
msgstr "ການປ່ຽນໂລໂກ້ ແລະ ໄຟລ໌ static ອື່ນໆ"

msgid ""
"The static files coming with Weblate can be overridden by placing "
"into :file:`/app/data/python/customize/static` (see :ref:`docker-volume`). "
"For example creating :file:`/app/data/python/customize/static/favicon.ico` "
"will replace the favicon."
msgstr ""
"ໄຟລ໌ static ທີ່ມາພ້ອມກັບ Weblate ສາມາດຖືກປັບປ່ຽນໄດ້ໂດຍການວາງໄວ້ໃນ :file:`/app/data/"
"python/customize/static` (ເບິ່ງ :ref:`docker-volume`). ຕົວຢ່າງ, ການສ້າງ :file:`/"
"app/data/python/customize/static/favicon.ico` ຈະປ່ຽນ favicon."

msgid ""
"The files are copied to the corresponding location upon container startup, "
"so a restart of Weblate is needed after changing the content of the volume."
msgstr ""
"ໄຟລ໌ເຫຼົ່ານີ້ຈະຖືກສຳເນົາໄປຍັງຕຳແໜ່ງທີ່ສອດຄ້ອງກັນເມື່ອເລີ່ມຕົ້ນຄອນເທນເນີ, ດັ່ງນັ້ນຈຶ່ງຈຳເປັນຕ້ອງ restart "
"Weblate ຫຼັງຈາກປ່ຽນເນື້ອຫາຂອງ volume."

msgid ""
"This approach can be also used to override Weblate templates. For example, "
"custom :ref:`legal` documents and styles can be provided as described "
"in :ref:`legal-customization`."
msgstr ""
"ວິທີການນີ້ຍັງສາມາດໃຊ້ເພື່ອຂ້າມ (override) ເທັມເພລດ (templates) ຂອງ Weblate ໄດ້. ຕົວຢ່າງ, "
"ສາມາດສະໜອງເອກະສານ :ref:`legal` ແລະ "
"ຮູບແບບແບບກຳນົດເອງໄດ້ຕາມທີ່ອະທິບາຍໄວ້ໃນ :ref:`legal-customization`."

msgid ""
"Alternatively you can also include own module (see :doc:`../customize`) and "
"add it as separate volume to the Docker container, for example:"
msgstr ""
"ນອກຈາກນີ້, ທ່ານຍັງສາມາດລວມໂມດູນຂອງທ່ານເອງ (ເບິ່ງ :doc:`../customize`) ແລະ ເພີ່ມມັນເປັນ "
"volume ແຍກຕ່າງຫາກໃສ່ Docker container, ຕົວຢ່າງ:"

msgid "Customizing code"
msgstr "ການປັບແຕ່ງລະຫັດ"

msgid ""
"The internal Weblate API may vary significantly between releases and is not "
"meant to be stable. Please review your custom code interacting with Weblate "
"internals on each upgrade."
msgstr ""
"Weblate API ພາຍໃນອາດຈະປ່ຽນແປງຢ່າງຫຼວງຫຼາຍລະຫວ່າງເວີຊັນ ແລະ ບໍ່ໄດ້ມີຈຸດປະສົງໃຫ້ມີຄວາມສະຖຽນ. "
"ກະລຸນາທົບທວນລະຫັດທີ່ກຳນົດເອງຂອງທ່ານທີ່ຕິດຕໍ່ກັບລະບົບພາຍໃນຂອງ Weblate ໃນທຸກຄັ້ງທີ່ມີການຍົກລະດັບ."

msgid ""
"You can place additional Python code into :file:`/app/data/python/customize` "
"(see :ref:`docker-volume`). It is already installed as a Django application "
"inside Weblate (this is used for customizing templates and static files as "
"described above)."
msgstr ""
"ທ່ານສາມາດວາງ Python code ເພີ່ມເຕີມໄວ້ໃນ :file:`/app/data/python/customize` "
"(ເບິ່ງ :ref:`docker-volume`). ມັນຖືກຕິດຕັ້ງໄວ້ແລ້ວໃນຖານະ Django application ພາຍໃນ "
"Weblate (ນີ້ແມ່ນໃຊ້ສຳລັບປັບແຕ່ງ templates ແລະ ໄຟລ໌ static ຕາມທີ່ໄດ້ອະທິບາຍຂ້າງເທິງ)."

msgid ""
"This can be used to place any code (for example :ref:`own-checks`) or to add "
"custom maintenance tasks to the Celery task scheduler."
msgstr ""
"ສິ່ງນີ້ສາມາດໃຊ້ເພື່ອວາງລະຫັດໃດກໍໄດ້ (ຕົວຢ່າງ :ref:`own-checks`) ຫຼື "
"ເພື່ອງານບຳລຸງຮັກສາແບບກຳນົດເອງໃສ່ Celery task scheduler."

msgid "Integrating third-party containers"
msgstr "ການເຊື່ອມໂຍງຄອນເທນເນີຂອງພາກສ່ວນທີສາມ"

msgid ""
"The Weblate Docker setup can be extended with additional containers to "
"provide complementary services such as machine translation, spell checking, "
"or other tools that enhance the translation workflow. These services can be "
"integrated into your Docker Compose configuration and work alongside Weblate."
msgstr ""
"ການຕັ້ງຄ່າ Weblate Docker ສາມາດຂະຫຍາຍໄດ້ດ້ວຍຄອນເທນເນີເພີ່ມເຕີມເພື່ອໃຫ້ບໍລິການເສີມ ເຊັ່ນ "
"ການແປດ້ວຍເຄື່ອງຈັກ, ການກວດສອບການສະກົດຄຳ, ຫຼື ເຄື່ອງມືອື່ນໆທີ່ຊ່ວຍເພີ່ມປະສິດທິພາບໃນຂັ້ນຕອນການແປ. "
"ບໍລິການເຫຼົ່ານີ້ສາມາດຖືກເຊື່ອມໂຍງເຂົ້າໃນການຕັ້ງຄ່າ Docker Compose ຂອງທ່ານ ແລະ ເຮັດວຽກຮ່ວມກັບ "
"Weblate."

msgid "When adding third-party containers, consider the following:"
msgstr "ເມື່ອເພີ່ມຄອນເທນເນີຂອງພາກສ່ວນທີສາມ, ໃຫ້ພິຈາລະນາຕໍ່ໄປນີ້:"

msgid ""
"**Network connectivity**: Ensure containers can communicate with each other "
"by placing them on the same Docker network"
msgstr ""
"**ການເຊື່ອມຕໍ່ເຄືອຂ່າຍ**: ຮັບປະກັນວ່າຄອນເທນເນີສາມາດສື່ສານກັນໄດ້ໂດຍການວາງໄວ້ໃນ Docker "
"network ດຽວກັນ"

msgid ""
"**Data persistence**: Use volumes for services that need to persist data"
msgstr "**ຄວາມຖາວອນຂອງຂໍ້ມູນ**: ໃຊ້ volumes ສຳລັບບໍລິການທີ່ຈຳເປັນຕ້ອງເກັບຂໍ້ມູນໄວ້ຢ່າງຖາວອນ"

msgid ""
"**Security**: Configure appropriate access controls and avoid exposing "
"unnecessary ports"
msgstr "**ຄວາມປອດໄພ**: ຕັ້ງຄ່າການຄວບຄຸມການເຂົ້າເຖິງທີ່ເໝາະສົມ ແລະ ຫຼີກເວັ້ນການເປີດພອດທີ່ບໍ່ຈຳເປັນ"

msgid "LibreTranslate Docker container integration"
msgstr "ການເຊື່ອມໂຍງ LibreTranslate Docker container"

msgid ""
"`LibreTranslate <https://libretranslate.com/>`_ is a free and open-source "
"machine translation service that can be self-hosted. Integrating it with "
"Weblate provides offline machine translation capabilities without relying on "
"external services."
msgstr ""
"`LibreTranslate <https://libretranslate.com/>`_ ແມ່ນບໍລິການແປດ້ວຍເຄື່ອງຈັກທີ່ບໍ່ເສຍຄ່າ "
"ແລະ ເປັນ open-source ເຊິ່ງສາມາດ self-hosted ໄດ້. ການເຊື່ອມໂຍງມັນກັບ Weblate "
"ໃຫ້ຄວາມສາມາດໃນການແປດ້ວຍເຄື່ອງຈັກແບບອອຟໄລໂດຍບໍ່ຕ້ອງອີງໃສ່ບໍລິການພາຍນອກ."

msgid ""
"You can incorporate the LibreTranslate service into your Weblate deployment "
"by including it in a :file:`docker-compose.override.yml` file. Since it runs "
"within the Docker network, it's only accessible to Weblate and not exposed "
"to the public internet."
msgstr ""
"ທ່ານສາມາດລວມບໍລິການ LibreTranslate ເຂົ້າໃນການຕິດຕັ້ງ Weblate "
"ຂອງທ່ານໂດຍການລວມມັນໄວ້ໃນໄຟລ໌ :file:`docker-compose.override.yml`. "
"ເນື່ອງຈາກມັນແລ່ນພາຍໃນ Docker network, ມັນສາມາດເຂົ້າເຖິງໄດ້ໂດຍ Weblate ເທົ່ານັ້ນ ແລະ "
"ບໍ່ໄດ້ຖືກເປີດເຜີຍຕໍ່ອິນເຕີເນັດສາທາລະນະ."

msgid "Basic setup using :file:`docker-compose.override.yml`:"
msgstr "ການຕັ້ງຄ່າພື້ນຖານໂດຍໃຊ້ :file:`docker-compose.override.yml`:"

msgid "For GPU-accelerated translation (if you have NVIDIA GPU available):"
msgstr "ສຳລັບການແປແບບເລັ່ງດ້ວຍ GPU (ຖ້າທ່ານມີ NVIDIA GPU):"

msgid ""
"After starting the services with ``docker compose down && docker compose up "
"-d``, configure LibreTranslate in Weblate:"
msgstr ""
"ຫຼັງຈາກເລີ່ມຕົ້ນບໍລິການດ້ວຍ ``docker compose down && docker compose up -d``, ໃຫ້ຕັ້ງຄ່າ "
"LibreTranslate ໃນ Weblate:"

msgid "Access the Weblate admin interface"
msgstr "ເຂົ້າເຖິງ Weblate admin interface"

msgid ""
"Navigate to :guilabel:`Machine translation` → :guilabel:`Automatic "
"suggestions`"
msgstr ""
"ໄປທີ່ :guilabel:`ການແປດ້ວຍເຄື່ອງຈັກ (Machine translation)` "
"→ :guilabel:`ຄຳແນະນຳອັດຕະໂນມັດ (Automatic suggestions)`"

msgid "Add a new LibreTranslate service with:"
msgstr "ເພີ່ມບໍລິການ LibreTranslate ໃໝ່ດ້ວຍ:"

msgid "Service"
msgstr "ບໍລິການ"

msgid "LibreTranslate"
msgstr "LibreTranslate"

msgid "API URL"
msgstr "API URL"

msgid "API key"
msgstr "API key"

msgid "Leave empty"
msgstr "ປ່ອຍຫວ່າງໄວ້"

msgid ""
"LibreTranslate is now configured and available for machine translation in "
"Weblate."
msgstr "LibreTranslate ໄດ້ຖືກຕັ້ງຄ່າແລ້ວ ແລະ ພ້ອມໃຊ້ງານສຳລັບການແປດ້ວຍເຄື່ອງຈັກໃນ Weblate."

msgid ""
"The LibreTranslate service runs without the web UI (``--disable-web-ui``) "
"and is only accessible via the API within the Docker network."
msgstr ""
"ບໍລິການ LibreTranslate ແລ່ນໂດຍບໍ່ມີ web UI (``--disable-web-ui``) ແລະ "
"ສາມາດເຂົ້າເຖິງໄດ້ຜ່ານ API ພາຍໃນ Docker network ເທົ່ານັ້ນ."

msgid ""
"Models are automatically updated when the container starts. "
"(``LT_UPDATE_MODELS: true``)"
msgstr "Models ຈະຖືກອັບເດດອັດຕະໂນມັດເມື່ອຄອນເທນເນີເລີ່ມຕົ້ນ. (``LT_UPDATE_MODELS: true``)"

msgid ""
"Data is persisted using Docker volumes for optimal performance and data "
"safety."
msgstr ""
"ຂໍ້ມູນຖືກຈັດເກັບໄວ້ຢ່າງຖາວອນໂດຍໃຊ້ Docker volumes ເພື່ອປະສິດທິພາບທີ່ດີທີ່ສຸດ ແລະ "
"ຄວາມປອດໄພຂອງຂໍ້ມູນ."

msgid ""
"Health checks ensure that the Docker engine properly observes the state of "
"the service."
msgstr "Health checks ຮັບປະກັນວ່າ Docker engine ຕິດຕາມສະຖານະຂອງການບໍລິການໄດ້ຢ່າງຖືກຕ້ອງ."

msgid ""
"For GPU acceleration, use the CUDA image variant and ensure your system has "
"NVIDIA Docker support. This container runs as a privileged user to be able "
"to use the GPU."
msgstr ""
"ສຳລັບ GPU acceleration, ໃຫ້ໃຊ້ CUDA image variant ແລະ "
"ຮັບປະກັນວ່າລະບົບຂອງທ່ານມີການຮອງຮັບ NVIDIA Docker. "
"ຄອນເທນເນີນີ້ແລ່ນໃນຖານະຜູ້ໃຊ້ທີ່ມີສິດທິພິເສດເພື່ອໃຫ້ສາມາດໃຊ້ GPU ໄດ້."

msgid "No external ports are exposed, making the setup secure by default."
msgstr "ບໍ່ມີພອດພາຍນອກໃດໆຖືກເປີດເຜີຍ, ເຮັດໃຫ້ການຕັ້ງຄ່າປອດໄພໂດຍເລີ່ມຕົ້ນ."

msgid "`LibreTranslate Docker documentation`_"
msgstr "`ເອກະສານ LibreTranslate Docker`_"

msgid "Anubis Docker container integration"
msgstr "ການເຊື່ອມໂຍງ Anubis Docker container"

msgid ""
"`Anubis`_ is a web AI firewall utility to block AI scrapers and other "
"disruptive traffic on the server. It is typically needed for publicly open "
"Weblate installations to avoid excessive load caused by scraping."
msgstr ""
"`Anubis`_ ແມ່ນເຄື່ອງມື web AI firewall ເພື່ອບລັອກ AI scrapers ແລະ "
"ທຣາຟິກອື່ນໆທີ່ລົບກວນໃນເຊີບເວີ. ໂດຍທົ່ວໄປແລ້ວມັນຈຳເປັນສຳລັບການຕິດຕັ້ງ Weblate "
"ທີ່ເປີດສາທາລະນະເພື່ອຫຼີກເວັ້ນການໂຫຼດເກີນທີ່ເກີດຈາກການ scraping."

msgid "Anubis can be deployed using Docker Compose:"
msgstr "Anubis ສາມາດຖືກ deploy ໂດຍໃຊ້ Docker Compose:"

msgid ""
"The ``anubis-data`` volume in the above configuration is expected to "
"contain :file:`botPolicies.yaml` with a bot policy configured to your needs."
msgstr ""
"Volume ``anubis-data`` ໃນການຕັ້ງຄ່າຂ້າງເທິງນັ້ນ ຄວນຈະມີໄຟລ໌ :file:`botPolicies.yaml` "
"ພ້ອມກັບນະໂຍບາຍບັອດ (bot policy) ທີ່ຕັ້ງຄ່າຕາມຄວາມຕ້ອງການຂອງທ່ານ."

msgid ""
"At minimum, you need to adjust status codes as described in https://"
"anubis.techaro.lol/docs/admin/configuration/subrequest-auth."
msgstr ""
"ຢ່າງໜ້ອຍ, ທ່ານຈຳເປັນຕ້ອງປັບລະຫັດສະຖານະຕາມທີ່ອະທິບາຍໄວ້ໃນ https://anubis.techaro.lol/"
"docs/admin/configuration/subrequest-auth."

msgid ""
"It is also recommended to configure persistent storage backend as described "
"in https://anubis.techaro.lol/docs/admin/policies/#storage-backends."
msgstr ""
"ຍັງແນະນຳໃຫ້ຕັ້ງຄ່າ persistent storage backend ຕາມທີ່ອະທິບາຍໄວ້ໃນ https://"
"anubis.techaro.lol/docs/admin/policies/#storage-backends."

msgid "You can then turn on the Anubis usage in Weblate using:"
msgstr "ຈາກນັ້ນທ່ານສາມາດເປີດໃຊ້ການໃຊ້ Anubis ໃນ Weblate ໂດຍໃຊ້:"

msgid "Configuring PostgreSQL server"
msgstr "ການຕັ້ງຄ່າເຊີບເວີ PostgreSQL"

msgid ""
"The PostgreSQL container uses default PostgreSQL configuration and it won't "
"effectively utilize your CPU cores or memory. It is recommended to customize "
"the configuration to improve the performance."
msgstr ""
"ຄອນເທນເນີ PostgreSQL ໃຊ້ການຕັ້ງຄ່າ PostgreSQL ເລີ່ມຕົ້ນ ແລະ ມັນຈະບໍ່ໃຊ້ CPU cores ຫຼື "
"ໜ່ວຍຄວາມຈຳຂອງທ່ານຢ່າງມີປະສິດທິພາບ. ແນະນຳໃຫ້ປັບແຕ່ງການຕັ້ງຄ່າເພື່ອເພີ່ມປະສິດທິພາບ."

msgid ""
"The configuration can be adjusted as described in `Database Configuration` "
"at https://hub.docker.com/_/postgres. The configuration matching your "
"environment can be generated using https://pgtune.leopard.in.ua/."
msgstr ""
"ການຕັ້ງຄ່າສາມາດປັບປ່ຽນໄດ້ຕາມທີ່ອະທິບາຍໄວ້ໃນ `Database Configuration` ທີ່ https://"
"hub.docker.com/_/postgres. ການຕັ້ງຄ່າທີ່ກົງກັບສະພາບແວດລ້ອມຂອງທ່ານສາມາດຖືກສ້າງຂຶ້ນໂດຍໃຊ້ "
"https://pgtune.leopard.in.ua/."

msgid "Container internals"
msgstr "ສ່ວນພາຍໃນຄອນເທນເນີ"

msgid ""
"The container is using :program:`supervisor` to start individual services. "
"In case of :ref:`docker-scaling`, it only starts single service in a "
"container."
msgstr ""
"ຄອນເທນເນີກຳລັງໃຊ້ :program:`supervisor` ເພື່ອເລີ່ມຕົ້ນບໍລິການແຕ່ລະຢ່າງ. "
"ໃນກໍລະນີຂອງ :ref:`docker-scaling`, ມັນຈະເລີ່ມຕົ້ນພຽງໜຶ່ງບໍລິການໃນຄອນເທນເນີເທົ່ານັ້ນ."

msgid "To check the services status use:"
msgstr "ເພື່ອຕວດສອບສະຖານະບໍລິການ ໃຫ້ໃຊ້:"

msgid ""
"There are individual services for each Celery queue (see :ref:`celery` for "
"details). You can stop processing some tasks by stopping the appropriate "
"worker:"
msgstr ""
"ມີບໍລິການແຍກຕ່າງຫາກສຳລັບແຕ່ລະ Celery queue (ເບິ່ງ :ref:`celery` ສຳລັບລາຍລະອຽດ). "
"ທ່ານສາມາດຢຸດການປະມວນຜົນບາງ task ໂດຍການຢຸດ worker ທີ່ເໝາະສົມ:"

msgid "Installing on Kubernetes"
msgstr "ການຕິດຕັ້ງເທິງ Kubernetes"

msgid ""
"This guide is looking for contributors experienced with Kubernetes to cover "
"the setup in more details."
msgstr ""
"ຄູ່ມືນີ້ກຳລັງຊອກຫາຜູ້ປະກອບສ່ວນທີ່ມີປະສົບການກັບ Kubernetes ເພື່ອປົກຄຸມການຕັ້ງຄ່າໃນລາຍລະອຽດເພີ່ມເຕີມ."

msgid ""
"With the Kubernetes Helm chart you can get your personal Weblate instance up "
"and running in seconds. All of Weblate’s dependencies are already included. "
"PostgreSQL is set up as the default database and persistent volume claims "
"are used."
msgstr ""
"ດ້ວຍ Kubernetes Helm chart ທ່ານສາມາດເຮັດໃຫ້ Weblate instance "
"ສ່ວນຕົວຂອງທ່ານພ້ອມໃຊ້ງານໄດ້ໃນເວລາບໍ່ເທົ່າໃດວິນາທີ. dependencies ທັງໝົດຂອງ Weblate "
"ຖືກລວມໄວ້ແລ້ວ. PostgreSQL ຖືກຕັ້ງຄ່າເປັນຖານຂໍ້ມູນເລີ່ມຕົ້ນ ແລະ ມີການໃຊ້ persistent volume "
"claims."

msgid ""
"You can find the chart at <https://github.com/WeblateOrg/helm/> and it can "
"be displayed at <https://artifacthub.io/packages/helm/weblate/weblate>."
msgstr ""
"ທ່ານສາມາດພົບ chart ໄດ້ທີ່ <https://github.com/WeblateOrg/helm/> ແລະ "
"ມັນສາມາດສະແດງໄດ້ທີ່ <https://artifacthub.io/packages/helm/weblate/weblate>."

msgid ""
"For further configuration options, see :ref:`docker-environment` for full "
"list of environment variables."
msgstr ""
"ສຳລັບທາງເລືອກການຕັ້ງຄ່າເພີ່ມເຕີມ, ເບິ່ງ :ref:`docker-environment` "
"ສຳລັບລາຍການຕົວແປສະພາບແວດລ້ອມທັງໝົດ."

msgid "Installing on OpenShift"
msgstr "ການຕິດຕັ້ງເທິງ OpenShift"

msgid ""
"With the OpenShift Weblate template you can get your personal Weblate "
"instance up and running in seconds. All of Weblate’s dependencies are "
"already included. PostgreSQL is set up as the default database and "
"persistent volume claims are used."
msgstr ""
"ດ້ວຍ OpenShift Weblate template ທ່ານສາມາດເຮັດໃຫ້ Weblate instance "
"ສ່ວນຕົວຂອງທ່ານພ້ອມໃຊ້ງານໄດ້ໃນເວລາບໍ່ເທົ່າໃດວິນາທີ. dependencies ທັງໝົດຂອງ Weblate "
"ຖືກລວມໄວ້ແລ້ວ. PostgreSQL ຖືກຕັ້ງຄ່າເປັນຖານຂໍ້ມູນເລີ່ມຕົ້ນ ແລະ ມີການໃຊ້ persistent volume "
"claims."

msgid ""
"You can find the template at <https://github.com/WeblateOrg/openshift/>."
msgstr "ທ່ານສາມາດພົບ template ໄດ້ທີ່ <https://github.com/WeblateOrg/openshift/>."

msgid ""
"The following examples assume you have a working OpenShift v3.x environment, "
"with ``oc`` client tool installed. Please check the OpenShift documentation "
"for instructions."
msgstr ""
"ຕົວຢ່າງຕໍ່ໄປນີ້ສົມມຸດວ່າທ່ານມີສະພາບແວດລ້ອມ OpenShift v3.x ທີ່ເຮັດວຽກໄດ້, ພ້ອມກັບເຄື່ອງມື ``oc`` "
"client ທີ່ຕິດຕັ້ງໄວ້. ກະລຸນາເບິ່ງເອກະສານ OpenShift ສຳລັບຄຳແນະນຳ."

msgid ""
"The :file:`template.yml` is suited for running all components in OpenShift. "
"There is also :file:`template-external-postgresql.yml` which does not start "
"a PostgreSQL server and allows you to configure external PostgreSQL server."
msgstr ""
":file:`template.yml` ແມ່ນເໝາະສົມສຳລັບການຮັນສ່ວນປະກອບທັງໝົດໃນ OpenShift. "
"ຍັງມີ :file:`template-external-postgresql.yml` ເຊິ່ງບໍ່ໄດ້ເລີ່ມຕົ້ນເຊີບເວີ PostgreSQL ແລະ "
"ອະນຸຍາດໃຫ້ທ່ານຕັ້ງຄ່າເຊີບເວີ PostgreSQL ພາຍນອກໄດ້."

msgid "Web Console"
msgstr "Web Console"

msgid ""
"Copy the raw content from `template.yml <https://github.com/WeblateOrg/"
"openshift/blob/main/template.yml>`_ and import them into your project, then "
"use the :guilabel:`Create` button in the OpenShift web console to create "
"your application. The web console will prompt you for the values for all of "
"the parameters used by the template."
msgstr ""
"ຄັດລອກເນື້ອຫາ raw ຈາກ `template.yml <https://github.com/WeblateOrg/openshift/"
"blob/main/template.yml>`_ ແລະ ນຳເຂົ້າພວກມັນເຂົ້າໃນໂປຣເຈັກຂອງທ່ານ, "
"ຈາກນັ້ນໃຊ້ປຸ່ມ :guilabel:`ສ້າງ (Create)` ໃນ OpenShift web console "
"ເພື່ອສ້າງແອັບພລິເຄຊັນຂອງທ່ານ. web console ຈະຖາມຫາຄ່າສຳລັບພາຣາມິເຕີທັງໝົດທີ່ template ໃຊ້."

msgid "CLI"
msgstr "CLI"

msgid ""
"To upload the Weblate template to your current project’s template library, "
"pass the :file:`template.yml` file with the following command:"
msgstr ""
"ເພື່ອອັບໂຫຼດ Weblate template ໄປຍັງຫ້ອງສະໝຸດ template ຂອງໂປຣເຈັກປັດຈຸບັນຂອງທ່ານ, "
"ໃຫ້ຜ່ານໄຟລ໌ :file:`template.yml` ດ້ວຍຄຳສັ່ງຕໍ່ໄປນີ້:"

msgid ""
"The template is now available for selection using the web console or the CLI."
msgstr "ເປີດໃຫ້ເລືອກໃຊ້ເທມເພລັດໄດ້ແລ້ວ ຜ່ານທາງເວັບຄອນໂຊ ຫຼື CLI."

msgid "Parameters"
msgstr "ພາຣາມິເຕີ"

msgid ""
"The parameters that you can override are listed in the parameters section of "
"the template. You can list them with the CLI by using the following command "
"and specifying the file to be used:"
msgstr ""
"ພາຣາມິເຕີທີ່ທ່ານສາມາດປັບປ່ຽນໄດ້ຈະຖືກລະບຸໄວ້ໃນສ່ວນພາຣາມິເຕີຂອງ template. "
"ທ່ານສາມາດສະແດງລາຍການພວກມັນດ້ວຍ CLI ໂດຍໃຊ້ຄຳສັ່ງຕໍ່ໄປນີ້ ແລະ ລະບຸໄຟລ໌ທີ່ຈະໃຊ້:"

msgid "Provisioning"
msgstr "ການຈັດຫາ (Provisioning)"

msgid ""
"You can also use the CLI to process templates and use the configuration that "
"is generated to create objects immediately."
msgstr ""
"ທ່ານຍັງສາມາດໃຊ້ CLI ເພື່ອປະມວນຜົນ templates ແລະ ໃຊ້ການຕັ້ງຄ່າທີ່ຖືກສ້າງຂຶ້ນເພື່ອສ້າງ object ທັນທີ."

msgid ""
"The Weblate instance should be available after successful migration and "
"deployment at the specified ``WEBLATE_SITE_DOMAIN`` parameter."
msgstr ""
"Weblate instance ຄວນຈະພ້ອມໃຊ້ງານຫຼັງຈາກການຍົກລະດັບ ແລະ deployment ທີ່ສຳເລັດຜົນ "
"ທີ່ພາຣາມິເຕີ ``WEBLATE_SITE_DOMAIN`` ທີ່ລະບຸໄວ້."

msgid ""
"After container setup, you can sign in as `admin` user with password "
"provided in ``WEBLATE_ADMIN_PASSWORD``, or a random password generated on "
"first start if that was not set."
msgstr ""
"ຫຼັງຈາກຕັ້ງຄ່າຄອນເທນເນີ, ທ່ານສາມາດເຂົ້າສູ່ລະບົບໃນຖານະຜູ້ໃຊ້ `admin` ດ້ວຍລະຫັດຜ່ານທີ່ໃຫ້ໄວ້ໃນ "
"``WEBLATE_ADMIN_PASSWORD``, ຫຼື "
"ລະຫັດຜ່ານແບບສຸ່ມທີ່ຖືກສ້າງຂຶ້ນໃນການເລີ່ມຕົ້ນຄັ້ງທຳອິດຖ້າບໍ່ໄດ້ຕັ້ງຄ່າໄວ້."

msgid ""
"To reset `admin` password, restart the container with "
"``WEBLATE_ADMIN_PASSWORD`` set to new password in the respective ``Secret``."
msgstr ""
"ເພື່ອຣີເຊັດລະຫັດຜ່ານ `admin`, ໃຫ້ restart ຄອນເທນເນີດ້ວຍ ``WEBLATE_ADMIN_PASSWORD`` "
"ທີ່ຕັ້ງເປັນລະຫັດຜ່ານໃໝ່ໃນ ``Secret`` ທີ່ກ່ຽວຂ້ອງ."

msgid "Eliminate"
msgstr "ການກຳຈັດ (Eliminate)"

msgid ""
"By processing the template a respective ``ConfigMap`` will be created and "
"which can be used to customize the Weblate image. The ``ConfigMap`` is "
"directly mounted as environment variables and triggers a new deployment "
"every time it is changed. For further configuration options, "
"see :ref:`docker-environment` for full list of environment variables."
msgstr ""
"ໂດຍການປະມວນຜົນ template, ``ConfigMap`` ທີ່ກ່ຽວຂ້ອງຈະຖືກສ້າງຂຶ້ນ ແລະ ສາມາດໃຊ້ເພື່ອປັບແຕ່ງ "
"Weblate image. ``ConfigMap`` ຈະຖືກ mount ໂດຍກົງເປັນຕົວແປສະພາບແວດລ້ອມ ແລະ "
"ກະຕຸ້ນໃຫ້ມີການ deployment ໃໝ່ທຸກຄັ້ງທີ່ມີການປ່ຽນແປງ. ສຳລັບທາງເລືອກການຕັ້ງຄ່າເພີ່ມເຕີມ, "
"ເບິ່ງ :ref:`docker-environment` ສຳລັບລາຍການຕົວແປສະພາບແວດລ້ອມທັງໝົດ."

msgid "Installing from sources"
msgstr "ການຕິດຕັ້ງຈາກແຫຼ່ງລະຫັດ (Source)"

msgid ""
"Please follow the installation instructions for your system first up to "
"installing Weblate:"
msgstr ""
"ກະລຸນາປະຕິບັດຕາມຄຳແນະນຳການຕິດຕັ້ງສຳລັບລະບົບຂອງທ່ານກ່ອນ ຈົນເຖິງຂັ້ນຕອນການຕິດຕັ້ງ Weblate:"

msgid ""
"Grab the latest Weblate sources using Git (or download a tarball and unpack "
"that):"
msgstr "ເອົາ Weblate sources ເວີຊັນຫຼ້າສຸດໂດຍໃຊ້ Git (ຫຼື ດາວໂຫຼດ tarball ແລະ ແຕກໄຟລ໌ນັ້ນ):"

msgid ""
"Alternatively you can use released archives. You can download them from our "
"website <https://weblate.org/>. Those downloads are cryptographically "
"signed, please see :ref:`verify`."
msgstr ""
"ນອກຈາກນີ້, ທ່ານສາມາດໃຊ້ Archives ທີ່ປ່ອຍອອກມາ. "
"ທ່ານສາມາດດາວໂຫຼດພວກມັນໄດ້ຈາກເວັບໄຊຂອງພວກເຮົາ <https://weblate.org/>. "
"ການດາວໂຫຼດເຫຼົ່ານັ້ນມີການເຊັນຊື່ທາງການເຂົ້າລະຫັດ, ກະລຸນາເບິ່ງ :ref:`verify`."

msgid "Install current Weblate code into the Python environment:"
msgstr "ຕິດຕັ້ງລະຫັດ Weblate ປັດຈຸບັນເຂົ້າໃນ Python environment:"

msgid ""
"If you intend to run the testsuite from the source checkout, install the "
"development dependencies as described in :ref:`local-tests`."
msgstr ""
"ຖ້າທ່ານຕັ້ງໃຈຈະຮັນ testsuite ຈາກ source checkout, ໃຫ້ຕິດຕັ້ງ development dependencies "
"ຕາມທີ່ອະທິບາຍໄວ້ໃນ :ref:`local-tests`."

msgid ""
"Copy :file:`weblate/settings_example.py` to :file:`weblate/settings.py`."
msgstr ""
"ສຳເນົາ :file:`weblate/settings_example.py` ໄປຍັງ :file:`weblate/settings.py`."

msgid "Create the database used by Weblate, see :ref:`database-setup`."
msgstr "ສ້າງຖານຂໍ້ມູນທີ່ Weblate ໃຊ້, ເບິ່ງ :ref:`database-setup`."

msgid ""
"Build Django tables, static files and initial data (see :ref:`tables-setup` "
"and :ref:`static-files`):"
msgstr ""
"Build Django tables, ໄຟລ໌ static ແລະ ຂໍ້ມູນເລີ່ມຕົ້ນ (ເບິ່ງ :ref:`tables-setup` "
"ແລະ :ref:`static-files`):"

msgid "This step should be repeated whenever you update the repository."
msgstr "ຂັ້ນຕອນນີ້ຄວນຖືກເຮັດຊ້ຳທຸກຄັ້ງທີ່ທ່ານອັບເດດ repository."

msgid "Packaging Weblate for distributions"
msgstr "ການຫຸ້ມຫໍ່ Weblate ສຳລັບການແຈກຢາຍ"

msgid ""
"The dependency versions in :file:`pyproject.toml` describe the runtime "
"environment tested by the Weblate project. They are intentionally strict for "
"installs from PyPI and for the Weblate release process, because Weblate "
"cannot validate every dependency-version combination covered by wider "
"version ranges."
msgstr ""
"ເວີຊັນ dependency ໃນ :file:`pyproject.toml` ອະທິບາຍ runtime environment "
"ທີ່ທົດສອບໂດຍໂປຣເຈັກ Weblate. ພວກມັນມີຄວາມເຂັ້ມງວດໂດຍເຈດຕະນາສຳລັບການຕິດຕັ້ງຈາກ PyPI ແລະ "
"ສຳລັບຂະບວນການປ່ອຍ Weblate, ເພາະ Weblate ບໍ່ສາມາດກວດສອບທຸກໆການປະສົມປະສານລະຫວ່າງ "
"dependency ແລະ ເວີຊັນທີ່ກວມເອົາໂດຍຊ່ວງເວີຊັນທີ່ກວ້າງກວ່າ."

msgid ""
"Distribution packages can replace those Python packages with versions from "
"the distribution package set. When doing so, run Weblate's test suite "
"against the packaged dependency set and treat passing tests as the "
"compatibility signal for the distribution package."
msgstr ""
"Distribution packages ສາມາດປ່ຽນແທນ Python packages ເຫຼົ່ານັ້ນດ້ວຍເວີຊັນຈາກຊຸດ "
"distribution package. ເມື່ອເຮັດດັ່ງນັ້ນ, ໃຫ້ຮັນ Weblate test suite ຕໍ່ກັບຊຸດ dependency "
"ທີ່ຫຸ້ມຫໍ່ ແລະ ຖືວ່າການທົດສອບທີ່ຜ່ານເປັນສັນຍານຄວາມເຂົ້າກັນໄດ້ສຳລັບ distribution package."

msgid ""
"Keep Weblate's tightly coupled companion packages in sync with the Weblate "
"release:"
msgstr ""
"ໃຫ້ຮັກສາ companion packages ທີ່ເຊື່ອມໂຍງຢ່າງໃກ້ຊິດຂອງ Weblate ໃຫ້ເປັນເວີຊັນດຽວກັນກັບການປ່ອຍ "
"Weblate:"

msgid ""
"Mismatched versions of these packages are more likely to break at runtime or "
"during tests than other Python dependency substitutions."
msgstr ""
"ເວີຊັນທີ່ບໍ່ກົງກັນຂອງ package ເຫຼົ່ານີ້ມີໂອກາດສູງທີ່ຈະເຮັດໃຫ້ເກີດບັນຫາໃນລະຫວ່າງ runtime ຫຼື "
"ໃນລະຫວ່າງການທົດສອບ ຫຼາຍກ່ວາການທົດແທນ Python dependency ອື່ນໆ."

msgid ""
"See :ref:`local-tests` for test setup and :ref:`release-cycle` for Weblate's "
"release cadence."
msgstr ""
"ເບິ່ງ :ref:`local-tests` ສຳລັບການຕັ້ງຄ່າການທົດສອບ ແລະ :ref:`release-cycle` "
"ສຳລັບຮອບວຽນການປ່ອຍຂອງ Weblate."

msgid ""
"Adjust the values in the new :file:`settings.py` file to your liking. You "
"will need to provide at least the database credentials and Django secret "
"key, but you will want more changes for production setup, "
"see :ref:`configuration`."
msgstr ""
"ປັບຄ່າໃນໄຟລ໌ :file:`settings.py` ໃໝ່ ຕາມທີ່ທ່ານຕ້ອງການ. "
"ທ່ານຈະຕ້ອງລະບຸຢ່າງໜ້ອຍຂໍ້ມູນຢັ້ງຢືນຖານຂໍ້ມູນ ແລະ Django secret key, "
"ແຕ່ທ່ານອາດຈະຕ້ອງການການປ່ຽນແປງເພີ່ມເຕີມສຳລັບການຕັ້ງຄ່າ production, "
"ເບິ່ງ :ref:`configuration`."

msgid "Hardware requirements"
msgstr "ຄວາມຕ້ອງການດ້ານຮາດແວ"

msgid ""
"Weblate should run on any contemporary hardware without problems, the "
"following is the minimal configuration required to run Weblate on a single "
"host (Weblate, database and web server):"
msgstr ""
"Weblate ຄວນຈະຮັນໄດ້ເທິງຮາດແວສະໄໝໃໝ່ໂດຍບໍ່ມີບັນຫາ, ຕໍ່ໄປນີ້ແມ່ນການຕັ້ງຄ່າຂັ້ນຕ່ຳທີ່ຈຳເປັນເພື່ອຮັນ "
"Weblate ເທິງໂຮສຕ໌ດຽວ (Weblate, ຖານຂໍ້ມູນ ແລະ ເວັບເຊີບເວີ):"

msgid "3 GB of RAM"
msgstr "RAM 3 GB"

msgid "2 CPU cores"
msgstr "2 CPU cores"

msgid "1 GB of storage space"
msgstr "ພື້ນທີ່ຈັດເກັບຂໍ້ມູນ 1 GB"

msgid ""
"Actual requirements for your installation of Weblate vary heavily based on "
"the size of the translations managed in it."
msgstr ""
"ຄວາມຕ້ອງການທີ່ແທ້ຈິງສຳລັບການຕິດຕັ້ງ Weblate "
"ຂອງທ່ານຈະແຕກຕ່າງກັນຢ່າງຫຼວງຫຼາຍໂດຍອີງໃສ່ຂະໜາດຂອງການແປທີ່ຈັດການຢູ່ພາຍໃນນັ້ນ."

msgid "Memory usage"
msgstr "ການໃຊ້ງານໜ່ວຍຄວາມຈຳ"

msgid ""
"The more memory the better - it is used for caching on all levels (file "
"system, database and Weblate). For hundreds of translation components, at "
"least 4 GB of RAM is recommended."
msgstr ""
"ມີໜ່ວຍຄວາມຈຳຫຼາຍເທົ່າໃດກໍຍິ່ງດີ - ມັນຖືກໃຊ້ສຳລັບການ caching ໃນທຸກລະດັບ (ລະບົບໄຟລ໌, ຖານຂໍ້ມູນ ແລະ "
"Weblate). ສຳລັບສ່ວນປະກອບການແປຫຼາຍຮ້ອຍລາຍການ, ແນະນຳໃຫ້ມີ RAM ຢ່າງໜ້ອຍ 4 GB."

msgid ""
"For systems with less memory than recommended, :ref:`minimal-celery` is "
"recommended."
msgstr "ສຳລັບລະບົບທີ່ມີໜ່ວຍຄວາມຈຳໜ້ອຍກວ່າທີ່ແນະນຳ, ແນະນຳໃຫ້ໃຊ້ :ref:`minimal-celery`."

msgid "CPU usage"
msgstr "ການໃຊ້ງານ CPU"

msgid "Many concurrent users increase the amount of needed CPU cores."
msgstr "ຜູ້ໃຊ້ຫຼາຍຄົນທີ່ໃຊ້ງານພ້ອມກັນຈະເພີ່ມຈຳນວນ CPU cores ທີ່ຈຳເປັນ."

msgid "Storage usage"
msgstr "ການໃຊ້ງານພື້ນທີ່ຈັດເກັບຂໍ້ມູນ"

msgid ""
"The typical database storage usage is around 300 MB per 1 million hosted "
"words."
msgstr "ການໃຊ້ພື້ນທີ່ຈັດເກັບຖານຂໍ້ມູນໂດຍທົ່ວໄປແມ່ນປະມານ 300 MB ຕໍ່ 1 ລ້ານຄຳທີ່ຝາກໄວ້."

msgid ""
"Storage space needed for cloned repositories varies, but Weblate tries to "
"keep their size minimal by doing shallow clones."
msgstr ""
"ພື້ນທີ່ຈັດເກັບຂໍ້ມູນທີ່ຈຳເປັນສຳລັບ cloned repositories ຈະແຕກຕ່າງກັນ, ແຕ່ Weblate "
"ພະຍາຍາມຮັກສາຂະໜາດຂອງມັນໃຫ້ໜ້ອຍທີ່ສຸດໂດຍການເຮັດ shallow clones."

#, fuzzy
#| msgid "Translate page performance."
msgid "Storage performance"
msgstr "ປະສິດທິພາບໜ້າແປ."

msgid ""
"Version control operations perform many filesystem metadata lookups. "
"The :file:`vcs` subdirectory in :setting:`DATA_DIR` therefore needs low read "
"latency; storage with slow metadata access can make operations such "
"as :command:`git status` take a long time even when its bulk throughput is "
"good. Keep :setting:`CACHE_DIR` on low-latency local or temporary storage "
"when possible."
msgstr ""

msgid ""
"The deployment checks measure metadata lookup latency for both locations and "
"warn when the median latency exceeds 10 milliseconds. This is an approximate "
"point-in-time measurement affected by filesystem and system load. "
"Rerun :command:`weblate check --deploy` before changing the storage "
"configuration."
msgstr ""

msgid "Nodes"
msgstr "Nodes"

msgid ""
"For small and medium-sized sites (millions of hosted words), all Weblate "
"components (see :ref:`architecture`) can be run on a single node."
msgstr ""
"ສຳລັບເວັບໄຊຂະໜາດນ້ອຍ ແລະ ຂະໜາດກາງ (ຫຼາຍລ້ານຄຳທີ່ຝາກໄວ້), ສ່ວນປະກອບທັງໝົດຂອງ Weblate "
"(ເບິ່ງ :ref:`architecture`) ສາມາດຮັນເທິງ node ດຽວໄດ້."

msgid ""
"When you grow to hundreds of millions of hosted words, it is recommended to "
"have a dedicated node for database (see :ref:`database-setup`)."
msgstr ""
"ເມື່ອທ່ານເຕີບໂຕໄປເຖິງຫຼາຍຮ້ອຍລ້ານຄຳທີ່ຝາກໄວ້, ແນະນຳໃຫ້ມີ node ສະເພາະສຳລັບຖານຂໍ້ມູນ "
"(ເບິ່ງ :ref:`database-setup`)."

msgid "After installation"
msgstr "ຫຼັງຈາກການຕິດຕັ້ງ"

msgid ""
"Congratulations, your Weblate server is now running and you can start using "
"it."
msgstr "ຂໍສະແດງຄວາມຍິນດີ, ເຊີບເວີ Weblate ຂອງທ່ານກຳລັງແລ່ນຢູ່ແລ້ວ ແລະ ທ່ານສາມາດເລີ່ມໃຊ້ງານໄດ້."

msgid "You can now access Weblate on ``http://localhost:8000/``."
msgstr "ດຽວນີ້ທ່ານສາມາດເຂົ້າເຖິງ Weblate ໄດ້ທີ່ ``http://localhost:8000/``."

msgid ""
"Sign in with admin credentials obtained during installation or register with "
"new users."
msgstr "ເຂົ້າສູ່ລະບົບດ້ວຍ admin credentials ທີ່ໄດ້ໃນລະຫວ່າງການຕິດຕັ້ງ ຫຼື ລົງທະບຽນດ້ວຍຜູ້ໃຊ້ໃໝ່."

msgid ""
"You can now run Weblate commands using :command:`weblate` command when "
"Weblate Python environment is active, see :ref:`manage`."
msgstr ""
"ດຽວນີ້ທ່ານສາມາດຮັນຄຳສັ່ງ Weblate ໂດຍໃຊ້ຄຳສັ່ງ :command:`weblate` ເມື່ອ Weblate Python "
"environment ເປີດໃຊ້ງານຢູ່, ເບິ່ງ :ref:`manage`."

msgid "You can stop the test server with :kbd:`Ctrl+C`."
msgstr "ທ່ານສາມາດຢຸດເຊີບເວີທົດສອບໄດ້ດ້ວຍ :kbd:`Ctrl+C`."

msgid ""
"Review potential issues with your installation either on ``/manage/"
"performance/`` URL (see :ref:`manage-performance`) or "
"using :command:`weblate check --deploy`, see :ref:`production`."
msgstr ""
"ທົບທວນບັນຫາທີ່ອາດເກີດຂຶ້ນກັບການຕິດຕັ້ງຂອງທ່ານບໍ່ວ່າຈະຢູ່ URL ``/manage/performance/`` "
"(ເບິ່ງ :ref:`manage-performance`) ຫຼື ໂດຍໃຊ້ :command:`weblate check --deploy`, "
"ເບິ່ງ :ref:`production`."

msgid "Adding translation"
msgstr "ການເພີ່ມການແປ"

msgid ""
"Open the admin interface (``http://localhost:8000/create/project/``) and "
"create the project you want to translate. See :ref:`project` for more "
"details."
msgstr ""
"ເປີດ admin interface (``http://localhost:8000/create/project/``) ແລະ "
"ສ້າງໂປຣເຈັກທີ່ທ່ານຕ້ອງການແປ. ເບິ່ງ :ref:`project` ສຳລັບລາຍລະອຽດເພີ່ມເຕີມ."

msgid "All you need to specify here is the project name and its website."
msgstr "ທັງໝົດທີ່ທ່ານຕ້ອງລະບຸທີ່ນີ້ແມ່ນຊື່ໂປຣເຈັກ ແລະ ເວັບໄຊຂອງມັນ."

msgid ""
"Create a component which is the real object for translation - it points to "
"the VCS repository, and selects which files to translate. "
"See :ref:`component` for more details."
msgstr ""
"ສ້າງ component ເຊິ່ງເປັນວັດຖຸທີ່ແທ້ຈິງສຳລັບການແປ - ມັນຊີ້ໄປຍັງ VCS repository, ແລະ "
"ເລືອກໄຟລ໌ໃດທີ່ຈະແປ. ເບິ່ງ :ref:`component` ສຳລັບລາຍລະອຽດເພີ່ມເຕີມ."

msgid ""
"The important fields here are: :ref:`component-name`, :ref:`component-repo`, "
"and :ref:`component-filemask` for finding translatable files. Weblate "
"supports a wide range of formats "
"including :ref:`gettext`, :ref:`aresource`, :ref:`apple`, :ref:`javaprop`, :ref:`stringsdict` "
"or :ref:`fluent`, see :ref:`formats` for more details."
msgstr ""
"ຊ່ອງຂໍ້ມູນທີ່ສຳຄັນທີ່ນີ້ແມ່ນ: :ref:`component-name`, :ref:`component-repo`, "
"ແລະ :ref:`component-filemask` ສຳລັບການຄົ້ນຫາໄຟລ໌ທີ່ສາມາດແປໄດ້. Weblate "
"ຮອງຮັບຮູບແບບຫຼາກຫຼາຍລວມທັງ :ref:`gettext`, :ref:`aresource`, :ref:`apple`, :ref:`javaprop`, :ref:`stringsdict` "
"ຫຼື :ref:`fluent`, ເບິ່ງ :ref:`formats` ສຳລັບລາຍລະອຽດເພີ່ມເຕີມ."

msgid ""
"Once the above is completed (it can be lengthy process depending on the size "
"of your VCS repository, and number of messages to translate), you can start "
"translating."
msgstr ""
"ເມື່ອຂັ້ນຕອນຂ້າງເທິງສຳເລັດ (ມັນອາດເປັນຂະບວນການທີ່ຍາວນານຂຶ້ນຢູ່ກັບຂະໜາດຂອງ VCS repository "
"ຂອງທ່ານ, ແລະ ຈຳນວນຂໍ້ຄວາມທີ່ຈະແປ), ທ່ານສາມາດເລີ່ມການແປໄດ້."

msgid "Configuring Weblate"
msgstr "ການຕັ້ງຄ່າ Weblate"

msgid ""
"The following assumes the Python environment used by Weblate is activated "
"(by executing ``. ~/weblate-env/bin/activate``). If not, specify the full "
"path to the :command:`weblate` command as ``~/weblate-env/bin/weblate``."
msgstr ""
"ຕໍ່ໄປນີ້ສົມມຸດວ່າ Python environment ທີ່ໃຊ້ໂດຍ Weblate ຖືກເປີດໃຊ້ງານຢູ່ (ໂດຍການປະຕິບັດ ``. ~/"
"weblate-env/bin/activate``). ຖ້າບໍ່ແມ່ນ, "
"ໃຫ້ລະບຸເສັ້ນທາງເຕັມໄປຍັງຄຳສັ່ງ :command:`weblate` ເປັນ ``~/weblate-env/bin/weblate``."

msgid ""
"Copy the file :file:`~/weblate-env/lib/python3.9/site-packages/weblate/"
"settings_example.py` to :file:`~/weblate-env/lib/python3.9/site-packages/"
"weblate/settings.py`."
msgstr ""
"ສຳເນົາໄຟລ໌ :file:`~/weblate-env/lib/python3.9/site-packages/weblate/"
"settings_example.py` ໄປຍັງ :file:`~/weblate-env/lib/python3.9/site-packages/"
"weblate/settings.py`."

msgid ""
"Create the database and its structure for Weblate (the example settings use "
"PostgreSQL, check :ref:`database-setup` for a production-ready setup):"
msgstr ""
"ສ້າງຖານຂໍ້ມູນ ແລະ ໂຄງສ້າງສຳລັບ Weblate (ການຕັ້ງຄ່າຕົວຢ່າງໃຊ້ PostgreSQL, "
"ເບິ່ງ :ref:`database-setup` ສຳລັບການຕັ້ງຄ່າທີ່ພ້ອມສຳລັບ production):"

msgid ""
"Create an administrator user account ``admin``, generate its password, and "
"copy it to the clipboard; remember to save it for later use:"
msgstr ""
"ສ້າງບັນຊີຜູ້ໃຊ້ຜູ້ບໍລິຫານ ``admin``, ສ້າງລະຫັດຜ່ານ, ແລະ ຄັດລອກມັນໄວ້ໃນ clipboard; "
"ຈື່ໄວ້ວ່າໃຫ້ບັນທຶກມັນໄວ້ໃຊ້ໃນພາຍຫຼັງ:"

msgid ""
"If you previously missed/lost the admin password, you can generate a new one "
"with the following command:"
msgstr "ຖ້າທ່ານພາດ/ເຮັດລະຫັດຜ່ານ admin ຫາຍໄປກ່ອນໜ້ານີ້, ທ່ານສາມາດສ້າງອັນໃໝ່ໄດ້ດ້ວຍຄຳສັ່ງຕໍ່ໄປນີ້:"

msgid ""
"Collect the static files for your web server (see :ref:`server` "
"and :ref:`static-files`):"
msgstr ""
"ເກັບກຳໄຟລ໌ static ສຳລັບເວັບເຊີບເວີຂອງທ່ານ (ເບິ່ງ :ref:`server` ແລະ :ref:`static-"
"files`):"

msgid ""
"Start the Celery workers. This is not necessary for development purposes, "
"but strongly recommended otherwise. :ref:`celery` has more info:"
msgstr ""
"ເລີ່ມຕົ້ນ Celery workers. ສິ່ງນີ້ບໍ່ຈຳເປັນສຳລັບຈຸດປະສົງການພັດທະນາ, "
"ແຕ່ແນະນຳຢ່າງຍິ່ງຖ້າບໍ່ແມ່ນ. :ref:`celery` ມີຂໍ້ມູນເພີ່ມເຕີມ:"

msgid ""
"Start the development server (:ref:`server` details a production setup):"
msgstr "ເລີ່ມຕົ້ນເຊີບເວີການພັດທະນາ (:ref:`server` ມີລາຍລະອຽດການຕັ້ງຄ່າ production):"

msgid "Python modules"
msgstr "Python modules"

msgid "We're installing Weblate in a separate Python environment."
msgstr "ພວກເຮົາກຳລັງຕິດຕັ້ງ Weblate ໃນ Python environment ແຍກຕ່າງຫາກ."

msgid "Create the Python environment for Weblate:"
msgstr "ສ້າງ Python environment ສຳລັບ Weblate:"

msgid "Activate the Python environment for Weblate:"
msgstr "ເປີດໃຊ້ Python environment ສຳລັບ Weblate:"

msgid "Install Weblate including all optional dependencies:"
msgstr "ຕິດຕັ້ງ Weblate ລວມທັງທາງເລືອກ dependencies ທັງໝົດ:"

msgid ""
"Please check :ref:`python-deps` for fine-tuning of optional dependencies."
msgstr ""
"ກະລຸນາກວດສອບ :ref:`python-deps` ສຳລັບການປັບແຕ່ງລະອຽດຂອງທາງເລືອກ dependencies."

msgid "`Using Python environments`_"
msgstr "`ການໃຊ້ Python environments`_"

msgid "System requirements"
msgstr "ຄວາມຕ້ອງການຂອງລະບົບ"

msgid ""
"Install the dependencies needed to build the Python modules "
"(see :ref:`requirements`):"
msgstr ""
"ຕິດຕັ້ງ dependencies ທີ່ຈຳເປັນເພື່ອ build Python modules (ເບິ່ງ :ref:`requirements`):"

msgid ""
"Install wanted optional dependencies depending on features you intend to use "
"(see :ref:`python-deps`):"
msgstr ""
"ຕິດຕັ້ງທາງເລືອກ dependencies ທີ່ຕ້ອງການໂດຍອີງຕາມຟີເຈີທີ່ທ່ານຕັ້ງໃຈຈະໃຊ້ (ເບິ່ງ :ref:`python-"
"deps`):"

msgid ""
"Optionally install software for running production server, "
"see :ref:`server`, :ref:`database-setup`, :ref:`celery`. Depending on size "
"of your installation you might want to run these components on dedicated "
"servers."
msgstr ""
"ທາງເລືອກໃນການຕິດຕັ້ງຊອບແວສຳລັບຮັນເຊີບເວີ production, "
"ເບິ່ງ :ref:`server`, :ref:`database-setup`, :ref:`celery`. "
"ຂຶ້ນຢູ່ກັບຂະໜາດຂອງການຕິດຕັ້ງຂອງທ່ານ, ທ່ານອາດຕ້ອງການຮັນສ່ວນປະກອບເຫຼົ່ານີ້ເທິງເຊີບເວີສະເພາະ."

msgid "The local installation instructions:"
msgstr "ຄຳແນະນຳການຕິດຕັ້ງໃນທ້ອງຖິ່ນ:"

msgid "uv package manager"
msgstr "uv package manager"

msgid "We're using uv package manager to install Weblate."
msgstr "ພວກເຮົາກຳລັງໃຊ້ uv package manager ເພື່ອຕິດຕັ້ງ Weblate."

msgid ""
"`Installing uv <https://docs.astral.sh/uv/getting-started/installation/>`_"
msgstr ""
"`ການຕິດຕັ້ງ uv <https://docs.astral.sh/uv/getting-started/installation/>`_"

msgid "Installing on Debian and Ubuntu"
msgstr "ການຕິດຕັ້ງເທິງ Debian ແລະ Ubuntu"

msgid "Installing on macOS"
msgstr "ການຕິດຕັ້ງເທິງ macOS"

msgid "Installing on RedHat, Fedora and CentOS"
msgstr "ການຕິດຕັ້ງເທິງ RedHat, Fedora ແລະ CentOS"

msgid "Installing on SUSE and openSUSE"
msgstr "ການຕິດຕັ້ງເທິງ SUSE ແລະ openSUSE"

msgid "Language definitions"
msgstr "ຄຳນິຍາມພາສາ"

msgid ""
"To present different translations properly, info about language name, text "
"direction, plural definitions and language code are needed."
msgstr ""
"ເພື່ອສະແດງການແປທີ່ແຕກຕ່າງກັນຢ່າງຖືກຕ້ອງ, ຂໍ້ມູນກ່ຽວກັບຊື່ພາສາ, ທິດທາງຂໍ້ຄວາມ, ຄຳນິຍາມພະຫຸພົດ ແລະ "
"ລະຫັດພາສາແມ່ນມີຄວາມຈຳເປັນ."

msgid "Built-in language definitions"
msgstr "ຄຳນິຍາມພາສາໃນຕົວ"

msgid ""
"Definitions for about 800 languages are included in Weblate and the list is "
"extended in every release. Whenever Weblate is upgraded (more specifically "
"whenever :wladmin:`migrate` is executed, see :ref:`generic-upgrade-"
"instructions`) the database of languages is updated to include all language "
"definitions shipped in Weblate."
msgstr ""
"ຄຳນິຍາມສຳລັບພາສາປະມານ 800 ພາສາຖືກລວມໄວ້ໃນ Weblate ແລະ "
"ລາຍການຈະຖືກຂະຫຍາຍອອກໃນທຸກເວີຊັນ. ເມື່ອໃດກໍຕາມທີ່ Weblate ຖືກຍົກລະດັບ "
"(ໂດຍສະເພາະເມື່ອ :wladmin:`migrate` ຖືກປະຕິບັດ, ເບິ່ງ :ref:`generic-upgrade-"
"instructions`) ຖານຂໍ້ມູນຂອງພາສາຈະຖືກອັບເດດເພື່ອລວມເອົາຄຳນິຍາມພາສາທັງໝົດທີ່ສົ່ງມາໃນ Weblate."

msgid ""
"This feature can be disabled using :setting:`UPDATE_LANGUAGES`. You can also "
"enforce updating the database to match Weblate built-in data "
"using :wladmin:`setuplang`."
msgstr ""
"ຟີເຈີນີ້ສາມາດຖືກປິດໃຊ້ງານໂດຍໃຊ້ :setting:`UPDATE_LANGUAGES`. "
"ທ່ານຍັງສາມາດບັງຄັບໃຫ້ອັບເດດຖານຂໍ້ມູນເພື່ອໃຫ້ກົງກັບຂໍ້ມູນໃນຕົວຂອງ Weblate "
"ໂດຍໃຊ້ :wladmin:`setuplang`."

msgid ""
"`Current language definitions <https://github.com/WeblateOrg/language-data/"
"blob/main/languages.csv>`_"
msgstr ""
"`ຄຳນິຍາມພາສາປັດຈຸບັນ <https://github.com/WeblateOrg/language-data/blob/main/"
"languages.csv>`_"

msgid "Parsing language codes"
msgstr "ການແຍກລະຫັດພາສາ (Parsing)"

msgid ""
"While parsing translations, Weblate attempts to map language code (usually "
"the ISO 639-1 one) from the :ref:`component-filemask` to any existing "
"language object."
msgstr ""
"ໃນລະຫວ່າງການແຍກການແປ, Weblate ພະຍາຍາມຈັບຄູ່ລະຫັດພາສາ (ປົກກະຕິແມ່ນ ISO 639-1) "
"ຈາກ :ref:`component-filemask` ກັບ object ພາສາທີ່ມີຢູ່ໃດໜຶ່ງ."

msgid ""
"You can further adjust this mapping at project level by :ref:`project-"
"language_aliases`."
msgstr ""
"ທ່ານສາມາດປັບການຈັບຄູ່ນີ້ເພີ່ມເຕີມໃນລະດັບໂປຣເຈັກໂດຍ :ref:`project-language_aliases`."

msgid ""
"If no exact match can be found, an attempt will be made to best fit it into "
"an existing language. Following steps are tried:"
msgstr ""
"ຖ້າບໍ່ພົບການຈັບຄູ່ທີ່ແນ່ນອນ, ຈະມີຄວາມພະຍາຍາມທີ່ຈະເຮັດໃຫ້ມັນເໝາະສົມທີ່ສຸດກັບພາສາທີ່ມີຢູ່. "
"ຂັ້ນຕອນຕໍ່ໄປນີ້ຈະຖືກທົດລອງ:"

msgid "Case insensitive lookups."
msgstr "ການຄົ້ນຫາແບບບໍ່ສົນໃຈຕົວພິມນ້ອຍ-ໃຫຍ່."

msgid "Normalizing underscores and dashes."
msgstr "ການປັບລະດັບ underscores ແລະ dashes ໃຫ້ເປັນມາດຕະຖານ."

msgid "Looking up built-in language aliases."
msgstr "ການຄົ້ນຫາ aliases ພາສາໃນຕົວ."

msgid "Looking up by language name."
msgstr "ການຄົ້ນຫາໂດຍຊື່ພາສາ."

msgid ""
"Ignoring the default country code for a given language—choosing ``cs`` "
"instead of ``cs_CZ``."
msgstr "ການລະເວັ້ນລະຫັດປະເທດເລີ່ມຕົ້ນສຳລັບພາສາທີ່ກຳນົດ - ເລືອກ ``cs`` ແທນ ``cs_CZ``."

msgid ""
"Should that also fail, a new language definition will be created using the "
"defaults (left to right text direction, one plural). The automatically "
"created language with code ``xx_XX`` will be named as :guilabel:`xx_XX "
"(generated)`. You might want to change this in the admin interface later, "
"(see :ref:`changing-languages`) and report it to the issue tracker "
"(see :ref:`contributing`), so that the proper definition can be added to the "
"upcoming Weblate release."
msgstr ""
"ຖ້າສິ່ງນັ້ນລົ້ມເຫຼວເຊັ່ນກັນ, ຄຳນິຍາມພາສາໃໝ່ຈະຖືກສ້າງຂຶ້ນໂດຍໃຊ້ຄ່າເລີ່ມຕົ້ນ (ທິດທາງຂໍ້ຄວາມຊ້າຍໄປຂວາ, "
"ພະຫຸພົດໜຶ່ງອັນ). ພາສາທີ່ຖືກສ້າງຂຶ້ນອັດຕະໂນມັດດ້ວຍລະຫັດ ``xx_XX`` "
"ຈະຖືກຕັ້ງຊື່ເປັນ :guilabel:`xx_XX (generated)`. ທ່ານອາດຕ້ອງການປ່ຽນສິ່ງນີ້ໃນ admin "
"interface ໃນພາຍຫຼັງ, (ເບິ່ງ :ref:`changing-languages`) ແລະ ລາຍງານມັນໄປຍັງ issue "
"tracker (ເບິ່ງ :ref:`contributing`), ເພື່ອໃຫ້ຄຳນິຍາມທີ່ຖືກຕ້ອງສາມາດຖືກເພີ່ມເຂົ້າໃນເວີຊັນ "
"Weblate ທີ່ຈະມາເຖິງ."

msgid ""
"In case you see something unwanted as a language, you might want to "
"adjust :ref:`component-language_regex` to ignore such file when parsing "
"translations."
msgstr ""
"ໃນກໍລະນີທີ່ທ່ານເຫັນບາງຢ່າງທີ່ບໍ່ຕ້ອງການເປັນພາສາ, ທ່ານອາດຕ້ອງການປັບ :ref:`component-"
"language_regex` ເພື່ອລະເວັ້ນໄຟລ໌ນັ້ນເມື່ອແຍກການແປ."

msgid "Changing language definitions"
msgstr "ການປ່ຽນແປງຄຳນິຍາມພາສາ"

msgid ""
"You can change language definitions in the languages interface (:file:`/"
"languages/` URL)."
msgstr "ທ່ານສາມາດປ່ຽນຄຳນິຍາມພາສາໃນອິນເຕີເຟດພາສາ (URL :file:`/languages/`)."

msgid ""
"While editing, ensure all fields are correct (especially plurals and text "
"direction), otherwise translators will be unable to properly edit those "
"translations."
msgstr ""
"ໃນຂະນະແກ້ໄຂ, ໃຫ້ຮັບປະກັນວ່າທຸກຊ່ອງຂໍ້ມູນຖືກຕ້ອງ (ໂດຍສະເພາະພະຫຸພົດ ແລະ ທິດທາງຂໍ້ຄວາມ), "
"ຖ້າບໍ່ດັ່ງນັ້ນຜູ້ແປຈະບໍ່ສາມາດແກ້ໄຂການແປເຫຼົ່ານັ້ນໄດ້ຢ່າງຖືກຕ້ອງ."

msgid ""
"Please consider contributing your changes back, see :ref:`extending-"
"languages`."
msgstr ""
"ກະລຸນາພິຈາລະນາປະກອບສ່ວນການປ່ຽນແປງຂອງທ່ານກັບຄືນມາ, ເບິ່ງ :ref:`extending-languages`."

msgid "Ambiguous language codes and macrolanguages"
msgstr "ລະຫັດພາສາທີ່ບໍ່ຊັດເຈນ ແລະ macrolanguages"

msgid ""
"In many cases it is not a good idea to use macrolanguage code for a "
"translation. The typical problematic case might be Kurdish language, which "
"might be written in Arabic or Latin script, depending on actual variant. To "
"get correct behavior in Weblate, it is recommended to use individual "
"language codes only and avoid macrolanguages."
msgstr ""
"ໃນຫຼາຍກໍລະນີ, ມັນບໍ່ແມ່ນຄວາມຄິດທີ່ດີທີ່ຈະໃຊ້ລະຫັດ macrolanguage ສຳລັບການແປ. "
"ກໍລະນີທີ່ເປັນບັນຫາທົ່ວໄປອາດຈະເປັນພາສາກູຣ໌ດ (Kurdish), ເຊິ່ງອາດຈະຖືກຂຽນດ້ວຍອັກສອນອາຣັບ ຫຼື ລາຕິນ, "
"ຂຶ້ນຢູ່ກັບຕົວປ່ຽນແປງທີ່ແທ້ຈິງ. ເພື່ອໃຫ້ໄດ້ພຶດຕິກຳທີ່ຖືກຕ້ອງໃນ Weblate, "
"ແນະນຳໃຫ້ໃຊ້ລະຫັດພາສາສ່ວນບຸກຄົນເທົ່ານັ້ນ ແລະ ຫຼີກເວັ້ນ macrolanguages."

msgid ""
"`Macrolanguages at Wikipedia <https://en.wikipedia.org/wiki/"
"ISO_639_macrolanguage>`_"
msgstr ""
"`Macrolanguages ໃນ Wikipedia <https://en.wikipedia.org/wiki/"
"ISO_639_macrolanguage>`_"

msgid "Each language consists of following fields:"
msgstr "ແຕ່ລະພາສາປະກອບດ້ວຍຊ່ອງຂໍ້ມູນຕໍ່ໄປນີ້:"

msgid "Language code"
msgstr "ລະຫັດພາສາ"

msgid ""
"Code identifying the language. Weblate prefers two letter codes as defined "
"by `ISO 639-1 <https://en.wikipedia.org/wiki/ISO_639-1>`_, but uses `ISO "
"639-2 <https://en.wikipedia.org/wiki/ISO_639-2>`_ or `ISO 639-3 <https://"
"en.wikipedia.org/wiki/ISO_639-3>`_ codes for languages that do not have two "
"letter code. It can also support extended codes as defined by `BCP 47`_."
msgstr ""
"ລະຫັດທີ່ລະບຸພາສາ. Weblate ມັກລະຫັດສອງຕົວອັກສອນຕາມທີ່ກຳນົດໂດຍ `ISO 639-1 <https://"
"en.wikipedia.org/wiki/ISO_639-1>`_, ແຕ່ໃຊ້ລະຫັດ `ISO 639-2 <https://"
"en.wikipedia.org/wiki/ISO_639-2>`_ ຫຼື `ISO 639-3 <https://en.wikipedia.org/"
"wiki/ISO_639-3>`_ ສຳລັບພາສາທີ່ບໍ່ມີລະຫັດສອງຕົວອັກສອນ. "
"ມັນຍັງສາມາດຮອງຮັບລະຫັດຂະຫຍາຍໄດ້ຕາມທີ່ກຳນົດໂດຍ `BCP 47`_."

msgid "Language name"
msgstr "ຊື່ພາສາ"

msgid ""
"Visible name of the language. The language names included in Weblate are "
"also being localized depending on user interface language."
msgstr "ຊື່ທີ່ເຫັນໄດ້ຂອງພາສາ. ຊື່ພາສາທີ່ລວມຢູ່ໃນ Weblate ຍັງຖືກແປຕາມພາສາອິນເຕີເຟດຜູ້ໃຊ້."

msgid "Text direction"
msgstr "ທິດທາງຂອງຕົວໜັງສື"

msgid ""
"Determines whether language is written right to left or left to right. This "
"property is autodetected correctly for most of the languages."
msgstr ""
"ກຳນົດວ່າພາສານັ້ນຂຽນຈາກຂວາໄປຊ້າຍ ຫຼື ຊ້າຍໄປຂວາ. "
"ຄຸນສົມບັດນີ້ຖືກກວດສອບໂດຍອັດຕະໂນມັດຢ່າງຖືກຕ້ອງສຳລັບພາສາສ່ວນໃຫຍ່."

msgid "Number of speakers"
msgstr "ຈຳນວນຜູ້ເວົ້າ"

msgid "Number of worldwide speakers of this language."
msgstr "ຈຳນວນຜູ້ເວົ້າພາສານີ້ທົ່ວໂລກ."

msgid "Plural definitions"
msgstr "ຄຳນິຍາມພົດພົດ"

msgid ""
"Weblate comes with a built-in set of plural definitions. These are based on "
"file-format specifications, CLDR, and other sources."
msgstr ""
"Weblate ມາພ້ອມກັບຊຸດຄຳນິຍາມພົດພົດທີ່ຕິດຕັ້ງມາໃນຕົວ. ເຫຼົ່ານີ້ແມ່ນອີງໃສ່ຂໍ້ມູນຈຳເພາະຂອງຮູບແບບໄຟລ໌, "
"CLDR, ແລະ ແຫຼ່ງຂໍ້ມູນອື່ນໆ."

msgid ""
"Doing changes to the built-in plural definitions will most likely won't have "
"desired effect, as these rules need to match underlying implementation."
msgstr ""
"ການປ່ຽນແປງຄຳນິຍາມພົດພົດທີ່ຕິດຕັ້ງມາໃນຕົວ ສ່ວນຫຼາຍແລ້ວຈະບໍ່ໄດ້ຜົນຕາມທີ່ຕ້ອງການ, "
"ເນື່ອງຈາກກົດເຫຼົ່ານີ້ຕ້ອງກົງກັບການຈັດຕັ້ງປະຕິບັດເບື້ອງຫຼັງ."

msgid ""
"Changing plural number or formula will affect only displaying of the "
"strings, but not parsing and storing strings to the files. Should you think "
"Weblate behaves incorrectly, please file an issue in our issue tracker."
msgstr ""
"ການປ່ຽນແປງຈຳນວນພົດພົດ ຫຼື ສູດຈະສົ່ງຜົນກະທົບພຽງແຕ່ການສະແດງຜົນຂອງຂໍ້ຄວາມເທົ່ານັ້ນ, "
"ແຕ່ບໍ່ໄດ້ສົ່ງຜົນຕໍ່ການວິເຄາະ ແລະ ການຈັດເກັບຂໍ້ຄວາມລົງໃນໄຟລ໌. ຖ້າທ່ານຄິດວ່າ Weblate ເຮັດວຽກບໍ່ຖືກຕ້ອງ, "
"ກະລຸນາແຈ້ງບັນຫາໃນລະບົບຕິດຕາມບັນຫາຂອງພວກເຮົາ."

msgid "Plural number"
msgstr "ຈຳນວນພົດພົດ"

msgid "Number of plurals used in the language."
msgstr "ຈຳນວນພົດພົດທີ່ໃຊ້ໃນພາສານີ້."

msgid "Plural formula"
msgstr "ສູດພະຫຸພົດ"

msgid ""
"Gettext compatible plural formula used to determine which plural form is "
"used for given count."
msgstr ""
"ສູດພົດພົດທີ່ເຂົ້າກັນໄດ້ກັບ Gettext ເຊິ່ງໃຊ້ເພື່ອ ກຳນົດວ່າຮູບແບບພົດພົດໃດທີ່ຖືກໃຊ້ສຳລັບຈຳນວນທີ່ກຳນົດ."

msgid ""
"The formula uses the same expression syntax as the ``plural=`` part of the "
"Gettext ``Plural-Forms`` header. The ``nplurals`` value sets how many plural "
"forms the language has, and the formula returns the zero-based index of the "
"plural form to use for a count ``n``."
msgstr ""
"ສູດດັ່ງກ່າວໃຊ້ syntax ການສະແດງຜົນດຽວກັນກັບສ່ວນ ``plural=`` ຂອງຫົວຂໍ້ Gettext ``Plural-"
"Forms``. ຄ່າ ``nplurals`` ຈະຕັ້ງຄ່າວ່າພາສານັ້ນມີຈັກຮູບແບບພົດພົດ, ແລະ "
"ສູດຈະສົ່ງກັບຄ່າດັດຊະນີທີ່ເລີ່ມຈາກສູນຂອງຮູບແບບພົດພົດທີ່ຈະໃຊ້ສຳລັບຈຳນວນ ``n``."

msgid ""
"Weblate validates the formula using the Gettext parser provided by Python. "
"The accepted syntax is a C-like integer expression with ``n`` as the only "
"variable. It can use decimal numbers, parentheses, arithmetic operators "
"(``+``, ``-``, ``*``, ``/``, ``%``), comparison and equality operators, "
"logical operators (``&&``, ``||``, ``!``), and the ternary operator "
"(``condition ? value1 : value2``). The result must be between ``0`` and "
"``nplurals - 1``."
msgstr ""
"Weblate ກວດສອບສູດໂດຍໃຊ້ຕົວວິເຄາະ Gettext ທີ່ມາພ້ອມກັບ Python. syntax "
"ທີ່ຍອມຮັບແມ່ນການສະແດງຜົນຈຳນວນເຕັມແບບ C ໂດຍມີ ``n`` ເປັນຕົວແປດຽວ. ມັນສາມາດໃຊ້ເລກທົດສະນິຍົມ, "
"ວົງເລັບ, ຕົວດຳເນີນການເລກຄະນິດ (``+``, ``-``, ``*``, ``/``, ``%``), "
"ຕົວດຳເນີນການປຽບທຽບ ແລະ ເທົ່າກັບ, ຕົວດຳເນີນການທາງຕັກກະຍະ (``&&``, ``||``, ``!``), ແລະ "
"ຕົວດຳເນີນການ ternary (``condition ? value1 : value2``). ຜົນລັດຕ້ອງຢູ່ລະຫວ່າງ ``0`` "
"ຫາ ``nplurals - 1``."

msgid "For example, English uses:"
msgstr "ຕົວຢ່າງ, ພາສາອັງກິດໃຊ້:"

msgid "`GNU gettext manual for plural forms`_"
msgstr "`ຄູ່ມື GNU gettext ສຳລັບຮູບແບບພົດພົດ`_"

msgid "`GNU gettext plural formula parser`_"
msgstr "`ຕົວວິເຄາະສູດພົດພົດ GNU gettext`_"

msgid "`Language Plural Rules by the Unicode Consortium`_"
msgstr "`ກົດພົດພົດຂອງພາສາໂດຍ Unicode Consortium`_"

msgid "Licensing translations"
msgstr "ການໃຫ້ສິດທິບັດການແປ"

msgid ""
"You can specify which license translations are contributed under. This is "
"especially important to do if translations are open to the public, to "
"stipulate what they can be used for."
msgstr ""
"ທ່ານສາມາດລະບຸໄດ້ວ່າການແປເຫຼົ່ານັ້ນຖືກປະກອບສ່ວນພາຍໃຕ້ສິດທິບັດໃດ. "
"ສິ່ງນີ້ມີຄວາມສຳຄັນໂດຍສະເພາະຫາກການແປເປີດເຜີຍຕໍ່ສາທາລະນະ, ເພື່ອລະບຸວ່າສາມາດນຳໄປໃຊ້ເພື່ອຫຍັງໄດ້."

msgid ""
"You should specify :ref:`component` license info. You should avoid requiring "
"a contributor license agreement, though it is possible."
msgstr ""
"ທ່ານຄວນລະບຸຂໍ້ມູນສິດທິບັດຂອງ :ref:`component`. "
"ທ່ານຄວນຫຼີກລ່ຽງການຮຽກຮ້ອງຂໍ້ຕົກລົງສິດທິບັດຂອງຜູ້ປະກອບສ່ວນ, ເຖິງແມ່ນວ່າຈະສາມາດເຮັດໄດ້ກໍຕາມ."

msgid "License info"
msgstr "ຂໍ້ມູນສິດທິບັດ"

msgid ""
"Upon specifying license info (license name and URL), this info is shown in "
"the translation info section of the respective :ref:`component`."
msgstr ""
"ເມື່ອລະບຸຂໍ້ມູນສິດທິບັດ (ຊື່ສິດທິບັດ ແລະ URL), "
"ຂໍ້ມູນນີ້ຈະຖືກສະແດງໃນພາກຂໍ້ມູນການແປຂອງ :ref:`component` ນັ້ນໆ."

msgid ""
"Usually this is best place to post licensing info if no explicit consent is "
"required. If your project or translation is not libre you most probably need "
"prior consent."
msgstr ""
"ໂດຍປົກກະຕິແລ້ວ ນີ້ແມ່ນບ່ອນທີ່ດີທີ່ສຸດໃນການປະກາດຂໍ້ມູນສິດທິບັດ ຖ້າຫາກບໍ່ຈຳເປັນຕ້ອງມີການຍິນຍອມທີ່ຊັດເຈນ. "
"ຫາກໂຄງການ ຫຼື ການແປຂອງທ່ານບໍ່ແມ່ນແບບເສລີ, ທ່ານຈຳເປັນຕ້ອງໄດ້ຮັບການຍິນຍອມກ່ອນ."

msgid "Contributor license agreement"
msgstr "ຂໍ້ຕົກລົງໃບອະນຸຍາດຜູ້ປະກອບສ່ວນ"

msgid ""
"If you specify a :ref:`component-agreement`, only users who have agreed to "
"it will be able to contribute. This is a clearly visible step when accessing "
"the translation:"
msgstr ""
"ຖ້າທ່ານລະບຸ :ref:`component-agreement`, "
"ພຽງແຕ່ຜູ້ໃຊ້ທີ່ຕົກລົງກັບຂໍ້ຕົກລົງດັ່ງກ່າວເທົ່ານັ້ນທີ່ຈະສາມາດປະກອບສ່ວນໄດ້. "
"ນີ້ເປັນຂັ້ນຕອນທີ່ເຫັນໄດ້ຊັດເຈນເມື່ອເຂົ້າເຖິງການແປ:"

msgid "User licenses"
msgstr "ສິດທິບັດຂອງຜູ້ໃຊ້"

msgid ""
"Any user can review all translation licenses of all public projects on the "
"instance from their profile:"
msgstr "ຜູ້ໃຊ້ທຸກຄົນສາມາດກວດສອບສິດທິບັດການແປທັງໝົດຂອງທຸກໂຄງການສາທາລະນະໃນລະບົບໄດ້ຈາກໂປຣໄຟລ໌ຂອງເຂົາເຈົ້າ:"

msgid "Automatic suggestions"
msgstr "ຄຳແນະນຳອັດຕະໂນມັດ"

msgid ""
"Prior to Weblate 4.13, the services were configured in the :ref:`config`."
msgstr "ກ່ອນ Weblate 4.13, ການບໍລິການເຫຼົ່ານີ້ຈະຖືກຕັ້ງຄ່າໃນ :ref:`config`."

msgid ""
"The support for several machine translation and translation memory services "
"is built-in. Each service can be turned on by the administrator for whole "
"site (under :guilabel:`Automatic suggestions` in :ref:`management-"
"interface`) or at the project settings:"
msgstr ""
"ການຮອງຮັບການແປດ້ວຍເຄື່ອງ ແລະ ໜ່ວຍຄວາມຈຳການແປຫຼາຍຢ່າງແມ່ນມີມາໃນຕົວ. "
"ແຕ່ລະການບໍລິການສາມາດເປີດໃຊ້ງານໂດຍຜູ້ເບິ່ງແຍງລະບົບສຳລັບທັງເວັບໄຊ "
"(ພາຍໃຕ້ :guilabel:`Automatic suggestions` ໃນ :ref:`management-interface`) ຫຼື "
"ທີ່ການຕັ້ງຄ່າໂຄງການ:"

msgid ""
"They come subject to their terms of use, so ensure you are allowed to use "
"them how you want. Third-party services can receive source strings, "
"translations, and related context from Weblate."
msgstr ""
"ພວກມັນຢູ່ພາຍໃຕ້ເງື່ອນໄຂການນຳໃຊ້ຂອງຕົນ, "
"ສະນັ້ນຕ້ອງໃຫ້ແນ່ໃຈວ່າທ່ານໄດ້ຮັບອະນຸຍາດໃຫ້ໃຊ້ພວກມັນໃນແບບທີ່ທ່ານຕ້ອງການ. "
"ການບໍລິການຂອງບຸກຄົນທີສາມສາມາດໄດ້ຮັບຂໍ້ຄວາມຕົ້ນສະບັບ, ຄຳແປ, ແລະ ບໍລິບົດທີ່ກ່ຽວຂ້ອງຈາກ Weblate."

msgid ""
"The services translate from the source language as configured "
"at :ref:`component`, see :ref:`component-source_language`."
msgstr ""
"ການບໍລິການເຫຼົ່ານີ້ຈະແປຈາກພາສາຕົ້ນສະບັບຕາມທີ່ຕັ້ງຄ່າໄວ້ທີ່ :ref:`component`, "
"ເບິ່ງ :ref:`component-source_language`."

msgid ""
"Per-project automatic suggestion can also be configured via the :ref:`api`."
msgstr "ຄຳແນະນຳອັດຕະໂນມັດຕໍ່ໂຄງການຍັງສາມາດຕັ້ງຄ່າຜ່ານ :ref:`api` ໄດ້ເຊັ່ນກັນ."

msgid "Priority of machine translation and translation memory services"
msgstr "ລຳດັບຄວາມສຳຄັນຂອງການແປດ້ວຍເຄື່ອງ ແລະ ການບໍລິການໜ່ວຍຄວາມຈຳການແປ"

msgid ""
":ref:`mt-weblate-translation-memory` matches with 100% score take priority "
"over machine translation services. If 100% match in translation memory is "
"found, no machine translation is performed. If several 100% matches occur, "
"the first one returned by the database is used."
msgstr ""
":ref:`mt-weblate-translation-memory` ທີ່ກົງກັນ 100% "
"ຈະມີຄວາມສຳຄັນສູງກວ່າການບໍລິການແປດ້ວຍເຄື່ອງ. ຖ້າພົບການກົງກັນ 100% ໃນໜ່ວຍຄວາມຈຳການແປ, "
"ຈະບໍ່ມີການແປດ້ວຍເຄື່ອງ. ຖ້າພົບການກົງກັນ 100% ຫຼາຍຢ່າງ, "
"ລາຍການທຳອິດທີ່ສົ່ງກັບມາຈາກຖານຂໍ້ມູນຈະຖືກນຳໃຊ້."

msgid ""
"Each machine translation service has a predefined maximum score it can "
"produce. The use of installed translation services is ordered according to "
"their maximum score. For each string with translation score lower than the "
"service's maximum, the service is asked to produce a translation. "
"Translations with a score exceeding the current one are accepted."
msgstr ""
"ແຕ່ລະການບໍລິການແປດ້ວຍເຄື່ອງມີຄະແນນສູງສຸດທີ່ກຳນົດໄວ້. "
"ການນຳໃຊ້ການບໍລິການແປທີ່ຕິດຕັ້ງໄວ້ຈະຖືກຈັດລຳດັບຕາມຄະແນນສູງສຸດຂອງພວກມັນ. "
"ສຳລັບແຕ່ລະຂໍ້ຄວາມທີ່ມີຄະແນນການແປຕ່ຳກວ່າຄະແນນສູງສຸດຂອງການບໍລິການ, "
"ລະບົບຈະຮ້ອງຂໍໃຫ້ການບໍລິການນັ້ນສ້າງຄຳແປ. ຄຳແປທີ່ມີຄະແນນສູງກວ່າຄະແນນປັດຈຸບັນຈະຖືກຍອມຮັບ."

msgid "Source strings for the machine translation"
msgstr "ຂໍ້ຄວາມຕົ້ນສະບັບສຳລັບການແປດ້ວຍເຄື່ອງ"

msgid ""
"The origin of source strings for all third-party services can be configured. "
"This can be used to tweak the service to get the best results. Following "
"choices are available:"
msgstr ""
"ແຫຼ່ງທີ່ມາຂອງຂໍ້ຄວາມຕົ້ນສະບັບສຳລັບການບໍລິການຂອງບຸກຄົນທີສາມທັງໝົດສາມາດຕັ້ງຄ່າໄດ້. "
"ນີ້ສາມາດໃຊ້ເພື່ອປັບແຕ່ງການບໍລິການໃຫ້ໄດ້ຜົນລັດທີ່ດີທີ່ສຸດ. ມີທາງເລືອກດັ່ງນີ້:"

msgid ":guilabel:`Automatic selection`"
msgstr ":guilabel:`ການເລືອກອັດຕະໂນມັດ`"

msgid "Chooses the best source language automatically."
msgstr "ເລືອກພາສາຕົ້ນສະບັບທີ່ດີທີ່ສຸດໂດຍອັດຕະໂນມັດ."

msgid "This is the default behavior."
msgstr "ນີ້ແມ່ນພຶດຕິກຳເລີ່ມຕົ້ນ."

msgid ":guilabel:`Component source language`"
msgstr ":guilabel:`ພາສາຕົ້ນສະບັບຂອງອົງປະກອບ`"

msgid "Uses the component source language."
msgstr "ໃຊ້ພາສາຕົ້ນສະບັບຂອງອົງປະກອບ."

msgid "This was the behavior before the 5.11 release."
msgstr "ນີ້ແມ່ນພຶດຕິກຳກ່ອນການປ່ອຍເວີຊັນ 5.11."

msgid ":guilabel:`Secondary language defined in project or component`"
msgstr ":guilabel:`ພາສາຮອງທີ່ກຳນົດໃນໂຄງການ ຫຼື ອົງປະກອບ`"

msgid ""
"Use project :ref:`project-secondary_language` or component :ref:`component-"
"secondary_language`."
msgstr ""
"ໃຊ້ :ref:`project-secondary_language` ຂອງໂຄງການ ຫຼື :ref:`component-"
"secondary_language` ຂອງອົງປະກອບ."

msgid ""
"Falls back to the automatic selection of the source language if the "
"secondary language not configured."
msgstr "ຈະກັບໄປໃຊ້ການເລືອກພາສາຕົ້ນສະບັບອັດຕະໂນມັດ ຖ້າບໍ່ໄດ້ຕັ້ງຄ່າພາສາຮອງ."

msgid "LLM translation context"
msgstr "ບໍລິບົດການແປຂອງ LLM"

msgid ""
"LLM-based automatic suggestion services receive additional context about "
"each translated string, when available. This includes the string context or "
"monolingual key, additional explanation, configured secondary-language "
"translation, plural information, failing quality checks, and placeholder "
"contents. Matching glossary entries are passed with their explanations and "
"selected flags, so duplicate glossary terms can be disambiguated."
msgstr ""
"ການບໍລິການຄຳແນະນຳອັດຕະໂນມັດແບບ LLM ຈະໄດ້ຮັບບໍລິບົດເພີ່ມເຕີມກ່ຽວກັບແຕ່ລະຂໍ້ຄວາມທີ່ແປ, ຫາກມີ. "
"ນີ້ລວມເຖິງບໍລິບົດຂອງຂໍ້ຄວາມ ຫຼື ກຸນແຈພາສາດຽວ, ຄຳອະທິບາຍເພີ່ມເຕີມ, ຄຳແປພາສາຮອງທີ່ຕັ້ງຄ່າໄວ້, "
"ຂໍ້ມູນພົດພົດ, ການກວດສອບຄຸນນະພາບທີ່ຜິດພາດ, ແລະ ເນື້ອໃນຕົວແທນ (placeholder). "
"ລາຍການຄຳສັບທີ່ກົງກັນຈະຖືກສົ່ງໄປພ້ອມກັບຄຳອະທິບາຍ ແລະ ທຸງທີ່ເລືອກ, "
"ເພື່ອໃຫ້ສາມາດແຍກຄວາມແຕກຕ່າງຂອງຄຳສັບທີ່ຊ້ຳກັນໄດ້."

msgid ""
"You can add target-language-specific instructions in :guilabel:`Language-"
"specific instructions` using a JSON object mapping language codes to text. "
"Language codes have to exist in Weblate and are matched exactly; whitespace "
"is not ignored. Each instruction can contain up to 1000 characters. Weblate "
"first looks for the exact target language code and then falls back to the "
"base language code."
msgstr ""
"ທ່ານສາມາດເພີ່ມຄຳແນະນຳສະເພາະພາສາປາຍທາງໃນ :guilabel:`Language-specific "
"instructions` ໂດຍໃຊ້ວັດຖຸ JSON ທີ່ຈັບຄູ່ລະຫັດພາສາກັບຂໍ້ຄວາມ. ລະຫັດພາສາຕ້ອງມີຢູ່ໃນ Weblate ແລະ "
"ຕ້ອງກົງກັນຢ່າງແນ່ນອນ; ຊ່ອງຫວ່າງຈະບໍ່ຖືກລະເລີຍ. ແຕ່ລະຄຳແນະນຳສາມາດບັນຈຸໄດ້ສູງສຸດ 1000 ຕົວອັກສອນ. "
"Weblate ຈະຊອກຫາລະຫັດພາສາປາຍທາງທີ່ແນ່ນອນກ່ອນ ແລ້ວຈຶ່ງກັບໄປໃຊ້ລະຫັດພາສາພື້ນຖານຖ້າບໍ່ພົບ."

msgid ""
"The added metadata is used only to guide the generated suggestion; the "
"returned translation still has to preserve the source placeholders and "
"markup. Weblate also sends a short previous chat exchange to LLM services to "
"demonstrate the expected JSON response format. The exchange uses bundled "
"translated examples when available for the source and target language pair, "
"or language-neutral formatting examples otherwise. Existing translations for "
"the same target language can be appended as additional examples."
msgstr ""
"ເມຕາດາຕ້າທີ່ເພີ່ມເຂົ້າມາຈະຖືກໃຊ້ພຽງເພື່ອແນະນຳຄຳແນະນຳທີ່ສ້າງຂຶ້ນເທົ່ານັ້ນ; "
"ຄຳແປທີ່ສົ່ງກັບມາຕ້ອງຍັງຄົງຮັກສາຕົວແທນ (placeholder) ແລະ ມາກອັບ (markup) ຂອງຕົ້ນສະບັບໄວ້. "
"Weblate ຍັງສົ່ງການສົນທະນາສັ້ນໆກ່ອນໜ້ານີ້ໃຫ້ການບໍລິການ LLM ເພື່ອສາທິດຮູບແບບການຕອບໂຕ້ JSON "
"ທີ່ຄາດຫວັງ. ການແລກປ່ຽນນີ້ໃຊ້ຕົວຢ່າງການແປທີ່ມາພ້ອມກັບລະບົບ ຫາກມີສຳລັບຄູ່ພາສາຕົ້ນສະບັບ ແລະ ປາຍທາງ, "
"ຫຼື ໃຊ້ຕົວຢ່າງຮູບແບບທີ່ເປັນກາງທາງພາສາໃນກໍລະນີອື່ນ. "
"ຄຳແປທີ່ມີຢູ່ແລ້ວສຳລັບພາສາປາຍທາງດຽວກັນສາມາດຖືກເພີ່ມເປັນຕົວຢ່າງເພີ່ມເຕີມ."

msgid "Custom machine translation"
msgstr "ການແປດ້ວຍເຄື່ອງແບບກຳນົດເອງ"

msgid ""
"You can also implement your own machine translation services using a few "
"lines of Python code. Place the code in a module Weblate can import "
"(see :ref:`custom-module` or :ref:`docker-python-override`) and add fully "
"qualified class name to :setting:`WEBLATE_MACHINERY`."
msgstr ""
"ທ່ານຍັງສາມາດສ້າງການບໍລິການແປດ້ວຍເຄື່ອງຂອງທ່ານເອງໂດຍໃຊ້ລະຫັດ Python ພຽງສອງສາມແຖວ. "
"ວາງລະຫັດໄວ້ໃນໂມດູນທີ່ Weblate ສາມາດນຳເຂົ້າໄດ້ (ເບິ່ງ :ref:`custom-module` "
"ຫຼື :ref:`docker-python-override`) ແລະ "
"ເພີ່ມຊື່ຄລາດທີ່ມີຄຸນສົມບັດຄົບຖ້ວນໄປທີ່ :setting:`WEBLATE_MACHINERY`."

msgid "Management commands"
msgstr "ຄຳສັ່ງຈັດການ"

msgid ""
"Running management commands under a different user than the one running your "
"webserver can result in files getting wrong permissions, please "
"check :ref:`file-permissions` for more details."
msgstr ""
"ການຮັນຄຳສັ່ງຈັດການດ້ວຍຜູ້ໃຊ້ທີ່ແຕກຕ່າງຈາກຜູ້ທີ່ຮັນເວັບເຊີບເວີຂອງທ່ານ "
"ອາດສົ່ງຜົນໃຫ້ໄຟລ໌ມີສິດທິອະນຸຍາດທີ່ຜິດພາດ, ກະລຸນາກວດສອບ :ref:`file-permissions` "
"ສຳລັບລາຍລະອຽດເພີ່ມເຕີມ."

msgid ""
"You will find basic management commands (available as :file:`./manage.py` in "
"the Django sources, or as an extended set in a script "
"called :command:`weblate` installable atop Weblate)."
msgstr ""
"ທ່ານຈະພົບຄຳສັ່ງຈັດການພື້ນຖານ (ທີ່ມີຢູ່ໃນ :file:`./manage.py` ໃນແຫຼ່ງຂໍ້ມູນ Django, ຫຼື "
"ເປັນຊຸດຂະຫຍາຍໃນສະຄຣິບທີ່ເອີ້ນວ່າ :command:`weblate` ເຊິ່ງຕິດຕັ້ງໄດ້ເທິງ Weblate)."

msgid "Invoking management commands"
msgstr "ການເອີ້ນໃຊ້ຄຳສັ່ງຈັດການ"

msgid "As mentioned before, invocation depends on how you installed Weblate."
msgstr "ດັ່ງທີ່ໄດ້ກ່າວມາແລ້ວ, ການເອີ້ນໃຊ້ຂຶ້ນຢູ່ກັບວິທີທີ່ທ່ານຕິດຕັ້ງ Weblate."

msgid ""
"If using a Python environment for Weblate, you can either specify the full "
"path to :command:`weblate`, or activate the Python environment prior to "
"invoking it:"
msgstr ""
"ຖ້າໃຊ້ສະພາບແວດລ້ອມ Python ສຳລັບ Weblate, "
"ທ່ານສາມາດລະບຸເສັ້ນທາງເຕັມໄປຍັງ :command:`weblate`, ຫຼື ເປີດໃຊ້ສະພາບແວດລ້ອມ Python "
"ກ່ອນທີ່ຈະເອີ້ນໃຊ້ມັນ:"

msgid ""
"If you are using source code directly (either from a tarball or Git "
"checkout), the management script is :file:`./manage.py` available in the "
"Weblate sources. To run it:"
msgstr ""
"ຖ້າທ່ານໃຊ້ລະຫັດແຫຼ່ງໂດຍກົງ (ບໍ່ວ່າຈະຈາກ tarball ຫຼື Git checkout), "
"ສະຄຣິບຈັດການແມ່ນ :file:`./manage.py` ເຊິ່ງມີຢູ່ໃນແຫຼ່ງຂໍ້ມູນ Weblate. ເພື່ອຮັນມັນ:"

msgid ""
"If you've installed Weblate using the pip installer, or by using "
"the :file:`./setup.py` script, the :command:`weblate` is installed to your "
"path (or Python environment path), from where you can use it to control "
"Weblate:"
msgstr ""
"ຖ້າທ່ານຕິດຕັ້ງ Weblate ໂດຍໃຊ້ pip, ຫຼື ໂດຍໃຊ້ສະຄຣິບ :file:`./"
"setup.py`, :command:`weblate` ຈະຖືກຕິດຕັ້ງໃສ່ path ຂອງທ່ານ (ຫຼື path ຂອງສະພາບແວດລ້ອມ "
"Python), ເຊິ່ງທ່ານສາມາດໃຊ້ເພື່ອຄວບຄຸມ Weblate:"

msgid ""
"For the Docker image, the script is installed like above, and you can run it "
"using :command:`docker exec`:"
msgstr ""
"ສຳລັບ Docker image, ສະຄຣິບຖືກຕິດຕັ້ງໄວ້ຄືກັບຂ້າງເທິງ, ແລະ "
"ທ່ານສາມາດຮັນມັນໄດ້ໂດຍໃຊ້ :command:`docker exec`:"

msgid ""
"For :program:`docker-compose-plugin` the process is similar, you just have "
"to use :command:`docker compose exec`:"
msgstr ""
"ສຳລັບ :program:`docker-compose-plugin`, ຂະບວນການແມ່ນຄ້າຍຄືກັນ, "
"ທ່ານພຽງແຕ່ຕ້ອງໃຊ້ :command:`docker compose exec`:"

msgid "In case you need to pass it a file, you can temporary add a volume:"
msgstr "ໃນກໍລະນີທີ່ທ່ານຕ້ອງການສົ່ງໄຟລ໌ໃຫ້ມັນ, ທ່ານສາມາດເພີ່ມ volume ຊົ່ວຄາວໄດ້:"

msgid ""
"Imports a translation from the file to use as a suggestion for the given "
"translation. It skips duplicated translations; only different ones are added."
msgstr ""
"ນຳເຂົ້າຄຳແປຈາກໄຟລ໌ເພື່ອໃຊ້ເປັນຄຳແນະນຳສຳລັບຄຳແປທີ່ກຳນົດ. ມັນຈະຂ້າມຄຳແປທີ່ຊ້ຳກັນ; "
"ມີພຽງແຕ່ຄຳແປທີ່ແຕກຕ່າງກັນເທົ່ານັ້ນທີ່ຈະຖືກເພີ່ມ."

msgid ""
"Analyzes change history to estimate realistic translator throughput per day. "
"The command includes only active human users and unit-backed manual "
"translation changes, and applies daily minimum and maximum thresholds to "
"skip obvious outliers, bots, bulk imports, uploads, and other events that "
"would pollute the result."
msgstr ""
"ວິເຄາະປະຫວັດການປ່ຽນແປງເພື່ອປະເມີນປະສິດທິພາບການແປຕົວຈິງຕໍ່ວັນ. ຄຳສັ່ງນີ້ລວມພຽງແຕ່ຜູ້ໃຊ້ທີ່ເປັນຄົນ ແລະ "
"ການປ່ຽນແປງຄຳແປດ້ວຍຕົນເອງ, ແລະ ນຳໃຊ້ຂອບເຂດຈຳກັດຕໍ່າສຸດ ແລະ ສູງສຸດຕໍ່ວັນເພື່ອຂ້າມຂໍ້ມູນທີ່ຜິດປົກກະຕິ, "
"ບັອດ, ການນຳເຂົ້າຈຳນວນຫຼາຍ, ການອັບໂຫຼດ, ແລະ ເຫດການອື່ນໆທີ່ອາດເຮັດໃຫ້ຜົນລັດເສື່ອມເສຍ."

msgid "Added parameter for translation mode."
msgstr "ເພີ່ມພາຣາມິເຕີສຳລັບໂໝດການແປ."

msgid "Performs automatic translation based on other component translations."
msgstr "ດຳເນີນການແປອັດຕະໂນມັດໂດຍອີງໃສ່ຄຳແປຂອງອົງປະກອບອື່ນ."

msgid ""
"Runs configured backups synchronously, without using Celery. It first "
"updates the settings and database backup dumps in :setting:`DATA_DIR`, then "
"runs the selected Borg backup service or services."
msgstr ""
"ຮັນການສຳຮອງຂໍ້ມູນທີ່ຕັ້ງຄ່າໄວ້ແບບ Synchronous, ໂດຍບໍ່ໃຊ້ Celery. ມັນຈະອັບເດດການຕັ້ງຄ່າ ແລະ "
"ໄຟລ໌ສຳຮອງຖານຂໍ້ມູນໃນ :setting:`DATA_DIR` ກ່ອນ, ຈາກນັ້ນຈຶ່ງຮັນການບໍລິການສຳຮອງຂໍ້ມູນ Borg "
"ທີ່ເລືອກ."

msgid ""
"Use Django's standard ``--verbosity 2`` option to show backup service "
"output. Failed backup service output is shown even without increased "
"verbosity."
msgstr ""
"ໃຊ້ຕົວເລືອກ ``--verbosity 2`` ມາດຕະຖານຂອງ Django "
"ເພື່ອສະແດງຜົນລັດຂອງການບໍລິການສຳຮອງຂໍ້ມູນ. "
"ຜົນລັດຂອງການບໍລິການທີ່ລົ້ມເຫຼວຈະຖືກສະແດງເຖິງແມ່ນວ່າຈະບໍ່ໄດ້ເພີ່ມຄວາມລະອຽດກໍຕາມ."

msgid "Examples:"
msgstr "ຕົວຢ່າງ:"

msgid ""
"For Docker Compose deployments, you can stop the regular Weblate container "
"and run the command in a one-off container using :command:`docker compose "
"run`. The database and configured backup storage still need to be available."
msgstr ""
"ສຳລັບການນຳໃຊ້ Docker Compose, ທ່ານສາມາດຢຸດຄອນເທນເນີ Weblate ປົກກະຕິ ແລະ "
"ຮັນຄຳສັ່ງໃນຄອນເທນເນີຊົ່ວຄາວໂດຍໃຊ້ :command:`docker compose run`. ຖານຂໍ້ມູນ ແລະ "
"ບ່ອນຈັດເກັບສຳຮອງທີ່ຕັ້ງຄ່າໄວ້ຕ້ອງຍັງສາມາດໃຊ້ງານໄດ້."

msgid "Imports given content into Weblate, useful for benchmarking."
msgstr "ນຳເຂົ້າເນື້ອຫາທີ່ກຳນົດເຂົ້າໃນ Weblate, ເປັນປະໂຫຍດສຳລັບການທົດສອບປະສິດທິພາບ."

msgid "Example of performance profiling"
msgstr "ຕົວຢ່າງຂອງການກວດສອບປະສິດທິພາບ"

msgid "Example of memory profiling"
msgstr "ຕົວຢ່າງຂອງການກວດສອບໜ່ວຍຄວາມຈຳ"

msgid ""
"Creates a demo billing project. Can be executed multiple times to add "
"additional invoices and billing events."
msgstr ""
"ສ້າງໂຄງການເກັບເງິນຕົວຢ່າງ. ສາມາດປະຕິບັດໄດ້ຫຼາຍຄັ້ງເພື່ອເພີ່ມໃບແຈ້ງໜີ້ ແລະ "
"ເຫດການການເກັບເງິນເພີ່ມເຕີມ."

msgid ""
"This can be useful when developing Weblate. Needs :ref:`billing` installed."
msgstr "ສິ່ງນີ້ອາດເປັນປະໂຫຍດເມື່ອພັດທະນາ Weblate. ຕ້ອງຕິດຕັ້ງ :ref:`billing`."

msgid "Displays length of Celery task queues."
msgstr "ສະແດງຄວາມຍາວຂອງຄິວວຽກງານ Celery."

msgid "Prints current state of the back-end Git repository."
msgstr "ພິມສະຖານະປັດຈຸບັນຂອງ Git repository ເບື້ອງຫຼັງ."

msgid ""
"You can either define which project or component to update (for example "
"``weblate/application``), or use ``--all`` to update all existing components."
msgstr ""
"ທ່ານສາມາດກຳນົດໂຄງການ ຫຼື ອົງປະກອບທີ່ຈະອັບເດດ (ຕົວຢ່າງ ``weblate/application``), ຫຼື ໃຊ້ "
"``--all`` ເພື່ອອັບເດດອົງປະກອບທີ່ມີຢູ່ທັງໝົດ."

msgid "Commits any possible pending changes to the back-end Git repository."
msgstr "ຄອມມິດການປ່ຽນແປງທີ່ຄ້າງຄາທັງໝົດໄປຍັງ Git repository ເບື້ອງຫຼັງ."

msgid ""
"You can either define which project or component to update (for example "
"``weblate/application``), or use ``--all`` to update all existing "
"components, or use ``--file-format`` to filter based on the file format."
msgstr ""
"ທ່ານສາມາດກຳນົດໂຄງການ ຫຼື ອົງປະກອບທີ່ຈະອັບເດດ (ຕົວຢ່າງ ``weblate/application``), ຫຼື ໃຊ້ "
"``--all`` ເພື່ອອັບເດດອົງປະກອບທີ່ມີຢູ່ທັງໝົດ, ຫຼື ໃຊ້ ``--file-format`` ເພື່ອກັ່ນກອງຕາມຮູບແບບໄຟລ໌."

msgid "Commits pending changes older than a given age."
msgstr "ຄອມມິດການປ່ຽນແປງທີ່ຄ້າງຄາ ເຊິ່ງເກົ່າກວ່າອາຍຸທີ່ກຳນົດໄວ້."

msgid ""
"This is automatically performed in the background by Weblate, so there no "
"real need to invoke this manually, besides forcing an earlier commit than "
"specified by :ref:`component`."
msgstr ""
"ສິ່ງນີ້ຖືກປະຕິບັດໂດຍອັດຕະໂນມັດໃນເບື້ອງຫຼັງໂດຍ Weblate, "
"ສະນັ້ນຈຶ່ງບໍ່ມີຄວາມຈຳເປັນຕ້ອງເອີ້ນໃຊ້ມັນດ້ວຍຕົນເອງ, "
"ນອກຈາກການບັງຄັບໃຫ້ຄອມມິດໄວຂຶ້ນກວ່າທີ່ລະບຸໄວ້ໂດຍ :ref:`component`."

msgid ""
"Cleans up orphaned checks and translation suggestions. There is normally no "
"need to run this manually, as the cleanups happen automatically in the "
"background."
msgstr ""
"ລຶບການກວດສອບ ແລະ ຄຳແນະນຳການແປທີ່ຕົກຄ້າງ. ໂດຍປົກກະຕິບໍ່ຈຳເປັນຕ້ອງຮັນດ້ວຍຕົນເອງ, "
"ເນື່ອງຈາກການລຶບລ້າງຈະເກີດຂຶ້ນໂດຍອັດຕະໂນມັດໃນເບື້ອງຫຼັງ."

msgid ""
"Removes all obsolete entries with pending status from the translation memory."
msgstr "ລຶບລາຍການທີ່ລ້າສະໄໝທັງໝົດທີ່ມີສະຖານະຄ້າງຄາອອກຈາກໜ່ວຍຄວາມຈຳການແປ."

msgid "Performs cleanup of stored SSH host keys:"
msgstr "ດຳເນີນການລຶບລ້າງ SSH host keys ທີ່ຈັດເກັບໄວ້:"

msgid ""
"Removes deprecated RSA keys for GitHub which might cause issues connecting "
"to GitHub."
msgstr ""
"ລຶບ RSA keys ທີ່ເລີກໃຊ້ແລ້ວສຳລັບ GitHub ເຊິ່ງອາດເຮັດໃຫ້ເກີດບັນຫາໃນການເຊື່ອມຕໍ່ກັບ GitHub."

msgid "Removes duplicate entries in host keys."
msgstr "ລຶບລາຍການທີ່ຊ້ຳກັນໃນ host keys."

msgid ""
"Creates an ``admin`` account with a random password, unless it is specified."
msgstr "ສ້າງບັນຊີ ``admin`` ດ້ວຍລະຫັດຜ່ານແບບສຸ່ມ, ຍົກເວັ້ນແຕ່ຈະມີການກຳນົດໄວ້."

msgid "Export a JSON file containing Weblate Translation Memory content."
msgstr "ສົ່ງອອກໄຟລ໌ JSON ທີ່ບັນຈຸເນື້ອຫາໜ່ວຍຄວາມຈຳການແປຂອງ Weblate."

msgid "Dumps userdata to a file for later use by :wladmin:`importuserdata`."
msgstr "ດັມບ໌ (Dump) ຂໍ້ມູນຜູ້ໃຊ້ໄປຍັງໄຟລ໌ເພື່ອໃຊ້ໃນພາຍຫຼັງໂດຍ :wladmin:`importuserdata`."

msgid "This comes in handy when migrating or merging Weblate instances."
msgstr "ສິ່ງນີ້ມີປະໂຫຍດເມື່ອຍ້າຍ ຫຼື ລວມລະບົບ Weblate."

msgid ""
"Creates a demo project with components based on <https://github.com/"
"WeblateOrg/demo>. Make sure the celery tasks are running before running this "
"command."
msgstr ""
"ສ້າງໂຄງການຕົວຢ່າງທີ່ມີອົງປະກອບອີງຕາມ <https://github.com/WeblateOrg/demo>. "
"ຕ້ອງໃຫ້ແນ່ໃຈວ່າວຽກງານ celery ກຳລັງຮັນຢູ່ກ່ອນທີ່ຈະຮັນຄຳສັ່ງນີ້."

msgid "This can be useful when developing Weblate."
msgstr "ສິ່ງນີ້ອາດເປັນປະໂຫຍດເມື່ອພັດທະນາ Weblate."

msgid "Batch import of components based on JSON data."
msgstr "ນຳເຂົ້າອົງປະກອບເປັນຊຸດໂດຍອີງໃສ່ຂໍ້ມູນ JSON."

msgid ""
"The imported JSON file structure pretty much corresponds to the component "
"object (see :http:get:`/api/components/(string:project)/(string:component)/"
"`). You have to include the ``name`` and ``filemask`` fields."
msgstr ""
"ໂຄງສ້າງໄຟລ໌ JSON ທີ່ນຳເຂົ້າມາຈະສອດຄ່ອງກັບວັດຖຸອົງປະກອບ (ເບິ່ງ :http:get:`/api/components/"
"(string:project)/(string:component)/`). ທ່ານຕ້ອງລວມຊ່ອງຂໍ້ມູນ ``name`` ແລະ "
"``filemask``."

msgid "Example of JSON file:"
msgstr "ຕົວຢ່າງຂອງໄຟລ໌ JSON:"

msgid "Imports a file into the Weblate translation memory."
msgstr "ນຳເຂົ້າໄຟລ໌ເຂົ້າໃນໜ່ວຍຄວາມຈຳການແປຂອງ Weblate."

msgid "Supported file formats are TMX, JSON, XLIFF, PO, CSV."
msgstr "ຮູບແບບໄຟລ໌ທີ່ຮອງຮັບຄື TMX, JSON, XLIFF, PO, CSV."

msgid ""
"Specifying a source and a target languages might be necessary for formats "
"other than JSON and TMX."
msgstr ""
"ການລະບຸພາສາຕົ້ນສະບັບ ແລະ ປາຍທາງອາດຈະຈຳເປັນສຳລັບຮູບແບບອື່ນນອກເໜືອຈາກ JSON ແລະ TMX."

msgid ""
"Batch imports components into project based on the file mask. It is based on "
"the :ref:`addon-weblate.discovery.discovery` add-on, so you might want to "
"use that instead."
msgstr ""
"ນຳເຂົ້າອົງປະກອບເປັນຊຸດເຂົ້າໃນໂຄງການໂດຍອີງໃສ່ file mask. ມັນອີງໃສ່ add-on :ref:`addon-"
"weblate.discovery.discovery`, ສະນັ້ນທ່ານອາດຈະຕ້ອງການໃຊ້ສິ່ງນັ້ນແທນ."

msgid ""
"`<project>` names an existing project, into which the components are to be "
"imported."
msgstr "`<project>` ແມ່ນຊື່ຂອງໂຄງການທີ່ມີຢູ່ແລ້ວ, ເຊິ່ງອົງປະກອບຈະຖືກນຳເຂົ້າໃສ່."

msgid ""
"The `<gitrepo>` defines the Git repository URL to use, and `<branch>` "
"signifies the Git branch. To import additional translation components from "
"an existing Weblate component, use a `weblate://<project>/<component>` URL "
"for the `<gitrepo>`."
msgstr ""
"`<gitrepo>` ກຳນົດ Git repository URL ທີ່ຈະໃຊ້, ແລະ `<branch>` ສື່ເຖິງ Git branch. "
"ເພື່ອຊ່ວຍນຳເຂົ້າອົງປະກອບການແປເພີ່ມເຕີມຈາກອົງປະກອບ Weblate ທີ່ມີຢູ່, ໃຫ້ໃຊ້ URL `weblate://"
"<project>/<component>` ສຳລັບ `<gitrepo>`."

msgid ""
"The `<filemask>` defines file discovery for the repository. It can be either "
"be made simple using wildcards, or it can use the full power of regular "
"expressions."
msgstr ""
"`<filemask>` ກຳນົດການຊອກຫາໄຟລ໌ສຳລັບ repository. ມັນສາມາດເຮັດໃຫ້ງ່າຍໂດຍໃຊ້ wildcards, "
"ຫຼື ສາມາດໃຊ້ພະລັງເຕັມທີ່ຂອງ regular expressions."

msgid ""
"The simple matching uses ``**`` for component name and ``*`` for language, "
"for example: ``**/*.po``"
msgstr ""
"ການຈັບຄູ່ແບບງ່າຍຈະໃຊ້ ``**`` ສຳລັບຊື່ອົງປະກອບ ແລະ ``*`` ສຳລັບພາສາ, ຕົວຢ່າງ: ``**/*.po``"

msgid ""
"The regular expression has to contain groups named `component` and "
"`language`, for example: ``(?P<language>[^/]*)/(?P<component>[^-/]*)\\.po``."
msgstr ""
"ນິພົດປົກກະຕິຕ້ອງມີກຸ່ມທີ່ຕັ້ງຊື່ວ່າ component ແລະ language, ຕົວຢ່າງເຊັ່ນ: ``(?P<language>[^/]*)/"
"(?P<component>[^-/]*)\\.po``."

msgid ""
"The import matches existing components based on files and adds the ones that "
"do not exist. It does not change already existing ones."
msgstr ""
"ການນຳເຂົ້າຈະຈັບຄູ່ອົງປະກອບທີ່ມີຢູ່ໂດຍອີງໃສ່ໄຟລ໌ ແລະ ເພີ່ມອົງປະກອບທີ່ບໍ່ທັນມີຢູ່. "
"ມັນຈະບໍ່ປ່ຽນແປງອົງປະກອບທີ່ມີຢູ່ແລ້ວ."

msgid "To give you some examples, let's try importing two projects."
msgstr "ເພື່ອໃຫ້ຕົວຢ່າງບາງຢ່າງແກ່ທ່ານ, ລອງນຳເຂົ້າສອງໂຄງການ."

msgid ""
"First The Debian Handbook translations, where each language has separate a "
"folder with the translations of each chapter:"
msgstr ""
"ທຳອິດແມ່ນການແປ The Debian Handbook, "
"ເຊິ່ງແຕ່ລະພາສາມີໂຟນເດີແຍກຕ່າງຫາກພ້ອມກັບການແປຂອງແຕ່ລະບົດ:"

msgid ""
"Then the Tanaguru tool, where the file format needs be specified, along with "
"the base file template, and how all components and translations are located "
"in single folder:"
msgstr ""
"ຈາກນັ້ນແມ່ນເຄື່ອງມື Tanaguru, ເຊິ່ງຮູບແບບໄຟລ໌ຕ້ອງຖືກລະບຸ, ພ້ອມກັບ base file template, ແລະ "
"ວິທີທີ່ອົງປະກອບ ແລະ ການແປທັງໝົດຕັ້ງຢູ່ໃນໂຟນເດີດຽວ:"

msgid ""
"More complex example of parsing of filenames to get the correct component "
"and language out of a filename like ``src/security/"
"Numerous_security_holes_in_0.10.1.de.po``:"
msgstr ""
"ຕົວຢ່າງທີ່ຊັບຊ້ອນກວ່ານີ້ຂອງການວິເຄາະຊື່ໄຟລ໌ເພື່ອໃຫ້ໄດ້ອົງປະກອບ ແລະ ພາສາທີ່ຖືກຕ້ອງອອກຈາກຊື່ໄຟລ໌ເຊັ່ນ "
"``src/security/Numerous_security_holes_in_0.10.1.de.po``:"

msgid "Filtering only translations in a chosen language:"
msgstr "ກັ່ນກອງພຽງແຕ່ການແປໃນພາສາທີ່ເລືອກ:"

msgid "Importing Sphinx documentation split to multiple files:"
msgstr "ນຳເຂົ້າເອກະສານ Sphinx ທີ່ແຍກເປັນຫຼາຍໄຟລ໌:"

msgid "Importing Sphinx documentation split to multiple files and directories:"
msgstr "ນຳເຂົ້າເອກະສານ Sphinx ທີ່ແຍກເປັນຫຼາຍໄຟລ໌ ແລະ ຫຼາຍໄດເລກະທໍຣີ:"

msgid ""
"More detailed examples can be found in the :ref:`starting` chapter, "
"alternatively you might want to use :wladmin:`import_json`."
msgstr ""
"ຕົວຢ່າງທີ່ລະອຽດກວ່ານີ້ສາມາດພົບໄດ້ໃນບົດ :ref:`starting`, ຫຼື "
"ທາງເລືອກອື່ນທ່ານອາດຕ້ອງການໃຊ້ :wladmin:`import_json`."

msgid "Imports :ref:`projectbackup`."
msgstr "ນຳເຂົ້າ :ref:`projectbackup`."

msgid ""
"Usually it is more comfortable to import project when :ref:`adding-projects`."
msgstr "ປົກກະຕິແລ້ວການນຳເຂົ້າໂຄງການຈະສະດວກກວ່າເມື່ອ :ref:`adding-projects`."

msgid "Imports user data from a file created by :wladmin:`dumpuserdata`."
msgstr "ນຳເຂົ້າຂໍ້ມູນຜູ້ໃຊ້ຈາກໄຟລ໌ທີ່ສ້າງໂດຍ :wladmin:`dumpuserdata`."

msgid "Imports users from JSON dump of the Django auth_users database."
msgstr "ນຳເຂົ້າຜູ້ໃຊ້ຈາກ JSON dump ຂອງຖານຂໍ້ມູນ Django auth_users."

msgid "You can dump users from the existing Django site using:"
msgstr "ທ່ານສາມາດດັມບ໌ຜູ້ໃຊ້ຈາກເວັບໄຊ Django ທີ່ມີຢູ່ໂດຍໃຊ້:"

msgid ""
"Use :wladmin:`dumpuserdata` for dumping data from other Weblate server as "
"that includes user settings as well."
msgstr ""
"ໃຊ້ :wladmin:`dumpuserdata` ສຳລັບການດັມບ໌ຂໍ້ມູນຈາກເຊີບເວີ Weblate ອື່ນ "
"ເນື່ອງຈາກມັນລວມການຕັ້ງຄ່າຜູ້ໃຊ້ໄວ້ນຳ."

msgid "Installs an add-on to a set of components."
msgstr "ຕິດຕັ້ງ add-on ໃຫ້ກັບຊຸດຂອງອົງປະກອບ."

msgid ""
"You can either define which project or component to install the add-on in "
"(for example ``weblate/application``), or use ``--all`` to include all "
"existing components."
msgstr ""
"ທ່ານສາມາດກຳນົດໂຄງການ ຫຼື ອົງປະກອບທີ່ຈະຕິດຕັ້ງ add-on (ຕົວຢ່າງ ``weblate/application``), "
"ຫຼື ໃຊ້ ``--all`` ເພື່ອລວມອົງປະກອບທີ່ມີຢູ່ທັງໝົດ."

msgid "To install :ref:`addon-weblate.gettext.mo` for all components:"
msgstr "ເພື່ອຕິດຕັ້ງ :ref:`addon-weblate.gettext.mo` ສຳລັບທຸກອົງປະກອບ:"

msgid "Installs a site-wide automatic suggestion service."
msgstr "ຕິດຕັ້ງການບໍລິການຄຳແນະນຳອັດຕະໂນມັດສຳລັບທັງເວັບໄຊ."

msgid "To install :ref:`mt-deepl`:"
msgstr "ເພື່ອຕິດຕັ້ງ :ref:`mt-deepl`:"

msgid ""
"Lists add-ons in reStructuredText as a template for :doc:`/admin/addons`."
msgstr ""
"ລາຍການ add-ons ໃນຮູບແບບ reStructuredText ເປັນແມ່ແບບສຳລັບ :doc:`/admin/addons`."

msgid ""
"Lists permissions in reStructuredText as a template for :doc:`/admin/access`."
msgstr ""
"ລາຍການສິດທິອະນຸຍາດໃນຮູບແບບ reStructuredText ເປັນແມ່ແບບສຳລັບ :doc:`/admin/access`."

msgid ""
"Lists quality checks in reStructuredText as a template for :doc:`/admin/"
"checks` and :doc:`/user/checks`."
msgstr ""
"ລາຍການການກວດສອບຄຸນນະພາບໃນຮູບແບບ reStructuredText ເປັນແມ່ແບບສຳລັບ :doc:`/admin/"
"checks` ແລະ :doc:`/user/checks`."

msgid ""
"Using ``--output`` requires selecting exactly one value in ``--sections`` so "
"each generated snippet is written to its own file. This matches the :doc:`/"
"contributing/documentation` workflow and the ``make -C docs update-docs`` "
"targets."
msgstr ""
"ການໃຊ້ ``--output`` ຕ້ອງເລືອກພຽງຄ່າດຽວໃນ ``--sections`` ເພື່ອໃຫ້ snippet "
"ທີ່ສ້າງຂຶ້ນແຕ່ລະອັນຖືກຂຽນລົງໃນໄຟລ໌ຂອງຕົນເອງ. ນີ້ສອດຄ່ອງກັບຂະບວນການ :doc:`/contributing/"
"documentation` ແລະ ເປົ້າໝາຍ ``make -C docs update-docs``."

msgid ""
"Lists supported languages in MediaWiki markup - language codes, English "
"names and localized names."
msgstr ""
"ລາຍການພາສາທີ່ຮອງຮັບໃນ MediaWiki markup - ລະຫັດພາສາ, ຊື່ພາສາອັງກິດ ແລະ ຊື່ພາສາທ້ອງຖິ່ນ."

msgid ""
"This is used to generate <https://www.l10n.cz/wiki/Slovn%C3%ADky/"
"Slovn%C3%ADk_s_n%C3%A1zvy_jazyk%C5%AF/>."
msgstr ""
"ສິ່ງນີ້ຖືກໃຊ້ເພື່ອສ້າງ <https://www.l10n.cz/wiki/Slovn%C3%ADky/"
"Slovn%C3%ADk_s_n%C3%A1zvy_jazyk%C5%AF/>."

msgid ""
"Lists automatic suggestions services in reStructuredText as a template "
"for :doc:`/admin/machine`."
msgstr ""
"ລາຍການບໍລິການຄຳແນະນຳອັດຕະໂນມັດໃນຮູບແບບ reStructuredText ເປັນແມ່ແບບສຳລັບ :doc:`/admin/"
"machine`."

msgid "Lists translators by contributed language for the given project:"
msgstr "ລາຍການນັກແປຕາມພາສາທີ່ປະກອບສ່ວນສຳລັບໂຄງການທີ່ກຳນົດ:"

msgid ""
"You can either define which project or component to use (for example "
"``weblate/application``), or use ``--all`` to list translators from all "
"existing components."
msgstr ""
"ທ່ານສາມາດກຳນົດໂຄງການ ຫຼື ອົງປະກອບທີ່ຈະໃຊ້ (ຕົວຢ່າງ ``weblate/application``), ຫຼື ໃຊ້ ``--"
"all`` ເພື່ອລາຍຊື່ນັກແປຈາກອົງປະກອບທີ່ມີຢູ່ທັງໝົດ."

msgid "Lists all Weblate dependencies and their versions."
msgstr "ລາຍການຄວາມຕ້ອງການຂອງ Weblate ແລະ ເວີຊັນຂອງພວກມັນ."

msgid "Lists File format parameters."
msgstr "ລາຍການພາຣາມິເຕີຮູບແບບໄຟລ໌."

msgid "Lists all possible change event types."
msgstr "ລາຍການປະເພດເຫດການການປ່ຽນແປງທີ່ເປັນໄປໄດ້ທັງໝົດ."

msgid ""
"Generates RST documentation snippets describing the supported features for "
"every file format."
msgstr "ສ້າງ RST documentation snippets ທີ່ອະທິບາຍຄຸນສົມບັດທີ່ຮອງຮັບສຳລັບທຸກຮູບແບບໄຟລ໌."

msgid ""
"The command generates one file for every format, that can be found in the "
"specified output directory."
msgstr "ຄຳສັ່ງນີ້ສ້າງໄຟລ໌ໜຶ່ງໄຟລ໌ຕໍ່ຮູບແບບ, ເຊິ່ງສາມາດພົບໄດ້ໃນໄດເລກະທໍຣີຜົນລັດທີ່ລະບຸ."

msgid ""
"The generated documentation files are meant to be included in documentation "
"sources such as :doc:`/formats`. See also :file:`weblate/formats/management/"
"commands/list_format_features.py` for customization and merging logic."
msgstr ""
"ໄຟລ໌ເອກະສານທີ່ສ້າງຂຶ້ນມີໄວ້ເພື່ອລວມເຂົ້າໃນແຫຼ່ງຂໍ້ມູນເອກະສານ ເຊັ່ນ :doc:`/formats`. "
"ເບິ່ງເພີ່ມເຕີມທີ່ :file:`weblate/formats/management/commands/"
"list_format_features.py` ສຳລັບເຫດຜົນການປັບແຕ່ງ ແລະ ການລວມ."

msgid ""
"Reloads translations from disk (for example in case you have done some "
"updates in the VCS repository)."
msgstr "ໂຫຼດການແປຄືນໃໝ່ຈາກດິສກ໌ (ຕົວຢ່າງ ໃນກໍລະນີທີ່ທ່ານໄດ້ອັບເດດບາງຢ່າງໃນ VCS repository)."

msgid ""
"You seldom need to invoke this, Weblate will automatically load changed "
"files for every VCS update. This is needed in case you manually changed an "
"underlying Weblate VCS repository or in some special cases following an "
"upgrade."
msgstr ""
"ທ່ານບໍ່ຄ່ອຍຈຳເປັນຕ້ອງເອີ້ນໃຊ້ມັນ, Weblate ຈະໂຫຼດໄຟລ໌ທີ່ປ່ຽນແປງໂດຍອັດຕະໂນມັດສຳລັບທຸກການອັບເດດ "
"VCS. ສິ່ງນີ້ຈຳເປັນໃນກໍລະນີທີ່ທ່ານປ່ຽນແປງ VCS repository ຂອງ Weblate ເບື້ອງຫຼັງດ້ວຍຕົນເອງ ຫຼື "
"ໃນກໍລະນີພິເສດບາງຢ່າງຫຼັງຈາກການອັບເກຣດ."

msgid "Prevents further translation of a component."
msgstr "ປ້ອງກັນການແປອົງປະກອບເພີ່ມເຕີມ."

msgid ""
"Useful in case you want to do some maintenance on the underlying repository."
msgstr "ມີປະໂຫຍດໃນກໍລະນີທີ່ທ່ານຕ້ອງການບຳລຸງຮັກສາ repository ເບື້ອງຫຼັງ."

msgid "Outputs the server metrics exposed by :http:get:`/api/metrics/`."
msgstr ""
"ສະແດງຕົວຊີ້ວັດປະສິດທິພາບຂອງເຊີເວີ (server metrics) ທີ່ເປີດເຜີຍໂດຍ :http:get:`/api/"
"metrics/`."

msgid ""
"Migrates database to current Weblate schema. The command line options are "
"described at Django :djadmin:`django:migrate`."
msgstr ""
"ຍ້າຍຖານຂໍ້ມູນໄປຍັງ schema Weblate ປັດຈຸບັນ. ຕົວເລືອກແຖວຄຳສັ່ງຖືກອະທິບາຍໄວ້ທີ່ "
"Django :djadmin:`django:migrate`."

msgid ""
"In case you want to run an installation non interactively, you can "
"use :samp:`weblate migrate --noinput`, and then create an admin user "
"using :wladmin:`createadmin` command."
msgstr ""
"ໃນກໍລະນີທີ່ທ່ານຕ້ອງການຮັນການຕິດຕັ້ງແບບບໍ່ຕ້ອງໂຕ້ຕອບ, ທ່ານສາມາດໃຊ້ :samp:`weblate migrate --"
"noinput`, ຈາກນັ້ນສ້າງຜູ້ໃຊ້ admin ໂດຍໃຊ້ຄຳສັ່ງ :wladmin:`createadmin`."

msgid ":djadmin:`django:migrate`"
msgstr ":djadmin:`django:migrate`"

msgid ""
"Allows you to merge language content. This is useful when updating to a new "
"version which contains aliases for previously unknown languages that have "
"been created with the :samp:`(generated)` suffix. It moves all content from "
"the `source` language to the `target` one."
msgstr ""
"ອະນຸຍາດໃຫ້ທ່ານລວມເນື້ອຫາພາສາ. "
"ສິ່ງນີ້ມີປະໂຫຍດເມື່ອອັບເດດເປັນເວີຊັນໃໝ່ທີ່ມີນາມແຝງສຳລັບພາສາທີ່ບໍ່ຮູ້ຈັກມາກ່ອນ ເຊິ່ງຖືກສ້າງຂຶ້ນດ້ວຍ "
"suffix :samp:`(generated)`. ມັນຍ້າຍເນື້ອຫາທັງໝົດຈາກພາສາ `source` ໄປຍັງພາສາ `target`."

msgid ""
"After moving the content, you should check whether there is anything left "
"(this is subject to race conditions when somebody updates the repository "
"meanwhile) and remove the :samp:`(generated)` language."
msgstr ""
"ຫຼັງຈາກຍ້າຍເນື້ອຫາແລ້ວ, ທ່ານຄວນກວດສອບວ່າຍັງມີຫຍັງເຫຼືອຢູ່ບໍ່ (ສິ່ງນີ້ອາດເກີດ race conditions "
"ຖ້າມີຄົນອັບເດດ repository ໃນຂະນະດຽວກັນ) ແລະ ລຶບພາສາ :samp:`(generated)` ອອກ."

msgid "Pushes committed changes to the upstream VCS repository."
msgstr "ພັຊ (Push) ການປ່ຽນແປງທີ່ຄອມມິດແລ້ວໄປຍັງ upstream VCS repository."

msgid ""
"Weblate pushes changes automatically if :ref:`component-push_on_commit` "
"in :ref:`component` is turned on, which is the default."
msgstr ""
"Weblate ຈະພັຊການປ່ຽນແປງໂດຍອັດຕະໂນມັດຖ້າ :ref:`component-push_on_commit` "
"ໃນ :ref:`component` ຖືກເປີດໃຊ້, ເຊິ່ງເປັນຄ່າເລີ່ມຕົ້ນ."

msgid "Unlocks a given component, making it available for translation."
msgstr "ປົດລັອກອົງປະກອບທີ່ກຳນົດ, ເຮັດໃຫ້ມັນສາມາດແປໄດ້."

msgid ""
"Configures default groups and optionally assigns all users to that default "
"group."
msgstr "ຕັ້ງຄ່າກຸ່ມເລີ່ມຕົ້ນ ແລະ ມອບໝາຍຜູ້ໃຊ້ທັງໝົດໃຫ້ກັບກຸ່ມເລີ່ມຕົ້ນນັ້ນ (ທາງເລືອກ)."

msgid "Updates list of defined languages in Weblate."
msgstr "ອັບເດດລາຍການພາສາທີ່ກຳນົດໄວ້ໃນ Weblate."

msgid "Updates all checks for all strings."
msgstr "ອັບເດດການກວດສອບທັງໝົດສຳລັບຂໍ້ຄວາມທັງໝົດ."

msgid "Useful for upgrades which do major changes to checks."
msgstr "ມີປະໂຫຍດສຳລັບການອັບເກຣດທີ່ມີການປ່ຽນແປງໃຫຍ່ຕໍ່ການກວດສອບ."

msgid ""
"Checks are recalculated regularly by Weblate in the background, the "
"frequency can be configured via :setting:`BACKGROUND_TASKS`."
msgstr ""
"ການກວດສອບຈະຖືກຄຳນວນຄືນໃໝ່ເປັນປົກກະຕິໂດຍ Weblate ໃນເບື້ອງຫຼັງ, "
"ຄວາມຖີ່ສາມາດຕັ້ງຄ່າໄດ້ຜ່ານ :setting:`BACKGROUND_TASKS`."

msgid "Fetches remote VCS repositories and updates the internal cache."
msgstr "ດຶງຂໍ້ມູນ remote VCS repositories ແລະ ອັບເດດ cache ພາຍໃນ."

msgid ""
"Usually it is better to configure hooks in the repository to "
"trigger :ref:`hooks`, instead of regular triggering the updates "
"by :wladmin:`updategit`."
msgstr ""
"ປົກກະຕິແລ້ວມັນດີກວ່າທີ່ຈະຕັ້ງຄ່າ hooks ໃນ repository ເພື່ອກະຕຸ້ນ :ref:`hooks`, "
"ແທນທີ່ຈະກະຕຸ້ນການອັບເດດເປັນປົກກະຕິໂດຍ :wladmin:`updategit`."

msgid "Translation Memory"
msgstr "ໜ່ວຍຄວາມຈຳການແປ"

msgid "Weblate comes with a built-in translation memory consisting of:"
msgstr "Weblate ມາພ້ອມກັບໜ່ວຍຄວາມຈຳການແປໃນຕົວ ເຊິ່ງປະກອບດ້ວຍ:"

msgid "Manually imported translation memory (see :ref:`memory-user`)."
msgstr "ໜ່ວຍຄວາມຈຳການແປທີ່ນຳເຂົ້າດ້ວຍຕົນເອງ (ເບິ່ງ :ref:`memory-user`)."

msgid ""
"Automatically stored translations performed in Weblate (depending "
"on :ref:`memory-scopes`)."
msgstr "ການແປທີ່ຖືກເກັບໄວ້ໂດຍອັດຕະໂນມັດທີ່ປະຕິບັດໃນ Weblate (ຂຶ້ນກັບ :ref:`memory-scopes`)."

msgid "Automatically imported past translations."
msgstr "ຄຳແປໃນອະດີດທີ່ນຳເຂົ້າໂດຍອັດຕະໂນມັດ."

msgid ""
"Content in the translation memory can be applied to strings in several ways:"
msgstr "ເນື້ອຫາໃນໜ່ວຍຄວາມຈຳການແປສາມາດນຳໃຊ້ກັບຂໍ້ຄວາມໄດ້ໃນຫຼາຍວິທີ:"

msgid ""
"User can accept suggestions from the :ref:`machine-translation` tab while "
"editing the string."
msgstr ""
"ຜູ້ໃຊ້ສາມາດຍອມຮັບຄຳແນະນຳຈາກແຖບ :ref:`machine-translation` ໃນຂະນະທີ່ແກ້ໄຂຂໍ້ຄວາມ."

msgid ""
"The selected strings can be processed using :ref:`auto-translation` from "
"the :guilabel:`Operations` menu."
msgstr ""
"ຂໍ້ຄວາມທີ່ເລືອກສາມາດຖືກປະມວນຜົນໂດຍໃຊ້ :ref:`auto-translation` "
"ຈາກເມນູ :guilabel:`Operations`."

msgid ""
":ref:`addon-weblate.autotranslate.autotranslate` add-on can automatically "
"apply changes to new and existing strings."
msgstr ""
"add-on :ref:`addon-weblate.autotranslate.autotranslate` "
"ສາມາດນຳໃຊ້ການປ່ຽນແປງກັບຂໍ້ຄວາມໃໝ່ ແລະ ທີ່ມີຢູ່ແລ້ວໂດຍອັດຕະໂນມັດ."

msgid ""
"For installation tips, see :ref:`mt-weblate-translation-memory`, which is "
"turned on by default."
msgstr ""
"ສຳລັບຄຳແນະນຳການຕິດຕັ້ງ, ເບິ່ງ :ref:`mt-weblate-translation-memory`, "
"ເຊິ່ງຖືກເປີດໃຊ້ໂດຍເລີ່ມຕົ້ນ."

msgid "Translation-memory scopes"
msgstr "ຂອບເຂດໜ່ວຍຄວາມຈຳການແປ"

msgid ""
"The translation-memory scopes ensure privacy for different projects and "
"users. Sharing of translations is also available."
msgstr ""
"ຂອບເຂດໜ່ວຍຄວາມຈຳການແປຮັບປະກັນຄວາມເປັນສ່ວນຕົວສຳລັບໂຄງການ ແລະ ຜູ້ໃຊ້ທີ່ແຕກຕ່າງກັນ. "
"ການແບ່ງປັນຄຳແປຍັງສາມາດໃຊ້ງານໄດ້."

msgid ""
"When upgrading from older Weblate releases, existing translation-memory "
"entries are converted to scopes by a periodic Celery background task. Until "
"this backfill finishes, existing entries can be temporarily unavailable in "
"suggestions and memory management views. Keep Celery running after the "
"upgrade so the periodic task can start or resume the migration. Site "
"administrators can monitor the backfill and duplicate-entry consolidation "
"in :guilabel:`Administration` > :guilabel:`Performance report`."
msgstr ""
"ເມື່ອອັບເກຣດຈາກເວີຊັນ Weblate ເກົ່າ, "
"ລາຍການໜ່ວຍຄວາມຈຳການແປທີ່ມີຢູ່ຈະຖືກປ່ຽນເປັນຂອບເຂດໂດຍວຽກງານ Celery ພື້ນຫຼັງແບບແຍກເວລາ. "
"ຈົນກວ່າການຕື່ມຂໍ້ມູນນີ້ຈະສຳເລັດ, ລາຍການທີ່ມີຢູ້ອາດຈະບໍ່ສາມາດໃຊ້ງານໄດ້ຊົ່ວຄາວໃນມຸມມອງຄຳແນະນຳ ແລະ "
"ການຈັດການໜ່ວຍຄວາມຈຳ. ຮັກສາໃຫ້ Celery ຮັນຢູ່ຫຼັງຈາກການອັບເກຣດເພື່ອໃຫ້ວຽກງານພື້ນຫຼັງສາມາດເລີ່ມຕົ້ນ "
"ຫຼື ສືບຕໍ່ການຍ້າຍຂໍ້ມູນ. ຜູ້ເບິ່ງແຍງລະບົບສາມາດຕິດຕາມການຕື່ມຂໍ້ມູນ ແລະ "
"ການລວມລາຍການທີ່ຊ້ຳກັນໄດ້ໃນ :guilabel:`Administration` > :guilabel:`Performance "
"report`."

msgid "Imported translation memory"
msgstr "ໜ່ວຍຄວາມຈຳການແປທີ່ນຳເຂົ້າ"

msgid ""
"Importing arbitrary translation memory data using "
"the :wladmin:`import_memory` command makes memory content available to all "
"users and projects."
msgstr ""
"ການນຳເຂົ້າຂໍ້ມູນໜ່ວຍຄວາມຈຳການແປໃດໆໂດຍໃຊ້ຄຳສັ່ງ :wladmin:`import_memory` "
"ຈະເຮັດໃຫ້ເນື້ອຫາໜ່ວຍຄວາມຈຳສາມາດໃຊ້ໄດ້ກັບຜູ້ໃຊ້ ແລະ ໂຄງການທັງໝົດ."

msgid "Per-user translation memory"
msgstr "ໜ່ວຍຄວາມຈຳການແປຕໍ່ຜູ້ໃຊ້"

msgid ""
"Stores all user translations automatically in the personal translation "
"memory of each respective user."
msgstr "ຈັດເກັບຄຳແປຂອງຜູ້ໃຊ້ທັງໝົດໂດຍອັດຕະໂນມັດໃນໜ່ວຍຄວາມຈຳການແປສ່ວນບຸກຄົນຂອງແຕ່ລະຜູ້ໃຊ້."

msgid ""
"The default value for new users is automatically adjusted based on "
"the :ref:`autoclean-tm` configuration. If automatic cleanup is enabled, this "
"is disabled by default to prevent reintroducing inconsistent translations."
msgstr ""
"ຄ່າເລີ່ມຕົ້ນສຳລັບຜູ້ໃຊ້ໃໝ່ຈະຖືກປັບໂດຍອັດຕະໂນມັດໂດຍອີງໃສ່ການຕັ້ງຄ່າ :ref:`autoclean-tm`. "
"ຖ້າເປີດໃຊ້ການລຶບລ້າງອັດຕະໂນມັດ, "
"ສິ່ງນີ້ຈະຖືກປິດໃຊ້ງານໂດຍເລີ່ມຕົ້ນເພື່ອປ້ອງກັນບໍ່ໃຫ້ເກີດການນຳຄຳແປທີ່ບໍ່ສອດຄ້ອງກັນກັບມາໃຊ້ໃໝ່."

msgid "Per-project translation memory"
msgstr "ໜ່ວຍຄວາມຈຳການແປຕໍ່ໂຄງການ"

msgid ""
"All translations within a project are automatically stored in a project "
"translation memory only available for this project."
msgstr ""
"ຄຳແປທັງໝົດພາຍໃນໂຄງການຈະຖືກຈັດເກັບໂດຍອັດຕະໂນມັດໃນໜ່ວຍຄວາມຈຳການແປຂອງໂຄງການ "
"ເຊິ່ງສາມາດໃຊ້ໄດ້ສະເພາະໂຄງການນີ້ເທົ່ານັ້ນ."

msgid ""
"Entries attributed to an existing restricted component are only available to "
"users who can access that component. This also applies when project memory "
"is downloaded or accessed using the REST API."
msgstr ""

msgid ""
"Legacy entries which can not be attributed to a current component use the "
"project access rules. This can happen when the component path has changed or "
"the component has been removed."
msgstr ""

msgid "Workspace translation memory"
msgstr "ໜ່ວຍຄວາມຈຳການແປຂອງພື້ນທີ່ເຮັດວຽກ"

msgid ""
"Projects in the same workspace can share translation memory without enabling "
"the global shared translation memory. Workspace translation memory has to be "
"enabled both in the workspace settings and in the individual project "
"workflow settings."
msgstr ""
"ໂຄງການໃນພື້ນທີ່ເຮັດວຽກດຽວກັນສາມາດແບ່ງປັນໜ່ວຍຄວາມຈຳການແປໄດ້ໂດຍບໍ່ຕ້ອງເປີດໃຊ້ໜ່ວຍຄວາມຈຳການແປແບບແບ່ງປັນທົ່ວໂລກ. "
"ໜ່ວຍຄວາມຈຳການແປຂອງພື້ນທີ່ເຮັດວຽກຕ້ອງຖືກເປີດໃຊ້ທັງໃນການຕັ້ງຄ່າພື້ນທີ່ເຮັດວຽກ ແລະ "
"ໃນການຕັ້ງຄ່າຂັ້ນຕອນການເຮັດວຽກຂອງແຕ່ລະໂຄງການ."

msgid ""
"Entries attributed to an existing restricted component are only available to "
"users who can access that component, even when they can access another "
"project in the workspace. Unattributed legacy entries use the workspace "
"access rules."
msgstr ""

msgid "Shared translation memory"
msgstr "ໜ່ວຍຄວາມຈຳການແປທີ່ໃຊ້ຮ່ວມກັນ"

msgid ""
"All translations within projects with shared translation memory turned on "
"are stored in a shared translation memory available to all projects. Turning "
"off contribution to shared translation memory stops previously contributed "
"automatic entries from being used as shared suggestions."
msgstr ""
"ຄຳແປທັງໝົດພາຍໃນໂຄງການທີ່ມີການເປີດໃຊ້ໜ່ວຍຄວາມຈຳການແປແບບແບ່ງປັນ "
"ຈະຖືກຈັດເກັບໃນໜ່ວຍຄວາມຈຳການແປແບບແບ່ງປັນທີ່ໃຊ້ໄດ້ກັບທຸກໂຄງການ. "
"ການປິດການປະກອບສ່ວນເຂົ້າໃນໜ່ວຍຄວາມຈຳການແປແບບແບ່ງປັນຈະຢຸດການໃຊ້ລາຍການອັດຕະໂນມັດທີ່ປະກອບສ່ວນມາກ່ອນ "
"ເປັນຄຳແນະນຳແບບແບ່ງປັນ."

msgid ""
"Restricted components do not contribute new entries to shared translation "
"memory. On Hosted Weblate, a project with restricted components can not "
"enable shared translation memory, and a component can not be restricted "
"while its project uses shared translation memory."
msgstr ""

msgid ""
"Unattributed legacy entries which are already in shared translation memory "
"use the shared translation memory access rules."
msgstr ""

msgid ""
"Please consider carefully whether to turn this feature on for shared Weblate "
"installations, as it can have severe implications:"
msgstr ""
"ກະລຸນາພິຈາລະນາຢ່າງລະອຽດວ່າຈະເປີດໃຊ້ຄຸນສົມບັດນີ້ສຳລັບການຕິດຕັ້ງ Weblate ແບບແບ່ງປັນຫຼືບໍ່, "
"ເນື່ອງຈາກມັນອາດມີຜົນກະທົບທີ່ຮຸນແຮງ:"

msgid "The translations can be used by anybody else."
msgstr "ຄຳແປເຫຼົ່ານີ້ສາມາດຖືກໃຊ້ໂດຍໃຜກໍໄດ້."

msgid "This might lead to disclosing secret information."
msgstr "ນີ້ອາດນຳໄປສູ່ການເປີດເຜີຍຂໍ້ມູນລັບ."

msgid "Make sure the translations you share have good quality."
msgstr "ຕ້ອງໃຫ້ແນ່ໃຈວ່າຄຳແປທີ່ທ່ານແບ່ງປັນມີຄຸນນະພາບດີ."

msgid "Translation memory status"
msgstr "ສະຖານະໜ່ວຍຄວາມຈຳການແປ"

msgid ""
"Translation memory entries can have two different statuses: **active** and "
"**pending**. Pending entries are included in suggestions, but with a quality "
"penalty applied. Depending on the configured score threshold, the penalty "
"can exclude even exact matches from suggestions and automatic translation. "
"Entries imported from translation memory files are stored as active. "
"If :ref:`autoclean-tm` is enabled, matching pending entries are removed when "
"a translation becomes active."
msgstr ""
"ຂໍ້ມູນໃນຄັງຄຳແປສາມາດມີສອງສະຖານະຄື: **ກຳລັງໃຊ້ງານ (active)** ແລະ **ລໍຖ້າ (pending)**. "
"ຂໍ້ມູນທີ່ລໍຖ້າຈະຖືກລວມເຂົ້າໃນການແນະນຳຄຳແປ ແຕ່ຈະມີການຕັດຄະແນນຄຸນນະພາບ. "
"ອີງຕາມເກນຄະແນນທີ່ຕັ້ງຄ່າໄວ້, ການຕັດຄະແນນອາດເຮັດໃຫ້ຄຳທີ່ກົງກັນທັງໝົດບໍ່ຖືກສະແດງໃນການແນະນຳ ຫຼື "
"ການແປອັດຕະໂນມັດ. ຂໍ້ມູນທີ່ນຳເຂົ້າຈາກໄຟລ໌ຄັງຄຳແປຈະຖືກເກັບເປັນແບບກຳລັງໃຊ້ງານ. "
"ຖ້າເປີດໃຊ້ :ref:`autoclean-tm`, "
"ຂໍ້ມູນລໍຖ້າທີ່ກົງກັນຈະຖືກລຶບອອກເມື່ອຄຳແປນັ້ນປ່ຽນເປັນສະຖານະກຳລັງໃຊ້ງານ."

msgid "Autoclean translation memory"
msgstr "ລ້າງໜ່ວຍຄວາມຈຳການແປອັດຕະໂນມັດ"

msgid ""
"When enabled for a project, Weblate replaces older automatically created "
"translation memory entries when a translation becomes active:"
msgstr ""
"ເມື່ອເປີດໃຊ້ສຳລັບໂຄງການ, Weblate ຈະແທນທີ່ລາຍການໜ່ວຍຄວາມຈຳການແປທີ່ສ້າງຂຶ້ນອັດຕະໂນມັດທີ່ເກົ່າກວ່າ "
"ເມື່ອຄຳແປກາຍເປັນສະຖານະໃຊ້ງານ:"

msgid ""
"With :ref:`project-translation_review` enabled, cleanup happens when the "
"translation is approved."
msgstr ""
"ເມື່ອເປີດໃຊ້ :ref:`project-translation_review`, ການລຶບລ້າງຈະເກີດຂຶ້ນເມື່ອຄຳແປຖືກອະນຸມັດ."

msgid ""
"Without review, cleanup happens as soon as the translation reaches the "
"translated state."
msgstr "ຖ້າບໍ່ມີການກວດສອບ, ການລຶບລ້າງຈະເກີດຂຶ້ນທັນທີທີ່ຄຳແປຮອດສະຖານະ 'ແປແລ້ວ'."

msgid ""
"For the same source string, component, context, and source/target language "
"pair, Weblate removes matching non-file entries from translation memory, "
"including entries with a different target text. This applies across "
"personal, project, and shared translation memory scopes. The current "
"translation is then stored again as an active entry in the scopes that are "
"enabled for that change."
msgstr ""
"ສຳລັບຂໍ້ຄວາມຕົ້ນສະບັບ, ອົງປະກອບ, ບໍລິບົດ, ແລະ ຄູ່ພາສາຕົ້ນສະບັບ/ປາຍທາງດຽວກັນ, Weblate "
"ຈະລຶບລາຍການທີ່ກົງກັນທີ່ບໍ່ແມ່ນໄຟລ໌ອອກຈາກໜ່ວຍຄວາມຈຳການແປ, "
"ລວມທັງລາຍການທີ່ມີຂໍ້ຄວາມປາຍທາງທີ່ແຕກຕ່າງກັນ. ສິ່ງນີ້ມີຜົນໃນທຸກຂອບເຂດໜ່ວຍຄວາມຈຳການແປທັງສ່ວນບຸກຄົນ, "
"ໂຄງການ, ແລະ ແບບແບ່ງປັນ. "
"ຄຳແປປັດຈຸບັນຈະຖືກຈັດເກັບໃໝ່ເປັນລາຍການໃຊ້ງານໃນຂອບເຂດທີ່ເປີດໃຊ້ສຳລັບການປ່ຽນແປງນັ້ນ."

msgid ""
"Entries imported from external translation memory files are not cleaned up "
"automatically. Entries with a different context are kept."
msgstr ""
"ລາຍການທີ່ນຳເຂົ້າຈາກໄຟລ໌ໜ່ວຍຄວາມຈຳການແປພາຍນອກຈະບໍ່ຖືກລຶບລ້າງອັດຕະໂນມັດ. "
"ລາຍການທີ່ມີບໍລິບົດແຕກຕ່າງກັນຈະຖືກເກັບໄວ້."

msgid ""
"In the Docker container this can be configured "
"using :envvar:`WEBLATE_DEFAULT_AUTOCLEAN_TM`."
msgstr ""
"ໃນ Docker container "
"ສິ່ງນີ້ສາມາດຕັ້ງຄ່າໄດ້ໂດຍໃຊ້ :envvar:`WEBLATE_DEFAULT_AUTOCLEAN_TM`."

msgid ""
"Enabling automatic cleanup also changes the default for new user profiles to "
"not contribute to personal translation memory. This prevents reintroducing "
"inconsistent translations that were supposed to be cleaned up."
msgstr ""
"ການເປີດໃຊ້ການລຶບລ້າງອັດຕະໂນມັດຍັງປ່ຽນຄ່າເລີ່ມຕົ້ນສຳລັບໂປຣໄຟລ໌ຜູ້ໃຊ້ໃໝ່ "
"ບໍ່ໃຫ້ປະກອບສ່ວນເຂົ້າໃນໜ່ວຍຄວາມຈຳການແປສ່ວນບຸກຄົນ. ສິ່ງນີ້ປ້ອງກັນບໍ່ໃຫ້ເກີດການນຳຄຳແປທີ່ບໍ່ສອດຄ້ອງກັນ "
"ເຊິ່ງຄວນຈະຖືກລຶບລ້າງແລ້ວ ກັບມາໃຊ້ໃໝ່."

msgid "Managing the Translation Memory"
msgstr "ການຈັດການໜ່ວຍຄວາມຈຳການແປ"

msgid "User interface"
msgstr "ອິນເຕີເຟສຜູ້ໃຊ້"

msgid ""
"Translation memory can be managed from several places in the Weblate UI:"
msgstr "ໜ່ວຍຄວາມຈຳການແປສາມາດຈັດການໄດ້ຈາກຫຼາຍບ່ອນໃນ Weblate UI:"

msgid ""
"Open the user menu and choose :guilabel:`Translation memory` to manage your "
"personal translation memory."
msgstr ""
"ເປີດເມນູຜູ້ໃຊ້ ແລະ ເລືອກ :guilabel:`Translation memory` "
"ເພື່ອຈັດການໜ່ວຍຄວາມຈຳການແປສ່ວນບຸກຄົນຂອງທ່ານ."

msgid ""
"Open a project and choose :guilabel:`Translation memory` from the project "
"menu to manage translation memory for that project."
msgstr ""
"ເປີດໂຄງການ ແລະ ເລືອກ :guilabel:`Translation memory` "
"ຈາກເມນູໂຄງການເພື່ອຈັດການໜ່ວຍຄວາມຈຳການແປສຳລັບໂຄງການນັ້ນ."

msgid ""
"Open a workspace and choose :guilabel:`Operations` ↓ :guilabel:`Translation "
"memory` to manage automatically created translation memory for that "
"workspace. Editing the workspace is required."
msgstr ""
"ເປີດ workspace ແລະ ເລືອກ :guilabel:`Operations` ↓ :guilabel:`Translation "
"memory` ເພື່ອຈັດການຄັງຄຳແປທີ່ຖືກສ້າງຂຶ້ນໂດຍອັດຕະໂນມັດສຳລັບ workspace ນັ້ນ. ຈຳເປັນຕ້ອງມີສິດແກ້ໄຂ "
"workspace."

msgid ""
"Open :guilabel:`Administration` and choose :guilabel:`Translation memory` to "
"manage uploaded translation memory for the whole Weblate instance."
msgstr ""
"ເປີດ :guilabel:`Administration` ແລະ ເລືອກ :guilabel:`Translation memory` "
"ເພື່ອຈັດການໜ່ວຍຄວາມຈຳການແປທີ່ອັບໂຫຼດໄວ້ສຳລັບທັງລະບົບ Weblate."

msgid ""
"The translation memory page shows entry counts for the selected scope. "
"Depending on the scope, it also lists entries by origin, component, or "
"language pair. The listed entries can be downloaded as JSON or TMX. Users "
"with the required permissions can delete entries, and the project view can "
"rebuild translation memory for the whole project or for individual "
"components from the current translations."
msgstr ""
"ໜ້າໜ່ວຍຄວາມຈຳການແປສະແດງຈຳນວນລາຍການສຳລັບຂອບເຂດທີ່ເລືອກ. ຂຶ້ນຢູ່ກັບຂອບເຂດ, "
"ມັນຍັງສະແດງລາຍການຕາມແຫຼ່ງທີ່ມາ, ອົງປະກອບ, ຫຼື ຄູ່ພາສາ. ລາຍການທີ່ສະແດງສາມາດດາວໂຫຼດເປັນ JSON "
"ຫຼື TMX. ຜູ້ໃຊ້ທີ່ມີສິດທິອະນຸຍາດທີ່ຕ້ອງການສາມາດລຶບລາຍການໄດ້, ແລະ "
"ມຸມມອງໂຄງການສາມາດສ້າງໜ່ວຍຄວາມຈຳການແປຄືນໃໝ່ສຳລັບທັງໂຄງການ ຫຼື "
"ສຳລັບແຕ່ລະອົງປະກອບຈາກຄຳແປປັດຈຸບັນ."

msgid ""
"Removing a component preserves its automatically created translation memory "
"by default. Because the component access rule no longer exists after "
"removal, the retained entries use the access rules of their remaining "
"translation-memory scope. To remove those entries together with a component, "
"select :guilabel:`Delete translation memory created from this component` in "
"the removal form. Category removal offers the equivalent option for every "
"component in the category and its nested categories. This removes attributed "
"entries and legacy entries matching the current component path. It does not "
"infer paths used before a component or category rename or move. Such "
"unmatched entries can be deleted by origin in the project or workspace "
"translation memory management, or using the REST API. The REST API accepts "
"the ``delete_memory`` boolean in the request body or query string for "
"component and category removal. Personal and uploaded entries are preserved."
msgstr ""

msgid ""
"The project view also shows whether shared translation memory and autoclean "
"translation memory are enabled for the project, with a link to the project "
"workflow settings when the user can edit the project."
msgstr ""
"ມຸມມອງໂຄງການຍັງສະແດງໃຫ້ເຫັນວ່າໜ່ວຍຄວາມຈຳການແປແບບແບ່ງປັນ ແລະ "
"ການລຶບລ້າງໜ່ວຍຄວາມຈຳການແປອັດຕະໂນມັດຖືກເປີດໃຊ້ສຳລັບໂຄງການຫຼືບໍ່, "
"ພ້ອມດ້ວຍລິ້ງໄປຍັງການຕັ້ງຄ່າຂັ້ນຕອນການເຮັດວຽກຂອງໂຄງການ ເມື່ອຜູ້ໃຊ້ສາມາດແກ້ໄຂໂຄງການນັ້ນໄດ້."

msgid ""
"The workspace view can rebuild all currently contributing projects or an "
"individual contributing component. It manages workspace-scoped automatic "
"entries only. Translation-memory files cannot be uploaded into a workspace "
"scope."
msgstr ""
"ສ່ວນສະແດງຜົນພື້ນທີ່ເຮັດວຽກສາມາດສ້າງໂຄງການທັງໝົດທີ່ກຳລັງມີສ່ວນຮ່ວມຄືນໃໝ່ ຫຼື ສ້າງສະເພາະສ່ວນປະກອບ "
"ທີ່ມີສ່ວນຮ່ວມນັ້ນໆ. ມັນຈັດການສະເພາະຂໍ້ມູນອັດຕະໂນມັດໃນຂອບເຂດຂອງພື້ນທີ່ເຮັດວຽກເທົ່ານັ້ນ. "
"ບໍ່ສາມາດອັບໂຫຼດໄຟລ໌ໜ່ວຍຄວາມຈຳການແປ (translation-memory) ເຂົ້າໄປໃນຂອບເຂດພື້ນທີ່ເຮັດວຽກໄດ້."

msgid ""
"Translation memory files can be imported on the same page. Uploaded files "
"are processed during the request, stored as active, and added to the "
"selected scope:"
msgstr ""
"ໄຟລ໌ຄັງຄຳແປສາມາດນຳເຂົ້າໄດ້ໃນໜ້າດຽວກັນ. ໄຟລ໌ທີ່ອັບໂຫລດຈະຖືກປະມວນຜົນໃນລະຫວ່າງການຮ້ອງຂໍ, "
"ຖືກເກັບເປັນແບບກຳລັງໃຊ້ງານ, ແລະ ເພີ່ມເຂົ້າໃນຂອບເຂດທີ່ເລືອກ:"

msgid "Personal uploads are available in your personal translation memory."
msgstr "ການອັບໂຫຼດສ່ວນບຸກຄົນຈະມີຢູ່ໃນໜ່ວຍຄວາມຈຳການແປສ່ວນບຸກຄົນຂອງທ່ານ."

msgid ""
"Project uploads are available in the selected project's translation memory."
msgstr "ການອັບໂຫຼດຂອງໂຄງການຈະມີຢູ່ໃນໜ່ວຍຄວາມຈຳການແປຂອງໂຄງການທີ່ເລືອກ."

msgid ""
"Administration uploads are available as uploaded shared entries for the "
"whole Weblate instance."
msgstr "ການອັບໂຫຼດຂອງຜູ້ເບິ່ງແຍງລະບົບຈະມີຢູ່ໃນຖານະລາຍການແບ່ງປັນທີ່ອັບໂຫຼດໄວ້ສຳລັບທັງລະບົບ Weblate."

msgid ""
"Translation memories in various formats can be imported into Weblate. The "
"TMX format is provided for interoperability with other tools. All supported "
"formats are TMX, JSON, XLIFF, PO, and CSV."
msgstr ""
"ໜ່ວຍຄວາມຈຳການແປໃນຮູບແບບຕ່າງໆສາມາດນຳເຂົ້າໃນ Weblate. ຮູບແບບ TMX "
"ຖືກຈັດຫາໄວ້ເພື່ອການເຮັດວຽກຮ່ວມກັນກັບເຄື່ອງມືອື່ນ. ຮູບແບບທີ່ຮອງຮັບທັງໝົດແມ່ນ TMX, JSON, XLIFF, PO, "
"ແລະ CSV."

msgid ""
"Source and target languages must be selected when uploading XLIFF, PO, or "
"CSV files if the language information is not provided by the file itself."
msgstr ""
"ພາສາຕົ້ນສະບັບ ແລະ ປາຍທາງຕ້ອງຖືກເລືອກເມື່ອອັບໂຫຼດໄຟລ໌ XLIFF, PO, ຫຼື CSV "
"ຖ້າຫາກຂໍ້ມູນພາສາບໍ່ໄດ້ຖືກສະໜອງໂດຍໄຟລ໌ນັ້ນໆ."

msgid ""
"You can search translation memory while editing strings from "
"the :ref:`machine-translation` tab."
msgstr ""
"ທ່ານສາມາດຄົ້ນຫາໜ່ວຍຄວາມຈຳການແປໃນຂະນະທີ່ແກ້ໄຂຂໍ້ຄວາມຈາກແຖບ :ref:`machine-translation`."

msgid "Admin interface"
msgstr "ອິນເຕີເຟສຜູ້ເບິ່ງແຍງລະບົບ"

msgid ""
"Administrative users have additional translation memory management controls. "
"In :guilabel:`Administration` > :guilabel:`Translation memory`, the page "
"lists uploaded shared entries, shared entries, and total entries for the "
"Weblate instance. Depending on permissions, it can import uploaded shared "
"memory, delete uploaded entries, and download uploaded, shared, or all "
"entries as JSON or TMX."
msgstr ""
"ຜູ້ໃຊ້ລະດັບຜູ້ເບິ່ງແຍງລະບົບຈະມີການຄວບຄຸມການຈັດການໜ່ວຍຄວາມຈຳການແປເພີ່ມເຕີມ. "
"ໃນ :guilabel:`Administration` > :guilabel:`Translation memory`, "
"ໜ້ານີ້ຈະສະແດງລາຍການແບ່ງປັນທີ່ອັບໂຫຼດໄວ້, ລາຍການແບ່ງປັນ, ແລະ ລາຍການທັງໝົດສຳລັບລະບົບ Weblate. "
"ຂຶ້ນຢູ່ກັບສິດທິອະນຸຍາດ, ມັນສາມາດນຳເຂົ້າໜ່ວຍຄວາມຈຳການແປທີ່ແບ່ງປັນທີ່ອັບໂຫຼດໄວ້, ລຶບລາຍການທີ່ອັບໂຫຼດໄວ້, "
"ແລະ ດາວໂຫຼດລາຍການທີ່ອັບໂຫຼດໄວ້, ລາຍການແບ່ງປັນ, ຫຼື ທຸກລາຍການເປັນ JSON ຫຼື TMX."

msgid ""
"The project translation memory view also allows rebuilding parts of or the "
"entire project translation memory. Automatically generated entries for the "
"selected component or project are deleted, and the memory is populated again "
"from the current translations in the background. Entries imported from files "
"are preserved."
msgstr ""
"ມຸມມອງຄັງຄຳແປຂອງໂຄງການຍັງອະນຸຍາດໃຫ້ສ້າງຄັງຄຳແປບາງສ່ວນ ຫຼື ທັງໝົດຄືນໃໝ່. "
"ຂໍ້ມູນທີ່ສ້າງຂຶ້ນໂດຍອັດຕະໂນມັດສຳລັບສ່ວນປະກອບ ຫຼື ໂຄງການທີ່ເລືອກຈະຖືກລຶບອອກ, ແລະ "
"ຄັງຄຳແປຈະຖືກຕື່ມຂໍ້ມູນໃໝ່ຈາກຄຳແປປັດຈຸບັນໃນພື້ນຫຼັງ. ສ່ວນຂໍ້ມູນທີ່ນຳເຂົ້າຈາກໄຟລ໌ຈະຖືກຮັກສາໄວ້."

msgid ""
"Several management commands can manipulate translation memory content. These "
"operate on the translation memory as a whole, unfiltered by scopes (unless "
"requested by parameters):"
msgstr ""
"ຄຳສັ່ງຈັດການຫຼາຍຢ່າງສາມາດຈັດການກັບເນື້ອຫາໜ່ວຍຄວາມຈຳການແປໄດ້. "
"ພວກມັນຈະດຳເນີນການກັບໜ່ວຍຄວາມຈຳການແປທັງໝົດ, ໂດຍບໍ່ມີການກັ່ນກອງຕາມຂອບເຂດ "
"(ນອກຈາກຈະຮ້ອງຂໍໂດຍພາຣາມິເຕີ):"

msgid "Exports the memory into JSON"
msgstr "ສົ່ງອອກໜ່ວຍຄວາມຈຳເປັນ JSON"

msgid "Imports TMX or JSON files into the translation memory"
msgstr "ນຳເຂົ້າໄຟລ໌ TMX ຫຼື JSON ເຂົ້າໃນໜ່ວຍຄວາມຈຳການແປ"

msgid "Removes all entries with pending status from the translation memory"
msgstr "ລຶບລາຍການທັງໝົດທີ່ມີສະຖານະຄ້າງຄາອອກຈາກໜ່ວຍຄວາມຈຳການແປ"

msgid ""
"The Weblate API covers the translation memory. This allows automated "
"manipulation for different purposes, or based on events in the translation "
"cycle."
msgstr ""
"Weblate API ຄອບຄຸມເຖິງໜ່ວຍຄວາມຈຳການແປ. "
"ນີ້ອະນຸຍາດໃຫ້ມີການຈັດການໂດຍອັດຕະໂນມັດສຳລັບຈຸດປະສົງທີ່ແຕກຕ່າງກັນ, ຫຼື "
"ໂດຍອີງໃສ່ເຫດການໃນຮອບວຽນການແປ."

msgid "Optional Weblate modules"
msgstr "ໂມດູນ Weblate ເພີ່ມເຕີມ"

msgid "Several optional modules are available for your setup."
msgstr "ມີຫຼາຍໂມດູນເພີ່ມເຕີມສຳລັບການຕິດຕັ້ງຂອງທ່ານ."

msgid "Git exporter"
msgstr "Git exporter"

msgid ""
"Provides you read-only access to the underlying Git repository using HTTP(S)."
msgstr "ສະໜອງການເຂົ້າເຖິງແບບອ່ານຢ່າງດຽວໄປຍັງ Git repository ເບື້ອງຫຼັງໂດຍໃຊ້ HTTP(S)."

msgid "Add ``weblate.gitexport`` to installed apps in :file:`settings.py`:"
msgstr "ເພີ່ມ ``weblate.gitexport`` ໄປຍັງ installed apps ໃນ :file:`settings.py`:"

msgid ""
"Export existing repositories by migrating your database after installation:"
msgstr "ສົ່ງອອກ repositories ທີ່ມີຢູ່ໂດຍການຍ້າຍຖານຂໍ້ມູນຂອງທ່ານຫຼັງຈາກການຕິດຕັ້ງ:"

msgid ""
"Git exporter is turned on in our official Docker image. To turn it off, use:"
msgstr "Git exporter ຖືກເປີດໃຊ້ໃນ Docker image ທາງການຂອງພວກເຮົາ. ເພື່ອປິດມັນ, ໃຊ້:"

msgid "Usage"
msgstr "ການນຳໃຊ້"

msgid ""
"The module automatically hooks into Weblate and sets the exported repository "
"URL in the :ref:`component`. The repositories are accessible under the ``/"
"git/`` part of the Weblate URL, for example ``https://example.org/git/"
"weblate/main/``."
msgstr ""
"ໂມດູນນີ້ຈະເຊື່ອມຕໍ່ເຂົ້າກັບ Weblate ໂດຍອັດຕະໂນມັດ ແລະ ຕັ້ງຄ່າ URL repository "
"ທີ່ສົ່ງອອກໃນ :ref:`component`. repositories ສາມາດເຂົ້າເຖິງໄດ້ພາຍໃຕ້ສ່ວນ ``/git/`` ຂອງ "
"Weblate URL, ຕົວຢ່າງ ``https://example.org/git/weblate/main/``."

msgid ""
"Repositories for publicly available projects can be cloned without "
"authentication:"
msgstr "Repositories ສຳລັບໂຄງການສາທາລະນະສາມາດຖືກ clone ໂດຍບໍ່ຕ້ອງມີການຢັ້ງຢືນຕົວຕົນ:"

msgid ""
"Access to browse the repositories with restricted access (with "
"`Private` :ref:`access control <acl>` or when :setting:`REQUIRE_LOGIN` is "
"enabled) requires an API token which can be obtained in your :ref:`user "
"profile <user-profile>`:"
msgstr ""
"ການເຂົ້າເຖິງເພື່ອເບິ່ງ repositories ທີ່ມີການເຂົ້າເຖິງແບບຈຳກັດ (ດ້ວຍ `Private` :ref:`access "
"control <acl>` ຫຼື ເມື່ອເປີດໃຊ້ :setting:`REQUIRE_LOGIN`) ຕ້ອງໃຊ້ API token "
"ເຊິ່ງສາມາດໄດ້ຮັບໃນ :ref:`user profile <user-profile>` ຂອງທ່ານ:"

msgid ""
"By default members of :guilabel:`Users` group and anonymous user have access "
"to the repositories for public projects via :guilabel:`Access repository` "
"and :guilabel:`Power user` roles."
msgstr ""
"ໂດຍເລີ່ມຕົ້ນ, ສະມາຊິກຂອງກຸ່ມ :guilabel:`Users` ແລະ ຜູ້ໃຊ້ທີ່ບໍ່ລະບຸຕົວຕົນ ມີການເຂົ້າເຖິງ "
"repositories ສຳລັບໂຄງການສາທາລະນະຜ່ານບົດບາດ :guilabel:`Access repository` "
"ແລະ :guilabel:`Power user`."

msgid "Billing"
msgstr "ການຮຽກເກັບເງິນ"

msgid ""
"This is used on `Hosted Weblate <https://weblate.org/hosting/>`_ to define "
"billing plans, track invoices and usage limits."
msgstr ""
"ສິ່ງນີ້ຖືກໃຊ້ໃນ `Hosted Weblate <https://weblate.org/hosting/>`_ "
"ເພື່ອກຳນົດແຜນການເກັບເງິນ, ຕິດຕາມໃບແຈ້ງໜີ້ ແລະ ຂີດຈຳກັດການນຳໃຊ້."

msgid "1. Add ``weblate.billing`` to installed apps in :file:`settings.py`:"
msgstr "1. ເພີ່ມ ``weblate.billing`` ໄປຍັງ installed apps ໃນ :file:`settings.py`:"

msgid ""
"Run the database migration to optionally install additional database "
"structures for the module:"
msgstr ""
"ດຳເນີນການຍ້າຍຖານຂໍ້ມູນ (migration) ເພື່ອຕິດຕັ້ງໂຄງສ້າງຖານຂໍ້ມູນເພີ່ມເຕີມສຳລັບໂມດູນ (ຖ້າຕ້ອງການ):"

msgid "Billing plan creation and assignment"
msgstr "ການສ້າງ ແລະ ມອບໝາຍແຜນການເກັບເງິນ"

msgid ""
"You first need to create a billing plan to activate billing. Navigate to the "
"`Administration` section (represented by the wrench icon) and open the "
"`Tools` screen. From there, proceed to the `Django admin interface`."
msgstr ""
"ທຳອິດທ່ານຕ້ອງສ້າງແຜນການເກັບເງິນເພື່ອເປີດໃຊ້ງານການເກັບເງິນ. ໄປທີ່ພາກ `Administration` "
"(ສະແດງດ້ວຍໄອຄອນປະແຈ) ແລະ ເປີດໜ້າຈໍ `Tools`. ຈາກນັ້ນ, ໄປທີ່ `Django admin interface`."

msgid ""
"In the Django admin interface, locate the `BILLING` section and add a "
"billing plan. For instance, you can add a `Free` plan with no cost."
msgstr ""
"ໃນ Django admin interface, ຊອກຫາພາກ `BILLING` ແລະ ເພີ່ມແຜນການເກັບເງິນ. ຕົວຢ່າງ, "
"ທ່ານສາມາດເພີ່ມແຜນ `Free` ໂດຍບໍ່ມີຄ່າໃຊ້ຈ່າຍ."

msgid ""
"If you wish to assign a billing plan to an existing project, this can also "
"be done within the `Django admin interface` using the `Customer billings` "
"option."
msgstr ""
"ຖ້າທ່ານຕ້ອງການມອບໝາຍແຜນການເກັບເງິນໃຫ້ກັບໂຄງການທີ່ມີຢູ່, ສິ່ງນີ້ສາມາດເຮັດໄດ້ພາຍໃນ `Django admin "
"interface` ໂດຍໃຊ້ຕົວເລືອກ `Customer billings`."

msgid ""
"Lastly, the `Django admin interface` provides an `Invoice` option for "
"logging your customer payments."
msgstr ""
"ສຸດທ້າຍ, `Django admin interface` ມີຕົວເລືອກ `Invoice` "
"ສຳລັບການບັນທຶກການຊຳລະເງິນຂອງລູກຄ້າ."

msgid ""
"After installation you can control billing in the admin interface. Users "
"with billing enabled will get new :guilabel:`Billing` tab in "
"their :ref:`user-profile`."
msgstr ""
"ຫຼັງຈາກການຕິດຕັ້ງ, ທ່ານສາມາດຄວບຄຸມການເກັບເງິນໄດ້ໃນ admin interface. "
"ຜູ້ໃຊ້ທີ່ເປີດໃຊ້ການເກັບເງິນຈະໄດ້ຮັບແຖບ :guilabel:`Billing` ໃໝ່ໃນ :ref:`user-profile` "
"ຂອງເຂົາເຈົ້າ."

msgid ""
"The billing module additionally allows users to create new projects and "
"components without being superusers (see :ref:`adding-projects`). This is "
"possible when following conditions are met:"
msgstr ""
"ໂມດູນການເກັບເງິນຍັງອະນຸຍາດໃຫ້ຜູ້ໃຊ້ສ້າງໂຄງການ ແລະ ອົງປະກອບໃໝ່ໄດ້ໂດຍບໍ່ຕ້ອງເປັນ superuser "
"(ເບິ່ງ :ref:`adding-projects`). ສິ່ງນີ້ເປັນໄປໄດ້ເມື່ອເງື່ອນໄຂຕໍ່ໄປນີ້ຖືກຕອບສະໜອງ:"

msgid ""
"The billing is in its configured limits (any overusage results in blocking "
"of project/component creation) and paid (if its price is non zero)"
msgstr ""
"ການເກັບເງິນຢູ່ໃນຂີດຈຳກັດທີ່ຕັ້ງໄວ້ (ການໃຊ້ເກີນຈະສົ່ງຜົນໃຫ້ຖືກບລັອກການສ້າງໂຄງການ/ອົງປະກອບ) ແລະ "
"ໄດ້ຮັບການຊຳລະແລ້ວ (ຖ້າລາຄາບໍ່ແມ່ນສູນ)"

msgid ""
"The user has :guilabel:`Add projects to workspace` permission for the "
"workspace covered by the billing plan."
msgstr ""
"ຜູ້ໃຊ້ມີສິດທິອະນຸຍາດ :guilabel:`Add projects to workspace` "
"ສຳລັບພື້ນທີ່ເຮັດວຽກທີ່ກວມເອົາໂດຍແຜນການເກັບເງິນ."

msgid ""
"Upon project creation user is able to choose which workspace should contain "
"the project. Projects created in a workspace with billing count against the "
"billing plan assigned to that workspace. Users with the :guilabel:`Edit "
"workspace settings` permission can view and pay the billing plan; billing "
"notification e-mails are sent to these users. See :ref:`workspace-billing` "
"for details."
msgstr ""
"ເມື່ອສ້າງໂຄງການ, ຜູ້ໃຊ້ສາມາດເລືອກໄດ້ວ່າພື້ນທີ່ເຮັດວຽກໃດຄວນບັນຈຸໂຄງການນັ້ນ. "
"ໂຄງການທີ່ສ້າງໃນພື້ນທີ່ເຮັດວຽກທີ່ມີການເກັບເງິນຈະຖືກນັບລວມໃນແຜນການເກັບເງິນທີ່ມອບໝາຍໃຫ້ພື້ນທີ່ເຮັດວຽກນັ້ນ. "
"ຜູ້ໃຊ້ທີ່ມີສິດທິອະນຸຍາດ :guilabel:`Edit workspace settings` ສາມາດເບິ່ງ ແລະ "
"ຊຳລະແຜນການເກັບເງິນໄດ້; ອີເມວແຈ້ງເຕືອນການເກັບເງິນຈະຖືກສົ່ງຫາຜູ້ໃຊ້ເຫຼົ່ານີ້. ເບິ່ງ :ref:`workspace-"
"billing` ສຳລັບລາຍລະອຽດ."

msgid "Legal module"
msgstr "ໂມດູນທາງກົດໝາຍ"

msgid ""
"This is used on `Hosted Weblate <https://weblate.org/hosting/>`_ to provide "
"required legal documents. It comes provided with blank documents, and you "
"are expected to fill out the following templates in the documents:"
msgstr ""
"ສິ່ງນີ້ຖືກໃຊ້ໃນ `Hosted Weblate <https://weblate.org/hosting/>`_ "
"ເພື່ອສະໜອງເອກະສານທາງກົດໝາຍທີ່ຈຳເປັນ. ມັນມາພ້ອມກັບເອກະສານເປົ່າ, ແລະ "
"ທ່ານຕ້ອງຕື່ມຂໍ້ມູນໃນແມ່ແບບຕໍ່ໄປນີ້ໃນເອກະສານ:"

msgid "Terms of service document"
msgstr "ເອກະສານເງື່ອນໄຂການໃຫ້ບໍລິການ"

msgid "Privacy policy document"
msgstr "ເອກະສານນະໂຍບາຍຄວາມເປັນສ່ວນຕົວ"

msgid "Short overview of the terms of service and privacy policy"
msgstr "ພາບລວມສັ້ນໆຂອງເງື່ອນໄຂການໃຫ້ບໍລິການ ແລະ ນະໂຍບາຍຄວາມເປັນສ່ວນຕົວ"

msgid "Subcontractor information"
msgstr "ຂໍ້ມູນຜູ້ຮັບເໝົາຊ່ວງ"

msgid ""
"The legal module embeds these templates inside Weblate. Its confirmation "
"page uses :file:`legal/documents/tos.html` and, when a privacy policy link "
"is available, requires one agreement covering both the terms of service and "
"the privacy policy. This is separate from :setting:`LEGAL_URL` "
"and :setting:`PRIVACY_URL`, which are meant for linking to externally hosted "
"legal documents from the footer when the legal module is not enabled or as "
"fallbacks for hidden internal pages. When the legal module is enabled, "
"Weblate links to the internal legal pages by default."
msgstr ""
"ໂມດູນທາງກົດໝາຍຈະຝັງເທັມເພລດເຫຼົ່ານີ້ໄວ້ພາຍໃນ Weblate. ໜ້າຢືນຢັນຈະໃຊ້ :file:`legal/"
"documents/tos.html` ແລະ ເມື່ອມີລິ້ງນະໂຍບາຍຄວາມເປັນສ່ວນຕົວ, "
"ຈະຕ້ອງມີການຍອມຮັບຂໍ້ຕົກລົງດຽວທີ່ກວມເອົາທັງຂໍ້ກຳນົດການບໍລິການ ແລະ ນະໂຍບາຍຄວາມເປັນສ່ວນຕົວ. "
"ນີ້ແມ່ນແຍກຕ່າງຫາກຈາກ :setting:`LEGAL_URL` ແລະ :setting:`PRIVACY_URL`, "
"ເຊິ່ງມີໄວ້ສຳລັບການລິ້ງໄປຫາເອກະສານທາງກົດໝາຍທີ່ຝາກໄວ້ພາຍນອກຈາກສ່ວນທ້າຍຂອງເວັບ (footer) "
"ເມື່ອບໍ່ໄດ້ເປີດໃຊ້ໂມດູນທາງກົດໝາຍ ຫຼື ເປັນທາງເລືອກສຳຮອງສຳລັບໜ້າພາຍໃນທີ່ຖືກເຊື່ອງໄວ້. "
"ເມື່ອເປີດໃຊ້ໂມດູນທາງກົດໝາຍ, ໂດຍເລີ່ມຕົ້ນແລ້ວ Weblate ຈະລິ້ງໄປຫາໜ້າທາງກົດໝາຍພາຍໃນ."

msgid ""
"On changing the terms of service or privacy policy, "
"adjust :setting:`LEGAL_TOS_DATE` when users should be forced to agree with "
"the updated documents."
msgstr ""
"ເມື່ອມີການປ່ຽນແປງຂໍ້ກຳນົດການບໍລິການ ຫຼື ນະໂຍບາຍຄວາມເປັນສ່ວນຕົວ, "
"ໃຫ້ປັບປ່ຽນ :setting:`LEGAL_TOS_DATE` ເມື່ອຕ້ອງການບັງຄັບໃຫ້ຜູ້ໃຊ້ຍອມຮັບເອກະສານທີ່ອັບເດດໃໝ່."

msgid ""
"Legal documents for the Hosted Weblate service operated by Weblate s.r.o. "
"are available in this Git repository: <https://github.com/WeblateOrg/wllegal/"
"tree/main/wllegal/templates/legal/documents>."
msgstr ""
"ເອກະສານທາງກົດໝາຍສຳລັບບໍລິການ Hosted Weblate ທີ່ດຳເນີນງານໂດຍ Weblate s.r.o. ມີຢູ່ໃນ Git "
"repository ນີ້: <https://github.com/WeblateOrg/wllegal/tree/main/wllegal/"
"templates/legal/documents>."

msgid ""
"The bundled terms of service and related legal documents are specific to "
"services operated by Weblate s.r.o. They can serve as an implementation "
"example, but should not be used as a basis for legal documents of other "
"services."
msgstr ""
"ຂໍ້ກຳນົດການບໍລິການ ແລະ ເອກະສານທາງກົດໝາຍທີ່ຕິດມານຳແມ່ນສະເພາະສຳລັບບໍລິການທີ່ດຳເນີນການໂດຍ "
"Weblate s.r.o. ເທົ່ານັ້ນ. ພວກມັນສາມາດໃຊ້ເປັນຕົວຢ່າງໃນການນຳໄປໃຊ້, "
"ແຕ່ບໍ່ຄວນໃຊ້ເປັນພື້ນຖານສຳລັບເອກະສານທາງກົດໝາຍຂອງບໍລິການອື່ນໆ."

msgid "1. Add ``weblate.legal`` to installed apps in :file:`settings.py`:"
msgstr "1. ເພີ່ມ ``weblate.legal`` ໄປຍັງ installed apps ໃນ :file:`settings.py`:"

msgid ""
"Provide legal document templates matching your service, as described "
"in :ref:`legal-customization`."
msgstr ""
"ສະໜອງເທັມເພລດເອກະສານທາງກົດໝາຍທີ່ກົງກັບການບໍລິການຂອງທ່ານ, ຕາມທີ່ອະທິບາຍໄວ້ໃນ :ref:`legal-"
"customization`."

msgid ""
"In Docker deployments, enable the legal module "
"using :envvar:`WEBLATE_LEGAL_INTEGRATION` instead of "
"editing :file:`settings.py`. Use ``tos-confirm`` to enable the legal module "
"and legal document confirmation enforcement, or ``wllegal`` to additionally "
"load the hosted legal document templates used by services operated by "
"Weblate s.r.o. These templates are not intended for general use. To provide "
"your own templates in Docker, place them in :file:`/app/data/python/"
"customize/templates/legal/documents`, see :ref:`docker-static-override`."
msgstr ""
"ໃນການຕິດຕັ້ງຜ່ານ Docker, "
"ໃຫ້ເປີດໃຊ້ໂມດູນທາງກົດໝາຍໂດຍໃຊ້ :envvar:`WEBLATE_LEGAL_INTEGRATION` "
"ແທນການແກ້ໄຂໄຟລ໌ :file:`settings.py`. ໃຊ້ ``tos-confirm`` ເພື່ອເປີດໃຊ້ໂມດູນທາງກົດໝາຍ "
"ແລະ ການບັງຄັບຢືນຢັນເອກະສານ, ຫຼື ``wllegal`` "
"ເພື່ອໂຫລດເທັມເພລດເອກະສານທາງກົດໝາຍທີ່ໃຊ້ໂດຍບໍລິການຂອງ Weblate s.r.o. ເພີ່ມເຕີມ. "
"ເທັມເພລດເຫຼົ່ານີ້ບໍ່ໄດ້ມີໄວ້ສຳລັບການໃຊ້ງານທົ່ວໄປ. ເພື່ອໃຊ້ເທັມເພລດຂອງທ່ານເອງໃນ Docker, "
"ໃຫ້ວາງພວກມັນໄວ້ໃນ :file:`/app/data/python/customize/templates/legal/documents`, "
"ເບິ່ງທີ່ :ref:`docker-static-override`."

msgid ""
"Recreate the Docker container after changing environment variables, for "
"example using :program:`docker compose up -d`. Restarting an existing "
"container does not apply changed environment values."
msgstr ""
"ສ້າງ Docker container ໃໝ່ຫຼັງຈາກປ່ຽນແປງ environment variables, "
"ຕົວຢ່າງໂດຍໃຊ້ :program:`docker compose up -d`. ການຣີສະຕາດ container ທີ່ມີຢູ່ຈະບໍ່ນຳໃຊ້ຄ່າ "
"environment ທີ່ປ່ຽນແປງ."

msgid ""
"After installation and customization, the legal documents are shown in the "
"Weblate UI."
msgstr ""
"ຫຼັງຈາກການຕິດຕັ້ງ ແລະ ການປັບແຕ່ງແລ້ວ, ເອກະສານທາງກົດໝາຍຈະຖືກສະແດງຢູ່ໃນສ່ວນຕິດຕໍ່ຜູ້ໃຊ້ (UI) ຂອງ "
"Weblate."

msgid ""
"The legal document templates are regular Django templates. Text is "
"translated only when you use Django translation tags such as ``{% translate "
"%}`` or ``{% blocktranslate %}``; plain HTML text is shown as written."
msgstr ""
"ແມ່ແບບເອກະສານທາງກົດໝາຍແມ່ນ Django templates ປົກກະຕິ. ຂໍ້ຄວາມຈະຖືກແປກໍຕໍ່ເມື່ອທ່ານໃຊ້ Django "
"translation tags ເຊັ່ນ ``{% translate %}`` ຫຼື ``{% blocktranslate %}``; ຂໍ້ຄວາມ "
"HTML ປົກກະຕິຈະຖືກສະແດງຕາມທີ່ຂຽນໄວ້."

msgid ""
"Legal pages and the sign-in and registration overview provide ``terms_url`` "
"and ``privacy_url`` variables for linking to the terms of service and "
"privacy policy documents."
msgstr ""
"ໜ້າທາງກົດໝາຍ ແລະ ພາບລວມການລົງຊື່ເຂົ້າໃຊ້ ແລະ ການລົງທະບຽນ ຈະມີຕົວແປ ``terms_url`` ແລະ "
"``privacy_url`` ສຳລັບການລິ້ງໄປຍັງເອກະສານເງື່ອນໄຂການໃຫ້ບໍລິການ ແລະ ນະໂຍບາຍຄວາມເປັນສ່ວນຕົວ."

msgid "Customizing legal documents and styles"
msgstr "ການປັບແຕ່ງເອກະສານ ແລະ ຮູບແບບທາງກົດໝາຍ"

msgid ""
"Provide your own legal documents by overriding these templates in "
"a :ref:`custom-module`:"
msgstr ""
"ສະໜອງເອກະສານທາງກົດໝາຍຂອງທ່ານເອງໂດຍການຂ້າມເທັມເພລດເຫຼົ່ານີ້ໃນ :ref:`custom-module`:"

msgid ""
"Place the customization app before ``weblate.legal`` and any other app "
"providing legal template overrides in :setting:`django:INSTALLED_APPS` so "
"that Django selects its templates. Only templates you provide are "
"overridden; the remaining legal templates continue to use the defaults from "
"later apps."
msgstr ""
"ວາງແອັບປັບແຕ່ງ (customization app) ໄວ້ກ່ອນ ``weblate.legal`` ແລະ ແອັບອື່ນໆທີ່ "
"ມີການຂ້າມເທັມເພລດທາງກົດໝາຍໃນ :setting:`django:INSTALLED_APPS` ເພື່ອໃຫ້ Django "
"ເລືອກໃຊ້ເທັມເພລດເຫຼົ່ານັ້ນ. ສະເພາະເທັມເພລດທີ່ທ່ານສະໜອງໃຫ້ເທົ່ານັ້ນທີ່ຈະຖືກຂ້າມ; "
"ສ່ວນເທັມເພລດທາງກົດໝາຍທີ່ເຫຼືອຈະຍັງຄົງໃຊ້ຄ່າເລີ່ມຕົ້ນຈາກແອັບທີ່ຢູ່ຖັດໄປ."

msgid ""
"The :file:`legal/styles.html` template is included in the HTML head of every "
"legal page. Use it to load a stylesheet from your customization app:"
msgstr ""
"ເທັມເພລດ :file:`legal/styles.html` ຖືກລວມຢູ່ໃນສ່ວນຫົວ (head) ຂອງ HTML "
"ຂອງທຸກໆໜ້າທາງກົດໝາຍ. ໃຊ້ເພື່ອໂຫຼດໄຟລ໌ຮູບແບບ (stylesheet) ຈາກແອັບປັບແຕ່ງຂອງທ່ານ:"

msgid ""
"Run :samp:`weblate collectstatic --noinput` after adding or changing the "
"static file."
msgstr ""
"ຣັນຄຳສັ່ງ :samp:`weblate collectstatic --noinput` ຫຼັງຈາກທີ່ເພີ່ມ ຫຼື ປ່ຽນແປງໄຟລ໌ static."

msgid ""
"In Docker deployments, place document templates in :file:`/app/data/python/"
"customize/templates/legal/documents`, :file:`styles.html` in :file:`/app/"
"data/python/customize/templates/legal/styles.html`, and the stylesheet "
"in :file:`/app/data/python/customize/static/legal.css`. The stylesheet "
"template then uses ``{% static 'legal.css' %}``. Restart the container to "
"apply the changes, see :ref:`docker-static-override`."
msgstr ""
"ໃນການຕິດຕັ້ງແບບ Docker, ໃຫ້ວາງເທັມເພລດເອກະສານໄວ້ໃນ :file:`/app/data/python/"
"customize/templates/legal/documents`, ໄຟລ໌ :file:`styles.html` ໄວ້ໃນ :file:`/"
"app/data/python/customize/templates/legal/styles.html`, ແລະ "
"ໄຟລ໌ຮູບແບບໄວ້ໃນ :file:`/app/data/python/customize/static/legal.css`. "
"ຈາກນັ້ນເທັມເພລດຮູບແບບ ຈະໃຊ້ຄຳສັ່ງ ``{% static 'legal.css' %}``. ໃຫ້ເລີ່ມຕົ້ນ container "
"ໃໝ່ເພື່ອໃຫ້ການປ່ຽນແປງມີຜົນ, ເບິ່ງທີ່ :ref:`docker-static-override`."

msgid ""
"By default, legal document wrappers use the ``tos`` CSS class. Weblate does "
"not attach any styling to this class; target it from your custom stylesheet, "
"or set :setting:`LEGAL_DOCUMENT_CSS_CLASS` to another class matching your "
"document markup. Set the setting to an empty string if no wrapper class is "
"needed."
msgstr ""
"ໂດຍເລີ່ມຕົ້ນແລ້ວ, wrapper ຂອງເອກະສານທາງກົດໝາຍຈະໃຊ້ CSS class ຊື່ວ່າ ``tos``. Weblate "
"ຈະບໍ່ໄດ້ກຳນົດຮູບແບບໃດໆໃຫ້ກັບ class ນີ້; ທ່ານສາມາດກຳນົດເປົ້າໝາຍໃສ່ class ນີ້ຈາກ "
"ໄຟລ໌ຮູບແບບຂອງທ່ານເອງ, ຫຼື ຕັ້ງຄ່າ :setting:`LEGAL_DOCUMENT_CSS_CLASS` ໃຫ້ເປັນ class ອື່ນ "
"ທີ່ກົງກັບ markup ຂອງເອກະສານທ່ານ. ໃຫ້ຕັ້ງຄ່ານີ້ເປັນຄ່າວ່າງ ຫາກບໍ່ຈຳເປັນຕ້ອງໃຊ້ wrapper class."

msgid ""
"Use :setting:`LEGAL_HIDDEN_DOCUMENTS` to hide optional legal pages such as "
"subcontractors from the legal menu. Hidden pages return a 404 response when "
"requested directly. If ``terms`` or ``privacy`` is hidden, links using "
"``terms_url`` or ``privacy_url`` fall back to :setting:`LEGAL_URL` "
"or :setting:`PRIVACY_URL` when configured, otherwise the link is omitted."
msgstr ""
"ໃຊ້ :setting:`LEGAL_HIDDEN_DOCUMENTS` ເພື່ອເຊື່ອງໜ້າທາງກົດໝາຍເພີ່ມເຕີມ ເຊັ່ນ ຜູ້ຮັບເໝົາຊ່ວງ "
"ອອກຈາກເມນູທາງກົດໝາຍ. ໜ້າທີ່ຖືກເຊື່ອງໄວ້ຈະສົ່ງກັບຄ່າຕອບໂຕ້ 404 ເມື່ອຖືກຮ້ອງຂໍໂດຍກົງ. ຖ້າ ``terms`` "
"ຫຼື ``privacy`` ຖືກເຊື່ອງໄວ້, ລິ້ງທີ່ໃຊ້ ``terms_url`` ຫຼື ``privacy_url`` "
"ຈະກັບໄປໃຊ້ :setting:`LEGAL_URL` ຫຼື :setting:`PRIVACY_URL` ເມື່ອຕັ້ງຄ່າໄວ້, "
"ຖ້າບໍ່ດັ່ງນັ້ນລິ້ງຈະຖືກລະເວັ້ນ."

msgid ""
"To use externally hosted legal documents with legal confirmation, "
"configure :setting:`LEGAL_HIDDEN_DOCUMENTS` to hide ``terms`` and "
"``privacy`` and set :setting:`LEGAL_URL` and :setting:`PRIVACY_URL`. The "
"confirmation page then links to those external documents and requires one "
"agreement covering both without needing a :file:`legal/documents/tos.html` "
"template override. If no privacy policy link is available, the confirmation "
"covers only the terms of service."
msgstr ""
"ເພື່ອໃຊ້ເອກະສານທາງກົດໝາຍທີ່ຝາກໄວ້ພາຍນອກຮ່ວມກັບການຢືນຢັນທາງກົດໝາຍ, "
"ໃຫ້ຕັ້ງຄ່າ :setting:`LEGAL_HIDDEN_DOCUMENTS` ເພື່ອເຊື່ອງ ``terms`` ແລະ ``privacy`` "
"ແລະ ຕັ້ງຄ່າ :setting:`LEGAL_URL` ແລະ :setting:`PRIVACY_URL`. ຈາກນັ້ນ "
"ໜ້າຢືນຢັນຈະລິ້ງໄປຫາເອກະສານພາຍນອກເຫຼົ່ານັ້ນ ແລະ ຕ້ອງການການຍອມຮັບດຽວທີ່ກວມເອົາທັງສອງ "
"ໂດຍບໍ່ຈຳເປັນຕ້ອງຂຽນທັບເທັມເພລດ :file:`legal/documents/tos.html`. "
"ຖ້າບໍ່ມີລິ້ງນະໂຍບາຍຄວາມເປັນສ່ວນຕົວ, ການຢືນຢັນຈະກວມເອົາພຽງແຕ່ຂໍ້ກຳນົດການບໍລິການເທົ່ານັ້ນ."

msgid "Avatars"
msgstr "ຮູບໂປຣໄຟລ໌"

msgid ""
"Avatars are downloaded and cached server-side to reduce information leaks to "
"the sites serving them by default. The built-in support for fetching avatars "
"from e-mails addresses configured for it can be turned off "
"using :setting:`ENABLE_AVATARS`."
msgstr ""
"ຮູບໂປຣໄຟລ໌ຈະຖືກດາວໂຫຼດ ແລະ ແຄຊ (cache) ໄວ້ທາງຝັ່ງເຊີບເວີ "
"ເພື່ອຫຼຸດຜ່ອນການຮົ່ວໄຫຼຂອງຂໍ້ມູນໄປຍັງເວັບໄຊທີ່ໃຫ້ບໍລິການຮູບເຫຼົ່ານັ້ນໂດຍເລີ່ມຕົ້ນ. "
"ການຮອງຮັບໃນຕົວສຳລັບການດຶງຮູບໂປຣໄຟລ໌ຈາກທີ່ຢູ່ອີເມວທີ່ຕັ້ງຄ່າໄວ້ "
"ສາມາດປິດໃຊ້ງານໄດ້ໂດຍໃຊ້ :setting:`ENABLE_AVATARS`."

msgid "Weblate currently supports:"
msgstr "ປັດຈຸບັນ Weblate ຮອງຮັບ:"

msgid "`Gravatar <https://gravatar.com/>`_"
msgstr "`Gravatar <https://gravatar.com/>`_"

msgid "`Libravatar <https://www.libravatar.org/>`_"
msgstr "`Libravatar <https://www.libravatar.org/>`_"

msgid ""
"The :ref:`addon-weblate.cdn.cdnjs` and :ref:`addon-weblate.cdn.files` add-"
"ons write files to :setting:`LOCALIZE_CDN_PATH`; Weblate does not serve "
"them. Configure the web server or CDN serving :setting:`LOCALIZE_CDN_URL` as "
"a public, read-only static file host."
msgstr ""
"ສ່ວນເສີມ (Add-ons) :ref:`addon-weblate.cdn.cdnjs` ແລະ :ref:`addon-"
"weblate.cdn.files` ຈະຂຽນໄຟລ໌ລົງໃນ :setting:`LOCALIZE_CDN_PATH`; ໂດຍທີ່ Weblate "
"ຈະບໍ່ໄດ້ເປັນຜູ້ໃຫ້ບໍລິການໄຟລ໌ເຫຼົ່ານັ້ນ. ໃຫ້ຕັ້ງຄ່າເວັບເຊີເວີ ຫຼື CDN "
"ທີ່ໃຫ້ບໍລິການ :setting:`LOCALIZE_CDN_URL` ເປັນໂຮສໄຟລ໌ static ແບບສາທາລະນະ ແລະ "
"ອ່ານໄດ້ຢ່າງດຽວ."

msgid ""
"Treat every published CDN file as public. The add-on specific UUID in the "
"URL is not an access-control mechanism. Do not enable CDN add-ons for "
"components that contain private strings, unreleased product text, customer "
"data, internal URLs, API examples, repository paths, translator comments, or "
"file-format metadata that should not be exposed."
msgstr ""
"ຖືວ່າທຸກໄຟລ໌ CDN ທີ່ເຜີຍແຜ່ເປັນສາທາລະນະ. UUID ສະເພາະຂອງ add-on ໃນ URL "
"ບໍ່ແມ່ນກົນໄກການຄວບຄຸມການເຂົ້າເຖິງ. ຢ່າເປີດໃຊ້ CDN add-ons ສຳລັບອົງປະກອບທີ່ມີຂໍ້ຄວາມສ່ວນຕົວ, "
"ຂໍ້ຄວາມຜະລິດຕະພັນທີ່ຍັງບໍ່ທັນປ່ອຍ, ຂໍ້ມູນລູກຄ້າ, URL ພາຍໃນ, API examples, repository paths, "
"ຄຳເຫັນຂອງນັກແປ, ຫຼື ເມຕາດາຕ້າຮູບແບບໄຟລ໌ທີ່ບໍ່ຄວນຖືກເປີດເຜີຍ."

msgid ""
"The :ref:`addon-weblate.cdn.files` add-on publishes raw translation files in "
"formats supported by Weblate. Some formats can be interpreted by browsers or "
"other clients as HTML, SVG, XML, JavaScript, YAML, or application-specific "
"configuration. Serve the CDN from a dedicated domain that is separate from "
"Weblate and from the application consuming the translations. Do not share "
"authentication cookies with the CDN domain."
msgstr ""
"ສ່ວນເສີມ :ref:`addon-weblate.cdn.files` ຈະເຜີຍແຜ່ໄຟລ໌ການແປແບບດິບໃນຮູບແບບທີ່ Weblate "
"ຮອງຮັບ. ບາງຮູບແບບອາດຖືກແປຄວາມໝາຍໂດຍບຣາວເຊີ ຫຼື ໄຄເອັນອື່ນໆໃຫ້ເປັນ HTML, SVG, XML, "
"JavaScript, YAML, ຫຼື ການຕັ້ງຄ່າສະເພາະຂອງແອັບພລິເຄຊັນ. ຄວນໃຫ້ບໍລິການ CDN "
"ຈາກໂດເມນສະເພາະທີ່ແຍກອອກຈາກ Weblate ແລະ ແຍກຈາກແອັບພລິເຄຊັນທີ່ໃຊ້ການແປນັ້ນ. "
"ຫ້າມແບ່ງປັນຄຸກກີ້ການຢືນຢັນຕົວຕົນກັບໂດເມນ CDN."

msgid "Recommended server configuration:"
msgstr "ການຕັ້ງຄ່າເຊີບເວີທີ່ແນະນຳ:"

msgid ""
"Serve only the directory configured by :setting:`LOCALIZE_CDN_PATH`; do not "
"expose Weblate repositories, backups, media, configuration, or the whole "
"data directory."
msgstr ""
"ໃຫ້ບໍລິການສະເພາະໄດເລກະທໍຣີທີ່ຕັ້ງຄ່າໂດຍ :setting:`LOCALIZE_CDN_PATH`; ຢ່າເປີດເຜີຍ Weblate "
"repositories, backups, media, configuration, ຫຼື ໄດເລກະທໍຣີຂໍ້ມູນທັງໝົດ."

msgid "Disable directory listing."
msgstr "ປິດການສະແດງລາຍການໄດເລກະທໍຣີ."

msgid "Use HTTPS and make the CDN host read-only from the web server."
msgstr "ໃຊ້ HTTPS ແລະ ເຮັດໃຫ້ CDN host ອ່ານໄດ້ຢ່າງດຽວຈາກເວັບເຊີບເວີ."

msgid "Send :http:header:`X-Content-Type-Options` with ``nosniff``."
msgstr "ສົ່ງ :http:header:`X-Content-Type-Options` ພ້ອມກັບ ``nosniff``."

msgid ""
"Configure conservative MIME types. Serve unknown translation formats "
"as :mimetype:`text/plain` or :mimetype:`application/octet-stream`; only "
"serve :file:`weblate.js` as JavaScript."
msgstr ""
"ຕັ້ງຄ່າ MIME types ແບບອະນຸລັກ. ໃຫ້ບໍລິການຮູບແບບການແປທີ່ບໍ່ຮູ້ຈັກເປັນ :mimetype:`text/plain` "
"ຫຼື :mimetype:`application/octet-stream`; ໃຫ້ບໍລິການພຽງ :file:`weblate.js` ເປັນ "
"JavaScript."

msgid ""
"For raw translation formats that are not intended to be rendered in a "
"browser, consider adding :http:header:`Content-Disposition` with "
"``attachment``."
msgstr ""
"ສຳລັບຮູບແບບການແປດິບທີ່ບໍ່ມີເຈດຕະນາໃຫ້ສະແດງຜົນໃນບຣາວເຊີ, "
"ພິຈາລະນາເພີ່ມ :http:header:`Content-Disposition` ພ້ອມກັບ ``attachment``."

msgid ""
"Configure ``Access-Control-Allow-Origin`` only for sites that need browser "
"access to the files."
msgstr ""
"ຕັ້ງຄ່າ ``Access-Control-Allow-Origin`` "
"ສະເພາະສຳລັບເວັບໄຊທີ່ຕ້ອງການການເຂົ້າເຖິງໄຟລ໌ຜ່ານບຣາວເຊີ."

msgid ""
"Set cache lifetimes that match your update expectations, and purge CDN "
"caches when stale translations must disappear quickly."
msgstr ""
"ຕັ້ງຄ່າອາຍຸການໃຊ້ງານຂອງ cache ໃຫ້ກົງກັບຄວາມຄາດຫວັງໃນການອັບເດດຂອງທ່ານ, ແລະ ລ້າງ CDN "
"caches ເມື່ອການແປທີ່ລ້າສະໄໝຕ້ອງຫາຍໄປຢ່າງໄວວາ."

msgid ""
"The following nginx snippet serves only the configured CDN directory and "
"applies conservative defaults for raw translation files:"
msgstr ""
"ສະນິບເປັດ nginx ຕໍ່ໄປນີ້ໃຫ້ບໍລິການສະເພາະໄດເລັກທໍຣີ CDN ທີ່ຕັ້ງຄ່າໄວ້ ແລະ "
"ນຳໃຊ້ຄ່າເລີ່ມຕົ້ນແບບອະນຸລັກສຳລັບໄຟລ໌ແປພາສາຕົ້ນສະບັບ:"

msgid "Signing Git commits with GnuPG"
msgstr "ການເຊັນ Git commits ດ້ວຍ GnuPG"

msgid "All commits can be signed by the GnuPG key of the Weblate instance."
msgstr "ການຄອມມິດທັງໝົດສາມາດລົງນາມດ້ວຍກຸນແຈ GnuPG ຂອງອິນສະແຕນ Weblate."

msgid ""
"Turn on :setting:`WEBLATE_GPG_IDENTITY`. (Weblate will generate a GnuPG key "
"when needed and will use it to sign all translation commits.)"
msgstr ""
"ເປີດໃຊ້ :setting:`WEBLATE_GPG_IDENTITY`. (Weblate ຈະສ້າງ GnuPG key ເມື່ອຈຳເປັນ ແລະ "
"ຈະໃຊ້ມັນເພື່ອເຊັນການຄອມມິດການແປທັງໝົດ.)"

msgid "This feature needs GnuPG 2.1 or newer installed."
msgstr "ຄຸນສົມບັດນີ້ຕ້ອງການ GnuPG 2.1 ຫຼື ໃໝ່ກວ່າທີ່ຕິດຕັ້ງໄວ້."

msgid ""
"You can find the key in the :setting:`DATA_DIR` and the public key is shown "
"on the \"About\" page:"
msgstr ""
"ທ່ານສາມາດພົບ key ໃນ :setting:`DATA_DIR` ແລະ public key ຈະສະແດງຢູ່ໃນໜ້າ \"About\":"

msgid ""
"Alternatively you can also import existing keys into Weblate, just set "
"``HOME=$DATA_DIR/home`` when invoking gpg."
msgstr ""
"ທາງເລືອກອື່ນ ທ່ານຍັງສາມາດນຳເຂົ້າ keys ທີ່ມີຢູ່ເຂົ້າໃນ Weblate, ພຽງແຕ່ຕັ້ງ ``HOME=$DATA_DIR/"
"home`` ເມື່ອເອີ້ນໃຊ້ gpg."

msgid ""
"The key material is cached by Weblate for a long period. In case you let "
"Weblate generate a key with :setting:`WEBLATE_GPG_IDENTITY` and then import "
"key with the same identity to use an existing key, purging redis cache is "
"recommended to see the effect of such change."
msgstr ""
"ຂໍ້ມູນຄີຈະຖືກເກັບໄວ້ໃນແຄຊ (cache) ຂອງ Weblate ເປັນເວລາດົນ. ໃນກໍລະນີທີ່ເຈົ້າໃຫ້ Weblate "
"ສ້າງຄີດ້ວຍ :setting:`WEBLATE_GPG_IDENTITY` ແລ້ວຈາກນັ້ນນຳເຂົ້າຄີທີ່ມີ identity "
"ດຽວກັນເພື່ອໃຊ້ຄີທີ່ມີຢູ່ແລ້ວ, ແນະນຳໃຫ້ລ້າງແຄຊ redis ເພື່ອໃຫ້ເຫັນຜົນຂອງການປ່ຽນແປງດັ່ງກ່າວ."

msgid ""
"When sharing :setting:`DATA_DIR` between multiple hosts, please follow "
"instructions at https://wiki.gnupg.org/NFS to make GnuPG signing work "
"reliably."
msgstr ""
"ເມື່ອແບ່ງປັນ :setting:`DATA_DIR` ລະຫວ່າງຫຼາຍ hosts, ກະລຸນາປະຕິບັດຕາມຄຳແນະນຳທີ່ https://"
"wiki.gnupg.org/NFS ເພື່ອເຮັດໃຫ້ການເຊັນ GnuPG ເຮັດວຽກໄດ້ຢ່າງໜ້າເຊື່ອຖື."

msgid "Rate limiting"
msgstr "ການຈຳກັດອັດຕາ"

msgid "The rate limiting no longer applies to signed in superusers."
msgstr "ການຈຳກັດອັດຕາບໍ່ມີຜົນອີກຕໍ່ໄປກັບ superusers ທີ່ລົງຊື່ເຂົ້າໃຊ້ແລ້ວ."

msgid ""
"Several operations in Weblate are rate limited. Rate limits are evaluated "
"independently for each scope. At most :setting:`RATELIMIT_ATTEMPTS` attempts "
"are allowed within :setting:`RATELIMIT_WINDOW` seconds in one scope. That "
"scope is then blocked for :setting:`RATELIMIT_LOCKOUT`; Weblate does not "
"turn this into a sitewide temporary IP ban. Exceeding one scope, such as "
"``TRANSLATE`` or ``SEARCH``, does not by itself block unrelated scopes such "
"as ``LOGIN`` or ``SECOND_FACTOR``. There are also settings specific to "
"scopes, for example ``RATELIMIT_CONTACT_ATTEMPTS`` or "
"``RATELIMIT_TRANSLATE_ATTEMPTS``. The table below is a full list of "
"available scopes."
msgstr ""
"ການດຳເນີນການຫຼາຍຢ່າງໃນ Weblate ມີການຈຳກັດອັດຕາ. "
"ການຈຳກັດອັດຕາຈະຖືກປະເມີນຢ່າງອິດສະຫຼະສຳລັບແຕ່ລະຂອບເຂດ. "
"ອະນຸຍາດໃຫ້ມີການພະຍາຍາມສູງສຸດ :setting:`RATELIMIT_ATTEMPTS` "
"ພາຍໃນ :setting:`RATELIMIT_WINDOW` ວິນາທີໃນໜຶ່ງຂອບເຂດ. "
"ຂອບເຂດນັ້ນຈະຖືກບລັອກເປັນເວລາ :setting:`RATELIMIT_LOCKOUT`; Weblate "
"ບໍ່ໄດ້ປ່ຽນສິ່ງນີ້ເປັນການບລັອກ IP ຊົ່ວຄາວທັງເວັບໄຊ. ການເກີນຂີດຈຳກັດໃນໜຶ່ງຂອບເຂດ, ເຊັ່ນ "
"``TRANSLATE`` ຫຼື ``SEARCH``, ຈະບໍ່ບລັອກຂອບເຂດທີ່ບໍ່ກ່ຽວຂ້ອງ ເຊັ່ນ ``LOGIN`` ຫຼື "
"``SECOND_FACTOR`` ດ້ວຍຕົນເອງ. ຍັງມີການຕັ້ງຄ່າສະເພາະສຳລັບຂອບເຂດ, ຕົວຢ່າງ "
"``RATELIMIT_CONTACT_ATTEMPTS`` ຫຼື ``RATELIMIT_TRANSLATE_ATTEMPTS``. "
"ຕາຕະລາງຂ້າງລຸ່ມນີ້ແມ່ນລາຍການເຕັມຂອງຂອບເຂດທີ່ມີຢູ່."

msgid "The following operations are subject to rate limiting:"
msgstr "ການດຳເນີນການຕໍ່ໄປນີ້ແມ່ນຢູ່ພາຍໃຕ້ການຈຳກັດອັດຕາ:"

msgid "Name"
msgstr "ຊື່"

msgid "Scope"
msgstr "ຂອບເຂດ"

msgid "Allowed attempts"
msgstr "ຈຳນວນຄັ້ງທີ່ອະນຸຍາດໃຫ້ພະຍາຍາມ"

msgid "Ratelimit window"
msgstr "ຊ່ວງເວລາການຈຳກັດອັດຕາ"

msgid "Lockout period"
msgstr "ໄລຍະເວລາການບລັອກ"

msgid "Registration"
msgstr "ການລົງທະບຽນ"

msgid "Sending message to admins"
msgstr "ການສົ່ງຂໍ້ຄວາມຫາຜູ້ເບິ່ງແຍງລະບົບ"

msgid "Password authentication on sign-in"
msgstr "ການຢັ້ງຢືນລະຫັດຜ່ານເມື່ອລົງຊື່ເຂົ້າໃຊ້"

msgid "Second-factor authentication"
msgstr "ການຢັ້ງຢືນຕົວຕົນຂັ້ນສອງ"

msgid "Sitewide search"
msgstr "ການຄົ້ນຫາທັງເວັບໄຊ"

msgid "Translating"
msgstr "ການແປ"

msgid "Adding to glossary"
msgstr "ການເພີ່ມເຂົ້າໃນຄຳສັບ"

msgid "Starting translation into a new language"
msgstr "ການເລີ່ມການແປເປັນພາສາໃໝ່"

msgid "Creating new project"
msgstr "ການສ້າງໂຄງການໃໝ່"

msgid "Connecting a GitHub account"
msgstr "ການເຊື່ອມຕໍ່ບັນຊີ GitHub"

msgid ""
"Within each scope, the rate limiting is based on sessions when user is "
"signed in and on IP address if not."
msgstr ""
"ພາຍໃນແຕ່ລະຂອບເຂດ, ການຈຳກັດອັດຕາຈະອີງໃສ່ເຊສຊັນ (sessions) ເມື່ອຜູ້ໃຊ້ລົງຊື່ເຂົ້າໃຊ້, ແລະ ໃສ່ IP "
"address ຖ້າບໍ່ໄດ້ລົງຊື່ເຂົ້າໃຊ້."

msgid ""
"For signed-in users, Weblate records the first rejected request during each "
"active scope lockout in the :ref:`audit-log`, including the scope and "
"request path. Repeated rejections during the same lockout do not create "
"additional audit-log entries."
msgstr ""
"ສຳລັບຜູ້ໃຊ້ທີ່ເຂົ້າສູ່ລະບົບແລ້ວ, Weblate ຈະບັນທຶກຄຳຮ້ອງຂໍທຳອິດທີ່ຖືກປະຕິເສດໃນລະຫວ່າງ "
"ການລັອກເອົາຂອບເຂດທີ່ກຳລັງເຮັດວຽກໄວ້ໃນ :ref:`audit-log`, ເຊິ່ງລວມມີຂອບເຂດ ແລະ "
"ເສັ້ນທາງຄຳຮ້ອງຂໍ. ການຖືກປະຕິເສດຊ້ຳໆໃນລະຫວ່າງການລັອກຄັ້ງດຽວກັນ ຈະບໍ່ມີການສ້າງບັນທຶກ audit-log "
"ເພີ່ມເຕີມ."

msgid ""
"If a user fails to sign in :setting:`AUTH_LOCK_ATTEMPTS` times, password "
"authentication will be turned off on the account until having gone through "
"the process of having its password reset."
msgstr ""
"ຖ້າຜູ້ໃຊ້ລົງຊື່ເຂົ້າໃຊ້ລົ້ມເຫຼວ :setting:`AUTH_LOCK_ATTEMPTS` ຄັ້ງ, "
"ການຢັ້ງຢືນດ້ວຍລະຫັດຜ່ານຈະຖືກປິດໃຊ້ງານໃນບັນຊີນັ້ນ ຈົນກວ່າຈະຜ່ານຂະບວນການຣີເຊັດລະຫັດຜ່ານ."

msgid ""
"The settings can be also applied in the Docker container by adding "
"``WEBLATE_`` prefix to the setting name, for "
"example :setting:`RATELIMIT_ATTEMPTS` "
"becomes :envvar:`WEBLATE_RATELIMIT_ATTEMPTS`."
msgstr ""
"ການຕັ້ງຄ່າສາມາດຖືກນຳໃຊ້ໃນ Docker container ໂດຍການເພີ່ມ prefix ``WEBLATE_`` "
"ໃສ່ຊື່ການຕັ້ງຄ່າ, ຕົວຢ່າງ :setting:`RATELIMIT_ATTEMPTS` "
"ຈະກາຍເປັນ :envvar:`WEBLATE_RATELIMIT_ATTEMPTS`."

msgid "The API has separate rate limiting settings, see :ref:`api-rate`."
msgstr "API ມີການຕັ້ງຄ່າການຈຳກັດອັດຕາແຍກຕ່າງຫາກ, ເບິ່ງ :ref:`api-rate`."

msgid "Translation projects"
msgstr "ໂຄງການການແປ"

msgid "Translation organization"
msgstr "ການຈັດຕັ້ງການແປ"

msgid ""
"Weblate organizes translatable VCS content of project/components into a tree-"
"like structure. You can additionally organize components within a project "
"using categories."
msgstr ""
"Weblate ຈັດລະບຽບເນື້ອຫາ VCS ທີ່ສາມາດແປໄດ້ຂອງໂຄງການ/ອົງປະກອບໃຫ້ເປັນໂຄງສ້າງຄ້າຍຕົ້ນໄມ້. "
"ທ່ານຍັງສາມາດຈັດລະບຽບອົງປະກອບພາຍໃນໂຄງການເພີ່ມເຕີມໂດຍໃຊ້ categories."

msgid ""
"The bottom level object is :ref:`project`, which should hold all "
"translations belonging together (for example translation of an application "
"in several versions and/or accompanying documentation)."
msgstr ""
"ວັດຖຸລະດັບລຸ່ມສຸດແມ່ນ :ref:`project`, ເຊິ່ງຄວນບັນຈຸການແປທັງໝົດທີ່ກ່ຽວຂ້ອງກັນ (ຕົວຢ່າງ "
"ການແປຂອງແອັບພລິເຄຊັນໃນຫຼາຍເວີຊັນ ແລະ/ຫຼື ເອກະສານທີ່ກ່ຽວຂ້ອງ)."

msgid ""
"The middle level is optionally created by :ref:`category`. The categories "
"can be nested to achieve more complex structure."
msgstr ""
"ລະດັບກາງຈະຖືກສ້າງຂຶ້ນທາງເລືອກໂດຍ :ref:`category`. Categories "
"ສາມາດຖືກຊ້ອນກັນເພື່ອໃຫ້ໄດ້ໂຄງສ້າງທີ່ຊັບຊ້ອນຂຶ້ນ."

msgid ""
"On the level above, :ref:`component`, which is actually the component to "
"translate, you define the VCS repository to use, and the mask of files to "
"translate."
msgstr ""
"ໃນລະດັບສູງກວ່າ, :ref:`component` ເຊິ່ງເປັນອົງປະກອບທີ່ແປຕົວຈິງ, ທ່ານຈະກຳນົດ VCS repository "
"ທີ່ຈະໃຊ້, ແລະ mask ຂອງໄຟລ໌ທີ່ຈະແປ."

msgid ""
"Above :ref:`component` there are individual translations, handled "
"automatically by Weblate as translation files (which match :ref:`component-"
"filemask` defined in :ref:`component`) appear in the VCS repository."
msgstr ""
"ເໜືອ :ref:`component` ຈະມີການແປແຕ່ລະລາຍການ, ເຊິ່ງຈັດການໂດຍອັດຕະໂນມັດໂດຍ Weblate "
"ເມື່ອໄຟລ໌ການແປ (ເຊິ່ງກົງກັບ :ref:`component-filemask` ທີ່ກຳນົດໃນ :ref:`component`) "
"ປາກົດຂຶ້ນໃນ VCS repository."

msgid ""
"Weblate supports a wide range of translation formats (both bilingual and "
"monolingual ones) supported by Translate Toolkit, see :ref:`formats`."
msgstr ""
"Weblate ຮອງຮັບຮູບແບບການແປທີ່ຫຼາກຫຼາຍ (ທັງສອງພາສາ ແລະ ພາສາດຽວ) ເຊິ່ງຮອງຮັບໂດຍ Translate "
"Toolkit, ເບິ່ງ :ref:`formats`."

msgid ""
"You can share cloned VCS repositories using :ref:`internal-urls`. Using this "
"feature is highly recommended when you have many components sharing the same "
"VCS. It improves performance and decreases required disk space."
msgstr ""
"ທ່ານສາມາດແບ່ງປັນ VCS repositories ທີ່ clone ມາໄດ້ໂດຍໃຊ້ :ref:`internal-urls`. "
"ການໃຊ້ຄຸນສົມບັດນີ້ໄດ້ຮັບການແນະນຳຢ່າງສູງເມື່ອທ່ານມີຫຼາຍອົງປະກອບທີ່ໃຊ້ VCS ດຽວກັນ. "
"ມັນຈະປັບປຸງປະສິດທິພາບ ແລະ ຫຼຸດພື້ນທີ່ດິສກ໌ທີ່ຕ້ອງການ."

msgid "Adding translation projects and components"
msgstr "ການເພີ່ມໂຄງການແປ ແລະ ອົງປະກອບ"

msgid ""
"Based on your permissions, new translation projects and components can be "
"created. It is always permitted for users with the :guilabel:`Add new "
"projects` permission, and if your instance uses billing (e.g. like https://"
"hosted.weblate.org/ see :ref:`billing`), you can also create those based on "
"your plans allowance from the user account that manages billing. Projects "
"can also be created in a workspace by users who have the :guilabel:`Add "
"projects to workspace` permission in that workspace. Creating a project "
"without selecting a workspace requires the site-wide :guilabel:`Add new "
"projects` permission. See :ref:`workspace-project-creation` for details."
msgstr ""
"ໂດຍອີງຕາມສິດທິອະນຸຍາດຂອງທ່ານ, ໂຄງການແປ ແລະ ອົງປະກອບໃໝ່ສາມາດຖືກສ້າງຂຶ້ນ. "
"ມັນໄດ້ຮັບອະນຸຍາດສະເໝີສຳລັບຜູ້ໃຊ້ທີ່ມີສິດທິອະນຸຍາດ :guilabel:`Add new projects`, ແລະ "
"ຖ້າລະບົບຂອງທ່ານໃຊ້ການເກັບເງິນ (ຕົວຢ່າງເຊັ່ນ https://hosted.weblate.org/ "
"ເບິ່ງ :ref:`billing`), "
"ທ່ານຍັງສາມາດສ້າງໂຄງການໂດຍອີງຕາມການອະນຸຍາດຂອງແຜນຂອງທ່ານຈາກບັນຊີຜູ້ໃຊ້ທີ່ຈັດການການເກັບເງິນ. "
"ໂຄງການຍັງສາມາດຖືກສ້າງໃນພື້ນທີ່ເຮັດວຽກໄດ້ໂດຍຜູ້ໃຊ້ທີ່ມີສິດທິອະນຸຍາດ :guilabel:`Add projects to "
"workspace` ໃນພື້ນທີ່ເຮັດວຽກນັ້ນ. "
"ການສ້າງໂຄງການໂດຍບໍ່ເລືອກພື້ນທີ່ເຮັດວຽກຈະຕ້ອງການສິດທິອະນຸຍາດ :guilabel:`Add new projects` "
"ທັງລະບົບ. ເບິ່ງ :ref:`workspace-project-creation` ສຳລັບລາຍລະອຽດ."

msgid ""
"To grant every user permission to create new projects create "
"new :ref:`autoteam` for the :guilabel:`Project creators` team."
msgstr ""
"ເພື່ອໃຫ້ສິດທິອະນຸຍາດແກ່ຜູ້ໃຊ້ທຸກຄົນໃນການສ້າງໂຄງການໃໝ່ ໃຫ້ສ້າງ :ref:`autoteam` "
"ໃໝ່ສຳລັບທີມ :guilabel:`Project creators`."

msgid "You can view your current billing plan on a separate page:"
msgstr "ທ່ານສາມາດເບິ່ງແຜນການເກັບເງິນປັດຈຸບັນຂອງທ່ານໃນໜ້າແຍກຕ່າງຫາກ:"

msgid ""
"The project creation can be initiated from there, or using the menu in the "
"navigation bar, filling in basic info about the translation project to "
"complete addition of it:"
msgstr ""
"ການສ້າງໂຄງການສາມາດເລີ່ມຕົ້ນໄດ້ຈາກບ່ອນນັ້ນ, ຫຼື ໂດຍໃຊ້ເມນູໃນແຖບນຳທາງ, "
"ໂດຍຕື່ມຂໍ້ມູນພື້ນຖານກ່ຽວກັບໂຄງການແປເພື່ອເຮັດໃຫ້ການເພີ່ມໂຄງການສຳເລັດ:"

msgid "After creating the project, you are taken directly to the project page:"
msgstr "ຫຼັງຈາກສ້າງໂຄງການແລ້ວ, ທ່ານຈະຖືກນຳໄປທີ່ໜ້າໂຄງການໂດຍກົງ:"

msgid ""
"Creating a new translation component can be initiated via a single click "
"there. The process of creating a component is multi-staged and automatically "
"detects most translation parameters. There are several approaches to "
"creating component:"
msgstr ""
"ການສ້າງອົງປະກອບການແປໃໝ່ສາມາດເລີ່ມຕົ້ນໄດ້ໂດຍການຄລິກເທື່ອດຽວຢູ່ບ່ອນນັ້ນ. "
"ຂະບວນການສ້າງອົງປະກອບມີຫຼາຍຂັ້ນຕອນ ແລະ ກວດສອບພາຣາມິເຕີການແປສ່ວນໃຫຍ່ໂດຍອັດຕະໂນມັດ. "
"ມີຫຼາຍວິທີໃນການສ້າງອົງປະກອບ:"

msgid "From version control"
msgstr "ຈາກລະບົບຄວບຄຸມເວີຊັນ"

msgid "Creates component from remote version control repository."
msgstr "ສ້າງອົງປະກອບຈາກ remote version control repository."

msgid "From existing component"
msgstr "ຈາກອົງປະກອບທີ່ມີຢູ່"

msgid ""
"Creates additional component to existing one by choosing different files."
msgstr "ສ້າງອົງປະກອບເພີ່ມເຕີມໃຫ້ກັບອົງປະກອບທີ່ມີຢູ່ໂດຍການເລືອກໄຟລ໌ທີ່ແຕກຕ່າງກັນ."

msgid "Additional branch"
msgstr "ສາຂາເພີ່ມເຕີມ"

msgid ""
"Creates additional component to existing one, just for different branch."
msgstr "ສ້າງອົງປະກອບເພີ່ມເຕີມໃຫ້ກັບອົງປະກອບທີ່ມີຢູ່, ສຳລັບ branch ທີ່ແຕກຕ່າງກັນເທົ່ານັ້ນ."

msgid "Upload translations files"
msgstr "ອັບໂຫຼດໄຟລ໌ການແປ"

msgid ""
"Upload translation files to Weblate in case you do not have version control "
"or do not want to integrate it with Weblate. You can later update the "
"content using the web interface or :ref:`api`."
msgstr ""
"ອັບໂຫຼດໄຟລ໌ການແປໃສ່ Weblate ໃນກໍລະນີທີ່ທ່ານບໍ່ມີ version control ຫຼື ບໍ່ຕ້ອງການເຊື່ອມຕໍ່ມັນກັບ "
"Weblate. ທ່ານສາມາດອັບເດດເນື້ອຫາໃນພາຍຫຼັງໂດຍໃຊ້ເວັບອິນເຕີເຟສ ຫຼື :ref:`api`."

msgid "Translate document"
msgstr "ແປເອກະສານ"

msgid "Upload single document or translation file and translate that."
msgstr "ອັບໂຫຼດເອກະສານດຽວ ຫຼື ໄຟລ໌ການແປ ແລະ ແປສິ່ງນັ້ນ."

msgid "Start from scratch"
msgstr "ເລີ່ມຈາກສູນ"

msgid "Create blank translation project and add strings manually."
msgstr "ສ້າງໂຄງການແປເປົ່າ ແລະ ເພີ່ມຂໍ້ຄວາມດ້ວຍຕົນເອງ."

msgid ""
"Once you have existing translation components, you can also easily add new "
"ones for additional files or branches using same repository."
msgstr ""
"ເມື່ອທ່ານມີອົງປະກອບການແປທີ່ມີຢູ່ແລ້ວ, ທ່ານຍັງສາມາດເພີ່ມອົງປະກອບໃໝ່ໄດ້ຢ່າງງ່າຍດາຍສຳລັບໄຟລ໌ ຫຼື branch "
"ເພີ່ມເຕີມໂດຍໃຊ້ repository ດຽວກັນ."

msgid "First you need to fill in name and repository location:"
msgstr "ທຳອິດທ່ານຕ້ອງຕື່ມຊື່ ແລະ ຕຳແໜ່ງ repository:"

msgid ""
"On the next page, you are presented with a list of discovered translatable "
"resources:"
msgstr "ໃນໜ້າຕໍ່ໄປ, ທ່ານຈະພົບກັບລາຍການຂອງຊັບພະຍາກອນທີ່ແປໄດ້ທີ່ຖືກຄົ້ນພົບ:"

msgid ""
"As a last step, you review the translation component info and fill in "
"optional details:"
msgstr "ໃນຂັ້ນຕອນສຸດທ້າຍ, ທ່ານຈະກວດສອບຂໍ້ມູນອົງປະກອບການແປ ແລະ ຕື່ມລາຍລະອຽດເພີ່ມເຕີມ:"

msgid "Project configuration"
msgstr "ການຕັ້ງຄ່າໂຄງການ"

msgid ""
"Create a translation project and then add a new component for translation in "
"it. The project is like a shelf, in which real translations are stacked. All "
"components in the same project share suggestions and their dictionary; the "
"translations are also automatically propagated through all components in a "
"single project (unless turned off in the component configuration), "
"see :ref:`memory`."
msgstr ""
"ສ້າງໂຄງການແປ ແລະ ຈາກນັ້ນເພີ່ມອົງປະກອບໃໝ່ສຳລັບການແປໃນນັ້ນ. ໂຄງການແມ່ນຄືກັບຊັ້ນວາງ, "
"ເຊິ່ງການແປຕົວຈິງຈະຖືກຈັດລຽງໄວ້. ອົງປະກອບທັງໝົດໃນໂຄງການດຽວກັນຈະແບ່ງປັນຄຳແນະນຳ ແລະ "
"ວັດຈະນານຸກົມຂອງພວກມັນ; ການແປຍັງຖືກກະຈາຍໂດຍອັດຕະໂນມັດຜ່ານອົງປະກອບທັງໝົດໃນໂຄງການດຽວ "
"(ນອກຈາກຈະຖືກປິດໃນການຕັ້ງຄ່າອົງປະກອບ), ເບິ່ງ :ref:`memory`."

msgid "These basic attributes set up and inform translators of a project:"
msgstr "ຄຸນລັກສະນະພື້ນຖານເຫຼົ່ານີ້ຕັ້ງຄ່າ ແລະ ແຈ້ງໃຫ້ນັກແປຂອງໂຄງການຊາບ:"

msgid "Project name"
msgstr "ຊື່ໂຄງການ"

msgid "Verbose project name, used to display the project name."
msgstr "ຊື່ໂຄງການແບບລະອຽດ, ໃຊ້ເພື່ອສະແດງຊື່ໂຄງການ."

msgid "URL slug"
msgstr "URL slug"

msgid "Project name suitable for URLs."
msgstr "ຊື່ໂຄງການທີ່ເໝາະສົມສຳລັບ URLs."

msgid "Project website"
msgstr "ເວັບໄຊຂອງໂຄງການ"

msgid "URL where translators can find more info about the project."
msgstr "URL ທີ່ນັກແປສາມາດພົບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບໂຄງການ."

msgid ""
"This is a required parameter unless turned off "
"by :setting:`WEBSITE_REQUIRED`."
msgstr "ນີ້ແມ່ນພາຣາມິເຕີທີ່ຈຳເປັນ ນອກຈາກຈະຖືກປິດໂດຍ :setting:`WEBSITE_REQUIRED`."

msgid "Translation instructions"
msgstr "ຄຳແນະນຳການແປ"

msgid ""
"Text describing localization process in the project, and any other "
"information useful for translators. Markdown can be used for text formatting "
"or inserting links."
msgstr ""
"ຂໍ້ຄວາມທີ່ອະທິບາຍຂະບວນການແປພາສາໃນໂຄງການ, ແລະ ຂໍ້ມູນອື່ນໆທີ່ເປັນປະໂຫຍດສຳລັບນັກແປ. Markdown "
"ສາມາດຖືກໃຊ້ສຳລັບການຈັດຮູບແບບຂໍ້ຄວາມ ຫຼື ການໃສ່ລິ້ງ."

msgid ""
"Good translation instructions explain how contributors should submit "
"translations, what review they should expect, how they can report problems "
"with source strings, and where translations can be tested or when they are "
"released."
msgstr ""
"ຄຳແນະນຳການແປທີ່ດີຄວນອະທິບາຍວ່າຜູ້ມີສ່ວນຮ່ວມຄວນສົ່ງການແປແນວໃດ, "
"ພວກເຂົາຄວນຄາດຫວັງການກວດສອບແບບໃດ, ພວກເຂົາສາມາດລາຍງານບັນຫາກ່ຽວກັບຂໍ້ຄວາມຕົ້ນສະບັບໄດ້ຢູ່ໃສ, "
"ແລະ ສາມາດທົດສອບການແປໄດ້ຢູ່ໃສ ຫຼື ຈະມີການປ່ອຍອອກເມື່ອໃດ."

msgid "Translation license"
msgstr "ໃບອະນຸຍາດການແປ"

msgid "Default translation license for components in this project."
msgstr "ສິດທິບັດການແປເລີ່ມຕົ້ນສຳລັບອົງປະກອບໃນໂຄງການນີ້."

msgid ""
"Default contributor license agreement for components in this project. "
"Markdown can be used for text formatting or inserting links."
msgstr ""
"ຂໍ້ຕົກລົງສິດທິບັດຂອງຜູ້ປະກອບສ່ວນເລີ່ມຕົ້ນສຳລັບອົງປະກອບໃນໂຄງການນີ້. Markdown "
"ສາມາດຖືກໃຊ້ສຳລັບການຈັດຮູບແບບຂໍ້ຄວາມ ຫຼື ການໃສ່ລິ້ງ."

msgid "Use shared translation memory"
msgstr "ໃຊ້ຄວາມຈຳການແປທີ່ແບ່ງປັນກັນ"

msgid ""
"Whether to use shared translation memory, see :ref:`shared-tm` for more "
"details."
msgstr "ຈະໃຊ້ໜ່ວຍຄວາມຈຳການແປແບບແບ່ງປັນຫຼືບໍ່, ເບິ່ງ :ref:`shared-tm` ສຳລັບລາຍລະອຽດເພີ່ມເຕີມ."

msgid "The default value can be changed by :setting:`DEFAULT_SHARED_TM`."
msgstr "ຄ່າເລີ່ມຕົ້ນສາມາດປ່ຽນແປງໄດ້ໂດຍ :setting:`DEFAULT_SHARED_TM`."

msgid "Contribute to shared translation memory"
msgstr "ປະກອບສ່ວນເຂົ້າໃນຄວາມຈຳການແປທີ່ແບ່ງປັນກັນ"

msgid ""
"Whether to contribute to shared translation memory, see :ref:`shared-tm` for "
"more details."
msgstr ""
"ຈະປະກອບສ່ວນເຂົ້າໃນໜ່ວຍຄວາມຈຳການແປແບບແບ່ງປັນຫຼືບໍ່, ເບິ່ງ :ref:`shared-tm` "
"ສຳລັບລາຍລະອຽດເພີ່ມເຕີມ."

msgid ""
"This also affects whether the project can be used as source "
"for :ref:`automatic-translation`."
msgstr ""
"ສິ່ງນີ້ຍັງສົ່ງຜົນຕໍ່ການທີ່ໂຄງການສາມາດຖືກໃຊ້ເປັນແຫຼ່ງສຳລັບ :ref:`automatic-translation` ຫຼືບໍ່."

msgid ""
"This option is unavailable on Hosted Weblate, it is toggled together "
"with :ref:`project-use_shared_tm`."
msgstr ""
"ຕົວເລືອກນີ້ບໍ່ສາມາດໃຊ້ໄດ້ໃນ Hosted Weblate, ມັນຈະຖືກເປີດ/ປິດຮ່ວມກັນກັບ :ref:`project-"
"use_shared_tm`."

msgid "Use workspace translation memory"
msgstr "ໃຊ້ຄວາມຈຳການແປຂອງພື້ນທີ່ເຮັດວຽກ"

msgid ""
"Whether to use translation memory shared by projects in the same workspace, "
"see :ref:`memory-scopes` for more details. The workspace has to allow "
"workspace translation memory as well."
msgstr ""
"ຈະໃຊ້ໜ່ວຍຄວາມຈຳການແປທີ່ແບ່ງປັນໂດຍໂຄງການໃນພື້ນທີ່ເຮັດວຽກດຽວກັນຫຼືບໍ່, ເບິ່ງ :ref:`memory-"
"scopes` ສຳລັບລາຍລະອຽດເພີ່ມເຕີມ. "
"ພື້ນທີ່ເຮັດວຽກຕ້ອງອະນຸຍາດໃຫ້ໃຊ້ໜ່ວຍຄວາມຈຳການແປຂອງພື້ນທີ່ເຮັດວຽກນຳ."

msgid "Contribute to workspace translation memory"
msgstr "ປະກອບສ່ວນເຂົ້າໃນຄວາມຈຳການແປຂອງພື້ນທີ່ເຮັດວຽກ"

msgid ""
"Whether to contribute translations to the translation memory shared by "
"projects in the same workspace. The workspace has to allow contribution as "
"well."
msgstr ""
"ຈະປະກອບສ່ວນການແປເຂົ້າໃນໜ່ວຍຄວາມຈຳການແປທີ່ແບ່ງປັນໂດຍໂຄງການໃນພື້ນທີ່ເຮັດວຽກດຽວກັນຫຼືບໍ່. "
"ພື້ນທີ່ເຮັດວຽກຕ້ອງອະນຸຍາດໃຫ້ມີການປະກອບສ່ວນນຳ."

msgid ""
"This option is unavailable on Hosted Weblate, it is toggled together "
"with :ref:`project-use-workspace-tm`."
msgstr ""
"ຕົວເລືອກນີ້ບໍ່ສາມາດໃຊ້ໄດ້ໃນ Hosted Weblate, ມັນຈະຖືກເປີດ/ປິດຮ່ວມກັນກັບ :ref:`project-use-"
"workspace-tm`."

msgid ""
"Whether to replace older automatically created translation memory entries "
"when a translation becomes active."
msgstr ""
"ຈະແທນທີ່ລາຍການໜ່ວຍຄວາມຈຳການແປທີ່ສ້າງຂຶ້ນອັດຕະໂນມັດທີ່ເກົ່າກວ່າ ເມື່ອຄຳແປກາຍເປັນສະຖານະໃຊ້ງານຫຼືບໍ່."

msgid ""
"Matching is based on the same source string, component, context, and source/"
"target language pair. Uploaded translation memory files are not affected."
msgstr ""
"ການຈັບຄູ່ແມ່ນອີງໃສ່ຂໍ້ຄວາມຕົ້ນສະບັບ, ອົງປະກອບ, ບໍລິບົດ, ແລະ ຄູ່ພາສາຕົ້ນສະບັບ/ປາຍທາງດຽວກັນ. "
"ໄຟລ໌ໜ່ວຍຄວາມຈຳການແປທີ່ອັບໂຫຼດໄວ້ຈະບໍ່ໄດ້ຮັບຜົນກະທົບ."

msgid "Configure per project access control, see :ref:`acl` for more details."
msgstr "ຕັ້ງຄ່າການຄວບຄຸມການເຂົ້າເຖິງແຕ່ລະໂຄງການ, ເບິ່ງ :ref:`acl` ສໍາລັບລາຍລະອຽດເພີ່ມເຕີມ."

msgid "The default value can be changed by :setting:`DEFAULT_ACCESS_CONTROL`."
msgstr "ຄ່າເລີ່ມຕົ້ນສາມາດປ່ຽນແປງໄດ້ໂດຍ :setting:`DEFAULT_ACCESS_CONTROL`."

msgid "Enforced two-factor authentication"
msgstr "ບັງຄັບໃຊ້ການຢືນຢັນຕົວຕົນແບບສອງຂັ້ນຕອນ"

msgid ""
"Enforce :ref:`2fa` for all contributors. Users won’t be allowed to perform "
"any operations within the project without having it configured."
msgstr ""
"ບັງຄັບ :ref:`2fa` ສໍາລັບຜູ້ປະກອບສ່ວນທຸກຄົນ. ຜູ້ໃຊ້ຈະບໍ່ໄດ້ຮັບອະນຸຍາດໃຫ້ດໍາເນີນການໃດໆພາຍໃນໂຄງການ "
"ຫາກຍັງບໍ່ໄດ້ຕັ້ງຄ່າໄວ້."

msgid "Enable reviews"
msgstr "ເປີດໃຊ້ການກວດສອບ (Reviews)"

msgid "Enable review workflow for translations, see :ref:`reviews`."
msgstr "ເປີດໃຊ້ຂັ້ນຕອນການກວດສອບສໍາລັບການແປ, ເບິ່ງ :ref:`reviews`."

msgid "Enable source reviews"
msgstr "ເປີດໃຊ້ການກວດສອບຕົ້ນສະບັບ"

msgid "Enable review workflow for source strings, see :ref:`source-reviews`."
msgstr "ເປີດໃຊ້ຂັ້ນຕອນການກວດສອບສໍາລັບຂໍ້ຄວາມຕົ້ນສະບັບ, ເບິ່ງ :ref:`source-reviews`."

msgid "Translation quality filter"
msgstr "ຕົວຕອງຄຸນນະພາບການແປ"

msgid ""
"The commit policy determines which translations are included when committing "
"changes to the version control system. This setting is available at the "
"project level and supports the following options:"
msgstr ""
"ນະໂຍບາຍການບັນທຶກ (commit) "
"ຈະກໍານົດວ່າການແປໃດແດ່ທີ່ຈະຖືກລວມເຂົ້າເມື່ອບັນທຶກການປ່ຽນແປງລົງໃນລະບົບຄວບຄຸມເວີຊັນ. "
"ການຕັ້ງຄ່ານີ້ມີໃຫ້ໃຊ້ໃນລະດັບໂຄງການ ແລະ ຮອງຮັບຕົວເລືອກດັ່ງຕໍ່ໄປນີ້:"

msgid ""
"**Commit all translations regardless of quality**: All translations will be "
"committed, including those marked as needing editing or not reviewed."
msgstr ""
"**ບັນທຶກທຸກການແປໂດຍບໍ່ຄໍານຶງເຖິງຄຸນນະພາບ**: ທຸກການແປຈະຖືກບັນທຶກ, "
"ລວມທັງອັນທີ່ຖືກໝາຍວ່າຕ້ອງການການແກ້ໄຂ ຫຼື ຍັງບໍ່ທັນໄດ້ກວດສອບ."

msgid ""
"**Skip translations marked as needing editing**: Only translations that "
"don't have the \"needs editing\", \"needs rewriting\" or \"needs checking\" "
"state will be committed."
msgstr ""
"**ຂ້າມການແປທີ່ຖືກໝາຍວ່າຕ້ອງການການແກ້ໄຂ**: ມີພຽງແຕ່ການແປທີ່ບໍ່ມີສະຖານະ \"needs editing\", "
"\"needs rewriting\" ຫຼື \"needs checking\" ເທົ່ານັ້ນທີ່ຈະຖືກບັນທຶກ."

msgid ""
"**Only include approved translations**: Only translations that have been "
"approved by a reviewer will be committed. This option requires :ref:`project-"
"translation_review` to be enabled."
msgstr ""
"**ລວມສະເພາະການແປທີ່ອະນຸມັດແລ້ວ**: ມີພຽງການແປທີ່ໄດ້ຮັບການອະນຸມັດຈາກຜູ້ກວດສອບເທົ່ານັ້ນທີ່ຈະຖືກບັນທຶກ. "
"ຕົວເລືອກນີ້ຕ້ອງການໃຫ້ເປີດໃຊ້ :ref:`project-translation_review`."

msgid "Enable hooks"
msgstr "ເປີດໃຊ້ Hooks"

msgid ""
"Whether unauthenticated :ref:`hooks` are to be used for this repository."
msgstr "ເລືອກວ່າຈະໃຊ້ :ref:`hooks` ທີ່ບໍ່ໄດ້ຢືນຢັນຕົວຕົນສໍາລັບ repository ນີ້ຫຼືບໍ່."

msgid "Language aliases"
msgstr "ນາມແຝງພາສາ"

msgid ""
"Define language codes mapping when importing translations into Weblate. Use "
"this when language codes are inconsistent in your repositories and you want "
"to get a consistent view in Weblate or in case you want to use non-standard "
"naming of your translation files."
msgstr ""
"ກໍານົດການຈັບຄູ່ລະຫັດພາສາເມື່ອນໍາເຂົ້າການແປເຂົ້າສູ່ Weblate. ໃຊ້ສິ່ງນີ້ເມື່ອລະຫັດພາສາບໍ່ສອດຄ່ອງກັນໃນ "
"repository ຂອງທ່ານ ແລະ ທ່ານຕ້ອງການໃຫ້ມັນສະແດງຜົນຢ່າງສອດຄ່ອງໃນ Weblate ຫຼື "
"ໃນກໍລະນີທີ່ທ່ານຕ້ອງການໃຊ້ການຕັ້ງຊື່ໄຟລ໌ການແປແບບບໍ່ມາດຕະຖານ."

msgid ""
"The typical use case might be mapping American English to English: "
"``en_US:en``"
msgstr ""
"ກໍລະນີການນໍາໃຊ້ທົ່ວໄປອາດຈະເປັນການຈັບຄູ່ພາສາອັງກິດແບບອາເມຣິກັນກັບພາສາອັງກິດ: ``en_US:en``"

msgid "Multiple mappings to be separated by comma: ``en_GB:en,en_US:en``"
msgstr "ການຈັບຄູ່ຫຼາຍອັນໃຫ້ແຍກດ້ວຍເຄື່ອງໝາຍຈຸດ: ``en_GB:en,en_US:en``"

msgid "Using non standard code: ``ia_FOO:ia``"
msgstr "ການໃຊ້ລະຫັດບໍ່ມາດຕະຖານ: ``ia_FOO:ia``"

msgid ""
"The language codes are mapped when matching the translation files and the "
"matches are case sensitive, so ensure you use the source language codes in "
"same form as used in the filenames."
msgstr ""
"ລະຫັດພາສາຈະຖືກຈັບຄູ່ເມື່ອຊອກຫາໄຟລ໌ການແປທີ່ກົງກັນ ແລະ ການຈັບຄູ່ນີ້ຈະແຍກຕົວພິມນ້ອຍ-ໃຫຍ່, "
"ດັ່ງນັ້ນໃຫ້ແນ່ໃຈວ່າທ່ານໃຊ້ລະຫັດພາສາຕົ້ນສະບັບໃນຮູບແບບດຽວກັນກັບທີ່ໃຊ້ໃນຊື່ໄຟລ໌."

msgid "Adding new translation"
msgstr "ການເພີ່ມການແປໃໝ່"

msgid ""
"Default behavior for requests to create new translations in components in "
"this project."
msgstr "ພຶດຕິກໍາເລີ່ມຕົ້ນສໍາລັບຄໍາຮ້ອງຂໍສ້າງການແປໃໝ່ໃນ component ພາຍໃນໂຄງການນີ້."

msgid "Language code style"
msgstr "ຮູບແບບລະຫັດພາສາ"

msgid ""
"Default language code style for translations created by Weblate in "
"components in this project."
msgstr "ຮູບແບບລະຫັດພາສາເລີ່ມຕົ້ນສໍາລັບການແປທີ່ສ້າງໂດຍ Weblate ໃນ component ຂອງໂຄງການນີ້."

msgid "Secondary language"
msgstr "ພາສາທີສອງ"

msgid ""
"Additional language to show together with the source language while "
"translating."
msgstr "ພາສາເພີ່ມເຕີມທີ່ຈະສະແດງພ້ອມກັບພາສາຕົ້ນສະບັບໃນຂະນະທີ່ແປ."

msgid ""
"Optionally, it can be also used as a source for the machine translation."
msgstr "ສາມາດເລືອກໃຊ້ເປັນແຫຼ່ງສໍາລັບການແປດ້ວຍເຄື່ອງຈັກໄດ້ອີກດ້ວຍ."

msgid "Translation flags"
msgstr "ແຟລັກການແປ"

msgid ""
"Customization of quality checks and other Weblate behavior, see :ref:`custom-"
"checks`."
msgstr ""
"ການປັບແຕ່ງການກວດສອບຄຸນນະພາບ ແລະ ພຶດຕິກໍາອື່ນໆຂອງ Weblate, ເບິ່ງ :ref:`custom-checks`."

msgid "Workspace, project, component, and translation flags are merged."
msgstr "ທຸງຂອງ Workspace, ໂຄງການ, component, ແລະ ການແປຈະຖືກຮວມເຂົ້າກັນ."

msgid "Commit, add, delete, merge, add-on, and merge request messages"
msgstr ""
"ຂໍ້ຄວາມສໍາລັບການ Commit, ເພີ່ມ, ລຶບ, ຮວມ, add-on, ແລະ ຄໍາຮ້ອງຂໍຮວມ (merge request)"

msgid ""
"Default commit and merge request message templates for components in this "
"project."
msgstr "ແມ່ແບບຂໍ້ຄວາມ Commit ແລະ Merge request ເລີ່ມຕົ້ນສໍາລັບ component ໃນໂຄງການນີ້."

msgid ""
"The default values can be changed "
"by :setting:`DEFAULT_ADD_MESSAGE`, :setting:`DEFAULT_ADDON_MESSAGE`, :setting:`DEFAULT_COMMIT_MESSAGE`, :setting:`DEFAULT_DELETE_MESSAGE`, :setting:`DEFAULT_MERGE_MESSAGE`, :setting:`DEFAULT_PULL_MESSAGE`."
msgstr "ຄ່າເລີ່ມຕົ້ນສາມາດປ່ຽນແປງໄດ້ໂດຍ :setting:`DEFAULT_ADD_MESSAGE`, :setting:`DEFAULT_ADDON_MESSAGE`, :setting:`DEFAULT_COMMIT_MESSAGE`, :setting:`DEFAULT_DELETE_MESSAGE`, :setting:`DEFAULT_MERGE_MESSAGE`, :setting:`DEFAULT_PULL_MESSAGE`."

msgid ""
"The built-in defaults follow Conventional Commits and include Weblate links "
"where available. Use :guilabel:`Restore site default` next to a message "
"editor to restore the current installation default for that message; for "
"inherited values, this also disables inheritance for that message."
msgstr ""
"ຄ່າເລີ່ມຕົ້ນທີ່ມີມາໃຫ້ປະຕິບັດຕາມ Conventional Commits ແລະ ລວມລິ້ງຂອງ Weblate ໄວ້ຖ້າມີ. "
"ໃຊ້ :guilabel:`Restore site default` "
"ຂ້າງຕົວແກ້ໄຂຂໍ້ຄວາມເພື່ອຟື້ນຄືນຄ່າເລີ່ມຕົ້ນຂອງການຕິດຕັ້ງນັ້ນໆສໍາລັບຂໍ້ຄວາມດັ່ງກ່າວ; "
"ສໍາລັບຄ່າທີ່ໄດ້ຮັບການສືບທອດມາ, ນີ້ຍັງເປັນການຍົກເລີກການສືບທອດສໍາລັບຂໍ້ຄວາມນັ້ນດ້ວຍ."

msgid "Component configuration"
msgstr "ການຕັ້ງຄ່າ Component"

msgid ""
"A component is a grouping of something for translation. You enter a VCS "
"repository location and file mask for which files you want translated, and "
"Weblate automatically fetches from this VCS, and finds all matching "
"translatable files."
msgstr ""
"Component ແມ່ນການຈັດກຸ່ມບາງສິ່ງບາງຢ່າງເພື່ອການແປ. ທ່ານພຽງແຕ່ໃສ່ຕໍາແໜ່ງ VCS repository ແລະ "
"file mask ສໍາລັບໄຟລ໌ທີ່ທ່ານຕ້ອງການແປ, ແລ້ວ Weblate ຈະດຶງຂໍ້ມູນຈາກ VCS ນັ້ນໂດຍອັດຕະໂນມັດ ແລະ "
"ຊອກຫາໄຟລ໌ທັງໝົດທີ່ສາມາດແປໄດ້."

msgid ""
"You can find some examples of typical configurations in the :ref:`formats`."
msgstr "ທ່ານສາມາດພົບຕົວຢ່າງການຕັ້ງຄ່າທົ່ວໄປໄດ້ໃນ :ref:`formats`."

msgid ""
"It is recommended to keep translation components to a reasonable size - "
"split the translation by anything that makes sense in your case (individual "
"apps or add-ons, book chapters or websites)."
msgstr ""
"ແນະນໍາໃຫ້ຮັກສາຂະໜາດຂອງ translation components ໃຫ້ເໝາະສົມ - "
"ໃຫ້ແບ່ງການແປຕາມສິ່ງທີ່ສົມເຫດສົມຜົນໃນກໍລະນີຂອງທ່ານ (ແຍກຕາມແອັບຯ ຫຼື add-ons, ບົດຂອງປຶ້ມ ຫຼື "
"ເວັບໄຊຕ໌)."

msgid ""
"Weblate easily handles translations with 10000s of strings, but it is harder "
"to split work and coordinate among translators with such large translation "
"components."
msgstr ""
"Weblate ສາມາດຈັດການການແປທີ່ມີຫຼາຍໝື່ນຂໍ້ຄວາມໄດ້ຢ່າງງ່າຍດາຍ, ແຕ່ການແບ່ງວຽກ ແລະ "
"ການປະສານງານລະຫວ່າງນັກແປຈະເຮັດໄດ້ຍາກຫາກ component ມີຂະໜາດໃຫຍ່ເກີນໄປ."

msgid ""
"Should the language definition for a translation be missing, an empty "
"definition is created and named as \"cs_CZ (generated)\". You should adjust "
"the definition and report this back to the Weblate authors, so that the "
"missing languages can be included in next release."
msgstr ""
"ຖ້າຫາກຄໍານິຍາມພາສາສໍາລັບການແປໃດໜຶ່ງຂາດຫາຍໄປ, ມັນຈະສ້າງຄໍານິຍາມຫວ່າງເປົ່າຂຶ້ນມາແລະຕັ້ງຊື່ວ່າ "
"\"cs_CZ (generated)\". ທ່ານຄວນປັບປ່ຽນຄໍານິຍາມນັ້ນ ແລະ ແຈ້ງໃຫ້ຜູ້ພັດທະນາ Weblate ຊາບ, "
"ເພື່ອໃຫ້ພາສາທີ່ຂາດຫາຍໄປນັ້ນຖືກລວມເຂົ້າໃນເວີຊັນຖັດໄປ."

msgid ""
"The component contains all important parameters for working with the VCS, "
"and for getting translations out of it:"
msgstr ""
"Component ປະກອບດ້ວຍພາລາມິເຕີທີ່ສໍາຄັນທັງໝົດສໍາລັບການເຮັດວຽກກັບ VCS ແລະ "
"ສໍາລັບການດຶງການແປອອກຈາກມັນ:"

msgid "Component name"
msgstr "ຊື່ຄອມໂພເນນ"

msgid "Verbose component name, used to display the component name."
msgstr "ຊື່ເຕັມຂອງ component, ໃຊ້ສໍາລັບສະແດງຊື່ component."

msgid "Component slug"
msgstr "Component slug"

msgid "Component name suitable for URLs."
msgstr "ຊື່ component ທີ່ເໝາະສົມສໍາລັບ URL."

msgid "Component project"
msgstr "ໂຄງການຂອງ Component"

msgid ":ref:`project` where the component belongs."
msgstr ":ref:`project` ທີ່ component ນີ້ສັງກັດຢູ່."

msgid "Version control system"
msgstr "ແອັບ Weblate GitHub"

msgid "VCS to use, see :ref:`vcs` for details."
msgstr "VCS ທີ່ຕ້ອງໃຊ້, ເບິ່ງ :ref:`vcs` ສໍາລັບລາຍລະອຽດ."

#, fuzzy
#| msgid "Version control repositories"
msgid "Version control parameters"
msgstr "ຣີໂພຊິທໍຣີຄວບຄຸມເວີຊັນ"

msgid ""
"Parameters tuning how Weblate interacts with the repository, for example "
"whether to force push or to open pull requests. Only parameters applicable "
"to the selected :ref:`component-vcs` are shown, see also :ref:`vcs_params`."
msgstr ""

msgid ""
"The settings form silently drops parameters which do not apply to the "
"selected version control system, but the REST API rejects them. When "
"changing :ref:`component-vcs` over the API, clear or replace ``vcs_params`` "
"in the same request. The same applies to :ref:`component-file_format_params` "
"and :ref:`component-file_format`."
msgstr ""

msgid "Source code repository"
msgstr "ຄັງເກັບຊອດໂຄ້ດ"

msgid "VCS repository used to pull changes."
msgstr "VCS repository ທີ່ໃຊ້ສໍາລັບດຶງການປ່ຽນແປງ."

msgid "See :ref:`vcs-repos` for more details on specifying URLs."
msgstr "ເບິ່ງ :ref:`vcs-repos` ສໍາລັບລາຍລະອຽດເພີ່ມເຕີມກ່ຽວກັບການກໍານົດ URL."

msgid ""
"This can either be a real VCS URL or ``weblate://project/component`` "
"indicating that the repository should be shared with another component. "
"See :ref:`internal-urls` for more details."
msgstr ""
"ນີ້ສາມາດເປັນໄດ້ທັງ VCS URL ແທ້ໆ ຫຼື ``weblate://project/component`` ເຊິ່ງຊີ້ບອກວ່າ "
"repository ຄວນຖືກແບ່ງປັນກັບ component ອື່ນ. ເບິ່ງ :ref:`internal-urls` "
"ສໍາລັບລາຍລະອຽດເພີ່ມເຕີມ."

msgid "Repository push URL"
msgstr "URL ສຳລັບ push ຄັງເກັບ"

msgid ""
"Repository URL used for pushing. The behavior of this depends "
"on :ref:`component-vcs`, and this is in more detail covered in :ref:`code-"
"hosting-push-options`."
msgstr ""
"Repository URL ທີ່ໃຊ້ສໍາລັບການ push. ພຶດຕິກໍາຂອງສິ່ງນີ້ຂຶ້ນຢູ່ກັບ :ref:`component-vcs`, ແລະ "
"ສິ່ງນີ້ຖືກອະທິບາຍຢ່າງລະອຽດໃນ :ref:`code-hosting-push-options`."

msgid ""
"For linked repositories, this is not used and setting from linked component "
"applies."
msgstr ""
"ສໍາລັບ repository ທີ່ເຊື່ອມຕໍ່ກັນ, ສິ່ງນີ້ຈະບໍ່ຖືກໃຊ້ ແລະ ຈະໃຊ້ການຕັ້ງຄ່າຈາກ component ທີ່ເຊື່ອມຕໍ່ແທນ."

msgid ""
"See :ref:`vcs-repos` for more details on how to specify a repository URL "
"and :ref:`code-hosting-push-options` for more details on pushing changes "
"from Weblate."
msgstr ""
"ເບິ່ງ :ref:`vcs-repos` ສໍາລັບລາຍລະອຽດເພີ່ມເຕີມກ່ຽວກັບວິທີການກໍານົດ repository URL "
"ແລະ :ref:`code-hosting-push-options` ສໍາລັບລາຍລະອຽດເພີ່ມເຕີມກ່ຽວກັບການ push "
"ການປ່ຽນແປງຈາກ Weblate."

msgid "Repository browser"
msgstr "ຕົວເບິ່ງຄັງເກັບ"

msgid ""
"URL of repository browser used to display source files (location of used "
"messages). When empty, no such links will be generated. You can "
"use :ref:`markup`."
msgstr ""
"URL ຂອງ repository browser ທີ່ໃຊ້ເພື່ອສະແດງໄຟລ໌ຕົ້ນສະບັບ (ຕໍາແໜ່ງຂອງຂໍ້ຄວາມທີ່ໃຊ້). "
"ຖ້າຫວ່າງເປົ່າ, ລິ້ງເຫຼົ່ານີ້ຈະບໍ່ຖືກສ້າງຂຶ້ນ. ທ່ານສາມາດໃຊ້ :ref:`markup`."

msgid ""
"For example on GitHub, use something like: ``https://github.com/WeblateOrg/"
"hello/blob/{{branch}}/{{filename}}#L{{line}}``"
msgstr ""
"ຕົວຢ່າງເຊັ່ນໃນ GitHub, ໃຫ້ໃຊ້ບາງຢ່າງເຊັ່ນ: ``https://github.com/WeblateOrg/hello/blob/"
"{{branch}}/{{filename}}#L{{line}}``"

msgid ""
"In case your paths are relative to different folder (path contains ``..``), "
"you might want to strip leading directory by ``parentdir`` filter "
"(see :ref:`markup`): ``https://github.com/WeblateOrg/hello/blob/{{branch}}/"
"{{filename|parentdir}}#L{{line}}``"
msgstr ""
"ໃນກໍລະນີທີ່ path ຂອງທ່ານອ້າງອີງເຖິງໂຟນເດີອື່ນ (path ມີ ``..``), "
"ທ່ານອາດຈະຕ້ອງການຕັດໄດເລກະທໍລີທາງໜ້າອອກດ້ວຍ filter ``parentdir`` "
"(ເບິ່ງ :ref:`markup`): ``https://github.com/WeblateOrg/hello/blob/{{branch}}/"
"{{filename|parentdir}}#L{{line}}``"

msgid "Exported repository URL"
msgstr "URL ຄັງເກັບທີ່ສົ່ງອອກ"

msgid ""
"URL where changes made by Weblate are exported. This is important "
"when :ref:`continuous-translation` is not used, or when there is a need to "
"manually merge changes. You can use :ref:`git-exporter` to automate this for "
"Git repositories."
msgstr ""
"URL ບ່ອນທີ່ການປ່ຽນແປງທີ່ເຮັດໂດຍ Weblate ຖືກສົ່ງອອກ. "
"ນີ້ແມ່ນສິ່ງສໍາຄັນເມື່ອບໍ່ໄດ້ໃຊ້ :ref:`continuous-translation` ຫຼື ເມື່ອມີຄວາມຕ້ອງການທີ່ຈະຮວມ "
"(merge) ການປ່ຽນແປງດ້ວຍຕົນເອງ. ທ່ານສາມາດໃຊ້ :ref:`git-exporter` "
"ເພື່ອເຮັດວຽກນີ້ໂດຍອັດຕະໂນມັດສໍາລັບ Git repositories."

msgid "Repository branch"
msgstr "ບຣານຊ໌ຂອງຄັງເກັບຂໍ້ມູນ"

msgid ""
"Which branch to checkout from the VCS, and where to look for translations."
msgstr "ສາຂາທີ່ໃຊ້ດຶງຂໍ້ມູນຈາກ VCS, ແລະບ່ອນທີ່ຈະຊອກຫາຄຳແປ."

msgid "Push branch"
msgstr "ສາຂາທີ່ຈະ push"

msgid "Branch for pushing changes, leave empty to use :ref:`component-branch`."
msgstr ""
"ບຣານ (branch) ສຳລັບການພຸຊ (push) ການປ່ຽນແປງ, ປະວ່າງໄວ້ຫາກຕ້ອງການໃຊ້ :ref:`component-"
"branch`."

msgid "This setting is ignored for Mercurial and Subversion."
msgstr "ການຕັ້ງຄ່ານີ້ຈະຖືກລະເລີຍສໍາລັບ Mercurial ແລະ Subversion."

msgid ""
"For Gerrit, this selects the target branch for the review request. Leave it "
"empty to review against :ref:`component-branch`. Use the short branch name, "
"not ``refs/heads/<branch>`` or ``refs/for/<branch>``. Gerrit push options "
"can be appended after ``%`` in either setting, for example "
"``main%topic=l10n``; Gerrit interprets them as the configured Weblate Gerrit "
"account."
msgstr ""
"ສໍາລັບ Gerrit, ນີ້ແມ່ນການເລືອກ branch ເປົ້າໝາຍສໍາລັບຄໍາຮ້ອງຂໍການກວດສອບ. "
"ປະຫວ່າງໄວ້ເພື່ອທຽບກັບ :ref:`component-branch`. ໃຊ້ຊື່ branch ແບບສັ້ນ, ບໍ່ແມ່ນ ``refs/"
"heads/<branch>`` ຫຼື ``refs/for/<branch>``. Gerrit push options ສາມາດເພີ່ມຕໍ່ຫຼັງ "
"``%`` ໃນການຕັ້ງຄ່າໃດກໍໄດ້, ຕົວຢ່າງເຊັ່ນ ``main%topic=l10n``; Gerrit "
"ຈະຕີຄວາມໝາຍສິ່ງເຫຼົ່ານັ້ນຕາມບັນຊີ Weblate Gerrit ທີ່ຕັ້ງຄ່າໄວ້."

msgid "File mask"
msgstr "ໜ້າກາກໄຟລ໌"

msgid ""
"Mask of files to translate, including path. It should include one \"*\" "
"replacing language code (see :ref:`languages` for info on how this is "
"processed). In case your repository contains more than one translation file "
"(e.g. more gettext domains), you need to create a component for each of them."
msgstr ""
"Mask ຂອງໄຟລ໌ທີ່ຕ້ອງການແປ, ລວມທັງ path. ມັນຄວນຈະມີ \"*\" ໜຶ່ງອັນເພື່ອແທນທີ່ລະຫັດພາສາ "
"(ເບິ່ງ :ref:`languages` ສໍາລັບຂໍ້ມູນກ່ຽວກັບວິທີການປະມວນຜົນສິ່ງນີ້). ໃນກໍລະນີທີ່ repository "
"ຂອງທ່ານມີໄຟລ໌ການແປຫຼາຍກວ່າໜຶ່ງໄຟລ໌ (ຕົວຢ່າງເຊັ່ນ ມີ gettext domains ຫຼາຍອັນ), "
"ທ່ານຈໍາເປັນຕ້ອງສ້າງ component ສໍາລັບແຕ່ລະໄຟລ໌."

msgid "For example ``po/*.po`` or ``locale/*/LC_MESSAGES/django.po``."
msgstr "ຕົວຢ່າງເຊັ່ນ ``po/*.po`` ຫຼື ``locale/*/LC_MESSAGES/django.po``."

msgid ""
"In case your filename contains special characters such as ``[``, ``]``, "
"these need to be escaped as ``[[]`` or ``[]]``."
msgstr ""
"ໃນກໍລະນີທີ່ຊື່ໄຟລ໌ຂອງທ່ານມີຕົວອັກສອນພິເສດເຊັ່ນ ``[``, ``]``, ສິ່ງເຫຼົ່ານີ້ຈະຕ້ອງຖືກ escape ເປັນ "
"``[[]`` ຫຼື ``[]]``."

msgid "Screenshot file mask"
msgstr "ໜ້າກາກໄຟລ໌ພາບໜ້າຈໍ"

msgid ""
"This feature allows the discovery and updating of screenshots through "
"screenshot file masks, using paths from the VCS repository. This operates at "
"the component level and necessitates the use of an asterisk \"*\" to replace "
"the screenshot file name."
msgstr ""
"ຟີເຈີນີ້ຊ່ວຍໃຫ້ສາມາດຄົ້ນພົບ ແລະ ອັບເດດພາບໜ້າຈໍຜ່ານ screenshot file masks, ໂດຍໃຊ້ path ຈາກ "
"VCS repository. ສິ່ງນີ້ເຮັດວຽກໃນລະດັບ component ແລະ ຈໍາເປັນຕ້ອງໃຊ້ເຄື່ອງໝາຍດອກຈັນ \"*\" "
"ເພື່ອແທນທີ່ຊື່ໄຟລ໌ພາບໜ້າຈໍ."

msgid "Allowed formats are WebP, JPEG, PNG, APNG and GIF."
msgstr "ຮູບແບບໄຟລ໌ທີ່ຮອງຮັບແມ່ນ WebP, JPEG, PNG, APNG ແລະ GIF."

msgid "Note:"
msgstr "ໝາຍເຫດ:"

msgid ""
"The file mask and screenshot file mask are not related. Configure them "
"separately."
msgstr "File mask ແລະ screenshot file mask ບໍ່ກ່ຽວຂ້ອງກັນ. ໃຫ້ຕັ້ງຄ່າແຍກຕ່າງຫາກ."

msgid ""
"It is a manual job to link a discovered screenshot in a component to a "
"specific translation key."
msgstr ""
"ມັນເປັນວຽກທີ່ຕ້ອງເຮັດດ້ວຍຕົນເອງໃນການເຊື່ອມໂຍງພາບໜ້າຈໍທີ່ຄົ້ນພົບໃນ component ກັບ translation "
"key ສະເພາະ."

msgid "Let's assume your VCS repository has a structure like this:"
msgstr "ສົມມຸດວ່າ VCS repository ຂອງທ່ານມີໂຄງສ້າງດັ່ງນີ້:"

msgid ""
"For component_A, you want to allow discovery and updates of PNG screenshots. "
"You'd set the screenshot file mask for component_A as ``component_A/docs/"
"*.png``. This means any PNG images under docs in component_A can be "
"discovered and updated. So, if you want to update ``image1.png``, the new "
"screenshot you provide should be named ``image1.png``, matching the existing "
"``filename``, and stored under ``component_A/docs/``."
msgstr ""
"ສໍາລັບ component_A, ທ່ານຕ້ອງການອະນຸຍາດໃຫ້ມີການຄົ້ນພົບ ແລະ ອັບເດດພາບໜ້າຈໍ PNG. ທ່ານຈະຕັ້ງຄ່າ "
"screenshot file mask ສໍາລັບ component_A ເປັນ ``component_A/docs/*.png``. "
"ນີ້ໝາຍຄວາມວ່າໄຟລ໌ຮູບພາບ PNG ໃດກໍຕາມພາຍໃຕ້ docs ໃນ component_A ສາມາດຖືກຄົ້ນພົບ ແລະ "
"ອັບເດດໄດ້. ດັ່ງນັ້ນ, ຖ້າທ່ານຕ້ອງການອັບເດດ ``image1.png``, ພາບໜ້າຈໍໃໝ່ທີ່ທ່ານໃຫ້ຄວນຕັ້ງຊື່ວ່າ "
"``image1.png``, ໃຫ້ກົງກັບ ``filename`` ທີ່ມີຢູ່ແລ້ວ, ແລະ ຈັດເກັບໄວ້ພາຍໃຕ້ ``component_A/"
"docs/``."

msgid ""
"For Android projects using Fastlane metadata, a source-language screenshot "
"mask can point to the metadata screenshot folder, for example ``fastlane/"
"metadata/android/en-US/images/phoneScreenshots/*.png``. Weblate will "
"discover matching screenshots on repository update. The discovered "
"screenshots still need to be associated with source strings in the "
"screenshot management interface; use OCR or source string search there to "
"assign them in bulk."
msgstr ""
"ສໍາລັບໂຄງການ Android ທີ່ໃຊ້ Fastlane metadata, screenshot mask "
"ຂອງພາສາຕົ້ນສະບັບສາມາດຊີ້ໄປທີ່ໂຟນເດີ metadata screenshot, ຕົວຢ່າງເຊັ່ນ ``fastlane/"
"metadata/android/en-US/images/phoneScreenshots/*.png``. Weblate "
"ຈະຄົ້ນພົບພາບໜ້າຈໍທີ່ກົງກັນເມື່ອອັບເດດ repository. ພາບໜ້າຈໍທີ່ຄົ້ນພົບຍັງຈໍາເປັນຕ້ອງໄດ້ຮັບການເຊື່ອມໂຍງກັບ "
"source strings ໃນສ່ວນການຈັດການພາບໜ້າຈໍ; ໃຫ້ໃຊ້ OCR ຫຼື ການຄົ້ນຫາ source string "
"ທີ່ນັ້ນເພື່ອມອບໝາຍພວກມັນແບບຈໍານວນຫຼາຍ (bulk)."

msgid "Monolingual base language file"
msgstr "ໄຟລ໌ພາສາຫຼັກ (Monolingual)"

msgid "Base file containing string definitions for :ref:`monolingual`."
msgstr "ໄຟລ໌ພື້ນຖານທີ່ມີຄໍານິຍາມຂໍ້ຄວາມສໍາລັບ :ref:`monolingual`."

msgid "Edit base file"
msgstr "ແກ້ໄຂໄຟລ໌ພື້ນຖານ"

msgid "Whether to allow editing strings in the :ref:`component-template`."
msgstr "ເລືອກວ່າຈະອະນຸຍາດໃຫ້ແກ້ໄຂຂໍ້ຄວາມໃນ :ref:`component-template` ຫຼືບໍ່."

msgid "Intermediate language file"
msgstr "ໄຟລ໌ພາສາກາງ"

msgid ""
"Intermediate language file for :ref:`monolingual`. In most cases this is a "
"translation file provided by developers and is used when creating actual "
"source strings."
msgstr ""
"ໄຟລ໌ພາສາກາງສໍາລັບ :ref:`monolingual`. ໃນກໍລະນີສ່ວນໃຫຍ່, ນີ້ແມ່ນໄຟລ໌ການແປທີ່ນັກພັດທະນາໃຫ້ມາ "
"ແລະ ຖືກໃຊ້ເມື່ອສ້າງ source strings ຕົວຈິງ."

msgid ""
"When set, the source strings are based on this file, but all other languages "
"are based on :ref:`component-template`. In case the string is not translated "
"into the source language, translating to other languages is prohibited. This "
"provides :ref:`source-quality-gateway`."
msgstr ""
"ເມື່ອຕັ້ງຄ່າແລ້ວ, source strings ຈະອີງຕາມໄຟລ໌ນີ້, ແຕ່ພາສາອື່ນທັງໝົດຈະອີງຕາມ :ref:`component-"
"template`. ໃນກໍລະນີທີ່ຂໍ້ຄວາມບໍ່ຖືກແປເປັນພາສາຕົ້ນສະບັບ, ການແປເປັນພາສາອື່ນຈະຖືກຫ້າມ. "
"ສິ່ງນີ້ສະໜອງ :ref:`source-quality-gateway`."

msgid ""
"The intermediate file can match an existing language file. While it is "
"configured as intermediate, Weblate does not list it as a regular language "
"in the component language list. Clearing this setting makes the file appear "
"as a regular language again on the next component scan."
msgstr ""
"ໄຟລ໌ກາງສາມາດກົງກັບໄຟລ໌ພາສາທີ່ມີຢູ່ແລ້ວ. ໃນຂະນະທີ່ມັນຖືກຕັ້ງຄ່າເປັນໄຟລ໌ກາງ, Weblate "
"ຈະບໍ່ສະແດງມັນເປັນພາສາປົກກະຕິໃນລາຍການພາສາຂອງ component. "
"ການລຶບການຕັ້ງຄ່ານີ້ຈະເຮັດໃຫ້ໄຟລ໌ກັບມາສະແດງເປັນພາສາປົກກະຕິອີກຄັ້ງໃນການສະແກນ component ຄັ້ງຖັດໄປ."

msgid ""
"Target strings can become read-only while the intermediate file is "
"configured. This happens for strings where the matching source string in "
"the :ref:`component-template` is not translated yet."
msgstr ""
"ຂໍ້ຄວາມເປົ້າໝາຍສາມາດກາຍເປັນແບບອ່ານຢ່າງດຽວ (read-only) ໃນຂະນະທີ່ໄຟລ໌ກາງຖືກຕັ້ງຄ່າໄວ້. "
"ສິ່ງນີ້ຈະເກີດຂຶ້ນກັບຂໍ້ຄວາມທີ່ source string ທີ່ກົງກັນໃນ :ref:`component-template` ຍັງບໍ່ທັນຖືກແປ."

msgid "Template for new translations"
msgstr "ແມ່ແບບສຳລັບການແປໃໝ່"

msgid "Base file used to generate new translations."
msgstr "ໄຟລ໌ພື້ນຖານທີ່ໃຊ້ເພື່ອສ້າງການແປໃໝ່."

msgid ""
"Keep this field empty for most of the monoligual formats. Those are "
"typically able to start from an empty file."
msgstr ""
"ໃຫ້ປະຊ່ອງນີ້ຫວ່າງໄວ້ສໍາລັບ format ແບບພາສາດຽວສ່ວນໃຫຍ່. ສິ່ງເຫຼົ່ານັ້ນມັກຈະສາມາດເລີ່ມຕົ້ນຈາກໄຟລ໌ເປົ່າໄດ້."

msgid "Choose ``.pot`` file with GNU gettext PO files."
msgstr "ເລືອກໄຟລ໌ ``.pot`` ທີ່ມີໄຟລ໌ GNU gettext PO."

msgid "Choose blank file without translations, if you have one."
msgstr "ເລືອກໄຟລ໌ເປົ່າທີ່ບໍ່ມີການແປ, ຖ້າທ່ານມີ."

msgid ""
"Choose :ref:`component-template` for monolingual formats that need a full "
"set of keys present."
msgstr ""
"ເລືອກ :ref:`component-template` ສໍາລັບ format ແບບພາສາດຽວທີ່ຕ້ອງການຊຸດ key ທັງໝົດທີ່ມີຢູ່."

msgid "Choose :ref:`component-template` for document translations."
msgstr "ເລືອກ :ref:`component-template` ສໍາລັບການແປເອກະສານ."

msgid "Choose any translation file for others."
msgstr "ເລືອກໄຟລ໌ການແປໃດກໍໄດ້ສໍາລັບອັນອື່ນ."

msgid "Template file can be the same as the base file in most cases."
msgstr "ໃນກໍລະນີສ່ວນໃຫຍ່, ໄຟລ໌ແມ່ແບບສາມາດເປັນໄຟລ໌ດຽວກັນກັບໄຟລ໌ພື້ນຖານໄດ້."

msgid ""
"In many monolingual formats Weblate starts with empty file by default. Use "
"this in case you want to have all strings present with empty value when "
"creating new translation."
msgstr ""
"ໃນຫຼາຍ format ແບບພາສາດຽວ, Weblate ຈະເລີ່ມຕົ້ນດ້ວຍໄຟລ໌ເປົ່າໂດຍເລີ່ມຕົ້ນ. "
"ໃຫ້ໃຊ້ສິ່ງນີ້ໃນກໍລະນີທີ່ທ່ານຕ້ອງການໃຫ້ຂໍ້ຄວາມທັງໝົດທີ່ມີຢູ່ມີຄ່າຫວ່າງເປົ່າເມື່ອສ້າງການແປໃໝ່."

msgid "File format"
msgstr "ຮູບແບບໄຟລ໌"

msgid "Translation file format, see also :ref:`formats`."
msgstr "ຮູບແບບໄຟລ໌ການແປ, ເບິ່ງເພີ່ມເຕີມທີ່ :ref:`formats`."

msgid "File format parameters"
msgstr "ພາລາມິເຕີຮູບແບບໄຟລ໌"

msgid ""
"Parameters used to configure how translation files are processed, see "
"also :ref:`file_format_params`."
msgstr ""
"ພາລາມິເຕີທີ່ໃຊ້ເພື່ອຕັ້ງຄ່າວິທີການປະມວນຜົນໄຟລ໌ການແປ, ເບິ່ງເພີ່ມເຕີມທີ່ :ref:`file_format_params`."

msgid "Source string bug reporting address"
msgstr "ທີ່ຢູ່ລາຍງານຂໍ້ຜິດພາດຂອງຂໍ້ຄວາມຕົ້ນສະບັບ"

msgid ""
"Email address used for reporting upstream bugs. This address will also "
"receive notification about any source string comments made in Weblate."
msgstr ""
"ທີ່ຢູ່ອີເມວທີ່ໃຊ້ສໍາລັບການລາຍງານຂໍ້ຜິດພາດຂອງແຫຼ່ງທີ່ມາ (upstream bugs). "
"ທີ່ຢູ່ນີ້ຍັງຈະໄດ້ຮັບການແຈ້ງເຕືອນກ່ຽວກັບຄໍາຄິດເຫັນກ່ຽວກັບຂໍ້ຄວາມຕົ້ນສະບັບທີ່ເຮັດໃນ Weblate."

msgid ""
"With the :ref:`gettext` format, this address is also saved by Weblate in "
"the :mailheader:`Report-Msgid-Bugs-To` header of the file."
msgstr ""
"ດ້ວຍ format :ref:`gettext`, ທີ່ຢູ່ນີ້ຈະຖືກບັນທຶກໂດຍ Weblate ໃນ "
"header :mailheader:`Report-Msgid-Bugs-To` ຂອງໄຟລ໌."

msgid "Do not show glossary matches"
msgstr "ບໍ່ຕ້ອງສະແດງຄຳສັບທີ່ກົງກັບອະພິທານສັບ"

msgid ""
"Hides the glossary panel and its matches in the translation editor for this "
"component. When enabled, glossary suggestions for this component are not "
"computed, and the Glossary panel (including its “Add term to glossary” "
"action) is hidden in the editor."
msgstr ""
"ເຊື່ອງແຜງ glossary ແລະ ການຈັບຄູ່ໃນຕົວແກ້ໄຂການແປສໍາລັບ component ນີ້. ເມື່ອເປີດໃຊ້ງານ, "
"ຄໍາແນະນໍາ glossary ສໍາລັບ component ນີ້ຈະບໍ່ຖືກຄິດໄລ່, ແລະ ແຜງ Glossary "
"(ລວມທັງການດໍາເນີນການ “Add term to glossary”) ຈະຖືກເຊື່ອງໄວ້ໃນຕົວແກ້ໄຂ."

msgid ""
"Glossary self-references are always excluded from matches even when this "
"option is disabled."
msgstr ""
"ການອ້າງອີງຕົນເອງຂອງ glossary ຈະຖືກຍົກເວັ້ນຈາກການຈັບຄູ່ສະເໝີ ເຖິງແມ່ນວ່າຕົວເລືອກນີ້ຈະຖືກປິດໄວ້ກໍຕາມ."

msgid "Contribute to project translation memory"
msgstr "ປະກອບສ່ວນເຂົ້າໃນຄວາມຈຳການແປ (Translation memory) ຂອງໂຄງການ"

msgid ""
"Controls whether translations from this component are added to the project "
"translation memory."
msgstr "ຄວບຄຸມວ່າຈະໃຫ້ເພີ່ມຄຳແປຈາກສ່ວນປະກອບນີ້ເຂົ້າໃນຄັງຄຳແປຂອງໂຄງການຫຼືບໍ່."

msgid "Allow translation propagation"
msgstr "ອະນຸຍາດການກະຈາຍການແປ"

msgid ""
"You can turn off propagation of translations to this component from other "
"components within same project. This really depends on what you are "
"translating, sometimes it's desirable to have make use of a translation more "
"than once."
msgstr ""
"ທ່ານສາມາດປິດການແຜ່ກະຈາຍການແປມາສູ່ component ນີ້ຈາກ component ອື່ນພາຍໃນໂຄງການດຽວກັນ. "
"ນີ້ຂຶ້ນຢູ່ກັບສິ່ງທີ່ທ່ານກໍາລັງແປຢ່າງແທ້ຈິງ, ບາງຄັ້ງມັນກໍເປັນທີ່ຕ້ອງການທີ່ຈະໃຊ້ການແປຫຼາຍກວ່າໜຶ່ງຄັ້ງ."

msgid ""
"It's usually a good idea to turn this off for monolingual translations, "
"unless you are using the same IDs across the whole project."
msgstr ""
"ໂດຍປົກກະຕິແລ້ວມັນເປັນຄວາມຄິດທີ່ດີທີ່ຈະປິດສິ່ງນີ້ສໍາລັບການແປແບບພາສາດຽວ (monolingual), "
"ເວັ້ນເສຍແຕ່ວ່າທ່ານຈະໃຊ້ IDs ດຽວກັນຕະຫຼອດທັງໂຄງການ."

msgid ""
"The default value can be changed "
"by :setting:`DEFAULT_TRANSLATION_PROPAGATION`."
msgstr "ຄ່າເລີ່ມຕົ້ນສາມາດປ່ຽນແປງໄດ້ໂດຍ :setting:`DEFAULT_TRANSLATION_PROPAGATION`."

msgid "Enable suggestions"
msgstr "ເປີດໃຊ້ຄໍາແນະນໍາ"

msgid "Whether translation suggestions are accepted for this component."
msgstr "ເລືອກວ່າຄໍາແນະນໍາການແປຈະຖືກຍອມຮັບສໍາລັບ component ນີ້ຫຼືບໍ່."

msgid "Suggestion voting"
msgstr "ການລົງຄະແນນສຽງການແນະນຳ"

msgid "Turns on vote casting for suggestions, see :ref:`voting`."
msgstr "ເປີດໃຊ້ການລົງຄະແນນສຽງສໍາລັບຄໍາແນະນໍາ, ເບິ່ງ :ref:`voting`."

msgid "Automatically accept suggestions"
msgstr "ຍອມຮັບການແນະນຳໂດຍອັດຕະໂນມັດ"

msgid "Automatically accept voted suggestions, see :ref:`voting`."
msgstr "ຍອມຮັບຄໍາແນະນໍາທີ່ມີຄະແນນສຽງໂດຍອັດຕະໂນມັດ, ເບິ່ງ :ref:`voting`."

msgid "Enforced checks"
msgstr "ການກວດສອບທີ່ບັງຄັບ"

msgid "List of checks which can not be dismissed."
msgstr "ລາຍການການກວດສອບທີ່ບໍ່ສາມາດຍົກເລີກໄດ້."

msgid ""
"License of the translation (does not need to be the same as the source code "
"license)."
msgstr "ໃບອະນຸຍາດຂອງການແປ (ບໍ່ຈໍາເປັນຕ້ອງເປັນໃບອະນຸຍາດດຽວກັນກັບ source code)."

msgid ""
"Contributor license agreement which needs to be approved before a user can "
"translate this component."
msgstr "ຂໍ້ຕົກລົງອະນຸຍາດຜູ້ປະກອບສ່ວນເຊິ່ງຕ້ອງໄດ້ຮັບການອະນຸມັດກ່ອນທີ່ຜູ້ໃຊ້ຈະສາມາດແປສ່ວນປະກອບນີ້ໄດ້."

msgid "Markdown can be used for text formatting or inserting links."
msgstr "Markdown ສາມາດຖືກໃຊ້ສໍາລັບການຈັດຮູບແບບຂໍ້ຄວາມ ຫຼື ໃສ່ລິ້ງ."

msgid ""
"How to handle requests for creation of new languages. Available options:"
msgstr "ວິທີຈັດການກັບຄໍາຮ້ອງຂໍສ້າງພາສາໃໝ່. ຕົວເລືອກທີ່ມີຢູ່:"

msgid "Contact maintainers"
msgstr "ຕິດຕໍ່ຜູ້ດູແລ"

msgid ""
"User can select desired language and the project maintainers will receive a "
"notification about this. It is up to them to add (or not) the language to "
"the repository."
msgstr ""
"ຜູ້ໃຊ້ສາມາດເລືອກພາສາທີ່ຕ້ອງການ ແລະ ຜູ້ດູແລໂຄງການຈະໄດ້ຮັບການແຈ້ງເຕືອນກ່ຽວກັບເລື່ອງນີ້. "
"ມັນຂຶ້ນຢູ່ກັບພວກເຂົາວ່າຈະເພີ່ມ (ຫຼື ບໍ່ເພີ່ມ) ພາສານັ້ນເຂົ້າໃນ repository."

msgid "Point to translation instructions URL"
msgstr "ຊີ້ໄປຫາ URL ຄຳແນະນຳການແປ"

msgid ""
"User is presented a link to page which describes process of starting new "
"translations. Use this in case more formal process is desired (for example "
"forming a team of people before starting actual translation)."
msgstr ""
"ຜູ້ໃຊ້ຈະໄດ້ຮັບລິ້ງໄປຍັງໜ້າທີ່ອະທິບາຍຂະບວນການເລີ່ມຕົ້ນການແປໃໝ່. "
"ໃຊ້ຕົວເລືອກນີ້ໃນກໍລະນີທີ່ຕ້ອງການຂະບວນການທີ່ເປັນທາງການຫຼາຍຂຶ້ນ (ຕົວຢ່າງ: "
"ການສ້າງທີມງານກ່ອນຈະເລີ່ມການແປຕົວຈິງ)."

msgid "Create new language file"
msgstr "ສ້າງໄຟລ໌ພາສາໃໝ່"

msgid ""
"User can select language and Weblate automatically creates the file for it "
"and translation can begin."
msgstr ""
"ຜູ້ໃຊ້ສາມາດເລືອກພາສາ ແລະ Weblate ຈະສ້າງໄຟລ໌ສໍາລັບພາສານັ້ນໂດຍອັດຕະໂນມັດ ແລະ "
"ການແປກໍສາມາດເລີ່ມຕົ້ນໄດ້."

msgid "Disable adding new translations"
msgstr "ປິດການເພີ່ມການແປໃໝ່"

msgid "There will be no option for user to start new translation."
msgstr "ຈະບໍ່ມີຕົວເລືອກໃຫ້ຜູ້ໃຊ້ເລີ່ມຕົ້ນການແປໃໝ່."

msgid ""
"The project admins can add new translations even if it is disabled here when "
"it is possible (either :ref:`component-new_base` or the file format supports "
"starting from an empty file)."
msgstr ""
"ຜູ້ດູແລໂຄງການສາມາດເພີ່ມການແປໃໝ່ໄດ້ເຖິງແມ່ນວ່າຈະຖືກປິດໄວ້ທີ່ນີ້ເມື່ອເປັນໄປໄດ້ "
"(ບໍ່ວ່າຈະເປັນ :ref:`component-new_base` ຫຼື ຮູບແບບໄຟລ໌ຮອງຮັບການເລີ່ມຕົ້ນຈາກໄຟລ໌ເປົ່າ)."

msgid "Manage strings"
msgstr "ຈັດການຂໍ້ຄວາມ"

msgid ""
"Configures whether users in Weblate will be allowed to add new strings and "
"remove existing ones. Adjust this to match your localization workflow - how "
"the new strings are supposed to be introduced."
msgstr ""
"ຕັ້ງຄ່າວ່າຈະອະນຸຍາດໃຫ້ຜູ້ໃຊ້ໃນ Weblate ເພີ່ມຂໍ້ຄວາມໃໝ່ ແລະ ລຶບຂໍ້ຄວາມທີ່ມີຢູ່ແລ້ວຫຼືບໍ່. "
"ປັບການຕັ້ງຄ່ານີ້ໃຫ້ກົງກັບຂະບວນການແປພາສາຂອງທ່ານ - ວິທີການທີ່ຂໍ້ຄວາມໃໝ່ຄວນຖືກນໍາເຂົ້າ."

msgid ""
"For bilingual formats, the strings are typically extracted from the source "
"code (for example by using :program:`xgettext`) and adding new strings in "
"Weblate should be disabled (they would be discarded next time you update the "
"translation files). In Weblate you can manage strings for every translation "
"and it does not enforce the strings in all translations to be consistent."
msgstr ""
"ສໍາລັບ format ແບບສອງພາສາ (bilingual), ຂໍ້ຄວາມມັກຈະຖືກສະກັດອອກຈາກ source code "
"(ຕົວຢ່າງໂດຍການໃຊ້ :program:`xgettext`) ແລະ ການເພີ່ມຂໍ້ຄວາມໃໝ່ໃນ Weblate ຄວນຖືກປິດ "
"(ເພາະມັນຈະຖືກຍົກເລີກໃນຄັ້ງຕໍ່ໄປທີ່ທ່ານອັບເດດໄຟລ໌ການແປ). ໃນ Weblate, "
"ທ່ານສາມາດຈັດການຂໍ້ຄວາມສໍາລັບທຸກການແປ ແລະ ມັນບໍ່ໄດ້ບັງຄັບໃຫ້ຂໍ້ຄວາມໃນທຸກການແປຕ້ອງສອດຄ່ອງກັນ."

msgid ""
"For monolingual formats, the strings are managed only on source language and "
"are automatically added or removed in the translations. The strings appear "
"in the translation files once they are translated."
msgstr ""
"ສໍາລັບ format ແບບພາສາດຽວ (monolingual), ຂໍ້ຄວາມຈະຖືກຈັດການໃນພາສາຕົ້ນສະບັບເທົ່ານັ້ນ ແລະ "
"ຈະຖືກເພີ່ມ ຫຼື ລຶບອອກໃນການແປໂດຍອັດຕະໂນມັດ. ຂໍ້ຄວາມຈະປາກົດໃນໄຟລ໌ການແປເມື່ອພວກມັນຖືກແປແລ້ວ."

msgid ""
"You might want to turn on :ref:`component-edit_template` together "
"with :guilabel:`Manage strings` for monolingual formats."
msgstr ""
"ທ່ານອາດຈະຕ້ອງການເປີດໃຊ້ :ref:`component-edit_template` ພ້ອມກັບ :guilabel:`Manage "
"strings` ສໍາລັບ format ແບບພາສາດຽວ."

msgid ""
":http:post:`/api/translations/(string:project)/(string:component)/"
"(string:language)/units/`"
msgstr ""
":http:post:`/api/translations/(string:project)/(string:component)/"
"(string:language)/units/`"

msgid ""
"Customize language code used to generate the filename for translations "
"created by Weblate."
msgstr "ປັບແຕ່ງລະຫັດພາສາທີ່ໃຊ້ເພື່ອສ້າງຊື່ໄຟລ໌ສຳລັບການແປທີ່ສ້າງໂດຍ Weblate."

msgid ""
"Weblate recognizes any of the language codes when parsing translation files, "
"following settings only influences how new files are created."
msgstr ""
"Weblate ຮັບຮູ້ລະຫັດພາສາໃດກໍໄດ້ເມື່ອ parsing ໄຟລ໌ການແປ, "
"ການຕັ້ງຄ່າຕໍ່ໄປນີ້ມີຜົນຕໍ່ກັບວິທີການສ້າງໄຟລ໌ໃໝ່ເທົ່ານັ້ນ."

msgid "Default based on the file format"
msgstr "ຄ່າເລີ່ມຕົ້ນຕາມຮູບແບບໄຟລ໌"

msgid "Dependent on file format, for most of them POSIX is used."
msgstr "ຂຶ້ນຢູ່ກັບ format ໄຟລ໌, ສໍາລັບສ່ວນໃຫຍ່ແລ້ວ POSIX ຈະຖືກໃຊ້."

msgid "POSIX style using underscore as a separator"
msgstr "ແບບ POSIX ໂດຍໃຊ້ຂີດກ້ອງເປັນຕົວຂັ້ນ"

msgid ""
"Typically used by gettext and related tools, produces language codes like "
"``pt_BR``."
msgstr "ໂດຍປົກກະຕິແລ້ວໃຊ້ໂດຍ gettext ແລະ ເຄື່ອງມືທີ່ກ່ຽວຂ້ອງ, ສ້າງລະຫັດພາສາເຊັ່ນ ``pt_BR``."

msgid "POSIX style using underscore as a separator, lower cased"
msgstr "ແບບ POSIX ໂດຍໃຊ້ຂີດກ້ອງເປັນຕົວຂັ້ນ, ເປັນຕົວພິມນ້ອຍ"

msgid "POSIX style using underscore as a separator, including country code"
msgstr "ແບບ POSIX ໂດຍໃຊ້ຂີດກ້ອງເປັນຕົວຂັ້ນ, ລວມທັງລະຫັດປະເທດ"

msgid ""
"POSIX style language code including the country code even when not necessary "
"(for example ``cs_CZ``)."
msgstr "ລະຫັດພາສາຮູບແບບ POSIX ລວມທັງລະຫັດປະເທດເຖິງແມ່ນວ່າຈະບໍ່ຈໍາເປັນ (ຕົວຢ່າງ ``cs_CZ``)."

msgid ""
"POSIX style using underscore as a separator, including country code, lower "
"cased"
msgstr "ແບບ POSIX ໂດຍໃຊ້ຂີດກ້ອງເປັນຕົວຂັ້ນ, ລວມທັງລະຫັດປະເທດ, ເປັນຕົວພິມນ້ອຍ"

msgid ""
"POSIX style language code including the country code even when not necessary "
"(lowercase) (for example ``cs_cz``)."
msgstr ""
"ລະຫັດພາສາຮູບແບບ POSIX ລວມທັງລະຫັດປະເທດເຖິງແມ່ນວ່າຈະບໍ່ຈໍາເປັນ (ຕົວພິມນ້ອຍ) (ຕົວຢ່າງ "
"``cs_cz``)."

msgid "BCP style using hyphen as a separator"
msgstr "ແບບ BCP ໂດຍໃຊ້ຂີດຕໍ່ເປັນຕົວຂັ້ນ"

msgid ""
"Typically used on web platforms, produces language codes like ``pt-BR``."
msgstr "ໂດຍປົກກະຕິແລ້ວໃຊ້ໃນເວທີເວັບ, ສ້າງລະຫັດພາສາເຊັ່ນ ``pt-BR``."

msgid "BCP style using hyphen as a separator, including country code"
msgstr "ແບບ BCP ໂດຍໃຊ້ຂີດຕໍ່ເປັນຕົວຂັ້ນ, ລວມທັງລະຫັດປະເທດ"

msgid ""
"BCP style language code including the country code even when not necessary "
"(for example ``cs-CZ``)."
msgstr "ລະຫັດພາສາຮູບແບບ BCP ລວມທັງລະຫັດປະເທດເຖິງແມ່ນວ່າຈະບໍ່ຈໍາເປັນ (ຕົວຢ່າງ ``cs-CZ``)."

msgid "BCP style using hyphen as a separator, legacy language codes"
msgstr "ແບບ BCP ໂດຍໃຊ້ຂີດຕໍ່ເປັນຕົວຂັ້ນ, ລະຫັດພາສາແບບເກົ່າ"

msgid "Uses legacy codes for Chinese and BCP style notation."
msgstr "ໃຊ້ລະຫັດແບບເກົ່າສໍາລັບພາສາຈີນ ແລະ ສັນຍາລັກຮູບແບບ BCP."

msgid "BCP style using hyphen as a separator, lower cased"
msgstr "ແບບ BCP ໂດຍໃຊ້ຂີດຕໍ່ເປັນຕົວຂັ້ນ, ເປັນຕົວພິມນ້ອຍ"

msgid "BCP style notation, all in lower case (for example ``cs-cz``)."
msgstr "ສັນຍາລັກຮູບແບບ BCP, ທັງໝົດເປັນຕົວພິມນ້ອຍ (ຕົວຢ່າງ ``cs-cz``)."

msgid "Apple App Store metadata style"
msgstr "ແບບຂໍ້ມູນເມຕາ Apple App Store"

msgid "Style suitable for uploading metadata to Apple App Store."
msgstr "ຮູບແບບທີ່ເໝາະສົມສໍາລັບການອັບໂຫຼດ metadata ໄປຍັງ Apple App Store."

msgid "Google Play metadata style"
msgstr "ແບບຂໍ້ມູນເມຕາ Google Play"

msgid "Style suitable for uploading metadata to Google Play Store."
msgstr "ຮູບແບບທີ່ເໝາະສົມສໍາລັບການອັບໂຫຼດ metadata ໄປຍັງ Google Play Store."

msgid "Android style"
msgstr "ແບບ Android"

msgid "Only used in Android apps, produces language codes like ``pt-rBR``."
msgstr "ໃຊ້ໃນແອັບຯ Android ເທົ່ານັ້ນ, ສ້າງລະຫັດພາສາເຊັ່ນ ``pt-rBR``."

msgid "Linux style"
msgstr "ແບບ Linux"

msgid ""
"Locales as used by Linux, uses legacy codes for Chinese and POSIX style "
"notation."
msgstr "Locales ທີ່ໃຊ້ໂດຍ Linux, ໃຊ້ລະຫັດແບບເກົ່າສໍາລັບພາສາຈີນ ແລະ ສັນຍາລັກຮູບແບບ POSIX."

msgid "Linux style, lower cased"
msgstr "ແບບ Linux, ເປັນຕົວພິມນ້ອຍ"

msgid ""
"Locales as used by Linux, uses legacy codes for Chinese and POSIX style "
"notation. Lower cased."
msgstr ""
"Locales ທີ່ໃຊ້ໂດຍ Linux, ໃຊ້ລະຫັດແບບເກົ່າສໍາລັບພາສາຈີນ ແລະ ສັນຍາລັກຮູບແບບ POSIX. ຕົວພິມນ້ອຍ."

msgid "Merge style"
msgstr "ຮູບແບບການລວມ (Merge style)"

msgid ""
"You can configure how updates from the upstream repository are handled. The "
"actual implementation depends on VCS, see :doc:`/vcs`."
msgstr ""
"ທ່ານສາມາດຕັ້ງຄ່າວິທີການຈັດການການອັບເດດຈາກ upstream repository. ການປະຕິບັດງານຕົວຈິງຂຶ້ນຢູ່ກັບ "
"VCS, ເບິ່ງ :doc:`/vcs`."

msgid "Rebase"
msgstr "Rebase"

msgid ""
"Rebases Weblate commits on top of upstream repository on update. This "
"provides clean history without extra merge commits."
msgstr ""
"Rebase ການ commit ຂອງ Weblate ໄວ້ເທິງສຸດຂອງ upstream repository ເມື່ອມີການອັບເດດ. "
"ສິ່ງນີ້ຈະໃຫ້ປະຫວັດທີ່ສະອາດໂດຍບໍ່ມີການ merge commits ເພີ່ມເຕີມ."

msgid ""
"Rebasing can cause you trouble in case of complicated merges, so carefully "
"consider whether or not you want to enable them."
msgstr ""
"Rebasing ສາມາດເຮັດໃຫ້ທ່ານມີບັນຫາໃນກໍລະນີທີ່ມີການ merge ທີ່ສັບສົນ, "
"ດັ່ງນັ້ນໃຫ້ພິຈາລະນາຢ່າງລະມັດລະວັງວ່າທ່ານຕ້ອງການເປີດໃຊ້ງານມັນຫຼືບໍ່."

#, fuzzy
#| msgid ""
#| "You might need to enable force pushing by choosing :ref:`vcs-git-force-"
#| "push` as :ref:`component-vcs`, especially when pushing to a different "
#| "branch."
msgid ""
"You might need to turn on :ref:`force pushing <vcs-git-force-push>` "
"in :ref:`component-vcs_params`, especially when pushing to a different "
"branch."
msgstr ""
"ທ່ານອາດຈະຈໍາເປັນຕ້ອງເປີດໃຊ້ force pushing ໂດຍການເລືອກ :ref:`vcs-git-force-push` "
"ເປັນ :ref:`component-vcs`, ໂດຍສະເພາະເມື່ອ push ໄປຍັງ branch ອື່ນ."

msgid "Merge"
msgstr "ລວມ (Merge)"

msgid ""
"Upstream repository changes are merged into Weblate one. This setting "
"utilizes fast-forward when possible. This is the safest way, but might "
"produce a lot of merge commits."
msgstr ""
"ການປ່ຽນແປງຂອງ upstream repository ຈະຖືກ merge ເຂົ້າກັບ Weblate. ການຕັ້ງຄ່ານີ້ໃຊ້ fast-"
"forward ເມື່ອເປັນໄປໄດ້. ນີ້ແມ່ນວິທີທີ່ປອດໄພທີ່ສຸດ, ແຕ່ອາດຈະສ້າງ merge commits ຈໍານວນຫຼາຍ."

msgid "Merge without fast-forward"
msgstr "ລວມໂດຍບໍ່ໃຊ້ fast-forward"

msgid ""
"Upstream repository changes are merged into Weblate one with doing a merge "
"commit every time (even when fast-forward would be possible). Every Weblate "
"change will appear as a merge commit in Weblate repository."
msgstr ""
"ການປ່ຽນແປງຂອງ upstream repository ຈະຖືກ merge ເຂົ້າກັບ Weblate ໂດຍການເຮັດ merge "
"commit ທຸກຄັ້ງ (ເຖິງແມ່ນວ່າ fast-forward ຈະສາມາດເຮັດໄດ້ກໍຕາມ). ການປ່ຽນແປງທຸກຢ່າງຂອງ "
"Weblate ຈະປະກົດເປັນ merge commit ໃນ Weblate repository."

msgid "The default value can be changed by :setting:`DEFAULT_MERGE_STYLE`."
msgstr "ຄ່າເລີ່ມຕົ້ນສາມາດປ່ຽນແປງໄດ້ໂດຍ :setting:`DEFAULT_MERGE_STYLE`."

msgid "Message used when committing a translation, see :ref:`markup`."
msgstr "ຂໍ້ຄວາມທີ່ໃຊ້ເມື່ອ commit ການແປ, ເບິ່ງ :ref:`markup`."

msgid ""
"The default value can be changed "
"by :setting:`DEFAULT_ADD_MESSAGE`, :setting:`DEFAULT_ADDON_MESSAGE`, :setting:`DEFAULT_COMMIT_MESSAGE`, :setting:`DEFAULT_DELETE_MESSAGE`, :setting:`DEFAULT_MERGE_MESSAGE`, :setting:`DEFAULT_PULL_MESSAGE`."
msgstr "ຄ່າເລີ່ມຕົ້ນສາມາດປ່ຽນແປງໄດ້ໂດຍ :setting:`DEFAULT_ADD_MESSAGE`, :setting:`DEFAULT_ADDON_MESSAGE`, :setting:`DEFAULT_COMMIT_MESSAGE`, :setting:`DEFAULT_DELETE_MESSAGE`, :setting:`DEFAULT_MERGE_MESSAGE`, :setting:`DEFAULT_PULL_MESSAGE`."

msgid "Push on commit"
msgstr "Push ເມື່ອບັນທຶກການປ່ຽນແປງ (Commit)"

msgid ""
"Whether committed changes should be automatically pushed to the upstream "
"repository. When enabled, the push is initiated once Weblate commits changes "
"to its underlying repository (see :ref:`lazy-commit`). To actually enable "
"pushing :guilabel:`Repository push URL` has to be configured as well."
msgstr ""
"ເລືອກວ່າການປ່ຽນແປງທີ່ commit ແລ້ວຄວນຈະຖືກ push ໄປຍັງ upstream repository "
"ໂດຍອັດຕະໂນມັດຫຼືບໍ່. ເມື່ອເປີດໃຊ້ງານ, ການ push ຈະເລີ່ມຕົ້ນເມື່ອ Weblate commit ການປ່ຽນແປງລົງໃນ "
"repository ພື້ນຖານຂອງມັນ (ເບິ່ງ :ref:`lazy-commit`). ເພື່ອໃຫ້ການ push "
"ເຮັດວຽກໄດ້ຈິງ, :guilabel:`Repository push URL` ຈະຕ້ອງຖືກຕັ້ງຄ່າໄວ້ດ້ວຍ."

msgid "Age of changes to commit"
msgstr "ອາຍຸຂອງການປ່ຽນແປງທີ່ຈະ commit"

msgid ""
"Sets how old (in hours) changes have to be before they are committed by "
"background task or the :wladmin:`commit_pending` management command. All "
"changes in a component are committed once there is at least one change older "
"than this period."
msgstr ""
"ກໍານົດວ່າການປ່ຽນແປງຕ້ອງມີອາຍຸເທົ່າໃດ (ເປັນຊົ່ວໂມງ) ກ່ອນທີ່ພວກມັນຈະຖືກ commit ໂດຍ task ພື້ນຫຼັງ ຫຼື "
"ຄໍາສັ່ງຈັດການ :wladmin:`commit_pending`. ການປ່ຽນແປງທັງໝົດໃນ component ຈະຖືກ commit "
"ເມື່ອມີການປ່ຽນແປງຢ່າງໜ້ອຍໜຶ່ງອັນທີ່ມີອາຍຸເກີນໄລຍະເວລານີ້."

msgid "The default value can be changed by :setting:`COMMIT_PENDING_HOURS`."
msgstr "ຄ່າເລີ່ມຕົ້ນສາມາດປ່ຽນແປງໄດ້ໂດຍ :setting:`COMMIT_PENDING_HOURS`."

msgid ""
"There are other situations where pending changes might be committed, "
"see :ref:`lazy-commit`."
msgstr "ຍັງມີສະຖານະການອື່ນທີ່ການປ່ຽນແປງທີ່ຄ້າງໄວ້ອາດຈະຖືກ commit, ເບິ່ງ :ref:`lazy-commit`."

msgid "Lock on error"
msgstr "ລັອກເມື່ອເກີດຂໍ້ຜິດພາດ"

msgid ""
"Locks the component (and linked components, see :ref:`internal-urls`) upon "
"the first failed push or merge into its upstream repository, or pull from "
"it. This avoids adding another conflicts, which would have to be resolved "
"manually."
msgstr ""
"ລັອກ component (ແລະ component ທີ່ເຊື່ອມຕໍ່ກັນ, ເບິ່ງ :ref:`internal-urls`) ໃນທັນທີທີ່ການ "
"push ຫຼື merge ໄປຍັງ upstream repository ຄັ້ງທໍາອິດລົ້ມເຫຼວ, ຫຼື ການ pull ຈາກມັນລົ້ມເຫຼວ. "
"ສິ່ງນີ້ຈະປ້ອງກັນການເພີ່ມຂໍ້ຂັດແຍ່ງ (conflicts) ໃໝ່, ເຊິ່ງຈະຕ້ອງໄດ້ຮັບການແກ້ໄຂດ້ວຍຕົນເອງ."

msgid ""
"The component will be automatically unlocked once there are no repository "
"errors left."
msgstr "Component ຈະຖືກປົດລັອກໂດຍອັດຕະໂນມັດເມື່ອບໍ່ມີຂໍ້ຜິດພາດຂອງ repository ເຫຼືອຢູ່."

msgid "Source language"
msgstr "ພາສາຕົ້ນທາງ"

msgid ""
"Language used for source strings. Change this if you are translating from "
"something else than English."
msgstr "ພາສາທີ່ໃຊ້ສໍາລັບ source strings. ປ່ຽນສິ່ງນີ້ຖ້າທ່ານກໍາລັງແປຈາກພາສາອື່ນທີ່ບໍ່ແມ່ນພາສາອັງກິດ."

msgid ""
"In case you are translating bilingual files from English, but want to be "
"able to do fixes in the English translation as well, "
"choose :guilabel:`English (Developer)` as a source language to avoid "
"conflict between the name of the source language and the existing "
"translation."
msgstr ""
"ໃນກໍລະນີທີ່ທ່ານກໍາລັງແປໄຟລ໌ສອງພາສາຈາກພາສາອັງກິດ, "
"ແຕ່ຕ້ອງການທີ່ຈະສາມາດແກ້ໄຂການແປພາສາອັງກິດໄດ້ດ້ວຍ, ໃຫ້ເລືອກ :guilabel:`English "
"(Developer)` ເປັນພາສາຕົ້ນສະບັບ ເພື່ອຫຼີກເວັ້ນຂໍ້ຂັດແຍ່ງລະຫວ່າງຊື່ພາສາຕົ້ນສະບັບ ແລະ ການແປທີ່ມີຢູ່."

msgid ""
"For monolingual translations, you can use intermediate translation in this "
"case, see :ref:`component-intermediate`."
msgstr ""
"ສໍາລັບການແປແບບພາສາດຽວ, ທ່ານສາມາດໃຊ້ການແປຂັ້ນກາງໃນກໍລະນີນີ້, ເບິ່ງ :ref:`component-"
"intermediate`."

msgid "Language filter"
msgstr "ຕົວຢັ້ງຢືນພາສາ"

msgid ""
"Regular expression used to filter the translation when scanning for file "
"mask. It can be used to limit the list of languages managed by Weblate."
msgstr ""
"Regular expression ທີ່ໃຊ້ເພື່ອການກັ່ນຕອງການແປເມື່ອສະແກນຫາ file mask. "
"ມັນສາມາດຖືກໃຊ້ເພື່ອຈໍາກັດລາຍການພາສາທີ່ຈັດການໂດຍ Weblate."

msgid "You need to list language codes as they appear in the filename."
msgstr "ທ່ານຈໍາເປັນຕ້ອງລະບຸລະຫັດພາສາຕາມທີ່ພວກມັນປາກົດໃນຊື່ໄຟລ໌."

msgid "Some examples of filtering:"
msgstr "ຕົວຢ່າງບາງສ່ວນຂອງການກັ່ນຕອງ:"

msgid "Filter description"
msgstr "ຄໍາອະທິບາຍຕົວກອງ"

msgid "Regular expression"
msgstr "ເຣກູລາເອັກເພຣດຊັນ"

msgid "Selected languages only"
msgstr "ເລືອກສະເພາະພາສາທີ່ເລືອກ"

msgid "Exclude languages"
msgstr "ຍົກເວັ້ນພາສາ"

msgid "Filter two letter codes only"
msgstr "ກັ່ນຕອງສະເພາະລະຫັດສອງຕົວອັກສອນ"

msgid "Exclude non language files"
msgstr "ຍົກເວັ້ນໄຟລ໌ທີ່ບໍ່ແມ່ນພາສາ"

msgid "Include all files (default)"
msgstr "ລວມທຸກໄຟລ໌ (ຄ່າເລີ່ມຕົ້ນ)"

msgid "Key filter"
msgstr "ຕົວກັ່ນຕອງຄີ"

msgid ""
"A regular expression that is used to filter units by their keys. It displays "
"only those units whose keys match the regular expression that was set as the "
"value of this field."
msgstr ""
"Regular expression ທີ່ໃຊ້ເພື່ອການກັ່ນຕອງ units ຕາມ keys ຂອງພວກມັນ. ມັນຈະສະແດງສະເພາະ "
"units ທີ່ keys ກົງກັບ regular expression ທີ່ຖືກຕັ້ງຄ່າເປັນຄ່າຂອງຊ່ອງນີ້."

msgid "Selected keys only"
msgstr "ເລືອກສະເພາະ keys ທີ່ເລືອກ"

msgid "Exclude app store changelogs"
msgstr "ຍົກເວັ້ນ changelogs ຂອງ app store"

msgid "Filter prefixed strings"
msgstr "ກັ່ນຕອງຂໍ້ຄວາມທີ່ມີຄໍານໍາໜ້າ (prefixed)"

msgid ""
"This filter is only available for components with monolingual file formats."
msgstr "ຕົວກອງນີ້ມີໃຫ້ໃຊ້ສໍາລັບ component ທີ່ມີ format ໄຟລ໌ແບບພາສາດຽວເທົ່ານັ້ນ."

msgid "Variants regular expression"
msgstr "ນິພົດປົກກະຕິຂອງລຸ້ນຍ່ອຍ (Variants)"

msgid ""
"Regular expression used to determine the variants of a string, "
"see :ref:`variants`."
msgstr "Regular expression ທີ່ໃຊ້ເພື່ອລະບຸ variant ຂອງຂໍ້ຄວາມ, ເບິ່ງ :ref:`variants`."

msgid ""
"Most of the fields can be edited by project owners or administrators, in the "
"Weblate interface."
msgstr ""
"ຊ່ອງຂໍ້ມູນສ່ວນໃຫຍ່ສາມາດຖືກແກ້ໄຂໂດຍເຈົ້າຂອງໂຄງການ ຫຼື ຜູ້ດູແລລະບົບ, ໃນໜ້າການໃຊ້ງານຂອງ Weblate."

msgid "This setting can be inherited from the project."
msgstr "ການຕັ້ງຄ່ານີ້ສາມາດຖືກສືບທອດມາຈາກໂຄງການໄດ້."

msgid "Priority"
msgstr "ລຳດັບຄວາມສຳຄັນ"

msgid "Components with higher priority are offered first to translators."
msgstr "ສ່ວນປະກອບທີ່ມີລຳດັບຄວາມສຳຄັນສູງກວ່າຈະຖືກສະເໜີໃຫ້ຜູ້ແປກ່ອນ."

msgid "This now also affects ordering of matched glossary terms."
msgstr "ດຽວນີ້ສິ່ງນີ້ຍັງມີຜົນຕໍ່ການຈັດລໍາດັບຂອງຄໍາສັບທີ່ຈັບຄູ່ໃນ glossary."

msgid "Restricted access"
msgstr "ການເຂົ້າເຖິງແບບຈໍາກັດ"

msgid ""
"On Hosted Weblate, this requires a billing plan which permits private "
"projects."
msgstr "ໃນ Hosted Weblate, ສິ່ງນີ້ຕ້ອງການແຜນການຊຳລະເງິນທີ່ອະນຸຍາດໃຫ້ມີໂຄງການສ່ວນຕົວ."

msgid ""
"By default the component is visible to anybody who has access to the "
"project, even if the person can not perform any changes in the component. "
"This makes it easier to keep translation consistency within the project."
msgstr ""
"ໂດຍເລີ່ມຕົ້ນ, component ຈະເຫັນໄດ້ໂດຍໃຜກໍຕາມທີ່ມີສິດເຂົ້າເຖິງໂຄງການ, "
"ເຖິງແມ່ນວ່າບຸກຄົນນັ້ນຈະບໍ່ສາມາດດໍາເນີນການປ່ຽນແປງໃດໆໃນ component ກໍຕາມ. "
"ສິ່ງນີ້ເຮັດໃຫ້ການຮັກສາຄວາມສອດຄ່ອງຂອງການແປພາຍໃນໂຄງການງ່າຍຂຶ້ນ."

msgid ""
"Restricting access at a component, or component-list level takes over access "
"permission to a component, regardless of project-level permissions. You will "
"have to grant access to it explicitly. This can be done through granting "
"access to a new user group and putting users in it, or using the default "
"`custom` or `private` access control groups."
msgstr ""
"ການຈໍາກັດການເຂົ້າເຖິງໃນລະດັບ component, ຫຼື component-list ຈະເຂົ້າມາແທນທີ່ສິດການເຂົ້າເຖິງ "
"component, ໂດຍບໍ່ຄໍານຶງເຖິງສິດໃນລະດັບໂຄງການ. ທ່ານຈະຕ້ອງໃຫ້ສິດການເຂົ້າເຖິງມັນຢ່າງຈະແຈ້ງ. "
"ສິ່ງນີ້ສາມາດເຮັດໄດ້ໂດຍການໃຫ້ສິດເຂົ້າເຖິງກັບກຸ່ມຜູ້ໃຊ້ໃໝ່ ແລະ ເພີ່ມຜູ້ໃຊ້ເຂົ້າໄປໃນນັ້ນ, ຫຼື "
"ການໃຊ້ກຸ່ມຄວບຄຸມການເຂົ້າເຖິງແບບ `custom` ຫຼື `private` ທີ່ເປັນຄ່າເລີ່ມຕົ້ນ."

msgid ""
"The default value can be changed in :setting:`DEFAULT_RESTRICTED_COMPONENT`."
msgstr "ຄ່າເລີ່ມຕົ້ນສາມາດປ່ຽນແປງໄດ້ໃນ :setting:`DEFAULT_RESTRICTED_COMPONENT`."

msgid ""
"This applies to project admins as well — please ensure you will not lose "
"access to the component after toggling the status."
msgstr ""
"ສິ່ງນີ້ມີຜົນກັບຜູ້ດູແລໂຄງການຄືກັນ — "
"ກະລຸນາກວດສອບໃຫ້ແນ່ໃຈວ່າທ່ານຈະບໍ່ເສຍສິດການເຂົ້າເຖິງສ່ວນປະກອບນີ້ຫຼັງຈາກປ່ຽນສະຖານະ."

msgid ""
"Restricted components do not contribute new entries to :ref:`shared-tm`. "
"Project and workspace translation memory entries attributed to an existing "
"restricted component follow the component restriction. Unattributed legacy "
"entries follow the access rules of their translation memory scope. On Hosted "
"Weblate, shared translation memory and restricted components can not be "
"enabled in the same project."
msgstr ""

msgid "Share in projects"
msgstr "ແບ່ງປັນໃນໂຄງການ"

msgid ""
"You can choose additional projects where the component will be visible. "
"Useful for shared libraries which you use in several projects."
msgstr ""
"ທ່ານສາມາດເລືອກໂຄງການເພີ່ມເຕີມທີ່ component ຈະສະແດງຜົນ. ເປັນປະໂຫຍດສໍາລັບຫໍສະໝຸດທີ່ແບ່ງປັນ "
"(shared libraries) ທີ່ທ່ານໃຊ້ໃນຫຼາຍໂຄງການ."

msgid ""
"Sharing a component doesn't change its access control. It only makes it "
"visible when browsing other projects. Users still need access to the actual "
"component to browse or translate it."
msgstr ""
"ການແບ່ງປັນ component ບໍ່ໄດ້ປ່ຽນແປງການຄວບຄຸມການເຂົ້າເຖິງຂອງມັນ. "
"ມັນພຽງແຕ່ເຮັດໃຫ້ມັນເຫັນໄດ້ເມື່ອເບິ່ງໂຄງການອື່ນ. ຜູ້ຍັງຄົງຕ້ອງການສິດເຂົ້າເຖິງ component ຕົວຈິງເພື່ອເບິ່ງ "
"ຫຼື ແປມັນ."

msgid "Use as a glossary"
msgstr "ໃຊ້ເປັນອະພິທານສັບ"

msgid ""
"Allows using this component as a glossary. Use when you want to manage "
"terminology separately from normal translations."
msgstr ""
"ອະນຸຍາດໃຫ້ໃຊ້ component ນີ້ເປັນ glossary. "
"ໃຊ້ເມື່ອທ່ານຕ້ອງການຈັດການຄໍາສັບຕ່າງໆແຍກຕ່າງຫາກຈາກການແປປົກກະຕິ."

msgid "Glossaries are best for:"
msgstr "Glossaries ດີທີ່ສຸດສໍາລັບ:"

msgid "Ensuring consistent use of terms (e.g., UI labels, product names)."
msgstr "ການຮັບປະກັນການໃຊ້ຄໍາສັບຢ່າງສອດຄ່ອງ (ຕົວຢ່າງ: UI labels, ຊື່ຜະລິດຕະພັນ)."

msgid "Sharing preferred translations across multiple components or projects."
msgstr "ການແບ່ງປັນການແປທີ່ຕ້ອງການໄປທົ່ວຫຼາຍ component ຫຼື ໂຄງການ."

msgid "Supporting translators with definitions and context."
msgstr "ການສະໜັບສະໜູນນັກແປດ້ວຍຄໍານິຍາມ ແລະ ບໍລິບົດ."

msgid ""
"Glossaries are not for regular translations—they are for managing terms only."
msgstr "Glossaries ບໍ່ແມ່ນສໍາລັບການແປປົກກະຕິ - ພວກມັນມີໄວ້ສໍາລັບການຈັດການຄໍາສັບເທົ່ານັ້ນ."

msgid ""
"You can configure how it will be listed using :ref:`component-"
"glossary_color`."
msgstr "ທ່ານສາມາດຕັ້ງຄ່າວິທີການສະແດງລາຍການໂດຍໃຊ້ :ref:`component-glossary_color`."

msgid ""
"The glossary will be accessible in all projects defined by :ref:`component-"
"links`."
msgstr "Glossary ຈະສາມາດເຂົ້າເຖິງໄດ້ໃນທຸກໂຄງການທີ່ກໍານົດໂດຍ :ref:`component-links`."

msgid ""
"It is recommended to enable :ref:`component-manage_units` on glossaries in "
"order to allow adding new words to them."
msgstr ""
"ແນະນໍາໃຫ້ເປີດໃຊ້ :ref:`component-manage_units` ໃນ glossaries "
"ເພື່ອອະນຸຍາດໃຫ້ເພີ່ມຄໍາສັບໃໝ່ເຂົ້າໄປໃນພວກມັນ."

msgid "Glossary color"
msgstr "ສີອະພິທານສັບ"

msgid ""
"Color used when displaying terms from this glossary. Useful to distinguish "
"glossaries when using more of them."
msgstr ""
"ສີທີ່ໃຊ້ເມື່ອສະແດງຄໍາສັບຈາກ glossary ນີ້. ເປັນປະໂຫຍດໃນການຈໍາແນກ glossaries ເມື່ອໃຊ້ຫຼາຍອັນ."

msgid "Category"
msgstr "ໝວດໝູ່"

msgid ""
"Categories are there to give structure to components within a project. You "
"can nest them to achieve a more complex structure."
msgstr ""
"ໝວດໝູ່ມີໄວ້ເພື່ອໃຫ້ໂຄງສ້າງກັບ components ພາຍໃນໂຄງການ. "
"ທ່ານສາມາດຊ້ອນພວກມັນໄວ້ເພື່ອໃຫ້ໄດ້ໂຄງສ້າງທີ່ຊັບຊ້ອນຍິ່ງຂຶ້ນ."

msgid "Category settings"
msgstr "ການຕັ້ງຄ່າໝວດໝູ່"

msgid ""
"Categories can override the same inherited settings as projects and "
"components, including translation license, contributor agreement, adding new "
"translations, secondary language, translation flags, and commit messages."
msgstr ""
"ໝວດໝູ່ສາມາດ override ການຕັ້ງຄ່າທີ່ສືບທອດມາໄດ້ຄືກັນກັບໂຄງການ ແລະ components, "
"ລວມທັງໃບອະນຸຍາດການແປ, ຂໍ້ຕົກລົງຜູ້ປະກອບສ່ວນ, ການເພີ່ມການແປໃໝ່, ພາສາຮອງ, ທຸງການແປ, ແລະ "
"ຂໍ້ຄວາມ commit."

msgid ""
"Nested categories inherit from their parent category by default. Top-level "
"categories inherit from the project. Components in a category inherit from "
"that category by default."
msgstr ""
"ໝວດໝູ່ທີ່ຖືກຊ້ອນຈະສືບທອດຈາກໝວດໝູ່ແມ່ໂດຍເລີ່ມຕົ້ນ. ໝວດໝູ່ລະດັບສູງສຸດຈະສືບທອດຈາກໂຄງການ. Components "
"ໃນໝວດໝູ່ຈະສືບທອດຈາກໝວດໝູ່ນັ້ນໂດຍເລີ່ມຕົ້ນ."

msgid "Template markup"
msgstr "Template markup"

msgid ""
"Weblate uses simple markup language in several places where text rendering "
"is needed. It is based on :doc:`django:ref/templates/language`, so it can be "
"quite powerful."
msgstr ""
"Weblate ໃຊ້ພາສາ markup ງ່າຍໆໃນຫຼາຍບ່ອນທີ່ຕ້ອງການການສະແດງຜົນຂໍ້ຄວາມ. "
"ມັນອີງໃສ່ :doc:`django:ref/templates/language`, ດັ່ງນັ້ນມັນຈຶ່ງມີປະສິດທິພາບຫຼາຍ."

msgid "Currently it is used in:"
msgstr "ປັດຈຸບັນມັນຖືກໃຊ້ໃນ:"

msgid "Commit message formatting, see :ref:`component`"
msgstr "ການຈັດຮູບແບບຂໍ້ຄວາມ Commit, ເບິ່ງ :ref:`component`"

msgid "Several add-ons"
msgstr "Add-ons ຫຼາຍຢ່າງ"

msgid "The following variables are available in the component templates:"
msgstr "ຕົວແປຕໍ່ໄປນີ້ສາມາດໃຊ້ໄດ້ໃນ component templates:"

msgid "Project slug"
msgstr "Project slug"

msgid "Translation URL"
msgstr "URL ການແປ"

msgid "Translation filename"
msgstr "ຊື່ໄຟລ໌ຄຳແປ"

msgid "Translation stats, this has further attributes, examples below."
msgstr "ສະຖິຕິການແປ, ສິ່ງນີ້ມີຄຸນລັກສະນະເພີ່ມເຕີມ, ຕົວຢ່າງຢູ່ດ້ານລຸ່ມ."

msgid "Total strings count"
msgstr "ຈໍານວນຂໍ້ຄວາມທັງໝົດ"

msgid "Count of strings needing review"
msgstr "ຈໍານວນຂໍ້ຄວາມທີ່ຕ້ອງການກວດສອບ"

msgid "Percent of strings needing review"
msgstr "ເປີເຊັນຂອງຂໍ້ຄວາມທີ່ຕ້ອງການກວດສອບ"

msgid "Translated strings count"
msgstr "ຈໍານວນຂໍ້ຄວາມທີ່ແປແລ້ວ"

msgid "Translated strings percent"
msgstr "ເປີເຊັນຂອງຂໍ້ຄວາມທີ່ແປແລ້ວ"

msgid "Number of strings with failing checks"
msgstr "ຈໍານວນຂໍ້ຄວາມທີ່ການກວດສອບລົ້ມເຫຼວ"

msgid "Percent of strings with failing checks"
msgstr "ເປີເຊັນຂອງຂໍ້ຄວາມທີ່ການກວດສອບລົ້ມເຫຼວ"

msgid "Author of current commit, available only in the commit scope."
msgstr "ຜູ້ຂຽນຂອງ commit ປັດຈຸບັນ, ໃຊ້ໄດ້ໃນຂອບເຂດ commit ເທົ່ານັ້ນ."

msgid ""
"Name of currently executed add-on, available only in the add-on commit "
"message."
msgstr "ຊື່ຂອງ add-on ທີ່ກໍາລັງເຮັດວຽກຢູ່, ໃຊ້ໄດ້ໃນຂໍ້ຄວາມ commit ຂອງ add-on ເທົ່ານັ້ນ."

msgid ""
"The following variables are available in the repository browser or editor "
"templates:"
msgstr "ຕົວແປຕໍ່ໄປນີ້ສາມາດໃຊ້ໄດ້ໃນ repository browser ຫຼື editor templates:"

msgid "current branch"
msgstr "branch ປັດຈຸບັນ"

msgid "line in file"
msgstr "ແຖວໃນໄຟລ໌"

msgid ""
"filename, you can also strip leading parts using the ``parentdir`` filter, "
"for example ``{{filename|parentdir}}``"
msgstr ""
"ຊື່ໄຟລ໌, ທ່ານຍັງສາມາດຕັດສ່ວນທາງໜ້າອອກໄດ້ໂດຍໃຊ້ filter ``parentdir``, ຕົວຢ່າງເຊັ່ນ "
"``{{filename|parentdir}}``"

msgid ""
"In some places additional variables can be available, see :ref:`addon-"
"weblate.discovery.discovery`."
msgstr ""
"ໃນບາງບ່ອນອາດມີຕົວແປເພີ່ມເຕີມໃຫ້ໃຊ້, ເບິ່ງ :ref:`addon-weblate.discovery.discovery`."

msgid "You can combine them with filters:"
msgstr "ທ່ານສາມາດລວມພວກມັນເຂົ້າກັບ filters:"

msgid "You can use conditions:"
msgstr "ທ່ານສາມາດໃຊ້ເງື່ອນໄຂຕ່າງໆ:"

msgid "There is additional tag available for replacing characters:"
msgstr "ມີ tag ເພີ່ມເຕີມສໍາລັບການແທນທີ່ຕົວອັກສອນ:"

msgid "You can combine it with filters:"
msgstr "ທ່ານສາມາດລວມມັນເຂົ້າກັບ filters:"

msgid "There are also additional filter to manipulate with filenames:"
msgstr "ຍັງມີ filter ເພີ່ມເຕີມເພື່ອຈັດການກັບຊື່ໄຟລ໌:"

msgid "…and other Django template features."
msgstr "...ແລະ ຄຸນສົມບັດ Django template ອື່ນໆ."

msgid "Importing speed"
msgstr "ຄວາມໄວໃນການນໍາເຂົ້າ"

msgid ""
"Fetching VCS repository and importing translations to Weblate can be a "
"lengthy process, depending on size of your translations. Here are some tips:"
msgstr ""
"ການດຶງ VCS repository ແລະ ການນໍາເຂົ້າການແປເຂົ້າສູ່ Weblate ສາມາດເປັນຂະບວນການທີ່ຍາວນານ, "
"ຂຶ້ນຢູ່ກັບຂະໜາດການແປຂອງທ່ານ. ນີ້ແມ່ນຄໍາແນະນໍາບາງຢ່າງ:"

msgid "Optimize configuration"
msgstr "ປັບແຕ່ງການຕັ້ງຄ່າໃຫ້ເໝາະສົມ"

msgid ""
"The default configuration is useful for testing and debugging Weblate, while "
"for a production setup, you should do some adjustments. Many of them have "
"quite a big impact on performance. Please check :ref:`production` for more "
"details, especially:"
msgstr ""
"ການຕັ້ງຄ່າເລີ່ມຕົ້ນມີປະໂຫຍດສໍາລັບການທົດສອບ ແລະ ການແກ້ໄຂບັນຫາ Weblate, ໃນຂະນະທີ່ການຕັ້ງຄ່າສໍາລັບ "
"production, ທ່ານຄວນປັບປ່ຽນບາງຢ່າງ. ຫຼາຍຢ່າງມີຜົນກະທົບຢ່າງໃຫຍ່ຫຼວງຕໍ່ປະສິດທິພາບ. "
"ກະລຸນາເບິ່ງ :ref:`production` ສໍາລັບລາຍລະອຽດເພີ່ມເຕີມ, ໂດຍສະເພາະ:"

msgid "Configure Celery for executing background tasks (see :ref:`celery`)"
msgstr "ຕັ້ງຄ່າ Celery ສໍາລັບການດໍາເນີນ task ພື້ນຫຼັງ (ເບິ່ງ :ref:`celery`)"

msgid "Check resource limits"
msgstr "ກວດສອບຂີດຈໍາກັດຂອງຊັບພະຍາກອນ"

msgid ""
"If you are importing huge translations or repositories, you might be hit by "
"resource limitations of your server."
msgstr ""
"ຖ້າທ່ານກໍາລັງນໍາເຂົ້າການແປ ຫຼື repositories ຂະໜາດໃຫຍ່, "
"ທ່ານອາດຈະພົບບັນຫາຂີດຈໍາກັດຂອງຊັບພະຍາກອນຂອງເຊີບເວີຂອງທ່ານ."

msgid ""
"Check the amount of free memory, having translation files cached by the "
"operating system will greatly improve performance."
msgstr ""
"ກວດສອບປະລິມານໜ່ວຍຄວາມຈໍາທີ່ຫວ່າງ, ການມີໄຟລ໌ການແປຖືກ cached "
"ໂດຍລະບົບປະຕິບັດການຈະຊ່ວຍປັບປຸງປະສິດທິພາບຢ່າງຫຼວງຫຼາຍ."

msgid ""
"Disk operations might be bottleneck if there is a lot of strings to process—"
"the disk is pushed by both Weblate and the database."
msgstr ""
"ການເຮັດວຽກຂອງດິສກ໌ອາດຈະເປັນຄໍຂວດ (bottleneck) ຖ້າມີຂໍ້ຄວາມຈໍານວນຫຼາຍຕ້ອງປະມວນຜົນ - "
"ດິສກ໌ຈະຖືກນໍາໃຊ້ໂດຍທັງ Weblate ແລະ ຖານຂໍ້ມູນ."

msgid ""
"Additional CPU cores might help improve performance of background tasks "
"(see :ref:`celery`)."
msgstr "CPU cores ເພີ່ມເຕີມອາດຈະຊ່ວຍປັບປຸງປະສິດທິພາບຂອງ task ພື້ນຫຼັງ (ເບິ່ງ :ref:`celery`)."

msgid "Disable unneeded checks"
msgstr "ປິດການກວດສອບທີ່ບໍ່ຈໍາເປັນ"

msgid ""
"Some quality checks can be quite expensive, and if not needed, can save you "
"some time during import if omitted. See :setting:`CHECK_LIST` for info on "
"configuration."
msgstr ""
"ການກວດສອບຄຸນນະພາບບາງຢ່າງອາດຈະໃຊ້ຊັບພະຍາກອນຫຼາຍ, ແລະ ຖ້າບໍ່ຈໍາເປັນ, "
"ການລະເວັ້ນພວກມັນອາດຈະຊ່ວຍໃຫ້ທ່ານປະຢັດເວລາໃນລະຫວ່າງການນໍາເຂົ້າ. "
"ເບິ່ງ :setting:`CHECK_LIST` ສໍາລັບຂໍ້ມູນກ່ຽວກັບການຕັ້ງຄ່າ."

msgid "Automatic creation of components"
msgstr "ການສ້າງ components ໂດຍອັດຕະໂນມັດ"

msgid ""
"In case your project has dozen of translation files (e.g. for different "
"gettext domains, or parts of Android apps), you might want to import them "
"automatically. This can either be achieved from the command-line by "
"using :wladmin:`import_project` or :wladmin:`import_json`, or by installing "
"the :ref:`addon-weblate.discovery.discovery` add-on."
msgstr ""
"ໃນກໍລະນີທີ່ໂຄງການຂອງທ່ານມີໄຟລ໌ການແປຫຼາຍໄຟລ໌ (ຕົວຢ່າງ: ສໍາລັບ gettext domains ທີ່ແຕກຕ່າງກັນ, ຫຼື "
"ສ່ວນຕ່າງໆຂອງແອັບຯ Android), ທ່ານອາດຈະຕ້ອງການນໍາເຂົ້າພວກມັນໂດຍອັດຕະໂນມັດ. "
"ສິ່ງນີ້ສາມາດເຮັດໄດ້ຈາກ command-line ໂດຍການໃຊ້ :wladmin:`import_project` "
"ຫຼື :wladmin:`import_json`, ຫຼື ໂດຍການຕິດຕັ້ງ add-on :ref:`addon-"
"weblate.discovery.discovery`."

msgid ""
"To use the add-on, you first need to create a component for one translation "
"file (choose the one that is the least likely to be renamed or removed in "
"future), and install the add-on on this component."
msgstr ""
"ເພື່ອໃຊ້ add-on, ກ່ອນອື່ນທ່ານຕ້ອງສ້າງ component ສໍາລັບໄຟລ໌ການແປໜຶ່ງໄຟລ໌ "
"(ເລືອກໄຟລ໌ທີ່ມີແນວໂນ້ມໜ້ອຍທີ່ສຸດທີ່ຈະຖືກປ່ຽນຊື່ ຫຼື ລຶບອອກໃນອະນາຄົດ), ແລະ ຕິດຕັ້ງ add-on ໃສ່ "
"component ນັ້ນ."

msgid ""
"For the management commands, you need to create a project which will contain "
"all components and then run :wladmin:`import_project` "
"or :wladmin:`import_json`."
msgstr ""
"ສໍາລັບຄໍາສັ່ງຈັດການ, ທ່ານຕ້ອງສ້າງໂຄງການທີ່ຈະບັນຈຸ components ທັງໝົດ ແລະ "
"ຈາກນັ້ນຮັນຄໍາສັ່ງ :wladmin:`import_project` ຫຼື :wladmin:`import_json`."

msgid "Sample configuration"
msgstr "ຕົວຢ່າງການຕັ້ງຄ່າ"

msgid ""
"The following example is shipped as :file:`weblate/settings_example.py` with "
"Weblate:"
msgstr "ຕົວຢ່າງຕໍ່ໄປນີ້ຖືກສົ່ງມາພ້ອມກັບ :file:`weblate/settings_example.py` ໃນ Weblate:"

msgid "Getting support for Weblate"
msgstr "ການຂໍຮັບການສະໜັບສະໜູນສໍາລັບ Weblate"

msgid ""
"*Weblate* is copylefted libre software with community support. Hosting "
"subscribers receive priority support at no extra charge. Prepaid help "
"packages are available for everyone, including self-hosting users. Find info "
"about current support offerings at https://weblate.org/support."
msgstr ""
"*Weblate* ເປັນຊອບແວເສລີແບບ copylefted ທີ່ມີການສະໜັບສະໜູນຈາກຊຸມຊົນ. ຜູ້ໃຊ້ບໍລິການ Hosting "
"ຈະໄດ້ຮັບການສະໜັບສະໜູນແບບບຸລິມະສິດໂດຍບໍ່ມີຄ່າໃຊ້ຈ່າຍເພີ່ມເຕີມ. "
"ແພັກເກັດການຊ່ວຍເຫຼືອແບບຈ່າຍລ່ວງໜ້າມີໃຫ້ສໍາລັບທຸກຄົນ, ລວມທັງຜູ້ໃຊ້ທີ່ host ດ້ວຍຕົນເອງ. "
"ຄົ້ນຫາຂໍ້ມູນກ່ຽວກັບຂໍ້ສະເໜີການສະໜັບສະໜູນໃນປັດຈຸບັນໄດ້ທີ່ https://weblate.org/support."

msgid "Integrating support"
msgstr "ການເຊື່ອມໂຍງການສະໜັບສະໜູນ"

msgid ""
"Purchased support packages can optionally be integrated into your Weblate "
"`subscription management <https://weblate.org/user/>`_ interface, from where "
"you will find a link to it. Basic instance details about your installation "
"are also reported back to Weblate this way."
msgstr ""
"ແພັກເກັດການສະໜັບສະໜູນທີ່ຊື້ແລ້ວສາມາດເລືອກເຊື່ອມໂຍງເຂົ້າກັບອິນເຕີເຟດ `subscription management "
"<https://weblate.org/user/>`_ ຂອງ Weblate ຂອງທ່ານໄດ້, ເຊິ່ງທ່ານຈະພົບລິ້ງໄປຫາສິ່ງນັ້ນ. "
"ລາຍລະອຽດພື້ນຖານຂອງ instance ກ່ຽວກັບການຕິດຕັ້ງຂອງທ່ານຍັງຈະຖືກລາຍງານກັບໄປຫາ Weblate "
"ດ້ວຍວິທີນີ້."

msgid "Info sent to the Weblate"
msgstr "ຂໍ້ມູນທີ່ສົ່ງໄປຫາ Weblate"

msgid "Your Weblate instance URL"
msgstr "URL Weblate instance ຂອງທ່ານ"

msgid "Its site title"
msgstr "ຊື່ເວັບໄຊຕ໌"

msgid "The version you are running"
msgstr "ເວີຊັນທີ່ທ່ານກໍາລັງໃຊ້"

msgid "Tallies of projects, components, languages, source strings, and users"
msgstr "ຈໍານວນໂຄງການ, components, ພາສາ, ຂໍ້ຄວາມຕົ້ນສະບັບ, ແລະ ຜູ້ໃຊ້"

msgid "The public SSH key of your instance"
msgstr "SSH key ສາທາລະນະຂອງ instance ຂອງທ່ານ"

msgid "Additionally, if you turn on :ref:`discover-weblate`:"
msgstr "ນອກຈາກນີ້, ຖ້າທ່ານເປີດໃຊ້ :ref:`discover-weblate`:"

msgid "List of public and protected projects (name, URL, and website)."
msgstr "ລາຍຊື່ຂອງໂຄງການສາທາລະນະ ແລະ ໂຄງການທີ່ຖືກປ້ອງກັນ (ຊື່, URL, ແລະ ເວັບໄຊ)."

msgid ""
"Check what *Discover* shows publicly in the :ref:`discover-weblate` "
"description."
msgstr ""
"ກວດສອບສິ່ງທີ່ *Discover* ສະແດງຢ່າງສາທາລະນະໃນຄໍາອະທິບາຍ :ref:`discover-weblate`."

msgid "No other data is submitted."
msgstr "ບໍ່ມີຂໍ້ມູນອື່ນທີ່ຖືກສົ່ງໄປ."

msgid "Integration services"
msgstr "ບໍລິການການເຊື່ອມໂຍງ"

msgid "See if your support package is still valid"
msgstr "ກວດສອບວ່າແພັກເກັດການສະໜັບສະໜູນຂອງທ່ານຍັງມີຜົນບັງຄັບໃຊ້ຢູ່ຫຼືບໍ່"

msgid ""
"Purchased support packages are already activated upon purchase and can be "
"used without integrating them."
msgstr ""
"ແພັກເກັດການສະໜັບສະໜູນທີ່ຊື້ແລ້ວຈະຖືກເປີດໃຊ້ງານທັນທີເມື່ອຊື້ ແລະ "
"ສາມາດໃຊ້ໄດ້ໂດຍບໍ່ຈໍາເປັນຕ້ອງເຊື່ອມໂຍງພວກມັນ."

msgid "Contacting customer care"
msgstr "ການຕິດຕໍ່ຝ່າຍບໍລິການລູກຄ້າ"

msgid ""
"If you do not have a support package yet, please refer to the :doc:`/"
"contributing/issues` section for available community resources."
msgstr ""
"ຖ້າທ່ານຍັງບໍ່ມີແພັກເກັດການສະໜັບສະໜູນ, ກະລຸນາເບິ່ງພາກ :doc:`/contributing/issues` "
"ສໍາລັບຊັບພະຍາກອນຊຸມຊົນທີ່ມີຢູ່."

msgid ""
"Subscribers can reach Weblate Care directly through the following channels:"
msgstr "ຜູ້ສະໝັກໃຊ້ສາມາດຕິດຕໍ່ Weblate Care ໄດ້ໂດຍກົງຜ່ານຊ່ອງທາງຕໍ່ໄປນີ້:"

msgid "Email support at care@weblate.org."
msgstr "ອີເມວສະໜັບສະໜູນທີ່ care@weblate.org."

msgid "The `customer care portal <https://care.weblate.org/>`_"
msgstr "`customer care portal <https://care.weblate.org/>`_"

msgid ""
"The support form is available in the Weblate management interface "
"after :ref:`activate-support`."
msgstr ""
"ແບບຟອມການສະໜັບສະໜູນມີໃຫ້ໃຊ້ໃນອິນເຕີເຟດການຈັດການ Weblate ຫຼັງຈາກ :ref:`activate-"
"support`."

msgid ""
"A subscription ensures timely and reliable help with setup, maintenance, and "
"troubleshooting."
msgstr ""
"ການສະໝັກໃຊ້ຮັບປະກັນຄວາມຊ່ວຍເຫຼືອທີ່ທັນເວລາ ແລະ ເຊື່ອຖືໄດ້ໃນການຕິດຕັ້ງ, ການບໍາລຸງຮັກສາ, ແລະ "
"ການແກ້ໄຂບັນຫາ."

msgid "**Sending encrypted content**"
msgstr "**ການສົ່ງເນື້ອຫາທີ່ເຂົ້າລະຫັດ**"

msgid ""
"If you want to send an encrypted content, please use the public key for "
"care@weblate.org with ID ``0961 62CE 141D 7FE4 B15D A9FA 73D9 298A CB26 "
"03F0``."
msgstr ""
"ຖ້າທ່ານຕ້ອງການສົ່ງເນື້ອຫາທີ່ເຂົ້າລະຫັດ, ກະລຸນາໃຊ້ public key ສໍາລັບ care@weblate.org ທີ່ມີ ID "
"``0961 62CE 141D 7FE4 B15D A9FA 73D9 298A CB26 03F0``."

msgid ""
"This public key is available on the most commonly used key servers, using "
"WKD or `directly from weblate.org <https://weblate.org/.well-known/"
"openpgpkey/hu/7oq6zfqsndhzsmw94xm1e5yu8me8sjsx?l=care>`_."
msgstr ""
"ກະແຈສາທາລະນະນີ້ມີຢູ່ເທິງເຊີບເວີກະແຈທີ່ໃຊ້ກັນທົ່ວໄປ, ໂດຍໃຊ້ WKD ຫຼື ໂດຍກົງຈາກ weblate.org "
"<https://weblate.org/.well-known/openpgpkey/hu/"
"7oq6zfqsndhzsmw94xm1e5yu8me8sjsx?l=care>."

msgid "Discover Weblate"
msgstr "ຄົ້ນພົບ Weblate"

msgid ""
"*Discover* is an opt-in service making it easier for translators to find "
"other Weblate instances and communities. Users can browse registered sites "
"and find projects to contribute to on https://weblate.org/discover/."
msgstr ""
"*Discover* ເປັນບໍລິການທີ່ເລືອກເປີດໃຊ້ໄດ້ ເຊິ່ງເຮັດໃຫ້ນັກແປສາມາດຊອກຫາ Weblate instances ແລະ "
"ຊຸມຊົນອື່ນໆໄດ້ງ່າຍຂຶ້ນ. ຜູ້ໃຊ້ສາມາດເບິ່ງເວັບໄຊຕ໌ທີ່ລົງທະບຽນໄວ້ ແລະ ຊອກຫາໂຄງການເພື່ອປະກອບສ່ວນໄດ້ທີ່ "
"https://weblate.org/discover/."

msgid "Getting listed"
msgstr "ການຖືກລະບຸໃນລາຍການ"

msgid ""
"Discover Weblate registration can be started directly from the management "
"interface without manually copying the activation token."
msgstr ""
"ການລົງທະບຽນ Discover Weblate ສາມາດເລີ່ມຕົ້ນໄດ້ໂດຍກົງຈາກໜ້າການຈັດການ ໂດຍບໍ່ຕ້ອງຄັດລອກ "
"activation token ດ້ວຍຕົນເອງ."

msgid ""
"Make sure you are OK with publishing your instance name, URL, tally of "
"projects, components, and users, together with names of public and protected "
"projects for use on *Discover*."
msgstr ""
"ກະລຸນາກວດສອບໃຫ້ແນ່ໃຈວ່າທ່ານຍິນດີທີ່ຈະເຜີຍແຜ່ຊື່ instance ຂອງທ່ານ, URL, ຈຳນວນໂຄງການ, "
"ສ່ວນປະກອບ, ແລະ ຜູ້ໃຊ້, ພ້ອມທັງຊື່ຂອງໂຄງການສາທາລະນະ ແລະ ໂຄງການທີ່ຖືກປ້ອງກັນ ເພື່ອໃຊ້ໃນໜ້າ "
"*Discover*."

msgid ""
"Use the :guilabel:`Discover Weblate` panel in the management interface to "
"manage the listing. If you have an activated support package, list your "
"server by clicking :guilabel:`Enable discovery`. If the instance is not "
"connected to weblate.org yet, start the registration by "
"clicking :guilabel:`Enable Discover Weblate`:"
msgstr ""
"ໃຊ້ແຜງ :guilabel:`Discover Weblate` ໃນສ່ວນຕິດຕໍ່ການຈັດການເພື່ອຈັດການລາຍຊື່. "
"ຫາກທ່ານມີແພັກເກັດການຊ່ວຍເຫຼືອທີ່ເປີດໃຊ້ແລ້ວ, "
"ໃຫ້ສະແດງລາຍຊື່ເຊີເວີຂອງທ່ານໂດຍການຄລິກ :guilabel:`Enable discovery`. "
"ຫາກອິນສະແຕນຊ໌ຍັງບໍ່ທັນເຊື່ອມຕໍ່ກັບ weblate.org, "
"ໃຫ້ເລີ່ມການລົງທະບຽນໂດຍການຄລິກ :guilabel:`Enable Discover Weblate`:"

msgid ""
"This opens the registration form on weblate.org and returns to your Weblate "
"management interface to complete activation with discovery already enabled. "
"The registration flow can be used from an account that has a support "
"subscription, but it registers the Discover Weblate listing; activating a "
"purchased support package is handled by :ref:`activate-support`. Unlinking "
"the support package disables the Discover Weblate listing."
msgstr ""
"ສິ່ງນີ້ຈະເປີດແບບຟອມການລົງທະບຽນໃນ weblate.org ແລະ ກັບຄືນໄປຍັງສ່ວນຕິດຕໍ່ການຈັດການ Weblate "
"ຂອງທ່ານເພື່ອເຮັດໃຫ້ການເປີດໃຊ້ງານສຳເລັດໂດຍທີ່ການຄົ້ນພົບ (discovery) ຖືກເປີດໃຊ້ງານແລ້ວ. "
"ຂັ້ນຕອນການລົງທະບຽນສາມາດໃຊ້ໄດ້ຈາກບັນຊີທີ່ມີການສະໝັກສະມາຊິກການຊ່ວຍເຫຼືອ, ແຕ່ມັນຈະລົງທະບຽນລາຍຊື່ "
"Discover Weblate; ການເປີດໃຊ້ແພັກເກັດການຊ່ວຍເຫຼືອທີ່ຊື້ແລ້ວແມ່ນຈະຖືກຈັດການໂດຍ :ref:`activate-"
"support`. ການຍົກເລີກການເຊື່ອມຕໍ່ແພັກເກັດການຊ່ວຍເຫຼືອຈະປິດການໃຊ້ງານລາຍຊື່ Discover Weblate."

msgid ""
"All steps for listing a server manually, for example from older Weblate "
"versions:"
msgstr "ທຸກຂັ້ນຕອນສຳລັບການລົງລາຍຊື່ເຊີເວີດ້ວຍຕົນເອງ, ຕົວຢ່າງຈາກ Weblate ເວີຊັນເກົ່າ:"

msgid "Register yourself at https://weblate.org/user/"
msgstr "ລົງທະບຽນຕົວເອງທີ່ https://weblate.org/user/"

msgid ""
"Register your Weblate site at https://weblate.org/subscription/discovery/"
msgstr ""
"ລົງທະບຽນເວັບໄຊຕ໌ Weblate ຂອງທ່ານທີ່ https://weblate.org/subscription/discovery/"

msgid "Copy the activation token into your Weblate management interface."
msgstr ""
"ຄັດລອກໂທເຄັນການເປີດໃຊ້ງານ (activation token) ໄປໃສ່ໃນສ່ວນຕິດຕໍ່ການຈັດການ Weblate ຂອງທ່ານ."

msgid ""
"Confirm you want your Weblate listed by clicking :guilabel:`Enable "
"discovery` from the :guilabel:`Discover Weblate` panel:"
msgstr ""
"ຢືນຢັນວ່າເຈົ້າຕ້ອງການໃຫ້ Weblate ຂອງເຈົ້າຢູ່ໃນລາຍຊື່ ໂດຍການຄລິກ :guilabel:`ເປີດໃຊ້ການຄົ້ນພົບ` "
"ຈາກແຜງ :guilabel:`Discover Weblate`:"

msgid "Listing customization"
msgstr "ການປັບແຕ່ງລາຍການ"

msgid ""
"You are encouraged to provide an image (570 x 260 pixels) and description of "
"your Weblate site at https://weblate.org/user/. This improves your "
"instance’s visibility in the list."
msgstr ""
"ທ່ານໄດ້ຮັບການຊຸກຍູ້ໃຫ້ຈັດຫາຮູບພາບ (570 x 260 ພິກເຊວ) ແລະ ຄໍາອະທິບາຍກ່ຽວກັບເວັບໄຊຕ໌ Weblate "
"ຂອງທ່ານທີ່ https://weblate.org/user/. ສິ່ງນີ້ຈະປັບປຸງການເບິ່ງເຫັນ instance "
"ຂອງທ່ານໃນລາຍການ."

msgid "Translation process"
msgstr "ຂະບວນການແປ"

msgid ""
"Everyone can add suggestions by default, to be accepted by signed in users. "
"Suggestion voting can be used to make use of a string when more than one "
"signed-in user agrees, by setting up the :ref:`component` "
"with :guilabel:`Suggestion voting` to turn on voting, "
"and :guilabel:`Automatically accept suggestions` to set a threshold for "
"accepted suggestions (this includes a vote from the user making the "
"suggestion if it is cast)."
msgstr ""
"ທຸກຄົນສາມາດເພີ່ມຄໍາແນະນໍາໄດ້ໂດຍເລີ່ມຕົ້ນ, ເພື່ອໃຫ້ຜູ້ໃຊ້ທີ່ລັອກອິນຍອມຮັບ. "
"ການລົງຄະແນນສຽງສໍາລັບຄໍາແນະນໍາສາມາດຖືກໃຊ້ເພື່ອໃຊ້ງານຂໍ້ຄວາມເມື່ອມີຜູ້ໃຊ້ທີ່ລັອກອິນຫຼາຍກວ່າໜຶ່ງຄົນເຫັນດີ, "
"ໂດຍການຕັ້ງຄ່າ :ref:`component` ດ້ວຍ :guilabel:`Suggestion voting` "
"ເພື່ອເປີດໃຊ້ການລົງຄະແນນ, ແລະ :guilabel:`Automatically accept suggestions` "
"ເພື່ອກໍານົດເກນສໍາລັບຄໍາແນະນໍາທີ່ຍອມຮັບ "
"(ນີ້ລວມເຖິງຄະແນນສຽງຈາກຜູ້ໃຊ້ທີ່ສ້າງຄໍາແນະນໍານັ້ນຫາກໄດ້ມີການລົງຄະແນນ)."

msgid ""
"Once automatic acceptance is set up, normal users lose the privilege to "
"directly save translations or accept suggestions. This can be overridden "
"with the :guilabel:`Edit string when suggestions are "
"enforced` :ref:`permission <privileges>`."
msgstr ""
"ເມື່ອການຍອມຮັບອັດຕະໂນມັດຖືກຕັ້ງຄ່າແລ້ວ, ຜູ້ໃຊ້ປົກກະຕິຈະເສຍສິດພິເສດໃນການບັນທຶກການແປໂດຍກົງ ຫຼື "
"ຍອມຮັບຄໍາແນະນໍາ. ສິ່ງນີ້ສາມາດຖືກ override ໄດ້ດ້ວຍ :ref:`permission "
"<privileges>` :guilabel:`Edit string when suggestions are enforced`."

msgid ""
"You can combine these with :ref:`access control <access-control>` into one "
"of the following setups:"
msgstr ""
"ທ່ານສາມາດລວມສິ່ງເຫຼົ່ານີ້ເຂົ້າກັບ :ref:`access control <access-control>` "
"ເພື່ອເປັນໜຶ່ງໃນການຕັ້ງຄ່າດັ່ງຕໍ່ໄປນີ້:"

msgid ""
"Users suggest and vote for suggestions and a limited group controls what is "
"accepted."
msgstr "ຜູ້ໃຊ້ແນະນໍາ ແລະ ລົງຄະແນນສຽງໃຫ້ຄໍາແນະນໍາ ແລະ ກຸ່ມຈໍາກັດຄວບຄຸມສິ່ງທີ່ຖືກຍອມຮັບ."

msgid "Turn on voting."
msgstr "ເປີດໃຊ້ການລົງຄະແນນ."

msgid "Turn off automatic acceptance."
msgstr "ປິດການຍອມຮັບອັດຕະໂນມັດ."

msgid "Don't let users save translations."
msgstr "ຢ່າໃຫ້ຜູ້ໃຊ້ບັນທຶກການແປ."

msgid ""
"Users suggest and vote for suggestions with automatic acceptance once the "
"defined number of them agree."
msgstr ""
"ຜູ້ໃຊ້ແນະນໍາ ແລະ ລົງຄະແນນສຽງໃຫ້ຄໍາແນະນໍາພ້ອມດ້ວຍການຍອມຮັບອັດຕະໂນມັດເມື່ອມີຈໍານວນຜູ້ເຫັນດີຕາມທີ່ກໍານົດ."

msgid "Set the desired number of votes for automatic acceptance."
msgstr "ກໍານົດຈໍານວນຄະແນນສຽງທີ່ຕ້ອງການສໍາລັບການຍອມຮັບອັດຕະໂນມັດ."

msgid ""
"Optional voting for suggestions. (Can optionally be used by users when they "
"are unsure about a translation by making multiple suggestions.)"
msgstr ""
"ການລົງຄະແນນສຽງທາງເລືອກສໍາລັບຄໍາແນະນໍາ. "
"(ສາມາດໃຊ້ໂດຍຜູ້ໃຊ້ເມື່ອພວກເຂົາບໍ່ແນ່ໃຈກ່ຽວກັບການແປໂດຍການສ້າງຄໍາແນະນໍາຫຼາຍອັນ.)"

msgid "Only turn on voting."
msgstr "ເປີດໃຊ້ສະເພາະການລົງຄະແນນ."

msgid "Additional info on source strings"
msgstr "ຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບຂໍ້ຄວາມຕົ້ນສະບັບ"

msgid ""
"Enhance the translation process by adding additional info to the strings "
"including explanations, string priorities, check flags and visual context. "
"Some of that info may be extracted from the translation files and some may "
"be added by editing the additional string info:"
msgstr ""
"ປັບປຸງຂະບວນການແປໂດຍການເພີ່ມຂໍ້ມູນເພີ່ມເຕີມໃຫ້ກັບຂໍ້ຄວາມ ລວມທັງຄໍາອະທິບາຍ, ຄວາມສໍາຄັນຂອງຂໍ້ຄວາມ, "
"ທຸງການກວດສອບ ແລະ ບໍລິບົດທາງສາຍຕາ. ຂໍ້ມູນບາງຢ່າງອາດຖືກສະກັດອອກຈາກໄຟລ໌ການແປ ແລະ "
"ບາງຢ່າງອາດຖືກເພີ່ມໂດຍການແກ້ໄຂຂໍ້ມູນຂໍ້ຄວາມເພີ່ມເຕີມ:"

msgid ""
"Access this directly from the translation interface by clicking the \"Edit\" "
"icon next to :guilabel:`Screenshot context` or :guilabel:`Flags`."
msgstr ""
"ເຂົ້າເຖິງສິ່ງນີ້ໂດຍກົງຈາກອິນເຕີເຟດການແປໂດຍການຄລິກໄອຄອນ \"Edit\" "
"ຂ້າງ :guilabel:`Screenshot context` ຫຼື :guilabel:`Flags`."

msgid "Strings prioritization"
msgstr "ການຈັດລໍາດັບຄວາມສໍາຄັນຂອງຂໍ້ຄວາມ"

msgid ""
"String priority can be changed to offer higher priority strings for "
"translation earlier by using the ``priority`` flag."
msgstr ""
"ຄວາມສໍາຄັນຂອງຂໍ້ຄວາມສາມາດປ່ຽນແປງໄດ້ເພື່ອໃຫ້ຂໍ້ຄວາມທີ່ມີຄວາມສໍາຄັນສູງກວ່າໄດ້ຮັບການແປກ່ອນໂດຍການໃຊ້ທຸງ "
"``priority``."

msgid "This can be used to order the flow of translation in a logical manner."
msgstr "ສິ່ງນີ້ສາມາດໃຊ້ເພື່ອຈັດລໍາດັບການໄຫຼວຽນຂອງການແປຢ່າງມີເຫດຜົນ."

msgid ""
"The string flags are also inherited from the :ref:`component-check_flags` "
"at :ref:`component` and flags from the translation file (see :doc:`/"
"formats`)."
msgstr ""
"ທຸງຂອງຂໍ້ຄວາມຍັງຖືກສືບທອດມາຈາກ :ref:`component-check_flags` ທີ່ :ref:`component` ແລະ "
"ທຸງຈາກໄຟລ໌ການແປ (ເບິ່ງ :doc:`/formats`)."

msgid "Explanation"
msgstr "ຄຳອະທິບາຍ"

msgid "In previous versions this has been called :guilabel:`Extra context`."
msgstr "ໃນເວີຊັນກ່ອນໜ້ານີ້ ສິ່ງນີ້ຖືກເອີ້ນວ່າ :guilabel:`Extra context`."

msgid "Support for syncing explanation with a file was introduced."
msgstr "ການຮອງຮັບການຊິງຄ໌ (sync) ຄໍາອະທິບາຍກັບໄຟລ໌ໄດ້ຖືກນໍາສະເໜີ."

msgid ""
"Use the explanation to clarify scope or usage of the translation. You can "
"use Markdown to include links and other markup."
msgstr ""
"ໃຊ້ຄໍາອະທິບາຍເພື່ອເຮັດໃຫ້ຂອບເຂດ ຫຼື ການນໍາໃຊ້ການແປມີຄວາມຊັດເຈນ. ທ່ານສາມາດໃຊ້ Markdown "
"ເພື່ອລວມລິ້ງ ແລະ markup ອື່ນໆ."

msgid ""
"Some file formats support storing explanation within the file, "
"see :ref:`format-explanation`."
msgstr ""
"ບາງ format ໄຟລ໌ຮອງຮັບການຈັດເກັບຄໍາອະທິບາຍໄວ້ພາຍໃນໄຟລ໌, ເບິ່ງ :ref:`format-explanation`."

msgid ""
"Weblate can also display description present in the translation file for "
"some formats, see :ref:`format-description`."
msgstr ""
"Weblate ຍັງສາມາດສະແດງຄໍາອະທິບາຍທີ່ມີໃນໄຟລ໌ການແປສໍາລັບບາງ format, ເບິ່ງ :ref:`format-"
"description`."

msgid "Screenshots and visual context"
msgstr "ພາບໜ້າຈໍ ແລະ ບໍລິບົດທາງສາຍຕາ"

msgid ""
"You can upload a screenshot showing a given source string in use within your "
"program. This helps translators understand where it is used, and how it "
"should be translated."
msgstr ""
"ທ່ານສາມາດອັບໂຫຼດພາບໜ້າຈໍທີ່ສະແດງໃຫ້ເຫັນຂໍ້ຄວາມຕົ້ນສະບັບທີ່ກໍາລັງຖືກໃຊ້ໃນໂປຣແກຣມຂອງທ່ານ. "
"ສິ່ງນີ້ຊ່ວຍໃຫ້ນັກແປເຂົ້າໃຈວ່າພວກມັນຖືກໃຊ້ຢູ່ໃສ, ແລະ ຄວນແປຢ່າງໃດ."

msgid "The uploaded screenshot is shown in the translation context sidebar:"
msgstr "ພາບໜ້າຈໍທີ່ອັບໂຫຼດຈະສະແດງໃນແຖບດ້ານຂ້າງບໍລິບົດການແປ:"

msgid ""
"In addition to :ref:`additional`, screenshots can be managed in the Weblate "
"UI, kept in sync from the repository, or handled through the :ref:`api`."
msgstr ""
"ນອກຈາກ :ref:`additional` ແລ້ວ, ພາບໜ້າຈໍສາມາດຖືກຈັດການໃນ Weblate UI, ຮັກສາການຊິງຄ໌ຈາກ "
"repository, ຫຼື ຈັດການຜ່ານ :ref:`api`."

msgid "Managing screenshots in the UI"
msgstr "ການຈັດການພາບໜ້າຈໍໃນສ່ວນຕິດຕໍ່ຜູ້ໃຊ້"

msgid ""
"Each screenshot is stored for a specific translation language. In the "
"translate page, screenshots attached to the source language are shown for "
"every translation of the string, while screenshots attached to any other "
"language are shown only for that language. You can add a screenshot directly "
"from the translate page using :guilabel:`Add screenshot` in "
"the :guilabel:`Screenshot context` panel, or open the separate management "
"interface under the :guilabel:`Operations` menu. There you can upload "
"screenshots, assign them to source strings manually, or let Weblate find "
"strings in the image using text recognition (OCR) with the :guilabel:`Find "
"strings in image` button. Matching source strings can be assigned "
"individually, in a selected batch, or all at once."
msgstr ""
"ພາບໜ້າຈໍແຕ່ລະພາບຈະຖືກຈັດເກັບໄວ້ສຳລັບພາສາການແປສະເພາະ. ໃນໜ້າການແປ, "
"ພາບໜ້າຈໍທີ່ແນບກັບພາສາຕົ້ນສະບັບຈະສະແດງໃຫ້ເຫັນໃນທຸກການແປຂອງຂໍ້ຄວາມນັ້ນ, "
"ໃນຂະນະທີ່ພາບໜ້າຈໍທີ່ແນບກັບພາສາອື່ນຈະສະແດງສະເພາະໃນພາສານັ້ນເທົ່ານັ້ນ. "
"ທ່ານສາມາດເພີ່ມພາບໜ້າຈໍໂດຍກົງຈາກໜ້າການແປໂດຍໃຊ້ :guilabel:`Add screenshot` "
"ໃນແຜງ :guilabel:`Screenshot context`, "
"ຫຼືເປີດອິນເຕີເຟດການຈັດການແຍກຕ່າງຫາກພາຍໃຕ້ເມນູ :guilabel:`Operations`. ຢູ່ບ່ອນນັ້ນ "
"ທ່ານສາມາດອັບໂຫຼດພາບໜ້າຈໍ, ກຳນົດໃຫ້ກັບຂໍ້ຄວາມຕົ້ນສະບັບດ້ວຍຕົນເອງ, ຫຼືໃຫ້ Weblate "
"ຊອກຫາຂໍ້ຄວາມໃນຮູບໂດຍໃຊ້ການຈົດຈຳຂໍ້ຄວາມ (OCR) ດ້ວຍປຸ່ມ :guilabel:`Find strings in "
"image`. ຂໍ້ຄວາມຕົ້ນສະບັບທີ່ກົງກັນສາມາດຖືກກຳນົດໄດ້ແບບລາຍການ, ເປັນກຸ່ມທີ່ເລືອກ, ຫຼືທັງໝົດໃນຄັ້ງດຽວ."

msgid ""
"The screenshot listing summarizes uploaded screenshots and lets you search "
"or filter them:"
msgstr "ລາຍການພາບໜ້າຈໍຈະສະຫຼຸບພາບໜ້າຈໍທີ່ອັບໂຫຼດໄວ້ ແລະໃຫ້ທ່ານຄົ້ນຫາ ຫຼືກັ່ນຕອງພວກມັນໄດ້:"

msgid ""
"Once a screenshot is uploaded, this interface handles management and source "
"string association:"
msgstr "ເມື່ອອັບໂຫຼດພາບໜ້າຈໍແລ້ວ, ອິນເຕີເຟດນີ້ຈະຈັດການການບໍລິຫານ ແລະການເຊື່ອມໂຍງຂໍ້ຄວາມຕົ້ນສະບັບ:"

msgid ""
"Use the screenshot listing search to find screenshots by name, repository "
"path, language, assigned source string, source string context, or source "
"string location. The search accepts plain text as well as advanced "
"screenshot queries, see :ref:`search-screenshots`. For example, use ``NOT "
"has:string`` to find unassigned screenshots, ``has:string`` to find assigned "
"screenshots, or ``repository:fastlane`` to review screenshots discovered "
"from repository paths."
msgstr ""
"ໃຊ້ການຄົ້ນຫາໃນລາຍການພາບໜ້າຈໍເພື່ອຊອກຫາພາບໜ້າຈໍຕາມຊື່, ເສັ້ນທາງ repository, ພາສາ, "
"ຂໍ້ຄວາມຕົ້ນສະບັບທີ່ກຳນົດ, ບໍລິບົດຂອງຂໍ້ຄວາມຕົ້ນສະບັບ, ຫຼືຕຳແໜ່ງຂອງຂໍ້ຄວາມຕົ້ນສະບັບ. "
"ການຄົ້ນຫາຮອງຮັບທັງຂໍ້ຄວາມທົ່ວໄປ ແລະການສອບຖາມພາບໜ້າຈໍຂັ້ນສູງ, ເບິ່ງ :ref:`search-"
"screenshots`. ຕົວຢ່າງ, ໃຊ້ ``NOT has:string`` ເພື່ອຊອກຫາພາບໜ້າຈໍທີ່ຍັງບໍ່ໄດ້ກຳນົດ, "
"``has:string`` ເພື່ອຊອກຫາພາບໜ້າຈໍທີ່ກຳນົດແລ້ວ, ຫຼື ``repository:fastlane`` "
"ເພື່ອກວດສອບພາບໜ້າຈໍທີ່ພົບຈາກເສັ້ນທາງ repository."

msgid ""
"You can upload a screenshot from a local file, paste it from the clipboard, "
"or provide a URL to download an image from an external source. URL-based "
"uploads may be restricted based on the :setting:`ALLOWED_ASSET_DOMAINS` "
"setting, which controls which domains are trusted for downloading external "
"assets, including any redirects followed while fetching the image, "
"and :setting:`ASSET_RESTRICT_PRIVATE`, which rejects internal or non-public "
"targets unless they are included in :setting:`ASSET_PRIVATE_ALLOWLIST`. "
"The :setting:`ALLOWED_ASSET_SIZE` setting limits maximal size for the asset."
msgstr ""
"ທ່ານສາມາດອັບໂຫຼດພາບໜ້າຈໍຈາກໄຟລ໌ໃນເຄື່ອງ, ວາງຈາກ clipboard, ຫຼືລະບຸ URL "
"ເພື່ອດາວໂຫຼດຮູບຈາກແຫຼ່ງພາຍນອກ. ການອັບໂຫຼດຜ່ານ URL "
"ອາດຈະຖືກຈຳກັດໂດຍອີງຕາມການຕັ້ງຄ່າ :setting:`ALLOWED_ASSET_DOMAINS` "
"ເຊິ່ງຄວບຄຸມວ່າໂດເມນໃດທີ່ເຊື່ອຖືໄດ້ສຳລັບການດາວໂຫຼດຊັບສິນພາຍນອກ, ລວມເຖິງການປ່ຽນເສັ້ນທາງ "
"(redirects) ທັງໝົດທີ່ຕິດຕາມໃນຂະນະດຶງຮູບ, ແລະ :setting:`ASSET_RESTRICT_PRIVATE` "
"ເຊິ່ງຈະປະຕິເສດເປົ້າໝາຍພາຍໃນ ຫຼືທີ່ບໍ່ແມ່ນສາທາລະນະ "
"ເວັ້ນເສຍແຕ່ວ່າຈະຖືກລວມຢູ່ໃນ :setting:`ASSET_PRIVATE_ALLOWLIST`. "
"ການຕັ້ງຄ່າ :setting:`ALLOWED_ASSET_SIZE` ຈະຈຳກັດຂະໜາດສູງສຸດຂອງຊັບສິນນັ້ນ."

msgid "Managing screenshots from the repository"
msgstr "ການຈັດການພາບໜ້າຈໍຈາກ repository"

msgid ""
"You can add or update screenshots directly from your Version Control System "
"(VCS) repository."
msgstr ""
"ທ່ານສາມາດເພີ່ມ ຫຼືອັບເດດພາບໜ້າຈໍໂດຍກົງຈາກ repository ລະບົບຄວບຄຸມເວີຊັນ (VCS) ຂອງທ່ານ."

msgid ""
"To enable this feature, you can either set a screenshot file mask when "
"creating a component, which will be monitored for updates in the repository, "
"or you can add or update screenshots when uploading them manually."
msgstr ""
"ເພື່ອເປີດໃຊ້ຟີເຈີນີ້, ທ່ານສາມາດຕັ້ງຄ່າໜ້າກາກໄຟລ໌ພາບໜ້າຈໍໃນຂະນະສ້າງອົງປະກອບ, "
"ເຊິ່ງຈະຖືກຕິດຕາມການອັບເດດໃນ repository, ຫຼືທ່ານສາມາດເພີ່ມ "
"ຫຼືອັບເດດພາບໜ້າຈໍໃນຂະນະອັບໂຫຼດດ້ວຍຕົນເອງ."

msgid ""
"To connect a manually uploaded screenshot with later repository updates, "
"fill in :guilabel:`Repository path to screenshot` with the path tracked in "
"the repository."
msgstr ""
"ເພື່ອເຊື່ອມຕໍ່ພາບໜ້າຈໍທີ່ອັບໂຫຼດດ້ວຍຕົນເອງກັບການອັບເດດ repository ໃນພາຍຫຼັງ, "
"ໃຫ້ຕື່ມຂໍ້ມູນໃສ່ :guilabel:`Repository path to screenshot` ດ້ວຍເສັ້ນທາງທີ່ຖືກຕິດຕາມຢູ່ໃນ "
"repository."

msgid ""
"When the repository is updated, the system will automatically scan for "
"changes. Existing screenshots in the repository will be updated, and new "
"screenshots matching the specified screenshot file mask will be added to the "
"component."
msgstr ""
"ເມື່ອ repository ຖືກອັບເດດ, ລະບົບຈະສະແກນການປ່ຽນແປງໂດຍອັດຕະໂນມັດ. ພາບໜ້າຈໍທີ່ມີຢູ່ໃນ "
"repository ຈະຖືກອັບເດດ, ແລະພາບໜ້າຈໍໃໝ່ທີ່ກົງກັບໜ້າກາກໄຟລ໌ພາບໜ້າຈໍທີ່ລະບຸຈະຖືກເພີ່ມເຂົ້າໃນອົງປະກອບ."

msgid "For application projects, a practical workflow is:"
msgstr "ສຳລັບໂປຣເຈັກແອັບພລິເຄຊັນ, ເວີກໂຟລທີ່ໃຊ້ງານໄດ້ຈິງແມ່ນ:"

msgid ""
"Capture source-language screenshots for the most visible user interface."
msgstr "ບັນທຶກພາບໜ້າຈໍພາສາຕົ້ນສະບັບສຳລັບສ່ວນຕິດຕໍ່ຜູ້ໃຊ້ທີ່ເຫັນໄດ້ຊັດເຈນທີ່ສຸດ."

msgid ""
"Store them in a stable repository path, for example below :file:`fastlane/"
"metadata/android/en-US/images/phoneScreenshots/`."
msgstr ""
"ຈັດເກັບພວກມັນໄວ້ໃນເສັ້ນທາງ repository ທີ່ໝັ້ນຄົງ, ຕົວຢ່າງເຊັ່ນພາຍໃຕ້ :file:`fastlane/"
"metadata/android/en-US/images/phoneScreenshots/`."

msgid "Configure :ref:`component-screenshot_filemask` for that path."
msgstr "ຕັ້ງຄ່າ :ref:`component-screenshot_filemask` ສຳລັບເສັ້ນທາງນັ້ນ."

msgid ""
"Update the component repository so Weblate discovers or refreshes the "
"screenshots."
msgstr "ອັບເດດ repository ຂອງອົງປະກອບເພື່ອໃຫ້ Weblate ຄົ້ນພົບ ຫຼືຮີເຟຣຊພາບໜ້າຈໍ."

msgid ""
"Use OCR or source string search to assign screenshots to the matching source "
"strings, and review the :guilabel:`Source strings without screenshots` "
"counter for important strings still missing visual context."
msgstr ""
"ໃຊ້ OCR ຫຼືການຄົ້ນຫາຂໍ້ຄວາມຕົ້ນສະບັບເພື່ອມອບໝາຍພາບໜ້າຈໍໃຫ້ກັບຂໍ້ຄວາມຕົ້ນສະບັບທີ່ກົງກັນ, "
"ແລະກວດສອບຕົວເລກ :guilabel:`Source strings without screenshots` "
"ສຳລັບຂໍ້ຄວາມສຳຄັນທີ່ຍັງຂາດບໍລິບົດທາງສາຍຕາ."

msgid "Managing screenshots through the API"
msgstr "ການຈັດການພາບໜ້າຈໍຜ່ານ API"

msgid ""
"Screenshot workflows are also available through the REST API. "
"Use :http:get:`/api/components/(string:project)/(string:component)/"
"screenshots/` to list screenshots for one component, :http:post:`/api/"
"screenshots/` to create screenshots, :http:post:`/api/screenshots/(int:id)/"
"file/` to replace the image, :http:post:`/api/screenshots/(int:id)/units/` "
"and :http:delete:`/api/screenshots/(int:id)/units/(int:unit_id)` to manage "
"source string associations, and :http:delete:`/api/screenshots/(int:id)/` to "
"delete screenshots. Screenshot API objects include the related translation "
"and the optional repository path used for repository-based updates."
msgstr ""
"ເວີກໂຟລຂອງພາບໜ້າຈໍຍັງມີໃຫ້ໃຊ້ງານຜ່ານ REST API. ໃຊ້ :http:get:`/api/components/"
"(string:project)/(string:component)/screenshots/` "
"ເພື່ອສະແດງລາຍການພາບໜ້າຈໍສຳລັບໜຶ່ງອົງປະກອບ, :http:post:`/api/screenshots/` "
"ເພື່ອສ້າງພາບໜ້າຈໍ, :http:post:`/api/screenshots/(int:id)/file/` "
"ເພື່ອແທນທີ່ຮູບພາບ, :http:post:`/api/screenshots/(int:id)/units/` "
"ແລະ :http:delete:`/api/screenshots/(int:id)/units/(int:unit_id)` "
"ເພື່ອຈັດການການເຊື່ອມໂຍງຂໍ້ຄວາມຕົ້ນສະບັບ, ແລະ :http:delete:`/api/screenshots/(int:id)/` "
"ເພື່ອລຶບພາບໜ້າຈໍ. ອອບເຈັກ Screenshot API ຈະລວມເຖິງການແປທີ່ກ່ຽວຂ້ອງ ແລະເສັ້ນທາງ repository "
"ທາງເລືອກທີ່ໃຊ້ສຳລັບການອັບເດດໂດຍອີງໃສ່ repository."

msgid "Upgrading Weblate"
msgstr "ການອັບເກຣດ Weblate"

msgid "Docker image upgrades"
msgstr "ການອັບເກຣດ Docker image"

msgid ""
"The official Weblate Docker image (see :doc:`install/docker`) integrates all "
"upgrade steps. Typically, no manual interaction is needed beyond pulling the "
"latest (or at least newer) version."
msgstr ""
"Weblate Docker image ທາງການ (ເບິ່ງ :doc:`install/docker`) "
"ໄດ້ລວມເອົາຂັ້ນຕອນການອັບເກຣດທັງໝົດໄວ້ແລ້ວ. ໂດຍປົກກະຕິ, "
"ບໍ່ຈຳເປັນຕ້ອງມີການໂຕ້ຕອບດ້ວຍຕົນເອງນອກເໜືອໄປຈາກການດຶງເວີຊັນລ່າສຸດ (ຫຼືຢ່າງໜ້ອຍກໍເວີຊັນໃໝ່ກວ່າ)."

msgid "Generic upgrade instructions"
msgstr "ຄຳແນະນຳການອັບເກຣດທົ່ວໄປ"

msgid ""
"Always look for new changes to :ref:`requirements` before upgrading. Once "
"all requirements are installed or upgraded, ensure your :file:`settings.py` "
"matches the changes in the configuration "
"(consult :file:`settings_example.py` for correct values)."
msgstr ""
"ໃຫ້ກວດເບິ່ງການປ່ຽນແປງໃໝ່ໆຕໍ່ :ref:`requirements` ສະເໝີກ່ອນການອັບເກຣດ. ເມື່ອຕິດຕັ້ງ "
"ຫຼືອັບເກຣດຄວາມຕ້ອງການທັງໝົດແລ້ວ, ໃຫ້ຮັບປະກັນວ່າ :file:`settings.py` "
"ຂອງທ່ານກົງກັບການປ່ຽນແປງໃນການຕັ້ງຄ່າ (ປຶກສາ :file:`settings_example.py` ສຳລັບຄ່າທີ່ຖືກຕ້ອງ)."

msgid ""
"Always check :ref:`version-specific-instructions` before upgrading. If you "
"are skipping any versions, be sure to follow instructions for all versions "
"you are skipping during such upgrade. It's sometimes better to upgrade "
"gradually to an intermediate version to ensure a smooth migration. Upgrading "
"across multiple releases should work, but is not as well tested as single "
"version upgrades!"
msgstr ""
"ກວດເບິ່ງ :ref:`version-specific-instructions` ສະເໝີກ່ອນການອັບເກຣດ. "
"ຖ້າທ່ານຂ້າມເວີຊັນໃດໜຶ່ງໄປ, "
"ໃຫ້ແນ່ໃຈວ່າໄດ້ປະຕິບັດຕາມຄຳແນະນຳສຳລັບທຸກເວີຊັນທີ່ທ່ານຂ້າມໃນລະຫວ່າງການອັບເກຣດນັ້ນ. "
"ບາງຄັ້ງການອັບເກຣດເທື່ອລະໜ້ອຍໄປຫາເວີຊັນກາງແມ່ນດີກວ່າເພື່ອໃຫ້ແນ່ໃຈວ່າການຍ້າຍລະບົບຈະເປັນໄປຢ່າງລຽບງ່າຍ. "
"ການອັບເກຣດຂ້າມຫຼາຍເວີຊັນຄວນຈະເຮັດວຽກໄດ້, ແຕ່ບໍ່ໄດ້ຜ່ານການທົດສອບດີເທົ່າກັບການອັບເກຣດເທື່ອລະເວີຊັນ!"

msgid ""
"Always back up the full database before upgrading, so that you can roll back "
"the database if the upgrade fails, see :doc:`backup`."
msgstr ""
"ໃຫ້ສຳຮອງຖານຂໍ້ມູນທັງໝົດສະເໝີກ່ອນການອັບເກຣດ, "
"ເພື່ອໃຫ້ທ່ານສາມາດຍ້ອນກັບຖານຂໍ້ມູນໄດ້ຫາກການອັບເກຣດລົ້ມເຫຼວ, ເບິ່ງ :doc:`backup`."

msgid ""
"Wait for the Celery queues to become empty, then stop the WSGI and Celery "
"processes to avoid old processes running while upgrading. Otherwise "
"incompatible changes in the database might occur."
msgstr ""
"ລໍຖ້າໃຫ້ຄິວ Celery ຫວ່າງເປົ່າ, ຈາກນັ້ນຢຸດໂປຣເຊສ WSGI ແລະ Celery "
"ເພື່ອຫຼີກລ່ຽງບໍ່ໃຫ້ໂປຣເຊສເກົ່າເຮັດວຽກໃນຂະນະອັບເກຣດ. ຖ້າບໍ່ດັ່ງນັ້ນ, "
"ອາດເກີດການປ່ຽນແປງທີ່ບໍ່ເຂົ້າກັນໃນຖານຂໍ້ມູນ."

msgid ""
"The Celery task queue is not a stable interface across releases, so queued "
"tasks from the old version are not guaranteed to work after the upgrade. You "
"can monitor queue length in the :ref:`management-interface` or by "
"using :wladmin:`celery_queues`."
msgstr ""
"ຄິວວຽກຂອງ Celery ບໍ່ແມ່ນອິນເຕີເຟດທີ່ໝັ້ນຄົງລະຫວ່າງເວີຊັນ, "
"ສະນັ້ນວຽກທີ່ຢູ່ໃນຄິວຈາກເວີຊັນເກົ່າບໍ່ໄດ້ຮັບປະກັນວ່າຈະເຮັດວຽກໄດ້ຫຼັງຈາກອັບເກຣດ. "
"ທ່ານສາມາດຕິດຕາມຄວາມຍາວຂອງຄິວໄດ້ໃນ :ref:`management-interface` "
"ຫຼືໂດຍໃຊ້ :wladmin:`celery_queues`."

msgid "Upgrade Weblate"
msgstr "ອັບເກຣດ Weblate"

msgid "For pip installs it can be achieved by:"
msgstr "ສຳລັບການຕິດຕັ້ງຜ່ານ pip ສາມາດເຮັດໄດ້ໂດຍ:"

msgid "Or, if you just want to get the latest released version:"
msgstr "ຫຼື, ຖ້າທ່ານພຽງແຕ່ຕ້ອງການໄດ້ເວີຊັນລ່າສຸດທີ່ປ່ອຍອອກມາ:"

msgid "If you don't want to install all of the optional dependencies do:"
msgstr "ຖ້າທ່ານບໍ່ຕ້ອງການຕິດຕັ້ງ dependencies ເພີ່ມເຕີມທັງໝົດ ໃຫ້ເຮັດດັ່ງນີ້:"

msgid ""
"Using Git checkout, you need to fetch new source code and update your "
"installation:"
msgstr ""
"ການໃຊ້ Git checkout, ທ່ານຈຳເປັນຕ້ອງດຶງຊໍສ໌ໂຄດ (source code) ໃໝ່ "
"ແລະອັບເດດການຕິດຕັ້ງຂອງທ່ານ:"

msgid ""
"New Weblate releases might have new :ref:`python-deps`, check if they cover "
"the features you want."
msgstr ""
"ເວີຊັນໃໝ່ຂອງ Weblate ອາດມີ :ref:`python-deps` ໃໝ່, "
"ໃຫ້ກວດເບິ່ງວ່າພວກມັນກວມເອົາຟີເຈີທີ່ທ່ານຕ້ອງການຫຼືບໍ່."

msgid ""
"Upgrade the configuration file by following "
"either :file:`settings_example.py`, or :ref:`version-specific-instructions`."
msgstr ""
"ອັບເກຣດໄຟລ໌ການຕັ້ງຄ່າໂດຍປະຕິບັດຕາມ :file:`settings_example.py`, ຫຼື :ref:`version-"
"specific-instructions`."

msgid "Upgrade the database:"
msgstr "ອັບເກຣດຖານຂໍ້ມູນ:"

msgid ""
"Collect updated static files (see :ref:`server` and :ref:`static-files`):"
msgstr "ເກັບກຳໄຟລ໌ static ທີ່ອັບເດດແລ້ວ (ເບິ່ງ :ref:`server` ແລະ :ref:`static-files`):"

msgid ""
"If you are running an installation from Git, you should also regenerate "
"locale files every time you upgrade. You can do this by invoking:"
msgstr ""
"ຖ້າທ່ານກຳລັງໃຊ້ການຕິດຕັ້ງຈາກ Git, ທ່ານຄວນສ້າງໄຟລ໌ locale ໃໝ່ທຸກຄັ້ງທີ່ອັບເກຣດ. "
"ທ່ານສາມາດເຮັດໄດ້ໂດຍການຮຽກ:"

msgid "Verify that your setup is sane (see also :ref:`production`):"
msgstr "ກວດສອບວ່າການຕັ້ງຄ່າຂອງທ່ານປົກກະຕິດີ (ເບິ່ງ :ref:`production` ນຳ):"

msgid "Restart the Celery worker (see :ref:`celery`)."
msgstr "ຣີສະຕາດ Celery worker (ເບິ່ງ :ref:`celery`)."

msgid ""
"Some upgrades run translation-memory scope backfill and consolidation in the "
"background using periodic Celery tasks. Keep Celery running after the "
"upgrade and monitor progress in :guilabel:`Administration` "
"> :guilabel:`Performance report`. See :ref:`memory-scopes` for details."
msgstr ""
"ການອັບເກຣດບາງຄັ້ງຈະເຮັດການຕື່ມຂໍ້ມູນ (backfill) ແລະລວມກຸ່ມ Translation-memory "
"ໃນເບື້ອງຫຼັງໂດຍໃຊ້ວຽກງານ Celery ຕາມໄລຍະເວລາ. ໃຫ້ເປີດ Celery ເຮັດວຽກໄວ້ຫຼັງຈາກອັບເກຣດ "
"ແລະຕິດຕາມຄວາມຄືບໜ້າໃນ :guilabel:`Administration` > :guilabel:`Performance "
"report`. ເບິ່ງ :ref:`memory-scopes` ສຳລັບລາຍລະອຽດ."

msgid "Version-specific instructions"
msgstr "ຄຳແນະນຳສະເພາະເວີຊັນ"

msgid ""
"Version specific instructions are now included in the release notes, "
"see :doc:`/changes`."
msgstr "ຄຳແນະນຳສະເພາະເວີຊັນໄດ້ຖືກລວມເຂົ້າໃນບັນທຶກການປ່ອຍເວີຊັນແລ້ວ, ເບິ່ງ :doc:`/changes`."

msgid "Upgrade from an older unsupported release"
msgstr "ການອັບເກຣດຈາກເວີຊັນເກົ່າທີ່ບໍ່ຮອງຮັບ"

msgid ""
"Direct upgrades are only supported for releases from the current or previous "
"calendar year. If you need to upgrade across this boundary, upgrade first to "
"an intermediate version as listed below. Upgrades skipping this step are not "
"supported and will break."
msgstr ""
"ການອັບເກຣດໂດຍກົງຮອງຮັບສະເພາະເວີຊັນຈາກປີປະຕິທິນປັດຈຸບັນ ຫຼືປີກ່ອນໜ້າ. "
"ຖ້າທ່ານຕ້ອງການອັບເກຣດຂ້າມຂອບເຂດນີ້, ໃຫ້ອັບເກຣດໄປຍັງເວີຊັນກາງຕາມລາຍການຂ້າງລຸ່ມນີ້ກ່ອນ. "
"ການອັບເກຣດທີ່ຂ້າມຂັ້ນຕອນນີ້ຈະບໍ່ໄດ້ຮັບການຮອງຮັບ ແລະຈະເຮັດໃຫ້ລະບົບເສຍຫາຍ."

msgid ""
"If you are upgrading from the 2.x release, always first upgrade to 3.0.1."
msgstr "ຖ້າທ່ານກຳລັງອັບເກຣດຈາກເວີຊັນ 2.x, ໃຫ້ອັບເກຣດເປັນ 3.0.1 ກ່ອນສະເໝີ."

msgid ""
"If you are upgrading from the 3.x release, always first upgrade to 4.0.4."
msgstr "ຖ້າທ່ານກຳລັງອັບເກຣດຈາກເວີຊັນ 3.x, ໃຫ້ອັບເກຣດເປັນ 4.0.4 ກ່ອນສະເໝີ."

msgid ""
"If you are upgrading from the 4.x release, always first upgrade to 5.0.2."
msgstr "ຖ້າທ່ານກຳລັງອັບເກຣດຈາກເວີຊັນ 4.x, ໃຫ້ອັບເກຣດເປັນ 5.0.2 ກ່ອນສະເໝີ."

msgid "If you are upgrading from 5.0.x-5.9.x, always first upgrade to 5.10.4."
msgstr "ຖ້າທ່ານກຳລັງອັບເກຣດຈາກເວີຊັນ 5.0.x-5.9.x, ໃຫ້ອັບເກຣດເປັນ 5.10.4 ກ່ອນສະເໝີ."

msgid "Upgrades from 5.10.x and newer are currently directly supported."
msgstr "ການອັບເກຣດຈາກ 5.10.x ແລະໃໝ່ກວ່ານັ້ນສາມາດເຮັດໄດ້ໂດຍກົງ."

msgid ""
"`Upgrade from 2.20 to 3.0 in Weblate 3.0 documentation <https://"
"docs.weblate.org/en/weblate-3.0.1/admin/upgrade.html#upgrade-3>`_"
msgstr ""
"`ອັບເກຣດຈາກ 2.20 ຫາ 3.0 ໃນເອກະສານ Weblate 3.0 <https://docs.weblate.org/en/"
"weblate-3.0.1/admin/upgrade.html#upgrade-3>`_"

msgid ""
"`Upgrade from 3.11 to 4.0 in Weblate 4.0 documentation <https://"
"docs.weblate.org/en/weblate-4.0.4/admin/upgrade.html#upgrade-from-3-11-"
"to-4-0>`_"
msgstr ""
"`ອັບເກຣດຈາກ 3.11 ຫາ 4.0 ໃນເອກະສານ Weblate 4.0 <https://docs.weblate.org/en/"
"weblate-4.0.4/admin/upgrade.html#upgrade-from-3-11-to-4-0>`_"

msgid ""
"`Upgrade from 4.x to 5.0.2 in Weblate 5.0 documentation <https://"
"docs.weblate.org/en/weblate-5.0.2/changes.html>`_"
msgstr ""
"`ອັບເກຣດຈາກ 4.x ຫາ 5.0.2 ໃນເອກະສານ Weblate 5.0 <https://docs.weblate.org/en/"
"weblate-5.0.2/changes.html>`_"

msgid "Migrating from other databases to PostgreSQL"
msgstr "ການຍ້າຍຈາກຖານຂໍ້ມູນອື່ນໄປຫາ PostgreSQL"

msgid ""
"MySQL and MariaDB are no longer supported in Weblate. You must migrate to "
"PostgreSQL before upgrading."
msgstr ""
"MySQL ແລະ MariaDB ບໍ່ໄດ້ຮັບການຮອງຮັບໃນ Weblate ອີກຕໍ່ໄປ. ທ່ານຕ້ອງຍ້າຍໄປຫາ PostgreSQL "
"ກ່ອນການອັບເກຣດ."

msgid ""
"If you are running Weblate with MySQL or MariaDB, consider migrating to "
"PostgreSQL for better performance by doing the following steps. Remember to "
"stop both, the web and Celery servers beforehand, otherwise you might end up "
"with inconsistent data."
msgstr ""
"ຖ້າທ່ານກຳລັງໃຊ້ Weblate ກັບ MySQL ຫຼື MariaDB, ໃຫ້ພິຈາລະນາຍ້າຍໄປຫາ PostgreSQL "
"ເພື່ອປະສິດທິພາບທີ່ດີກວ່າໂດຍປະຕິບັດຕາມຂັ້ນຕອນຕໍ່ໄປນີ້. ຈື່ໄວ້ວ່າໃຫ້ຢຸດເຊີເວີເວັບ ແລະ Celery ກ່ອນ, "
"ບໍ່ດັ່ງນັ້ນທ່ານອາດຈະພົບກັບຂໍ້ມູນທີ່ບໍ່ສອດຄ່ອງກັນ."

msgid ""
"It is usually a good idea to run Weblate in a separate database, and a "
"separate user account:"
msgstr ""
"ໂດຍປົກກະຕິແລ້ວມັນເປັນຄວາມຄິດທີ່ດີທີ່ຈະໃຊ້ Weblate ໃນຖານຂໍ້ມູນແຍກຕ່າງຫາກ ແລະບັນຊີຜູ້ໃຊ້ແຍກຕ່າງຫາກ:"

msgid "Migrating to PostgreSQL using pgloader"
msgstr "ການຍ້າຍໄປ PostgreSQL ໂດຍໃຊ້ pgloader"

msgid ""
"The `pgloader`_ is a generic migration tool to migrate data to PostgreSQL. "
"You can use it to migrate your Weblate database."
msgstr ""
"`pgloader`_ ແມ່ນເຄື່ອງມືຍ້າຍຂໍ້ມູນທົ່ວໄປສຳລັບຍ້າຍຂໍ້ມູນໄປຫາ PostgreSQL. ທ່ານສາມາດໃຊ້ປ່ຽນຖານຂໍ້ມູນ "
"Weblate ຂອງທ່ານໄດ້."

msgid "Adjust your :file:`settings.py` to use PostgreSQL as database."
msgstr "ປັບ :file:`settings.py` ຂອງທ່ານໃຫ້ໃຊ້ PostgreSQL ເປັນຖານຂໍ້ມູນ."

msgid "Migrate the schema in the PostgreSQL database:"
msgstr "ຍ້າຍ schema ໃນຖານຂໍ້ມູນ PostgreSQL:"

msgid ""
"3. Run the pgloader to transfer the data. The following script can be used "
"to migrate the database, but you might want to learn more about `pgloader`_ "
"to better understand what it does, and tweak it to match your setup:"
msgstr ""
"3. ຣັນ pgloader ເພື່ອໂອນຍ້າຍຂໍ້ມູນ. ສະຄຣິບຕໍ່ໄປນີ້ສາມາດໃຊ້ເພື່ອຍ້າຍຖານຂໍ້ມູນໄດ້, "
"ແຕ່ທ່ານອາດຈະຕ້ອງການຮຽນຮູ້ເພີ່ມເຕີມກ່ຽວກັບ `pgloader`_ ເພື່ອເຂົ້າໃຈສິ່ງທີ່ມັນເຮັດໃຫ້ດີຂຶ້ນ, "
"ແລະປັບແຕ່ງມັນໃຫ້ກົງກັບການຕັ້ງຄ່າຂອງທ່ານ:"

msgid "Migrating from Pootle"
msgstr "ການຍ້າຍຈາກ Pootle"

msgid ""
"As Weblate was originally written as a replacement for Pootle, it is "
"supported to migrate the user accounts from it. You can dump the users from "
"Pootle and import them using :wladmin:`importusers`."
msgstr ""
"ເນື່ອງຈາກ Weblate ຖືກຂຽນຂຶ້ນເພື່ອເປັນຕົວແທນຂອງ Pootle, ຈຶ່ງສາມາດຍ້າຍບັນຊີຜູ້ໃຊ້ຈາກມັນໄດ້. "
"ທ່ານສາມາດ dump ຜູ້ໃຊ້ຈາກ Pootle ແລະນຳເຂົ້າພວກມັນໂດຍໃຊ້ :wladmin:`importusers`."

msgid "Workspaces"
msgstr "ພື້ນທີ່ເຮັດວຽກ"

msgid ""
"Workspaces group related translation projects. They sit above projects and "
"provide a shared place for project listings, workspace-scoped access "
"control, and billing details when the billing module is enabled."
msgstr ""
"ພື້ນທີ່ເຮັດວຽກ (Workspaces) ເປັນການຈັດກຸ່ມໂປຣເຈັກການແປທີ່ກ່ຽວຂ້ອງ. ພວກມັນຢູ່ເໜືອໂປຣເຈັກ "
"ແລະເປັນບ່ອນຮ່ວມສຳລັບລາຍການໂປຣເຈັກ, ການຄວບຄຸມການເຂົ້າເຖິງໃນຂອບເຂດພື້ນທີ່ເຮັດວຽກ, "
"ແລະລາຍລະອຽດການເກັບເງິນເມື່ອໂມດູນການເກັບເງິນຖືກເປີດໃຊ້."

msgid ""
"Workspace membership does not grant access to translate or manage projects "
"in the workspace. Project access is still controlled by the project access "
"control settings and project teams, see :ref:`acl`."
msgstr ""
"ການເປັນສະມາຊິກພື້ນທີ່ເຮັດວຽກບໍ່ໄດ້ໃຫ້ສິດໃນການແປ ຫຼືຈັດການໂປຣເຈັກໃນພື້ນທີ່ເຮັດວຽກນັ້ນ. "
"ການເຂົ້າເຖິງໂປຣເຈັກຍັງຄົງຖືກຄວບຄຸມໂດຍການຕັ້ງຄ່າການຄວບຄຸມການເຂົ້າເຖິງໂປຣເຈັກ ແລະທີມງານໂປຣເຈັກ, "
"ເບິ່ງ :ref:`acl`."

msgid ""
"The workspace page lists projects in that workspace that you can access."
msgstr "ໜ້າພື້ນທີ່ເຮັດວຽກຈະສະແດງລາຍການໂປຣເຈັກໃນພື້ນທີ່ເຮັດວຽກນັ້ນທີ່ທ່ານສາມາດເຂົ້າເຖິງໄດ້."

msgid ""
"Signed-in users can also review grouped project and component findings on "
"the workspace :guilabel:`Diagnostics` tab. See :ref:`diagnostics-overviews`."
msgstr ""
"ຜູ້ໃຊ້ທີ່ເຂົ້າສູ່ລະບົບແລ້ວຍັງສາມາດກວດສອບຜົນການກວດສອບໂຄງການ ແລະ "
"ສ່ວນປະກອບທີ່ຖືກຈັດກຸ່ມໄວ້ໃນແຖບ :guilabel:`Diagnostics` ຂອງພື້ນທີ່ເຮັດວຽກ. "
"ເບິ່ງ :ref:`diagnostics-overviews`."

msgid ""
"Signed-in users can open :guilabel:`Projects` ↓ :guilabel:`My workspaces` to "
"list workspaces where they have an explicit workspace-team assignment. This "
"list does not include workspaces merely because the user has site-wide "
"management access."
msgstr ""
"ຜູ້ໃຊ້ທີ່ເຂົ້າສູ່ລະບົບແລ້ວສາມາດເປີດ :guilabel:`ໂຄງການ` ↓ :guilabel:`ພື້ນທີ່ເຮັດວຽກຂອງຂ້ອຍ` "
"ເພື່ອເບິ່ງລາຍຊື່ ພື້ນທີ່ເຮັດວຽກທີ່ພວກເຂົາໄດ້ຮັບການມອບໝາຍໃຫ້ຢູ່ໃນທີມພື້ນທີ່ເຮັດວຽກຢ່າງຊັດເຈນ. "
"ລາຍຊື່ນີ້ຈະບໍ່ລວມເອົາ ພື້ນທີ່ເຮັດວຽກທີ່ຜູ້ໃຊ້ມີສິດຈັດການທົ່ວລະບົບພຽງຢ່າງດຽວ."

msgid ""
"Site managers can list all workspaces in the management interface "
"at :guilabel:`Manage` ↓ :guilabel:`Workspaces`."
msgstr ""
"ຜູ້ດູແລເວັບໄຊສາມາດເບິ່ງລາຍຊື່ workspace ທັງໝົດໄດ້ໃນສ່ວນຈັດການທີ່ :guilabel:`Manage` "
"↓ :guilabel:`Workspaces`."

msgid ""
"Workspace statistics aggregate all owned and shared content, including "
"projects and restricted components that you cannot access. Project listings "
"and actions remain permission-filtered. See :ref:`statistics access "
"filtering <statistics-access-filtering>`."
msgstr ""
"ສະຖິຕິພື້ນທີ່ເຮັດວຽກຈະລວມເອົາເນື້ອໃນທັງໝົດທີ່ເປັນເຈົ້າຂອງ ແລະ ທີ່ແບ່ງປັນ, ລວມທັງໂຄງການ ແລະ "
"ສ່ວນປະກອບທີ່ຖືກຈຳກັດທີ່ເຈົ້າບໍ່ສາມາດເຂົ້າເຖິງໄດ້. ການສະແດງລາຍຊື່ໂຄງການ ແລະ ການດຳເນີນການ "
"ຍັງຄົງຖືກກັ່ນຕອງຕາມການອະນຸຍາດ. ເບິ່ງ :ref:`statistics access filtering <statistics-"
"access-filtering>`."

msgid ""
"The workspace :guilabel:`Files` menu downloads a ZIP archive of owned "
"components that you can access and have permission to download. Workspace "
"membership does not bypass project access control or component restrictions. "
"The menu also provides :guilabel:`Upload translation` guidance. Uploading at "
"workspace level is not supported; select a project and open an individual "
"translation to upload a file."
msgstr ""
"ເມນູ :guilabel:`ໄຟລ໌` ຂອງພື້ນທີ່ເຮັດວຽກຈະດາວໂຫຼດໄຟລ໌ ZIP ຂອງສ່ວນປະກອບທີ່ເປັນເຈົ້າຂອງ "
"ທີ່ເຈົ້າສາມາດເຂົ້າເຖິງ ແລະ ມີສິດດາວໂຫຼດໄດ້. ການເປັນສະມາຊິກພື້ນທີ່ເຮັດວຽກບໍ່ໄດ້ໝາຍຄວາມວ່າຈະຂ້າມ "
"ການຄວບຄຸມການເຂົ້າເຖິງໂຄງການ ຫຼື ການຈຳກັດສ່ວນປະກອບໄດ້. "
"ເມນູນີ້ຍັງໃຫ້ຄຳແນະນຳໃນການ :guilabel:`ອັບໂຫຼດການແປ`. "
"ການອັບໂຫຼດໃນລະດັບພື້ນທີ່ເຮັດວຽກແມ່ນຍັງບໍ່ຮອງຮັບ; ໃຫ້ເລືອກໂຄງການ ແລະ ເປີດການແປແຕ່ລະລາຍການ "
"ເພື່ອອັບໂຫຼດໄຟລ໌."

msgid ""
"Users who can edit translations in an accessible project can "
"choose :guilabel:`Operations` ↓ :guilabel:`Search and replace` to replace "
"text across permission-filtered owned project content in the workspace. The "
"existing :ref:`search-replace` preview and confirmation workflow applies."
msgstr ""
"ຜູ້ໃຊ້ທີ່ສາມາດແກ້ໄຂການແປໃນໂຄງການທີ່ເຂົ້າເຖິງໄດ້ ສາມາດເລືອກ :guilabel:`ການດຳເນີນການ` "
"↓ :guilabel:`ຄົ້ນຫາ ແລະ ແທນທີ່` ເພື່ອແທນທີ່ຂໍ້ຄວາມໃນເນື້ອໃນໂຄງການທີ່ເປັນເຈົ້າຂອງ ແລະ "
"ຖືກກັ່ນຕອງຕາມການອະນຸຍາດໃນພື້ນທີ່ເຮັດວຽກ. ຂັ້ນຕອນການເບິ່ງຕົວຢ່າງ ແລະ ການຢືນຢັນ :ref:`search-"
"replace` ທີ່ມີຢູ່ແລ້ວຈະຖືກນຳໃຊ້."

msgid "Workspace removal"
msgstr "ການລຶບ Workspace"

msgid ""
"Users with the :guilabel:`Edit workspace settings` permission can remove a "
"workspace from :guilabel:`Operations` ↓ :guilabel:`Organize or remove`."
msgstr ""
"ຜູ້ໃຊ້ທີ່ມີສິດ :guilabel:`ແກ້ໄຂການຕັ້ງຄ່າພື້ນທີ່ເຮັດວຽກ` "
"ສາມາດລຶບພື້ນທີ່ເຮັດວຽກອອກໄດ້ຈາກ :guilabel:`ການດຳເນີນການ` ↓ :guilabel:`ຈັດລະບຽບ ຫຼື "
"ລຶບອອກ`."

msgid ""
"Only empty workspaces can be removed. Move or remove all projects in the "
"workspace first. Workspaces associated with billing cannot be removed."
msgstr ""
"ສາມາດລຶບໄດ້ສະເພາະພື້ນທີ່ເຮັດວຽກທີ່ວ່າງເປົ່າເທົ່ານັ້ນ. ໃຫ້ຍ້າຍ ຫຼື ລຶບໂຄງການທັງໝົດໃນພື້ນທີ່ເຮັດວຽກອອກກ່ອນ. "
"ພື້ນທີ່ເຮັດວຽກທີ່ກ່ຽວຂ້ອງກັບການຮຽກເກັບເງິນ (billing) ແມ່ນບໍ່ສາມາດລຶບອອກໄດ້."

msgid "Project creation and moves"
msgstr "ການສ້າງ ແລະຍ້າຍໂປຣເຈັກ"

msgid "Projects can be created with or without a workspace:"
msgstr "ໂປຣເຈັກສາມາດຖືກສ້າງຂຶ້ນໂດຍມີ ຫຼືບໍ່ມີພື້ນທີ່ເຮັດວຽກ:"

msgid ""
"Creating a project in a workspace requires the :guilabel:`Add projects to "
"workspace` permission for that workspace."
msgstr ""
"ການສ້າງໂປຣເຈັກໃນພື້ນທີ່ເຮັດວຽກຕ້ອງການສິດ :guilabel:`Add projects to workspace` "
"ສຳລັບພື້ນທີ່ເຮັດວຽກນັ້ນ."

msgid ""
"Creating a project without a workspace requires the site-wide :guilabel:`Add "
"new projects` permission."
msgstr ""
"ການສ້າງໂປຣເຈັກໂດຍບໍ່ມີພື້ນທີ່ເຮັດວຽກຕ້ອງການສິດ :guilabel:`Add new projects` ທັງເວັບໄຊ."

msgid ""
"When creating a project with the :ref:`api`, pass the workspace UUID in the "
"``workspace`` field."
msgstr "ເມື່ອສ້າງໂປຣເຈັກດ້ວຍ :ref:`api`, ໃຫ້ສົ່ງ UUID ຂອງພື້ນທີ່ເຮັດວຽກໃນຊ່ອງ ``workspace``."

msgid ""
"Existing projects can be moved between workspaces from the "
"project :guilabel:`Organize` tab or by changing the ``workspace`` field with "
"the :ref:`api`. Moving a project requires permission to edit the project and "
"the :guilabel:`Edit workspace settings` permission for the source and target "
"workspace. The target workspace also requires the :guilabel:`Add projects to "
"workspace` permission. Moving a project out of a workspace also requires the "
"site-wide :guilabel:`Add new projects` permission."
msgstr ""
"ໂປຣເຈັກທີ່ມີຢູ່ສາມາດຍ້າຍລະຫວ່າງພື້ນທີ່ເຮັດວຽກໄດ້ຈາກແຖບ :guilabel:`Organize` ຂອງໂປຣເຈັກ "
"ຫຼືໂດຍການປ່ຽນຊ່ອງ ``workspace`` ດ້ວຍ :ref:`api`. "
"ການຍ້າຍໂປຣເຈັກຕ້ອງການສິດໃນການແກ້ໄຂໂປຣເຈັກ ແລະສິດ :guilabel:`Edit workspace "
"settings` ສຳລັບພື້ນທີ່ເຮັດວຽກຕົ້ນທາງ ແລະປາຍທາງ. "
"ພື້ນທີ່ເຮັດວຽກປາຍທາງຍັງຕ້ອງການສິດ :guilabel:`Add projects to workspace`. "
"ການຍ້າຍໂປຣເຈັກອອກຈາກພື້ນທີ່ເຮັດວຽກຍັງຕ້ອງການສິດ :guilabel:`Add new projects` ທັງເວັບໄຊ."

msgid "Workspace settings"
msgstr "ການຕັ້ງຄ່າພື້ນທີ່ເຮັດວຽກ"

msgid ""
"Workspace settings define workspace identity and defaults inherited by "
"projects and components."
msgstr ""
"ການຕັ້ງຄ່າພື້ນທີ່ເຮັດວຽກກຳນົດຕົວຕົນຂອງພື້ນທີ່ເຮັດວຽກ ແລະຄ່າເລີ່ມຕົ້ນທີ່ຖືກສືບທອດໂດຍໂປຣເຈັກ "
"ແລະອົງປະກອບຕ່າງໆ."

msgid "Workspace name"
msgstr "ຊື່ພື້ນທີ່ເຮັດວຽກ"

msgid ""
"Verbose workspace name used in workspace listings and project organization."
msgstr "ຊື່ເຕັມຂອງພື້ນທີ່ເຮັດວຽກທີ່ໃຊ້ໃນລາຍການພື້ນທີ່ເຮັດວຽກ ແລະການຈັດລະບຽບໂປຣເຈັກ."

msgid ""
"Whether projects in this workspace can use translation memory shared within "
"the workspace. Individual projects also have to enable workspace translation "
"memory."
msgstr ""
"ວ່າໂປຣເຈັກໃນພື້ນທີ່ເຮັດວຽກນີ້ສາມາດໃຊ້ translation memory ທີ່ແບ່ງປັນພາຍໃນພື້ນທີ່ເຮັດວຽກໄດ້ຫຼືບໍ່. "
"ໂປຣເຈັກແຕ່ລະອັນຍັງຕ້ອງເປີດໃຊ້ translation memory ຂອງພື້ນທີ່ເຮັດວຽກນຳ."

msgid ""
"Whether projects in this workspace can contribute translations to the "
"workspace translation memory. Individual projects also have to enable "
"contribution."
msgstr ""
"ວ່າໂປຣເຈັກໃນພື້ນທີ່ເຮັດວຽກນີ້ສາມາດປະກອບສ່ວນການແປເຂົ້າສູ່ translation memory "
"ຂອງພື້ນທີ່ເຮັດວຽກໄດ້ຫຼືບໍ່. ໂປຣເຈັກແຕ່ລະອັນຍັງຕ້ອງເປີດໃຊ້ການປະກອບສ່ວນນຳ."

msgid ""
"Users with permission to edit the workspace can open :guilabel:`Operations` "
"↓ :guilabel:`Translation memory` to browse, download, delete, or rebuild "
"automatically created workspace translation-memory entries. See :ref:`memory-"
"user`."
msgstr ""
"ຜູ້ໃຊ້ທີ່ມີສິດແກ້ໄຂພື້ນທີ່ເຮັດວຽກສາມາດເປີດ :guilabel:`ການດຳເນີນການ` "
"↓ :guilabel:`ໜ່ວຍຄວາມຈຳການແປ` ເພື່ອເບິ່ງ, ດາວໂຫຼດ, ລຶບ, ຫຼື "
"ສ້າງລາຍການໜ່ວຍຄວາມຈຳການແປຂອງພື້ນທີ່ເຮັດວຽກທີ່ຖືກສ້າງຂຶ້ນອັດຕະໂນມັດຄືນໃໝ່. ເບິ່ງ :ref:`memory-"
"user`."

msgid ""
"Default translation license for projects and components in this workspace."
msgstr "ໃບອະນຸຍາດການແປເລີ່ມຕົ້ນສຳລັບໂປຣເຈັກ ແລະອົງປະກອບໃນພື້ນທີ່ເຮັດວຽກນີ້."

msgid ""
"Default contributor license agreement for projects and components in this "
"workspace. Markdown can be used for text formatting or inserting links."
msgstr ""
"ຂໍ້ຕົກລົງໃບອະນຸຍາດຜູ້ປະກອບສ່ວນເລີ່ມຕົ້ນສຳລັບໂປຣເຈັກ ແລະອົງປະກອບໃນພື້ນທີ່ເຮັດວຽກນີ້. Markdown "
"ສາມາດໃຊ້ສຳລັບການຈັດຮູບແບບຂໍ້ຄວາມ ຫຼືໃສ່ລິ້ງໄດ້."

msgid ""
"Default behavior for requests to create new translations in projects and "
"components in this workspace."
msgstr "ພຶດຕິກຳເລີ່ມຕົ້ນສຳລັບການຮ້ອງຂໍສ້າງການແປໃໝ່ໃນໂປຣເຈັກ ແລະອົງປະກອບໃນພື້ນທີ່ເຮັດວຽກນີ້."

msgid ""
"Default language code style for translations created by Weblate in projects "
"and components in this workspace."
msgstr ""
"ຮູບແບບລະຫັດພາສາເລີ່ມຕົ້ນສຳລັບການແປທີ່ສ້າງໂດຍ Weblate ໃນໂປຣເຈັກ ແລະອົງປະກອບໃນພື້ນທີ່ເຮັດວຽກນີ້."

msgid ""
"Default secondary language to show together with the source language while "
"translating projects and components in this workspace."
msgstr ""
"ພາສາສຳຮອງເລີ່ມຕົ້ນທີ່ຈະສະແດງຮ່ວມກັບພາສາຕົ້ນສະບັບໃນຂະນະແປໂປຣເຈັກ ແລະອົງປະກອບໃນພື້ນທີ່ເຮັດວຽກນີ້."

msgid ""
"Workspace-level translation flags. These are merged with project, component, "
"and translation flags instead of being inherited as a replacement."
msgstr ""
"ທຸງການແປໃນລະດັບພື້ນທີ່ເຮັດວຽກ. ສິ່ງເຫຼົ່ານີ້ຈະຖືກລວມເຂົ້າກັບທຸງຂອງໂປຣເຈັກ, ອົງປະກອບ, ແລະການແປ "
"ແທນທີ່ຈະຖືກສືບທອດມາເປັນການແທນທີ່."

msgid ""
"Default commit and merge request message templates for projects and "
"components in this workspace. These templates use the same markup as "
"component message settings."
msgstr ""
"ແມ່ແບບຂໍ້ຄວາມຄອມມິດ ແລະ merge request ເລີ່ມຕົ້ນສຳລັບໂປຣເຈັກ ແລະອົງປະກອບໃນພື້ນທີ່ເຮັດວຽກນີ້. "
"ແມ່ແບບເຫຼົ່ານີ້ໃຊ້ markup ດຽວກັນກັບການຕັ້ງຄ່າຂໍ້ຄວາມຂອງອົງປະກອບ."

msgid ""
"The built-in defaults follow Conventional Commits and include Weblate links "
"where available. Use :guilabel:`Restore site default` next to a message "
"editor to restore the current installation default for that message."
msgstr ""
"ຄ່າເລີ່ມຕົ້ນທີ່ມີໃນຕົວປະຕິບັດຕາມ Conventional Commits ແລະລວມເອົາລິ້ງ Weblate ບ່ອນທີ່ມີ. "
"ໃຊ້ :guilabel:`Restore site default` "
"ຖັດຈາກຕົວແກ້ໄຂຂໍ້ຄວາມເພື່ອຣີສະຕໍຄ່າເລີ່ມຕົ້ນຂອງການຕິດຕັ້ງປັດຈຸບັນສຳລັບຂໍ້ຄວາມນັ້ນ."

msgid "Settings inheritance"
msgstr "ການສືບທອດການຕັ້ງຄ່າ"

msgid ""
"Settings inheritance lets common defaults be configured once and reused in "
"lower scopes:"
msgstr "ການສືບທອດການຕັ້ງຄ່າຊ່ວຍໃຫ້ສາມາດຕັ້ງຄ່າເລີ່ມຕົ້ນທົ່ວໄປຄັ້ງດຽວ ແລະນຳໃຊ້ຊ້ຳໃນຂອບເຂດທີ່ຕ່ຳກວ່າ:"

msgid "Workspaces define defaults for projects in the workspace."
msgstr "ພື້ນທີ່ເຮັດວຽກກຳນົດຄ່າເລີ່ມຕົ້ນສຳລັບໂປຣເຈັກໃນພື້ນທີ່ເຮັດວຽກ."

msgid "Projects define defaults for categories and components in the project."
msgstr "ໂປຣເຈັກກຳນົດຄ່າເລີ່ມຕົ້ນສຳລັບໝວດໝູ່ ແລະອົງປະກອບໃນໂປຣເຈັກ."

msgid ""
"Categories define defaults for nested categories and components in the "
"category."
msgstr "ໝວດໝູ່ກຳນົດຄ່າເລີ່ມຕົ້ນສຳລັບໝວດໝູ່ທີ່ຊ້ອນກັນ ແລະອົງປະກອບໃນໝວດໝູ່ນັ້ນ."

msgid ""
"Components use the effective value from the nearest inherited scope unless "
"inheritance is disabled for that setting."
msgstr ""
"ອົງປະກອບໃຊ້ຄ່າທີ່ມີຜົນຈາກຂອບເຂດທີ່ສືບທອດມາທີ່ໃກ້ທີ່ສຸດ "
"ເວັ້ນເສຍແຕ່ວ່າການສືບທອດຈະຖືກປິດໄວ້ສຳລັບການຕັ້ງຄ່ານັ້ນ."

msgid ""
"This is available for translation license, contributor license agreement, "
"adding new translations, language code style, secondary language, and commit "
"message templates."
msgstr ""
"ສິ່ງນີ້ມີໃຫ້ສຳລັບໃບອະນຸຍາດການແປ, ຂໍ້ຕົກລົງໃບອະນຸຍາດຜູ້ປະກອບສ່ວນ, ການເພີ່ມການແປໃໝ່, "
"ຮູບແບບລະຫັດພາສາ, ພາສາສຳຮອງ, ແລະແມ່ແບບຂໍ້ຄວາມຄອມມິດ."

msgid ""
"Project, category, and component settings expose :guilabel:`Inherit from "
"workspace`, :guilabel:`Inherit from project`, or :guilabel:`Inherit from "
"category` checkboxes for these values. When inheritance is enabled, the "
"inherited value is shown in the settings form; disable inheritance and save "
"to edit the stored override value."
msgstr ""
"ການຕັ້ງຄ່າໂປຣເຈັກ, ໝວດໝູ່, ແລະອົງປະກອບຈະເປີດເຜີຍກ່ອງກາໝາຍ :guilabel:`Inherit from "
"workspace`, :guilabel:`Inherit from project`, ຫຼື :guilabel:`Inherit from "
"category` ສຳລັບຄ່າເຫຼົ່ານີ້. ເມື່ອເປີດໃຊ້ການສືບທອດ, ຄ່າທີ່ສືບທອດມາຈະຖືກສະແດງໃນແບບຟອມການຕັ້ງຄ່າ; "
"ໃຫ້ປິດການສືບທອດ ແລະບັນທຶກເພື່ອແກ້ໄຂຄ່າ override ທີ່ຖືກຈັດເກັບໄວ້."

msgid ""
"Translation flags are handled differently. Workspace, project, category, "
"component, and translation flags are merged, so each level can add flags "
"without replacing the lower levels."
msgstr ""
"ທຸງການແປຖືກຈັດການແຕກຕ່າງອອກໄປ. ທຸງຂອງພື້ນທີ່ເຮັດວຽກ, ໂປຣເຈັກ, ໝວດໝູ່, ອົງປະກອບ, "
"ແລະການແປຈະຖືກລວມເຂົ້າກັນ, ດັ່ງນັ້ນແຕ່ລະລະດັບສາມາດເພີ່ມທຸງໄດ້ໂດຍບໍ່ຕ້ອງແທນທີ່ລະດັບທີ່ຕ່ຳກວ່າ."

msgid ""
"When a workspace is created, these defaults are copied from the current "
"installation defaults. Later changes to installation defaults do not update "
"existing workspaces."
msgstr ""
"ເມື່ອພື້ນທີ່ເຮັດວຽກຖືກສ້າງຂຶ້ນ, ຄ່າເລີ່ມຕົ້ນເຫຼົ່ານີ້ຈະຖືກສຳເນົາຈາກຄ່າເລີ່ມຕົ້ນຂອງການຕິດຕັ້ງປັດຈຸບັນ. "
"ການປ່ຽນແປງຄ່າເລີ່ມຕົ້ນຂອງການຕິດຕັ້ງໃນພາຍຫຼັງຈະບໍ່ອັບເດດພື້ນທີ່ເຮັດວຽກທີ່ມີຢູ່."

msgid ""
"Workspace-less projects also store their own defaults when created and do "
"not inherit from a workspace unless moved into one and configured to inherit."
msgstr ""
"ໂປຣເຈັກທີ່ບໍ່ມີພື້ນທີ່ເຮັດວຽກກໍຈັດເກັບຄ່າເລີ່ມຕົ້ນຂອງຕົນເອງໃນເວລາສ້າງ "
"ແລະຈະບໍ່ສືບທອດຈາກພື້ນທີ່ເຮັດວຽກເວັ້ນເສຍແຕ່ວ່າຈະຖືກຍ້າຍເຂົ້າໄປໃນພື້ນທີ່ເຮັດວຽກ ແລະຖືກຕັ້ງຄ່າໃຫ້ສືບທອດ."

msgid ""
"When upgrading existing installations, Weblate consolidates matching "
"settings: if all components in a project use the same value, the value is "
"moved to the project and those components inherit it. The same consolidation "
"is then applied from projects to workspaces. Category settings are "
"initialized to inherit from their parent and matching explicit child "
"overrides can be consolidated to the category. Differing values remain "
"configured directly on the lower scope."
msgstr ""
"ເມື່ອອັບເກຣດການຕິດຕັ້ງທີ່ມີຢູ່, Weblate ຈະລວມການຕັ້ງຄ່າທີ່ກົງກັນ: "
"ຖ້າອົງປະກອບທັງໝົດໃນໂປຣເຈັກໃຊ້ຄ່າດຽວກັນ, ຄ່ານັ້ນຈະຖືກຍ້າຍໄປທີ່ໂປຣເຈັກ "
"ແລະອົງປະກອບເຫຼົ່ານັ້ນຈະສືບທອດມັນ. ການລວມຕົວດຽວກັນຈະຖືກນຳໃຊ້ຈາກໂປຣເຈັກໄປສູ່ພື້ນທີ່ເຮັດວຽກ. "
"ການຕັ້ງຄ່າໝວດໝູ່ຈະຖືກເລີ່ມຕົ້ນໃຫ້ສືບທອດຈາກແມ່ຂອງມັນ ແລະການ override "
"ທີ່ຊັດເຈນຂອງລູກທີ່ກົງກັນສາມາດລວມເຂົ້າກັບໝວດໝູ່ໄດ້. "
"ຄ່າທີ່ແຕກຕ່າງກັນຈະຍັງຄົງຖືກຕັ້ງຄ່າໂດຍກົງໃນຂອບເຂດທີ່ຕ່ຳກວ່າ."

msgid ""
"Workspaces have workspace-scoped teams. These teams control workspace-level "
"actions only; they do not grant translation access to the projects in the "
"workspace."
msgstr ""
"ພື້ນທີ່ເຮັດວຽກມີທີມງານໃນຂອບເຂດພື້ນທີ່ເຮັດວຽກ. "
"ທີມງານເຫຼົ່ານີ້ຄວບຄຸມສະເພາະການກະທຳໃນລະດັບພື້ນທີ່ເຮັດວຽກເທົ່ານັ້ນ; "
"ພວກມັນບໍ່ໃຫ້ສິດການແປໃນໂປຣເຈັກພາຍໃນພື້ນທີ່ເຮັດວຽກ."

msgid "The default workspace teams are:"
msgstr "ທີມງານພື້ນທີ່ເຮັດວຽກເລີ່ມຕົ້ນແມ່ນ:"

msgid "`Owners`"
msgstr "`ເຈົ້າຂອງ (Owners)`"

msgid ""
"Can edit workspace settings, add projects to the workspace, manage workspace "
"access, and view or pay billing plans assigned to the workspace."
msgstr ""
"ສາມາດແກ້ໄຂການຕັ້ງຄ່າພື້ນທີ່ເຮັດວຽກ, ເພີ່ມໂປຣເຈັກເຂົ້າໃນພື້ນທີ່ເຮັດວຽກ, ຈັດການການເຂົ້າເຖິງພື້ນທີ່ເຮັດວຽກ, "
"ແລະເບິ່ງ ຫຼືຈ່າຍຄ່າແຜນການເກັບເງິນທີ່ມອບໝາຍໃຫ້ພື້ນທີ່ເຮັດວຽກ."

msgid "Can add projects to the workspace."
msgstr "ສາມາດເພີ່ມໂປຣເຈັກເຂົ້າໃນພື້ນທີ່ເຮັດວຽກໄດ້."

msgid ""
"Users can still view a workspace page when they can access at least one "
"project in that workspace. This does not grant billing access or permission "
"to add more projects."
msgstr ""
"ຜູ້ໃຊ້ຍັງສາມາດເບິ່ງໜ້າພື້ນທີ່ເຮັດວຽກໄດ້ເມື່ອພວກເຂົາສາມາດເຂົ້າເຖິງຢ່າງໜ້ອຍໜຶ່ງໂປຣເຈັກໃນພື້ນທີ່ເຮັດວຽກນັ້ນ. "
"ສິ່ງນີ້ບໍ່ໄດ້ໃຫ້ສິດເຂົ້າເຖິງການເກັບເງິນ ຫຼືສິດໃນການເພີ່ມໂປຣເຈັກເພີ່ມເຕີມ."

msgid ""
"When :ref:`billing` is enabled, a billing plan is assigned to a workspace. "
"Projects in that workspace count against the workspace billing plan."
msgstr ""
"ເມື່ອ :ref:`billing` ຖືກເປີດໃຊ້, ແຜນການເກັບເງິນຈະຖືກມອບໝາຍໃຫ້ພື້ນທີ່ເຮັດວຽກ. "
"ໂປຣເຈັກໃນພື້ນທີ່ເຮັດວຽກນັ້ນຈະຖືກນັບລວມເຂົ້າໃນແຜນການເກັບເງິນຂອງພື້ນທີ່ເຮັດວຽກນັ້ນ."

msgid ""
"Users with :guilabel:`Edit workspace settings` permission can view and pay "
"the billing plan. Billing notification e-mails are sent to these users."
msgstr ""
"ຜູ້ໃຊ້ທີ່ມີສິດ :guilabel:`Edit workspace settings` ສາມາດເບິ່ງ ແລະຈ່າຍຄ່າແຜນການເກັບເງິນໄດ້. "
"ອີເມວແຈ້ງເຕືອນການເກັບເງິນຈະຖືກສົ່ງຫາຜູ້ໃຊ້ເຫຼົ່ານີ້."

msgid ""
"Billing is optional. Workspaces are still available when the billing module "
"is not installed."
msgstr "ການເກັບເງິນເປັນທາງເລືອກ. ພື້ນທີ່ເຮັດວຽກຍັງຄົງມີໃຫ້ໃຊ້ງານເມື່ອໂມດູນການເກັບເງິນບໍ່ໄດ້ຖືກຕິດຕັ້ງ."

msgid "Upgrading from billing owners"
msgstr "ການອັບເກຣດຈາກເຈົ້າຂອງການເກັບເງິນ"

msgid ""
"Older Weblate versions stored billing owners directly on billing plans. "
"These users are migrated to the workspace :guilabel:`Owners` team for the "
"workspace covered by the billing plan."
msgstr ""
"Weblate ເວີຊັນເກົ່າຈະຈັດເກັບເຈົ້າຂອງການເກັບເງິນໂດຍກົງໃນແຜນການເກັບເງິນ. "
"ຜູ້ໃຊ້ເຫຼົ່ານີ້ຈະຖືກຍ້າຍໄປຍັງທີມງານ :guilabel:`Owners` "
"ຂອງພື້ນທີ່ເຮັດວຽກທີ່ກວມເອົາໂດຍແຜນການເກັບເງິນນັ້ນ."

msgid "Weblate's REST API"
msgstr "REST API ຂອງ Weblate"

msgid ""
"The API is accessible on the ``/api/`` URL and it is based on `Django REST "
"framework <https://www.django-rest-framework.org/>`_. You can use it "
"directly or by :ref:`wlc`."
msgstr ""
"API ສາມາດເຂົ້າເຖິງໄດ້ທີ່ URL ``/api/`` ແລະມັນອີງໃສ່ `Django REST framework <https://"
"www.django-rest-framework.org/>`_. ທ່ານສາມາດໃຊ້ໂດຍກົງ ຫຼືຜ່ານ :ref:`wlc`."

msgid ""
"The API is also documented using OpenAPI 3.1 on the ``/api/schema/`` URL, "
"you can browse at ``/api/docs/``."
msgstr ""
"API ຍັງຖືກຈັດເອກະສານໂດຍໃຊ້ OpenAPI 3.1 ທີ່ URL ``/api/schema/``, ທ່ານສາມາດເບິ່ງໄດ້ທີ່ ``/"
"api/docs/``."

msgid ""
"OpenAPI is available as a feature preview. The documentation is most likely "
"incomplete at this point and subject to change. Please consult the "
"documentation below for more detailed information on the API."
msgstr ""
"OpenAPI ມີໃຫ້ໃຊ້ງານເປັນຕົວຢ່າງຟີເຈີ. ເອກະສານມີຄວາມເປັນໄປໄດ້ສູງທີ່ຈະບໍ່ສົມບູນໃນຈຸດນີ້ "
"ແລະສາມາດມີການປ່ຽນແປງ. ກະລຸນາປຶກສາເອກະສານຂ້າງລຸ່ມນີ້ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບ API."

msgid "Authentication and generic parameters"
msgstr "ການຢືນຢັນຕົວຕົນ ແລະພາຣາມິເຕີທົ່ວໄປ"

msgid ""
"The read-only API is available without authentication "
"unless :setting:`REQUIRE_LOGIN` is turned on. Unauthenticated requests are "
"heavily throttled (by default to 100 requests per day), so it is recommended "
"to use authentication."
msgstr ""
"API ແບບອ່ານຢ່າງດຽວສາມາດໃຊ້ໄດ້ໂດຍບໍ່ຕ້ອງຢືນຢັນຕົວຕົນ ເວັ້ນເສຍແຕ່ວ່າ :setting:`REQUIRE_LOGIN` "
"ຈະຖືກເປີດໃຊ້. ການຮ້ອງຂໍທີ່ບໍ່ໄດ້ຢືນຢັນຕົວຕົນຈະຖືກຈຳກັດຢ່າງໜັກ (ຕາມຄ່າເລີ່ມຕົ້ນແມ່ນ 100 ຄັ້ງຕໍ່ມື້), "
"ສະນັ້ນແນະນຳໃຫ້ໃຊ້ການຢືນຢັນຕົວຕົນ."

msgid ""
"The authentication uses a token, which you can get in your profile. Use it "
"in the ``Authorization`` header:"
msgstr ""
"ການຢືນຢັນຕົວຕົນໃຊ້ token, ເຊິ່ງທ່ານສາມາດໄດ້ຮັບໃນໂປຣໄຟລ໌ຂອງທ່ານ. ໃຊ້ໃນ header "
"``Authorization``:"

msgid "Authentication tokens"
msgstr "Token ການຢືນຢັນຕົວຕົນ"

msgid "Project scoped tokens were introduced in the 4.10 release."
msgstr "Token ທີ່ກຳນົດຂອບເຂດໂປຣເຈັກຖືກນຳສະເໜີໃນເວີຊັນ 4.10."

msgid ""
"Each user has a personal access token which can be obtained in the user "
"profile. Newly generated user tokens have the ``wlu_`` prefix."
msgstr ""
"ຜູ້ໃຊ້ແຕ່ລະຄົນມີ token ການເຂົ້າເຖິງສ່ວນຕົວເຊິ່ງສາມາດຮັບໄດ້ໃນໂປຣໄຟລ໌ຜູ້ໃຊ້. Token ຜູ້ໃຊ້ທີ່ສ້າງຂຶ້ນໃໝ່ຈະມີ "
"prefix ``wlu_``."

msgid ""
"It is possible to create project scoped tokens for API access to given "
"project only. These tokens can be identified by the ``wlp_`` prefix."
msgstr ""
"ມັນສາມາດສ້າງ token ທີ່ມີຂອບເຂດໂປຣເຈັກສຳລັບການເຂົ້າເຖິງ API ໃຫ້ກັບໂປຣເຈັກທີ່ກຳນົດເທົ່ານັ້ນ. Token "
"ເຫຼົ່ານີ້ສາມາດລະບຸໄດ້ໂດຍ prefix ``wlp_``."

msgid "Authentication examples"
msgstr "ຕົວຢ່າງການຢືນຢັນຕົວຕົນ"

msgid "**Example request:**"
msgstr "**ຕົວຢ່າງການຮ້ອງຂໍ:**"

msgid "**Example response:**"
msgstr "**ຕົວຢ່າງການຕອບສະໜອງ:**"

msgid "**CURL example:**"
msgstr "**ຕົວຢ່າງ CURL:**"

msgid "Passing Parameters Examples"
msgstr "ຕົວຢ່າງການສົ່ງພາຣາມິເຕີ"

msgid ""
"For the :http:method:`POST` method the parameters can be specified either as "
"form submission (:mimetype:`application/x-www-form-urlencoded`) or as JSON "
"(:mimetype:`application/json`)."
msgstr ""
"ສຳລັບ method :http:method:`POST`, ພາຣາມິເຕີສາມາດລະບຸໄດ້ທັງແບບການສົ່ງຟອມ "
"(:mimetype:`application/x-www-form-urlencoded`) ຫຼືແບບ JSON "
"(:mimetype:`application/json`)."

msgid "**Form request example:**"
msgstr "**ຕົວຢ່າງການຮ້ອງຂໍແບບຟອມ:**"

msgid "**JSON request example:**"
msgstr "**ຕົວຢ່າງການຮ້ອງຂໍແບບ JSON:**"

msgid "**CURL JSON example:**"
msgstr "**ຕົວຢ່າງ CURL JSON:**"

msgid "Components and categories"
msgstr "ອົງປະກອບ ແລະໝວດໝູ່"

msgid ""
"To access a component which is nested inside a :ref:`category`, you need to "
"URL encode the category name into a component name separated with a slash. "
"For example ``usage`` placed in a ``docs`` category needs to be used as "
"``docs%252Fusage``. Full URL in this case would be for example ``https://"
"example.com/api/components/hello/docs%252Fusage/repository/``."
msgstr ""
"ເພື່ອເຂົ້າເຖິງອົງປະກອບທີ່ຊ້ອນຢູ່ໃນ :ref:`category`, ທ່ານຕ້ອງເຂົ້າລະຫັດ URL "
"ຂອງຊື່ໝວດໝູ່ເຂົ້າໄປໃນຊື່ອົງປະກອບທີ່ແຍກດ້ວຍເຄື່ອງໝາຍ slash. ຕົວຢ່າງເຊັ່ນ ``usage`` ທີ່ວາງຢູ່ໃນໝວດໝູ່ "
"``docs`` ຕ້ອງຖືກໃຊ້ເປັນ ``docs%252Fusage``. URL ເຕັມໃນກໍລະນີນີ້ຈະເປັນ ``https://"
"example.com/api/components/hello/docs%252Fusage/repository/``."

msgid "API rate limiting"
msgstr "ການຈຳກັດອັດຕາ API"

msgid ""
"The API requests are rate limited; the default configuration limits it to "
"100 requests per day for anonymous users and 5000 requests per hour for "
"authenticated users."
msgstr ""
"ການຮ້ອງຂໍ API ຖືກຈຳກັດອັດຕາ; ການຕັ້ງຄ່າເລີ່ມຕົ້ນຈຳກັດໄວ້ທີ່ 100 ຄັ້ງຕໍ່ມື້ສຳລັບຜູ້ໃຊ້ທີ່ບໍ່ລະບຸຕົວຕົນ ແລະ "
"5000 ຄັ້ງຕໍ່ຊົ່ວໂມງສຳລັບຜູ້ໃຊ້ທີ່ຢືນຢັນຕົວຕົນ."

msgid ""
"Rate limiting can be adjusted in the :file:`settings.py`; see `Throttling in "
"Django REST framework documentation <https://www.django-rest-framework.org/"
"api-guide/throttling/>`_ for more details how to configure it."
msgstr ""
"ການຈຳກັດອັດຕາສາມາດປັບປ່ຽນໄດ້ໃນ :file:`settings.py`; ເບິ່ງ `Throttling in Django "
"REST framework documentation <https://www.django-rest-framework.org/api-"
"guide/throttling/>`_ ສຳລັບລາຍລະອຽດເພີ່ມເຕີມກ່ຽວກັບວິທີການຕັ້ງຄ່າ."

msgid ""
"In the Docker container this can be configured "
"using :envvar:`WEBLATE_API_RATELIMIT_ANON` "
"and :envvar:`WEBLATE_API_RATELIMIT_USER`."
msgstr ""
"ໃນ Docker container ສາມາດຕັ້ງຄ່າໄດ້ໂດຍໃຊ້ :envvar:`WEBLATE_API_RATELIMIT_ANON` "
"ແລະ :envvar:`WEBLATE_API_RATELIMIT_USER`."

msgid "The status of rate limiting is reported in following headers:"
msgstr "ສະຖານະຂອງການຈຳກັດອັດຕາຖືກລາຍງານໃນ headers ຕໍ່ໄປນີ້:"

msgid "Allowed number of requests to perform"
msgstr "ຈຳນວນຄຳຮ້ອງຂໍທີ່ອະນຸຍາດໃຫ້ດຳເນີນການ"

msgid "Remaining number of requests to perform"
msgstr "ຈຳນວນຄຳຮ້ອງຂໍທີ່ຍັງເຫຼືອ"

msgid "Number of seconds until the rate-limit window resets"
msgstr "ຈຳນວນວິນາທີຈົນກວ່າຂີດຈຳກັດຄວາມຖີ່ຈະຖືກຕັ້ງຄ່າໃໝ່"

msgid "Added ratelimiting status headers."
msgstr "ເພີ່ມ headers ສະຖານະການຈຳກັດອັດຕາ."

msgid "Error responses"
msgstr "ການຕອບສະໜອງຜິດພາດ"

msgid "Error responses were endpoint specific before this release."
msgstr "ການຕອບສະໜອງຜິດພາດເປັນແບບສະເພາະ endpoint ກ່ອນເວີຊັນນີ້."

msgid ""
"Weblate error responses are formatted based on :doc:`drf-standardized-"
"error:error_response`."
msgstr ""
"ການຕອບສະໜອງຜິດພາດຂອງ Weblate ຖືກຈັດຮູບແບບໂດຍອີງໃສ່ :doc:`drf-standardized-"
"error:error_response`."

msgid "API Entry Point"
msgstr "ຈຸດເຂົ້າ API"

msgid "Users"
msgstr "ຜູ້ໃຊ້"

msgid "User profile"
msgstr "ໂປຣໄຟລ໌ຜູ້ໃຊ້"

msgid ""
"The user API exposes profile preferences in a nested ``profile`` object. The "
"object is returned on :http:get:`/api/users/(str:username)/` only for "
"callers with the ``user.view`` or ``user.edit`` permission. Users without "
"those permissions can still update their own profile through :http:patch:`/"
"api/users/(str:username)/`; the response then includes the updated "
"``profile`` object."
msgstr ""
"API ຜູ້ໃຊ້ສະແດງການຕັ້ງຄ່າໂປຣໄຟລ໌ໃນວັດຖຸ ``profile`` ທີ່ຊ້ອນຢູ່ທາງໃນ. "
"ວັດຖຸດັ່ງກ່າວຈະຖືກສົ່ງກັບມາຈາກ :http:get:`/api/users/(str:username)/` ສະເພາະຜູ້ຮ້ອງຂໍທີ່ມີສິດ "
"``user.view`` ຫຼື ``user.edit`` ເທົ່ານັ້ນ. "
"ຜູ້ໃຊ້ທີ່ບໍ່ມີສິດເຫຼົ່ານັ້ນຍັງສາມາດອັບເດດໂປຣໄຟລ໌ຂອງຕົນເອງໄດ້ຜ່ານ :http:patch:`/api/users/"
"(str:username)/`; ຈາກນັ້ນການຕອບກັບຈະລວມເອົາວັດຖຸ ``profile`` ທີ່ອັບເດດແລ້ວ."

msgid "Profile fields mirror the settings described in :ref:`user-profile`."
msgstr "ຟິວໃນໂປຣໄຟລ໌ແມ່ນຄືກັນກັບການຕັ້ງຄ່າທີ່ອະທິບາຍໄວ້ໃນ :ref:`user-profile`."

msgid "Groups"
msgstr "ກຸ່ມ"

msgid "Projects"
msgstr "ໂຄງການ"

msgid ""
"Use :http:post:`/api/projects/(string:project)/components/` to create new "
"components."
msgstr ""
"ໃຊ້ :http:post:`/api/projects/(string:project)/components/` ເພື່ອສ້າງອົງປະກອບໃໝ່."

msgid "Translations"
msgstr "ການແປ"

msgid "Memory"
msgstr "ໜ່ວຍຄວາມຈຳ"

msgid "Units"
msgstr "ໜ່ວຍຂໍ້ມູນ"

msgid ""
"A `unit` is a single piece of a translation which pairs a source string with "
"a corresponding translated string and also contains some related metadata. "
"The term is derived from "
"the :py:class:`tt:translate.storage.base.TranslationUnit` in Translate "
"Toolkit and XLIFF."
msgstr ""
"`ໜ່ວຍຂໍ້ມູນ (unit)` ແມ່ນສ່ວນໜຶ່ງຂອງການແປທີ່ຈັບຄູ່ຂໍ້ຄວາມຕົ້ນສະບັບກັບຂໍ້ຄວາມທີ່ແປແລ້ວ ແລະຍັງມີ metadata "
"ທີ່ກ່ຽວຂ້ອງບາງຢ່າງ. "
"ຄຳສັບນີ້ໄດ້ມາຈາກ :py:class:`tt:translate.storage.base.TranslationUnit` ໃນ "
"Translate Toolkit ແລະ XLIFF."

msgid "Suggestions"
msgstr "ຄຳແນະນຳ"

msgid "Changes"
msgstr "ການປ່ຽນແປງ"

msgid "Screenshots"
msgstr "ພາບໜ້າຈໍ"

msgid "Component lists"
msgstr "ລາຍຊື່ສ່ວນປະກອບ"

msgid "Glossary"
msgstr "ຄຳສັບສະເພາະ"

msgid ""
"Glossaries are now stored as regular components, translations and strings, "
"please use respective API instead."
msgstr ""
"ອະພິທານສັບປັດຈຸບັນຖືກຈັດເກັບເປັນອົງປະກອບ, ການແປ ແລະຂໍ້ຄວາມປົກກະຕິ, ກະລຸນາໃຊ້ API ທີ່ກ່ຽວຂ້ອງແທນ."

msgid "Reports"
msgstr "ລາຍງານ"

msgid "Tasks"
msgstr "ວຽກງານ"

msgid "Statistics"
msgstr "ສະຖິຕິ"

msgid "Metrics"
msgstr "ຕົວຊີ້ວັດ"

msgid ""
"Project metrics expose translation statistics for each visible component and "
"language at :http:get:`/api/projects/(string:project)/metrics/`. They "
"include translated, total, fuzzy, failing-check, and approved string, word, "
"and character counts; suggestions; comments; and translated and approved "
"percentages."
msgstr ""
"ຕົວຊີ້ວັດໂຄງການສະແດງສະຖິຕິການແປສຳລັບແຕ່ລະສ່ວນປະກອບ ແລະ ພາສາທີ່ເບິ່ງເຫັນໄດ້ທີ່ :http:get:`/api/"
"projects/(string:project)/metrics/`. ເຊິ່ງລວມມີຈຳນວນຂໍ້ຄວາມທີ່ແປແລ້ວ, ຈຳນວນທັງໝົດ, "
"fuzzy, ຂໍ້ຄວາມທີ່ກວດສອບບໍ່ຜ່ານ, ແລະ ຂໍ້ຄວາມທີ່ໄດ້ຮັບການອະນຸມັດ; ຈຳນວນຄຳ ແລະ ຕົວອັກສອນ; "
"ຄຳແນະນຳ; ຄຳຄິດເຫັນ; ແລະ ເປີເຊັນການແປ ແລະ ການອະນຸມັດ."

msgid "Search"
msgstr "ຄົ້ນຫາ"

msgid "Categories"
