msgid "Access control"
msgstr "ການຄວບຄຸມການເຂົ້າເຖິງ"

msgid ""
"Weblate comes with a fine-grained privilege system to assign user "
"permissions for the whole instance with predefined roles, or by assigning "
"one or more groups of permissions to users for everything, or individual "
"projects, components, glossaries, and so on."
msgstr ""
"Weblate ມາພ້ອມກັບລະບົບສິດທິພິເສດແບບລະອຽດ ເພື່ອກຳນົດສິດການໃຊ້ງານຂອງຜູ້ໃຊ້ "
"ສຳລັບທັງລະບົບໂດຍໃຊ້ບົດບາດທີ່ກຳນົດໄວ້ລ່ວງໜ້າ, ຫຼືໂດຍການກຳນົດກຸ່ມສິດທິໜຶ່ງ ຫຼື "
"ຫຼາຍກຸ່ມໃຫ້ກັບຜູ້ໃຊ້ສຳລັບທຸກຢ່າງ, ຫຼື ເຈາະຈົງສະເພາະໂຄງການ, ອົງປະກອບ, ຄຳສັບ, ແລະ ອື່ນໆ."

msgid "Project access control"
msgstr "ການຄວບຄຸມການເຂົ້າເຖິງໂຄງການ"

msgid ""
"Projects running the gratis Libre plan on Hosted Weblate are "
"always :guilabel:`Public`. You can switch to the paid plan if you want to "
"restrict access to your project."
msgstr ""
"ໂຄງການທີ່ໃຊ້ແຜນ Libre ຟຣີໃນ Hosted Weblate ຈະເປັນ :guilabel:`ສາທາລະນະ` ສະເໝີ. "
"ທ່ານສາມາດປ່ຽນໄປໃຊ້ແຜນແບບເສຍເງິນໄດ້ຫາກຕ້ອງການຈຳກັດການເຂົ້າເຖິງໂຄງການຂອງທ່ານ."

msgid ""
"Limit user access to individual projects by selecting a "
"different :ref:`project-access_control` setting. The available options are:"
msgstr ""
"ຈຳກັດການເຂົ້າເຖິງຂອງຜູ້ໃຊ້ໃນແຕ່ລະໂຄງການໂດຍການເລືອກການຕັ້ງຄ່າ :ref:`project-"
"access_control` ທີ່ແຕກຕ່າງກັນ. ຕົວເລືອກທີ່ມີໃຫ້ມີດັ່ງນີ້:"

msgid ":guilabel:`Public`"
msgstr ":guilabel:`ສາທາລະນະ`"

msgid "Visible to everybody."
msgstr "ທຸກຄົນສາມາດເຫັນໄດ້."

msgid "Any authenticated user can contribute."
msgstr "ຜູ້ໃຊ້ທີ່ເຂົ້າສູ່ລະບົບແລ້ວທຸກຄົນສາມາດປະກອບສ່ວນໄດ້."

msgid "VCS repository might be exposed to everybody."
msgstr "ບ່ອນເກັບຂໍ້ມູນ VCS ອາດຖືກເປີດເຜີຍຕໍ່ທຸກຄົນ."

msgid ""
"**Choose this for open-source projects, or when your Weblate instance is "
"private or locked-down.**"
msgstr ""
"**ເລືອກອັນນີ້ສຳລັບໂຄງການໂອເພນຊອດ, ຫຼື ເມື່ອລະບົບ Weblate ຂອງທ່ານເປັນສ່ວນຕົວ ຫຼື ຖືກລັອກໄວ້.**"

msgid ":guilabel:`Protected`"
msgstr ":guilabel:`ປົກປ້ອງ`"

msgid "Only chosen users can contribute."
msgstr "ສະເພາະຜູ້ໃຊ້ທີ່ຖືກເລືອກເທົ່ານັ້ນທີ່ສາມາດປະກອບສ່ວນໄດ້."

msgid "Only chosen users can access VCS repository."
msgstr "ສະເພາະຜູ້ໃຊ້ທີ່ຖືກເລືອກເທົ່ານັ້ນຈຶ່ງສາມາດເຂົ້າເຖິງຄັງເກັບ VCS ໄດ້."

msgid ""
"**Choose this to gain visibility, but still have control over who can "
"contribute.**"
msgstr "**ເລືອກອັນນີ້ເພື່ອເພີ່ມການເບິ່ງເຫັນ, ແຕ່ຍັງຄົງຄວບຄຸມໄດ້ວ່າໃຜສາມາດປະກອບສ່ວນໄດ້.**"

msgid ":guilabel:`Private`"
msgstr ":guilabel:`ສ່ວນຕົວ`"

msgid "Visible only to chosen users."
msgstr "ເຫັນໄດ້ສະເພາະຜູ້ໃຊ້ທີ່ຖືກເລືອກເທົ່ານັ້ນ."

msgid ""
"**Choose this for projects that should not be exposed publicly at all.**"
msgstr "**ເລືອກອັນນີ້ສຳລັບໂຄງການທີ່ບໍ່ຕ້ອງການໃຫ້ເປີດເຜີຍຕໍ່ສາທາລະນະເລີຍ.**"

msgid ":guilabel:`Custom`"
msgstr ":guilabel:`ກຳນົດເອງ`"

msgid "Not available on Hosted Weblate."
msgstr "ບໍ່ມີໃຫ້ໃຊ້ງານໃນ Hosted Weblate."

msgid "You will have to set up all the permissions using :ref:`custom-acl`."
msgstr "ທ່ານຈະຕ້ອງຕັ້ງຄ່າສິດທິທັງໝົດໂດຍໃຊ້ :ref:`custom-acl`."

msgid ""
"**Choose this on your own Weblate instance if you want to define access in a "
"specific, finely customizable way.**"
msgstr ""
"**ເລືອກອັນນີ້ໃນລະບົບ Weblate ຂອງທ່ານເອງ ຫາກທ່ານຕ້ອງການກຳນົດການເຂົ້າເຖິງໃນແບບສະເພາະ "
"ທີ່ສາມາດປັບແຕ່ງໄດ້ຢ່າງລະອຽດ.**"

msgid ""
":guilabel:`Access control` can be changed in the :guilabel:`Access` tab of "
"the configuration (:guilabel:`Operations` ↓ :guilabel:`Settings`) of each "
"respective project."
msgstr ""
":guilabel:`ການຄວບຄຸມການເຂົ້າເຖິງ` ສາມາດປ່ຽນແປງໄດ້ໃນແຖບ :guilabel:`ການເຂົ້າເຖິງ` "
"ຂອງການຕັ້ງຄ່າ (:guilabel:`ການດຳເນີນງານ` ↓ :guilabel:`ການຕັ້ງຄ່າ`) ຂອງແຕ່ລະໂຄງການ."

msgid ""
"The default can also be changed by setting :setting:`DEFAULT_ACCESS_CONTROL`."
msgstr "ຄ່າເລີ່ມຕົ້ນຍັງສາມາດປ່ຽນແປງໄດ້ໂດຍການຕັ້ງຄ່າ :setting:`DEFAULT_ACCESS_CONTROL`."

#, fuzzy
#| msgid ""
#| "Aggregate statistics include `Private` projects and :ref:`restricted "
#| "components <component-restricted>`, including in site-wide, language, and "
#| "workspace summaries. Object listings, names, and actions remain "
#| "permission-filtered, so these aggregates do not grant access to the "
#| "underlying projects or components."
msgid ""
"Aggregate statistics include `Private` projects and :ref:`restricted "
"components <component-restricted>`, including in site-wide, language, and "
"workspace summaries. Object listings, names, and actions in the web "
"interface and API remain permission-filtered, so these aggregates do not "
"grant access to the underlying projects or components."
msgstr ""
"ສະຖິຕິລວມແມ່ນລວມເອົາໂຄງການ `ສ່ວນຕົວ` ແລະ :ref:`ສ່ວນປະກອບທີ່ຖືກຈຳກັດ <component-"
"restricted>`, ເຊິ່ງລວມມີບົດສະຫຼຸບທົ່ວລະບົບ, ພາສາ, ແລະ ພື້ນທີ່ເຮັດວຽກ. ການສະແດງລາຍການວັດຖຸ, "
"ຊື່, ແລະ ການດຳເນີນການຕ່າງໆ ຍັງຄົງຖືກກັ່ນຕອງຕາມການອະນຸຍາດ, "
"ດັ່ງນັ້ນຂໍ້ມູນລວມເຫຼົ່ານີ້ຈຶ່ງບໍ່ໄດ້ໃຫ້ສິດເຂົ້າເຖິງໂຄງການ ຫຼື ສ່ວນປະກອບພື້ນຖານ."

msgid ""
"Generic incoming :ref:`notification hooks <hooks>` are an explicit "
"compatibility exception to identifier confidentiality. When supplied with a "
"matching repository URL, their diagnostic response includes match counts "
"and, when an update is scheduled, the project/component slug and API URL. "
"This also applies to `Private` projects and restricted components, except "
"components managed through an authenticated integration. The API URL does "
"not bypass access control, and no project content or credentials are "
"included. See :ref:`hooks-target-matching`."
msgstr ""

msgid ""
"Instance administrators can modify the default permission sets available to "
"users in `Public`, `Protected`, and `Private` projects by using :ref:`custom "
"settings <custom-acl>`."
msgstr ""
"ຜູ້ດູແລລະບົບສາມາດແກ້ໄຂຊຸດສິດທິພິເສດເລີ່ມຕົ້ນທີ່ມີໃຫ້ສຳລັບຜູ້ໃຊ້ໃນໂຄງການ `ສາທາລະນະ`, `ປົກປ້ອງ`, ແລະ "
"`ສ່ວນຕົວ` ໂດຍການໃຊ້ :ref:`ການຕັ້ງຄ່າແບບກຳນົດເອງ <custom-acl>`."

msgid "Workspace access control"
msgstr "ການຄວບຄຸມການເຂົ້າເຖິງພື້ນທີ່ເຮັດວຽກ"

msgid "Workspace-scoped teams are documented in :ref:`workspace-acl`."
msgstr "ທີມໃນລະດັບພື້ນທີ່ເຮັດວຽກມີເອກະສານລະບຸໄວ້ໃນ :ref:`workspace-acl`."

msgid "Managing per-project access control"
msgstr "ການຈັດການການຄວບຄຸມການເຂົ້າເຖິງລາຍໂຄງການ"

msgid "For `Public`, `Protected` and `Private` projects:"
msgstr "ສຳລັບໂຄງການ `ສາທາລະນະ`, `ປົກປ້ອງ` ແລະ `ສ່ວນຕົວ`:"

msgid ""
"Granting users :guilabel:`Manage project access` (see :ref:`privileges`) "
"allows them to assign other users in `Public`, `Protected` and `Private` "
"(but not `Custom`) projects via adding them to teams."
msgstr ""
"ການໃຫ້ສິດ :guilabel:`ຈັດການການເຂົ້າເຖິງໂຄງການ` (ເບິ່ງ :ref:`privileges`) ແກ່ຜູ້ໃຊ້ "
"ຊ່ວຍໃຫ້ພວກເຂົາສາມາດກຳນົດຜູ້ໃຊ້ອື່ນໆໃນໂຄງການ `ສາທາລະນະ`, `ປົກປ້ອງ` ແລະ `ສ່ວນຕົວ` (ແຕ່ບໍ່ແມ່ນ "
"`ກຳນົດເອງ`) ໂດຍການເພີ່ມພວກເຂົາເຂົ້າໃນທີມ."

msgid ""
"These are the default teams provided with Weblate; teams can be added or "
"modified by users with sufficient privileges:"
msgstr "ເຫຼົ່ານີ້ແມ່ນທີມເລີ່ມຕົ້ນທີ່ Weblate ຈັດຫາໃຫ້; ທີມສາມາດຖືກເພີ່ມ ຫຼື ແກ້ໄຂໂດຍຜູ້ໃຊ້ທີ່ມີສິດທິພຽງພໍ:"

msgid "`Administration`"
msgstr "`ການບໍລິຫານ`"

msgid "All available permissions for the project."
msgstr "ສິດທິທັງໝົດທີ່ມີສຳລັບໂຄງການ."

msgid "`Review`"
msgstr "`ການກວດສອບ`"

msgid "Approve translations in a review."
msgstr "ອະນຸມັດການແປໃນການກວດສອບ."

msgid "Available only if :ref:`review workflow <reviews>` is on."
msgstr "ມີໃຫ້ໃຊ້ງານສະເພາະເມື່ອ :ref:`ຂັ້ນຕອນການກວດສອບ <reviews>` ເປີດຢູ່ເທົ່ານັ້ນ."

msgid "For `Protected` and `Private` projects only:"
msgstr "ສຳລັບໂຄງການ `ປົກປ້ອງ` ແລະ `ສ່ວນຕົວ` ເທົ່ານັ້ນ:"

msgid "`Translate`"
msgstr "`ການແປ`"

msgid "Translate the project and upload translations made offline."
msgstr "ແປໂຄງການ ແລະ ອັບໂຫຼດການແປທີ່ເຮັດແບບອອບລາຍ."

msgid "`Sources`"
msgstr "`ແຫຼ່ງຂໍ້ມູນ`"

msgid ""
"Edit source strings (if allowed in the :ref:`project settings <component-"
"manage_units>`) and source-string info."
msgstr ""
"ແກ້ໄຂຂໍ້ຄວາມຕົ້ນສະບັບ (ຫາກອະນຸຍາດໃນ :ref:`ການຕັ້ງຄ່າໂຄງການ <component-manage_units>`) "
"ແລະ ຂໍ້ມູນຂໍ້ຄວາມຕົ້ນສະບັບ."

msgid "`Languages`"
msgstr "`ພາສາ`"

msgid "Manage translated languages (add or remove translations)."
msgstr "ຈັດການພາສາທີ່ແປ (ເພີ່ມ ຫຼື ລຶບການແປ)."

msgid "`Glossary`"
msgstr "`ຄຳສັບ`"

msgid "Manage glossary (add, remove, and upload entries)."
msgstr "ຈັດການຄຳສັບ (ເພີ່ມ, ລຶບ, ແລະ ອັບໂຫຼດລາຍການ)."

msgid "`Memory`"
msgstr "`ໜ່ວຍຄວາມຈຳ`"

msgid "Manage translation memory."
msgstr "ຈັດການໜ່ວຍຄວາມຈຳການແປ."

msgid "`Screenshots`"
msgstr "`ພາບໜ້າຈໍ`"

msgid "Manage screenshots (add, remove, and associate them to source strings)."
msgstr "ຈັດການພາບໜ້າຈໍ (ເພີ່ມ, ລຶບ, ແລະ ເຊື່ອມໂຍງກັບຂໍ້ຄວາມຕົ້ນສະບັບ)."

msgid "`Automatic translation`"
msgstr "`ການແປອັດຕະໂນມັດ`"

msgid "Can use automatic translation."
msgstr "ສາມາດໃຊ້ການແປອັດຕະໂນມັດໄດ້."

msgid "`VCS`"
msgstr "`VCS`"

msgid "Manage VCS and access the exported repository."
msgstr "ຈັດການ VCS ແລະ ເຂົ້າເຖິງບ່ອນເກັບຂໍ້ມູນທີ່ສົ່ງອອກ."

msgid "`Billing`"
msgstr "`ການເອີ້ນເກັບເງິນ`"

msgid "Access billing info and settings (see :ref:`billing`)."
msgstr "ເຂົ້າເຖິງຂໍ້ມູນການເອີ້ນເກັບເງິນ ແລະ ການຕັ້ງຄ່າ (ເບິ່ງ :ref:`billing`)."

msgid ""
"These features are available on the :guilabel:`Access control` page in the "
"project’s menu :guilabel:`Operations` ↓ :guilabel:`Users`."
msgstr ""
"ຄຸນສົມບັດເຫຼົ່ານີ້ມີໃຫ້ໃຊ້ງານໃນໜ້າ :guilabel:`ການຄວບຄຸມການເຂົ້າເຖິງ` "
"ໃນເມນູຂອງໂຄງການ :guilabel:`ການດຳເນີນງານ` ↓ :guilabel:`ຜູ້ໃຊ້`."

msgid ""
"You can limit teams to languages or components, and assign them designated "
"access roles (see :ref:`privileges`)."
msgstr ""
"ທ່ານສາມາດຈຳກັດທີມໃຫ້ສະເພາະພາສາ ຫຼື ອົງປະກອບ, ແລະ ກຳນົດບົດບາດການເຂົ້າເຖິງທີ່ກຳນົດໄວ້ໃຫ້ພວກເຂົາ "
"(ເບິ່ງ :ref:`privileges`)."

msgid "Team administrators"
msgstr "ຜູ້ດູແລທີມ"

msgid ""
"Each team can have team administrators, who can add and remove users within "
"the team."
msgstr "ແຕ່ລະທີມສາມາດມີຜູ້ດູແລທີມ, ເຊິ່ງສາມາດເພີ່ມ ແລະ ລຶບຜູ້ໃຊ້ພາຍໃນທີມໄດ້."

msgid "This is useful in case you want to build self-governed teams."
msgstr "ອັນນີ້ມີປະໂຫຍດໃນກໍລະນີທີ່ທ່ານຕ້ອງການສ້າງທີມທີ່ປົກຄອງຕົນເອງ."

msgid "Inviting new users"
msgstr "ການເຊີນຜູ້ໃຊ້ໃໝ່"

msgid ""
"Adding existing users will send them invitation to confirm. "
"With :setting:`REGISTRATION_OPEN` the administrator can also invite new "
"users using e-mail. Invited users have to complete the registration process "
"to get access to the project."
msgstr ""
"ການເພີ່ມຜູ້ໃຊ້ທີ່ມີຢູ່ແລ້ວຈະສົ່ງຄຳເຊີນໄປໃຫ້ພວກເຂົາຢືນຢັນ. ດ້ວຍ :setting:`REGISTRATION_OPEN` "
"ຜູ້ດູແລລະບົບຍັງສາມາດເຊີນຜູ້ໃຊ້ໃໝ່ໂດຍໃຊ້ອີເມວ. ຜູ້ໃຊ້ທີ່ຖືກເຊີນຕ້ອງເຮັດຂະບວນການລົງທະບຽນໃຫ້ສຳເລັດ "
"ເພື່ອໃຫ້ໄດ້ຮັບສິດເຂົ້າເຖິງໂຄງການ."

msgid ""
"It is not required to have any site-wide privileges in order to do so, "
"access management permission on the project’s scope (e.g. a membership in "
"the `Administration` team) would be sufficient."
msgstr ""
"ບໍ່ຈຳເປັນຕ້ອງມີສິດທິພິເສດໃນລະດັບເວັບໄຊເພື່ອເຮັດສິ່ງນີ້, "
"ສິດໃນການຈັດການການເຂົ້າເຖິງໃນຂອບເຂດຂອງໂຄງການ (ເຊັ່ນ: ການເປັນສະມາຊິກໃນທີມ `ການບໍລິຫານ`) "
"ກໍພຽງພໍແລ້ວ."

msgid ""
"If the invited user missed the validity of the invitation, a new invitation "
"has to be created."
msgstr "ຫາກຜູ້ໃຊ້ທີ່ຖືກເຊີນພາດໄລຍະເວລາການມີຜົນຂອງຄຳເຊີນ, ຈະຕ້ອງສ້າງຄຳເຊີນໃໝ່."

msgid ""
"The same kind of invitations are available site-wide from "
"the :ref:`management interface <management-interface>` on "
"the :guilabel:`Users` tab. Both project administrators and site "
"administrators can also invite multiple users at once by pasting whitespace-"
"separated e-mail addresses. All invitations created in one bulk action use "
"the selected team, and site-wide bulk invites also apply the selected "
"superuser flag."
msgstr ""
"ຄຳເຊີນແບບດຽວກັນນີ້ມີໃຫ້ໃນລະດັບເວັບໄຊຈາກ :ref:`ອິນເຕີເຟດການຈັດການ <management-"
"interface>` ໃນແຖບ :guilabel:`ຜູ້ໃຊ້`. ທັງຜູ້ດູແລໂຄງການ ແລະ "
"ຜູ້ດູແລລະບົບສາມາດເຊີນຜູ້ໃຊ້ຫຼາຍຄົນພ້ອມກັນ ໂດຍການວາງທີ່ຢູ່ອີເມວທີ່ແຍກດ້ວຍຊ່ອງຫວ່າງ. "
"ຄຳເຊີນທັງໝົດທີ່ສ້າງຂຶ້ນໃນການດຳເນີນງານຮອບດຽວຈະໃຊ້ທີມທີ່ເລືອກໄວ້, ແລະ "
"ຄຳເຊີນແບບຮອບດຽວໃນລະດັບເວັບໄຊຍັງຈະນຳໃຊ້ທຸງ superuser ທີ່ເລືອກອີກດ້ວຍ."

#, fuzzy
#| msgid ""
#| "Site-wide user management is controlled by the global ``user.edit`` "
#| "permission. Unlike project access management, this is a trusted "
#| "administrative permission which allows editing user accounts across the "
#| "whole instance, including assigning site-wide teams and granting "
#| "superuser status to the managed account, even the caller's own account."
msgid ""
"Site-wide user management is controlled by the global ``user.edit`` "
"permission. Unlike project access management, this is a trusted "
"administrative permission which allows editing user accounts across the "
"whole instance. It includes adding or removing the managed account from any "
"site-wide, workspace, or project team, and granting or revoking superuser "
"status, even for the caller's own account. These actions do not require "
"the :guilabel:`Manage teams` permission or separate authority over the "
"affected team."
msgstr ""
"ການຈັດການຜູ້ໃຊ້ໃນລະດັບເວັບໄຊຖືກຄວບຄຸມໂດຍສິດ ``user.edit`` ສ່ວນກາງ. "
"ແຕກຕ່າງຈາກການຈັດການການເຂົ້າເຖິງໂຄງການ, ນີ້ແມ່ນສິດທິດ້ານການບໍລິຫານທີ່ເຊື່ອຖືໄດ້ "
"ເຊິ່ງອະນຸຍາດໃຫ້ແກ້ໄຂບັນຊີຜູ້ໃຊ້ທົ່ວທັງລະບົບ, ລວມເຖິງການກຳນົດທີມໃນລະດັບເວັບໄຊ ແລະ ການໃຫ້ສະຖານະ "
"superuser ແກ່ບັນຊີທີ່ຖືກຈັດການ, ລວມເຖິງບັນຊີຂອງຜູ້ເອີ້ນໃຊ້ເອງ."

msgid ""
"Treat ``user.edit`` as effectively equivalent to superuser access, not as a "
"limited helpdesk permission. To delegate access management within a narrower "
"scope, use a project `Administration` team or a :ref:`team administrator "
"<team-admins>` instead."
msgstr ""

msgid ""
"Site administrators can also disable password authentication for a user. "
"The :guilabel:`Regenerate API key` option is enabled by default so that the "
"current personal API key stops working. Clear it only when the current API "
"key should remain active."
msgstr ""
"ຜູ້ດູແລລະບົບຍັງສາມາດປິດໃຊ້ງານການຢືນຢັນຕົວຕົນດ້ວຍລະຫັດຜ່ານສຳລັບຜູ້ໃຊ້ໄດ້. ຕົວເລືອກ :guilabel:`ສ້າງຄີ "
"API ໃໝ່` ຖືກເປີດໃຊ້ໄວ້ເປັນຄ່າເລີ່ມຕົ້ນ ເພື່ອໃຫ້ຄີ API ສ່ວນຕົວປັດຈຸບັນຢຸດການເຮັດວຽກ. "
"ໃຫ້ຍົກເລີກການເລືອກກໍຕໍ່ເມື່ອຕ້ອງການໃຫ້ຄີ API ປັດຈຸບັນຍັງຄົງໃຊ້ງານໄດ້ຢູ່."

msgid ""
"Bulk invitations are processed individually. Invalid addresses and addresses "
"with an already pending invitation are skipped while valid invitations are "
"still created and sent."
msgstr ""
"ການເຊີນແບບຮອບດຽວຈະຖືກປະມວນຜົນເທື່ອລະລາຍການ. ທີ່ຢູ່ທີ່ບໍ່ຖືກຕ້ອງ ແລະ ທີ່ຢູ່ທີ່ມີຄຳເຊີນຄ້າງໄວ້ຢູ່ແລ້ວ "
"ຈະຖືກຂ້າມໄປ ໃນຂະນະທີ່ຄຳເຊີນທີ່ຖືກຕ້ອງຍັງຈະຖືກສ້າງ ແລະ ສົ່ງອອກໄປ."

msgid ""
"Weblate now does not automatically create accounts or add users to the "
"teams. This is only done after confirmation from the user."
msgstr ""
"ຕອນນີ້ Weblate ບໍ່ໄດ້ສ້າງບັນຊີ ຫຼື ເພີ່ມຜູ້ໃຊ້ເຂົ້າໃນທີມໂດຍອັດຕະໂນມັດ. "
"ສິ່ງນີ້ຈະເຮັດໄດ້ຫຼັງຈາກການຢືນຢັນຈາກຜູ້ໃຊ້ເທົ່ານັ້ນ."

msgid "Blocking users"
msgstr "ການບລັອກຜູ້ໃຊ້"

msgid ""
"If users misbehave in your project, you can block them from contributing. "
"With the relevant permissions blocked, users can still see the project, but "
"won't be able to contribute."
msgstr ""
"ຫາກຜູ້ໃຊ້ປະພຶດຕົວບໍ່ເໝາະສົມໃນໂຄງການຂອງທ່ານ, ທ່ານສາມາດບລັອກພວກເຂົາຈາກການປະກອບສ່ວນໄດ້. "
"ດ້ວຍສິດທິທີ່ກ່ຽວຂ້ອງຖືກບລັອກ, ຜູ້ໃຊ້ຍັງສາມາດເບິ່ງໂຄງການໄດ້, ແຕ່ຈະບໍ່ສາມາດປະກອບສ່ວນໄດ້."

msgid "Cleaning up user contributions"
msgstr "ການລ້າງຂໍ້ມູນການປະກອບສ່ວນຂອງຜູ້ໃຊ້"

msgid ""
"When blocking spam or abusive accounts, project administrators can also "
"clean up the user's existing contributions in that project. "
"Use :guilabel:`Operations` ↓ :guilabel:`Users`, block the user, and select "
"the cleanup actions in the block form. For users who are already blocked, "
"use :guilabel:`Clean up user contributions` in the blocked users list."
msgstr ""
"ເມື່ອບລັອກສະແປມ ຫຼື ບັນຊີທີ່ລະເມີດ, "
"ຜູ້ດູແລໂຄງການຍັງສາມາດລ້າງຂໍ້ມູນການປະກອບສ່ວນທີ່ມີຢູ່ແລ້ວຂອງຜູ້ໃຊ້ໃນໂຄງການນັ້ນໄດ້. "
"ໃຊ້ :guilabel:`ການດຳເນີນງານ` ↓ :guilabel:`ຜູ້ໃຊ້`, ບລັອກຜູ້ໃຊ້, ແລະ "
"ເລືອກການດຳເນີນການລ້າງຂໍ້ມູນໃນຟອມບລັອກ. ສຳລັບຜູ້ໃຊ້ທີ່ຖືກບລັອກຢູ່ແລ້ວ, "
"ໃຫ້ໃຊ້ :guilabel:`ລ້າງຂໍ້ມູນການປະກອບສ່ວນຂອງຜູ້ໃຊ້` ໃນລາຍການຜູ້ໃຊ້ທີ່ຖືກບລັອກ."

msgid "The available cleanup actions are:"
msgstr "ການດຳເນີນການລ້າງຂໍ້ມູນທີ່ມີໃຫ້ມີດັ່ງນີ້:"

msgid ""
":guilabel:`Revert user edits` reverts the latest editable translations by "
"the user."
msgstr ":guilabel:`ຍົກເລີກການແກ້ໄຂຂອງຜູ້ໃຊ້` ຈະຍົກເລີກການແປຫຼ້າສຸດທີ່ສາມາດແກ້ໄຂໄດ້ໂດຍຜູ້ໃຊ້."

msgid ""
":guilabel:`Reject user suggestions` rejects pending suggestions by the user."
msgstr ":guilabel:`ປະຕິເສດຄຳແນະນຳຂອງຜູ້ໃຊ້` ຈະປະຕິເສດຄຳແນະນຳທີ່ຄ້າງໄວ້ໂດຍຜູ້ໃຊ້."

msgid ":guilabel:`Delete user comments` deletes comments by the user."
msgstr ":guilabel:`ລຶບຄວາມຄິດເຫັນຂອງຜູ້ໃຊ້` ຈະລຶບຄວາມຄິດເຫັນໂດຍຜູ້ໃຊ້."

msgid ""
"Site administrators with the site-wide ``user.edit`` permission can perform "
"the same bulk cleanup across all projects from the :ref:`management "
"interface <management-interface>` on the :guilabel:`Users` tab. Open the "
"user's profile, select the :guilabel:`Edit` tab, and "
"use :guilabel:`Contribution cleanup`."
msgstr ""
"ຜູ້ດູແລລະບົບທີ່ມີສິດ ``user.edit`` ໃນລະດັບເວັບໄຊ ສາມາດດຳເນີນການລ້າງຂໍ້ມູນແບບຮອບດຽວແບບດຽວກັນ "
"ໃນທົ່ວທຸກໂຄງການຈາກ :ref:`ອິນເຕີເຟດການຈັດການ <management-interface>` "
"ໃນແຖບ :guilabel:`ຜູ້ໃຊ້`. ເປີດໂປຣໄຟລ໌ຂອງຜູ້ໃຊ້, ເລືອກແຖບ :guilabel:`ແກ້ໄຂ`, ແລະ "
"ໃຊ້ :guilabel:`ການລ້າງຂໍ້ມູນການປະກອບສ່ວນ`."

msgid "Per-project permission management"
msgstr "ການຈັດການສິດທິລາຍໂຄງການ"

msgid ""
"You can set your projects to :guilabel:`Protected` or :guilabel:`Private` "
"(see :ref:`acl`), and :ref:`manage users access <manage-acl>` per-project."
msgstr ""
"ທ່ານສາມາດຕັ້ງຄ່າໂຄງການຂອງທ່ານເປັນ :guilabel:`ປົກປ້ອງ` ຫຼື :guilabel:`ສ່ວນຕົວ` "
"(ເບິ່ງ :ref:`acl`), ແລະ :ref:`ຈັດການການເຂົ້າເຖິງຂອງຜູ້ໃຊ້ <manage-acl>` ລາຍໂຄງການ."

msgid ""
"By default this prevents Weblate from granting access provided by `Users` "
"and `Viewers` :ref:`default teams <default-teams>` due to these teams’ own "
"configuration. This doesn’t prevent you from granting permissions to those "
"projects site-wide by altering default teams, creating a new one, or "
"creating additional custom settings for individual component as described "
"in :ref:`custom-acl` below."
msgstr ""
"ໂດຍຄ່າເລີ່ມຕົ້ນ, ສິ່ງນີ້ຈະປ້ອງກັນບໍ່ໃຫ້ Weblate ໃຫ້ສິດເຂົ້າເຖິງທີ່ໃຫ້ໂດຍທີມ `ຜູ້ໃຊ້` ແລະ "
"`ຜູ້ເບິ່ງ` :ref:`ທີມເລີ່ມຕົ້ນ <default-teams>` ເນື່ອງຈາກການຕັ້ງຄ່າຂອງທີມເຫຼົ່ານັ້ນ. "
"ສິ່ງນີ້ບໍ່ໄດ້ປ້ອງກັນທ່ານຈາກການໃຫ້ສິດແກ່ໂຄງການເຫຼົ່ານັ້ນໃນລະດັບເວັບໄຊ ໂດຍການປ່ຽນແປງທີມເລີ່ມຕົ້ນ, "
"ການສ້າງທີມໃໝ່, ຫຼື ການສ້າງການຕັ້ງຄ່າແບບກຳນົດເອງເພີ່ມເຕີມສຳລັບແຕ່ລະອົງປະກອບ "
"ດັ່ງທີ່ອະທິບາຍໄວ້ໃນ :ref:`custom-acl` ດ້ານລຸ່ມ."

msgid ""
"One of the main benefits of managing permissions through the Weblate user "
"interface is that you can delegate it to other users without giving them the "
"superuser privilege. In order to do so, add them to the `Administration` "
"team of the project."
msgstr ""
"ຜົນປະໂຫຍດຫຼັກຢ່າງໜຶ່ງຂອງການຈັດການສິດທິຜ່ານອິນເຕີເຟດຜູ້ໃຊ້ Weblate ຄື "
"ທ່ານສາມາດມອບໝາຍໃຫ້ຜູ້ໃຊ້ອື່ນໄດ້ໂດຍບໍ່ຕ້ອງໃຫ້ສິດ superuser ແກ່ພວກເຂົາ. ເພື່ອເຮັດສິ່ງນີ້, "
"ໃຫ້ເພີ່ມພວກເຂົາເຂົ້າໃນທີມ `ການບໍລິຫານ` ຂອງໂຄງການ."

msgid ""
"This project-scoped delegation is separate from the site-wide ``user.edit`` "
"permission. Membership in a project `Administration` team allows managing "
"access only for that project, while ``user.edit`` grants site-wide user "
"management in the Weblate UI and API and should be assigned only to fully "
"trusted site administrators."
msgstr ""
"ການມອບໝາຍໃນຂອບເຂດໂຄງການນີ້ແຍກຕ່າງຫາກຈາກສິດ ``user.edit`` ໃນລະດັບເວັບໄຊ. "
"ການເປັນສະມາຊິກໃນທີມ `ການບໍລິຫານ` "
"ຂອງໂຄງການອະນຸຍາດໃຫ້ຈັດການການເຂົ້າເຖິງສຳລັບໂຄງການນັ້ນເທົ່ານັ້ນ, ໃນຂະນະທີ່ ``user.edit`` "
"ໃຫ້ສິດການຈັດການຜູ້ໃຊ້ໃນລະດັບເວັບໄຊໃນ Weblate UI ແລະ API ແລະ "
"ຄວນມອບໝາຍໃຫ້ຜູ້ດູແລລະບົບທີ່ເຊື່ອຖືໄດ້ຢ່າງເຕັມທີ່ເທົ່ານັ້ນ."

msgid "Per-project access tokens"
msgstr "ໂທເຄັນການເຂົ້າເຖິງລາຍໂຄງການ"

msgid ""
"You can define project-scoped access tokens in :guilabel:`API access` tab. "
"The API tokens can have expiry date set, and their permissions can be "
"customized by team memberships same as with users."
msgstr ""
"ທ່ານສາມາດກຳນົດໂທເຄັນການເຂົ້າເຖິງໃນຂອບເຂດໂຄງການໄດ້ໃນແຖບ :guilabel:`ການເຂົ້າເຖິງ API`. "
"ໂທເຄັນ API ສາມາດຕັ້ງວັນໝົດອາຍຸໄດ້, ແລະ ສິດທິຂອງພວກມັນສາມາດປັບແຕ່ງໄດ້ໂດຍການເປັນສະມາຊິກທີມ "
"ແບບດຽວກັນກັບຜູ້ໃຊ້."

msgid "Site-wide access control"
msgstr "ການຄວບຄຸມການເຂົ້າເຖິງໃນລະດັບເວັບໄຊ"

msgid "This feature is unavailable on Hosted Weblate."
msgstr "ຄຸນສົມບັດນີ້ບໍ່ມີໃຫ້ໃຊ້ໃນ Hosted Weblate."

msgid ""
"The permission system is based on roles defining a set of permissions, and "
"teams linking roles to users and translations, read :ref:`auth-model` for "
"more details."
msgstr ""
"ລະບົບສິດທິອີງໃສ່ບົດບາດທີ່ກຳນົດຊຸດຂອງສິດທິ, ແລະ ທີມທີ່ເຊື່ອມໂຍງບົດບາດກັບຜູ້ໃຊ້ ແລະ ການແປ, "
"ອ່ານ :ref:`auth-model` ສຳລັບລາຍລະອຽດເພີ່ມເຕີມ."

msgid ""
"The most powerful features of the Weblate’s access control system can be "
"configured in the :ref:`management-interface`. You can use it to manage "
"permissions of any project. You don’t necessarily have to switch it "
"to :guilabel:`Custom` :ref:`access control <acl>` to utilize it. However you "
"must have superuser privileges in order to use it."
msgstr ""
"ຄຸນສົມບັດທີ່ມີພະລັງທີ່ສຸດຂອງລະບົບການຄວບຄຸມການເຂົ້າເຖິງຂອງ Weblate "
"ສາມາດຕັ້ງຄ່າໄດ້ໃນ :ref:`ອິນເຕີເຟດການຈັດການ <management-interface>`. "
"ທ່ານສາມາດໃຊ້ເພື່ອຈັດການສິດທິຂອງໂຄງການໃດກໍໄດ້. "
"ທ່ານບໍ່ຈຳເປັນຕ້ອງປ່ຽນເປັນ :guilabel:`ກຳນົດເອງ` :ref:`ການຄວບຄຸມການເຂົ້າເຖິງ <acl>` "
"ເພື່ອໃຊ້ງານມັນ. ຢ່າງໃດກໍຕາມ, ທ່ານຕ້ອງມີສິດ superuser ເພື່ອໃຊ້ງານມັນ."

msgid ""
"If you are not interested in details of implementation, and just want to "
"create a simple-enough configuration based on the defaults, or don’t have a "
"site-wide access to the whole Weblate installation (like on `Hosted Weblate "
"<https://hosted.weblate.org/>`_), please refer to the :ref:`manage-acl` "
"section."
msgstr ""
"ຫາກທ່ານບໍ່ສົນໃຈລາຍລະອຽດຂອງການຈັດຕັ້ງປະຕິບັດ, ແລະ "
"ພຽງແຕ່ຕ້ອງການສ້າງການຕັ້ງຄ່າທີ່ງ່າຍພໍໂດຍອີງໃສ່ຄ່າເລີ່ມຕົ້ນ, ຫຼື ບໍ່ມີສິດເຂົ້າເຖິງລະດັບເວັບໄຊໃນທັງໝົດການຕິດຕັ້ງ "
"Weblate (ເຊັ່ນໃນ `Hosted Weblate <https://hosted.weblate.org/>`_), "
"ກະລຸນາເບິ່ງພາກ :ref:`manage-acl`."

msgid "Site-wide permission management"
msgstr "ການຈັດການສິດທິໃນລະດັບເວັບໄຊ"

msgid ""
"To manage permissions for a whole instance at once, add users to "
"appropriate :ref:`default teams <default-teams>`:"
msgstr ""
"ເພື່ອຈັດການສິດທິສຳລັບທັງລະບົບໃນຄັ້ງດຽວ, ໃຫ້ເພີ່ມຜູ້ໃຊ້ເຂົ້າໃນ :ref:`ທີມເລີ່ມຕົ້ນ <default-teams>` "
"ທີ່ເໝາະສົມ:"

msgid ""
"`Users` (this is done by default by the :ref:`automatic team assignment "
"<autoteam>`)."
msgstr "`ຜູ້ໃຊ້` (ສິ່ງນີ້ຖືກເຮັດໂດຍຄ່າເລີ່ມຕົ້ນໂດຍ :ref:`ການກຳນົດທີມອັດຕະໂນມັດ <autoteam>`)."

msgid ""
"`Reviewers` (if you are using :ref:`review workflow <reviews>` with "
"dedicated reviewers)."
msgstr ""
"`ຜູ້ກວດສອບ` (ຫາກທ່ານກຳລັງໃຊ້ :ref:`ຂັ້ນຕອນການກວດສອບ <reviews>` ກັບຜູ້ກວດສອບໂດຍສະເພາະ)."

msgid ""
"`Managers` (if you want to delegate most of the management operations to "
"somebody else)."
msgstr "`ຜູ້ຈັດການ` (ຫາກທ່ານຕ້ອງການມອບໝາຍການດຳເນີນງານການຈັດການສ່ວນໃຫຍ່ໃຫ້ຄົນອື່ນ)."

msgid ""
"You should keep all projects configured as `Public` (see :ref:`acl`), "
"otherwise the site-wide permissions provided by membership in the `Users` "
"and `Reviewers` teams won’t have any effect."
msgstr ""
"ທ່ານຄວນຮັກສາທຸກໂຄງການໃຫ້ຕັ້ງຄ່າເປັນ `ສາທາລະນະ` (ເບິ່ງ :ref:`acl`), "
"ຖ້າບໍ່ດັ່ງນັ້ນສິດທິໃນລະດັບເວັບໄຊທີ່ໃຫ້ໂດຍການເປັນສະມາຊິກໃນທີມ `ຜູ້ໃຊ້` ແລະ `ຜູ້ກວດສອບ` ຈະບໍ່ມີຜົນໃດໆ."

msgid ""
"You may also grant some additional permissions of your choice to the default "
"teams. For example, you may want to give a permission to manage screenshots "
"to all the `Users`."
msgstr ""
"ທ່ານອາດຈະມອບສິດເພີ່ມເຕີມບາງຢ່າງຕາມທີ່ທ່ານເລືອກໃຫ້ແກ່ທີມເລີ່ມຕົ້ນ. ຕົວຢ່າງ, "
"ທ່ານອາດຈະຕ້ອງການໃຫ້ສິດໃນການຈັດການພາບໜ້າຈໍແກ່ `ຜູ້ໃຊ້` ທຸກຄົນ."

msgid ""
"You can define some new custom teams as well. If you want to keep managing "
"your permissions site-wide for these teams, choose an appropriate value for "
"the :guilabel:`Project selection` (e.g. :guilabel:`All projects` "
"or :guilabel:`All public projects`)."
msgstr ""
"ທ່ານສາມາດກຳນົດທີມກຳນົດເອງໃໝ່ໄດ້ເຊັ່ນກັນ. "
"ຫາກທ່ານຕ້ອງການຈັດການສິດທິໃນລະດັບເວັບໄຊສຳລັບທີມເຫຼົ່ານີ້ຕໍ່ໄປ, "
"ໃຫ້ເລືອກຄ່າທີ່ເໝາະສົມສຳລັບ :guilabel:`ການເລືອກໂຄງການ` (ເຊັ່ນ :guilabel:`ທຸກໂຄງການ` "
"ຫຼື :guilabel:`ທຸກໂຄງການສາທາລະນະ`)."

msgid "Custom permissions for languages, components or projects"
msgstr "ສິດທິແບບກຳນົດເອງສຳລັບພາສາ, ອົງປະກອບ ຫຼື ໂຄງການ"

msgid ""
"You can create your own dedicated teams to manage permissions for distinct "
"objects such as languages, components, and projects. Although these teams "
"can only grant additional privileges, you can’t revoke any permission "
"granted by site-wide or per-project teams by adding another custom team."
msgstr ""
"ທ່ານສາມາດສ້າງທີມສະເພາະຂອງທ່ານເອງເພື່ອຈັດການສິດທິສຳລັບວັດຖຸຕ່າງໆ ເຊັ່ນ ພາສາ, ອົງປະກອບ, ແລະ "
"ໂຄງການ. ເຖິງແມ່ນວ່າທີມເຫຼົ່ານີ້ຈະສາມາດໃຫ້ສິດທິພິເສດເພີ່ມເຕີມໄດ້ເທົ່ານັ້ນ, "
"ທ່ານບໍ່ສາມາດຖອນສິດໃດໆທີ່ໃຫ້ໂດຍທີມໃນລະດັບເວັບໄຊ ຫຼື ລາຍໂຄງການໂດຍການເພີ່ມທີມກຳນົດເອງອື່ນໄດ້."

msgid "**Example:**"
msgstr "**ຕົວຢ່າງ:**"

msgid ""
"Restricting translation to `Czech` to a selected set of translators, (while "
"keeping translations to other languages public):"
msgstr ""
"ການຈຳກັດການແປພາສາ `ເຊັກ` ໃຫ້ສະເພາະກຸ່ມນັກແປທີ່ເລືອກ, "
"(ໃນຂະນະທີ່ຮັກສາການແປພາສາອື່ນໆເປັນສາທາລະນະ):"

#, fuzzy
#| msgid ""
#| "Remove the permission to translate `Czech` from all users. In the default "
#| "configuration this can be done by altering the `Users` :ref:`default team "
#| "<default-teams>`."
msgid ""
"Remove the permission to translate `Czech` from all users. In the default "
"configuration this can be done by altering the `Users` :ref:`default team "
"<default-teams>`. Built-in teams reject this change in the team management "
"UI, use the :ref:`Django admin interface <admin-interface>` instead."
msgstr ""
"ລຶບສິດໃນການແປພາສາ `ເຊັກ` ອອກຈາກຜູ້ໃຊ້ທຸກຄົນ. ໃນການຕັ້ງຄ່າເລີ່ມຕົ້ນ, "
"ສິ່ງນີ້ສາມາດເຮັດໄດ້ໂດຍການປ່ຽນແປງ `ຜູ້ໃຊ້` :ref:`ທີມເລີ່ມຕົ້ນ <default-teams>`."

msgid "Group `Users`"
msgstr "ກຸ່ມ `ຜູ້ໃຊ້`"

msgid "All languages"
msgstr "ທຸກພາສາ"

msgid "Turned off"
msgstr "ປິດຢູ່"

msgid "Languages"
msgstr "ພາສາ"

msgid "All but `Czech`"
msgstr "ທຸກພາສາຍົກເວັ້ນ `ເຊັກ`"

msgid "Add a dedicated team for `Czech` translators."
msgstr "ເພີ່ມທີມສະເພາະສຳລັບນັກແປພາສາ `ເຊັກ`."

msgid "Group `Czech translators`"
msgstr "ກຸ່ມ `ນັກແປພາສາເຊັກ`"

msgid "Roles"
msgstr "ບົດບາດ"

msgid "`Power users`"
msgstr "`ຜູ້ໃຊ້ຂັ້ນສູງ`"

msgid "Project selection"
msgstr "ການເລືອກໂຄງການ"

msgid "`All public projects`"
msgstr "`ທຸກໂຄງການສາທາລະນະ`"

msgid "`Czech`"
msgstr "`ເຊັກ`"

msgid "Add users you wish to give the permissions to into this team."
msgstr "ເພີ່ມຜູ້ໃຊ້ທີ່ທ່ານຕ້ອງການໃຫ້ສິດເຂົ້າໃນທີມນີ້."

msgid ""
"Management permissions this way is powerful, but can be quite a tedious job. "
"You can only delegate it to other users by granting them Superuser status."
msgstr ""
"ການຈັດການສິດທິດ້ວຍວິທີນີ້ມີພະລັງ, ແຕ່ອາດເປັນວຽກທີ່ໜ້າເບື່ອໜ່າຍ. "
"ທ່ານສາມາດມອບໝາຍໃຫ້ຜູ້ໃຊ້ອື່ນໄດ້ພຽງແຕ່ໂດຍການໃຫ້ສະຖານະ Superuser ແກ່ພວກເຂົາເທົ່ານັ້ນ."

msgid "Users, roles, teams, and permissions"
msgstr "ຜູ້ໃຊ້, ບົດບາດ, ທີມ, ແລະ ສິດທິ"

msgid "The authentication models consist of several objects:"
msgstr "ແບບຈຳລອງການຢືນຢັນຕົວຕົນປະກອບດ້ວຍວັດຖຸຫຼາຍຢ່າງ:"

msgid "`Permission`"
msgstr "`ສິດທິ`"

msgid ""
"Individual permission defined by Weblate. Permissions cannot be assigned to "
"users, only through assignment of roles."
msgstr ""
"ສິດທິແຕ່ລະຢ່າງທີ່ກຳນົດໂດຍ Weblate. ສິດທິບໍ່ສາມາດມອບໝາຍໃຫ້ຜູ້ໃຊ້ໂດຍກົງໄດ້, "
"ເຮັດໄດ້ພຽງແຕ່ຜ່ານການມອບໝາຍບົດບາດ."

msgid "`Role`"
msgstr "`ບົດບາດ`"

msgid ""
"A role defines a set of permissions (and can be reused in several places)."
msgstr "ບົດບາດກຳນົດຊຸດຂອງສິດທິ (ແລະ ສາມາດນຳໃຊ້ຄືນໄດ້ໃນຫຼາຍບ່ອນ)."

msgid "`User`"
msgstr "`ຜູ້ໃຊ້`"

msgid "A user can belong to several teams."
msgstr "ຜູ້ໃຊ້ສາມາດເປັນສະມາຊິກຂອງຫຼາຍທີມ."

msgid "`Group`"
msgstr "`ກຸ່ມ`"

msgid ""
"Groups connect roles and users with authentication objects (projects, "
"languages, components, and component lists)."
msgstr ""
"ກຸ່ມເຊື່ອມໂຍງບົດບາດ ແລະ ຜູ້ໃຊ້ເຂົ້າກັບວັດຖຸການຢືນຢັນຕົວຕົນ (ໂຄງການ, ພາສາ, ອົງປະກອບ, ແລະ "
"ລາຍການອົງປະກອບ)."

msgid ""
"A team can have no roles assigned to it, in that case access to browse the "
"project by anyone is assumed (see below)."
msgstr ""
"ທີມອາດຈະບໍ່ມີບົດບາດໃດໆຖືກມອບໝາຍ, ໃນກໍລະນີນັ້ນ "
"ການເຂົ້າເຖິງເພື່ອຊອກຫາໂຄງການໂດຍໃຜກໍຕາມຈະຖືກສົມມຸດຂຶ້ນ (ເບິ່ງດ້ານລຸ່ມ)."

msgid "Project-browsing access"
msgstr "ການເຂົ້າເຖິງການຊອກຫາໂຄງການ"

msgid ""
"A user has to be a member of a team linked to the project, or any component "
"inside that project. Having membership is enough, no specific permissions "
"are needed to browse the project (this is used in the default `Viewers` "
"team, see :ref:`default-teams`)."
msgstr ""
"ຜູ້ໃຊ້ຕ້ອງເປັນສະມາຊິກຂອງທີມທີ່ເຊື່ອມໂຍງກັບໂຄງການ, ຫຼື ອົງປະກອບໃດກໍຕາມພາຍໃນໂຄງການນັ້ນ. "
"ການເປັນສະມາຊິກແມ່ນພຽງພໍ, ບໍ່ຈຳເປັນຕ້ອງມີສິດທິສະເພາະໃດໆເພື່ອຊອກຫາໂຄງການ (ສິ່ງນີ້ຖືກໃຊ້ໃນທີມ "
"`ຜູ້ເບິ່ງ` ເລີ່ມຕົ້ນ, ເບິ່ງ :ref:`default-teams`)."

msgid "Component-browsing access"
msgstr "ການເຂົ້າເຖິງການຊອກຫາອົງປະກອບ"

msgid ""
"Granting browsing access to a user in one project gives it access to any "
"component with derived browsing permissions. With :ref:`component-"
"restricted` on, access to components (or component lists) are granted "
"explicitly."
msgstr ""
"ການມອບສິດການຊອກຫາແກ່ຜູ້ໃຊ້ໃນໂຄງການໜຶ່ງຈະໃຫ້ພວກເຂົາເຂົ້າເຖິງອົງປະກອບໃດກໍຕາມທີ່ມີສິດການຊອກຫາທີ່ໄດ້ຮັບມາ. "
"ດ້ວຍ :ref:`component-restricted` ເປີດຢູ່, ການເຂົ້າເຖິງອົງປະກອບ (ຫຼື ລາຍການອົງປະກອບ) "
"ຈະຖືກມອບໃຫ້ຢ່າງຊັດເຈນ."

msgid "Scope of teams"
msgstr "ຂອບເຂດຂອງທີມ"

msgid ""
"The scope of the permission assigned by the roles in the teams are applied "
"by the following rules:"
msgstr "ຂອບເຂດຂອງສິດທິທີ່ມອບໝາຍໂດຍບົດບາດໃນທີມຈະຖືກນຳໃຊ້ໂດຍກົດລະບຽບຕໍ່ໄປນີ້:"

msgid ""
"If the team specifies any :guilabel:`Component list`, all the permissions "
"given to members of that team are granted for all the components in the "
"component lists attached to the team, and an access with no additional "
"permissions is granted for all the projects these components are "
"in. :guilabel:`Components` and :guilabel:`Projects` are ignored."
msgstr ""
"ຫາກທີມລະບຸ :guilabel:`ລາຍການອົງປະກອບ` ໃດໜຶ່ງ, ສິດທິທັງໝົດທີ່ມອບໃຫ້ສະມາຊິກຂອງທີມນັ້ນ "
"ຈະຖືກມອບໃຫ້ສຳລັບອົງປະກອບທັງໝົດໃນລາຍການອົງປະກອບທີ່ຕິດກັບທີມ, ແລະ ການເຂົ້າເຖິງໂດຍບໍ່ມີສິດທິເພີ່ມເຕີມ "
"ຈະຖືກມອບໃຫ້ສຳລັບທຸກໂຄງການທີ່ອົງປະກອບເຫຼົ່ານັ້ນຢູ່. :guilabel:`ອົງປະກອບ` "
"ແລະ :guilabel:`ໂຄງການ` ຈະຖືກຂ້າມໄປ."

msgid ""
"Using huge component lists might have a performance impact, please consider "
"giving access via projects instead."
msgstr ""
"ການໃຊ້ລາຍການອົງປະກອບຂະໜາດໃຫຍ່ອາດສົ່ງຜົນກະທົບຕໍ່ປະສິດທິພາບ, "
"ກະລຸນາພິຈາລະນາໃຫ້ການເຂົ້າເຖິງຜ່ານໂຄງການແທນ."

msgid ""
"If the team specifies any :guilabel:`Components`, all the permissions given "
"to the members of that team are granted for all the components attached to "
"the team, and an access with no additional permissions is granted for all "
"the projects these components are in. :guilabel:`Projects` are ignored."
msgstr ""
"ຫາກທີມລະບຸ :guilabel:`ອົງປະກອບ` ໃດໜຶ່ງ, ສິດທິທັງໝົດທີ່ມອບໃຫ້ສະມາຊິກຂອງທີມນັ້ນ "
"ຈະຖືກມອບໃຫ້ສຳລັບອົງປະກອບທັງໝົດທີ່ຕິດກັບທີມ, ແລະ ການເຂົ້າເຖິງໂດຍບໍ່ມີສິດທິເພີ່ມເຕີມ "
"ຈະຖືກມອບໃຫ້ສຳລັບທຸກໂຄງການທີ່ອົງປະກອບເຫຼົ່ານັ້ນຢູ່. :guilabel:`ໂຄງການ` ຈະຖືກຂ້າມໄປ."

msgid ""
"Otherwise, if the team specifies any :guilabel:`Projects`, either by "
"directly listing them or by having :guilabel:`Projects selection` set to a "
"value like :guilabel:`All public projects`, all those permissions are "
"applied to all the projects, which effectively grants the same permissions "
"to access all projects :ref:`unrestricted components <component-restricted>`."
msgstr ""
"ຖ້າບໍ່ດັ່ງນັ້ນ, ຫາກທີມລະບຸ :guilabel:`ໂຄງການ` ໃດໜຶ່ງ, ບໍ່ວ່າຈະໂດຍການລາຍຊື່ໂດຍກົງ ຫຼື "
"ໂດຍການຕັ້ງຄ່າ :guilabel:`ການເລືອກໂຄງການ` "
"ໃຫ້ເປັນຄ່າເຊັ່ນ :guilabel:`ທຸກໂຄງການສາທາລະນະ`, ສິດທິທັງໝົດເຫຼົ່ານັ້ນຈະຖືກນຳໃຊ້ກັບທຸກໂຄງການ, "
"ເຊິ່ງຈະໃຫ້ສິດທິການເຂົ້າເຖິງດຽວກັນກັບທຸກໂຄງການ :ref:`ອົງປະກອບທີ່ບໍ່ຖືກຈຳກັດ <component-"
"restricted>` ຢ່າງມີປະສິດທິຜົນ."

msgid ""
"The restrictions imposed by a team’s :guilabel:`Languages` are applied "
"separately, when it’s verified if a user has access to perform certain "
"actions. Namely, it’s applied only to actions directly related to the "
"translation process itself like reviewing, saving translations, adding "
"suggestions, etc."
msgstr ""
"ການຈຳກັດທີ່ກຳນົດໂດຍ :guilabel:`ພາສາ` ຂອງທີມຈະຖືກນຳໃຊ້ແຍກຕ່າງຫາກ, "
"ເມື່ອມີການກວດສອບວ່າຜູ້ໃຊ້ມີສິດເຂົ້າເຖິງເພື່ອປະຕິບັດການດຳເນີນການບາງຢ່າງຫຼືບໍ່. ໂດຍສະເພາະ, "
"ມັນຈະຖືກນຳໃຊ້ສະເພາະກັບການດຳເນີນການທີ່ກ່ຽວຂ້ອງໂດຍກົງກັບຂະບວນການແປ ເຊັ່ນ ການກວດສອບ, "
"ການບັນທຶກການແປ, ການເພີ່ມຄຳແນະນຳ, ແລະ ອື່ນໆ."

msgid ""
"Individual team memberships can further limit these permissions to selected "
"languages. Leaving the per-member language limit empty applies no additional "
"limit beyond the team language selection. The same language limit can be set "
"when inviting new users to a project team. When a per-member language limit "
"is set, the membership grants only permissions that can be evaluated for one "
"of those languages. Project-wide, component-wide and global permissions from "
"that team are not granted for that member."
msgstr ""
"ການເປັນສະມາຊິກທີມແຕ່ລະຄົນສາມາດຈຳກັດສິດທິເຫຼົ່ານີ້ເພີ່ມເຕີມໃຫ້ສະເພາະພາສາທີ່ເລືອກໄດ້. "
"ການປ່ອຍໃຫ້ຂີດຈຳກັດພາສາຕໍ່ສະມາຊິກຫວ່າງໄວ້ຈະບໍ່ນຳໃຊ້ຂີດຈຳກັດເພີ່ມເຕີມນອກເໜືອຈາກການເລືອກພາສາຂອງທີມ. "
"ຂີດຈຳກັດພາສາດຽວກັນສາມາດຖືກຕັ້ງຄ່າໄດ້ເມື່ອເຊີນຜູ້ໃຊ້ໃໝ່ເຂົ້າໃນທີມໂຄງການ. "
"ເມື່ອມີການຕັ້ງຄ່າຂີດຈຳກັດພາສາຕໍ່ສະມາຊິກ, "
"ການເປັນສະມາຊິກຈະມອບພຽງແຕ່ສິດທິທີ່ສາມາດປະເມີນໄດ້ສຳລັບໜຶ່ງໃນພາສາເຫຼົ່ານັ້ນ. ສິດທິໃນລະດັບໂຄງການ, "
"ລະດັບອົງປະກອບ ແລະ ລະດັບໂລກຈາກທີມນັ້ນຈະບໍ່ຖືກມອບໃຫ້ແກ່ສະມາຊິກຄົນນັ້ນ."

msgid ""
"The VCS permissions to commit, push, reset, and update are evaluated for the "
"whole repository. A member needs component-wide permission on the component "
"owning the repository and every component linked to it. This also applies "
"when linked components are in other projects. A per-member language limit "
"therefore cannot grant these permissions."
msgstr ""
"ການອະນຸຍາດ VCS ເພື່ອຄອມມິດ (commit), ພຸຊ (push), ຣີເຊັດ (reset), ແລະ ອັບເດດ (update) "
"ແມ່ນຖືກປະເມີນສຳລັບຄັງເກັບ (repository) ທັງໝົດ. ສະມາຊິກຕ້ອງມີການອະນຸຍາດລະດັບສ່ວນປະກອບ "
"ໃນສ່ວນປະກອບທີ່ເປັນເຈົ້າຂອງຄັງເກັບ ແລະ ທຸກໆສ່ວນປະກອບທີ່ເຊື່ອມໂຍງກັບມັນ. "
"ສິ່ງນີ້ຍັງນຳໃຊ້ໃນເວລາທີ່ສ່ວນປະກອບທີ່ເຊື່ອມໂຍງນັ້ນຢູ່ໃນໂຄງການອື່ນ. ດັ່ງນັ້ນ, "
"ການຈຳກັດພາສາລາຍບຸກຄົນຈຶ່ງບໍ່ສາມາດໃຫ້ການອະນຸຍາດເຫຼົ່ານີ້ໄດ້."

msgid ""
"Project-wide repository status and operations filter repositories using this "
"rule. Repositories for which the member lacks permission on any linked "
"component are listed separately and are not inspected or changed. An "
"operation is denied when none of the project's repositories are available to "
"it."
msgstr ""

msgid ""
"The :guilabel:`Edit component settings` permission allows administrative "
"operations that can affect repository contents. For example, users can "
"choose files through component settings or install and configure component "
"add-ons. For a :ref:`linked component <internal-urls>`, these operations use "
"the complete shared checkout. Grant this permission only to users trusted by "
"the repository owner with that checkout. Ordinary translation permissions do "
"not grant this administrative access."
msgstr ""

msgid ""
"Repository-wide VCS permissions protect explicit commit, push, reset, and "
"update operations. They are not required for Weblate's normal background "
"commit and push of translation changes made through an authorized component."
msgstr ""

#, fuzzy
#| msgid ""
#| "Use :guilabel:`Language selection` or :guilabel:`Project selection` to "
#| "automate inclusion of all languages or projects."
msgid ""
"Use :guilabel:`All languages` or :guilabel:`Project selection` to automate "
"inclusion of all languages or projects."
msgstr ""
"ໃຊ້ :guilabel:`ການເລືອກພາສາ` ຫຼື :guilabel:`ການເລືອກໂຄງການ` ເພື່ອເຮັດໃຫ້ການລວມທຸກພາສາ "
"ຫຼື ໂຄງການເປັນອັດຕະໂນມັດ."

msgid ""
"A project ``foo`` with the components: ``foo/bar`` and ``foo/baz``, with "
"reviewing and management rights, in the following team:"
msgstr ""
"ໂຄງການ ``foo`` ທີ່ມີອົງປະກອບ: ``foo/bar`` ແລະ ``foo/baz``, ພ້ອມສິດທິການກວດສອບ ແລະ "
"ການຈັດການ, ໃນທີມດັ່ງຕໍ່ໄປນີ້:"

msgid "Group `Spanish Admin-Reviewers`"
msgstr "ກຸ່ມ `ຜູ້ກວດສອບ ແລະ ຜູ້ບໍລິຫານພາສາສະເປນ`"

msgid "`Review strings`, `Manage repository`"
msgstr "`ກວດສອບຂໍ້ຄວາມ`, `ຈັດການບ່ອນເກັບຂໍ້ມູນ`"

msgid "Components"
msgstr "ສ່ວນປະກອບ"

msgid "foo/bar"
msgstr "foo/bar"

msgid "`Spanish`"
msgstr "`ພາສາສະເປນ`"

msgid ""
"Members of that team will have these permissions (assuming the default role "
"settings):"
msgstr "ສະມາຊິກຂອງທີມນັ້ນຈະມີສິດທິເຫຼົ່ານີ້ (ໂດຍສົມມຸດວ່າເປັນການຕັ້ງຄ່າບົດບາດເລີ່ມຕົ້ນ):"

msgid ""
"General (browsing) access to the whole project ``foo`` including both "
"components in it: ``foo/bar`` and ``foo/baz``."
msgstr ""
"ສິດເຂົ້າເຖິງທົ່ວໄປ (ການຊອກຫາ) ຕໍ່ທັງໂຄງການ ``foo`` ລວມເຖິງອົງປະກອບທັງສອງໃນນັ້ນ: ``foo/"
"bar`` ແລະ ``foo/baz``."

msgid "Review strings in ``foo/bar`` Spanish translation (not elsewhere)."
msgstr "ກວດສອບຂໍ້ຄວາມໃນການແປພາສາສະເປນ ``foo/bar`` (ບໍ່ແມ່ນບ່ອນອື່ນ)."

msgid ""
"Manage VCS for the whole ``foo/bar`` repository e.g. commit pending changes "
"made by translators for all languages."
msgstr ""
"ຈັດການ VCS ສຳລັບບ່ອນເກັບຂໍ້ມູນ ``foo/bar`` ທັງໝົດ ເຊັ່ນ "
"ຄອມມິດການປ່ຽນແປງທີ່ຄ້າງໄວ້ໂດຍນັກແປສຳລັບທຸກພາສາ."

msgid "Automatic team assignments"
msgstr "ການກຳນົດທີມອັດຕະໂນມັດ"

msgid ""
"While editing the :guilabel:`Team`, you can "
"specify :guilabel:`Automatic assignments`, which is a list of regular "
"expressions used to automatically assign newly created users to a team based "
"on their e-mail addresses. This assignment only happens upon account "
"creation."
msgstr ""
"ໃນຂະນະທີ່ແກ້ໄຂ :guilabel:`ທີມ`, ທ່ານສາມາດລະບຸ :guilabel:`ການມອບໝາຍອັດຕະໂນມັດ`, "
"ເຊິ່ງເປັນລາຍການຂອງ regular expressions ທີ່ໃຊ້ເພື່ອມອບໝາຍຜູ້ໃຊ້ທີ່ສ້າງໃໝ່ເຂົ້າໃນທີມໂດຍອັດຕະໂນມັດ "
"ໂດຍອີງໃສ່ທີ່ຢູ່ອີເມວຂອງພວກເຂົາ. ການມອບໝາຍນີ້ຈະເກີດຂຶ້ນພຽງແຕ່ເມື່ອສ້າງບັນຊີເທົ່ານັ້ນ."

msgid ""
"The most common use-case for the feature is to assign all new users to some "
"default team. This behavior is used for the default `Users` and `Guest` "
"teams (see :ref:`default-teams`). Use regular expression ``^.*$`` to match "
"all users."
msgstr ""
"ກໍລະນີການໃຊ້ງານທົ່ວໄປທີ່ສຸດສຳລັບຄຸນສົມບັດນີ້ຄື ການມອບໝາຍຜູ້ໃຊ້ໃໝ່ທັງໝົດໃຫ້ກັບທີມເລີ່ມຕົ້ນ. "
"ພຶດຕິກຳນີ້ຖືກໃຊ້ສຳລັບທີມ `ຜູ້ໃຊ້` ແລະ `ແຂກ` ເລີ່ມຕົ້ນ (ເບິ່ງ :ref:`default-teams`). ໃຊ້ "
"regular expression ``^.*$`` ເພື່ອຈັບຄູ່ກັບຜູ້ໃຊ້ທັງໝົດ."

msgid ""
"Another use-case for this option might be to give some additional privileges "
"to employees of your company by default. Assuming all of them use corporate "
"e-mail addresses on your domain, this can be accomplished with an expression "
"like ``^.*@mycompany.com``."
msgstr ""
"ອີກກໍລະນີການໃຊ້ງານສຳລັບຕົວເລືອກນີ້ອາດຈະເປັນການໃຫ້ສິດທິພິເສດເພີ່ມເຕີມແກ່ພະນັກງານໃນບໍລິສັດຂອງທ່ານໂດຍຄ່າເລີ່ມຕົ້ນ. "
"ໂດຍສົມມຸດວ່າພວກເຂົາທັງໝົດໃຊ້ທີ່ຢູ່ອີເມວຂອງບໍລິສັດໃນໂດເມນຂອງທ່ານ, ສິ່ງນີ້ສາມາດເຮັດໃຫ້ສຳເລັດໄດ້ດ້ວຍ "
"expression ເຊັ່ນ ``^.*@mycompany.com``."

msgid ""
"Automatic team assignment to `Users` and `Viewers` is always recreated when "
"upgrading from one Weblate version to another. If you want to turn it off, "
"set the regular expression to ``^$`` (which won’t match anything)."
msgstr ""
"ການມອບໝາຍທີມອັດຕະໂນມັດໃຫ້ກັບ `ຜູ້ໃຊ້` ແລະ `ຜູ້ເບິ່ງ` ຈະຖືກສ້າງຂຶ້ນໃໝ່ສະເໝີເມື່ອອັບເກຣດຈາກ Weblate "
"ເວີຊັນໜຶ່ງໄປອີກເວີຊັນໜຶ່ງ. ຫາກທ່ານຕ້ອງການປິດມັນ, ໃຫ້ຕັ້ງຄ່າ regular expression ເປັນ ``^$`` "
"(ເຊິ່ງຈະບໍ່ຈັບຄູ່ກັບສິ່ງໃດເລີຍ)."

msgid ""
"Bulk inviting through the user interface creates invitations. Existing users "
"still have to confirm the invitation before they become team members."
msgstr ""
"ການເຊີນແບບຮອບດຽວຜ່ານອິນເຕີເຟດຜູ້ໃຊ້ຈະສ້າງຄຳເຊີນ. "
"ຜູ້ໃຊ້ທີ່ມີຢູ່ແລ້ວຍັງຕ້ອງຢືນຢັນຄຳເຊີນກ່ອນທີ່ພວກເຂົາຈະກາຍເປັນສະມາຊິກທີມ."

msgid "Default teams and roles"
msgstr "ທີມ ແລະ ບົດບາດເລີ່ມຕົ້ນ"

msgid ""
"After installation, a default set of teams is created (see :ref:`default-"
"teams`)."
msgstr "ຫຼັງຈາກການຕິດຕັ້ງ, ຊຸດທີມເລີ່ມຕົ້ນຈະຖືກສ້າງຂຶ້ນ (ເບິ່ງ :ref:`default-teams`)."

msgid ""
"These roles and teams are created upon installation. The built-in roles are "
"always kept up to date by the database migration when upgrading. You can’t "
"actually change them, please define a new role if you want to define your "
"own set of permissions."
msgstr ""
"ບົດບາດ ແລະ ທີມເຫຼົ່ານີ້ຖືກສ້າງຂຶ້ນເມື່ອຕິດຕັ້ງ. "
"ບົດບາດທີ່ມີມາໃຫ້ຈະຖືກຮັກສາໃຫ້ທັນສະໄໝສະເໝີໂດຍການຍ້າຍຖານຂໍ້ມູນ ເມື່ອອັບເກຣດ. "
"ທ່ານບໍ່ສາມາດປ່ຽນແປງພວກມັນໄດ້, ກະລຸນາກຳນົດບົດບາດໃໝ່ຫາກທ່ານຕ້ອງການກຳນົດຊຸດສິດທິຂອງທ່ານເອງ."

msgid ""
"Roles do not have a separate scope; the permissions in a role determine its "
"scope. A role containing a permission listed under :guilabel:`Site wide "
"privileges` grants that permission across the Weblate instance when assigned "
"through a site-wide team. The team's project selection does not narrow these "
"permissions."
msgstr ""

msgid ""
"Site-wide privileges are not granted to any default role. Treat custom roles "
"containing them as trusted administrative access because some are "
"effectively equivalent to superuser status. For example, ``user.edit`` "
"allows users to change their own team memberships and grant themselves "
"superuser status."
msgstr ""

msgid "List of teams"
msgstr "ລາຍການທີມ"

msgid ""
"The following teams are created upon installation (or after "
"executing :wladmin:`setupgroups`) and you are free to modify them. The "
"migration will, however, re-create them if you delete or rename them."
msgstr ""
"ທີມຕໍ່ໄປນີ້ຖືກສ້າງຂຶ້ນເມື່ອຕິດຕັ້ງ (ຫຼື ຫຼັງຈາກດຳເນີນການ :wladmin:`setupgroups`) ແລະ "
"ທ່ານມີອິດສະຫຼະທີ່ຈະແກ້ໄຂພວກມັນ. ຢ່າງໃດກໍຕາມ, ການຍ້າຍຈະສ້າງພວກມັນຄືນໃໝ່ຫາກທ່ານລຶບ ຫຼື ປ່ຽນຊື່."

msgid "`Guests`"
msgstr "`ແຂກ`"

msgid "Defines permissions for non-authenticated users."
msgstr "ກຳນົດສິດທິສຳລັບຜູ້ໃຊ້ທີ່ບໍ່ໄດ້ຢືນຢັນຕົວຕົນ."

msgid ""
"This team only contains anonymous users (see :setting:`ANONYMOUS_USER_NAME`)."
msgstr "ທີມນີ້ບັນຈຸພຽງແຕ່ຜູ້ໃຊ້ທີ່ບໍ່ເປີດເຜີຍຊື່ (ເບິ່ງ :setting:`ANONYMOUS_USER_NAME`)."

msgid ""
"Remove roles from this team to limit permissions for non-authenticated users."
msgstr "ລຶບບົດບາດອອກຈາກທີມນີ້ເພື່ອຈຳກັດສິດທິສຳລັບຜູ້ໃຊ້ທີ່ບໍ່ໄດ້ຢືນຢັນຕົວຕົນ."

msgid "Default roles: `Add suggestion`, `Access repository`"
msgstr "ບົດບາດເລີ່ມຕົ້ນ: `ເພີ່ມຄຳແນະນຳ`, `ເຂົ້າເຖິງບ່ອນເກັບຂໍ້ມູນ`"

msgid "`Viewers`"
msgstr "`ຜູ້ເບິ່ງ`"

msgid ""
"This role ensures the visibility of public projects to all users. By "
"default, all users are members of this team."
msgstr ""
"ບົດບາດນີ້ຮັບປະກັນການເບິ່ງເຫັນຂອງໂຄງການສາທາລະນະຕໍ່ຜູ້ໃຊ້ທຸກຄົນ. ໂດຍຄ່າເລີ່ມຕົ້ນ, "
"ຜູ້ໃຊ້ທຸກຄົນແມ່ນສະມາຊິກຂອງທີມນີ້."

msgid ""
"By default, :ref:`automatic team assignment <autoteam>` makes all new "
"accounts members of this team when they join."
msgstr ""
"ໂດຍຄ່າເລີ່ມຕົ້ນ, :ref:`ການກຳນົດທີມອັດຕະໂນມັດ <autoteam>` "
"ເຮັດໃຫ້ບັນຊີໃໝ່ທັງໝົດເປັນສະມາຊິກຂອງທີມນີ້ ເມື່ອພວກເຂົາເຂົ້າຮ່ວມ."

msgid "Default roles: none"
msgstr "ບົດບາດເລີ່ມຕົ້ນ: ບໍ່ມີ"

msgid "`Users`"
msgstr "`ຜູ້ໃຊ້`"

msgid "Default team for all users."
msgstr "ທີມເລີ່ມຕົ້ນສຳລັບຜູ້ໃຊ້ທຸກຄົນ."

msgid "Default roles: `Power user`"
msgstr "ບົດບາດເລີ່ມຕົ້ນ: `ຜູ້ໃຊ້ຂັ້ນສູງ`"

msgid "`Reviewers`"
msgstr "`ຜູ້ກວດສອບ`"

msgid "Group for reviewers (see :ref:`workflows`)."
msgstr "ກຸ່ມສຳລັບຜູ້ກວດສອບ (ເບິ່ງ :ref:`workflows`)."

msgid "Default roles: `Review strings`"
msgstr "ບົດບາດເລີ່ມຕົ້ນ: `ກວດສອບຂໍ້ຄວາມ`"

msgid "`Managers`"
msgstr "`ຜູ້ຈັດການ`"

msgid "Group for administrators."
msgstr "ກຸ່ມສຳລັບຜູ້ດູແລລະບົບ."

msgid "Default roles: `Administration`"
msgstr "ບົດບາດເລີ່ມຕົ້ນ: `ການບໍລິຫານ`"

msgid "`Project creators`"
msgstr "`ຜູ້ສ້າງໂຄງການ`"

msgid "Users who can create new projects."
msgstr "ຜູ້ໃຊ້ທີ່ສາມາດສ້າງໂຄງການໃໝ່."

msgid "Default roles: `Add new projects`"
msgstr "ບົດບາດເລີ່ມຕົ້ນ: `ເພີ່ມໂຄງການໃໝ່`"

msgid ""
"Never remove the predefined Weblate teams and users, as that can lead to "
"unexpected problems! If you have no use for them, simply remove all their "
"privileges instead."
msgstr ""
"ຢ່າລຶບທີມ ແລະ ຜູ້ໃຊ້ທີ່ກຳນົດໄວ້ລ່ວງໜ້າຂອງ Weblate ເດັດຂາດ, ເພາະມັນອາດນຳໄປສູ່ບັນຫາທີ່ບໍ່ຄາດຄິດ! "
"ຫາກທ່ານບໍ່ໄດ້ໃຊ້ພວກມັນ, ພຽງແຕ່ລຶບສິດທິທັງໝົດຂອງພວກມັນອອກແທນ."

msgid "Additional access restrictions"
msgstr "ການຈຳກັດການເຂົ້າເຖິງເພີ່ມເຕີມ"

msgid ""
"If you want to use your Weblate installation in a less public manner, i.e. "
"allow new users on an invitational basis only, it can be done by configuring "
"Weblate in such a way that only known users have an access to it. In order "
"to do so, you can set :setting:`REGISTRATION_OPEN` to ``False`` to prevent "
"registrations of any new users, and set :setting:`REQUIRE_LOGIN` to ``True`` "
"to require signing in to access all the site pages. This is basically the "
"way to lock your Weblate installation."
msgstr ""
"ຫາກທ່ານຕ້ອງການໃຊ້ Weblate ທີ່ຕິດຕັ້ງໄວ້ໃນລັກສະນະທີ່ບໍ່ສາທາລະນະ, ເຊັ່ນ "
"ອະນຸຍາດໃຫ້ຜູ້ໃຊ້ໃໝ່ສະເພາະແບບການເຊີນເທົ່ານັ້ນ, ມັນສາມາດເຮັດໄດ້ໂດຍການຕັ້ງຄ່າ Weblate "
"ໃນແບບທີ່ໃຫ້ສະເພາະຜູ້ໃຊ້ທີ່ຮູ້ຈັກເທົ່ານັ້ນມີສິດເຂົ້າເຖິງ. ເພື່ອເຮັດສິ່ງນີ້, "
"ທ່ານສາມາດຕັ້ງຄ່າ :setting:`REGISTRATION_OPEN` ເປັນ ``False`` "
"ເພື່ອປ້ອງກັນການລົງທະບຽນຜູ້ໃຊ້ໃໝ່, ແລະ ຕັ້ງຄ່າ :setting:`REQUIRE_LOGIN` ເປັນ ``True`` "
"ເພື່ອບັງຄັບໃຫ້ລົງຊື່ເຂົ້າໃຊ້ ເພື່ອເຂົ້າເຖິງໜ້າເວັບໄຊທັງໝົດ. ນີ້ແມ່ນວິທີໂດຍພື້ນຖານໃນການລັອກການຕິດຕັ້ງ "
"Weblate ຂອງທ່ານ."

msgid ""
"Additionally, changing :setting:`DEFAULT_ACCESS_CONTROL` to ``100`` will "
"make all newly created projects private, requiring explicit access to be "
"granted."
msgstr ""
"ນອກຈາກນັ້ນ, ການປ່ຽນ :setting:`DEFAULT_ACCESS_CONTROL` ເປັນ ``100`` "
"ຈະເຮັດໃຫ້ໂຄງການທີ່ສ້າງໃໝ່ທັງໝົດເປັນສ່ວນຕົວ, ເຊິ່ງຕ້ອງໄດ້ຮັບການອະນຸຍາດເຂົ້າເຖິງຢ່າງຊັດເຈນ."

msgid "You can use built-in :ref:`invite-user` to add new users."
msgstr "ທ່ານສາມາດໃຊ້ :ref:`invite-user` ທີ່ມີມາໃຫ້ເພື່ອເພີ່ມຜູ້ໃຊ້ໃໝ່."

msgid "Expiration of user accounts"
msgstr "ການໝົດອາຍຸຂອງບັນຊີຜູ້ໃຊ້"

msgid ""
"Each account can have an expiry set. After the expiration, the account will "
"be automatically disabled. This is used for :ref:`project-api`, but can be "
"utilized for regular users as well."
msgstr ""
"ແຕ່ລະບັນຊີສາມາດຕັ້ງຄ່າວັນໝົດອາຍຸໄດ້. ຫຼັງຈາກການໝົດອາຍຸ, ບັນຊີຈະຖືກປິດການໃຊ້ງານໂດຍອັດຕະໂນມັດ. "
"ສິ່ງນີ້ຖືກໃຊ້ສຳລັບ :ref:`project-api`, ແຕ່ສາມາດນຳໃຊ້ສຳລັບຜູ້ໃຊ້ທົ່ວໄປໄດ້ເຊັ່ນກັນ."

msgid "Add-ons"
msgstr "ສ່ວນເສີມ"

msgid ""
"Add-ons provide ways to customize and automate the translation workflow. "
"Admins can add and manage add-ons from the :guilabel:`Operations` "
"↓ :guilabel:`Add-ons` menu of each respective translation project or "
"component. Add-ons can be also installed site-wide in :ref:`management-"
"interface`."
msgstr ""
"ສ່ວນເສີມໃຫ້ວິທີການປັບແຕ່ງ ແລະ ອັດຕະໂນມັດຂະບວນການແປ. ຜູ້ດູແລລະບົບສາມາດເພີ່ມ ແລະ "
"ຈັດການສ່ວນເສີມໄດ້ຈາກເມນູ :guilabel:`ການດຳເນີນງານ` ↓ :guilabel:`ສ່ວນເສີມ` "
"ຂອງແຕ່ລະໂຄງການ ຫຼື ອົງປະກອບການແປ. "
"ສ່ວນເສີມຍັງສາມາດຕິດຕັ້ງໃນລະດັບເວັບໄຊໄດ້ໃນ :ref:`ອິນເຕີເຟດການຈັດການ <management-"
"interface>`."

msgid ""
"You can also configure add-ons using :ref:`API <addons-"
"api>`, :setting:`DEFAULT_ADDONS`, or :wladmin:`install_addon`."
msgstr ""
"ທ່ານຍັງສາມາດຕັ້ງຄ່າສ່ວນເສີມໂດຍໃຊ້ :ref:`API <addons-"
"api>`, :setting:`DEFAULT_ADDONS`, ຫຼື :wladmin:`install_addon`."

msgid ""
"Add-ons that opt in to manual triggering can be run from add-on management "
"or using the :ref:`API <addons-api>`. Results are recorded in the add-on "
"activity log."
msgstr ""
"ສ່ວນເສີມທີ່ເລືອກເປີດໃຊ້ການກະຕຸ້ນດ້ວຍຕົນເອງສາມາດດຳເນີນການໄດ້ຈາກການຈັດການສ່ວນເສີມ ຫຼື "
"ໂດຍໃຊ້ :ref:`API <addons-api>`. ຜົນໄດ້ຮັບຈະຖືກບັນທຶກໄວ້ໃນບັນທຶກກິດຈະກຳຂອງສ່ວນເສີມ."

msgid "Obsolete add-ons"
msgstr "ສ່ວນເສີມທີ່ລ້າສະໄໝ"

msgid "Customize XML output"
msgstr "ປັບແຕ່ງຜົນລວມ XML"

msgid "Replaced by :ref:`file_format_params`."
msgstr "ຖືກແທນທີ່ໂດຍ :ref:`file_format_params`."

msgid "Customize YAML output"
msgstr "ປັບແຕ່ງຜົນລວມ YAML"

msgid "Customizing list of add-ons"
msgstr "ການປັບແຕ່ງລາຍການສ່ວນເສີມ"

msgid ""
"The list of add-ons is configured by :setting:`WEBLATE_ADDONS`. To add "
"another add-on, simply include the absolute class name in this setting."
msgstr ""
"ລາຍການຂອງສ່ວນເສີມຖືກຕັ້ງຄ່າໂດຍ :setting:`WEBLATE_ADDONS`. ເພື່ອເພີ່ມສ່ວນເສີມອື່ນ, "
"ພຽງແຕ່ໃສ່ຊື່ຄລາສທີ່ສົມບູນໃນການຕັ້ງຄ່ານີ້."

msgid "Writing add-on"
msgstr "ການຂຽນສ່ວນເສີມ"

msgid ""
"You can write your own add-ons too, create a subclass "
"of :class:`weblate.addons.base.BaseAddon` to define the add-on metadata, and "
"then implement a callback to do the processing."
msgstr ""
"ທ່ານສາມາດຂຽນສ່ວນເສີມຂອງທ່ານເອງໄດ້ເຊັ່ນກັນ, ສ້າງ subclass "
"ຂອງ :class:`weblate.addons.base.BaseAddon` ເພື່ອລະບຸເມຕາດາຕ້າຂອງສ່ວນເສີມ, ແລະ "
"ຈາກນັ້ນປະຕິບັດ callback ເພື່ອເຮັດການປະມວນຜົນ."

msgid "Executing scripts from add-on"
msgstr "ການດຳເນີນການສະຄຣິບຈາກສ່ວນເສີມ"

msgid ""
"Add-ons can also be used to execute external scripts. This used to be "
"integrated in Weblate, but now you have to write some code to wrap your "
"script with an add-on."
msgstr ""
"ສ່ວນເສີມຍັງສາມາດຖືກໃຊ້ເພື່ອດຳເນີນການສະຄຣິບພາຍນອກ. ໂດຍປົກກະຕິແລ້ວມັນຈະຖືກລວມເຂົ້າໃນ Weblate, "
"ແຕ່ດຽວນີ້ທ່ານຕ້ອງຂຽນລະຫັດເພື່ອຫຸ້ມສະຄຣິບຂອງທ່ານດ້ວຍສ່ວນເສີມ."

msgid "For installation instructions see :ref:`custom-addon-modules`."
msgstr "ສຳລັບຄຳແນະນຳການຕິດຕັ້ງ ເບິ່ງ :ref:`custom-addon-modules`."

msgid ""
"The script is executed with the current directory set to the root of the VCS "
"repository for any given component."
msgstr ""
"ສະຄຣິບຈະຖືກດຳເນີນການໂດຍມີໄດເລກະທໍລີປັດຈຸບັນຕັ້ງເປັນຮາກຂອງບ່ອນເກັບຂໍ້ມູນ VCS ສຳລັບອົງປະກອບໃດກໍຕາມ."

msgid "Additionally, the following environment variables are available:"
msgstr "ນອກຈາກນັ້ນ, ຍັງມີຕົວແປສະພາບແວດລ້ອມຕໍ່ໄປນີ້ໃຫ້ໃຊ້ງານ:"

msgid "Version control system used."
msgstr "ລະບົບຄວບຄຸມເວີຊັນທີ່ໃຊ້."

msgid "Upstream repository URL."
msgstr "URL ບ່ອນເກັບຂໍ້ມູນຕົ້ນທາງ."

msgid "Absolute path to VCS repository."
msgstr "ເສັ້ນທາງທີ່ສົມບູນໄປຫາບ່ອນເກັບຂໍ້ມູນ VCS."

msgid "Repository branch configured in the current component."
msgstr "ສາຂາບ່ອນເກັບຂໍ້ມູນທີ່ຕັ້ງຄ່າໃນອົງປະກອບປັດຈຸບັນ."

msgid "File mask for current component."
msgstr "ໜ້າກາກໄຟລ໌ສຳລັບອົງປະກອບປັດຈຸບັນ."

msgid "Filename of template for monolingual translations (can be empty)."
msgstr "ຊື່ໄຟລ໌ຂອງເທມເພລດສຳລັບການແປແບບພາສາດຽວ (ສາມາດຫວ່າງໄວ້ໄດ້)."

msgid "Filename of the file used for creating new translations (can be empty)."
msgstr "ຊື່ໄຟລ໌ທີ່ໃຊ້ສຳລັບການສ້າງການແປໃໝ່ (ສາມາດຫວ່າງໄວ້ໄດ້)."

msgid "File format used in current component."
msgstr "ຮູບແບບໄຟລ໌ທີ່ໃຊ້ໃນອົງປະກອບປັດຈຸບັນ."

msgid ""
"Language of currently processed translation (not available for component-"
"level hooks)."
msgstr "ພາສາຂອງການແປທີ່ກຳລັງປະມວນຜົນ (ບໍ່ມີໃຫ້ສຳລັບ hooks ລະດັບອົງປະກອບ)."

msgid ""
"Previous HEAD after update (only available after running the post-update "
"hook)."
msgstr "HEAD ກ່ອນໜ້າຫຼັງຈາກອັບເດດ (ມີໃຫ້ສະເພາະຫຼັງຈາກດຳເນີນການ post-update hook)."

msgid "Component slug used to construct URL."
msgstr "Component slug ທີ່ໃຊ້ສຳລັບສ້າງ URL."

msgid "Project slug used to construct URL."
msgstr "Project slug ທີ່ໃຊ້ສຳລັບສ້າງ URL."

msgid "Component name."
msgstr "ຊື່ອົງປະກອບ."

msgid "Project name."
msgstr "ຊື່ໂຄງການ."

msgid "Component URL."
msgstr "URL ອົງປະກອບ."

msgid "Project engage URL."
msgstr "URL ໂຄງການ."

msgid "Post-update repository processing"
msgstr "ການປະມວນຜົນບ່ອນເກັບຂໍ້ມູນຫຼັງການອັບເດດ"

msgid ""
"Can be used to update translation files when the VCS upstream source "
"changes. To achieve this, please remember Weblate only sees files committed "
"to the VCS, so you need to commit changes as a part of the script."
msgstr ""
"ສາມາດໃຊ້ເພື່ອອັບເດດໄຟລ໌ການແປເມື່ອແຫຼ່ງຂໍ້ມູນຕົ້ນທາງ VCS ປ່ຽນແປງ. ເພື່ອເຮັດສິ່ງນີ້, ກະລຸນາຈື່ໄວ້ວ່າ "
"Weblate ເຫັນສະເພາະໄຟລ໌ທີ່ຄອມມິດໃສ່ VCS, ດັ່ງນັ້ນທ່ານຕ້ອງຄອມມິດການປ່ຽນແປງເປັນສ່ວນໜຶ່ງຂອງສະຄຣິບ."

msgid "For example with Gulp you can do it using following code:"
msgstr "ຕົວຢ່າງ, ດ້ວຍ Gulp ທ່ານສາມາດເຮັດໄດ້ໂດຍໃຊ້ລະຫັດຕໍ່ໄປນີ້:"

msgid "Pre-commit processing of translations"
msgstr "ການປະມວນຜົນການແປກ່ອນການຄອມມິດ"

msgid ""
"Use the commit script to automatically change a translation before it is "
"committed to the repository."
msgstr "ໃຊ້ສະຄຣິບຄອມມິດເພື່ອປ່ຽນແປງການແປໂດຍອັດຕະໂນມັດກ່ອນທີ່ມັນຈະຖືກຄອມມິດໃສ່ບ່ອນເກັບຂໍ້ມູນ."

msgid ""
"It is passed as a single parameter consisting of the filename of a current "
"translation."
msgstr "ມັນຖືກສົ່ງຜ່ານເປັນພາຣາມິເຕີດຽວທີ່ປະກອບດ້ວຍຊື່ໄຟລ໌ຂອງການແປປັດຈຸບັນ."

msgid "Add-on activity logging"
msgstr "ບັນທຶກກິດຈະກຳຂອງສ່ວນເສີມ"

msgid ""
"Add-on activity log keeps track of the add-on execution and can be used to "
"keep track of add-on activity."
msgstr ""
"ບັນທຶກກິດຈະກຳຂອງສ່ວນເສີມຈະຕິດຕາມການດຳເນີນການຂອງສ່ວນເສີມ ແລະ "
"ສາມາດໃຊ້ເພື່ອຕິດຕາມກິດຈະກຳຂອງສ່ວນເສີມ."

msgid ""
"Each entry records whether processing is pending, successful, failed, or "
"skipped. Skipped entries include the reason the add-on did not run, such as "
"an incompatible component, no relevant changes, or a configured schedule "
"that is not due yet. A successful entry can still mean that the add-on "
"checked its inputs but found nothing to change."
msgstr ""
"ແຕ່ລະລາຍການບັນທຶກວ່າການປະມວນຜົນແມ່ນກຳລັງລໍຖ້າ, ສຳເລັດ, ຫຼົ້ມເຫຼວ, ຫຼື ຖືກຂ້າມ. "
"ລາຍການທີ່ຖືກຂ້າມຈະລວມມີເຫດຜົນທີ່ສ່ວນເສີມບໍ່ໄດ້ເຮັດວຽກ, ເຊັ່ນ: ສ່ວນປະກອບທີ່ເຂົ້າກັນບໍ່ໄດ້, "
"ບໍ່ມີການປ່ຽນແປງທີ່ກ່ຽວຂ້ອງ, ຫຼື ຕາຕະລາງເວລາທີ່ຕັ້ງໄວ້ຍັງບໍ່ທັນຮອດກຳນົດ. "
"ລາຍການທີ່ສຳເລັດຍັງສາມາດໝາຍຄວາມວ່າສ່ວນເສີມໄດ້ກວດສອບຂໍ້ມູນນຳເຂົ້າແລ້ວແຕ່ບໍ່ພົບສິ່ງໃດທີ່ຈະປ່ຽນແປງ."

msgid ""
"For scope-wide add-ons that process components independently, the activity "
"log contains a separate entry for each component."
msgstr ""
"ສຳລັບສ່ວນເສີມໃນຂອບເຂດກວ້າງທີ່ປະມວນຜົນສ່ວນປະກອບຢ່າງເປັນເອກະລາດ, "
"ບັນທຶກກິດຈະກຳຈະມີລາຍການແຍກຕ່າງຫາກສຳລັບແຕ່ລະສ່ວນປະກອບ."

msgid ""
"The logs can be pruned after a certain time interval by configuring "
"the :setting:`ADDON_ACTIVITY_LOG_EXPIRY`."
msgstr "ບັນທຶກສາມາດຖືກລຶບລ້າງຫຼັງຈາກໄລຍະເວລາໃດໜຶ່ງໂດຍການຕັ້ງຄ່າ :setting:`ADDON_ACTIVITY_LOG_EXPIRY`."

msgid "Management interface"
msgstr "ອິນເຕີເຟດການຈັດການ"

msgid ""
"The management interface offer administration settings under the :file:`/"
"manage/` URL. It is available for users signed in with admin privileges, "
"accessible by using the wrench icon top right:"
msgstr ""
"ອິນເຕີເຟດການຈັດການສະເໜີການຕັ້ງຄ່າການບໍລິຫານພາຍໃຕ້ URL :file:`/manage/`. "
"ມັນມີໃຫ້ສຳລັບຜູ້ໃຊ້ທີ່ລົງຊື່ເຂົ້າໃຊ້ດ້ວຍສິດຜູ້ດູແລ, ສາມາດເຂົ້າເຖິງໄດ້ໂດຍໃຊ້ໄອຄອນຮູບປະແຈຢູ່ເບື້ອງຂວາເທິງ:"

msgid "It includes basic overview of your Weblate:"
msgstr "ມັນລວມເຖິງພາບລວມພື້ນຖານຂອງ Weblate ຂອງທ່ານ:"

msgid "Support status, see :doc:`support`."
msgstr "ສະຖານະການສະໜັບສະໜູນ, ເບິ່ງ :doc:`support`."

msgid "Backups, see :doc:`backup`."
msgstr "ການສຳຮອງຂໍ້ມູນ, ເບິ່ງ :doc:`backup`."

msgid "Shared translation memory, see :doc:`memory`."
msgstr "ໜ່ວຍຄວາມຈຳການແປແບບແບ່ງປັນ, ເບິ່ງ :doc:`memory`."

msgid ""
":ref:`manage-performance` to review Weblate health and length of Celery "
"queues."
msgstr ""
":ref:`manage-performance` ເພື່ອກວດສອບສຸຂະພາບຂອງ Weblate ແລະ ຄວາມຍາວຂອງຄິວ Celery."

msgid "SSH keys management, see :ref:`ssh-repos`."
msgstr "ການຈັດການຄີ SSH, ເບິ່ງ :ref:`ssh-repos`."

msgid "Alerts overview for all components, see :ref:`alerts`."
msgstr "ພາບລວມການແຈ້ງເຕືອນສຳລັບທຸກອົງປະກອບ, ເບິ່ງ :ref:`alerts`."

msgid ""
"Users and teams, see :ref:`custom-acl`; site administrators can "
"also :ref:`clean up user contributions <cleanup-user-contributions>`."
msgstr ""
"ຜູ້ໃຊ້ ແລະ ທີມ, ເບິ່ງ :ref:`custom-acl`; "
"ຜູ້ດູແລລະບົບຍັງສາມາດ :ref:`ລ້າງຂໍ້ມູນການປະກອບສ່ວນຂອງຜູ້ໃຊ້ <cleanup-user-contributions>`."

msgid ":ref:`manage-appearance`."
msgstr ":ref:`manage-appearance`."

msgid "Configure :ref:`machine-translation-setup`."
msgstr "ຕັ້ງຄ່າ :ref:`machine-translation-setup`."

msgid "Configure site-wide addons, see :ref:`addons`."
msgstr "ຕັ້ງຄ່າສ່ວນເສີມໃນລະດັບເວັບໄຊ, ເບິ່ງ :ref:`addons`."

msgid "Performance report"
msgstr "ລາຍງານປະສິດທິພາບ"

msgid ""
"This page provides an overview of Weblate configuration and performance "
"status."
msgstr "ໜ້ານີ້ໃຫ້ພາບລວມຂອງການຕັ້ງຄ່າ Weblate ແລະ ສະຖານະປະສິດທິພາບ."

msgid ""
":guilabel:`Configuration errors` indicate issues present in your "
"environment. It covers missing optional dependencies (see :ref:`python-"
"deps`), configuration issues or delayed processing of background tasks "
"(see :ref:`celery`)."
msgstr ""
":guilabel:`ຂໍ້ຜິດພາດໃນການຕັ້ງຄ່າ` ຊີ້ໃຫ້ເຫັນບັນຫາທີ່ມີຢູ່ໃນສະພາບແວດລ້ອມຂອງທ່ານ. ມັນກວມເຖິງ "
"dependencies ທາງເລືອກທີ່ຂາດຫາຍໄປ (ເບິ່ງ :ref:`python-deps`), ບັນຫາການຕັ້ງຄ່າ ຫຼື "
"ການປະມວນຜົນວຽກເບື້ອງຫຼັງທີ່ล่าຊ້າ (ເບິ່ງ :ref:`celery`)."

msgid ""
":guilabel:`System checks` lists possible configuration issues. These can be "
"silenced using :setting:`django:SILENCED_SYSTEM_CHECKS`, see "
"also :doc:`django:howto/deployment/checklist`."
msgstr ""
":guilabel:`ການກວດສອບລະບົບ` ລາຍຊື່ບັນຫາການຕັ້ງຄ່າທີ່ເປັນໄປໄດ້. "
"ສິ່ງເຫຼົ່ານີ້ສາມາດເຮັດໃຫ້ງຽບໄດ້ໂດຍໃຊ້ :setting:`django:SILENCED_SYSTEM_CHECKS`, "
"ເບິ່ງຕື່ມທີ່ :doc:`django:howto/deployment/checklist`."

msgid ""
":guilabel:`Celery queues` provides overview of Celery queues. These "
"typically should be close to zero. The same can be obtained on the command "
"line using :wladmin:`celery_queues`."
msgstr ""
":guilabel:`ຄິວ Celery` ໃຫ້ພາບລວມຂອງຄິວ Celery. ໂດຍປົກກະຕິສິ່ງເຫຼົ່ານີ້ຄວນຈະໃກ້ກັບສູນ. "
"ສິ່ງດຽວກັນສາມາດໄດ້ຮັບຜ່ານທາງຄຳສັ່ງໂດຍໃຊ້ :wladmin:`celery_queues`."

msgid ""
":guilabel:`HTTP environment` allows you to see HTTP environment observed by "
"Weblate. This is useful when debugging reverse proxy configuration, "
"see :ref:`reverse-proxy`. :guilabel:`HTTP headers` shows complete HTTP "
"request headers to provide additional information."
msgstr ""
":guilabel:`ສະພາບແວດລ້ອມ HTTP` ຊ່ວຍໃຫ້ທ່ານເຫັນສະພາບແວດລ້ອມ HTTP ທີ່ Weblate ສັງເກດເຫັນ. "
"ນີ້ມີປະໂຫຍດເມື່ອດີບັກການຕັ້ງຄ່າ reverse proxy, ເບິ່ງ :ref:`reverse-"
"proxy`. :guilabel:`ສ່ວນຫົວ HTTP` ສະແດງສ່ວນຫົວຂອງຄຳຮ້ອງຂໍ HTTP ທີ່ສົມບູນເພື່ອໃຫ້ຂໍ້ມູນເພີ່ມເຕີມ."

msgid ""
":guilabel:`System encoding` should list ``UTF-8`` encoding in all processes. "
"This needs to be configured in your system, see :ref:`production-encoding`."
msgstr ""
":guilabel:`ການເຂົ້າລະຫັດລະບົບ` ຄວນສະແດງການເຂົ້າລະຫັດ ``UTF-8`` ໃນທຸກຂະບວນການ. "
"ນີ້ຈຳເປັນຕ້ອງຖືກຕັ້ງຄ່າໃນລະບົບຂອງທ່ານ, ເບິ່ງ :ref:`production-encoding`."

#, fuzzy
#| msgid ""
#| ":guilabel:`Connectivity` shows latencies to the database, cache, and "
#| "Celery. This might be useful to diagnose connectivity issues."
msgid ""
":guilabel:`Connectivity` shows latencies to the database, cache, Celery, and "
"the filesystems used for data and cache directories. This might be useful to "
"diagnose connectivity and storage performance issues."
msgstr ""
":guilabel:`ການເຊື່ອມຕໍ່` ສະແດງຄວາມລ່າຊ້າໄປຫາຖານຂໍ້ມູນ, ແຄຊ, ແລະ Celery. "
"ອັນນີ້ອາດມີປະໂຫຍດໃນການວິນິດໄສບັນຫາການເຊື່ອມຕໍ່."

msgid "Appearance customization"
msgstr "ການປັບແຕ່ງຮູບລັກສະນະ"

msgid ""
"The colors are currently used in both dark and light theme, so be careful "
"when choosing them."
msgstr "ສີຖືກໃຊ້ໃນປັດຈຸບັນໃນທັງຮູບແບບມືດ ແລະ ສະຫວ່າງ, ດັ່ງນັ້ນຈົ່ງລະວັງເມື່ອເລືອກສີເຫຼົ່ານັ້ນ."

msgid "Colors, fonts, and page appearance can be customized here."
msgstr "ສີ, ຕົວອັກສອນ, ແລະ ຮູບລັກສະນະຂອງໜ້າສາມາດປັບແຕ່ງໄດ້ທີ່ນີ້."

msgid "If you are looking for more customization, see :doc:`/admin/customize`."
msgstr "ຫາກທ່ານກຳລັງຊອກຫາການປັບແຕ່ງເພີ່ມເຕີມ, ເບິ່ງ :doc:`/admin/customize`."

msgid "The Django admin interface"
msgstr "ອິນເຕີເຟດຜູ້ດູແລ Django"

msgid ""
"Use with caution as this is a low level interface. You should not need it in "
"most cases as most things are comfortably approachable through Weblate UI or "
"API."
msgstr ""
"ໃຊ້ດ້ວຍຄວາມລະມັດລະວັງເພາະນີ້ແມ່ນອິນເຕີເຟດລະດັບຕ່ຳ. ທ່ານບໍ່ຄວນຈະຕ້ອງການມັນໃນກໍລະນີສ່ວນໃຫຍ່ "
"ເພາະສິ່ງສ່ວນໃຫຍ່ສາມາດເຂົ້າເຖິງໄດ້ຢ່າງສະດວກສະບາຍຜ່ານ Weblate UI ຫຼື API."

msgid ""
"Here you can manage objects stored in the database, such as users, "
"translations and other settings."
msgstr "ທີ່ນີ້ທ່ານສາມາດຈັດການວັດຖຸທີ່ເກັບໄວ້ໃນຖານຂໍ້ມູນ, ເຊັ່ນ ຜູ້ໃຊ້, ການແປ ແລະ ການຕັ້ງຄ່າອື່ນໆ."

msgid ""
"In the :guilabel:`Reports` section, you can check the status of your site, "
"tweak it for :ref:`production`, or manage SSH keys used to access :ref:`vcs-"
"repos`."
msgstr ""
"ໃນພາກ :guilabel:`ລາຍງານ`, ທ່ານສາມາດກວດສອບສະຖານະຂອງເວັບໄຊຂອງທ່ານ, "
"ປັບແຕ່ງມັນສຳລັບ :ref:`production`, ຫຼື ຈັດການຄີ SSH ທີ່ໃຊ້ເພື່ອເຂົ້າເຖິງ :ref:`vcs-repos`."

msgid ""
"Use the Weblate UI or API for normal operations such as creating projects, "
"creating components, managing users, or posting announcements."
msgstr ""
"ໃຊ້ Weblate UI ຫຼື API ສຳລັບການດຳເນີນງານປົກກະຕິ ເຊັ່ນ ການສ້າງໂຄງການ, ການສ້າງອົງປະກອບ, "
"ການຈັດການຜູ້ໃຊ້, ຫຼື ການປະກາດ."

msgid "Project and component creation"
msgstr "ການສ້າງໂຄງການ ແລະ ອົງປະກອບ"

msgid ""
"Projects and components are created from the regular Weblate UI. Projects "
"serve as containers for translation components, and components can use "
"bilingual or monolingual translation files. See :ref:`project` "
"and :ref:`component` for the available settings, and :ref:`bimono` for how "
"bilingual and monolingual formats differ."
msgstr ""
"ໂຄງການ ແລະ ອົງປະກອບຖືກສ້າງຂຶ້ນຈາກ Weblate UI ປົກກະຕິ. "
"ໂຄງການເຮັດໜ້າທີ່ເປັນພາຊະນະສຳລັບອົງປະກອບການແປ, ແລະ ອົງປະກອບສາມາດໃຊ້ໄຟລ໌ການແປແບບສອງພາສາ "
"ຫຼື ພາສາດຽວ. ເບິ່ງ :ref:`project` ແລະ :ref:`component` ສຳລັບການຕັ້ງຄ່າທີ່ມີ, "
"ແລະ :ref:`bimono` ສຳລັບຄວາມແຕກຕ່າງລະຫວ່າງຮູບແບບສອງພາສາ ແລະ ພາສາດຽວ."

msgid "Announcements"
msgstr "ການປະກາດ"

msgid "In prior releases this feature was called whiteboard messages."
msgstr "ໃນເວີຊັນກ່ອນໜ້ານີ້ ຄຸນສົມບັດນີ້ຖືກເອີ້ນວ່າຂໍ້ຄວາມກະດານຂາວ."

msgid ""
"Provide info to your translators by posting announcements, site-wide, per "
"project, category, component, or language."
msgstr ""
"ໃຫ້ຂໍ້ມູນແກ່ນັກແປຂອງທ່ານໂດຍການປະກາດ, ໃນລະດັບເວັບໄຊ, ລາຍໂຄງການ, ໝວດໝູ່, ອົງປະກອບ, ຫຼື ພາສາ."

msgid ""
"Announce the purpose, deadlines, status, or specify targets for translation."
msgstr "ປະກາດຈຸດປະສົງ, ກຳນົດເວລາ, ສະຖານະ, ຫຼື ລະບຸເປົ້າໝາຍສຳລັບການແປ."

msgid ""
"The users will receive notification on the announcements for watched "
"projects (unless they opt out)."
msgstr ""
"ຜູ້ໃຊ້ຈະໄດ້ຮັບການແຈ້ງເຕືອນກ່ຽວກັບການປະກາດສຳລັບໂຄງການທີ່ຕິດຕາມ (ເວັ້ນແຕ່ພວກເຂົາຈະເລືອກບໍ່ຮັບ)."

msgid ""
"This can be useful for various things from announcing the purpose of the "
"website to specifying targets for translations."
msgstr ""
"ສິ່ງນີ້ມີປະໂຫຍດສຳລັບຫຼາຍຢ່າງ ຕັ້ງແຕ່ການປະກາດຈຸດປະສົງຂອງເວັບໄຊ ໄປຈົນເຖິງການລະບຸເປົ້າໝາຍສຳລັບການແປ."

msgid ""
"The announcements can posted on each level in the :guilabel:`Operations` "
"menu, using :guilabel:`Post announcement`:"
msgstr ""
"ການປະກາດສາມາດຖືກໂພສໃນແຕ່ລະລະດັບໃນເມນູ :guilabel:`ການດຳເນີນງານ`, "
"ໂດຍໃຊ້ :guilabel:`ໂພສການປະກາດ`:"

msgid ""
"Image showing an announcement that reads: \"Translations will be used only "
"if they reach 60%\" atop the dashboard view."
msgstr ""
"ຮູບພາບທີ່ສະແດງການປະກາດທີ່ອ່ານວ່າ: \"ການແປຈະຖືກໃຊ້ກໍຕໍ່ເມື່ອບັນລຸເຖິງ 60%\" "
"ຢູ່ເທິງສຸດຂອງມຸມມອງແຜງຄວບຄຸມ."

msgid "The announcements are shown based on their specified context:"
msgstr "ການປະກາດຈະຖືກສະແດງໂດຍອີງໃສ່ບໍລິບົດທີ່ລະບຸໄວ້ຂອງພວກມັນ:"

msgid "No context specified"
msgstr "ບໍ່ໄດ້ລະບຸບໍລິບົດ"

msgid "Shown on dashboard (landing page)."
msgstr "ສະແດງໃນແຜງຄວບຄຸມ (ໜ້າຫຼັກ)."

msgid "Project specified"
msgstr "ໂຄງການທີ່ລະບຸ"

msgid ""
"Shown within the project, including all its components and translations."
msgstr "ສະແດງພາຍໃນໂຄງການ, ລວມເຖິງອົງປະກອບ ແລະ ການແປທັງໝົດຂອງມັນ."

msgid "Project and language specified"
msgstr "ໂຄງການ ແລະ ພາສາທີ່ລະບຸ"

msgid ""
"Shown within the project for the specified language, including all its "
"translations."
msgstr "ສະແດງພາຍໃນໂຄງການສຳລັບພາສາທີ່ລະບຸ, ລວມເຖິງການແປທັງໝົດຂອງມັນ."

msgid "Category specified"
msgstr "ໝວດໝູ່ທີ່ລະບຸ"

msgid ""
"Shown within the category, including all its components and translations."
msgstr "ສະແດງພາຍໃນໝວດໝູ່, ລວມເຖິງອົງປະກອບ ແລະ ການແປທັງໝົດຂອງມັນ."

msgid "Component specified"
msgstr "ອົງປະກອບທີ່ລະບຸ"

msgid "Shown for a given component and all its translations."
msgstr "ສະແດງສຳລັບອົງປະກອບທີ່ກຳນົດ ແລະ ການແປທັງໝົດຂອງມັນ."

msgid "Language specified"
msgstr "ພາສາທີ່ລະບຸ"

msgid "Shown on the language overview and all translations in that language."
msgstr "ສະແດງໃນພາບລວມພາສາ ແລະ ການແປທັງໝົດໃນພາສານັ້ນ."

msgid "This is how it looks on the language overview page:"
msgstr "ນີ້ຄືວິທີທີ່ມັນປາກົດໃນໜ້າພາບລວມພາສາ:"

msgid ""
"Image showing an announcement that reads: \"Czech translators rock!\" atop "
"the Czech language overview."
msgstr ""
"ຮູບພາບທີ່ສະແດງການປະກາດທີ່ອ່ານວ່າ: \"ນັກແປພາສາເຊັກສຸດຍອດ!\" ຢູ່ເທິງສຸດຂອງພາບລວມພາສາເຊັກ."

msgid "Authentication"
msgstr "ການຢືນຢັນຕົວຕົນ"

msgid "User registration"
msgstr "ການລົງທະບຽນຜູ້ໃຊ້"

msgid ""
"The default setup for Weblate is to use python-social-auth, a form on the "
"website to handle registration of new users. After confirming their e-mail a "
"new user can contribute or authenticate by using one of the third party "
"services."
msgstr ""
"ການຕັ້ງຄ່າເລີ່ມຕົ້ນສຳລັບ Weblate ແມ່ນໃຊ້ python-social-auth, "
"ເປັນຟອມໃນເວັບໄຊເພື່ອຈັດການການລົງທະບຽນຂອງຜູ້ໃຊ້ໃໝ່. ຫຼັງຈາກຢືນຢັນອີເມວຂອງພວກເຂົາແລ້ວ "
"ຜູ້ໃຊ້ໃໝ່ສາມາດປະກອບສ່ວນ ຫຼື ຢືນຢັນຕົວຕົນໂດຍໃຊ້ໜຶ່ງໃນບໍລິການຂອງບຸກຄົນທີສາມ."

msgid ""
"You can also turn off registration of new users "
"using :setting:`REGISTRATION_OPEN`."
msgstr "ທ່ານຍັງສາມາດປິດການລົງທະບຽນຂອງຜູ້ໃຊ້ໃໝ່ໂດຍໃຊ້ :setting:`REGISTRATION_OPEN`."

msgid "The authentication attempts are subject to :ref:`rate-limit`."
msgstr "ຄວາມພະຍາຍາມໃນການຢືນຢັນຕົວຕົນຢູ່ພາຍໃຕ້ :ref:`rate-limit`."

msgid "Authentication backends"
msgstr "ແບັກເອນການຢືນຢັນຕົວຕົນ"

msgid ""
"Weblate relies on Django for the authentication. This includes built-in "
"password-based authentication, social authentication, and third-party "
"authentication backends for Django."
msgstr ""
"Weblate ອີງໃສ່ Django ສຳລັບການຢືນຢັນຕົວຕົນ. ສິ່ງນີ້ລວມເຖິງການຢືນຢັນຕົວຕົນໂດຍໃຊ້ລະຫັດຜ່ານ, "
"ການຢືນຢັນຕົວຕົນຜ່ານໂຊຊຽວ, ແລະ ແບັກເອນການຢືນຢັນຕົວຕົນຂອງບຸກຄົນທີສາມສຳລັບ Django."

msgid ""
"Using Django's built-in authentication means you can import the user "
"database of other Django-based projects (see :ref:`pootle-migration`)."
msgstr ""
"ການໃຊ້ການຢືນຢັນຕົວຕົນໃນຕົວຂອງ Django ໝາຍຄວາມວ່າທ່ານສາມາດນຳເຂົ້າຖານຂໍ້ມູນຜູ້ໃຊ້ຂອງໂຄງການທີ່ອີງໃສ່ "
"Django ອື່ນໆ (ເບິ່ງ :ref:`pootle-migration`)."

msgid ""
":ref:`docker-auth` describes how to configure authentication in the official "
"Docker image."
msgstr ":ref:`docker-auth` ອະທິບາຍວິທີການຕັ້ງຄ່າການຢືນຢັນຕົວຕົນໃນອິເມດ Docker ທາງການ."

msgid "Social authentication"
msgstr "ການຢືນຢັນຕົວຕົນຜ່ານໂຊຊຽວ"

msgid ""
"Thanks to :doc:`psa:index`, Weblate support authentication using many third "
"party services such as GitLab, Ubuntu, Fedora, etc."
msgstr ""
"ຂອບໃຈ :doc:`psa:index`, Weblate "
"ສະໜັບສະໜູນການຢືນຢັນຕົວຕົນໂດຍໃຊ້ບໍລິການຂອງບຸກຄົນທີສາມຫຼາຍຢ່າງ ເຊັ່ນ GitLab, Ubuntu, Fedora, "
"ແລະ ອື່ນໆ."

msgid ""
"Please check their documentation for generic configuration instructions "
"in :doc:`psa:configuration/django`."
msgstr ""
"ກະລຸນາກວດສອບເອກະສານຂອງພວກເຂົາສຳລັບຄຳແນະນຳການຕັ້ງຄ່າທົ່ວໄປໃນ :doc:`psa:configuration/"
"django`."

msgid ""
"By default, Weblate relies on third-party authentication services to provide "
"a validated e-mail address. If some of the services you want to use don't "
"support this, please enforce e-mail validation on the Weblate side by "
"configuring FORCE_EMAIL_VALIDATION for them. For example:"
msgstr ""
"ໂດຍຄ່າເລີ່ມຕົ້ນ, Weblate ອີງໃສ່ບໍລິການຢືນຢັນຕົວຕົນຂອງບຸກຄົນທີສາມເພື່ອໃຫ້ທີ່ຢູ່ອີເມວທີ່ຜ່ານການຢືນຢັນແລ້ວ. "
"ຫາກບາງບໍລິການທີ່ທ່ານຕ້ອງການໃຊ້ບໍ່ສະໜັບສະໜູນສິ່ງນີ້, ກະລຸນາບັງຄັບການຢືນຢັນອີເມວໃນຝ່າຍ Weblate "
"ໂດຍການຕັ້ງຄ່າ FORCE_EMAIL_VALIDATION ສຳລັບພວກເຂົາ. ຕົວຢ່າງ:"

msgid ""
"Enabling individual backends is quite easy, it's just a matter of adding an "
"entry to the :setting:`django:AUTHENTICATION_BACKENDS` setting and possibly "
"adding keys needed for a given authentication method. Please note that some "
"backends do not provide user e-mail by default, you have to request it "
"explicitly, otherwise Weblate will not be able to properly credit "
"contributions users make."
msgstr ""
"ການເປີດໃຊ້ແບັກເອນແຕ່ລະຢ່າງແມ່ນງ່າຍຫຼາຍ, "
"ມັນເປັນພຽງການເພີ່ມລາຍການເຂົ້າໃນການຕັ້ງຄ່າ :setting:`django:AUTHENTICATION_BACKENDS` "
"ແລະ ອາດຈະເປັນການເພີ່ມຄີທີ່ຈຳເປັນສຳລັບວິທີການຢືນຢັນຕົວຕົນທີ່ກຳນົດໄວ້. "
"ກະລຸນາສັງເກດວ່າບາງແບັກເອນບໍ່ໄດ້ໃຫ້ອີເມວຜູ້ໃຊ້ໂດຍຄ່າເລີ່ມຕົ້ນ, ທ່ານຕ້ອງຮ້ອງຂໍຢ່າງຊັດເຈນ, ຖ້າບໍ່ດັ່ງນັ້ນ "
"Weblate ຈະບໍ່ສາມາດໃຫ້ເຄຣດິດການປະກອບສ່ວນທີ່ຜູ້ໃຊ້ເຮັດໄດ້ຢ່າງຖືກຕ້ອງ."

msgid ""
"Most of the authentication backends require HTTPS. Once HTTPS is enabled in "
"your web server please configure Weblate to report it properly "
"using :setting:`ENABLE_HTTPS`, or by :envvar:`WEBLATE_ENABLE_HTTPS` in the "
"Docker container."
msgstr ""
"ແບັກເອນການຢືນຢັນຕົວຕົນສ່ວນໃຫຍ່ຕ້ອງການ HTTPS. ເມື່ອ HTTPS "
"ຖືກເປີດໃຊ້ງານໃນເວັບເຊີບເວີຂອງທ່ານແລ້ວ, ກະລຸນາຕັ້ງຄ່າ Weblate "
"ໃຫ້ລາຍງານມັນຢ່າງຖືກຕ້ອງໂດຍໃຊ້ :setting:`ENABLE_HTTPS`, ຫຼື "
"ໂດຍ :envvar:`WEBLATE_ENABLE_HTTPS` ໃນຄອນເທນເນີ Docker."

msgid ":doc:`Python Social Auth backend <psa:backends/index>`"
msgstr ":doc:`ແບັກເອນ Python Social Auth <psa:backends/index>`"

msgid "OpenID authentication"
msgstr "ການຢືນຢັນຕົວຕົນ OpenID"

msgid ""
"For OpenID-based services it's usually just a matter of enabling them. The "
"following section enables OpenID authentication for OpenSUSE, Fedora and "
"Ubuntu:"
msgstr ""
"ສຳລັບບໍລິການທີ່ອີງໃສ່ OpenID ມັນມັກຈະເປັນພຽງການເປີດໃຊ້ງານພວກມັນ. "
"ພາກສ່ວນຕໍ່ໄປນີ້ເປີດໃຊ້ການຢືນຢັນຕົວຕົນ OpenID ສຳລັບ OpenSUSE, Fedora ແລະ Ubuntu:"

msgid "GitHub authentication"
msgstr "ການຢືນຢັນຕົວຕົນ GitHub"

msgid ""
"You need to register an OAuth application on GitHub and then tell Weblate "
"all its secrets:"
msgstr ""
"ທ່ານຕ້ອງລົງທະບຽນແອັບພລິເຄຊັນ OAuth ໃນ GitHub ແລະ ບອກ Weblate ເຖິງຄວາມລັບທັງໝົດຂອງມັນ:"

msgid ""
"The GitHub should be configured to have callback URL as ``https://WEBLATE "
"SERVER/accounts/complete/github/``."
msgstr ""
"GitHub ຄວນຖືກຕັ້ງຄ່າໃຫ້ມີ callback URL ເປັນ ``https://WEBLATE SERVER/accounts/"
"complete/github/``."

msgid ""
"There are similar authentication backends for GitHub for Organizations and "
"GitHub for Teams. Their settings are named ``SOCIAL_AUTH_GITHUB_ORG_*`` and "
"``SOCIAL_AUTH_GITHUB_TEAM_*``, and they require additional setting of the "
"scope - ``SOCIAL_AUTH_GITHUB_ORG_NAME`` or ``SOCIAL_AUTH_GITHUB_TEAM_ID``. "
"Their callback URLs are ``https://WEBLATE SERVER/accounts/complete/github-"
"org/`` and ``https://WEBLATE SERVER/accounts/complete/github-teams/``."
msgstr ""
"ມີແບັກເອນການຢືນຢັນຕົວຕົນທີ່ຄ້າຍຄືກັນສຳລັບ GitHub for Organizations ແລະ GitHub for Teams. "
"ການຕັ້ງຄ່າຂອງພວກມັນຖືກຕັ້ງຊື່ເປັນ ``SOCIAL_AUTH_GITHUB_ORG_*`` ແລະ "
"``SOCIAL_AUTH_GITHUB_TEAM_*``, ແລະ ພວກມັນຕ້ອງການການຕັ້ງຄ່າເພີ່ມເຕີມຂອງຂອບເຂດ - "
"``SOCIAL_AUTH_GITHUB_ORG_NAME`` ຫຼື ``SOCIAL_AUTH_GITHUB_TEAM_ID``. callback "
"URL ຂອງພວກມັນຄື ``https://WEBLATE SERVER/accounts/complete/github-org/`` ແລະ "
"``https://WEBLATE SERVER/accounts/complete/github-teams/``."

msgid "GitHub EE authentication"
msgstr "ການຢືນຢັນຕົວຕົນ GitHub EE"

msgid ""
"You need to register an OAuth App on GitHub EE and then tell Weblate all its "
"secrets:"
msgstr ""
"ທ່ານຕ້ອງລົງທະບຽນ OAuth App ໃນ GitHub EE ແລະ ບອກ Weblate ເຖິງຄວາມລັບທັງໝົດຂອງມັນ:"

msgid ""
"The GitHub OAuth App should be configured to have callback URL as ``https://"
"WEBLATE SERVER/accounts/complete/github-enterprise/``."
msgstr ""
"GitHub OAuth App ຄວນຖືກຕັ້ງຄ່າໃຫ້ມີ callback URL ເປັນ ``https://WEBLATE SERVER/"
"accounts/complete/github-enterprise/``."

msgid ""
"Instead GitHub OAuth App, GitHub App can also be used. With GitHub App "
"permissions can be granted on repositories, organisation and/or user level. "
"If you decide to use GitHub App, you need to enable `Access: Read-only` "
"permission for Users - <Email addresses> and Organisation - <Members>."
msgstr ""
"ແທນທີ່ຈະເປັນ GitHub OAuth App, GitHub App ສາມາດຖືກໃຊ້ໄດ້ເຊັ່ນກັນ. ດ້ວຍ GitHub App "
"ສາມາດໃຫ້ສິດໃນບ່ອນເກັບຂໍ້ມູນ, ອົງການຈັດຕັ້ງ ແລະ/ຫຼື ລະດັບຜູ້ໃຊ້. ຫາກທ່ານຕັດສິນໃຈໃຊ້ GitHub App, "
"ທ່ານຕ້ອງເປີດໃຊ້ສິດ `ການເຂົ້າເຖິງ: ອ່ານຢ່າງດຽວ` ສຳລັບຜູ້ໃຊ້ - <ທີ່ຢູ່ອີເມວ> ແລະ ອົງການຈັດຕັ້ງ - "
"<ສະມາຊິກ>."

msgid "Bitbucket authentication"
msgstr "ການຢືນຢັນຕົວຕົນ Bitbucket"

msgid ""
"You need to register an application on Bitbucket and then tell Weblate all "
"its secrets:"
msgstr "ທ່ານຕ້ອງລົງທະບຽນແອັບພລິເຄຊັນໃນ Bitbucket ແລະ ບອກ Weblate ເຖິງຄວາມລັບທັງໝົດຂອງມັນ:"

msgid "Google OAuth 2"
msgstr "Google OAuth 2"

msgid ""
"To use Google OAuth 2, you need to register an OAuth application at <https://"
"console.developers.google.com/>."
msgstr ""
"ເພື່ອໃຊ້ Google OAuth 2, ທ່ານຕ້ອງລົງທະບຽນແອັບພລິເຄຊັນ OAuth ທີ່ <https://"
"console.developers.google.com/>."

msgid ""
"The redirect URL is ``https://WEBLATE SERVER/accounts/complete/google-oauth2/"
"``."
msgstr ""
"URL ການປ່ຽນເສັ້ນທາງຄື ``https://WEBLATE SERVER/accounts/complete/google-oauth2/"
"``."

msgid "Facebook OAuth 2"
msgstr "Facebook OAuth 2"

msgid ""
"As per usual with OAuth 2 services, you need to register your application "
"with Facebook. Once this is done, you can set up Weblate to use it:"
msgstr ""
"ຕາມປົກກະຕິກັບບໍລິການ OAuth 2, ທ່ານຕ້ອງລົງທະບຽນແອັບພລິເຄຊັນຂອງທ່ານກັບ Facebook. "
"ເມື່ອສິ່ງນີ້ສຳເລັດແລ້ວ, ທ່ານສາມາດຕັ້ງຄ່າ Weblate ເພື່ອໃຊ້ງານມັນໄດ້:"

msgid ""
"The redirect URL is ``https://WEBLATE SERVER/accounts/complete/facebook/``."
msgstr ""
"URL ການປ່ຽນເສັ້ນທາງຄື ``https://WEBLATE SERVER/accounts/complete/facebook/``."

msgid "GitLab OAuth 2"
msgstr "GitLab OAuth 2"

msgid ""
"For using GitLab OAuth 2, you need to register an application at <https://"
"gitlab.com/profile/applications>."
msgstr ""
"ສຳລັບການໃຊ້ GitLab OAuth 2, ທ່ານຕ້ອງລົງທະບຽນແອັບພລິເຄຊັນທີ່ <https://gitlab.com/"
"profile/applications>."

msgid ""
"The redirect URL is ``https://WEBLATE SERVER/accounts/complete/gitlab/`` and "
"ensure you mark the `read_user` scope."
msgstr ""
"URL ການປ່ຽນເສັ້ນທາງຄື ``https://WEBLATE SERVER/accounts/complete/gitlab/`` ແລະ "
"ຮັບປະກັນວ່າທ່ານໝາຍຂອບເຂດ `read_user` ໄວ້."

msgid "Gitea OAuth 2"
msgstr "Gitea OAuth 2"

msgid ""
"For using Gitea OAuth 2, you need to register an application at ``https://"
"GITEA SERVER/user/settings/applications``."
msgstr ""
"ສຳລັບການໃຊ້ Gitea OAuth 2, ທ່ານຕ້ອງລົງທະບຽນແອັບພລິເຄຊັນທີ່ ``https://GITEA SERVER/user/"
"settings/applications``."

msgid ""
"The redirect URL is ``https://WEBLATE SERVER/accounts/complete/gitea/``."
msgstr "URL ການປ່ຽນເສັ້ນທາງຄື ``https://WEBLATE SERVER/accounts/complete/gitea/``."

msgid ""
"The configuration above also works with Forgejo; for an example of "
"production deployment with Forgejo, see `Codeberg Translate <https://"
"translate.codeberg.org>`_."
msgstr ""
"ການຕັ້ງຄ່າຂ້າງເທິງຍັງໃຊ້ງານໄດ້ກັບ Forgejo; ສຳລັບຕົວຢ່າງຂອງການນຳໃຊ້ໃນການຜະລິດກັບ Forgejo, "
"ເບິ່ງ `Codeberg Translate <https://translate.codeberg.org>`_."

msgid "Microsoft Entra ID"
msgstr "Microsoft Entra ID"

msgid ""
"Azure Active Directory (Azure AD) is now Microsoft Entra ID. Weblate keeps "
"the ``azuread-oauth2`` and ``azuread-tenant-oauth2`` backend names for "
"compatibility with the underlying Python Social Auth backends and existing "
"deployments."
msgstr ""
"Azure Active Directory (Azure AD) ດຽວນີ້ຄື Microsoft Entra ID. Weblate "
"ຮັກສາຊື່ແບັກເອນ ``azuread-oauth2`` ແລະ ``azuread-tenant-oauth2`` "
"ໄວ້ເພື່ອຄວາມເຂົ້າກັນໄດ້ກັບແບັກເອນ Python Social Auth ພື້ນຖານ ແລະ ການນຳໃຊ້ທີ່ມີຢູ່."

msgid ""
"Weblate can be configured to use common or specific tenants for "
"authentication."
msgstr "Weblate ສາມາດຖືກຕັ້ງຄ່າໃຫ້ໃຊ້ tenants ທົ່ວໄປ ຫຼື ສະເພາະສຳລັບການຢືນຢັນຕົວຕົນ."

msgid ""
"The redirect URL is ``https://WEBLATE SERVER/accounts/complete/azuread-"
"oauth2/`` for common and ``https://WEBLATE SERVER/accounts/complete/azuread-"
"tenant-oauth2/`` for tenant-specific authentication."
msgstr ""
"URL ການປ່ຽນເສັ້ນທາງຄື ``https://WEBLATE SERVER/accounts/complete/azuread-oauth2/"
"`` ສຳລັບທົ່ວໄປ ແລະ ``https://WEBLATE SERVER/accounts/complete/azuread-tenant-"
"oauth2/`` ສຳລັບການຢືນຢັນຕົວຕົນສະເພາະ tenant."

msgid "You will need following:"
msgstr "ທ່ານຈະຕ້ອງການສິ່ງຕໍ່ໄປນີ້:"

msgid ""
"*Application (client) ID* is available on the app registration overview in "
"the Microsoft Entra admin center. *Object ID* is not used in Weblate."
msgstr ""
"*Application (client) ID* ມີໃຫ້ໃນພາບລວມການລົງທະບຽນແອັບໃນສູນບໍລິຫານ Microsoft Entra. "
"*Object ID* ບໍ່ໄດ້ຖືກໃຊ້ໃນ Weblate."

msgid ""
"*Directory (tenant) ID* is needed for tenant scoped authentication, what is "
"usually desired."
msgstr ""
"*Directory (tenant) ID* ຈຳເປັນສຳລັບການຢືນຢັນຕົວຕົນໃນຂອບເຂດ tenant, "
"ເຊິ່ງມັກຈະເປັນທີ່ຕ້ອງການ."

msgid ""
"*Secret value* is displayed once you create a client secret for the app "
"registration. *Secret ID* is not used in Weblate."
msgstr ""
"*Secret value* ຈະຖືກສະແດງເມື່ອທ່ານສ້າງ client secret ສຳລັບການລົງທະບຽນແອັບ. *Secret "
"ID* ບໍ່ໄດ້ຖືກໃຊ້ໃນ Weblate."

msgid "Slack"
msgstr "Slack"

msgid ""
"For using Slack OAuth 2, you need to register an application at <https://"
"api.slack.com/apps>."
msgstr ""
"ສຳລັບການໃຊ້ Slack OAuth 2, ທ່ານຕ້ອງລົງທະບຽນແອັບພລິເຄຊັນທີ່ <https://api.slack.com/"
"apps>."

msgid ""
"The redirect URL is ``https://WEBLATE SERVER/accounts/complete/slack/``."
msgstr "URL ການປ່ຽນເສັ້ນທາງຄື ``https://WEBLATE SERVER/accounts/complete/slack/``."

msgid "Overriding authentication method names and icons"
msgstr "ການຂຽນທັບຊື່ວິທີການຢືນຢັນຕົວຕົນ ແລະ ໄອຄອນ"

msgid ""
"You can override the authentication method display name and icon using "
"settings as ``SOCIAL_AUTH_<NAME>_IMAGE`` and ``SOCIAL_AUTH_<NAME>_TITLE``. "
"For example overriding naming for Auth0 would look like:"
msgstr ""
"ທ່ານສາມາດຂຽນທັບຊື່ສະແດງ ແລະ ໄອຄອນຂອງວິທີການຢືນຢັນຕົວຕົນໂດຍໃຊ້ການຕັ້ງຄ່າເປັນ "
"``SOCIAL_AUTH_<NAME>_IMAGE`` ແລະ ``SOCIAL_AUTH_<NAME>_TITLE``. "
"ຕົວຢ່າງການຂຽນທັບຊື່ສຳລັບ Auth0 ຈະເປັນແບບນີ້:"

msgid "Turning off password authentication"
msgstr "ການປິດການຢືນຢັນຕົວຕົນດ້ວຍລະຫັດຜ່ານ"

msgid ""
"E-mail and password authentication can be turned off by removing "
"``social_core.backends.email.EmailAuth`` "
"from :setting:`django:AUTHENTICATION_BACKENDS`. Always keep "
"``weblate.accounts.auth.WeblateUserBackend`` there, it is needed for core "
"Weblate functionality."
msgstr ""
"ການຢືນຢັນຕົວຕົນດ້ວຍອີເມວ ແລະ ລະຫັດຜ່ານສາມາດປິດໄດ້ໂດຍການລຶບ "
"``social_core.backends.email.EmailAuth`` "
"ອອກຈາກ :setting:`django:AUTHENTICATION_BACKENDS`. ຄວນຮັກສາ "
"``weblate.accounts.auth.WeblateUserBackend`` ໄວ້ສະເໝີ, "
"ມັນຈຳເປັນສຳລັບການເຮັດວຽກຫຼັກຂອງ Weblate."

msgid ""
"Disabling e-mail authentication will disable all e-mail related "
"functionality – user invitation or password reset feature."
msgstr ""
"ການປິດການຢືນຢັນຕົວຕົນດ້ວຍອີເມວຈະປິດການເຮັດວຽກທັງໝົດທີ່ກ່ຽວຂ້ອງກັບອີເມວ - ຄຸນສົມບັດການເຊີນຜູ້ໃຊ້ ຫຼື "
"ການຣີເຊັດລະຫັດຜ່ານ."

msgid ""
"You can still use password authentication for the admin interface, for users "
"you manually create there. Just navigate to ``/admin/login/``."
msgstr ""
"ທ່ານຍັງສາມາດໃຊ້ການຢືນຢັນຕົວຕົນດ້ວຍລະຫັດຜ່ານສຳລັບອິນເຕີເຟດຜູ້ດູແລ, ສຳລັບຜູ້ໃຊ້ທີ່ທ່ານສ້າງດ້ວຍຕົນເອງທີ່ນັ້ນ. "
"ພຽງແຕ່ໄປທີ່ ``/admin/login/``."

msgid ""
"For example authentication using only the openSUSE Open ID provider can be "
"achieved using the following:"
msgstr ""
"ຕົວຢ່າງ, ການຢືນຢັນຕົວຕົນໂດຍໃຊ້ສະເພາະຜູ້ໃຫ້ບໍລິການ Open ID ຂອງ openSUSE "
"ສາມາດເຮັດໄດ້ໂດຍໃຊ້ສິ່ງຕໍ່ໄປນີ້:"

msgid "Password authentication"
msgstr "ການຢືນຢັນຕົວຕົນດ້ວຍລະຫັດຜ່ານ"

msgid ""
"The default :file:`settings.py` comes with a reasonable set "
"of :setting:`django:AUTH_PASSWORD_VALIDATORS` that ensures that weak "
"passwords are not allowed. You can customize this setting to match your "
"password policy."
msgstr ""
":file:`settings.py` "
"ເລີ່ມຕົ້ນມາພ້ອມກັບຊຸດ :setting:`django:AUTH_PASSWORD_VALIDATORS` ທີ່ສົມເຫດສົມຜົນ "
"ເຊິ່ງຮັບປະກັນວ່າລະຫັດຜ່ານທີ່ອ່ອນແອຈະບໍ່ຖືກອະນຸຍາດ. "
"ທ່ານສາມາດປັບແຕ່ງການຕັ້ງຄ່ານີ້ເພື່ອໃຫ້ກົງກັບນະໂຍບາຍລະຫັດຜ່ານຂອງທ່ານ."

msgid ""
"Additionally you can also install `django-zxcvbn-password-validator <https://"
"github.com/Pierre-Sassoulas/django-zxcvbn-password-validator>`_ which gives "
"quite realistic estimates of password difficulty and allows rejecting "
"passwords below a certain threshold."
msgstr ""
"ນອກຈາກນັ້ນ, ທ່ານຍັງສາມາດຕິດຕັ້ງ `django-zxcvbn-password-validator <https://"
"github.com/Pierre-Sassoulas/django-zxcvbn-password-validator>`_ "
"ເຊິ່ງໃຫ້ການປະເມີນຄວາມຍາກງ່າຍຂອງລະຫັດຜ່ານທີ່ສົມຈິງຫຼາຍ ແລະ "
"ອະນຸຍາດໃຫ້ປະຕິເສດລະຫັດຜ່ານທີ່ຕ່ຳກວ່າຂີດຈຳກັດໃດໜຶ່ງ."

msgid "SAML authentication"
msgstr "ການຢືນຢັນຕົວຕົນ SAML"

msgid ""
"The dependencies for SAML authentication are no longer included in the "
"default ``all`` extras. You need to include ``saml`` while installing the "
"Weblate package using pip (``uv pip install Weblate[all,saml]``)."
msgstr ""
"Dependencies ສຳລັບການຢືນຢັນຕົວຕົນ SAML ບໍ່ໄດ້ລວມຢູ່ໃນ ``all`` extras ເລີ່ມຕົ້ນອີກຕໍ່ໄປ. "
"ທ່ານຕ້ອງລວມ ``saml`` ໃນຂະນະທີ່ຕິດຕັ້ງແພັກເກັດ Weblate ໂດຍໃຊ້ pip (``uv pip install "
"Weblate[all,saml]``)."

msgid ""
"Please follow the Python Social Auth instructions for configuration. Notable "
"differences:"
msgstr ""
"ກະລຸນາປະຕິບັດຕາມຄຳແນະນຳຂອງ Python Social Auth ສຳລັບການຕັ້ງຄ່າ. ຄວາມແຕກຕ່າງທີ່ໜ້າສັງເກດ:"

msgid ""
"Weblate supports single IDP which has to be called ``weblate`` in "
"``SOCIAL_AUTH_SAML_ENABLED_IDPS``."
msgstr ""
"Weblate ສະໜັບສະໜູນ IDP ດຽວ ເຊິ່ງຕ້ອງຖືກເອີ້ນວ່າ ``weblate`` ໃນ "
"``SOCIAL_AUTH_SAML_ENABLED_IDPS``."

msgid ""
"The SAML XML metadata URL is ``/accounts/metadata/saml/``, which is also an "
"entity ID."
msgstr ""
"URL ເມຕາດາຕ້າ SAML XML ຄື ``/accounts/metadata/saml/``, ເຊິ່ງເປັນ entity ID ເຊັ່ນກັນ."

msgid ""
"The sign-in URL is ``/accounts/complete/saml/`` (also known as ACS URL)."
msgstr "URL ການລົງຊື່ເຂົ້າໃຊ້ຄື ``/accounts/complete/saml/`` (ຫຼື ຮູ້ຈັກກັນໃນຊື່ ACS URL)."

msgid ""
"Following settings are automatically filled in: "
"``SOCIAL_AUTH_SAML_SP_ENTITY_ID``, ``SOCIAL_AUTH_SAML_TECHNICAL_CONTACT``, "
"``SOCIAL_AUTH_SAML_SUPPORT_CONTACT``"
msgstr ""
"ການຕັ້ງຄ່າຕໍ່ໄປນີ້ຖືກຕື່ມໂດຍອັດຕະໂນມັດ: ``SOCIAL_AUTH_SAML_SP_ENTITY_ID``, "
"``SOCIAL_AUTH_SAML_TECHNICAL_CONTACT``, ``SOCIAL_AUTH_SAML_SUPPORT_CONTACT``"

