msgstr ""
"`ລາຍລະອຽດການປ່ຽນແປງທັງໝົດ <https://github.com/WeblateOrg/weblate/milestone/96?"
"closed=1>`__."

msgid "Weblate 4.16.3"
msgstr "Weblate 4.16.3"

msgid "*Released on March 15th 2023.*"
msgstr "*ອອກວັນທີ 15 ມີນາ 2023.*"

msgid "Improved session handling with project backups."
msgstr "ປັບປຸງການຈັດການເຊສຊັນກັບການສຳຮອງຂໍ້ມູນໂຄງການ."

msgid ""
"`All changes in detail <https://github.com/WeblateOrg/weblate/milestone/95?"
"closed=1>`__."
msgstr ""
"`ລາຍລະອຽດການປ່ຽນແປງທັງໝົດ <https://github.com/WeblateOrg/weblate/milestone/95?"
"closed=1>`__."

msgid "Weblate 4.16.2"
msgstr "Weblate 4.16.2"

msgid "*Released on March 8th 2023.*"
msgstr "*ອອກວັນທີ 8 ມີນາ 2023.*"

msgid "Fixed searching in the translation memory."
msgstr "ແກ້ໄຂການຄົ້ນຫາໃນໜ່ວຍຄວາມຈຳການແປ."

msgid "Fixed automatic translation with more services."
msgstr "ແກ້ໄຂການແປອັດຕະໂນມັດກັບບໍລິການເພີ່ມເຕີມ."

msgid "Improved rendering of overlapping glossary term matches."
msgstr "ປັບປຸງການສະແດງການຈັບຄູ່ຄຳສັບ Glossary ທີ່ຊ້ອນກັນ."

msgid "Fixed plurals parsing for non-English source language in some formats."
msgstr "ແກ້ໄຂການແຍກວິເຄາະຮູບແບບພົດສຳລັບພາສາຕົ້ນສະບັບທີ່ບໍ່ແມ່ນພາສາອັງກິດໃນບາງຮູບແບບ."

msgid "Added support for go-i18n v2 JSON files."
msgstr "ເພີ່ມການຮອງຮັບໄຟລ໌ go-i18n v2 JSON."

msgid ""
"`All changes in detail <https://github.com/WeblateOrg/weblate/milestone/94?"
"closed=1>`__."
msgstr ""
"`ລາຍລະອຽດການປ່ຽນແປງທັງໝົດ <https://github.com/WeblateOrg/weblate/milestone/94?"
"closed=1>`__."

msgid "Weblate 4.16.1"
msgstr "Weblate 4.16.1"

msgid "*Released on March 1st 2023.*"
msgstr "*ອອກວັນທີ 1 ມີນາ 2023.*"

msgid "Fixed testsuite error."
msgstr "ແກ້ໄຂຂໍ້ຜິດພາດຂອງ Testsuite."

msgid ""
"`All changes in detail <https://github.com/WeblateOrg/weblate/milestone/92?"
"closed=1>`__."
msgstr ""
"`ລາຍລະອຽດການປ່ຽນແປງທັງໝົດ <https://github.com/WeblateOrg/weblate/milestone/92?"
"closed=1>`__."

msgid "Weblate 4.16"
msgstr "Weblate 4.16"

msgid "Format string checks now also detects duplicated formats."
msgstr "ການກວດສອບ Format string ຕອນນີ້ກວດພົບ Format ທີ່ຊ້ຳກັນນຳ."

msgid "Improved search performance for some specially formatted strings."
msgstr "ປັບປຸງປະສິດທິພາບການຄົ້ນຫາສຳລັບຂໍ້ຄວາມທີ່ມີຮູບແບບພິເສດບາງຢ່າງ."

msgid "Celery beat is now storing the tasks schedule in the database."
msgstr "Celery beat ຕອນນີ້ເກັບຕາຕະລາງວຽກໃນຖານຂໍ້ມູນ."

msgid "Added support for IBM Watson Language Translator."
msgstr "ເພີ່ມການຮອງຮັບ IBM Watson Language Translator."

msgid "Dropped support for VCS integration settings deprecated in 4.14."
msgstr "ຢຸດການຮອງຮັບການຕັ້ງຄ່າການເຊື່ອມຕໍ່ VCS ທີ່ບໍ່ແນະນຳໃຫ້ໃຊ້ໃນ 4.14."

msgid "Added support for Bitbucket Server pull requests."
msgstr "ເພີ່ມການຮອງຮັບ Pull request ຂອງ Bitbucket Server."

msgid "Improved conflicts handling in gettext PO files."
msgstr "ປັບປຸງການຈັດການຄວາມຂັດແຍ້ງໃນໄຟລ໌ gettext PO."

msgid "Added support for defining strings state when adding via API."
msgstr "ເພີ່ມການຮອງຮັບການກຳນົດສະຖານະຂໍ້ຄວາມເມື່ອເພີ່ມຜ່ານ API."

msgid "Added support for configuring CORS allowed origins."
msgstr "ເພີ່ມການຮອງຮັບການຕັ້ງຄ່າ CORS allowed origins."

msgid "Added plurals support to automatic suggestions."
msgstr "ເພີ່ມການຮອງຮັບຮູບແບບພົດໃນຄຳແນະນຳອັດຕະໂນມັດ."

msgid ""
"`All changes in detail <https://github.com/WeblateOrg/weblate/milestone/89?"
"closed=1>`__."
msgstr ""
"`ລາຍລະອຽດການປ່ຽນແປງທັງໝົດ <https://github.com/WeblateOrg/weblate/milestone/89?"
"closed=1>`__."

msgid ""
"Celery beat is now storing the tasks schedule in the database, "
"``CELERY_BEAT_SCHEDULER`` and :setting:`django:INSTALLED_APPS` need to be "
"changed for that."
msgstr ""
"Celery beat ຕອນນີ້ເກັບຕາຕະລາງວຽກໃນຖານຂໍ້ມູນ, ``CELERY_BEAT_SCHEDULER`` "
"ແລະ :setting:`django:INSTALLED_APPS` ຕ້ອງຖືກປ່ຽນແປງສຳລັບສິ່ງນັ້ນ."

msgid ""
"The deprecated VCS setting for credentials is no longer supported, "
"see :ref:`up-4-14`."
msgstr ""
"ການຕັ້ງຄ່າ VCS ສຳລັບ Credential ທີ່ບໍ່ແນະນຳໃຫ້ໃຊ້ແລ້ວຈະບໍ່ຖືກຮອງຮັບອີກ, ເບິ່ງ :ref:`up-4-14`."

msgid ""
"Upgrade of `django-crispy-forms` requires changes "
"in :setting:`django:INSTALLED_APPS`."
msgstr ""
"ການອັບເກຣດ `django-crispy-forms` "
"ຕ້ອງມີການປ່ຽນແປງໃນ :setting:`django:INSTALLED_APPS`."

msgid ""
"Integration of `django-cors-headers` requires changes "
"in :setting:`django:INSTALLED_APPS` and :setting:`django:MIDDLEWARE`."
msgstr ""
"ການລວມ `django-cors-headers` "
"ຕ້ອງມີການປ່ຽນແປງໃນ :setting:`django:INSTALLED_APPS` "
"ແລະ :setting:`django:MIDDLEWARE`."

msgid ""
"Introduction of :setting:`CACHE_DIR` changed default value "
"of :setting:`django:STATIC_ROOT`. You might need to adjust :ref:`static-"
"files` accordingly."
msgstr ""
"ການນຳໃຊ້ :setting:`CACHE_DIR` ໄດ້ປ່ຽນຄ່າເລີ່ມຕົ້ນຂອງ :setting:`django:STATIC_ROOT`. "
"ທ່ານອາດຕ້ອງປັບ :ref:`static-files` ໃຫ້ສອດຄ່ອງ."

msgid "Weblate 4.15.2"
msgstr "Weblate 4.15.2"

msgid "*Released on January 25th 2023.*"
msgstr "*ອອກວັນທີ 25 ມັງກອນ 2023.*"

msgid ""
"Enabled gotext JSON and i18next v4 formats in the default configuration."
msgstr "ເປີດໃຊ້ຮູບແບບ gotext JSON ແລະ i18next v4 ໃນການຕັ້ງຄ່າເລີ່ມຕົ້ນ."

msgid "Fixed crash on uploading corrupted files."
msgstr "ແກ້ໄຂການຂັດຂ້ອງເມື່ອອັບໂຫຼດໄຟລ໌ທີ່ເສຍຫາຍ."

msgid "Show stale directories in Git repository status."
msgstr "ສະແດງ Directory ທີ່ຄ້າງຢູ່ໃນສະຖານະ Git repository."

msgid ""
"`All changes in detail <https://github.com/WeblateOrg/weblate/milestone/91?"
"closed=1>`__."
msgstr ""
"`ລາຍລະອຽດການປ່ຽນແປງທັງໝົດ <https://github.com/WeblateOrg/weblate/milestone/91?"
"closed=1>`__."

msgid "Weblate 4.15.1"
msgstr "Weblate 4.15.1"

msgid "*Released on January 19th 2023.*"
msgstr "*ອອກວັນທີ 19 ມັງກອນ 2023.*"

msgid "Fixed suggestions from automatic translation."
msgstr "ແກ້ໄຂຄຳແນະນຳຈາກການແປອັດຕະໂນມັດ."

msgid "Fixed add-on page crash in some corner cases."
msgstr "ແກ້ໄຂໜ້າ Add-on ຂັດຂ້ອງໃນບາງກໍລະນີ."

msgid "Fixed untranslating template for new translations in some cases."
msgstr "ແກ້ໄຂ Template ການຍົກເລີກການແປສຳລັບການແປໃໝ່ໃນບາງກໍລະນີ."

msgid "Documented licensing using `REUSE 3.0 <https://reuse.software/>`_."
msgstr "ເອກະສານສິດທິບັດໂດຍໃຊ້ `REUSE 3.0 <https://reuse.software/>`_."

msgid "Fixed users pagination on team management."
msgstr "ແກ້ໄຂການແບ່ງໜ້າຜູ້ໃຊ້ໃນການຈັດການທີມ."

msgid "Improved performance of project creation and saving."
msgstr "ປັບປຸງປະສິດທິພາບການສ້າງແລະບັນທຶກໂຄງການ."

msgid "Added support for gotext JSON files."
msgstr "ເພີ່ມການຮອງຮັບໄຟລ໌ gotext JSON."

msgid "Added support for i18next v4 files."
msgstr "ເພີ່ມການຮອງຮັບໄຟລ໌ i18next v4."

msgid "Pagination in the API is now customizable."
msgstr "ການແບ່ງໜ້າໃນ API ຕອນນີ້ສາມາດປັບແຕ່ງໄດ້."

msgid ""
"`All changes in detail <https://github.com/WeblateOrg/weblate/milestone/90?"
"closed=1>`__."
msgstr ""
"`ລາຍລະອຽດການປ່ຽນແປງທັງໝົດ <https://github.com/WeblateOrg/weblate/milestone/90?"
"closed=1>`__."

msgid "Weblate 4.15"
msgstr "Weblate 4.15"

msgid "*Released on December 16th 2022.*"
msgstr "*ອອກວັນທີ 16 ທັນວາ 2022.*"

msgid "Added support for browsing all changes for an individual string."
msgstr "ເພີ່ມການຮອງຮັບການເບິ່ງການປ່ຽນແປງທັງໝົດສຳລັບຂໍ້ຄວາມສ່ວນບຸກຄົນ."

msgid "Fixed plurals handling in automatic translation from other components."
msgstr "ແກ້ໄຂການຈັດການຮູບແບບພົດໃນການແປອັດຕະໂນມັດຈາກອົງປະກອບອື່ນ."

msgid "Added keyboard shortcut Alt+Enter to submit string as a suggestion."
msgstr "ເພີ່ມປຸ່ມລັດ Alt+Enter ເພື່ອສົ່ງຂໍ້ຄວາມເປັນຄຳແນະນຳ."

msgid "Added support for placeables in the Fluent format."
msgstr "ເພີ່ມການຮອງຮັບ Placeable ໃນຮູບແບບ Fluent."

msgid "Improved performance of translation memory."
msgstr "ປັບປຸງປະສິດທິພາບໜ່ວຍຄວາມຈຳການແປ."

msgid ""
"Autogenerate repoweb browsing links for well known code hosting services."
msgstr "ສ້າງລິ້ງ Repoweb browsing ໂດຍອັດຕະໂນມັດສຳລັບບໍລິການໂຮສໂຄ້ດທີ່ຮູ້ຈັກດີ."

msgid "Improved performance of several views."
msgstr "ປັບປຸງປະສິດທິພາບຂອງມຸມມອງຕ່າງໆ."

msgid "Improved listing of strings with plurals."
msgstr "ປັບປຸງລາຍການຂໍ້ຄວາມທີ່ມີຮູບແບບພົດ."

msgid "Added support for adding custom markup to HTML head."
msgstr "ເພີ່ມການຮອງຮັບການເພີ່ມ Markup ແບບກຳນົດເອງໃສ່ HTML head."

msgid ""
"Fixed generation of MO files in the add-on to include only translated files."
msgstr "ແກ້ໄຂການສ້າງໄຟລ໌ MO ໃນ Add-on ໃຫ້ລວມສະເພາະໄຟລ໌ທີ່ແປແລ້ວ."

msgid "Fixed rendering of regular expression flags."
msgstr "ແກ້ໄຂການສະແດງທຸງ Regular expression."

msgid "Improved placeholders check behavior with plurals."
msgstr "ປັບປຸງການກວດສອບ Placeholder ດ້ວຍຮູບແບບພົດ."

msgid "Added support for translation files naming suitable for Google Play."
msgstr "ເພີ່ມການຮອງຮັບການຕັ້ງຊື່ໄຟລ໌ການແປໃຫ້ເໝາະສົມກັບ Google Play."

msgid "Added support for labels in API."
msgstr "ເພີ່ມການຮອງຮັບ Label ໃນ API."

msgid ""
"Added support for choosing different e-mail for commits than for "
"notifications."
msgstr "ເພີ່ມການຮອງຮັບການເລືອກອີເມວສຳລັບ Commits ທີ່ແຕກຕ່າງຈາກການແຈ້ງເຕືອນ."

msgid "The Docker image no longer enables debug mode by default."
msgstr "Docker image ຕອນນີ້ບໍ່ໄດ້ເປີດໃຊ້ Debug mode ໂດຍເລີ່ມຕົ້ນ."

msgid "Order glossary terms based on the glossary component priority."
msgstr "ຈັດລຽງຄຳສັບ Glossary ຕາມຄວາມສຳຄັນຂອງອົງປະກອບ Glossary."

msgid "Added team administrators who can add or remove members of the team."
msgstr "ເພີ່ມຜູ້ດູແລທີມທີ່ສາມາດເພີ່ມຫຼືລຶບສະມາຊິກຂອງທີມໄດ້."

msgid "Added a popup confirmation before deleting users."
msgstr "ເພີ່ມການຢືນຢັນຜ່ານ Popup ກ່ອນລຶບຜູ້ໃຊ້."

msgid "Added add-on to customize XML output."
msgstr "ເພີ່ມ Add-on ເພື່ອປັບແຕ່ງຜົນລັພ XML."

msgid ""
"`All changes in detail <https://github.com/WeblateOrg/weblate/milestone/88?"
"closed=1>`__."
msgstr ""
"`ລາຍລະອຽດການປ່ຽນແປງທັງໝົດ <https://github.com/WeblateOrg/weblate/milestone/88?"
"closed=1>`__."

msgid ""
"Weblate now requires ``btree_gin`` extension in PostgreSQL. The migration "
"process will install it if it has sufficient privileges. See :ref:`dbsetup-"
"postgres` for manual setup."
msgstr ""
"Weblate ຕອນນີ້ຕ້ອງການ Extension ``btree_gin`` ໃນ PostgreSQL. "
"ຂະບວນການຍ້າຍຂໍ້ມູນຈະຕິດຕັ້ງໃຫ້ຫາກມີສິດທິພຽງພໍ. ເບິ່ງ :ref:`dbsetup-postgres` "
"ສຳລັບການຕັ້ງຄ່າດ້ວຍຕົນເອງ."

msgid ""
"The Docker image no longer enables debug mode by default. In case you want "
"it, enable it in the environment using :envvar:`WEBLATE_DEBUG`."
msgstr ""
"Docker image ຕອນນີ້ບໍ່ໄດ້ເປີດໃຊ້ Debug mode ໂດຍເລີ່ມຕົ້ນ. ໃນກໍລະນີທີ່ທ່ານຕ້ອງການ, "
"ໃຫ້ເປີດໃຊ້ໃນສະພາບແວດລ້ອມໂດຍໃຊ້ :envvar:`WEBLATE_DEBUG`."

msgid ""
"The database migration make take hours on larger instances due to recreating "
"some of the indexes."
msgstr ""
"ການຍ້າຍຂໍ້ມູນຖານຂໍ້ມູນອາດໃຊ້ເວລາຫຼາຍຊົ່ວໂມງໃນ Instance ຂະໜາດໃຫຍ່ເນື່ອງຈາກການສ້າງ Index "
"ບາງຢ່າງຄືນໃໝ່."

msgid ""
"**Changed in 4.15.1:** The default value for ``DEFAULT_PAGINATION_CLASS`` in "
"rest framework settings was changed."
msgstr ""
"**ປ່ຽນແປງໃນ 4.15.1:** ຄ່າເລີ່ມຕົ້ນສຳລັບ ``DEFAULT_PAGINATION_CLASS`` ໃນການຕັ້ງຄ່າ rest "
"framework ໄດ້ຖືກປ່ຽນແປງ."

msgid "Weblate 4.14.2"
msgstr "Weblate 4.14.2"

msgid "*Released on November 5th 2022.*"
msgstr "*ອອກວັນທີ 5 ພະຈິກ 2022.*"

msgid "Added support for removing entries from translation memory."
msgstr "ເພີ່ມການຮອງຮັບການລຶບລາຍການອອກຈາກໜ່ວຍຄວາມຈຳການແປ."

msgid "Improved analysis on the duplicate language alert."
msgstr "ປັບປຸງການວິເຄາະໃນການແຈ້ງເຕືອນພາສາທີ່ຊ້ຳກັນ."

msgid "Improved accuracy of the consecutive duplicated-words check."
msgstr "ປັບປຸງຄວາມຖືກຕ້ອງຂອງການກວດສອບຄຳທີ່ຊ້ຳກັນຕິດຕໍ່ກັນ."

msgid "Improved scaling of sending many notifications."
msgstr "ປັບປຸງການຂະຫຍາຍໃນການສົ່ງແຈ້ງເຕືອນຈຳນວນຫຼາຍ."

msgid "Improved string-state handling for subtitle translation."
msgstr "ປັບປຸງການຈັດການສະຖານະຂໍ້ຄວາມສຳລັບການແປຄຳບັນຍາຍ."

msgid ""
"Deprecated insecure configuration of VCS service API keys via _TOKEN/"
"_USERNAME configuration instead of _CREDENTIALS list."
msgstr ""
"ບໍ່ແນະນຳໃຫ້ໃຊ້ການຕັ້ງຄ່າທີ່ບໍ່ປອດໄພຂອງຄີ API ບໍລິການ VCS ຜ່ານການຕັ້ງຄ່າ _TOKEN/_USERNAME "
"ແທນລາຍການ _CREDENTIALS."

msgid "Fixed processing of some uploaded CSV files."
msgstr "ແກ້ໄຂການປະມວນຜົນໄຟລ໌ CSV ທີ່ອັບໂຫຼດບາງໄຟລ໌."

msgid "Improved whitespace changes handling in diff display."
msgstr "ປັບປຸງການຈັດການການປ່ຽນແປງ Whitespace ໃນການສະແດງ Diff."

msgid "Added link for managing automatic suggestions to the management pages."
msgstr "ເພີ່ມລິ້ງສຳລັບຈັດການຄຳແນະນຳອັດຕະໂນມັດໃນໜ້າຈັດການ."

msgid "Track comment removal/resolving in history."
msgstr "ຕິດຕາມການລຶບ/ແກ້ໄຂຄຳເຫັນໃນປະຫວັດ."

msgid "Fixed restoring project backups with linked components."
msgstr "ແກ້ໄຂການກູ້ຄືນການສຳຮອງຂໍ້ມູນໂຄງການທີ່ມີອົງປະກອບເຊື່ອມໂຍງ."

msgid "Fixed CAPTCHA entering on unsuccessful registration."
msgstr "ແກ້ໄຂການໃສ່ CAPTCHA ເມື່ອການລົງທະບຽນບໍ່ສຳເລັດ."

msgid "Improved languages support in DeepL."
msgstr "ປັບປຸງການຮອງຮັບພາສາໃນ DeepL."

msgid "Improved webhooks compatibility with authenticated repositories."
msgstr "ປັບປຸງຄວາມເຂົ້າກັນໄດ້ຂອງ Webhook ກັບ Repository ທີ່ມີການຢືນຢັນຕົວຕົນ."

msgid "Added support for Python 3.11."
msgstr "ເພີ່ມການຮອງຮັບ Python 3.11."

msgid ""
"`All changes in detail <https://github.com/WeblateOrg/weblate/milestone/87?"
"closed=1>`__."
msgstr ""
"`ລາຍລະອຽດການປ່ຽນແປງທັງໝົດ <https://github.com/WeblateOrg/weblate/milestone/87?"
"closed=1>`__."

msgid "Weblate 4.14.1"
msgstr "Weblate 4.14.1"

msgid "*Released on September 15th 2022.*"
msgstr "*ອອກວັນທີ 15 ກັນຍາ 2022.*"

msgid "Fixed generating project backups in some situations."
msgstr "ແກ້ໄຂການສ້າງການສຳຮອງຂໍ້ມູນໂຄງການໃນບາງສະຖານະການ."

msgid "Improved error reporting when uploading files."
msgstr "ປັບປຸງການລາຍງານຂໍ້ຜິດພາດເມື່ອອັບໂຫຼດໄຟລ໌."

msgid "Fetch all user verified e-mails from GitHub during authentication."
msgstr "ດຶງຂໍ້ມູນອີເມວທີ່ຢືນຢັນແລ້ວຂອງຜູ້ໃຊ້ທັງໝົດຈາກ GitHub ໃນລະຫວ່າງການຢືນຢັນຕົວຕົນ."

msgid "Avoid matching glossary terms on context or keys."
msgstr "ຫຼີກເວັ້ນການຈັບຄູ່ຄຳສັບ Glossary ໃນບໍລິບົດຫຼືຄີ."

msgid "Added notifications for string removals."
msgstr "ເພີ່ມການແຈ້ງເຕືອນສຳລັບການລຶບຂໍ້ຄວາມ."

msgid "Improved management of untranslatable terms in glossary."
msgstr "ປັບປຸງການຈັດການຄຳສັບທີ່ແປບໍ່ໄດ້ໃນ Glossary."

msgid "List number of team members on team management page."
msgstr "ລາຍການຈຳນວນສະມາຊິກທີມໃນໜ້າຈັດການທີມ."

msgid "Add group management interface."
msgstr "ເພີ່ມອິນເຕີເຟສການຈັດການກຸ່ມ."

msgid "Always show review stats when reviews are turned on."
msgstr "ສະແດງສະຖິຕິການທົບທວນສະເໝີເມື່ອເປີດໃຊ້ການທົບທວນ."

msgid "Added searching support in units API."
msgstr "ເພີ່ມການຮອງຮັບການຄົ້ນຫາໃນ API ຫົວໜ່ວຍ."

msgid ""
"Fixed progress bar display for read-only strings in the review workflow."
msgstr "ແກ້ໄຂການສະແດງແຖບຄວາມຄືບໜ້າສຳລັບຂໍ້ຄວາມ Read-only ໃນຂະບວນການທົບທວນ."

msgid "Improved punctuation checks for Burmese."
msgstr "ປັບປຸງການກວດສອບເຄື່ອງໝາຍວັກຕອນສຳລັບພາສາພະມ້າ."

msgid "Fixed garbage collecting of metrics data."
msgstr "ແກ້ໄຂການເກັບຂີ້ເຫຍື້ອຂອງຂໍ້ມູນ Metrics."

msgid ""
"`All changes in detail <https://github.com/WeblateOrg/weblate/milestone/86?"
"closed=1>`__."
msgstr ""
"`ລາຍລະອຽດການປ່ຽນແປງທັງໝົດ <https://github.com/WeblateOrg/weblate/milestone/86?"
"closed=1>`__."

msgid "Weblate 4.14"
msgstr "Weblate 4.14"

msgid "*Released on August 22nd 2022.*"
msgstr "*ອອກວັນທີ 22 ສິງຫາ 2022.*"

msgid "Track add-on changes in a history."
msgstr "ຕິດຕາມການປ່ຽນແປງ Add-on ໃນປະຫວັດ."

msgid "Fixed parsing translation from Windows RC, HTML and text files."
msgstr "ແກ້ໄຂການແຍກວິເຄາະການແປຈາກໄຟລ໌ Windows RC, HTML ແລະ ຂໍ້ຄວາມ."

msgid "Extended language code style configuration options."
msgstr "ຂະຫຍາຍຕົວເລືອກການຕັ້ງຄ່າຮູບແບບລະຫັດພາສາ."

msgid "Added support for plurals updated in the recent CLDR releases."
msgstr "ເພີ່ມການຮອງຮັບຮູບແບບພົດທີ່ອັບເດດໃນ CLDR ລຸ້ນຫຼ້າສຸດ."

msgid ""
"Reduced memory usage while updating components with a lot of translations."
msgstr "ຫຼຸດການໃຊ້ໜ່ວຍຄວາມຈຳໃນຂະນະອັບເດດອົງປະກອບທີ່ມີການແປຫຼາຍ."

msgid "Added support for translation domain in SAP Translation Hub."
msgstr "ເພີ່ມການຮອງຮັບ Translation domain ໃນ SAP Translation Hub."

msgid "Allow absolute links in source string locations."
msgstr "ອະນຸຍາດລິ້ງສົມບູນໃນຕຳແໜ່ງຂໍ້ຄວາມຕົ້ນສະບັບ."

msgid "Improved operation behind some reverse proxies."
msgstr "ປັບປຸງການເຮັດວຽກທີ່ຢູ່ເບື້ອງຫຼັງ Reverse proxy ບາງຢ່າງ."

msgid "Extended API to cover translation memory."
msgstr "ຂະຫຍາຍ API ໃຫ້ກວມເອົາໜ່ວຍຄວາມຈຳການແປ."

msgid "Improved document translation workflow."
msgstr "ປັບປຸງຂະບວນການແປເອກະສານ."

msgid "Improved reliability of HTML and text files translation."
msgstr "ປັບປຸງຄວາມໜ້າເຊື່ອຖືຂອງການແປໄຟລ໌ HTML ແລະ ຂໍ້ຄວາມ."

msgid "Added support for project level backups."
msgstr "ເພີ່ມການຮອງຮັບການສຳຮອງຂໍ້ມູນລະດັບໂຄງການ."

msgid "Improved performance and memory usage of translation memory lookups."
msgstr "ປັບປຸງປະສິດທິພາບແລະການໃຊ້ໜ່ວຍຄວາມຈຳຂອງການຄົ້ນຫາໜ່ວຍຄວາມຈຳການແປ."

msgid ""
"`All changes in detail <https://github.com/WeblateOrg/weblate/milestone/84?"
"closed=1>`__."
msgstr ""
"`ລາຍລະອຽດການປ່ຽນແປງທັງໝົດ <https://github.com/WeblateOrg/weblate/milestone/84?"
"closed=1>`__."

msgid ""
"The Java formatting checks now match GNU gettext flags. The flags set in "
"Weblate will be automatically migrated, but third-party scripts will need to "
"use ``java-printf-format`` instead of ``java-format`` and ``java-format`` "
"instead of ``java-messageformat``."
msgstr ""
"ການກວດສອບ Java formatting ຕອນນີ້ກົງກັບທຸງ GNU gettext. ທຸງທີ່ຕັ້ງໃນ Weblate "
"ຈະຖືກຍ້າຍໂດຍອັດຕະໂນມັດ, ແຕ່ສະຄຣິບຂອງພາກສ່ວນທີສາມຈະຕ້ອງໃຊ້ ``java-printf-format`` ແທນ "
"``java-format`` ແລະ ``java-format`` ແທນ ``java-messageformat``."

msgid "The `jellyfish` dependency has been replaced by `rapidfuzz`."
msgstr "Dependency `jellyfish` ໄດ້ຖືກປ່ຽນແທນດ້ວຍ `rapidfuzz`."

msgid ""
"**Changed in 4.14.2:** Deprecated insecure configuration of VCS service API "
"keys via _TOKEN/_USERNAME configuration instead of _CREDENTIALS list. In "
"Docker, please add matching _HOST directive. For example "
"see :envvar:`WEBLATE_GITHUB_HOST` and :setting:`GITHUB_CREDENTIALS`."
msgstr ""
"**ປ່ຽນແປງໃນ 4.14.2:** ບໍ່ແນະນຳໃຫ້ໃຊ້ການຕັ້ງຄ່າທີ່ບໍ່ປອດໄພຂອງຄີ API ບໍລິການ VCS ຜ່ານການຕັ້ງຄ່າ "
"_TOKEN/_USERNAME ແທນລາຍການ _CREDENTIALS. ໃນ Docker, ກະລຸນາເພີ່ມ Directive _HOST "
"ທີ່ກົງກັນ. ຕົວຢ່າງເບິ່ງ :envvar:`WEBLATE_GITHUB_HOST` "
"ແລະ :setting:`GITHUB_CREDENTIALS`."

msgid "Weblate 4.13.1"
msgstr "Weblate 4.13.1"

msgid "*Released on July 1st 2022.*"
msgstr "*ອອກຈຳໜ່າຍເມື່ອວັນທີ 1 ກໍລະກົດ 2022.*"

msgid "Fixed tracking suggestions in history."
msgstr "ແກ້ໄຂການຕິດຕາມຄຳແນະນຳໃນປະຫວັດ."

msgid "Fixed parsing reverse proxy info from Cloudflare."
msgstr "ແກ້ໄຂການແຍກວິເຄາະຂໍ້ມູນ reverse proxy ຈາກ Cloudflare."

msgid "Make parse errors lock translation of a component."
msgstr "ເຮັດໃຫ້ຂໍ້ຜິດພາດໃນການແຍກວິເຄາະ ລັອກການແປຂອງອົງປະກອບນັ້ນ."

msgid "Fixed configuring intermediate file in the discovery add-on."
msgstr "ແກ້ໄຂການຕັ້ງຄ່າໄຟລ໌ກາງໃນສ່ວນເສີມ discovery."

msgid "Fixed DeepL translations behavior with placeholders."
msgstr "ແກ້ໄຂພຶດຕິກຳການແປຂອງ DeepL ທີ່ມີ placeholder."

msgid "Fixed untranslating strings via API."
msgstr "ແກ້ໄຂການຍົກເລີກການແປຂໍ້ຄວາມຜ່ານ API."

msgid "Added support for removing a user from a group via API."
msgstr "ເພີ່ມການຮອງຮັບການລຶບຜູ້ໃຊ້ອອກຈາກກຸ່ມຜ່ານ API."

msgid "Fixed audit log for user invitation e-mails."
msgstr "ແກ້ໄຂບັນທຶກການກວດສອບສຳລັບອີເມວເຊີນຜູ້ໃຊ້."

msgid "Fixed flag names for Java formatting strings."
msgstr "ແກ້ໄຂຊື່ທຸງສຳລັບຂໍ້ຄວາມຮູບແບບ Java."

msgid ""
"`All changes in detail <https://github.com/WeblateOrg/weblate/milestone/85?"
"closed=1>`__."
msgstr ""
"`ລາຍລະອຽດການປ່ຽນແປງທັງໝົດ <https://github.com/WeblateOrg/weblate/milestone/85?"
"closed=1>`__."

msgid "Weblate 4.13"
msgstr "Weblate 4.13"

msgid "*Released on June 15th 2022.*"
msgstr "*ອອກຈຳໜ່າຍເມື່ອວັນທີ 15 ມິຖຸນາ 2022.*"

msgid "Changed behavior of updating language names."
msgstr "ປ່ຽນແປງພຶດຕິກຳການອັບເດດຊື່ພາສາ."

msgid "Added pagination to projects listing."
msgstr "ເພີ່ມການແບ່ງໜ້າໃນລາຍການໂຄງການ."

msgid "API for creating new units now returns info about newly created unit."
msgstr "API ສຳລັບການສ້າງຫົວໜ່ວຍໃໝ່ ຕອນນີ້ສົ່ງກັບຂໍ້ມູນກ່ຽວກັບຫົວໜ່ວຍທີ່ສ້າງຂຶ້ນໃໝ່."

msgid "Component discovery now supports configuring an intermediate language."
msgstr "Component discovery ຕອນນີ້ຮອງຮັບການຕັ້ງຄ່າພາສາກາງ."

msgid "Added fixed encoding variants to CSV formats."
msgstr "ເພີ່ມຕົວເລືອກການເຂົ້າລະຫັດແບບຄົງທີ່ໃຫ້ກັບຮູບແບບ CSV."

msgid ""
"Changed handling of context and location for some formats to better fit "
"underlying implementation."
msgstr ""
"ປ່ຽນແປງການຈັດການບໍລິບົດ ແລະ ທີ່ຕັ້ງສຳລັບບາງຮູບແບບ ເພື່ອໃຫ້ເຂົ້າກັບການນຳໄປໃຊ້ງານພື້ນຖານໄດ້ດີຂຶ້ນ."

msgid "Added support for the ResourceDictionary format."
msgstr "ເພີ່ມການຮອງຮັບຮູບແບບ ResourceDictionary."

msgid "Improved progress-bar colors for color-blind people."
msgstr "ປັບປຸງສີແຖບຄວາມຄືບໜ້າສຳລັບຜູ້ທີ່ມີບັນຫາຕາບອດສີ."

msgid "Fixed variants cleanup when removing strings."
msgstr "ແກ້ໄຂການທຳຄວາມສະອາດຕົວເລືອກຕ່າງໆ ເມື່ອລຶບຂໍ້ຄວາມ."

msgid "Compatibility with Django 4.1."
msgstr "ຮອງຮັບການເຮັດວຽກກັບ Django 4.1."

msgid "Added support for storing escaped XML elements in XLIFF."
msgstr "ເພີ່ມການຮອງຮັບການຈັດເກັບອົງປະກອບ XML ແບບ escape ໃນ XLIFF."

msgid "Improved formatting of placeholder-check errors."
msgstr "ປັບປຸງການຈັດຮູບແບບຂໍ້ຜິດພາດໃນການກວດສອບ placeholder."

msgid "Redirect /.well-known/change-password to /accounts/password/."
msgstr "ປ່ຽນເສັ້ນທາງ /.well-known/change-password ໄປທີ່ /accounts/password/."

msgid "Machine translation services are now configurable per project."
msgstr "ບໍລິການແປພາສາດ້ວຍເຄື່ອງຈັກ ຕອນນີ້ສາມາດຕັ້ງຄ່າແຍກເປັນລາຍໂຄງການໄດ້."

msgid ""
"Added separate permission for resolving comments and grant it to "
"the :guilabel:`Review strings` role."
msgstr ""
"ເພີ່ມສິດທິພິເສດແຍກຕ່າງຫາກສຳລັບການແກ້ໄຂຄຳຄິດເຫັນ ແລະ ມອບສິດນີ້ໃຫ້ກັບບົດບາດ :guilabel:`Review "
"strings`."

msgid "Added support for storing alternative translations in the CSV file."
msgstr "ເພີ່ມການຮອງຮັບການຈັດເກັບຄຳແປທາງເລືອກໃນໄຟລ໌ CSV."

msgid "The placeholders check can now be case-insensitive as well."
msgstr "ການກວດສອບ placeholder ຕອນນີ້ສາມາດຕັ້ງຄ່າໃຫ້ບໍ່ສົນໃຈຕົວພິມນ້ອຍ-ໃຫຍ່ໄດ້."

msgid ""
"`All changes in detail <https://github.com/WeblateOrg/weblate/milestone/81?"
"closed=1>`__."
msgstr ""
"`ລາຍລະອຽດການປ່ຽນແປງທັງໝົດ <https://github.com/WeblateOrg/weblate/milestone/81?"
"closed=1>`__."

msgid ""
"The :ref:`languages` are now automatically updated on upgrade, "
"use :setting:`UPDATE_LANGUAGES` to disable that."
msgstr ""
":ref:`languages` ຈະຖືກອັບເດດໂດຍອັດຕະໂນມັດເມື່ອອັບເກຣດ, "
"ໃຊ້ :setting:`UPDATE_LANGUAGES` ເພື່ອປິດການເຮັດວຽກດັ່ງກ່າວ."

msgid ""
"Handling of context and location has been changed "
"for :ref:`winrc`, :ref:`html`, :ref:`idml`, and :ref:`txt` file formats. In "
"most cases the context is now shown as location."
msgstr ""
"ການຈັດການບໍລິບົດ ແລະ "
"ທີ່ຕັ້ງໄດ້ຖືກປ່ຽນແປງສຳລັບຮູບແບບໄຟລ໌ :ref:`winrc`, :ref:`html`, :ref:`idml` "
"ແລະ :ref:`txt`. ໃນກໍລະນີສ່ວນໃຫຍ່ ບໍລິບົດຈະຖືກສະແດງເປັນທີ່ຕັ້ງ."

msgid ""
"The machine translation services are now configured using the user "
"interface, settings from the configuration file will be imported during the "
"database migration."
msgstr ""
"ບໍລິການແປພາສາດ້ວຍເຄື່ອງຈັກ ຕອນນີ້ຖືກຕັ້ງຄ່າໂດຍໃຊ້ການໂຕ້ຕອບຜູ້ໃຊ້, "
"ການຕັ້ງຄ່າຈາກໄຟລ໌ຕັ້ງຄ່າຈະຖືກນຳເຂົ້າໃນລະຫວ່າງການຍ້າຍຖານຂໍ້ມູນ."

msgid "Weblate 4.12.2"
msgstr "Weblate 4.12.2"

msgid "*Released on May 11th 2022.*"
msgstr "*ອອກຈຳໜ່າຍເມື່ອວັນທີ 11 ພຶດສະພາ 2022.*"

msgid "Fixed rebuilding project translation-memory for some components."
msgstr "ແກ້ໄຂການສ້າງໜ່ວຍຄວາມຈຳການແປຂອງໂຄງການຄືນໃໝ່ສຳລັບບາງອົງປະກອບ."

msgid "Fixed sorting components by untranslated strings."
msgstr "ແກ້ໄຂການຈັດລຽງອົງປະກອບຕາມຂໍ້ຄວາມທີ່ຍັງບໍ່ທັນແປ."

msgid "Fixed possible loss of translations while adding a new language."
msgstr "ແກ້ໄຂການສູນເສຍຄຳແປທີ່ອາດເກີດຂຶ້ນໃນຂະນະເພີ່ມພາສາໃໝ່."

msgid "Ensure Weblate SSH key is generated during migrations."
msgstr "ຮັບປະກັນວ່າ SSH key ຂອງ Weblate ຖືກສ້າງຂຶ້ນໃນລະຫວ່າງການຍ້າຍລະບົບ."

msgid ""
"`All changes in detail <https://github.com/WeblateOrg/weblate/milestone/83?"
"closed=1>`__."
msgstr ""
"`ລາຍລະອຽດການປ່ຽນແປງທັງໝົດ <https://github.com/WeblateOrg/weblate/milestone/83?"
"closed=1>`__."

msgid "Weblate 4.12.1"
msgstr "Weblate 4.12.1"

msgid "*Released on April 29th 2022.*"
msgstr "*ອອກຈຳໜ່າຍເມື່ອວັນທີ 29 ເມສາ 2022.*"

msgid "Fixed pull request message title."
msgstr "ແກ້ໄຂຫົວຂໍ້ຂໍ້ຄວາມ pull request."

msgid "Improved syntax error handling in Fluent format."
msgstr "ປັບປຸງການຈັດການຂໍ້ຜິດພາດທາງໄວຍາກອນໃນຮູບແບບ Fluent."

msgid "Fixed avatar display in notification e-mails."
msgstr "ແກ້ໄຂການສະແດງຮູບແທນຕົວໃນອີເມວແຈ້ງເຕືອນ."

msgid "Add support for web monetization."
msgstr "ເພີ່ມການຮອງຮັບການສ້າງລາຍໄດ້ຈາກເວັບ."

msgid "Fixed removal of stale source strings when removing translations."
msgstr "ແກ້ໄຂການລຶບຂໍ້ຄວາມຕົ້ນສະບັບທີ່ຄ້າງຄາອອກ ເມື່ອລຶບຄຳແປ."

msgid ""
"`All changes in detail <https://github.com/WeblateOrg/weblate/milestone/82?"
"closed=1>`__."
msgstr ""
"`ລາຍລະອຽດການປ່ຽນແປງທັງໝົດ <https://github.com/WeblateOrg/weblate/milestone/82?"
"closed=1>`__."

msgid "Weblate 4.12"
msgstr "Weblate 4.12"

msgid "*Released on April 20th 2022.*"
msgstr "*ອອກຈຳໜ່າຍເມື່ອວັນທີ 20 ເມສາ 2022.*"

msgid "Added support for Amharic in :ref:`check-end-stop`."
msgstr "ເພີ່ມການຮອງຮັບພາສາອຳຮາຣິກໃນ :ref:`check-end-stop`."

msgid "Added support for Burmese in :ref:`check-end-question`."
msgstr "ເພີ່ມການຮອງຮັບພາສາພະມ້າໃນ :ref:`check-end-question`."

msgid ""
"Extended options of the :ref:`addon-weblate.generate.pseudolocale` add-on."
msgstr "ຂະຫຍາຍຕົວເລືອກຂອງສ່ວນເສີມ :ref:`addon-weblate.generate.pseudolocale`."

msgid ""
"Added ``ignore-all-checks`` flag to ignore all quality checks on a string."
msgstr "ເພີ່ມທຸງ ``ignore-all-checks`` ເພື່ອບໍ່ສົນໃຈການກວດສອບຄຸນນະພາບທັງໝົດໃນຂໍ້ຄວາມ."

msgid ""
"Avoid :ref:`addon-weblate.generate.pseudolocale` add-on to trigger failing "
"checks."
msgstr ""
"ຫຼີກເວັ້ນບໍ່ໃຫ້ສ່ວນເສີມ :ref:`addon-weblate.generate.pseudolocale` "
"ກະຕຸ້ນການກວດສອບທີ່ລົ້ມເຫຼວ."

msgid "Added support for :ref:`code-hosting-gitea-pull-requests`."
msgstr "ເພີ່ມການຮອງຮັບ :ref:`code-hosting-gitea-pull-requests`."

msgid ""
"Added Linux-style language code to :ref:`component-language_code_style`."
msgstr "ເພີ່ມລະຫັດພາສາແບບ Linux ໃຫ້ກັບ :ref:`component-language_code_style`."

msgid "Added support for rebuilding project translation memory."
msgstr "ເພີ່ມການຮອງຮັບການສ້າງໜ່ວຍຄວາມຈຳການແປຂອງໂຄງການຄືນໃໝ່."

msgid "Improved API for creating components from a file."
msgstr "ປັບປຸງ API ສຳລັບການສ້າງອົງປະກອບຈາກໄຟລ໌."

msgid "Add copy and clone buttons to other translations."
msgstr "ເພີ່ມປຸ່ມສຳເນົາ ແລະ ຄລອນໄປຍັງຄຳແປອື່ນໆ."

msgid "Make merge request message configurable at the component level."
msgstr "ເຮັດໃຫ້ຂໍ້ຄວາມ merge request ສາມາດຕັ້ງຄ່າໄດ້ໃນລະດັບອົງປະກອບ."

msgid "Improved behavior of maximal-length restriction with XML tags."
msgstr "ປັບປຸງພຶດຕິກຳຂອງຂໍ້ຈຳກັດຄວາມຍາວສູງສຸດດ້ວຍແທັກ XML."

msgid "Fixed loading Fluent files with additional comments."
msgstr "ແກ້ໄຂການໂຫຼດໄຟລ໌ Fluent ທີ່ມີຄຳຄິດເຫັນເພີ່ມເຕີມ."

msgid ""
"`All changes in detail <https://github.com/WeblateOrg/weblate/milestone/77?"
"closed=1>`__."
msgstr ""
"`ລາຍລະອຽດການປ່ຽນແປງທັງໝົດ <https://github.com/WeblateOrg/weblate/milestone/77?"
"closed=1>`__."

msgid "There are no special steps required."
msgstr "ບໍ່ມີຂັ້ນຕອນພິເສດໃດໆທີ່ຈຳເປັນ."

msgid "Weblate 4.11.2"
msgstr "Weblate 4.11.2"

msgid "*Released on March 4th 2022.*"
msgstr "*ອອກຈຳໜ່າຍເມື່ອວັນທີ 4 ມີນາ 2022.*"

msgid "Fixed corrupted MO files in the binary release."
msgstr "ແກ້ໄຂໄຟລ໌ MO ທີ່ເສຍຫາຍໃນການປ່ອຍໄຟລ໌ຖານສອງ."

msgid ""
"`All changes in detail <https://github.com/WeblateOrg/weblate/milestone/80?"
"closed=1>`__."
msgstr ""
"`ລາຍລະອຽດການປ່ຽນແປງທັງໝົດ <https://github.com/WeblateOrg/weblate/milestone/80?"
"closed=1>`__."

msgid "Weblate 4.11.1"
msgstr "Weblate 4.11.1"

msgid ""
"Fixed missing sanitizing of arguments to Git and Mercurial "
"- :cve:`2022-23915`, see :ghsa:`3872-f48p-pxqj` for more details."
msgstr ""
"ແກ້ໄຂການບໍ່ກວດສອບຄວາມປອດໄພຂອງອາກິວເມັນສຳລັບ Git ແລະ Mercurial - :cve:`2022-23915`, "
"ເບິ່ງ :ghsa:`3872-f48p-pxqj` ສຳລັບລາຍລະອຽດເພີ່ມເຕີມ."

msgid "Fixed loading fuzzy strings from CSV files."
msgstr "ແກ້ໄຂການໂຫຼດຂໍ້ຄວາມ fuzzy ຈາກໄຟລ໌ CSV."

msgid "Added support for creating teams using the API."
msgstr "ເພີ່ມການຮອງຮັບການສ້າງທີມໂດຍໃຊ້ API."

msgid "Fixed user mention suggestions display."
msgstr "ແກ້ໄຂການສະແດງຄຳແນະນຳການກ່າວເຖິງຜູ້ໃຊ້."

msgid "The project tokens access can now be customized."
msgstr "ການເຂົ້າເຖິງ token ຂອງໂຄງການຕອນນີ້ສາມາດປັບແຕ່ງໄດ້."

msgid ""
"`All changes in detail <https://github.com/WeblateOrg/weblate/milestone/78?"
"closed=1>`__."
msgstr ""
"`ລາຍລະອຽດການປ່ຽນແປງທັງໝົດ <https://github.com/WeblateOrg/weblate/milestone/78?"
"closed=1>`__."

msgid "Weblate 4.11"
msgstr "Weblate 4.11"

msgid "*Released on February 25th 2022.*"
msgstr "*ອອກຈຳໜ່າຍເມື່ອວັນທີ 25 ກຸມພາ 2022.*"

msgid ""
"Fixes stored XSS - :cve:`2022-24710`, see :ghsa:`6jp6-9rf9-gc66` for more "
"details."
msgstr ""
"ແກ້ໄຂ Stored XSS - :cve:`2022-24710`, ເບິ່ງ :ghsa:`6jp6-9rf9-gc66` "
"ສຳລັບລາຍລະອຽດເພີ່ມເຕີມ."

msgid "Fixed add-on installation using the API."
msgstr "ແກ້ໄຂການຕິດຕັ້ງສ່ວນເສີມໂດຍໃຊ້ API."

msgid ""
"Renamed :guilabel:`Strings needing action` to :guilabel:`Unfinished strings`."
msgstr ""
"ປ່ຽນຊື່ :guilabel:`Strings needing action` ເປັນ :guilabel:`Unfinished strings`."

msgid "Fixed false positives from :ref:`check-icu-message-format-syntax`."
msgstr "ແກ້ໄຂຜົນບວກປອມຈາກ :ref:`check-icu-message-format-syntax`."

msgid "Indicate lock and contributor agreement on other occurrences listing."
msgstr "ສະແດງການລັອກ ແລະ ຂໍ້ຕົກລົງຜູ້ປະກອບສ່ວນໃນລາຍການອື່ນໆທີ່ພົບ."

msgid "Fixed updating PO files with obsolete strings or missing plurals."
msgstr "ແກ້ໄຂການອັບເດດໄຟລ໌ PO ທີ່ມີຂໍ້ຄວາມທີ່ລ້າສະໄໝ ຫຼື ພະຫຸພົດທີ່ຂາດຫາຍ."

msgid "Improved squash add-on compatibility with Gerrit."
msgstr "ປັບປຸງຄວາມເຂົ້າກັນໄດ້ຂອງສ່ວນເສີມ squash ກັບ Gerrit."

msgid ""
"Automatically initialize user languages based on the :http:header:`Accept-"
"Language` header."
msgstr "ລິເລີ່ມພາສາຂອງຜູ້ໃຊ້ໂດຍອັດຕະໂນມັດໂດຍອີງໃສ່ສ່ວນຫົວ :http:header:`Accept-Language`."

msgid "Improved error handling on string removal."
msgstr "ປັບປຸງການຈັດການຂໍ້ຜິດພາດເມື່ອລຶບຂໍ້ຄວາມ."

msgid "Weblate now requires Python 3.7 or newer."
msgstr "Weblate ຕອນນີ້ຕ້ອງການ Python 3.7 ຫຼື ໃໝ່ກວ່າ."

msgid "Fixed some write operations with project token authentication."
msgstr "ແກ້ໄຂການດຳເນີນການຂຽນບາງຢ່າງດ້ວຍການຢືນຢັນຕົວຕົນຜ່ານ token ຂອງໂຄງການ."

msgid "Fixed string state tracking when the strings changes in the repository."
msgstr "ແກ້ໄຂການຕິດຕາມສະຖານະຂໍ້ຄວາມ ເມື່ອຂໍ້ຄວາມມີການປ່ຽນແປງໃນບ່ອນເກັບຂໍ້ມູນ."

msgid "Track string changes from the repository."
msgstr "ຕິດຕາມການປ່ຽນແປງຂໍ້ຄວາມຈາກບ່ອນເກັບຂໍ້ມູນ."

msgid "Sticky header on translations listing to improve navigation."
msgstr "ຫົວຂໍ້ແບບຕິດຄ້າງ (sticky header) ໃນລາຍການແປເພື່ອປັບປຸງການນຳທາງ."

msgid "Fixed untranslating strings in :ref:`javaprop`."
msgstr "ແກ້ໄຂການຍົກເລີກການແປຂໍ້ຄວາມໃນ :ref:`javaprop`."

msgid "Fixed Git operation with non-ASCII branch names."
msgstr "ແກ້ໄຂການດຳເນີນການ Git ດ້ວຍຊື່ສາຂາທີ່ບໍ່ແມ່ນ ASCII."

msgid "New add-on :ref:`addon-weblate.generate.prefill`."
msgstr "ສ່ວນເສີມໃໝ່ :ref:`addon-weblate.generate.prefill`."

msgid ""
"Added :guilabel:`Merge without fast-forward` :ref:`component-merge_style`."
msgstr ""
"ເພີ່ມ :guilabel:`Merge without fast-forward` :ref:`component-merge_style`."

msgid ""
"Fixed :ref:`addon-weblate.autotranslate.autotranslate` add-on triggering for "
"newly added strings."
msgstr ""
"ແກ້ໄຂສ່ວນເສີມ :ref:`addon-weblate.autotranslate.autotranslate` "
"ທີ່ກະຕຸ້ນສຳລັບຂໍ້ຄວາມທີ່ເພີ່ມໃໝ່."

msgid ""
"Added support for defining custom teams at project level to grant users "
"access, see :ref:`manage-acl`."
msgstr ""
"ເພີ່ມການຮອງຮັບການກຳນົດທີມແບບກຳນົດເອງໃນລະດັບໂຄງການເພື່ອໃຫ້ສິດທິຜູ້ໃຊ້, ເບິ່ງ :ref:`manage-acl`."

msgid "Added documentation links to alerts."
msgstr "ເພີ່ມລິ້ງເອກະສານໃຫ້ກັບການແຈ້ງເຕືອນ."

msgid ""
"Docker container automatically enables TLS/SSL for outgoing e-mail when "
"needed."
msgstr "Docker container ເປີດໃຊ້ TLS/SSL ໂດຍອັດຕະໂນມັດສຳລັບອີເມວຂາອອກເມື່ອຈຳເປັນ."

msgid "Added support for searching for resolved comments."
msgstr "ເພີ່ມການຮອງຮັບການຄົ້ນຫາຄຳຄິດເຫັນທີ່ແກ້ໄຂແລ້ວ."

msgid "Added support for borgbackup 1.2."
msgstr "ເພີ່ມການຮອງຮັບ borgbackup 1.2."

msgid "Fixed applying of :guilabel:`Automatically translated` label."
msgstr "ແກ້ໄຂການນຳໃຊ້ປ້າຍ :guilabel:`Automatically translated`."

msgid ""
"`All changes in detail <https://github.com/WeblateOrg/weblate/milestone/75?"
"closed=1>`__."
msgstr ""
"`ລາຍລະອຽດການປ່ຽນແປງທັງໝົດ <https://github.com/WeblateOrg/weblate/milestone/75?"
"closed=1>`__."

msgid ""
"The implementation of :ref:`manage-acl` has changed, removing the project "
"prefix from the group names. This affects API users."
msgstr ""
"ການຈັດຕັ້ງປະຕິບັດ :ref:`manage-acl` ໄດ້ປ່ຽນແປງ, ໂດຍການລຶບຄຳນຳໜ້າໂຄງການອອກຈາກຊື່ກຸ່ມ. "
"ສິ່ງນີ້ສົ່ງຜົນກະທົບຕໍ່ຜູ້ໃຊ້ API."

msgid ""
"Weblate now uses ``charset-normalizer`` instead of ``chardet`` module for "
"character set detection."
msgstr ""
"Weblate ຕອນນີ້ໃຊ້ ``charset-normalizer`` ແທນໂມດູນ ``chardet`` "
"ສຳລັບການກວດຫາຊຸດຕົວອັກສອນ."

msgid ""
"**Changed in 4.11.1:** There is a change in ``REST_FRAMEWORK`` setting "
"(removal of one of the backends in ``DEFAULT_AUTHENTICATION_CLASSES``)."
msgstr ""
"**ປ່ຽນແປງໃນ 4.11.1:** ມີການປ່ຽນແປງໃນການຕັ້ງຄ່າ ``REST_FRAMEWORK`` (ການລຶບໜຶ່ງໃນ "
"backend ໃນ ``DEFAULT_AUTHENTICATION_CLASSES``)."

msgid "Weblate 4.10.1"
msgstr "Weblate 4.10.1"

msgid "*Released on December 22nd 2021.*"
msgstr "*ອອກຈຳໜ່າຍເມື່ອວັນທີ 22 ທັນວາ 2021.*"

msgid "Documented changes introduced by upgrading to Django 4.0."
msgstr "ບັນທຶກການປ່ຽນແປງທີ່ນຳສະເໜີໂດຍການອັບເກຣດເປັນ Django 4.0."

msgid "Fixed displaying of :guilabel:`Automatically translated` label."
msgstr "ແກ້ໄຂການສະແດງປ້າຍ :guilabel:`Automatically translated`."

msgid "Fixed API display of branch in components with a shared repository."
msgstr "ແກ້ໄຂການສະແດງ API ຂອງສາຂາໃນອົງປະກອບທີ່ມີບ່ອນເກັບຂໍ້ມູນຮ່ວມກັນ."

msgid "Improved analysis on the failed push alert."
msgstr "ປັບປຸງການວິເຄາະໃນການແຈ້ງເຕືອນການ push ລົ້ມເຫຼວ."

msgid "Fixed manually editing page when browsing changes."
msgstr "ແກ້ໄຂໜ້າການແກ້ໄຂດ້ວຍຕົນເອງໃນເວລາຊອກຫາການປ່ຽນແປງ."

msgid "Improved accuracy of :ref:`check-kashida`."
msgstr "ປັບປຸງຄວາມຖືກຕ້ອງຂອງ :ref:`check-kashida`."

msgid "The Weblate Docker container now uses Python 3.10."
msgstr "Weblate Docker container ຕອນນີ້ໃຊ້ Python 3.10."

msgid ""
"`All changes in detail <https://github.com/WeblateOrg/weblate/milestone/76?"
"closed=1>`__."
msgstr ""
"`ລາຍລະອຽດການປ່ຽນແປງທັງໝົດ <https://github.com/WeblateOrg/weblate/milestone/76?"
"closed=1>`__."

msgid "Weblate 4.10"
msgstr "Weblate 4.10"

msgid "*Released on December 16th 2021.*"
msgstr "*ອອກຈຳໜ່າຍເມື່ອວັນທີ 16 ທັນວາ 2021.*"

msgid "Added support for formality and placeholders with DeepL."
msgstr "ເພີ່ມການຮອງຮັບຄວາມເປັນທາງການ ແລະ placeholder ກັບ DeepL."

msgid ""
"Bulk edit and search-and-replace are now available on project and language "
"level."
msgstr "ການແກ້ໄຂແບບກຸ່ມ ແລະ ການຊອກຫາ-ແລະ-ແທນທີ່ ຕອນນີ້ມີໃຫ້ໃຊ້ໃນລະດັບໂຄງການ ແລະ ພາສາ."

msgid "Added filtering to search and replace."
msgstr "ເພີ່ມການກັ່ນຕອງໃຫ້ກັບການຊອກຫາ ແລະ ແທນທີ່."

msgid ""
"Fixed: \"Perform automatic translation\" privilege is no longer part of the "
"*Languages* group."
msgstr ""
"ແກ້ໄຂ: ສິດ \"Perform automatic translation\" ບໍ່ໄດ້ເປັນສ່ວນໜຶ່ງຂອງກຸ່ມ *Languages* "
"ອີກຕໍ່ໄປ."

msgid ""
"\"Perform automatic translation\" is in the *Administration* and the new "
"*Automatic translation* group."
msgstr ""
"\"Perform automatic translation\" ຢູ່ໃນກຸ່ມ *Administration* ແລະ ກຸ່ມ *Automatic "
"translation* ໃໝ່."

msgid "Fixed generating XLSX files with special chars."
msgstr "ແກ້ໄຂການສ້າງໄຟລ໌ XLSX ທີ່ມີຕົວອັກສອນພິເສດ."

msgid ""
"Added ability to the GitHub authentication backend to check if the user "
"belongs to a specific GitHub organization or team."
msgstr ""
"ເພີ່ມຄວາມສາມາດໃຫ້ກັບ GitHub authentication backend "
"ເພື່ອກວດສອບວ່າຜູ້ໃຊ້ເປັນສະມາຊິກຂອງອົງກອນ ຫຼື ທີມໃດໜຶ່ງຂອງ GitHub ຫຼື ບໍ່."

msgid "Improved feedback on invalid parameters passed to API."
msgstr "ປັບປຸງການຕອບກັບກ່ຽວກັບອາກິວເມັນທີ່ບໍ່ຖືກຕ້ອງທີ່ສົ່ງໄປຍັງ API."

msgid "Added support for project scoped access tokens for API."
msgstr "ເພີ່ມການຮອງຮັບ token ການເຂົ້າເຖິງໃນຂອບເຂດໂຄງການສຳລັບ API."

msgid "Fixed string removal in some cases."
msgstr "ແກ້ໄຂການລຶບຂໍ້ຄວາມໃນບາງກໍລະນີ."

msgid "Fixed translating newly added strings."
msgstr "ແກ້ໄຂການແປຂໍ້ຄວາມທີ່ເພີ່ມໃໝ່."

msgid "Label automatically translated strings to ease their filtering."
msgstr "ຕິດປ້າຍຂໍ້ຄວາມທີ່ແປໂດຍອັດຕະໂນມັດເພື່ອເຮັດໃຫ້ການກັ່ນຕອງງ່າຍຂຶ້ນ."

msgid ""
"`All changes in detail <https://github.com/WeblateOrg/weblate/milestone/74?"
"closed=1>`__."
msgstr ""
"`ລາຍລະອຽດການປ່ຽນແປງທັງໝົດ <https://github.com/WeblateOrg/weblate/milestone/74?"
"closed=1>`__."

msgid ""
"There is a change in per-project groups, the upgrade can take long time on "
"sites with thousands of projects."
msgstr "ມີການປ່ຽນແປງໃນກຸ່ມຕໍ່ໂຄງການ, ການອັບເກຣດອາດໃຊ້ເວລາດົນໃນເວັບໄຊທີ່ມີໂຄງການຫຼາຍພັນໂຄງການ."

msgid ""
"Django 4.0 has made some incompatible changes, see :ref:`django:backwards-"
"incompatible-4.0`. Weblate still supports Django 3.2 for now, in case any of "
"these are problematic. Most notable changes which might affect Weblate:"
msgstr ""
"Django 4.0 ໄດ້ມີການປ່ຽນແປງບາງຢ່າງທີ່ບໍ່ສາມາດເຂົ້າກັນໄດ້, ເບິ່ງ :ref:`django:backwards-"
"incompatible-4.0`. Weblate ຍັງຮອງຮັບ Django 3.2 ໃນຕອນນີ້, "
"ໃນກໍລະນີທີ່ການປ່ຽນແປງເຫຼົ່ານີ້ມີບັນຫາ. ການປ່ຽນແປງທີ່ໂດດເດັ່ນທີ່ສຸດທີ່ອາດສົ່ງຜົນກະທົບຕໍ່ Weblate:"

msgid ""
"Dropped support for PostgreSQL 9.6, Django 4.0 supports PostgreSQL 10 and "
"higher."
msgstr ""
"ຍົກເລີກການຮອງຮັບ PostgreSQL 9.6, Django 4.0 ຮອງຮັບ PostgreSQL 10 ແລະ ສູງກວ່າ."

msgid "Format of :setting:`django:CSRF_TRUSTED_ORIGINS` was changed."
msgstr "ຮູບແບບຂອງ :setting:`django:CSRF_TRUSTED_ORIGINS` ໄດ້ຖືກປ່ຽນແປງ."

msgid "The Docker container now uses Django 4.0, see above for changes."
msgstr "Docker container ຕອນນີ້ໃຊ້ Django 4.0, ເບິ່ງຂ້າງເທິງສຳລັບການປ່ຽນແປງ."

msgid "Weblate 4.9.1"
msgstr "Weblate 4.9.1"

msgid "*Released on November 19th 2021.*"
msgstr "*ອອກຈຳໜ່າຍເມື່ອວັນທີ 19 ພະຈິກ 2021.*"

msgid "Fixed upload of monolingual files after changing template."
msgstr "ແກ້ໄຂການອັບໂຫຼດໄຟລ໌ພາສາດຽວຫຼັງຈາກປ່ຽນແມ່ແບບ."

msgid "Improved handling of whitespace in flags."
msgstr "ປັບປຸງການຈັດການຊ່ອງຫວ່າງໃນທຸງ."

msgid "Add support for filtering in download API."
msgstr "ເພີ່ມການຮອງຮັບການກັ່ນຕອງໃນ API ດາວໂຫຼດ."

msgid "Fixed statistics display when adding new translations."
msgstr "ແກ້ໄຂການສະແດງສະຖິຕິເມື່ອເພີ່ມຄຳແປໃໝ່."

msgid "Mitigate issues with GitHub SSH key change."
msgstr "ຫຼຸດຜ່ອນບັນຫາກ່ຽວກັບການປ່ຽນແປງ SSH key ຂອງ GitHub."

msgid ""
"`All changes in detail <https://github.com/WeblateOrg/weblate/milestone/73?"
"closed=1>`__."
msgstr ""
"`ລາຍລະອຽດການປ່ຽນແປງທັງໝົດ <https://github.com/WeblateOrg/weblate/milestone/73?"
"closed=1>`__."

msgid "Weblate 4.9"
msgstr "Weblate 4.9"

msgid "*Released on November 10th 2021.*"
msgstr "*ອອກຈຳໜ່າຍເມື່ອວັນທີ 10 ພະຈິກ 2021.*"

msgid "Provide more details for events in history."
msgstr "ໃຫ້ລາຍລະອຽດເພີ່ມເຕີມສຳລັບເຫດການໃນປະຫວັດ."

msgid "Improved rendering of history."
msgstr "ປັບປຸງການສະແດງປະຫວັດ."

msgid "Improved performance of the translation pages."
msgstr "ປັບປຸງປະສິດທິພາບຂອງໜ້າການແປ."

msgid "Added support for restricting translation file downloads."
msgstr "ເພີ່ມການຮອງຮັບການຈຳກັດການດາວໂຫຼດໄຟລ໌ແປ."

msgid ""
"The ``safe-html`` can now understand Markdown when used with ``md-text``."
msgstr "``safe-html`` ຕອນນີ້ສາມາດເຂົ້າໃຈ Markdown ເມື່ອໃຊ້ກັບ ``md-text``."

msgid ""
"The ``max-length`` tag now ignores XML markup when used with ``xml-text``."
msgstr "ແທັກ ``max-length`` ຕອນນີ້ບໍ່ສົນໃຈ XML markup ເມື່ອໃຊ້ກັບ ``xml-text``."

msgid "Fixed dimensions of rendered texts in :ref:`check-max-size`."
msgstr "ແກ້ໄຂຂະໜາດຂອງຂໍ້ຄວາມທີ່ສະແດງໃນ :ref:`check-max-size`."

msgid ""
"Lowered app store title length to 30 to assist with upcoming Google policy "
"changes."
msgstr ""
"ຫຼຸດຄວາມຍາວຫົວຂໍ້ App Store ເຫຼືອ 30 ເພື່ອຊ່ວຍເຫຼືອການປ່ຽນແປງນະໂຍບາຍຂອງ Google ທີ່ຈະມາເຖິງ."

msgid ""
"Added support for customizing SSH invocation via :setting:`SSH_EXTRA_ARGS`."
msgstr "ເພີ່ມການຮອງຮັບການປັບແຕ່ງການເອີ້ນໃຊ້ SSH ຜ່ານ :setting:`SSH_EXTRA_ARGS`."

msgid "Added checks for ICU MessageFormat."
msgstr "ເພີ່ມການກວດສອບສຳລັບ ICU MessageFormat."

msgid "Improved error condition handling in machine translation backends."
msgstr "ປັບປຸງການຈັດການເງື່ອນໄຂຂໍ້ຜິດພາດໃນ backend ຂອງການແປພາສາດ້ວຍເຄື່ອງຈັກ."

msgid "Highlight unusual whitespace characters in the strings."
msgstr "ເນັ້ນຕົວອັກສອນຊ່ອງຫວ່າງທີ່ຜິດປົກກະຕິໃນຂໍ້ຄວາມ."

msgid "Added option to stay on translated string while editing."
msgstr "ເພີ່ມຕົວເລືອກໃຫ້ຢູ່ໃນຂໍ້ຄວາມທີ່ແປແລ້ວໃນຂະນະແກ້ໄຂ."

msgid ""
"Added support for customizing Borg invocation via :setting:`BORG_EXTRA_ARGS`."
msgstr "ເພີ່ມການຮອງຮັບການປັບແຕ່ງການເອີ້ນໃຊ້ Borg ຜ່ານ :setting:`BORG_EXTRA_ARGS`."

msgid "Fixed generating of MO files for monolingual translations."
msgstr "ແກ້ໄຂການສ້າງໄຟລ໌ MO ສຳລັບການແປພາສາດຽວ."

msgid ""
"Added API endpoint to download all component translations as a ZIP file."
msgstr "ເພີ່ມ API endpoint ເພື່ອດາວໂຫຼດຄຳແປອົງປະກອບທັງໝົດເປັນໄຟລ໌ ZIP."

msgid "Added support for Python 3.10."
msgstr "ເພີ່ມການຮອງຮັບ Python 3.10."

msgid ""
"Added support for resending e-mail invitation from the management interface."
msgstr "ເພີ່ມການຮອງຮັບການສົ່ງອີເມວເຊີນຄືນໃໝ່ຈາກອິນເຕີເຟດການຈັດການ."

msgid ""
"`All changes in detail <https://github.com/WeblateOrg/weblate/milestone/71?"
"closed=1>`__."
msgstr ""
"`ລາຍລະອຽດການປ່ຽນແປງທັງໝົດ <https://github.com/WeblateOrg/weblate/milestone/71?"
"closed=1>`__."

msgid ""
"There is a change in storing metrics, the upgrade can take long time on "
"larger sites."
msgstr "ມີການປ່ຽນແປງໃນການຈັດເກັບເມທຣິກ, ການອັບເກຣດອາດໃຊ້ເວລາດົນໃນເວັບໄຊຂະໜາດໃຫຍ່."

msgid "Weblate 4.8.1"
msgstr "Weblate 4.8.1"

msgid "*Released on September 10th 2021.*"
msgstr "*ອອກຈຳໜ່າຍເມື່ອວັນທີ 10 ກັນຍາ 2021.*"

msgid "Fixed user removal in Django admin interface."
msgstr "ແກ້ໄຂການລຶບຜູ້ໃຊ້ໃນ Django admin interface."

msgid "Document add-on parameters in greater detail."
msgstr "ບັນທຶກອາກິວເມັນຂອງສ່ວນເສີມໃນລາຍລະອຽດທີ່ຫຼາຍຂຶ້ນ."

msgid "Fixed JavaScript error in glossary."
msgstr "ແກ້ໄຂຂໍ້ຜິດພາດ JavaScript ໃນຄຳສັບ."

msgid "Add limit to number of matches in consistency check."
msgstr "ເພີ່ມຂີດຈຳກັດໃຫ້ກັບຈຳນວນການຈັບຄູ່ໃນການກວດສອບຄວາມສອດຄ້ອງ."

msgid "Improve handling of placeholders in machine translations."
msgstr "ປັບປຸງການຈັດການ placeholder ໃນການແປພາສາດ້ວຍເຄື່ອງຈັກ."

msgid "Fixed creating add-ons using the API."
msgstr "ແກ້ໄຂການສ້າງສ່ວນເສີມໂດຍໃຊ້ API."

msgid ""
"Added :setting:`PRIVACY_URL` setting to add privacy policy link to the "
"footer."
msgstr ""
"ເພີ່ມການຕັ້ງຄ່າ :setting:`PRIVACY_URL` ເພື່ອເພີ່ມລິ້ງນະໂຍບາຍຄວາມເປັນສ່ວນຕົວໄປຍັງສ່ວນທ້າຍ."

msgid "Hide member e-mail addresses from project admins."
msgstr "ຊ່ອນທີ່ຢູ່ອີເມວສະມາຊິກຈາກຜູ້ດູແລໂຄງການ."

msgid "Improved gettext PO merging in case of conflicts."
msgstr "ປັບປຸງການລວມ gettext PO ໃນກໍລະນີທີ່ເກີດຄວາມຂັດແຍ່ງ."

msgid "Improved glossary highlighting."
msgstr "ປັບປຸງການເນັ້ນຄຳສັບ."

msgid "Improved ``safe-html`` flag behavior with XML checks."
msgstr "ປັບປຸງພຶດຕິກຳຂອງທຸງ ``safe-html`` ກັບການກວດສອບ XML."

msgid "Fixed commit messages for linked components."
msgstr "ແກ້ໄຂຂໍ້ຄວາມ commit ສຳລັບອົງປະກອບທີ່ເຊື່ອມໂຍງ."

msgid ""
"`All changes in detail <https://github.com/WeblateOrg/weblate/milestone/70?"
"closed=1>`__."
msgstr ""
"`ລາຍລະອຽດການປ່ຽນແປງທັງໝົດ <https://github.com/WeblateOrg/weblate/milestone/70?"
"closed=1>`__."

msgid "Weblate 4.8"
msgstr "Weblate 4.8"

msgid "*Released on August 21th 2021.*"
msgstr "*ອອກຈຳໜ່າຍເມື່ອວັນທີ 21 ສິງຫາ 2021.*"

msgid "Added support for Apple stringsdict format."
msgstr "ເພີ່ມການຮອງຮັບຮູບແບບ Apple stringsdict."

msgid "The exact search operator is now case-sensitive with PostgreSQL."
msgstr "ຕົວດຳເນີນການຄົ້ນຫາທີ່ແນ່ນອນ ຕອນນີ້ເປັນແບບລະອຽດຕໍ່ຕົວພິມນ້ອຍ-ໃຫຍ່ກັບ PostgreSQL."

msgid "Fixed saving glossary explanations in some cases."
msgstr "ແກ້ໄຂການບັນທຶກຄຳອະທິບາຍຄຳສັບໃນບາງກໍລະນີ."

msgid "Fixed adding strings to monolingual glossary components."
msgstr "ແກ້ໄຂການເພີ່ມຂໍ້ຄວາມໄປຍັງອົງປະກອບຄຳສັບພາສາດຽວ."

msgid "Improved performance in handling variants."
msgstr "ປັບປຸງປະສິດທິພາບໃນການຈັດການຕົວເລືອກຕ່າງໆ."

msgid "Fixed squash add-on sometimes skipping parsing upstream changes."
msgstr "ແກ້ໄຂສ່ວນເສີມ squash ທີ່ບາງຄັ້ງຂ້າມການແຍກວິເຄາະການປ່ຽນແປງອັບສະຕຣີມ."

msgid "Preserve file extension for downloads."
msgstr "ຮັກສານາມສະກຸນໄຟລ໌ໄວ້ສຳລັບການດາວໂຫຼດ."

msgid "Added support for the Fluent format."
msgstr "ເພີ່ມການຮອງຮັບຮູບແບບ Fluent."

msgid "Added support for using tabs to indent JSON formats."
msgstr "ເພີ່ມການຮອງຮັບການໃຊ້ແຖບເພື່ອຍະຫ່າງຮູບແບບ JSON."

msgid ""
"`All changes in detail <https://github.com/WeblateOrg/weblate/milestone/67?"
"closed=1>`__."
msgstr ""
"`ລາຍລະອຽດການປ່ຽນແປງທັງໝົດ <https://github.com/WeblateOrg/weblate/milestone/67?"
"closed=1>`__."

msgid "There are no additional upgrade steps needed in this release."
msgstr "ບໍ່ມີຂັ້ນຕອນການອັບເກຣດເພີ່ມເຕີມທີ່ຈຳເປັນໃນການປ່ອຍນີ້."

msgid "Weblate 4.7.2"
msgstr "Weblate 4.7.2"

msgid "*Released on July 15th 2021.*"
msgstr "*ອອກຈຳໜ່າຍເມື່ອວັນທີ 15 ກໍລະກົດ 2021.*"

msgid "Support more language aliases to be configured on a project."
msgstr "ຮອງຮັບນາມແຝງພາສາເພີ່ມເຕີມເພື່ອຕັ້ງຄ່າໃນໂຄງການ."

msgid "Fixed search string validation in API."
msgstr "ແກ້ໄຂການກວດສອບຄວາມຖືກຕ້ອງຂອງຂໍ້ຄວາມຄົ້ນຫາໃນ API."

msgid "Fixed Git exporter URLs after a domain change."
msgstr "ແກ້ໄຂ URL ຂອງ Git exporter ຫຼັງຈາກການປ່ຽນແປງໂດເມນ."

msgid "Fixed cleanup add-on for Windows RC files."
msgstr "ແກ້ໄຂສ່ວນເສີມທຳຄວາມສະອາດສຳລັບໄຟລ໌ Windows RC."

msgid "Fixed possible crash in XLIFF updating."
msgstr "ແກ້ໄຂການຂັດຂ້ອງທີ່ອາດເກີດຂຶ້ນໃນການອັບເດດ XLIFF."

msgid ""
"`All changes in detail <https://github.com/WeblateOrg/weblate/milestone/69?"
"closed=1>`__."
msgstr ""
"`ລາຍລະອຽດການປ່ຽນແປງທັງໝົດ <https://github.com/WeblateOrg/weblate/milestone/69?"
"closed=1>`__."

msgid "Weblate 4.7.1"
msgstr "Weblate 4.7.1"

msgid "*Released on June 30th 2021.*"
msgstr "*ອອກຈຳໜ່າຍເມື່ອວັນທີ 30 ມິຖຸນາ 2021.*"

msgid "Improved popup for adding terms to glossary."
msgstr "ປັບປຸງປັອບອັບສຳລັບການເພີ່ມຄຳສັບໄປຍັງຄຳສັບ."

msgid "Added support for LibreTranslate machine translation service."
msgstr "ເພີ່ມການຮອງຮັບບໍລິການແປພາສາດ້ວຍເຄື່ອງຈັກ LibreTranslate."

msgid "Added rate limiting on creating new projects."
msgstr "ເພີ່ມການຈຳກັດອັດຕາໃນການສ້າງໂຄງການໃໝ່."

msgid "Improved performance of file updates."
msgstr "ປັບປຸງປະສິດທິພາບຂອງການອັບເດດໄຟລ໌."

msgid ""
"`All changes in detail <https://github.com/WeblateOrg/weblate/milestone/68?"
"closed=1>`__."
msgstr ""
"`ລາຍລະອຽດການປ່ຽນແປງທັງໝົດ <https://github.com/WeblateOrg/weblate/milestone/68?"
"closed=1>`__."

msgid "Weblate 4.7"
msgstr "Weblate 4.7"

msgid "*Released on June 17th 2021.*"
msgstr "*ອອກຈຳໜ່າຍເມື່ອວັນທີ 17 ມິຖຸນາ 2021.*"

msgid "Improved configuration health check."
msgstr "ປັບປຸງການກວດສອບສຸຂະພາບການຕັ້ງຄ່າ."

msgid ""
"Added support for ``object-pascal-format`` used in gettext PO, "
"see :ref:`check-object-pascal-format`."
msgstr ""
"ເພີ່ມການຮອງຮັບ ``object-pascal-format`` ທີ່ໃຊ້ໃນ gettext PO, ເບິ່ງ :ref:`check-"
"object-pascal-format`."

msgid ""
"Renamed :guilabel:`Nearby keys` to :guilabel:`Similar keys` to better "
"describe the purpose."
msgstr ""
"ປ່ຽນຊື່ :guilabel:`Nearby keys` ເປັນ :guilabel:`Similar keys` "
"ເພື່ອອະທິບາຍຈຸດປະສົງໄດ້ດີຂຶ້ນ."

msgid "Added support for :ref:`mi18n-lang`."
msgstr "ເພີ່ມການຮອງຮັບ :ref:`mi18n-lang`."

msgid "Improved SAML authentication integration."
msgstr "ປັບປຸງການເຊື່ອມໂຍງການຢືນຢັນຕົວຕົນແບບ SAML."

msgid ""
"Fixed :ref:`code-hosting-gerrit` integration to better handle corner cases."
msgstr "ແກ້ໄຂການເຊື່ອມໂຍງ :ref:`code-hosting-gerrit` ເພື່ອຈັດການກໍລະນີພິເສດໄດ້ດີຂຶ້ນ."

msgid "Weblate now requires Django 3.2."
msgstr "Weblate ຕອນນີ້ຕ້ອງການ Django 3.2."

msgid "Fixed inviting users when e-mail authentication is disabled."
msgstr "ແກ້ໄຂການເຊີນຜູ້ໃຊ້ເມື່ອການຢືນຢັນຕົວຕົນທາງອີເມວຖືກປິດໃຊ້ງານ."

msgid "Improved language definitions."
msgstr "ປັບປຸງຄຳນິຍາມພາສາ."

msgid "Added support for blocking users from contributing to a project."
msgstr "ເພີ່ມການຮອງຮັບການບລັອກຜູ້ໃຊ້ຈາກການປະກອບສ່ວນໃຫ້ກັບໂຄງການ."

msgid "Fixed automatic creation of glossary languages."
msgstr "ແກ້ໄຂການສ້າງພາສາຄຳສັບໂດຍອັດຕະໂນມັດ."

msgid "Extended documentation about add-ons."
msgstr "ຂະຫຍາຍເອກະສານກ່ຽວກັບສ່ວນເສີມ."

msgid "Performance improvements for components with linked repositories."
msgstr "ປັບປຸງປະສິດທິພາບສຳລັບອົງປະກອບທີ່ມີບ່ອນເກັບຂໍ້ມູນທີ່ເຊື່ອມໂຍງ."

msgid "Added support for free DeepL API."
msgstr "ເພີ່ມການຮອງຮັບ DeepL API ຟຣີ."

msgid "The user management no longer needs Django admin interface."
msgstr "ການຈັດການຜູ້ໃຊ້ບໍ່ຈຳເປັນຕ້ອງໃຊ້ Django admin interface ອີກຕໍ່ໄປ."

msgid ""
"`All changes in detail <https://github.com/WeblateOrg/weblate/milestone/64?"
"closed=1>`__."
msgstr ""
"`ລາຍລະອຽດການປ່ຽນແປງທັງໝົດ <https://github.com/WeblateOrg/weblate/milestone/64?"
"closed=1>`__."

msgid "Notable configuration or dependencies changes:"
msgstr "ການປ່ຽນແປງການຕັ້ງຄ່າ ຫຼື ການເພິ່ງພາອາໄສທີ່ໂດດເດັ່ນ:"

msgid ""
"There are several changes in :file:`settings_example.py`, most notable "
"middleware changes (:setting:`django:MIDDLEWARE`), please adjust your "
"settings accordingly."
msgstr ""
"ມີການປ່ຽນແປງຫຼາຍຢ່າງໃນ :file:`settings_example.py`, ການປ່ຽນແປງ middleware "
"ທີ່ໂດດເດັ່ນທີ່ສຸດ (:setting:`django:MIDDLEWARE`), ກະລຸນາປັບການຕັ້ງຄ່າຂອງທ່ານຕາມຄວາມເໝາະສົມ."

msgid ""
"The :ref:`mt-deepl` machine translation now has a generic "
"``MT_DEEPL_API_URL`` setting to adapt to different subscription models more "
"flexibly. The ``MT_DEEPL_API_VERSION`` setting is no longer used."
msgstr ""
"ການແປພາສາດ້ວຍເຄື່ອງຈັກ :ref:`mt-deepl` ຕອນນີ້ມີການຕັ້ງຄ່າ ``MT_DEEPL_API_URL`` "
"ແບບທົ່ວໄປເພື່ອປັບຕົວໃຫ້ເຂົ້າກັບຮູບແບບການສະໝັກໃຊ້ທີ່ແຕກຕ່າງກັນໄດ້ຢ່າງຍືດຫຍຸ່ນຫຼາຍຂຶ້ນ. ການຕັ້ງຄ່າ "
"``MT_DEEPL_API_VERSION`` ບໍ່ໄດ້ຖືກນຳໃຊ້ແລ້ວ."

msgid "Django 3.2 is now required."
msgstr "Django 3.2 ແມ່ນຕ້ອງການຕອນນີ້."

msgid "Weblate 4.6.2"
msgstr "Weblate 4.6.2"

msgid "*Released on May 8th 2021.*"
msgstr "*ອອກຈຳໜ່າຍເມື່ອວັນທີ 8 ພຶດສະພາ 2021.*"

msgid "Fixed crash after moving shared component between projects."
msgstr "ແກ້ໄຂການຂັດຂ້ອງຫຼັງຈາກຍ້າຍອົງປະກອບຮ່ວມກັນລະຫວ່າງໂຄງການ."

msgid "Fixed adding new strings to empty properties files."
msgstr "ແກ້ໄຂການເພີ່ມຂໍ້ຄວາມໃໝ່ໄປຍັງໄຟລ໌ properties ທີ່ຫວ່າງເປົ່າ."

msgid "Fixed copy icon alignment in RTL languages."
msgstr "ແກ້ໄຂການຈັດວາງໄອຄອນສຳເນົາໃນພາສາ RTL."

msgid "Extended string statistics on the Info tab."
msgstr "ຂະຫຍາຍສະຖິຕິຂໍ້ຄວາມໃນແຖບຂໍ້ມູນ."

msgid "Fixed handling of translation files ignored in Git."
msgstr "ແກ້ໄຂການຈັດການໄຟລ໌ແປທີ່ຖືກລະເລີຍໃນ Git."

msgid "Improved metrics performance."
msgstr "ປັບປຸງປະສິດທິພາບເມທຣິກ."

msgid "Fixed possible bug in saving glossaries."
msgstr "ແກ້ໄຂຂໍ້ຜິດພາດທີ່ອາດເກີດຂຶ້ນໃນການບັນທຶກຄຳສັບ."

msgid ""
"Fixed consistency check behavior on languages with different plural rules."
msgstr "ແກ້ໄຂພຶດຕິກຳການກວດສອບຄວາມສອດຄ້ອງໃນພາສາທີ່ມີກົດລະບຽບພະຫຸພົດທີ່ແຕກຕ່າງກັນ."

msgid ""
"`All changes in detail <https://github.com/WeblateOrg/weblate/milestone/66?"
"closed=1>`__."
msgstr ""
"`ລາຍລະອຽດການປ່ຽນແປງທັງໝົດ <https://github.com/WeblateOrg/weblate/milestone/66?"
"closed=1>`__."

msgid "Weblate 4.6.1"
msgstr "Weblate 4.6.1"

msgid "*Released on May 2nd 2021.*"
msgstr "*ອອກຈຳໜ່າຍເມື່ອວັນທີ 2 ພຶດສະພາ 2021.*"

msgid "Remove obsolete spam protection code."
msgstr "ລຶບລະຫັດປ້ອງກັນສະແປມທີ່ລ້າສະໄໝ."

msgid "Improve source plural check accuracy."
msgstr "ປັບປຸງຄວາມຖືກຕ້ອງຂອງການກວດສອບພະຫຸພົດຕົ້ນສະບັບ."

msgid "Update list of user interface languages in Docker."
msgstr "ອັບເດດລາຍການພາສາອິນເຕີເຟດຜູ້ໃຊ້ໃນ Docker."

msgid "Improved error messages when creating pull requests."
msgstr "ປັບປຸງຂໍ້ຄວາມຂໍ້ຜິດພາດເມື່ອສ້າງ pull requests."

msgid "Fixed creating pull requests on Pagure."
msgstr "ແກ້ໄຂການສ້າງ pull requests ໃນ Pagure."

msgid "Fixed triggering automatically installed add-ons."
msgstr "ແກ້ໄຂການກະຕຸ້ນສ່ວນເສີມທີ່ຕິດຕັ້ງໂດຍອັດຕະໂນມັດ."

msgid "Fixed possible caching issues on upgrade."
msgstr "ແກ້ໄຂບັນຫາການແຄຊທີ່ອາດເກີດຂຶ້ນເມື່ອອັບເກຣດ."

msgid "Fixed adding new units to monolingual translations using upload."
msgstr "ແກ້ໄຂການເພີ່ມຫົວໜ່ວຍໃໝ່ໄປຍັງການແປພາສາດຽວໂດຍໃຊ້ການອັບໂຫຼດ."

msgid ""
"`All changes in detail <https://github.com/WeblateOrg/weblate/milestone/65?"
"closed=1>`__."
msgstr ""
"`ລາຍລະອຽດການປ່ຽນແປງທັງໝົດ <https://github.com/WeblateOrg/weblate/milestone/65?"
"closed=1>`__."

msgid "Weblate 4.6"
msgstr "Weblate 4.6"

msgid "*Released on April 19th 2021.*"
msgstr "*ອອກຈຳໜ່າຍເມື່ອວັນທີ 19 ເມສາ 2021.*"

msgid ""
"The auto_translate management command has now a parameter for specifying "
"translation mode."
msgstr "ຄຳສັ່ງການຈັດການ auto_translate ຕອນນີ້ມີອາກິວເມັນສຳລັບການກຳນົດໂໝດການແປ."

msgid "Added support for :ref:`txt`."
msgstr "ເພີ່ມການຮອງຮັບ :ref:`txt`."

msgid "Added trends and metrics for all objects."
msgstr "ເພີ່ມແນວໂນ້ມ ແລະ ເມທຣິກສຳລັບທຸກວັດຖຸ."

msgid "Added support for directly copying text from secondary languages."
msgstr "ເພີ່ມການຮອງຮັບການຄັດລອກຂໍ້ຄວາມໂດຍກົງຈາກພາສາຮອງ."

msgid "Added date filtering when browsing changes."
msgstr "ເພີ່ມການກັ່ນຕອງວັນທີເມື່ອຊອກຫາການປ່ຽນແປງ."

msgid "Improved activity charts."
msgstr "ປັບປຸງແຜນພູມກິດຈະກຳ."

msgid "Sender for contact form e-mails can now be configured."
msgstr "ຜູ້ສົ່ງສຳລັບອີເມວແບບຟອມຕິດຕໍ່ສາມາດຕັ້ງຄ່າໄດ້."

msgid "Improved parameters validation in component creation API."
msgstr "ປັບປຸງການກວດສອບອາກິວເມັນໃນ API ການສ້າງອົງປະກອບ."

msgid "The rate limiting no longer applies to superusers."
msgstr "ການຈຳກັດອັດຕາບໍ່ນຳໃຊ້ກັບຜູ້ໃຊ້ສູງສຸດອີກຕໍ່ໄປ."

msgid "Improved automatic translation add-on performance and reliability."
msgstr "ປັບປຸງປະສິດທິພາບ ແລະ ຄວາມໜ້າເຊື່ອຖືຂອງສ່ວນເສີມການແປພາສາອັດຕະໂນມັດ."

msgid "The rate limiting now can be customized in the Docker container."
msgstr "ການຈຳກັດອັດຕາຕອນນີ້ສາມາດປັບແຕ່ງໄດ້ໃນ Docker container."

msgid ""
"API for creating components now automatically uses :ref:`internal-urls`."
msgstr "API ສຳລັບການສ້າງອົງປະກອບຕອນນີ້ໃຊ້ :ref:`internal-urls` ໂດຍອັດຕະໂນມັດ."

msgid "Simplified state indication while listing strings."
msgstr "ເຮັດໃຫ້ຕົວຊີ້ບອກສະຖານະງ່າຍຂຶ້ນໃນຂະນະສະແດງລາຍການຂໍ້ຄວາມ."

msgid "Password hashing now uses Argon2 by default."
msgstr "ການແຮຊລະຫັດຜ່ານຕອນນີ້ໃຊ້ Argon2 ໂດຍຄ່າເລີ່ມຕົ້ນ."

msgid "Simplified progress bars indicating translation status."
msgstr "ເຮັດໃຫ້ແຖບຄວາມຄືບໜ້າສະແດງສະຖານະການແປງ່າຍຂຶ້ນ."

msgid ""
"Renamed :ref:`addon-weblate.consistency.languages` to clarify the purpose."
msgstr ""
"ປ່ຽນຊື່ :ref:`addon-weblate.consistency.languages` ເພື່ອອະທິບາຍຈຸດປະສົງໃຫ້ຊັດເຈນ."

msgid "Fixed saving string state to XLIFF."
msgstr "ແກ້ໄຂການບັນທຶກສະຖານະຂໍ້ຄວາມໄປຍັງ XLIFF."

msgid "Added language-wide search."
msgstr "ເພີ່ມການຄົ້ນຫາທົ່ວພາສາ."

msgid "Initial support for :ref:`docker-scaling` the Docker deployment."
msgstr "ການຮອງຮັບເບື້ອງຕົ້ນສຳລັບ :ref:`docker-scaling` ການປັບຂະໜາດ Docker."

msgid ""
"`All changes in detail <https://github.com/WeblateOrg/weblate/milestone/61?"
"closed=1>`__."
msgstr ""
"`ລາຍລະອຽດການປ່ຽນແປງທັງໝົດ <https://github.com/WeblateOrg/weblate/milestone/61?"
"closed=1>`__."

msgid ""
"There are new file formats, you might want to include them in case you "
"modified the :setting:`WEBLATE_FORMATS`."
msgstr ""
"ມີຮູບແບບໄຟລ໌ໃໝ່, ທ່ານອາດຕ້ອງການລວມພວກມັນໄວ້ໃນກໍລະນີທີ່ທ່ານແກ້ໄຂ :setting:`WEBLATE_FORMATS`."

msgid ""
"API for creating components now automatically uses :ref:`internal-urls`, "
"see :http:post:`/api/projects/(string:project)/components/`."
msgstr ""
"API ສຳລັບການສ້າງອົງປະກອບຕອນນີ້ໃຊ້ :ref:`internal-urls` ໂດຍອັດຕະໂນມັດ, "
"ເບິ່ງ :http:post:`/api/projects/(string:project)/components/`."

msgid ""
"There is a change in dependencies and :setting:`django:PASSWORD_HASHERS` to "
"prefer Argon2 for passwords hashing."
msgstr ""
"ມີການປ່ຽນແປງໃນການເພິ່ງພາອາໄສ ແລະ :setting:`django:PASSWORD_HASHERS` "
"ເພື່ອໃຫ້ຄວາມສຳຄັນກັບ Argon2 ສຳລັບການແຮຊລະຫັດຜ່ານ."

msgid "Weblate 4.5.3"
msgstr "Weblate 4.5.3"

msgid "*Released on April 1st 2021.*"
msgstr "*ອອກຈຳໜ່າຍເມື່ອວັນທີ 1 ເມສາ 2021.*"

msgid "Fixed metrics collection."
msgstr "ແກ້ໄຂການເກັບເມທຣິກ."

msgid "Fixed possible crash when adding strings."
msgstr "ແກ້ໄຂການຂັດຂ້ອງທີ່ອາດເກີດຂຶ້ນເມື່ອເພີ່ມຂໍ້ຄວາມ."

msgid "Improved search query examples."
msgstr "ປັບປຸງຕົວຢ່າງການສອບຖາມຄົ້ນຫາ."

msgid "Fixed possible loss of newly added strings on replace upload."
msgstr "ແກ້ໄຂການສູນເສຍຂໍ້ຄວາມທີ່ເພີ່ມໃໝ່ທີ່ອາດເກີດຂຶ້ນໃນການອັບໂຫຼດແບບແທນທີ່."

msgid "Weblate 4.5.2"
msgstr "Weblate 4.5.2"

msgid "*Released on March 26th 2021.*"
msgstr "*ອອກຈຳໜ່າຍເມື່ອວັນທີ 26 ມີນາ 2021.*"

msgid "Configurable schedule for automatic translation."
msgstr "ຕາຕະລາງທີ່ຕັ້ງຄ່າໄດ້ສຳລັບການແປພາສາອັດຕະໂນມັດ."

msgid "Added Lua format check."
msgstr "ເພີ່ມການກວດສອບຮູບແບບ Lua."

msgid "Ignore format strings in the :ref:`check-duplicate` check."
msgstr "ລະເລີຍຂໍ້ຄວາມຮູບແບບໃນການກວດສອບ :ref:`check-duplicate`."

msgid "Allow uploading screenshot from a translate page."
msgstr "ອະນຸຍາດໃຫ້ອັບໂຫຼດຮູບພາບໜ້າຈໍຈາກໜ້າການແປ."

msgid "Added forced file synchronization to the repository maintenance."
msgstr "ເພີ່ມການຊິງຄ໌ໄຟລ໌ແບບບັງຄັບໃນການບຳລຸງຮັກສາບ່ອນເກັບຂໍ້ມູນ."

msgid "Fixed automatic suggestions for languages with a longer code."
msgstr "ແກ້ໄຂຄຳແນະນຳອັດຕະໂນມັດສຳລັບພາສາທີ່ມີລະຫັດຍາວ."

msgid "Improved performance when adding new strings."
msgstr "ປັບປຸງປະສິດທິພາບເມື່ອເພີ່ມຂໍ້ຄວາມໃໝ່."

msgid "Several bug fixes in quality checks."
msgstr "ການແກ້ໄຂຂໍ້ຜິດພາດຫຼາຍຢ່າງໃນການກວດສອບຄຸນນະພາບ."

msgid "Several performance improvements."
msgstr "ການປັບປຸງປະສິດທິພາບຫຼາຍຢ່າງ."

msgid "Added integration with :ref:`discover-weblate`."
msgstr "ເພີ່ມການເຊື່ອມໂຍງກັບ :ref:`discover-weblate`."

msgid "Fixed checks behavior with read-only strings."
msgstr "ແກ້ໄຂພຶດຕິກຳການກວດສອບກັບຂໍ້ຄວາມແບບອ່ານຢ່າງດຽວ."

msgid ""
"`All changes in detail <https://github.com/WeblateOrg/weblate/milestone/63?"
"closed=1>`__."
msgstr ""
"`ລາຍລະອຽດການປ່ຽນແປງທັງໝົດ <https://github.com/WeblateOrg/weblate/milestone/63?"
"closed=1>`__."

msgid "Weblate 4.5.1"
msgstr "Weblate 4.5.1"

msgid "*Released on March 5th 2021.*"
msgstr "*ອອກຈຳໜ່າຍເມື່ອວັນທີ 5 ມີນາ 2021.*"

msgid "Fixed editing of glossary flags in some corner cases."
msgstr "ແກ້ໄຂການແກ້ໄຂທຸງຄຳສັບໃນບາງກໍລະນີພິເສດ."

msgid "Extend metrics usage to improve performance of several pages."
msgstr "ຂະຫຍາຍການໃຊ້ເມທຣິກເພື່ອປັບປຸງປະສິດທິພາບຂອງຫຼາຍໜ້າ."

msgid "Store correct source language in TMX files."
msgstr "ຈັດເກັບພາສາຕົ້ນສະບັບທີ່ຖືກຕ້ອງໃນໄຟລ໌ TMX."

msgid "Better handling for uploads of monolingual PO using the API."
msgstr "ການຈັດການທີ່ດີຂຶ້ນສຳລັບການອັບໂຫຼດ PO ພາສາດຽວໂດຍໃຊ້ API."

msgid "Improved alerts behavior on glossary components."
msgstr "ປັບປຸງພຶດຕິກຳການແຈ້ງເຕືອນໃນອົງປະກອບຄຳສັບ."

msgid "Improved Markdown link checks."
msgstr "ປັບປຸງການກວດສອບລິ້ງ Markdown."

msgid "Indicate glossary and source language in breadcrumbs."
msgstr "ສະແດງຄຳສັບ ແລະ ພາສາຕົ້ນສະບັບໃນ breadcrumbs."

msgid "Paginated component listing of huge projects."
msgstr "ລາຍການອົງປະກອບແບບແບ່ງໜ້າຂອງໂຄງການຂະໜາດໃຫຍ່."

msgid "Improved performance of translation, component or project removal."
msgstr "ປັບປຸງປະສິດທິພາບຂອງການລຶບຄຳແປ, ອົງປະກອບ ຫຼື ໂຄງການ."

msgid "Improved bulk edit performance."
msgstr "ປັບປຸງປະສິດທິພາບການແກ້ໄຂແບບກຸ່ມ."

msgid ""
"Fixed preserving \"Needs editing\" and \"Approved\" states for ODF files."
msgstr "ແກ້ໄຂການຮັກສາສະຖານະ \"Needs editing\" ແລະ \"Approved\" ສຳລັບໄຟລ໌ ODF."

msgid "Improved interface for customizing translation-file downloads"
msgstr "ປັບປຸງອິນເຕີເຟດສຳລັບການປັບແຕ່ງການດາວໂຫຼດໄຟລ໌ແປ"

msgid ""
"`All changes in detail <https://github.com/WeblateOrg/weblate/milestone/62?"
"closed=1>`__."
msgstr ""
"`ລາຍລະອຽດການປ່ຽນແປງທັງໝົດ <https://github.com/WeblateOrg/weblate/milestone/62?"
"closed=1>`__."

msgid "Weblate 4.5"
msgstr "Weblate 4.5"

msgid "*Released on February 19th 2021.*"
msgstr "*ອອກຈຳໜ່າຍເມື່ອວັນທີ 19 ກຸມພາ 2021.*"

msgid "Added support for ``lua-format`` used in gettext PO."
msgstr "ເພີ່ມການຮອງຮັບ ``lua-format`` ທີ່ໃຊ້ໃນ gettext PO."

msgid "Added support for sharing a component between projects."
msgstr "ເພີ່ມການຮອງຮັບການແບ່ງປັນອົງປະກອບລະຫວ່າງໂຄງການ."

msgid ""
"Fixed multiple unnamed variables check behavior with multiple format flags."
msgstr "ແກ້ໄຂພຶດຕິກຳການກວດສອບຕົວປ່ຽນທີ່ບໍ່ມີຊື່ຫຼາຍຕົວດ້ວຍທຸງຮູບແບບຫຼາຍອັນ."

msgid ""
"Dropped mailing list field on the project in favor of generic instructions "
"for translators."
msgstr "ຍົກເລີກຊ່ອງລາຍຊື່ອີເມວໃນໂຄງການເພື່ອແທນທີ່ດ້ວຍຄຳແນະນຳທົ່ວໄປສຳລັບຜູ້ແປ."

msgid "Added pseudolocale generation add-on."
msgstr "ເພີ່ມສ່ວນເສີມການສ້າງ pseudolocale."

msgid "Added support for TermBase eXchange files."
msgstr "ເພີ່ມການຮອງຮັບໄຟລ໌ TermBase eXchange."

msgid "Added support for manually defining string variants using a flag."
msgstr "ເພີ່ມການຮອງຮັບການກຳນົດຕົວເລືອກຂໍ້ຄວາມດ້ວຍຕົນເອງໂດຍໃຊ້ທຸງ."

msgid "Improved performance of consistency checks."
msgstr "ປັບປຸງປະສິດທິພາບຂອງການກວດສອບຄວາມສອດຄ້ອງ."

msgid "Improved performance of translation memory for long strings."
msgstr "ປັບປຸງປະສິດທິພາບຂອງໜ່ວຍຄວາມຈຳການແປສຳລັບຂໍ້ຄວາມຍາວ."

msgid "Added support for searching in explanations."
msgstr "ເພີ່ມການຮອງຮັບການຄົ້ນຫາໃນຄຳອະທິບາຍ."

msgid "Strings can now be added and removed in bilingual formats as well."
msgstr "ຂໍ້ຄວາມຕອນນີ້ສາມາດເພີ່ມ ແລະ ລຶບໃນຮູບແບບສອງພາສາໄດ້ເຊັ່ນກັນ."

msgid ""
"Extend list of supported languages in Amazon Translate machine translation."
msgstr "ຂະຫຍາຍລາຍການພາສາທີ່ຮອງຮັບໃນການແປພາສາດ້ວຍເຄື່ອງຈັກ Amazon Translate."

msgid "Automatically enable Java MessageFormat checks for Java Properties."
msgstr "ເປີດໃຊ້ການກວດສອບ Java MessageFormat ໂດຍອັດຕະໂນມັດສຳລັບ Java Properties."

msgid "Added a new upload method to add new strings to a translation."
msgstr "ເພີ່ມວິທີການອັບໂຫຼດໃໝ່ເພື່ອເພີ່ມຂໍ້ຄວາມໃໝ່ໄປຍັງການແປ."

msgid "Added a simple interface to browse translation."
msgstr "ເພີ່ມອິນເຕີເຟດງ່າຍໆເພື່ອເບິ່ງການແປ."

msgid "Glossaries are now stored as regular components."
msgstr "ຄຳສັບຕອນນີ້ຖືກຈັດເກັບເປັນອົງປະກອບປົກກະຕິ."

msgid "Dropped specific API for glossaries as component API is used now."
msgstr "ຍົກເລີກ API ສະເພາະສຳລັບຄຳສັບ ເນື່ອງຈາກຕອນນີ້ໃຊ້ API ອົງປະກອບ."

msgid "Added simplified interface to toggle some of the flags."
msgstr "ເພີ່ມອິນເຕີເຟດແບບງ່າຍໆເພື່ອສະຫຼັບບາງທຸງ."

msgid "Added support for non-translatable or forbidden terms in the glossary."
msgstr "ເພີ່ມການຮອງຮັບຄຳສັບທີ່ບໍ່ສາມາດແປໄດ້ ຫຼື ຕ້ອງຫ້າມໃນຄຳສັບ."

msgid "Added support for defining terminology in a glossary."
msgstr "ເພີ່ມການຮອງຮັບການກຳນົດຄຳສັບໃນຄຳສັບ."

msgid "Moved text direction toggle to get more space for the visual keyboard."
msgstr "ຍ້າຍຕົວສະຫຼັບທິດທາງຂໍ້ຄວາມເພື່ອໃຫ້ມີພື້ນທີ່ສຳລັບແປ້ນພິມພາບຫຼາຍຂຶ້ນ."

msgid "Added option to automatically watch projects user-contributed to."
msgstr "ເພີ່ມຕົວເລືອກໃຫ້ຕິດຕາມໂຄງການທີ່ຜູ້ໃຊ້ມີສ່ວນຮ່ວມໂດຍອັດຕະໂນມັດ."

msgid "Added check whether translation matches the glossary."
msgstr "ເພີ່ມການກວດສອບວ່າຄຳແປກົງກັບຄຳສັບຫຼືບໍ່."

msgid "Added support for customizing navigation text color."
msgstr "ເພີ່ມການຮອງຮັບການປັບແຕ່ງສີຂໍ້ຄວາມການນຳທາງ."

msgid ""
"`All changes in detail <https://github.com/WeblateOrg/weblate/milestone/59?"
"closed=1>`__."
msgstr ""
"`ລາຍລະອຽດການປ່ຽນແປງທັງໝົດ <https://github.com/WeblateOrg/weblate/milestone/59?"
"closed=1>`__."

msgid "The migration might take considerable time if you had big glossaries."
msgstr "ການຍ້າຍລະບົບອາດໃຊ້ເວລາດົນພໍສົມຄວນຖ້າທ່ານມີຄຳສັບຂະໜາດໃຫຍ່."

msgid ""
"The glossary API is removed, use regular translation API to access "
"glossaries."
msgstr "API ຄຳສັບຖືກລຶບອອກແລ້ວ, ໃຊ້ API ການແປປົກກະຕິເພື່ອເຂົ້າເຖິງຄຳສັບ."

msgid ""
"There is a change in :setting:`django:INSTALLED_APPS`; ``weblate.metrics`` "
"should be added."
msgstr ""
"ມີການປ່ຽນແປງໃນ :setting:`django:INSTALLED_APPS`; ``weblate.metrics`` ຄວນຖືກເພີ່ມ."

msgid "There is a new dependency on the `pyahocorasick` module."
msgstr "ມີການເພິ່ງພາອາໄສໃໝ່ເທິງໂມດູນ `pyahocorasick`."

msgid "Weblate 4.4.2"
msgstr "Weblate 4.4.2"

msgid "*Released on January 14th 2021.*"
msgstr "*ອອກຈຳໜ່າຍເມື່ອວັນທີ 14 ມັງກອນ 2021.*"

msgid "Fixed corruption of one distributed MO file."
msgstr "ແກ້ໄຂການເສຍຫາຍຂອງໄຟລ໌ MO ທີ່ແຈກຢາຍອັນໜຶ່ງ."

msgid "Weblate 4.4.1"
msgstr "Weblate 4.4.1"

msgid "*Released on January 13th 2021.*"
msgstr "*ອອກຈຳໜ່າຍເມື່ອວັນທີ 13 ມັງກອນ 2021.*"

msgid "Fixed reverting plural changes."
msgstr "ແກ້ໄຂການກັບຄືນການປ່ຽນແປງພະຫຸພົດ."

msgid "Fixed displaying help for project settings."
msgstr "ແກ້ໄຂການສະແດງຄວາມຊ່ວຍເຫຼືອສຳລັບການຕັ້ງຄ່າໂຄງການ."

msgid "Improved administration of users."
msgstr "ປັບປຸງການບໍລິຫານຜູ້ໃຊ້."

msgid "Improved handling of context in monolingual PO files."
msgstr "ປັບປຸງການຈັດການບໍລິບົດໃນໄຟລ໌ PO ພາສາດຽວ."

msgid ""
"Fixed cleanup add-on behavior with HTML, ODF, IDML and Windows RC formats."
msgstr "ແກ້ໄຂພຶດຕິກຳສ່ວນເສີມທຳຄວາມສະອາດກັບຮູບແບບ HTML, ODF, IDML ແລະ Windows RC."

msgid "Fixed parsing of location from CSV files."
msgstr "ແກ້ໄຂການແຍກວິເຄາະທີ່ຕັ້ງຈາກໄຟລ໌ CSV."

msgid "Use content compression for file downloads."
msgstr "ໃຊ້ການບີບອັດເນື້ອຫາສຳລັບການດາວໂຫຼດໄຟລ໌."

msgid "Improved user experience on importing from ZIP file."
msgstr "ປັບປຸງປະສົບການຜູ້ໃຊ້ໃນການນຳເຂົ້າຈາກໄຟລ໌ ZIP."

msgid "Improved detection of file format for uploads."
msgstr "ປັບປຸງການກວດຫາຮູບແບບໄຟລ໌ສຳລັບການອັບໂຫຼດ."

msgid "Avoid duplicate pull requests on Pagure."
msgstr "ຫຼີກເວັ້ນ pull requests ຊ້ຳກັນໃນ Pagure."

msgid "Improved performance when displaying ghost translations."
msgstr "ປັບປຸງປະສິດທິພາບເມື່ອສະແດງຄຳແປຜີ (ghost translations)."

msgid "Reimplemented translation editor to use native browser textarea."
msgstr "ຈັດຕັ້ງປະຕິບັດຕົວແກ້ໄຂການແປຄືນໃໝ່ເພື່ອໃຊ້ textarea ຂອງເບຣົາເຊີ."

msgid "Fixed cleanup add-on breaking adding new strings."
msgstr "ແກ້ໄຂສ່ວນເສີມທຳຄວາມສະອາດທີ່ເຮັດໃຫ້ການເພີ່ມຂໍ້ຄວາມໃໝ່ເສຍຫາຍ."

msgid "Added API for add-ons."
msgstr "ເພີ່ມ API ສຳລັບສ່ວນເສີມ."

msgid ""
"`All changes in detail <https://github.com/WeblateOrg/weblate/milestone/60?"
"closed=1>`__."
msgstr ""
"`ລາຍລະອຽດການປ່ຽນແປງທັງໝົດ <https://github.com/WeblateOrg/weblate/milestone/60?"
"closed=1>`__."

msgid "Weblate 4.4"
msgstr "Weblate 4.4"

msgid "*Released on December 15th 2020.*"
msgstr "*ອອກຈຳໜ່າຍເມື່ອວັນທີ 15 ທັນວາ 2020.*"

msgid "Improved validation when creating a component."
msgstr "ປັບປຸງການກວດສອບຄວາມຖືກຕ້ອງເມື່ອສ້າງອົງປະກອບ."

msgid "Weblate now requires Django 3.1."
msgstr "Weblate ຕອນນີ້ຕ້ອງການ Django 3.1."

msgid "Added support for appearance customization in the management interface."
msgstr "ເພີ່ມການຮອງຮັບການປັບແຕ່ງຮູບລັກສະນະໃນອິນເຕີເຟດການຈັດການ."

msgid "Fixed read-only state handling in bulk edit."
msgstr "ແກ້ໄຂການຈັດການສະຖານະອ່ານຢ່າງດຽວໃນການແກ້ໄຂແບບກຸ່ມ."

msgid "Improved CodeMirror integration."
msgstr "ປັບປຸງການເຊື່ອມໂຍງ CodeMirror."

msgid "Added add-on to remove blank strings from translation files."
msgstr "ເພີ່ມສ່ວນເສີມເພື່ອລຶບຂໍ້ຄວາມຫວ່າງເປົ່າອອກຈາກໄຟລ໌ແປ."

msgid "The CodeMirror editor is now used for translations."
msgstr "ຕົວແກ້ໄຂ CodeMirror ຕອນນີ້ຖືກໃຊ້ສຳລັບການແປ."

msgid ""
"Syntax highlighting in translation editor for XML, HTML, Markdown and "
"reStructuredText."
msgstr ""
"ການເນັ້ນໄວຍາກອນໃນຕົວແກ້ໄຂການແປສຳລັບ XML, HTML, Markdown ແລະ reStructuredText."

msgid "Highlight placeables in translation editor."
msgstr "ເນັ້ນ placeables ໃນຕົວແກ້ໄຂການແປ."

msgid "Improved support for non-standard language codes."
msgstr "ປັບປຸງການຮອງຮັບລະຫັດພາສາທີ່ບໍ່ແມ່ນມາດຕະຖານ."

msgid "Added alert when using ambiguous language codes."
msgstr "ເພີ່ມການແຈ້ງເຕືອນເມື່ອໃຊ້ລະຫັດພາສາທີ່ບໍ່ຊັດເຈນ."

msgid ""
"The user is now presented with a filtered list of languages when adding a "
"new translation."
msgstr "ຜູ້ໃຊ້ຈະໄດ້ຮັບລາຍການພາສາທີ່ກັ່ນຕອງແລ້ວເມື່ອເພີ່ມການແປໃໝ່."

msgid "Extended search capabilities for changes in history."
msgstr "ຂະຫຍາຍຄວາມສາມາດໃນການຄົ້ນຫາສຳລັບການປ່ຽນແປງໃນປະຫວັດ."

msgid "Improved billing detail pages and Libre hosting workflow."
msgstr "ປັບປຸງໜ້າລາຍລະອຽດການເອີ້ນເກັບເງິນ ແລະ ຂັ້ນຕອນການໂຮດຕິ້ງ Libre."

msgid "Extended translation statistics API."
msgstr "ຂະຫຍາຍ API ສະຖິຕິການແປ."

msgid "Improved \"other translations\" tab while translating."
msgstr "ປັບປຸງແຖບ \"other translations\" ໃນຂະນະແປ."

msgid "Added tasks API."
msgstr "ເພີ່ມ API ວຽກງານ."

msgid "Improved performance of file upload."
msgstr "ປັບປຸງປະສິດທິພາບຂອງການອັບໂຫຼດໄຟລ໌."

msgid "Improved display of user defined special characters."
msgstr "ປັບປຸງການສະແດງຕົວອັກສອນພິເສດທີ່ຜູ້ໃຊ້ກຳນົດ."

msgid "Improved performance of auto-translation."
msgstr "ປັບປຸງປະສິດທິພາບຂອງການແປພາສາອັດຕະໂນມັດ."

msgid "Several minor improvements in the user interface."
msgstr "ການປັບປຸງເລັກນ້ອຍຫຼາຍຢ່າງໃນອິນເຕີເຟດຜູ້ໃຊ້."

msgid "Improved naming of ZIP downloads."
msgstr "ປັບປຸງການຕັ້ງຊື່ການດາວໂຫຼດ ZIP."

msgid "Added option for getting notifications on unwatched projects."
msgstr "ເພີ່ມຕົວເລືອກສຳລັບການຮັບການແຈ້ງເຕືອນກ່ຽວກັບໂຄງການທີ່ບໍ່ໄດ້ຕິດຕາມ."

msgid ""
"`All changes in detail <https://github.com/WeblateOrg/weblate/milestone/56?"
"closed=1>`__."
msgstr ""
"`ລາຍລະອຽດການປ່ຽນແປງທັງໝົດ <https://github.com/WeblateOrg/weblate/milestone/56?"
"closed=1>`__."

msgid ""
"There is a change in :setting:`django:INSTALLED_APPS`, "
"``weblate.configuration`` has to be added there."
msgstr ""
"ມີການປ່ຽນແປງໃນ :setting:`django:INSTALLED_APPS`, ``weblate.configuration`` "
"ຕ້ອງຖືກເພີ່ມຢູ່ທີ່ນັ້ນ."

msgid "Django 3.1 is now required."
msgstr "Django 3.1 ແມ່ນຕ້ອງການຕອນນີ້."

msgid ""
"In case you are using MySQL or MariaDB, the minimal required versions have "
"increased."
msgstr "ໃນກໍລະນີທີ່ທ່ານໃຊ້ MySQL ຫຼື MariaDB, ເວີຊັນຕໍ່າສຸດທີ່ຕ້ອງການໄດ້ເພີ່ມຂຶ້ນ."

msgid ""
":ref:`mono_gettext` now uses both ``msgid`` and ``msgctxt`` when present. "
"This will change identification of translation strings in such files "
"breaking links to Weblate extended data such as screenshots or review "
"states. Please ensure you commit pending changes in such files prior "
"upgrading and it is recommended to force loading of affected component "
"using :wladmin:`loadpo`."
msgstr ""
":ref:`mono_gettext` ຕອນນີ້ໃຊ້ທັງ ``msgid`` ແລະ ``msgctxt`` ເມື່ອມີ. "
"ສິ່ງນີ້ຈະປ່ຽນການລະບຸຂໍ້ຄວາມແປໃນໄຟລ໌ດັ່ງກ່າວ ເຊິ່ງຈະເຮັດໃຫ້ລິ້ງໄປຍັງຂໍ້ມູນເພີ່ມເຕີມຂອງ Weblate ເຊັ່ນ "
"ຮູບພາບໜ້າຈໍ ຫຼື ສະຖານະການກວດສອບເສຍຫາຍ. ກະລຸນາຮັບປະກັນວ່າທ່ານ commit "
"ການປ່ຽນແປງທີ່ຄ້າງຢູ່ໃນໄຟລ໌ດັ່ງກ່າວກ່ອນການອັບເກຣດ ແລະ "
"ແນະນຳໃຫ້ບັງຄັບການໂຫຼດອົງປະກອບທີ່ໄດ້ຮັບຜົນກະທົບໂດຍໃຊ້ :wladmin:`loadpo`."

msgid ""
"Increased minimal required version of translate-toolkit to address several "
"file format issues."
msgstr "ເພີ່ມເວີຊັນຕໍ່າສຸດທີ່ຕ້ອງການຂອງ translate-toolkit ເພື່ອແກ້ໄຂບັນຫາຮູບແບບໄຟລ໌ຫຼາຍຢ່າງ."

msgid "Weblate 4.3.2"
msgstr "Weblate 4.3.2"

msgid "*Released on November 4th 2020.*"
msgstr "*ອອກຈຳໜ່າຍເມື່ອວັນທີ 4 ພະຈິກ 2020.*"

msgid "Fixed crash on certain component file masks."
msgstr "ແກ້ໄຂການຂັດຂ້ອງໃນ mask ໄຟລ໌ອົງປະກອບບາງຢ່າງ."

msgid "Added support for Pagure pull requests."
msgstr "ເພີ່ມການຮອງຮັບ Pagure pull requests."

msgid "Improved error messages for failed registrations."
msgstr "ປັບປຸງຂໍ້ຄວາມຂໍ້ຜິດພາດສຳລັບການລົງທະບຽນທີ່ລົ້ມເຫຼວ."

msgid "Reverted rendering developer comments as Markdown."
msgstr "ຍົກເລີກການສະແດງຄຳຄິດເຫັນຂອງນັກພັດທະນາເປັນ Markdown."

msgid ""
"Simplified setup of Git repositories with different default branch than "
"\"master\"."
msgstr "ເຮັດໃຫ້ການຕັ້ງຄ່າບ່ອນເກັບຂໍ້ມູນ Git ທີ່ມີສາຂາເລີ່ມຕົ້ນທີ່ບໍ່ແມ່ນ \"master\" ງ່າຍຂຶ້ນ."

msgid "Newly created internal repositories now use main as the default branch."
msgstr "ບ່ອນເກັບຂໍ້ມູນພາຍໃນທີ່ສ້າງຂຶ້ນໃໝ່ຕອນນີ້ໃຊ້ main ເປັນສາຂາເລີ່ມຕົ້ນ."

msgid ""
"Reduced false positives rate of unchanged translation while translating "
"reStructuredText."
msgstr "ຫຼຸດອັດຕາຜົນບວກປອມຂອງການແປທີ່ບໍ່ມີການປ່ຽນແປງໃນຂະນະແປ reStructuredText."

msgid "Fixed CodeMirror display issues in some situations."
msgstr "ແກ້ໄຂບັນຫາການສະແດງ CodeMirror ໃນບາງສະຖານະການ."

msgid "Renamed Template group to \"Sources\" to clarify its meaning."
msgstr "ປ່ຽນຊື່ກຸ່ມ Template ເປັນ \"Sources\" ເພື່ອອະທິບາຍຄວາມໝາຍໃຫ້ຊັດເຈນ."

msgid "Fixed GitLab pull requests on repositories with longer paths."
msgstr "ແກ້ໄຂ GitLab pull requests ໃນບ່ອນເກັບຂໍ້ມູນທີ່ມີເສັ້ນທາງຍາວ."

msgid ""
"`All changes in detail <https://github.com/WeblateOrg/weblate/milestone/58?"
"closed=1>`__."
msgstr ""
"`ລາຍລະອຽດການປ່ຽນແປງທັງໝົດ <https://github.com/WeblateOrg/weblate/milestone/58?"
"closed=1>`__."

msgid "Weblate 4.3.1"
msgstr "Weblate 4.3.1"

msgid "*Released on October 21st 2020.*"
msgstr "*ອອກຈຳໜ່າຍເມື່ອວັນທີ 21 ຕຸລາ 2020.*"

msgid "Improved auto-translation performance."
msgstr "ປັບປຸງປະສິດທິພາບການແປພາສາອັດຕະໂນມັດ."

msgid "Fixed session expiry for authenticated users."
msgstr "ແກ້ໄຂການໝົດອາຍຸເຊສຊັນສຳລັບຜູ້ໃຊ້ທີ່ຢືນຢັນຕົວຕົນ."

msgid "Add support for hiding version information."
msgstr "ເພີ່ມການຮອງຮັບການຊ່ອນຂໍ້ມູນເວີຊັນ."

msgid "Improve hooks compatibility with Bitbucket Server."
msgstr "ປັບປຸງຄວາມເຂົ້າກັນໄດ້ຂອງ hooks ກັບ Bitbucket Server."

msgid "Improved performance of translation memory updates."
msgstr "ປັບປຸງປະສິດທິພາບການອັບເດດໜ່ວຍຄວາມຈຳການແປ."

msgid "Reduced memory usage."
msgstr "ຫຼຸດການໃຊ້ໜ່ວຍຄວາມຈຳ."

msgid "Improved performance of Matrix view."
msgstr "ປັບປຸງປະສິດທິພາບຂອງມຸມມອງ Matrix."

msgid "Added confirmation before removing a user from a project."
msgstr "ເພີ່ມການຢືນຢັນກ່ອນລຶບຜູ້ໃຊ້ອອກຈາກໂຄງການ."

msgid ""
"`All changes in detail <https://github.com/WeblateOrg/weblate/milestone/57?"
"closed=1>`__."
msgstr ""
"`ລາຍລະອຽດການປ່ຽນແປງທັງໝົດ <https://github.com/WeblateOrg/weblate/milestone/57?"
"closed=1>`__."

msgid "Weblate 4.3"
msgstr "Weblate 4.3"

msgid "*Released on October 15th 2020.*"
msgstr "*ອອກຈຳໜ່າຍເມື່ອວັນທີ 15 ຕຸລາ 2020.*"

msgid "Include user stats in the API."
msgstr "ລວມສະຖິຕິຜູ້ໃຊ້ໃນ API."

msgid "Fixed component ordering on paginated pages."
msgstr "ແກ້ໄຂການຈັດລຽງອົງປະກອບໃນໜ້າທີ່ມີການແບ່ງໜ້າ."

msgid "Define source language for a glossary."
msgstr "ກຳນົດພາສາຕົ້ນສະບັບສຳລັບຄຳສັບ."

msgid "Rewritten support for GitHub and GitLab pull requests."
msgstr "ຂຽນໃໝ່ການຮອງຮັບສຳລັບ GitHub ແລະ GitLab pull requests."

msgid "Fixed stats counts after removing suggestion."
msgstr "ແກ້ໄຂການນັບສະຖິຕິຫຼັງຈາກລຶບຄຳແນະນຳ."

msgid "Extended public user profile."
msgstr "ຂະຫຍາຍໂປຣໄຟລ໌ຜູ້ໃຊ້ສາທາລະນະ."

msgid "Fixed configuration of enforced checks."
msgstr "ແກ້ໄຂການຕັ້ງຄ່າການກວດສອບແບບບັງຄັບ."

msgid "Improve documentation about built-in backups."
msgstr "ປັບປຸງເອກະສານກ່ຽວກັບການສຳຮອງຂໍ້ມູນທີ່ມີໃນຕົວ."

msgid "Moved source language attribute from project to a component."
msgstr "ຍ້າຍຄຸນລັກສະນະພາສາຕົ້ນສະບັບຈາກໂຄງການໄປຍັງອົງປະກອບ."

msgid "Add Vue I18n formatting check."
msgstr "ເພີ່ມການກວດສອບຮູບແບບ Vue I18n."

msgid "Generic placeholders check now supports regular expressions."
msgstr "ການກວດສອບ placeholder ທົ່ວໄປຕອນນີ້ຮອງຮັບ regular expressions."

msgid "Improved look of Matrix mode."
msgstr "ປັບປຸງຮູບລັກສະນະຂອງໂໝດ Matrix."

msgid "Machinery is now called automatic suggestions."
msgstr "Machinery ຕອນນີ້ຖືກເອີ້ນວ່າຄຳແນະນຳອັດຕະໂນມັດ."

msgid "Added support for interacting with multiple GitLab or GitHub instances."
msgstr "ເພີ່ມການຮອງຮັບການໂຕ້ຕອບກັບຫຼາຍອິນສະແຕນສ໌ GitLab ຫຼື GitHub."

msgid ""
"Extended API to cover project updates, unit updates and removals and "
"glossaries."
msgstr ""
"ຂະຫຍາຍ API ເພື່ອກວມເອົາການອັບເດດໂຄງການ, ການອັບເດດຫົວໜ່ວຍ, ການລຶບຫົວໜ່ວຍ ແລະ ຄຳສັບ."

msgid "Unit API now properly handles plural strings."
msgstr "Unit API ຕອນນີ້ຈັດການຂໍ້ຄວາມພະຫຸພົດໄດ້ຢ່າງຖືກຕ້ອງ."

msgid "Component creation can now handle ZIP file or document upload."
msgstr "ການສ້າງອົງປະກອບຕອນນີ້ສາມາດຈັດການໄຟລ໌ ZIP ຫຼື ການອັບໂຫຼດເອກະສານ."

msgid "Consolidated API response status codes."
msgstr "ລວມລະຫັດສະຖານະການຕອບກັບ API."

msgid "Support Markdown in contributor agreement."
msgstr "ຮອງຮັບ Markdown ໃນຂໍ້ຕົກລົງຜູ້ປະກອບສ່ວນ."

msgid "Improved source strings tracking."
msgstr "ປັບປຸງການຕິດຕາມຂໍ້ຄວາມຕົ້ນສະບັບ."

msgid "Improved JSON, YAML and CSV formats compatibility."
msgstr "ປັບປຸງຄວາມເຂົ້າກັນໄດ້ຂອງຮູບແບບ JSON, YAML ແລະ CSV."

msgid "Added support for removing strings."
msgstr "ເພີ່ມການຮອງຮັບການລຶບຂໍ້ຄວາມ."

msgid "Improved performance of file downloads."
msgstr "ປັບປຸງປະສິດທິພາບຂອງການດາວໂຫຼດໄຟລ໌."

msgid "Improved repository management view."
msgstr "ປັບປຸງມຸມມອງການຈັດການບ່ອນເກັບຂໍ້ມູນ."

msgid "Automatically enable java-format for Android."
msgstr "ເປີດໃຊ້ java-format ໂດຍອັດຕະໂນມັດສຳລັບ Android."

msgid "Added support for localized screenshots."
msgstr "ເພີ່ມການຮອງຮັບຮູບພາບໜ້າຈໍສະເພາະພາສາ."

msgid "Added support for Python 3.9."
msgstr "ເພີ່ມການຮອງຮັບ Python 3.9."

msgid "Fixed translating HTML files under certain conditions."
msgstr "ແກ້ໄຂການແປໄຟລ໌ HTML ພາຍໃຕ້ເງື່ອນໄຂບາງຢ່າງ."

msgid ""
"`All changes in detail <https://github.com/WeblateOrg/weblate/milestone/53?"
"closed=1>`__."
msgstr ""
"`ລາຍລະອຽດການປ່ຽນແປງທັງໝົດ <https://github.com/WeblateOrg/weblate/milestone/53?"
"closed=1>`__."

msgid ""
"There are some changes in quality checks, you might want to include them in "
"case you modified the :setting:`CHECK_LIST`."
msgstr ""
"ມີການປ່ຽນແປງບາງຢ່າງໃນການກວດສອບຄຸນນະພາບ, "
"ທ່ານອາດຕ້ອງການລວມພວກມັນໄວ້ໃນກໍລະນີທີ່ທ່ານແກ້ໄຂ :setting:`CHECK_LIST`."

msgid ""
"The source language attribute was moved from project to a component what is "
"exposed in the API. You will need to update :ref:`wlc` in case you are using "
"it."
msgstr ""
"ຄຸນລັກສະນະພາສາຕົ້ນສະບັບໄດ້ຖືກຍ້າຍຈາກໂຄງການໄປຍັງອົງປະກອບ ເຊິ່ງຖືກເປີດເຜີຍໃນ API. "
"ທ່ານຈະຕ້ອງອັບເດດ :ref:`wlc` ໃນກໍລະນີທີ່ທ່ານນຳໃຊ້ມັນ."

msgid ""
"The database migration to 4.3 might take long depending on number of strings "
"you are translating (expect around one hour of migration time per 100,000 "
"source strings)."
msgstr ""
"ການຍ້າຍຖານຂໍ້ມູນໄປ 4.3 ອາດໃຊ້ເວລາດົນຂຶ້ນຢູ່ກັບຈຳນວນຂໍ້ຄວາມທີ່ທ່ານກຳລັງແປ "
"(ຄາດວ່າຈະໃຊ້ເວລາປະມານໜຶ່ງຊົ່ວໂມງຂອງເວລາການຍ້າຍຕໍ່ 100,000 ຂໍ້ຄວາມຕົ້ນສະບັບ)."

msgid "There is a change in :setting:`django:INSTALLED_APPS`."
msgstr "ມີການປ່ຽນແປງໃນ :setting:`django:INSTALLED_APPS`."

msgid ""
"There is a new setting :setting:`SESSION_COOKIE_AGE_AUTHENTICATED` which "
"complements :setting:`django:SESSION_COOKIE_AGE`."
msgstr ""
"ມີການຕັ້ງຄ່າໃໝ່ :setting:`SESSION_COOKIE_AGE_AUTHENTICATED` "
"ເຊິ່ງເສີມກັບ :setting:`django:SESSION_COOKIE_AGE`."

msgid ""
"In case you were using :command:`hub` or :command:`lab` to integrate with "
"GitHub or GitLab, you will need to reconfigure this, "
"see :setting:`GITHUB_CREDENTIALS` and :setting:`GITLAB_CREDENTIALS`."
msgstr ""
"ໃນກໍລະນີທີ່ທ່ານໃຊ້ :command:`hub` ຫຼື :command:`lab` ເພື່ອເຊື່ອມໂຍງກັບ GitHub ຫຼື GitLab, "
"ທ່ານຈະຕ້ອງຕັ້ງຄ່າສິ່ງນີ້ໃໝ່, ເບິ່ງ :setting:`GITHUB_CREDENTIALS` "
"ແລະ :setting:`GITLAB_CREDENTIALS`."

msgid ""
"The Celery configuration was changed to add ``memory`` queue. Please adjust "
"your startup scripts and ``CELERY_TASK_ROUTES`` setting."
msgstr ""
"ການຕັ້ງຄ່າ Celery ໄດ້ຖືກປ່ຽນແປງເພື່ອເພີ່ມຄິວ ``memory``. ກະລຸນາປັບສະຄຣິບເລີ່ມຕົ້ນ ແລະ ການຕັ້ງຄ່າ "
"``CELERY_TASK_ROUTES`` ຂອງທ່ານ."

msgid ""
"The ``post_update`` method of add-ons now takes extra ``skip_push`` "
"parameter."
msgstr "ວິທີການ ``post_update`` ຂອງສ່ວນເສີມຕອນນີ້ຮັບອາກິວເມັນ ``skip_push`` ເພີ່ມເຕີມ."

msgid "Weblate 4.2.2"
msgstr "Weblate 4.2.2"

msgid "*Released on September 2nd 2020.*"
msgstr "*ອອກເຜີຍແຜ່ເມື່ອວັນທີ 2 ກັນຍາ 2020.*"

msgid "Fixed matching of source strings for JSON formats."
msgstr "ແກ້ໄຂການຈັບຄູ່ຂໍ້ຄວາມຕົ້ນສະບັບສຳລັບຮູບແບບ JSON."

msgid "Fixed login redirect for some authentication configurations."
msgstr "ແກ້ໄຂການປ່ຽນເສັ້ນທາງການເຂົ້າສູ່ລະບົບສຳລັບບາງການຕັ້ງຄ່າການຢືນຢັນຕົວຕົນ."

msgid "Fixed LDAP authentication with group sync."
msgstr "ແກ້ໄຂການຢືນຢັນຕົວຕົນຜ່ານ LDAP ພ້ອມກັບການຊິ້ງຂໍ້ມູນກຸ່ມ."

msgid "Fixed crash in reporting automatic translation progress."
msgstr "ແກ້ໄຂບັນຫາແອັບຯປິດເອງໃນການລາຍງານຄວາມຄືບໜ້າການແປພາສາອັດຕະໂນມັດ."

msgid "Fixed Git commit squashing with trailers enabled."
msgstr "ແກ້ໄຂການລວມ Git commit ເມື່ອເປີດໃຊ້ງານ trailers."

msgid "Fixed creating local VCS components using the API."
msgstr "ແກ້ໄຂການສ້າງອົງປະກອບ VCS ທ້ອງຖິ່ນໂດຍໃຊ້ API."

msgid "Weblate 4.2.1"
msgstr "Weblate 4.2.1"

msgid "*Released on August 21st 2020.*"
msgstr "*ອອກເຜີຍແຜ່ເມື່ອວັນທີ 21 ສິງຫາ 2020.*"

msgid "Fixed saving plurals for some locales in Android resources."
msgstr "ແກ້ໄຂການບັນທຶກຮູບແບບພະຫຸພົດສຳລັບບາງພາສາໃນຊັບພະຍາກອນ Android."

msgid "Fixed crash in the cleanup add-on for some XLIFF files."
msgstr "ແກ້ໄຂບັນຫາແອັບຯປິດເອງໃນສ່ວນເສີມທຳຄວາມສະອາດສຳລັບໄຟລ໌ XLIFF ບາງໄຟລ໌."

msgid "Allow setting up localization CDN in Docker image."
msgstr "ອະນຸຍາດໃຫ້ຕັ້ງຄ່າ CDN ການແປພາສາໃນ Docker image."

msgid "Weblate 4.2"
msgstr "Weblate 4.2"

msgid "*Released on August 18th 2020.*"
msgstr "*ອອກເຜີຍແຜ່ເມື່ອວັນທີ 18 ສິງຫາ 2020.*"

msgid "Improved user pages and added listing of users."
msgstr "ປັບປຸງໜ້າຜູ້ໃຊ້ງານ ແລະ ເພີ່ມລາຍການຜູ້ໃຊ້."

msgid ""
"Dropped support for migrating from 3.x releases, migrate through 4.1 or 4.0."
msgstr "ຍົກເລີກການຮອງຮັບການຍ້າຍຂໍ້ມູນຈາກເວີຊັນ 3.x, ໃຫ້ຍ້າຍຜ່ານເວີຊັນ 4.1 ຫຼື 4.0."

msgid "Added exports into several monolingual formats."
msgstr "ເພີ່ມການສົ່ງອອກເປັນຫຼາຍຮູບແບບສຳລັບພາສາຽວ."

msgid "Number of displayed nearby strings can be configured."
msgstr "ສາມາດຕັ້ງຄ່າຈຳນວນຂອງຂໍ້ຄວາມໃກ້ຄຽງທີ່ສະແດງຜົນໄດ້."

msgid "Added support for locking components experiencing repository errors."
msgstr "ເພີ່ມການຮອງຮັບການລັອກອົງປະກອບທີ່ພົບຂໍ້ຜິດພາດຂອງ repository."

msgid "Simplified main navigation (replaced buttons with icons)."
msgstr "ເຮັດໃຫ້ການນຳທາງຫຼັກງ່າຍຂຶ້ນ (ປ່ຽນປຸ່ມເປັນໄອຄອນ)."

msgid "Improved language code handling in Google Translate integration."
msgstr "ປັບປຸງການຈັດການລະຫັດພາສາໃນການເຊື່ອມຕໍ່ກັບ Google Translate."

msgid "The Git squash add-on can generate ``Co-authored-by:`` trailers."
msgstr "ສ່ວນເສີມ Git squash ສາມາດສ້າງ trailer ແບບ ``Co-authored-by:`` ໄດ້."

msgid "Improved query search parser."
msgstr "ປັບປຸງຕົວແຍກຄຳສັ່ງຄົ້ນຫາ."

msgid "Improved user feedback from format strings checks."
msgstr "ປັບປຸງການຕອບກັບຜູ້ໃຊ້ຈາກການກວດສອບຮູບແບບຂໍ້ຄວາມ."

msgid "Improved performance of bulk state changes."
msgstr "ປັບປຸງປະສິດທິພາບໃນການປ່ຽນແປງສະຖານະແບບກຸ່ມ."

msgid "Added compatibility redirects after project or component renaming."
msgstr "ເພີ່ມການປ່ຽນເສັ້ນທາງເພື່ອຄວາມເຂົ້າກັນໄດ້ຫຼັງຈາກການປ່ຽນຊື່ໂຄງການ ຫຼື ອົງປະກອບ."

msgid ""
"Added notifications for strings approval, component locking and license "
"change."
msgstr "ເພີ່ມການແຈ້ງເຕືອນສຳລັບການອະນຸມັດຂໍ້ຄວາມ, ການລັອກອົງປະກອບ ແລະ ການປ່ຽນແປງໃບອະນຸຍາດ."

msgid "Added support for ModernMT."
msgstr "ເພີ່ມການຮອງຮັບ ModernMT."

msgid "Allow to avoid overwriting approved translations on file upload."
msgstr "ອະນຸຍາດໃຫ້ຫຼີກເວັ້ນການຂຽນທັບຄຳແປທີ່ອະນຸມັດແລ້ວໃນຕອນອັບໂຫຼດໄຟລ໌."

msgid "Dropped support for some compatibility URL redirects."
msgstr "ຍົກເລີກການຮອງຮັບການປ່ຽນເສັ້ນທາງ URL ເພື່ອຄວາມເຂົ້າກັນໄດ້ບາງອັນ."

msgid "Added check for ECMAScript template literals."
msgstr "ເພີ່ມການກວດສອບສຳລັບ ECMAScript template literals."

msgid "Added option to watch a component."
msgstr "ເພີ່ມຕົວເລືອກເພື່ອຕິດຕາມອົງປະກອບ."

msgid "Removed leading dot from JSON unit keys."
msgstr "ລົບຈຸດນຳໜ້າອອກຈາກ key ຂອງ JSON unit."

msgid "Removed separate Celery queue for translation memory."
msgstr "ລົບແຖວ Celery ແຍກຕ່າງຫາກສຳລັບໜ່ວຍຄວາມຈຳການແປ."

msgid "Allow translating all components a language at once."
msgstr "ອະນຸຍາດໃຫ້ແປທຸກອົງປະກອບຂອງພາສາໃດໜຶ່ງພ້ອມກັນ."

msgid "Allow to configure ``Content-Security-Policy`` HTTP headers."
msgstr "ອະນຸຍາດໃຫ້ຕັ້ງຄ່າ ``Content-Security-Policy`` HTTP headers."

msgid "Added support for aliasing languages at project level."
msgstr "ເພີ່ມການຮອງຮັບການຕັ້ງນາມແຝງພາສາໃນລະດັບໂຄງການ."

msgid ""
"New add-on to help with HTML or JavaScript localization, see :ref:`addon-"
"weblate.cdn.cdnjs`."
msgstr ""
"ສ່ວນເສີມໃໝ່ເພື່ອຊ່ວຍໃນການແປພາສາ HTML ຫຼື JavaScript, ເບິ່ງ :ref:`addon-"
"weblate.cdn.cdnjs`."

msgid ""
"The Weblate domain is now configured in the settings, "
"see :setting:`SITE_DOMAIN`."
msgstr "ໂດເມນ Weblate ຕອນນີ້ຖືກຕັ້ງຄ່າໃນການຕັ້ງຄ່າແລ້ວ, ເບິ່ງ :setting:`SITE_DOMAIN`."

msgid "Add support for searching by component and project."
msgstr "ເພີ່ມການຮອງຮັບການຄົ້ນຫາຕາມອົງປະກອບ ແລະ ໂຄງການ."

msgid ""
"Upgrade from 3.x releases is not longer supported, please upgrade to 4.0 or "
"4.1 first."
msgstr "ບໍ່ຮອງຮັບການອັບເກຣດຈາກເວີຊັນ 3.x ແລ້ວ, ກະລຸນາອັບເກຣດເປັນ 4.0 ຫຼື 4.1 ກ່ອນ."

msgid "There are some new and updated requirements."
msgstr "ມີຂໍ້ກຳນົດໃໝ່ ແລະ ທີ່ຖືກປັບປຸງບາງຢ່າງ."

msgid ""
"There are several changes in :file:`settings_example.py`, most notable new "
"middleware and changed application ordering."
msgstr ""
"ມີການປ່ຽນແປງຫຼາຍຢ່າງໃນ :file:`settings_example.py`, ທີ່ສຳຄັນທີ່ສຸດຄື middleware ໃໝ່ ແລະ "
"ການປ່ຽນລຳດັບແອັບພລິເຄຊັນ."

msgid ""
"The keys for JSON based formats no longer include leading dot. The strings "
"are adjusted during the database migration, but external components might "
"need adjustment in case you rely on keys in exports or API."
msgstr ""
"ຄີສຳລັບຮູບແບບທີ່ອີງໃສ່ JSON ຈະບໍ່ມີຈຸດນຳໜ້າອີກຕໍ່ໄປ. ຂໍ້ຄວາມຕ່າງໆຈະຖືກປັບໃນລະຫວ່າງການຍ້າຍຖານຂໍ້ມູນ, "
"ແຕ່ອົງປະກອບພາຍນອກອາດຈະຕ້ອງໄດ້ປັບຖ້າທ່ານອີງໃສ່ keys ໃນການສົ່ງອອກ ຫຼື API."

msgid ""
"The Celery configuration was changed to no longer use ``memory`` queue. "
"Please adjust your startup scripts and ``CELERY_TASK_ROUTES`` setting."
msgstr ""
"ການຕັ້ງຄ່າ Celery ໄດ້ຖືກປ່ຽນແປງເພື່ອບໍ່ໃຫ້ໃຊ້ແຖວ ``memory`` ອີກຕໍ່ໄປ. "
"ກະລຸນາປັບສະຄຣິບເລີ່ມຕົ້ນຂອງທ່ານ ແລະ ການຕັ້ງຄ່າ ``CELERY_TASK_ROUTES``."

msgid ""
"The Weblate domain is now configured in the settings, "
"see :setting:`SITE_DOMAIN` (or :envvar:`WEBLATE_SITE_DOMAIN`). You will have "
"to configure it before running Weblate."
msgstr ""
"ໂດເມນ Weblate ຕອນນີ້ຖືກຕັ້ງຄ່າໃນການຕັ້ງຄ່າແລ້ວ, ເບິ່ງ :setting:`SITE_DOMAIN` "
"(ຫຼື :envvar:`WEBLATE_SITE_DOMAIN`). ທ່ານຈະຕ້ອງຕັ້ງຄ່າມັນກ່ອນເປີດໃຊ້ງານ Weblate."

msgid ""
"The username and email fields on user database now should be case "
"insensitive unique. It was mistakenly not enforced with PostgreSQL."
msgstr ""
"ຊ່ອງຂໍ້ມູນຊື່ຜູ້ໃຊ້ ແລະ ອີເມວໃນຖານຂໍ້ມູນຜູ້ໃຊ້ຕອນນີ້ຄວນຈະມີເອກະລັກໂດຍບໍ່ແຍກຕົວພິມນ້ອຍ-ໃຫຍ່. "
"ມັນເຄີຍບໍ່ໄດ້ຖືກບັງຄັບໃນ PostgreSQL ໂດຍຜິດພາດ."

msgid "Weblate 4.1.1"
msgstr "Weblate 4.1.1"

msgid "*Released on June 19th 2020.*"
msgstr "*ອອກເຜີຍແຜ່ເມື່ອວັນທີ 19 ມິຖຸນາ 2020.*"

msgid "Fixed changing autofix or add-ons configuration in Docker."
msgstr "ແກ້ໄຂການປ່ຽນແປງການຕັ້ງຄ່າ autofix ຫຼື add-ons ໃນ Docker."

msgid "Fixed possible crash in \"About\" page."
msgstr "ແກ້ໄຂບັນຫາແອັບຯອາດປິດເອງໃນໜ້າ \"ກ່ຽວກັບ\"."

msgid "Improved installation of byte-compiled locale files."
msgstr "ປັບປຸງການຕິດຕັ້ງໄຟລ໌ locale ທີ່ເປັນ byte-compiled."

msgid "Fixed adding words to glossary."
msgstr "ແກ້ໄຂການເພີ່ມຄຳສັບໃສ່ glossary."

msgid "Fixed keyboard shortcuts for machinery."
msgstr "ແກ້ໄຂປຸ່ມລັດແປ້ນພິມສຳລັບ machinery."

msgid "Removed debugging output causing discarding log events in some setups."
msgstr "ລົບຜົນການດີບັກທີ່ເຮັດໃຫ້ເຫດການ log ຖືກຍົກເລີກໃນບາງການຕັ້ງຄ່າ."

msgid "Fixed lock indication on project listing."
msgstr "ແກ້ໄຂການສະແດງສະຖານະລັອກໃນລາຍການໂຄງການ."

msgid "Fixed listing GPG keys in some setups."
msgstr "ແກ້ໄຂການສະແດງລາຍການ GPG keys ໃນບາງການຕັ້ງຄ່າ."

msgid "Added option for which DeepL API version to use."
msgstr "ເພີ່ມຕົວເລືອກສຳລັບເວີຊັນ DeepL API ທີ່ຈະໃຊ້."

msgid ""
"Added support for acting as SAML Service Provider, see :ref:`saml-auth`."
msgstr "ເພີ່ມການຮອງຮັບການເປັນ SAML Service Provider, ເບິ່ງ :ref:`saml-auth`."

msgid "Weblate 4.1"
msgstr "Weblate 4.1"

msgid "*Released on June 15th 2020.*"
msgstr "*ອອກເຜີຍແຜ່ເມື່ອວັນທີ 15 ມິຖຸນາ 2020.*"

msgid "Added support for creating new translations with included country code."
msgstr "ເພີ່ມການຮອງຮັບການສ້າງການແປພາສາໃໝ່ທີ່ລວມລະຫັດປະເທດ."

msgid "Added support for searching source strings with screenshot."
msgstr "ເພີ່ມການຮອງຮັບການຄົ້ນຫາຂໍ້ຄວາມຕົ້ນສະບັບດ້ວຍພາບໜ້າຈໍ."

msgid "Extended info available in the stats insights."
msgstr "ເພີ່ມຂໍ້ມູນທີ່ມີໃຫ້ໃນສະຖິຕິເຈາະເລິກ."

msgid "Improved search editing on \"Translate\" pages."
msgstr "ປັບປຸງການແກ້ໄຂການຄົ້ນຫາໃນໜ້າ \"ແປພາສາ\"."

msgid "Improve handling of concurrent repository updates."
msgstr "ປັບປຸງການຈັດການການອັບເດດ repository ທີ່ເກີດຂຶ້ນພ້ອມກັນ."

msgid "Include source language in project creation form."
msgstr "ລວມພາສາຕົ້ນສະບັບໃນຟອມສ້າງໂຄງການ."

msgid "Include changes count in credits."
msgstr "ລວມຈຳນວນການປ່ຽນແປງໃນເຄຣດິດ."

msgid "Fixed UI language selection in some cases."
msgstr "ແກ້ໄຂການເລືອກພາສາ UI ໃນບາງກໍລະນີ."

msgid ""
"Possibility to allow certain registration methods with registrations closed."
msgstr "ຄວາມເປັນໄປໄດ້ທີ່ຈະອະນຸຍາດໃຫ້ບາງວິທີການລົງທະບຽນເຖິງວ່າການລົງທະບຽນຈະຖືກປິດ."

msgid "Improved lookup of related terms in glossary."
msgstr "ປັບປຸງການຄົ້ນຫາຄຳສັບທີ່ກ່ຽວຂ້ອງໃນ glossary."

msgid "Improved translation memory matches."
msgstr "ປັບປຸງການຈັບຄູ່ໜ່ວຍຄວາມຈຳການແປ."

msgid "Group same machinery results."
msgstr "ຈັດກຸ່ມຜົນລັດຈາກ machinery ດຽວກັນ."

msgid "Add direct link to edit screenshot from translate page."
msgstr "ເພີ່ມລິ້ງໂດຍກົງເພື່ອແກ້ໄຂພາບໜ້າຈໍຈາກໜ້າແປພາສາ."

msgid "Improved removal confirmation dialog."
msgstr "ປັບປຸງກ່ອງໂຕ້ຕອບການຢືນຢັນການລຶບ."

msgid "Include templates in ZIP download."
msgstr "ລວມແມ່ແບບໃນການດາວໂຫຼດ ZIP."

msgid ""
"Add support for Markdown and notification configuration in announcements."
msgstr "ເພີ່ມການຮອງຮັບ Markdown ແລະ ການຕັ້ງຄ່າການແຈ້ງເຕືອນໃນການປະກາດ."

msgid "Extended details in check listings."
msgstr "ເພີ່ມລາຍລະອຽດໃນລາຍການກວດສອບ."

msgid ""
"Added support for new file formats: :ref:`laravel-"
"php`, :ref:`html`, :ref:`odf`, :ref:`idml`, :ref:`winrc`, :ref:`ini`, :ref:`islu`, :ref:`gwt`, :ref:`go-"
"i18n-json`, :ref:`arb`."
msgstr ""
"ເພີ່ມການຮອງຮັບຮູບແບບໄຟລ໌ໃໝ່: :ref:`laravel-"
"php`, :ref:`html`, :ref:`odf`, :ref:`idml`, :ref:`winrc`, :ref:`ini`, :ref:`islu`, :ref:`gwt`, :ref:`go-"
"i18n-json`, :ref:`arb`."

msgid "Consistently use dismissed as state of dismissed checks."
msgstr "ໃຊ້ສະຖານະ dismissed ສຳລັບການກວດສອບທີ່ຖືກຍົກເລີກຢ່າງສະໝ່ຳສະເໝີ."

msgid "Add support for configuring default add-ons to enable."
msgstr "ເພີ່ມການຮອງຮັບການຕັ້ງຄ່າ add-ons ເລີ່ມຕົ້ນເພື່ອເປີດໃຊ້ງານ."

msgid "Fixed editor keyboard shortcut to dismiss checks."
msgstr "ແກ້ໄຂປຸ່ມລັດແປ້ນພິມຂອງຕົວແກ້ໄຂເພື່ອຍົກເລີກການກວດສອບ."

msgid "Improved machine translation of strings with placeholders."
msgstr "ປັບປຸງການແປພາສາດ້ວຍເຄື່ອງຈັກສຳລັບຂໍ້ຄວາມທີ່ມີຕົວແທນ."

msgid "Show ghost translation for user languages to ease starting them."
msgstr "ສະແດງການແປພາສາແບບ ghost ສຳລັບພາສາຂອງຜູ້ໃຊ້ເພື່ອຄວາມງ່າຍໃນການເລີ່ມຕົ້ນ."

msgid "Improved language code parsing."
msgstr "ປັບປຸງການແຍກລະຫັດພາສາ."

msgid "Show translations in user language first in the list."
msgstr "ສະແດງການແປພາສາໃນພາສາຂອງຜູ້ໃຊ້ຂຶ້ນກ່ອນໃນລາຍການ."

msgid "Renamed shapings to more generic name variants."
msgstr "ປ່ຽນຊື່ shapings ເປັນຊື່ທີ່ທົ່ວໄປກວ່າຄື variants."

msgid ""
"Added new quality checks: :ref:`check-unnamed-format`, :ref:`check-long-"
"untranslated`, :ref:`check-duplicate`."
msgstr ""
"ເພີ່ມການກວດສອບຄຸນນະພາບໃໝ່: :ref:`check-unnamed-format`, :ref:`check-long-"
"untranslated`, :ref:`check-duplicate`."

msgid "Reintroduced support for wiping translation memory."
msgstr "ນຳການຮອງຮັບການລ້າງໜ່ວຍຄວາມຈຳການແປກັບຄືນມາ."

msgid "Fixed option to ignore source checks."
msgstr "ແກ້ໄຂຕົວເລືອກໃນການລະເລີຍການກວດສອບຕົ້ນສະບັບ."

msgid "Added support for configuring different branch for pushing changes."
msgstr "ເພີ່ມການຮອງຮັບການຕັ້ງຄ່າສາຂາທີ່ແຕກຕ່າງກັນສຳລັບການຍູ້ການປ່ຽນແປງ."

msgid "API now reports rate limiting status in the HTTP headers."
msgstr "ຕອນນີ້ API ລາຍງານສະຖານະການຈຳກັດອັດຕາໃນ HTTP headers."

msgid "Added support for Google Translate V3 API (Advanced)."
msgstr "ເພີ່ມການຮອງຮັບ Google Translate V3 API (ຂັ້ນສູງ)."

msgid "Added ability to restrict access on component level."
msgstr "ເພີ່ມຄວາມສາມາດໃນການຈຳກັດການເຂົ້າເຖິງໃນລະດັບອົງປະກອບ."

msgid ""
"Added support for whitespace and other special chars in translation flags, "
"see :ref:`custom-checks`."
msgstr ""
"ເພີ່ມການຮອງຮັບການໃຊ້ຊ່ອງຫວ່າງ ແລະ ຕົວອັກສອນພິເສດອື່ນໆໃນທຸງການແປພາສາ, ເບິ່ງ :ref:`custom-"
"checks`."

msgid "Always show rendered text check if enabled."
msgstr "ສະແດງການກວດສອບຂໍ້ຄວາມທີ່ສະແດງຜົນສະເໝີຖ້າເປີດໃຊ້ງານ."

msgid "API now supports filtering of changes."
msgstr "ຕອນນີ້ API ຮອງຮັບການກັ່ນຕອງການປ່ຽນແປງ."

msgid "Added support for sharing glossaries between projects."
msgstr "ເພີ່ມການຮອງຮັບການແບ່ງປັນ glossary ລະຫວ່າງໂຄງການ."

msgid ""
"There are several changes in :file:`settings_example.py`, most notable "
"middleware changes, please adjust your settings accordingly."
msgstr ""
"ມີການປ່ຽນແປງຫຼາຍຢ່າງໃນ :file:`settings_example.py`, ທີ່ສຳຄັນທີ່ສຸດຄືການປ່ຽນແປງ "
"middleware, ກະລຸນາປັບການຕັ້ງຄ່າຂອງທ່ານໃຫ້ສອດຄ່ອງ."

msgid ""
"There are new quality checks, you might want to include them in case you "
"modified the :setting:`CHECK_LIST`."
msgstr ""
"ມີການກວດສອບຄຸນນະພາບໃໝ່, "
"ທ່ານອາດຈະຕ້ອງການລວມມັນເຂົ້າໄປໃນກໍລະນີທີ່ທ່ານໄດ້ດັດແປງ :setting:`CHECK_LIST`."

msgid ""
"There is change in ``DEFAULT_THROTTLE_CLASSES`` setting to allow reporting "
"of rate limiting in the API."
msgstr ""
"ມີການປ່ຽນແປງໃນການຕັ້ງຄ່າ ``DEFAULT_THROTTLE_CLASSES`` "
"ເພື່ອອະນຸຍາດໃຫ້ມີການລາຍງານການຈຳກັດອັດຕາໃນ API."

msgid ""
"The ``MT_DEEPL_API_VERSION`` setting has been removed in Version 4.7. "
"The :ref:`mt-deepl` machine translation now uses the new "
"``MT_DEEPL_API_URL`` instead. You might need to adjust ``MT_DEEPL_API_URL`` "
"to match your subscription."
msgstr ""
"ການຕັ້ງຄ່າ ``MT_DEEPL_API_VERSION`` ຖືກລົບອອກໃນເວີຊັນ 4.7. "
"ການແປພາສາດ້ວຍເຄື່ອງຈັກ :ref:`mt-deepl` ຕອນນີ້ໃຊ້ ``MT_DEEPL_API_URL`` ໃໝ່ແທນ. "
"ທ່ານອາດຈະຕ້ອງປັບ ``MT_DEEPL_API_URL`` ໃຫ້ກົງກັບການສະໝັກໃຊ້ຂອງທ່ານ."

msgid "Weblate 4.0.4"
msgstr "Weblate 4.0.4"

msgid "*Released on May 7th 2020.*"
msgstr "*ອອກເຜີຍແຜ່ເມື່ອວັນທີ 7 ພຶດສະພາ 2020.*"

msgid "Fixed testsuite execution on some Python 3.8 environments."
msgstr "ແກ້ໄຂການດຳເນີນງານ testsuite ໃນບາງສະພາບແວດລ້ອມ Python 3.8."

msgid "Typo fixes in the documentation."
msgstr "ແກ້ໄຂຄຳຜິດໃນເອກະສານ."

msgid "Fixed creating components using the API in some cases."
msgstr "ແກ້ໄຂການສ້າງອົງປະກອບໂດຍໃຊ້ API ໃນບາງກໍລະນີ."

msgid "Fixed JavaScript errors breaking mobile navigation."
msgstr "ແກ້ໄຂຂໍ້ຜິດພາດ JavaScript ທີ່ເຮັດໃຫ້ການນຳທາງເທິງມືຖືຂັດຂ້ອງ."

msgid "Fixed crash on displaying some checks."
msgstr "ແກ້ໄຂບັນຫາແອັບຯປິດເອງໃນການສະແດງການກວດສອບບາງອັນ."

msgid "Fixed screenshots listing."
msgstr "ແກ້ໄຂລາຍການພາບໜ້າຈໍ."

msgid "Fixed monthly digest notifications."
msgstr "ແກ້ໄຂການແຈ້ງເຕືອນສະຫຼຸບປະຈຳເດືອນ."

msgid ""
"Fixed intermediate translation behavior with units non existing in "
"translation."
msgstr "ແກ້ໄຂພຶດຕິກຳການແປພາສາຂັ້ນກາງກັບໜ່ວຍທີ່ບໍ່ມີໃນການແປພາສາ."

msgid "Weblate 4.0.3"
msgstr "Weblate 4.0.3"

msgid "*Released on May 2nd 2020.*"
msgstr "*ອອກເຜີຍແຜ່ເມື່ອວັນທີ 2 ພຶດສະພາ 2020.*"

msgid "Fixed possible crash in reports."
msgstr "ແກ້ໄຂບັນຫາແອັບຯອາດປິດເອງໃນບົດລາຍງານ."

msgid "User mentions in comments are now case insensitive."
msgstr "ການກ່າວເຖິງຜູ້ໃຊ້ໃນຄວາມຄິດເຫັນຕອນນີ້ບໍ່ແຍກຕົວພິມນ້ອຍ-ໃຫຍ່."

msgid "Fixed PostgreSQL migration for non superusers."
msgstr "ແກ້ໄຂການຍ້າຍຂໍ້ມູນ PostgreSQL ສຳລັບຜູ້ໃຊ້ທີ່ບໍ່ແມ່ນ superuser."

msgid "Fixed changing the repository URL while creating component."
msgstr "ແກ້ໄຂການປ່ຽນ URL ຂອງ repository ໃນຂະນະສ້າງອົງປະກອບ."

msgid "Fixed crash when upstream repository is gone."
msgstr "ແກ້ໄຂບັນຫາແອັບຯປິດເອງເມື່ອ repository ຕົ້ນທາງຫາຍໄປ."

msgid "Weblate 4.0.2"
msgstr "Weblate 4.0.2"

msgid "*Released on April 27th 2020.*"
msgstr "*ອອກເຜີຍແຜ່ເມື່ອວັນທີ 27 ເມສາ 2020.*"

msgid "Improved performance of translation stats."
msgstr "ປັບປຸງປະສິດທິພາບຂອງສະຖິຕິການແປພາສາ."

msgid "Improved performance of changing labels."
msgstr "ປັບປຸງປະສິດທິພາບຂອງການປ່ຽນແປງປ້າຍກຳກັບ."

msgid "Fixed possible crash on component deletion."
msgstr "ແກ້ໄຂບັນຫາແອັບຯອາດປິດເອງໃນການລຶບອົງປະກອບ."

msgid "Fixed displaying of translation changes in some corner cases."
msgstr "ແກ້ໄຂການສະແດງການປ່ຽນແປງການແປພາສາໃນບາງກໍລະນີພິເສດ."

msgid "Improved warning about too long celery queue."
msgstr "ປັບປຸງຄຳເຕືອນກ່ຽວກັບແຖວ Celery ທີ່ຍາວເກີນໄປ."

msgid "Fixed possible false positives in the consistency check."
msgstr "ແກ້ໄຂບັນຫາຜົນຜິດພາດທີ່ເປັນໄປໄດ້ໃນການກວດສອບຄວາມສອດຄ່ອງ."

msgid "Fixed deadlock when changing linked component repository."
msgstr "ແກ້ໄຂການເກີດ deadlock ເມື່ອປ່ຽນ repository ຂອງອົງປະກອບທີ່ເຊື່ອມໂຍງ."

msgid "Included edit distance in changes listing and CSV and reports."
msgstr "ລວມໄລຍະຫ່າງການແກ້ໄຂໃນລາຍການການປ່ຽນແປງ, CSV ແລະ ບົດລາຍງານ."

msgid "Avoid false positives of punctuation spacing check for Canadian French."
msgstr "ຫຼີກເວັ້ນຜົນຜິດພາດຂອງການກວດສອບຊ່ອງຫວ່າງເຄື່ອງໝາຍວັກຕອນສຳລັບພາສາຝຣັ່ງການາດາ."

msgid "Fixed XLIFF export with placeholders."
msgstr "ແກ້ໄຂການສົ່ງອອກ XLIFF ທີ່ມີຕົວແທນ."

msgid "Fixed false positive with zero width check."
msgstr "ແກ້ໄຂຜົນຜິດພາດກັບການກວດສອບຄວາມກວ້າງສູນ."

msgid "Improved reporting of configuration errors."
msgstr "ປັບປຸງການລາຍງານຂໍ້ຜິດພາດຂອງການຕັ້ງຄ່າ."

msgid "Fixed bilingual source upload."
msgstr "ແກ້ໄຂການອັບໂຫຼດຕົ້ນສະບັບສອງພາສາ."

msgid "Automatically detect supported languages for DeepL machine translation."
msgstr "ກວດສອບພາສາທີ່ຮອງຮັບສຳລັບການແປພາສາດ້ວຍເຄື່ອງຈັກ DeepL ໂດຍອັດຕະໂນມັດ."

msgid "Fixed progress bar display in some corner cases."
msgstr "ແກ້ໄຂການສະແດງແຖບຄວາມຄືບໜ້າໃນບາງກໍລະນີພິເສດ."

msgid "Fixed some checks triggering on non translated strings."
msgstr "ແກ້ໄຂບາງການກວດສອບທີ່ເຮັດວຽກກັບຂໍ້ຄວາມທີ່ຍັງບໍ່ໄດ້ແປ."

msgid "Weblate 4.0.1"
msgstr "Weblate 4.0.1"

msgid "*Released on April 16th 2020.*"
msgstr "*ອອກເຜີຍແຜ່ເມື່ອວັນທີ 16 ເມສາ 2020.*"

msgid "Fixed package installation from PyPI."
msgstr "ແກ້ໄຂການຕິດຕັ້ງແພັກເກັດຈາກ PyPI."

msgid "Weblate 4.0"
msgstr "Weblate 4.0"

msgid "Weblate now requires Python 3.6 or newer."
msgstr "ຕອນນີ້ Weblate ຕ້ອງການ Python 3.6 ຫຼື ໃໝ່ກວ່າ."

msgid "Added management overview of component alerts."
msgstr "ເພີ່ມພາບລວມການຈັດການການແຈ້ງເຕືອນອົງປະກອບ."

msgid "Added component alert for broken repository browser URLs."
msgstr "ເພີ່ມການແຈ້ງເຕືອນອົງປະກອບສຳລັບ URL ຕົວທ່ອງເວັບ repository ທີ່ເສຍຫາຍ."

msgid "Improved sign in and registration pages."
msgstr "ປັບປຸງໜ້າເຂົ້າສູ່ລະບົບ ແລະ ລົງທະບຽນ."

msgid ""
"Project access control and workflow configuration integrated to project "
"settings."
msgstr ""
"ການຄວບຄຸມການເຂົ້າເຖິງໂຄງການ ແລະ ການຕັ້ງຄ່າຂັ້ນຕອນການເຮັດວຽກຖືກລວມເຂົ້າໃນການຕັ້ງຄ່າໂຄງການ."

msgid "Added check and highlighter for i18next interpolation and nesting."
msgstr "ເພີ່ມການກວດສອບ ແລະ ໄຮໄລ້ສຳລັບ i18next interpolation ແລະ nesting."

msgid "Added check and highlighter for percent placeholders."
msgstr "ເພີ່ມການກວດສອບ ແລະ ໄຮໄລ້ສຳລັບຕົວແທນເປີເຊັນ."

msgid "Display suggestions failing checks."
msgstr "ສະແດງຄຳແນະນຳທີ່ບໍ່ຜ່ານການກວດສອບ."

msgid "Record source string changes in history."
msgstr "ບັນທຶກການປ່ຽນແປງຂໍ້ຄວາມຕົ້ນສະບັບໃນປະຫວັດ."

msgid "Upgraded Microsoft Translator to version 3 API."
msgstr "ອັບເກຣດ Microsoft Translator ເປັນເວີຊັນ 3 API."

msgid "Reimplemented translation memory backend."
msgstr "ປັບປຸງການຈັດການ backend ໜ່ວຍຄວາມຈຳການແປພາສາໃໝ່."

msgid "Added support for several ``is:`` lookups in :doc:`/user/search`."
msgstr "ເພີ່ມການຮອງຮັບການຄົ້ນຫາ ``is:`` ຫຼາຍຢ່າງໃນ :doc:`/user/search`."

msgid "Allow to make :ref:`check-same` avoid the built-in words exceptions."
msgstr "ອະນຸຍາດໃຫ້ :ref:`check-same` ຫຼີກເວັ້ນຂໍ້ຍົກເວັ້ນຄຳສັບໃນຕົວ."

msgid "Improved comments extraction from monolingual po files."
msgstr "ປັບປຸງການສະກັດຄວາມຄິດເຫັນຈາກໄຟລ໌ po ພາສາດຽວ."

msgid "Renamed whiteboard messages to announcements."
msgstr "ປ່ຽນຊື່ຂໍ້ຄວາມກະດານຂາວເປັນການປະກາດ."

msgid "Fixed occasional problems with registration mails."
msgstr "ແກ້ໄຂບັນຫາບາງຄັ້ງຄາວກັບອີເມວລົງທະບຽນ."

msgid "Improved LINGUAS update add-on to handle more syntax variants."
msgstr "ປັບປຸງສ່ວນເສີມອັບເດດ LINGUAS ເພື່ອຈັດການກັບ variants ທາງໄວຍາກອນຫຼາຍຂຶ້ນ."

msgid "Fixed editing monolingual XLIFF source file."
msgstr "ແກ້ໄຂການແກ້ໄຂໄຟລ໌ຕົ້ນສະບັບ XLIFF ພາສາດຽວ."

msgid "Added support for exact matching in :doc:`/user/search`."
msgstr "ເພີ່ມການຮອງຮັບການຈັບຄູ່ທີ່ແນ່ນອນໃນ :doc:`/user/search`."

msgid ""
"Extended API to cover screenshots, users, groups, componentlists and "
"extended creating projects."
msgstr ""
"ຂະຫຍາຍ API ໃຫ້ກວມເອົາພາບໜ້າຈໍ, ຜູ້ໃຊ້, ກຸ່ມ, ລາຍການອົງປະກອບ ແລະ ການສ້າງໂຄງການແບບຂະຫຍາຍ."

msgid "Add support for source upload on bilingual translations."
msgstr "ເພີ່ມການຮອງຮັບການອັບໂຫຼດຕົ້ນສະບັບໃນການແປພາສາດຽວ."

msgid "Added support for intermediate language from developers."
msgstr "ເພີ່ມການຮອງຮັບພາສາກາງຈາກນັກພັດທະນາ."

msgid "Added support for source strings review."
msgstr "ເພີ່ມການຮອງຮັບການກວດສອບຂໍ້ຄວາມຕົ້ນສະບັບ."

msgid "Extended download options for platform wide translation memory."
msgstr "ຂະຫຍາຍຕົວເລືອກດາວໂຫຼດສຳລັບໜ່ວຍຄວາມຈຳການແປພາສາທັງແພລັດຟອມ."

msgid "Weblate 5.x series"
msgstr "Weblate ຊຸດ 5.x"

msgid "Weblate 5.17.1"
msgstr "Weblate 5.17.1"

msgid "*Released on April 30th 2026.*"
msgstr "*ອອກເຜີຍແຜ່ເມື່ອວັນທີ 30 ເມສາ 2026.*"

msgid ""
"Add-ons that opt in to manual triggering can now be run from add-on "
"management and the :ref:`addons-api`."
msgstr ""
"ສ່ວນເສີມທີ່ເລືອກໃຊ້ການກະຕຸ້ນດ້ວຍຕົນເອງຕອນນີ້ສາມາດດຳເນີນງານໄດ້ຈາກການຈັດການສ່ວນເສີມ "
"ແລະ :ref:`addons-api`."

msgid ""
"Admins can now clean up blocked or abusive users by reverting edits, "
"rejecting pending suggestions, and deleting comments across project or site-"
"wide scopes."
msgstr ""
"ຜູ້ເບິ່ງແຍງລະບົບຕອນນີ້ສາມາດຈັດການກັບຜູ້ໃຊ້ທີ່ຖືກບລັອກ ຫຼື ໃຊ້ໃນທາງທີ່ຜິດໂດຍການຍົກເລີກການແກ້ໄຂ, "
"ປະຕິເສດຄຳແນະນຳທີ່ຄ້າງຢູ່, ແລະ ລຶບຄວາມຄິດເຫັນທົ່ວໂຄງການ ຫຼື ທົ່ວເວັບໄຊ."

msgid "Admin user management can now find users by audit log IP address."
msgstr "ການຈັດການຜູ້ໃຊ້ຂອງຜູ້ເບິ່ງແຍງລະບົບຕອນນີ້ສາມາດຊອກຫາຜູ້ໃຊ້ດ້ວຍທີ່ຢູ່ IP ຂອງ audit log."

msgid ""
":doc:`/admin/announcements` can now also be managed via the :ref:`api` for "
"categories."
msgstr ""
":doc:`/admin/announcements` ຕອນນີ້ສາມາດຈັດການຜ່ານ :ref:`api` ສຳລັບໝວດໝູ່ໄດ້ເຊັ່ນກັນ."

msgid "Added :ref:`mt-ltengine` machine translation service."
msgstr "ເພີ່ມບໍລິການແປພາສາດ້ວຍເຄື່ອງຈັກ :ref:`mt-ltengine`."

msgid ""
"Improved documentation for the global ``user.edit`` "
"permission, :ref:`autoclean-tm`, :ref:`glossary-terminology`, and "
"current :ref:`translation-memory` management options in the UI."
msgstr ""
"ປັບປຸງເອກະສານສຳລັບສິດ ``user.edit`` ທົ່ວໂລກ, :ref:`autoclean-tm`, :ref:`glossary-"
"terminology`, ແລະ ຕົວເລືອກການຈັດການ :ref:`translation-memory` ໃນ UI."

msgid ""
"Improved :ref:`screenshots` documentation and linked it from the screenshots "
"UI."
msgstr "ປັບປຸງເອກະສານ :ref:`screenshots` ແລະ ເຊື່ອມຕໍ່ຈາກ UI ພາບໜ້າຈໍ."

msgid ""
"Documented restoring Docker-based setups from backups, see :ref:`restore-"
"docker`."
msgstr ""
"ສ້າງເອກະສານການກູ້ຄືນການຕັ້ງຄ່າແບບ Docker ຈາກການສຳຮອງຂໍ້ມູນ, ເບິ່ງ :ref:`restore-docker`."

msgid ""
"Clarified :ref:`generic-upgrade-instructions` to state that Celery queues "
"should be empty before upgrading."
msgstr ""
"ຊີ້ແຈງ :ref:`generic-upgrade-instructions` ວ່າແຖວ Celery ຄວນຫວ່າງເປົ່າກ່ອນການອັບເກຣດ."

msgid ""
"The OpenAPI schema is cleaner and now describes action endpoints with their "
"actual list, statistics, status, upload, and download response payloads."
msgstr ""
"OpenAPI schema ສະອາດຂຶ້ນ ແລະ ຕອນນີ້ອະທິບາຍ endpoint ການກະທຳດ້ວຍລາຍການ, ສະຖິຕິ, "
"ສະຖານະ, ອັບໂຫຼດ ແລະ ດາວໂຫຼດ payload ຕອບກັບຕົວຈິງ."

msgid ""
"The web installation flow for :ref:`addon-weblate.consistency.languages` now "
"shows a preview and requires confirmation before creating missing language "
"files across projects, categories, or site-wide scopes."
msgstr ""
"ຂັ້ນຕອນການຕິດຕັ້ງເວັບສຳລັບ :ref:`addon-weblate.consistency.languages` "
"ຕອນນີ້ສະແດງຕົວຢ່າງ ແລະ ຕ້ອງການການຢືນຢັນກ່ອນສ້າງໄຟລ໌ພາສາທີ່ຂາດຫາຍໄປໃນທົ່ວໂຄງການ, ໝວດໝູ່, ຫຼື "
"ທົ່ວເວັບໄຊ."

msgid ""
":ref:`addon-weblate.discovery.discovery` now offers guided client-side "
"presets, suggests presets detected from component repository layouts, "
"validates ``{{ component }}`` more clearly, and includes a worked discovery-"
"template example in the docs."
msgstr ""
":ref:`addon-weblate.discovery.discovery` ຕອນນີ້ສະເໜີ presets ຝັ່ງລູກຄ້າທີ່ມີຄຳແນະນຳ, "
"ແນະນຳ presets ທີ່ກວດພົບຈາກໂຄງສ້າງ repository ອົງປະກອບ, ຢືນຢັນ ``{{ component }}`` "
"ໄດ້ຊັດເຈນຂຶ້ນ, ແລະ ລວມຕົວຢ່າງ discovery-template ທີ່ເຮັດວຽກໄດ້ໃນເອກະສານ."

msgid ""
"Superuser and site-wide team changes are now tracked in :ref:`audit-log`."
msgstr "ການປ່ຽນແປງຂອງ Superuser ແລະ ທີມງານທົ່ວເວັບໄຊຕອນນີ້ຖືກຕິດຕາມໃນ :ref:`audit-log`."

msgid ""
"URL validation alerts now show clearer errors for project website and "
"repository browser URLs, and project-level machine translation validation "
"better explains private or local endpoint restrictions on hosted and self-"
"managed sites."
msgstr ""
"ການແຈ້ງເຕືອນການຢືນຢັນ URL ຕອນນີ້ສະແດງຂໍ້ຜິດພາດທີ່ຊັດເຈນຂຶ້ນສຳລັບ URL ເວັບໄຊໂຄງການ ແລະ "
"ຕົວທ່ອງເວັບ repository, ແລະ ການຢືນຢັນການແປພາສາດ້ວຍເຄື່ອງຈັກລະດັບໂຄງການອະທິບາຍຂໍ້ຈຳກັດ "
"endpoint ສ່ວນຕົວ ຫຼື ທ້ອງຖິ່ນໃນເວັບໄຊທີ່ເປັນເຈົ້າພາບ ແລະ ຈັດການເອງໄດ້ດີຂຶ້ນ."

msgid ""
":ref:`addon-weblate.autotranslate.autotranslate` now attributes copied "
"translations to the add-on user and records automatic translation results in "
"the add-on activity log."
msgstr ""
":ref:`addon-weblate.autotranslate.autotranslate` "
"ຕອນນີ້ກຳນົດຄຳແປທີ່ຖືກຄັດລອກໃຫ້ກັບຜູ້ໃຊ້ສ່ວນເສີມ ແລະ "
"ບັນທຶກຜົນການແປພາສາອັດຕະໂນມັດໃນບັນທຶກກິດຈະກຳຂອງສ່ວນເສີມ."

msgid ""
"Extended the conflicting repository setup alert to direct Git pushes, "
"see :ref:`alerts`."
msgstr ""
"ຂະຫຍາຍການແຈ້ງເຕືອນການຕັ້ງຄ່າ repository ທີ່ຂັດແຍ້ງກັນໄປສູ່ການຍູ້ Git ໂດຍກົງ, "
"ເບິ່ງ :ref:`alerts`."

msgid ":ref:`profile` links now show an external-link warning where possible."
msgstr "ລິ້ງ :ref:`profile` ຕອນນີ້ສະແດງຄຳເຕືອນລິ້ງພາຍນອກບ່ອນທີ່ເປັນໄປໄດ້."

msgid ""
"Client-side popup notifications triggered by JavaScript now use Bootstrap "
"toasts, with higher-contrast dark theme colors for Bootstrap subtle and "
"emphasis variants."
msgstr ""
"ການແຈ້ງເຕືອນປັອບອັບຝັ່ງລູກຄ້າທີ່ຖືກກະຕຸ້ນໂດຍ JavaScript ຕອນນີ້ໃຊ້ Bootstrap toasts, "
"ພ້ອມດ້ວຍສີຕີມມື້ທີ່ມີຄອນທຣາດສູງກວ່າສຳລັບ variants ຂອງ Bootstrap subtle ແລະ emphasis."

msgid ""
"The :guilabel:`SSH keys` management page can now remove stored host keys so "
"changed host keys can be replaced there."
msgstr ""
"ໜ້າການຈັດການ :guilabel:`SSH keys` ຕອນນີ້ສາມາດລຶບ host keys ທີ່ເກັບໄວ້ເພື່ອໃຫ້ສາມາດປ່ຽນ "
"host keys ທີ່ປ່ຽນແປງໄດ້."

msgid ""
"Project listings now show review progress columns when any listed project "
"has reviews enabled."
msgstr "ລາຍການໂຄງການຕອນນີ້ສະແດງຄໍລຳຄວາມຄືບໜ້າການກວດສອບເມື່ອໂຄງການໃດໜຶ່ງທີ່ລະບຸໄວ້ເປີດໃຊ້ງານການກວດສອບ."

msgid ""
"Image URLs in Markdown are now escaped before rendering "
"(:cve:`2026-44264` / :ghsa:`5cmv-3rc4-7279`)."
msgstr ""
"URL ຮູບພາບໃນ Markdown ຕອນນີ້ຖືກ escape ກ່ອນການສະແດງຜົນ "
"(:cve:`2026-44264` / :ghsa:`5cmv-3rc4-7279`)."

msgid ""
"Tightened :ref:`api` input validation to prevent translation enumeration "
"(:cve:`2026-44263` / :ghsa:`gcg5-86jr-f7jg`)."
msgstr ""
"ເພີ່ມຄວາມເຂັ້ມງວດໃນການຢືນຢັນການປ້ອນຂໍ້ມູນ :ref:`api` ເພື່ອປ້ອງກັນການນັບລາຍຊື່ການແປພາສາ "
"(:cve:`2026-44263` / :ghsa:`gcg5-86jr-f7jg`)."

msgid ""
"Project backup imports now revalidate component repository URLs before "
"restoring from backup (:cve:`2026-41654` / :ghsa:`cwcx-382v-8m9g`)."
msgstr ""
"ການນຳເຂົ້າການສຳຮອງຂໍ້ມູນໂຄງການຕອນນີ້ກວດສອບ URL repository "
"ອົງປະກອບຄືນກ່ອນການກູ້ຄືນຈາກການສຳຮອງ (:cve:`2026-41654` / :ghsa:`cwcx-382v-8m9g`)."

msgid ""
"Fixed revert links in the translate-view history tab after moving a "
"component to another project."
msgstr "ແກ້ໄຂລິ້ງຍົກເລີກໃນແຖບປະຫວັດການເບິ່ງການແປພາສາຫຼັງຈາກຍ້າຍອົງປະກອບໄປໂຄງການອື່ນ."

msgid ""
"Invitation acceptance now verifies the invited e-mail address and invitation "
"expiry before granting team membership."
msgstr ""
"ການຍອມຮັບຄຳເຊີນຕອນນີ້ຢືນຢັນທີ່ຢູ່ອີເມວທີ່ຖືກເຊີນ ແລະ "
"ວັນໝົດອາຍຸຂອງຄຳເຊີນກ່ອນການມອບສິດການເປັນສະມາຊິກທີມ."

msgid ""
":ref:`check-rst-references` no longer crashes on repeated explicit-link "
"targets."
msgstr ":ref:`check-rst-references` ບໍ່ປິດເອງອີກຕໍ່ໄປເມື່ອມີການເປົ້າໝາຍລິ້ງທີ່ຊັດເຈນຊ້ຳກັນ."

msgid ""
"The :ref:`addons-api` now validates required add-on configuration when "
"installing add-ons."
msgstr ":ref:`addons-api` ຕອນນີ້ຢືນຢັນການຕັ້ງຄ່າສ່ວນເສີມທີ່ຈຳເປັນເມື່ອຕິດຕັ້ງສ່ວນເສີມ."

msgid ""
"Component updates no longer time out waiting on their own repository lock "
"during validation."
msgstr ""
"ການອັບເດດອົງປະກອບບໍ່ມີການໝົດເວລາໃນການລໍຖ້າການລັອກ repository ຂອງຕົນເອງໃນລະຫວ່າງການຢືນຢັນ."

msgid ""
":ref:`check-punctuation-spacing` check no longer triggers false positives "
"for placeholders."
msgstr ""
"ການກວດສອບ :ref:`check-punctuation-spacing` ບໍ່ເຮັດໃຫ້ເກີດຜົນຜິດພາດສຳລັບຕົວແທນອີກຕໍ່ໄປ."

msgid ""
"Repository alerts, history entries, and task messages now preserve multiline "
"Git and SSH backend error output."
msgstr ""
"ການແຈ້ງເຕືອນ repository, ລາຍການປະຫວັດ, ແລະ ຂໍ້ຄວາມວຽກງານຕອນນີ້ຮັກສາຜົນຂໍ້ຜິດພາດ Git ແລະ "
"SSH backend ແບບຫຼາຍແຖວ."

msgid ""
"Interrupted Git rebases now recover more reliably after worker restarts, and "
"signal-terminated backend commands are reported more clearly."
msgstr ""
"ການ Rebase Git ທີ່ຖືກຂັດຂວາງຕອນນີ້ກູ້ຄືນໄດ້ເຊື່ອຖືໄດ້ຫຼາຍຂຶ້ນຫຼັງຈາກ worker ເລີ່ມຕົ້ນໃໝ່, ແລະ ຄຳສັ່ງ "
"backend ທີ່ຖືກຍົກເລີກໂດຍສັນຍານຈະຖືກລາຍງານຢ່າງຊັດເຈນຂຶ້ນ."

msgid ""
"Borg backups that finish with warnings are no longer shown as failed in the "
"management UI, and backup logs now show ``C`` entries for files that changed "
"during the backup."
msgstr ""
"ການສຳຮອງຂໍ້ມູນ Borg ທີ່ສຳເລັດພ້ອມຄຳເຕືອນບໍ່ຖືກສະແດງວ່າລົ້ມເຫຼວໃນ UI ການຈັດການອີກຕໍ່ໄປ, ແລະ log "
"ການສຳຮອງຂໍ້ມູນຕອນນີ້ສະແດງລາຍການ ``C`` ສຳລັບໄຟລ໌ທີ່ປ່ຽນແປງໃນລະຫວ່າງການສຳຮອງ."

msgid ""
"Git exporter no longer rejects shared-history fetches just because the first "
"negotiated ``have`` revisions are newer than Weblate's local history."
msgstr ""
"Git exporter ບໍ່ປະຕິເສດການດຶງຂໍ້ມູນ shared-history ພຽງເພາະວ່າ ``have`` revisions "
"ທຳອິດທີ່ເຈລະຈາໃໝ່ກວ່າປະຫວັດທ້ອງຖິ່ນຂອງ Weblate."

msgid ""
":ref:`mt-weblate-translation-memory` automatic translation avoids broad "
"PostgreSQL searches."
msgstr ""
"ການແປພາສາອັດຕະໂນມັດ :ref:`mt-weblate-translation-memory` ຫຼີກເວັ້ນການຄົ້ນຫາ "
"PostgreSQL ແບບກວ້າງ."

msgid "Malformed IPv6 repository URLs no longer crash SSH host key detection."
msgstr "URL repository IPv6 ທີ່ບໍ່ຖືກຕ້ອງບໍ່ເຮັດໃຫ້ການກວດສອບ SSH host key ປິດເອງອີກຕໍ່ໄປ."

msgid ""
":ref:`addon-weblate.gettext.xgettext` and related POT update add-ons now "
"replace the standard descriptive-title placeholder in normalized POT headers "
"again."
msgstr ""
":ref:`addon-weblate.gettext.xgettext` ແລະ ສ່ວນເສີມອັບເດດ POT "
"ທີ່ກ່ຽວຂ້ອງຕອນນີ້ແທນທີ່ຕົວແທນຊື່-ຄຳອະທິບາຍມາດຕະຖານໃນ headers POT ທີ່ຖືກປັບໃຫ້ເປັນປົກກະຕິອີກຄັ້ງ."

msgid ""
":ref:`addon-weblate.gettext.django` now skips repository ``locale`` trees "
"during preflight validation, fixing components that store ``django.pot`` in "
"a top-level ``locale`` directory."
msgstr ""
":ref:`addon-weblate.gettext.django` ຕອນນີ້ຂ້າມຕົ້ນໄມ້ ``locale`` ຂອງ repository "
"ໃນລະຫວ່າງການຢືນຢັນເບື້ອງຕົ້ນ, ແກ້ໄຂອົງປະກອບທີ່ເກັບ ``django.pot`` ໄວ້ໃນໄດເລກະທໍລີ "
"``locale`` ລະດັບສູງສຸດ."

msgid ""
"Screenshot OCR now skips corrupted or truncated image files instead of "
"failing the request."
msgstr "Screenshot OCR ຕອນນີ້ຂ້າມໄຟລ໌ຮູບພາບທີ່ເສຍຫາຍ ຫຼື ຖືກຕັດອອກແທນທີ່ຈະເຮັດໃຫ້ຄຳຮ້ອງຂໍລົ້ມເຫຼວ."

msgid ""
"Monolingual component validation now honors :ref:`component-source_language` "
"when checking duplicate files alongside a separate :ref:`component-template`."
msgstr ""
"ການຢືນຢັນອົງປະກອບພາສາດຽວຕອນນີ້ໃຫ້ຄວາມສຳຄັນກັບ :ref:`component-source_language` "
"ເມື່ອກວດສອບໄຟລ໌ຊ້ຳກັນຄຽງຄູ່ກັບ :ref:`component-template` ແຍກຕ່າງຫາກ."

msgid ""
":ref:`Translation memory upload <memory-user>` and :wladmin:`import_memory` "
"now report a validation error for TMX files missing the required header "
"instead of failing the request."
msgstr ""
":ref:`Translation memory upload <memory-user>` ແລະ :wladmin:`import_memory` "
"ຕອນນີ້ລາຍງານຂໍ້ຜິດພາດການຢືນຢັນສຳລັບໄຟລ໌ TMX ທີ່ຂາດ header ທີ່ຈຳເປັນແທນທີ່ຈະເຮັດໃຫ້ຄຳຮ້ອງຂໍລົ້ມເຫຼວ."

msgid ""
":ref:`mt-weblate-translation-memory` no longer misses boundary similarity "
"matches after stricter lookups."
msgstr ""
":ref:`mt-weblate-translation-memory` "
"ບໍ່ພາດການຈັບຄູ່ຄວາມຄ້າຍຄືກັນຂອງຂອບເຂດຫຼັງຈາກການຄົ້ນຫາທີ່ເຂັ້ມງວດຂຶ້ນ."

msgid ""
"The missing file-mask matches :ref:`alert <alerts>` is now restored after "
"rescans that leave only the source translation."
msgstr ""
"ການຈັບຄູ່ file-mask ທີ່ຂາດຫາຍໄປ :ref:`alert <alerts>` "
"ຕອນນີ້ຖືກກູ້ຄືນຫຼັງຈາກການສະແກນໃໝ່ທີ່ເຫຼືອພຽງແຕ່ການແປພາສາຕົ້ນສະບັບ."

msgid ""
":ref:`addon-weblate.discovery.discovery` now disables inherited string "
"management for discovered formats that do not support adding or removing "
"strings."
msgstr ""
":ref:`addon-weblate.discovery.discovery` "
"ຕອນນີ້ປິດໃຊ້ງານການຈັດການຂໍ້ຄວາມທີ່ສືບທອດມາສຳລັບຮູບແບບທີ່ຄົ້ນພົບທີ່ບໍ່ຮອງຮັບການເພີ່ມ ຫຼື ລຶບຂໍ້ຄວາມ."

msgid ""
"Automatic translation from other components now ignores read-only source "
"candidates with empty translations."
msgstr "ການແປພາສາອັດຕະໂນມັດຈາກອົງປະກອບອື່ນຕອນນີ້ລະເລີຍຜູ້ສະໝັກຕົ້ນສະບັບແບບອ່ານຢ່າງດຽວທີ່ມີການແປພາສາຫວ່າງເປົ່າ."

msgid ""
"Project component pagination now keeps the :guilabel:`Components` tab active "
"when jumping to a typed page number."
msgstr ""
"ການແບ່ງໜ້າອົງປະກອບໂຄງການຕອນນີ້ຮັກສາແຖບ :guilabel:`Components` "
"ໃຫ້ໃຊ້ງານຢູ່ເມື່ອກະໂດດໄປຫາໝາຍເລກໜ້າທີ່ພິມ."

msgid ""
"Markdown rendering now falls back to escaped plain text when the parser "
"fails."
msgstr "ການສະແດງຜົນ Markdown ຕອນນີ້ກັບໄປໃຊ້ plain text ທີ່ຖືກ escape ເມື່ອຕົວແຍກລົ້ມເຫຼວ."

msgid ""
"Forgejo and Gitea test deliveries with sample loopback repository URLs no "
"longer trigger slow suffix matching against all components."
msgstr ""
"ການຈັດສົ່ງທົດສອບ Forgejo ແລະ Gitea ດ້ວຍ URL repository ຕົວຢ່າງ loopback ບໍ່ກະຕຸ້ນການຈັບຄູ່ "
"suffix ທີ່ຊ້າກັບທຸກອົງປະກອບອີກຕໍ່ໄປ."

msgid ""
"Password changes now regenerate personal API keys by default "
"(:cve:`2026-41519` / :ghsa:`6j8j-4qp3-36p2`)."
msgstr ""
"ການປ່ຽນລະຫັດຜ່ານຕອນນີ້ສ້າງ personal API keys ຄືນໃໝ່ໂດຍຄ່າເລີ່ມຕົ້ນ "
"(:cve:`2026-41519` / :ghsa:`6j8j-4qp3-36p2`)."

msgid ""
":setting:`VCS_RESTRICT_PRIVATE` and :setting:`WEBHOOK_RESTRICT_PRIVATE` now "
"reject URLs whose hostnames cannot be resolved during validation unless the "
"host is explicitly allowed."
msgstr ""
":setting:`VCS_RESTRICT_PRIVATE` ແລະ :setting:`WEBHOOK_RESTRICT_PRIVATE` "
"ຕອນນີ້ປະຕິເສດ URL ທີ່ບໍ່ສາມາດແກ້ໄຂ hostname ໄດ້ໃນລະຫວ່າງການຢືນຢັນເວັ້ນເສຍແຕ່ host "
"ຈະຖືກອະນຸຍາດຢ່າງຈະແຈ້ງ."

msgid ""
":ref:`profile` URL validation now rejects obvious direct file download URLs "
"and invalid code site or Fediverse profile links."
msgstr ""
"ການຢືນຢັນ URL :ref:`profile` ຕອນນີ້ປະຕິເສດ URL ດາວໂຫຼດໄຟລ໌ໂດຍກົງທີ່ຊັດເຈນ ແລະ "
"ລິ້ງເວັບໄຊໂຄ້ດ ຫຼື ໂປຣໄຟລ໌ Fediverse ທີ່ບໍ່ຖືກຕ້ອງ."

msgid ""
"Uploads now "
"enforce :setting:`TRANSLATION_UPLOAD_MAX_SIZE`, :setting:`COMPONENT_ZIP_UPLOAD_MAX_SIZE`, "
"and :setting:`PROJECT_BACKUP_UPLOAD_MAX_SIZE` before parsing. Component ZIP "
"imports and project backup restores now share stricter ZIP archive safety "
"checks, including total uncompressed data limits for project backup imports."
msgstr ""
"ການອັບໂຫຼດຕອນນີ້ບັງຄັບໃຊ້ :setting:`TRANSLATION_UPLOAD_MAX_SIZE`, :setting:`COMPONENT_ZIP_UPLOAD_MAX_SIZE`, "
"ແລະ :setting:`PROJECT_BACKUP_UPLOAD_MAX_SIZE` ກ່ອນການແຍກວິເຄາະ. ການນຳເຂົ້າ "
"Component ZIP ແລະ ການກູ້ຄືນການສຳຮອງຂໍ້ມູນໂຄງການຕອນນີ້ແບ່ງປັນການກວດສອບຄວາມປອດໄພຂອງ ZIP "
"archive ທີ່ເຂັ້ມງວດຂຶ້ນ, ລວມທັງຂີດຈຳກັດຂໍ້ມູນທີ່ບໍ່ໄດ້ບີບອັດທັງໝົດສຳລັບການນຳເຂົ້າການສຳຮອງຂໍ້ມູນໂຄງການ."

msgid ""
"`All changes in detail <https://github.com/WeblateOrg/weblate/milestone/164?"
"closed=1>`__."
msgstr ""
"`ລາຍລະອຽດການປ່ຽນແປງທັງໝົດ <https://github.com/WeblateOrg/weblate/milestone/164?"
"closed=1>`__."

msgid "Weblate 5.17"
msgstr "Weblate 5.17"

msgid "*Released on April 15th 2026.*"
msgstr "*ອອກເຜີຍແຜ່ເມື່ອວັນທີ 15 ເມສາ 2026.*"

msgid ""
"Added :setting:`PROJECT_WEB_RESTRICT_ALLOWLIST` to exempt selected project "
"slugs from project website restriction settings."
msgstr ""
"ເພີ່ມ :setting:`PROJECT_WEB_RESTRICT_ALLOWLIST` ເພື່ອຍົກເວັ້ນ project slugs "
"ທີ່ເລືອກຈາກການຕັ້ງຄ່າຂໍ້ຈຳກັດເວັບໄຊໂຄງການ."

msgid ""
"Added :setting:`WEBSITE_ALERTS_ENABLED` setting to allow disabling project "
"website availability checks and alerts."
msgstr ""
"ເພີ່ມການຕັ້ງຄ່າ :setting:`WEBSITE_ALERTS_ENABLED` "
"ເພື່ອອະນຸຍາດໃຫ້ປິດໃຊ້ງານການກວດສອບຄວາມພ້ອມໃຊ້ງານ ແລະ ການແຈ້ງເຕືອນເວັບໄຊໂຄງການ."

msgid ""
"Added new management command :wladmin:`list_format_features`, which "
"generates RST documentation snippets describing the supported features for "
"every file format."
msgstr ""
"ເພີ່ມຄຳສັ່ງຈັດການໃໝ່ :wladmin:`list_format_features`, ເຊິ່ງສ້າງເອກະສານ RST snippets "
"ທີ່ອະທິບາຍຄຸນສົມບັດທີ່ຮອງຮັບສຳລັບທຸກຮູບແບບໄຟລ໌."

msgid ""
"Shared components can now be categorized within the target project, "
"including through the :ref:`api` using the ``category_id`` parameter."
msgstr ""
"ອົງປະກອບທີ່ແບ່ງປັນຕອນນີ້ສາມາດຈັດໝວດໝູ່ພາຍໃນໂຄງການເປົ້າໝາຍໄດ້, ລວມທັງຜ່ານ :ref:`api` "
"ໂດຍໃຊ້ພາລາມິເຕີ ``category_id``."

msgid ""
"Added :ref:`addon-weblate.gettext.xgettext`, :ref:`addon-"
"weblate.gettext.meson`, :ref:`addon-weblate.gettext.django`, and :ref:`addon-"
"weblate.gettext.sphinx` to update POT files with configurable update cadence."
msgstr ""
"ເພີ່ມ :ref:`addon-weblate.gettext.xgettext`, :ref:`addon-"
"weblate.gettext.meson`, :ref:`addon-weblate.gettext.django`, ແລະ :ref:`addon-"
"weblate.gettext.sphinx` ເພື່ອອັບເດດໄຟລ໌ POT ດ້ວຍຈັງຫວະການອັບເດດທີ່ສາມາດຕັ້ງຄ່າໄດ້."

msgid ""
"Added :setting:`PASSWORD_RESET_URL` to customize the sign-in page password "
"reset link, useful for external identity providers (Docker "
"env: :envvar:`WEBLATE_PASSWORD_RESET_URL`)."
msgstr ""
"ເພີ່ມ :setting:`PASSWORD_RESET_URL` ເພື່ອປັບແຕ່ງລິ້ງຣີເຊັດລະຫັດຜ່ານໃນໜ້າເຂົ້າສູ່ລະບົບ, "
"ເຊິ່ງເປັນປະໂຫຍດສຳລັບຜູ້ໃຫ້ບໍລິການຕົວຕົນພາຍນອກ (Docker "
"env: :envvar:`WEBLATE_PASSWORD_RESET_URL`)."

msgid "Added :ref:`bulk user invitations <invite-user>`."
msgstr "ເພີ່ມ :ref:`bulk user invitations <invite-user>`."

msgid "Added :ref:`check-objc-format`."
msgstr "ເພີ່ມ :ref:`check-objc-format`."

msgid ""
"Added Forgejo notification webhook, see :ref:`Forgejo notifications <code-"
"hosting-forgejo-notifications>`."
msgstr ""
"ເພີ່ມ Forgejo notification webhook, ເບິ່ງ :ref:`Forgejo notifications <code-"
"hosting-forgejo-notifications>`."

msgid ""
"Added translation memory API filtering, scoped access, and bulk lookup "
"support."
msgstr ""
"ເພີ່ມການກັ່ນຕອງ API ໜ່ວຍຄວາມຈຳການແປພາສາ, ການເຂົ້າເຖິງແບບ scoped, ແລະ "
"ການຮອງຮັບການຄົ້ນຫາແບບກຸ່ມ."

msgid ""
"Added ``from_component`` support to the REST API for creating components "
"from existing component content and for seeding new translations by "
"automatic translation from existing components."
msgstr ""
"ເພີ່ມການຮອງຮັບ ``from_component`` ໃນ REST API "
"ສຳລັບການສ້າງອົງປະກອບຈາກເນື້ອຫາອົງປະກອບທີ່ມີຢູ່ ແລະ ສຳລັບການ seeding "
"ການແປພາສາໃໝ່ໂດຍການແປພາສາອັດຕະໂນມັດຈາກອົງປະກອບທີ່ມີຢູ່."

msgid ""
":doc:`/admin/announcements` can now be managed via the :ref:`api` for "
"projects, components and translations."
msgstr ""
":doc:`/admin/announcements` ຕອນນີ້ສາມາດຈັດການຜ່ານ :ref:`api` ສຳລັບໂຄງການ, ອົງປະກອບ "
"ແລະ ການແປພາສາ."

msgid ""
"Added a ``soft`` mode to :setting:`VERSION_DISPLAY` to hide the Weblate "
"version from prominent UI while keeping it available on "
"the :guilabel:`About` page and :http:get:`/api/metrics/`."
msgstr ""
"ເພີ່ມໂໝດ ``soft`` ໃນ :setting:`VERSION_DISPLAY` ເພື່ອເຊື່ອງເວີຊັນ Weblate ຈາກ UI "
"ທີ່ໂດດເດັ່ນໃນຂະນະທີ່ຍັງຮັກສາມັນໄວ້ໃນໜ້າ :guilabel:`About` ແລະ :http:get:`/api/metrics/`."

msgid "Track origin of newly added source strings."
msgstr "ຕິດຕາມຕົ້ນທາງຂອງຂໍ້ຄວາມຕົ້ນສະບັບທີ່ເພີ່ມໃໝ່."

msgid ""
"Markdown now uses ``auto-safe-html`` by default, applying :ref:`check-safe-"
"html` and :ref:`autofix-html` only to plain text and source strings that "
"contain standard HTML markup or valid custom elements."
msgstr ""
"Markdown ຕອນນີ້ໃຊ້ ``auto-safe-html`` ໂດຍຄ່າເລີ່ມຕົ້ນ, ນຳໃຊ້ :ref:`check-safe-html` "
"ແລະ :ref:`autofix-html` ສະເພາະກັບ plain text ແລະ ຂໍ້ຄວາມຕົ້ນສະບັບທີ່ມີ markup HTML "
"ມາດຕະຖານ ຫຼື ອົງປະກອບແບບກຳນົດເອງທີ່ຖືກຕ້ອງ."

msgid "Improved LLM interfaces for better reliability."
msgstr "ປັບປຸງອິນເຕີເຟສ LLM ເພື່ອຄວາມເຊື່ອຖືໄດ້ທີ່ດີຂຶ້ນ."

msgid ""
"Improved logic for adding monolingual plurals in :doc:`/formats/gettext`."
msgstr "ປັບປຸງຕັກກະຍະສາດສຳລັບການເພີ່ມຮູບແບບພະຫຸພົດພາສາດຽວໃນ :doc:`/formats/gettext`."

msgid ""
"Added a component alert for conflicting merge request repository setup, "
"see :ref:`alerts`."
msgstr ""
"ເພີ່ມການແຈ້ງເຕືອນອົງປະກອບສຳລັບການຕັ້ງຄ່າ repository ການຮ້ອງຂໍລວມທີ່ຂັດແຍ້ງກັນ, "
"ເບິ່ງ :ref:`alerts`."

msgid "Improved plural handling in :ref:`auto-translation`."
msgstr "ປັບປຸງການຈັດການພະຫຸພົດໃນ :ref:`auto-translation`."

msgid "Improved error messages in some :ref:`api` endpoints."
msgstr "ປັບປຸງຂໍ້ຄວາມຂໍ້ຜິດພາດໃນບາງ endpoint ຂອງ :ref:`api`."

msgid ""
"Updated Microsoft Entra ID authentication docs and Microsoft sign-in "
"branding while keeping legacy Azure AD backend identifiers and documentation "
"anchors for compatibility."
msgstr ""
"ອັບເດດເອກະສານການຢືນຢັນຕົວຕົນ Microsoft Entra ID ແລະ branding ການເຂົ້າສູ່ລະບົບຂອງ "
"Microsoft ໃນຂະນະທີ່ຍັງຮັກສາຕົວລະບຸ backend Azure AD ແບບເດີມ ແລະ anchors "
"ເອກະສານເພື່ອຄວາມເຂົ້າກັນໄດ້."

msgid ""
"Improved performance of project and category search result pages with very "
"large match sets."
msgstr "ປັບປຸງປະສິດທິພາບຂອງໜ້າຜົນການຄົ້ນຫາໂຄງການ ແລະ ໝວດໝູ່ທີ່ມີຊຸດການຈັບຄູ່ຂະໜາດໃຫຍ່."

msgid ""
"Docker now "
"exposes :envvar:`WEBLATE_COMMIT_PENDING_HOURS`, :envvar:`WEBLATE_SOCIAL_AUTH_KEYCLOAK_ID_KEY` "
"for customizing the Keycloak unique user identifier claim, "
"and :envvar:`WEBLATE_NGINX_IPV6` for controlling IPv6 listeners in the "
"bundled NGINX."
msgstr ""
"Docker "
"ຕອນນີ້ເປີດເຜີຍ :envvar:`WEBLATE_COMMIT_PENDING_HOURS`, :envvar:`WEBLATE_SOCIAL_AUTH_KEYCLOAK_ID_KEY` "
"ສຳລັບການປັບແຕ່ງ Keycloak unique user identifier claim, "
"ແລະ :envvar:`WEBLATE_NGINX_IPV6` ສຳລັບການຄວບຄຸມ IPv6 listeners ໃນ NGINX ທີ່ລວມມາ."

msgid ""
"Project history now records project backups and project/component restore "
"events."
msgstr "ປະຫວັດໂຄງການຕອນນີ້ບັນທຶກເຫດການສຳຮອງຂໍ້ມູນໂຄງການ ແລະ ການກູ້ຄືນໂຄງການ/ອົງປະກອບ."

msgid ""
"Improved documentation with auto-generated snippets "
"for :ref:`addons`, :ref:`fmt_capabs`, :ref:`checks`, and :ref:`machine-"
"translation` machines, and clarified merge-conflict behavior for exported "
"repositories using shallow clones by default."
msgstr ""
"ປັບປຸງເອກະສານດ້ວຍ snippets "
"ທີ່ສ້າງຂຶ້ນອັດຕະໂນມັດສຳລັບ :ref:`addons`, :ref:`fmt_capabs`, :ref:`checks`, ແລະ "
"ເຄື່ອງ :ref:`machine-translation`, ແລະ ຊີ້ແຈງພຶດຕິກຳການຂັດແຍ້ງໃນການລວມສຳລັບ "
"repositories ທີ່ສົ່ງອອກທີ່ໃຊ້ shallow clones ໂດຍຄ່າເລີ່ມຕົ້ນ."

msgid ""
"Added :setting:`PROJECT_WEB_RESTRICT_PRIVATE` to reject project website and "
"repository browser URLs targeting internal or non-public "
"addresses, :setting:`WEBHOOK_RESTRICT_PRIVATE` to reject webhook URLs "
"targeting internal or non-public addresses, "
"and :setting:`VCS_RESTRICT_PRIVATE` to reject repository and push URLs "
"targeting internal or non-public addresses. These are exposed in Docker "
"as :envvar:`WEBLATE_PROJECT_WEB_RESTRICT_PRIVATE`, :envvar:`WEBLATE_WEBHOOK_RESTRICT_PRIVATE`, "
"and :envvar:`WEBLATE_VCS_RESTRICT_PRIVATE`."
msgstr ""
"ເພີ່ມ :setting:`PROJECT_WEB_RESTRICT_PRIVATE` ເພື່ອປະຕິເສດ URL ເວັບໄຊໂຄງການ ແລະ "
"ຕົວທ່ອງເວັບ repository ທີ່ແນເປົ້າໝາຍໄປທີ່ທີ່ຢູ່ພາຍໃນ ຫຼື "
"ບໍ່ແມ່ນສາທາລະນະ, :setting:`WEBHOOK_RESTRICT_PRIVATE` ເພື່ອປະຕິເສດ URL webhook "
"ທີ່ແນເປົ້າໝາຍໄປທີ່ທີ່ຢູ່ພາຍໃນ ຫຼື ບໍ່ແມ່ນສາທາລະນະ, ແລະ :setting:`VCS_RESTRICT_PRIVATE` "
"ເພື່ອປະຕິເສດ URL repository ແລະ push ທີ່ແນເປົ້າໝາຍໄປທີ່ທີ່ຢູ່ພາຍໃນ ຫຼື ບໍ່ແມ່ນສາທາລະນະ. "
"ສິ່ງເຫຼົ່ານີ້ຖືກເປີດເຜີຍໃນ Docker "
"ເປັນ :envvar:`WEBLATE_PROJECT_WEB_RESTRICT_PRIVATE`, :envvar:`WEBLATE_WEBHOOK_RESTRICT_PRIVATE`, "
"ແລະ :envvar:`WEBLATE_VCS_RESTRICT_PRIVATE`."

msgid "Improved performance of :ref:`mt-weblate` lookups."
msgstr "ປັບປຸງປະສິດທິພາບຂອງການຄົ້ນຫາ :ref:`mt-weblate`."

msgid ""
"Screenshot and font upload forms now honor :setting:`ALLOWED_ASSET_SIZE` "
"which now defaults to 10 MB."
msgstr ""
"ຟອມອັບໂຫຼດພາບໜ້າຈໍ ແລະ ຟອນຕ໌ຕອນນີ້ປະຕິບັດຕາມ :setting:`ALLOWED_ASSET_SIZE` "
"ເຊິ່ງຕອນນີ້ຄ່າເລີ່ມຕົ້ນແມ່ນ 10 MB."

msgid ""
"Expanded :doc:`/security/threat-model` to cover webhook trust boundaries and "
"delegated authorization boundaries, and clarified the instance-wide 2FA "
"enforcement path in :doc:`/admin/auth`."
msgstr ""
"ຂະຫຍາຍ :doc:`/security/threat-model` ເພື່ອກວມເອົາຂອບເຂດຄວາມເຊື່ອຖື webhook ແລະ "
"ຂອບເຂດການມອບສິດການອະນຸຍາດ, ແລະ ຊີ້ແຈງເສັ້ນທາງການບັງຄັບໃຊ້ 2FA ທົ່ວອິນສະແຕນໃນ :doc:`/"
"admin/auth`."

msgid ""
":ref:`manage-vcs-reset-reapply` now recreates missing translation files when "
"possible and otherwise reports a clearer recovery error instead of failing "
"later with a generic parse error."
msgstr ""
":ref:`manage-vcs-reset-reapply` ຕອນນີ້ສ້າງໄຟລ໌ການແປພາສາທີ່ຂາດຫາຍໄປຄືນໃໝ່ເມື່ອເປັນໄປໄດ້ "
"ແລະ "
"ຖ້າບໍ່ດັ່ງນັ້ນກໍລາຍງານຂໍ້ຜິດພາດການກູ້ຄືນທີ່ຊັດເຈນຂຶ້ນແທນທີ່ຈະລົ້ມເຫຼວໃນພາຍຫຼັງດ້ວຍຂໍ້ຜິດພາດການແຍກວິເຄາະທົ່ວໄປ."

msgid ""
"Updated :doc:`/contributing/documentation` to describe the current ``make -C "
"docs update-docs`` workflow for generated snippets."
msgstr ""
"ອັບເດດ :doc:`/contributing/documentation` ເພື່ອອະທິບາຍຂັ້ນຕອນການເຮັດວຽກ ``make -C "
"docs update-docs`` ໃນປັດຈຸບັນສຳລັບ snippets ທີ່ສ້າງຂຶ້ນ."

msgid ""
"Linked repository components now inherit :ref:`component-"
"push_on_commit`, :ref:`component-commit_pending_age`, and :ref:`component-"
"auto_lock_error` from the linked component that owns the repository."
msgstr ""
"ອົງປະກອບ repository ທີ່ເຊື່ອມໂຍງຕອນນີ້ສືບທອດ :ref:`component-"
"push_on_commit`, :ref:`component-commit_pending_age`, ແລະ :ref:`component-"
"auto_lock_error` ຈາກອົງປະກອບທີ່ເຊື່ອມໂຍງທີ່ເປັນເຈົ້າຂອງ repository."

msgid ""
"Git exporter now provides clearer push and missing-revision errors to "
"authorized users."
msgstr ""
"Git exporter ຕອນນີ້ໃຫ້ຂໍ້ຜິດພາດການ push ແລະ missing-revision "
"ທີ່ຊັດເຈນຂຶ້ນແກ່ຜູ້ໃຊ້ທີ່ໄດ້ຮັບອະນຸຍາດ."

msgid ""
"Faster category and project removals, and improved performance of project "
"language counting and API listing on projects with shared components."
msgstr ""
"ການລຶບໝວດໝູ່ ແລະ ໂຄງການທີ່ໄວຂຶ້ນ, ແລະ ປັບປຸງປະສິດທິພາບຂອງການນັບພາສາໂຄງການ ແລະ ການລາຍການ "
"API ໃນໂຄງການທີ່ມີອົງປະກອບແບ່ງປັນ."

msgid "Clarified Git LFS limits of :ref:`git-exporter` in the UI and docs."
msgstr "ຊີ້ແຈງຂີດຈຳກັດ Git LFS ຂອງ :ref:`git-exporter` ໃນ UI ແລະ ເອກະສານ."

msgid ""
"Improved :ref:`backup` status reporting while keeping maintenance after "
"failed backup attempts."
msgstr ""
"ປັບປຸງການລາຍງານສະຖານະ :ref:`backup` "
"ໃນຂະນະທີ່ຮັກສາການບຳລຸງຮັກສາຫຼັງຈາກຄວາມພະຍາຍາມສຳຮອງຂໍ້ມູນທີ່ລົ້ມເຫຼວ."

msgid ""
"Improved loading speed for comments on the translate page and reduced "
"repeated metric queries when rendering activity charts on overview pages "
"with cold caches."
msgstr ""
"ປັບປຸງຄວາມໄວໃນການໂຫຼດຄວາມຄິດເຫັນໃນໜ້າແປພາສາ ແລະ ຫຼຸດຜ່ອນການສອບຖາມ metrics "
"ຊ້ຳໆເມື່ອສະແດງຜົນຕາຕະລາງກິດຈະກຳໃນໜ້າພາບລວມທີ່ມີແຄຊເຢັນ."

msgid ""
"Hardened repository boundary checks for symlink targets "
"(:cve:`2026-40256` / :ghsa:`ffgh-3jrf-8wvh`)."
msgstr ""
"ເພີ່ມຄວາມເຂັ້ມງວດການກວດສອບຂອບເຂດ repository ສຳລັບເປົ້າໝາຍ symlink "
"(:cve:`2026-40256` / :ghsa:`ffgh-3jrf-8wvh`)."

msgid ""
"Hardened component file handling for repository symlinks "
"(:cve:`2026-34242` / :ghsa:`hv99-mxm5-q397`)."
msgstr ""
"ເພີ່ມຄວາມເຂັ້ມງວດການຈັດການໄຟລ໌ອົງປະກອບສຳລັບ symlinks repository "
"(:cve:`2026-34242` / :ghsa:`hv99-mxm5-q397`)."

msgid ""
"Tightened :ref:`api` permission enforcement (:cve:`2026-34393` / :ghsa:`3382-"
"gw9x-477v`)."
msgstr ""
"ເພີ່ມຄວາມເຂັ້ມງວດການບັງຄັບໃຊ້ສິດ :ref:`api` (:cve:`2026-34393` / :ghsa:`3382-"
"gw9x-477v`)."

msgid ""
"Hardened project-level :ref:`machine-translation` against SSRF "
"(:cve:`2026-34244` / :ghsa:`xrwr-fcw6-fmq8`)."
msgstr ""
"ເພີ່ມຄວາມເຂັ້ມງວດ :ref:`machine-translation` ລະດັບໂຄງການຕໍ່ SSRF "
"(:cve:`2026-34244` / :ghsa:`xrwr-fcw6-fmq8`)."

msgid ""
"Tightened location validation in :ref:`addon-weblate.cdn.cdnjs` "
"(:cve:`2026-33220` / :ghsa:`mqph-7h49-hqfm`)."
msgstr ""
"ເພີ່ມຄວາມເຂັ້ມງວດການຢືນຢັນສະຖານທີ່ໃນ :ref:`addon-weblate.cdn.cdnjs` "
"(:cve:`2026-33220` / :ghsa:`mqph-7h49-hqfm`)."

msgid ""
"Enforced :setting:`ALLOWED_ASSET_DOMAINS` across redirects for asset "
"downloads (:cve:`2026-33440` / :ghsa:`5fhx-9jwj-867m`)."
msgstr ""
"ບັງຄັບໃຊ້ :setting:`ALLOWED_ASSET_DOMAINS` ທົ່ວການປ່ຽນເສັ້ນທາງສຳລັບການດາວໂຫຼດຊັບສິນ "
"(:cve:`2026-33440` / :ghsa:`5fhx-9jwj-867m`)."

msgid ""
"Hardened :ref:`addon-weblate.webhook.webhook` "
"(:cve:`2026-39845` / :ghsa:`f8hv-g549-hwg2`)."
msgstr ""
"ເພີ່ມຄວາມເຂັ້ມງວດ :ref:`addon-weblate.webhook.webhook` "
"(:cve:`2026-39845` / :ghsa:`f8hv-g549-hwg2`)."

msgid ""
"Removed unintended :ref:`translation-memory` API endpoints "
"(:cve:`2026-33214` / :ghsa:`mpf5-3vph-q75r`)."
msgstr ""
"ລົບ API endpoints :ref:`translation-memory` ທີ່ບໍ່ໄດ້ຕັ້ງໃຈ "
"(:cve:`2026-33214` / :ghsa:`mpf5-3vph-q75r`)."

msgid ""
"Tightened API access control for pending tasks "
"(:cve:`2026-33212` / :ghsa:`vj45-x3pj-f4w4`)."
msgstr ""
"ເພີ່ມຄວາມເຂັ້ມງວດການຄວບຄຸມການເຂົ້າເຖິງ API ສຳລັບວຽກງານທີ່ຄ້າງຢູ່ "
"(:cve:`2026-33212` / :ghsa:`vj45-x3pj-f4w4`)."

msgid ""
"Hardened :ref:`projectbackup` restore against repository-local VCS "
"configuration and hooks from uploaded archives "
"(:cve:`2026-33435` / :ghsa:`558g-h753-6m33`)."
msgstr ""
"ເພີ່ມຄວາມເຂັ້ມງວດການກູ້ຄືນ :ref:`projectbackup` ຕໍ່ການຕັ້ງຄ່າ VCS ໃນ repository ແລະ "
"hooks ຈາກ archive ທີ່ອັບໂຫຼດ (:cve:`2026-33435` / :ghsa:`558g-h753-6m33`)."

msgid ""
":ref:`Project backup <projectbackup>` now preserves source translation read-"
"only handling, and source-side pending commits without files are discarded "
"to avoid repeated parse failures."
msgstr ""
":ref:`Project backup <projectbackup>` "
"ຕອນນີ້ຮັກສາການຈັດການການແປພາສາຕົ້ນສະບັບແບບອ່ານຢ່າງດຽວ, ແລະ commits "
"ທີ່ຄ້າງຢູ່ຝັ່ງຕົ້ນສະບັບທີ່ບໍ່ມີໄຟລ໌ຈະຖືກຍົກເລີກເພື່ອຫຼີກເວັ້ນຂໍ້ຜິດພາດການແຍກວິເຄາະຊ້ຳໆ."

msgid ""
"Fixed background failures in :ref:`addon-"
"weblate.autotranslate.autotranslate`."
msgstr ""
"ແກ້ໄຂຄວາມລົ້ມເຫຼວໃນພື້ນຫຼັງໃນ :ref:`addon-weblate.autotranslate.autotranslate`."

msgid ""
"Generated SSH wrapper scripts are now stored in :setting:`CACHE_DIR` instead "
"of persistent SSH storage, and obsolete or stale wrappers are cleaned up "
"during upgrade."
msgstr ""
"ສະຄຣິບ SSH wrapper ທີ່ສ້າງຂຶ້ນຕອນນີ້ຖືກເກັບໄວ້ໃນ :setting:`CACHE_DIR` "
"ແທນທີ່ຈະເປັນບ່ອນເກັບຂໍ້ມູນ SSH ຖາວອນ, ແລະ wrappers ທີ່ລ້າສະໄໝ ຫຼື "
"ເກົ່າຈະຖືກທຳຄວາມສະອາດໃນລະຫວ່າງການອັບເກຣດ."

msgid ""
"Hardened Git branch handling to reject invalid branch names before "
"repository operations."
msgstr ""
"ເພີ່ມຄວາມເຂັ້ມງວດການຈັດການສາຂາ Git ເພື່ອປະຕິເສດຊື່ສາຂາທີ່ບໍ່ຖືກຕ້ອງກ່ອນການດຳເນີນງານ repository."

msgid ""
"Sanitized repository and upload backend errors before exposing them in UI "
"and API responses."
msgstr ""
"Sanitized repository ແລະ ຂໍ້ຜິດພາດ backend ການອັບໂຫຼດກ່ອນການເປີດເຜີຍໃນ UI ແລະ "
"ການຕອບກັບ API."

msgid "Matching exporters now honor component file format parameters."
msgstr "ເຄື່ອງມືສົ່ງອອກທີ່ກົງກັນ ໃນຕອນນີ້ໄດ້ນຳໃຊ້ພາຣາມິເຕີຮູບແບບໄຟລ໌ຂອງອົງປະກອບແລ້ວ."

msgid ""
":ref:`project-api` now clean up stale bot users on project deletion and "
"upgrade, and prevent removing the last assigned team to avoid orphaning the "
"token."
msgstr ""
":ref:`project-api` ຕອນນີ້ທຳຄວາມສະອາດຜູ້ໃຊ້ bot ທີ່ລ້າສະໄໝໃນການລຶບ ແລະ ອັບເກຣດໂຄງການ, "
"ແລະ ປ້ອງກັນການລຶບທີມງານທີ່ຖືກມອບໝາຍຫຼ້າສຸດເພື່ອຫຼີກເວັ້ນການເຮັດໃຫ້ໂທເຄັນກາຍເປັນເດັກກຳພ້າ."

msgid ""
"Batch automatic translation now uses project-level machinery configuration "
"instead of only site-wide settings."
msgstr ""
"ການແປພາສາອັດຕະໂນມັດແບບແບັດຕອນນີ້ໃຊ້ການຕັ້ງຄ່າ machinery "
"ລະດັບໂຄງການແທນທີ່ຈະໃຊ້ພຽງແຕ່ການຕັ້ງຄ່າທົ່ວເວັບໄຊ."

msgid "Fixed sorting by the **Unreviewed** column in listings."
msgstr "ແກ້ໄຂການຈັດລຽງຕາມຄໍລຳ **ບໍ່ໄດ້ກວດສອບ** ໃນລາຍການ."

msgid ""
"Fixed false positive in :ref:`check-xml-chars-around-tags` for Arabic letter "
"Waw (\"و\") adjacent to XML tags."
msgstr ""
"ແກ້ໄຂຜົນຜິດພາດໃນ :ref:`check-xml-chars-around-tags` ສຳລັບຕົວອັກສອນພາສາອາຣັບ Waw "
"(\"و\") ທີ່ຕິດກັບແທັກ XML."

msgid ":ref:`addon-weblate.git.squash` better handle commits applied upstream."
msgstr ":ref:`addon-weblate.git.squash` ຈັດການ commits ທີ່ຖືກນຳໃຊ້ຕົ້ນທາງໄດ້ດີຂຶ້ນ."

msgid ""
":wladmin:`list_checks` now requires exactly one ``--sections`` value when "
"writing generated documentation to a file using ``--output``."
msgstr ""
":wladmin:`list_checks` ຕອນນີ້ຕ້ອງການຄ່າ ``--sections`` "
"ຢ່າງແນ່ນອນໜຶ່ງຄ່າເມື່ອຂຽນເອກະສານທີ່ສ້າງຂຶ້ນໃສ່ໄຟລ໌ໂດຍໃຊ້ ``--output``."

msgid ""
"Watched translations on the dashboard now use a stable language-aware "
"ordering."
msgstr "ການແປພາສາທີ່ຕິດຕາມໃນແຜງໜ້າປັດຕອນນີ້ໃຊ້ການຈັດລຽງທີ່ໝັ້ນຄົງຕາມພາສາ."

msgid ""
"Reduced error-reporting noise for handled authentication callback failures "
"and clarified password reset confirmation messages."
msgstr ""
"ຫຼຸດຜ່ອນສຽງລົບກວນການລາຍງານຂໍ້ຜິດພາດສຳລັບຄວາມລົ້ມເຫຼວຂອງ callback ການຢືນຢັນຕົວຕົນທີ່ຈັດການແລ້ວ "
"ແລະ ຊີ້ແຈງຂໍ້ຄວາມຢືນຢັນການຣີເຊັດລະຫັດຜ່ານ."

msgid ""
":doc:`/admin/machine` now falls back to the default API URL when base URL is "
"empty."
msgstr ":doc:`/admin/machine` ຕອນນີ້ກັບໄປໃຊ້ API URL ເລີ່ມຕົ້ນເມື່ອ base URL ຫວ່າງເປົ່າ."

msgid ":ref:`mt-deepl` maps plain Portuguese to European Portuguese."
msgstr ":ref:`mt-deepl` ແມັບພາສາປອກຕຸຍການທົ່ວໄປໄປຫາພາສາປອກຕຸຍການເອີຣົບ."

msgid ""
":ref:`mt-mymemory` now falls back to HTTP status handling when the service "
"returns a non-JSON error response."
msgstr ""
":ref:`mt-mymemory` ຕອນນີ້ກັບໄປໃຊ້ການຈັດການສະຖານະ HTTP "
"ເມື່ອບໍລິການສົ່ງຄືນການຕອບກັບຂໍ້ຜິດພາດທີ່ບໍ່ແມ່ນ JSON."

msgid ""
"Push branches are no longer updated with upstream-only commits in multi-"
"branch workflows."
msgstr "Push branches ບໍ່ຖືກອັບເດດດ້ວຍ commits ຕົ້ນທາງເທົ່ານັ້ນໃນຂັ້ນຕອນການເຮັດວຽກຫຼາຍສາຂາ."

msgid ""
"POT update add-ons now fall back to the component URL for the ``Report-Msgid-"
"Bugs-To`` header when the component setting is empty."
msgstr ""
"ສ່ວນເສີມອັບເດດ POT ຕອນນີ້ກັບໄປໃຊ້ component URL ສຳລັບ header ``Report-Msgid-Bugs-"
"To`` ເມື່ອການຕັ້ງຄ່າອົງປະກອບຫວ່າງເປົ່າ."

msgid "Improved repository lock error handling when deleting units."
msgstr "ປັບປຸງການຈັດການຂໍ້ຜິດພາດການລັອກ repository ເມື່ອລຶບໜ່ວຍ."

msgid ""
"Adding new languages now rescans only the newly added languages instead of "
"forcing a full component scan."
msgstr "ການເພີ່ມພາສາໃໝ່ຕອນນີ້ສະແດງສະເພາະພາສາທີ່ເພີ່ມໃໝ່ແທນທີ່ຈະບັງຄັບໃຫ້ສະແກນອົງປະກອບທັງໝົດ."

msgid ""
":ref:`check-max-size` previews now keep the configured text box visible and "
"render overflowing text in red."
msgstr ""
"ຕົວຢ່າງ :ref:`check-max-size` ຕອນນີ້ຮັກສາກ່ອງຂໍ້ຄວາມທີ່ຕັ້ງຄ່າໄວ້ໃຫ້ເຫັນໄດ້ ແລະ "
"ສະແດງຂໍ້ຄວາມທີ່ລົ້ນໃນສີແດງ."

msgid ""
"Restored documented default encoding fallback for :doc:`/formats/apple` "
"and :doc:`/formats/java` when file format parameters are not explicitly set."
msgstr ""
"ກູ້ຄືນເອກະສານການກັບໄປໃຊ້ encoding ເລີ່ມຕົ້ນສຳລັບ :doc:`/formats/apple` ແລະ :doc:`/"
"formats/java` ເມື່ອພາລາມິເຕີຮູບແບບໄຟລ໌ບໍ່ໄດ້ຖືກຕັ້ງຢ່າງຈະແຈ້ງ."

msgid ""
"Reduced repeated database queries in :ref:`addon-"
"weblate.generate.fill_read_only` during the daily add-on task, and fixed "
"auto-translation progress updates when the queued target disappears before "
"execution."
msgstr ""
"ຫຼຸດຜ່ອນການສອບຖາມຖານຂໍ້ມູນຊ້ຳໆໃນ :ref:`addon-weblate.generate.fill_read_only` "
"ໃນລະຫວ່າງວຽກງານສ່ວນເສີມປະຈຳວັນ, ແລະ "
"ແກ້ໄຂການອັບເດດຄວາມຄືບໜ້າການແປພາສາອັດຕະໂນມັດເມື່ອເປົ້າໝາຍທີ່ຢູ່ໃນແຖວຫາຍໄປກ່ອນການດຳເນີນງານ."

msgid ""
":doc:`/formats/android` now preserves template-defined escaped markup "
"formatting when saving translations."
msgstr ""
":doc:`/formats/android` ຕອນນີ້ຮັກສາການຈັດຮູບແບບ markup ທີ່ຖືກ escape "
"ທີ່ກຳນົດໂດຍແມ່ແບບເມື່ອບັນທຶກການແປພາສາ."

msgid ""
"REST API component creation now handles temporary uploaded files for "
"``docfile`` and ``zipfile`` uploads."
msgstr ""
"ການສ້າງອົງປະກອບ REST API ຕອນນີ້ຈັດການກັບໄຟລ໌ທີ່ອັບໂຫຼດຊົ່ວຄາວສຳລັບການອັບໂຫຼດ ``docfile`` ແລະ "
"``zipfile``."

msgid ""
"SSH repository errors now distinguish changed host keys from missing host "
"keys and avoid automatically trusting host key replacements."
msgstr ""
"ຂໍ້ຜິດພາດ SSH repository ຕອນນີ້ແຍກຄວາມແຕກຕ່າງລະຫວ່າງ host keys ທີ່ປ່ຽນແປງຈາກ host keys "
"ທີ່ຂາດຫາຍໄປ ແລະ ຫຼີກເວັ້ນການເຊື່ອຖືການປ່ຽນແທນ host key ໂດຍອັດຕະໂນມັດ."

msgid ""
":ref:`machine-translation` no longer treats translatable reStructuredText "
"role content as :ref:`placeables-mt`."
msgstr ""
":ref:`machine-translation` ບໍ່ປະຕິບັດຕໍ່ເນື້ອຫາບົດບາດ reStructuredText "
"ທີ່ແປໄດ້ເປັນ :ref:`placeables-mt` ອີກຕໍ່ໄປ."

msgid ""
":ref:`check-end-interrobang` now recognizes Arabic interrobang punctuation "
"such as ``؟!`` and ``!؟``."
msgstr ""
":ref:`check-end-interrobang` ຕອນນີ້ຮັບຮູ້ເຄື່ອງໝາຍວັກຕອນ interrobang ພາສາອາຣັບ ເຊັ່ນ "
"``؟!`` ແລະ ``!؟``."

msgid ""
"The ``project_scope`` class attribute on add-ons has been removed. Third-"
"party add-ons that used ``project_scope = True`` should override "
"``can_install()`` to return ``False`` when ``component`` is not ``None``."
msgstr ""
"ຄຸນລັກສະນະຄລາດ ``project_scope`` ໃນສ່ວນເສີມຖືກລົບອອກ. ສ່ວນເສີມຂອງບຸກຄົນທີສາມທີ່ໃຊ້ "
"``project_scope = True`` ຄວນ override ``can_install()`` ເພື່ອກັບຄືນ ``False`` "
"ເມື່ອ ``component`` ບໍ່ແມ່ນ ``None``."

msgid ""
"The ``daily()`` method signature on add-ons has changed. Add-ons that "
"previously overrode ``daily(component)`` to perform per-component work "
"should now override ``daily_component(component)`` instead. The base "
"``daily()`` method automatically iterates components and calls "
"``daily_component()`` for each. Add-ons that can be optimized to operate at "
"project scope should override ``daily(component, project)`` directly to "
"implement project-level logic."
msgstr ""
"ລາຍເຊັນວິທີການ ``daily()`` ໃນສ່ວນເສີມໄດ້ປ່ຽນແປງ. ສ່ວນເສີມທີ່ເຄີຍ override "
"``daily(component)`` ເພື່ອເຮັດວຽກແຕ່ລະອົງປະກອບຕອນນີ້ຄວນ override "
"``daily_component(component)`` ແທນ. ວິທີການ ``daily()`` "
"ພື້ນຖານຈະເຮັດຊ້ຳອົງປະກອບໂດຍອັດຕະໂນມັດ ແລະ ໂທຫາ ``daily_component()`` "
"ສຳລັບແຕ່ລະອົງປະກອບ. ສ່ວນເສີມທີ່ສາມາດປັບປຸງໃຫ້ເຮັດວຽກໃນລະດັບໂຄງການຄວນ override "
"``daily(component, project)`` ໂດຍກົງເພື່ອຈັດຕັ້ງປະຕິບັດຕັກກະຍະສາດລະດັບໂຄງການ."

msgid "Dropped support for MySQL and MariaDB as the database engine."
msgstr "ຍົກເລີກການຮອງຮັບ MySQL ແລະ MariaDB ເປັນຖານຂໍ້ມູນ."

msgid "Weblate now requires Django 6.0."
msgstr "ຕອນນີ້ Weblate ຕ້ອງການ Django 6.0."

msgid "Weblate now requires Git 2.46 or newer."
msgstr "ຕອນນີ້ Weblate ຕ້ອງການ Git 2.46 ຫຼື ໃໝ່ກວ່າ."

msgid ""
"Uploaded project backups are now validated more strictly during import and "
"suspicious ZIP archives can be rejected; see :ref:`projectbackup`."
msgstr ""
"ການສຳຮອງຂໍ້ມູນໂຄງການທີ່ອັບໂຫຼດຕອນນີ້ຖືກຢືນຢັນຢ່າງເຂັ້ມງວດຂຶ້ນໃນລະຫວ່າງການນຳເຂົ້າ ແລະ ZIP "
"archives ທີ່ໜ້າສົງໄສສາມາດຖືກປະຕິເສດ; ເບິ່ງ :ref:`projectbackup`."

msgid ""
"There are several changes in :file:`settings_example.py`, most "
"notably :setting:`ADMINS` syntax has changed in Django and "
"``SOCIAL_AUTH_PIPELINE`` and ``INSTALLED_APPS`` need adjustments; please "
"adjust your settings accordingly."
msgstr ""
"ມີການປ່ຽນແປງຫຼາຍຢ່າງໃນ :file:`settings_example.py`, "
"ທີ່ສຳຄັນທີ່ສຸດຄືໄວຍາກອນ :setting:`ADMINS` ໄດ້ປ່ຽນແປງໃນ Django ແລະ "
"``SOCIAL_AUTH_PIPELINE`` ແລະ ``INSTALLED_APPS`` ຕ້ອງການການປັບປຸງ; "
"ກະລຸນາປັບການຕັ້ງຄ່າຂອງທ່ານໃຫ້ສອດຄ່ອງ."

msgid ""
"If you run Weblate in Docker and rely on IPv6 listeners, "
"review :envvar:`WEBLATE_NGINX_IPV6`. The default ``auto`` enables IPv6 "
"listeners only when IPv6 is available in the container runtime; use ``on`` "
"to always enable them or ``off`` to disable them."
msgstr ""
"ຖ້າທ່ານແລ່ນ Weblate ໃນ Docker ແລະ ອີງໃສ່ IPv6 listeners, "
"ໃຫ້ກວດສອບ :envvar:`WEBLATE_NGINX_IPV6`. ຄ່າເລີ່ມຕົ້ນ ``auto`` ເປີດໃຊ້ງານ IPv6 "
"listeners ສະເພາະເມື່ອ IPv6 ມີຢູ່ໃນ container runtime; ໃຊ້ ``on`` "
"ເພື່ອເປີດໃຊ້ງານພວກມັນສະເໝີ ຫຼື ``off`` ເພື່ອປິດໃຊ້ງານພວກມັນ."

msgid ""
"Outbound project links, webhook URLs, and repository or push URLs pointing "
"to internal or non-public addresses are now rejected by default. If your "
"setup intentionally uses internal addresses, adjust the corresponding "
"restriction settings such "
"as :setting:`PROJECT_WEB_RESTRICT_PRIVATE`, :setting:`WEBHOOK_RESTRICT_PRIVATE`, "
"or :setting:`VCS_RESTRICT_PRIVATE`, and the related allowlists such "
"as :setting:`VCS_ALLOW_HOSTS`."
msgstr ""
"ລິ້ງໂຄງການຂາອອກ, URL webhook, ແລະ URL repository ຫຼື push ທີ່ຊີ້ໄປທີ່ທີ່ຢູ່ພາຍໃນ ຫຼື "
"ບໍ່ແມ່ນສາທາລະນະຕອນນີ້ຖືກປະຕິເສດໂດຍຄ່າເລີ່ມຕົ້ນ. ຖ້າການຕັ້ງຄ່າຂອງທ່ານໃຊ້ທີ່ຢູ່ພາຍໃນໂດຍຕັ້ງໃຈ, "
"ໃຫ້ປັບການຕັ້ງຄ່າຂໍ້ຈຳກັດທີ່ກ່ຽວຂ້ອງ "
"ເຊັ່ນ :setting:`PROJECT_WEB_RESTRICT_PRIVATE`, :setting:`WEBHOOK_RESTRICT_PRIVATE`, "
"ຫຼື :setting:`VCS_RESTRICT_PRIVATE`, ແລະ allowlists ທີ່ກ່ຽວຂ້ອງ "
"ເຊັ່ນ :setting:`VCS_ALLOW_HOSTS`."

msgid ""
"`All changes in detail <https://github.com/WeblateOrg/weblate/milestone/158?"
"closed=1>`__."
msgstr ""
"`ລາຍລະອຽດການປ່ຽນແປງທັງໝົດ <https://github.com/WeblateOrg/weblate/milestone/158?"
"closed=1>`__."

msgid "Weblate 5.16.2"
msgstr "Weblate 5.16.2"

msgid "*Released on March 6th 2026.*"
msgstr "*ອອກເຜີຍແຜ່ເມື່ອວັນທີ 6 ມີນາ 2026.*"

msgid ""
"New setting :setting:`PUBLIC_ENGAGE` to make the engage page public even "
"with :setting:`REQUIRE_LOGIN`."
msgstr ""
"ການຕັ້ງຄ່າໃໝ່ :setting:`PUBLIC_ENGAGE` ເພື່ອເຮັດໃຫ້ໜ້າ engage "
"ເປັນສາທາລະນະເຖິງແມ່ນວ່າຈະມີ :setting:`REQUIRE_LOGIN`."

msgid "Improved matching in :doc:`/admin/memory`."
msgstr "ປັບປຸງການຈັບຄູ່ໃນ :doc:`/admin/memory`."

msgid "Show the number of strings waiting for review in listings."
msgstr "ສະແດງຈຳນວນຂໍ້ຄວາມທີ່ລໍຖ້າການກວດສອບໃນລາຍການ."

msgid ""
"Avoid displaying confusing status icons for ghost languages on project or "
"category level."
msgstr "ຫຼີກເວັ້ນການສະແດງໄອຄອນສະຖານະທີ່ສັບສົນສຳລັບພາສາ ghost ໃນລະດັບໂຄງການ ຫຼື ໝວດໝູ່."

msgid ""
"Fixed missing plural source strings when creating new bilingual plural units."
msgstr "ແກ້ໄຂຂໍ້ຄວາມຕົ້ນສະບັບພະຫຸພົດທີ່ຂາດຫາຍໄປເມື່ອສ້າງໜ່ວຍພະຫຸພົດສອງພາສາໃໝ່."

msgid "Crash on certain pages with nested categories."
msgstr "ບັນຫາແອັບຯປິດເອງໃນບາງໜ້າທີ່ມີໝວດໝູ່ຊ້ອນກັນ."

msgid "Improved API validation when adding strings."
msgstr "ປັບປຸງການຢືນຢັນ API ເມື່ອເພີ່ມຂໍ້ຄວາມ."

msgid "Disabled throttling for incoming webhooks."
msgstr "ປິດໃຊ້ງານ throttling ສຳລັບ webhooks ຂາເຂົ້າ."

msgid "Avoid displaying non-actionable ghost languages."
msgstr "ຫຼີກເວັ້ນການສະແດງພາສາ ghost ທີ່ບໍ່ສາມາດດຳເນີນການໄດ້."

msgid "Fixed highlighting in the translation editor."
msgstr "ແກ້ໄຂການໄຮໄລ້ໃນຕົວແກ້ໄຂການແປພາສາ."

msgid ""
"`All changes in detail <https://github.com/WeblateOrg/weblate/milestone/163?"
"closed=1>`__."
msgstr ""
"`ລາຍລະອຽດການປ່ຽນແປງທັງໝົດ <https://github.com/WeblateOrg/weblate/milestone/163?"
"closed=1>`__."

msgid "Weblate 5.16.1"
msgstr "Weblate 5.16.1"

msgid "*Released on February 26th 2026.*"
msgstr "*ອອກເຜີຍແຜ່ເມື່ອວັນທີ 26 ກຸມພາ 2026.*"

msgid ""
":doc:`/formats/asciidoc`, :doc:`/formats/xliff` with Apple extensions, "
"and :doc:`/formats/wxl` are now supported file formats."
msgstr ""
":doc:`/formats/asciidoc`, :doc:`/formats/xliff` ພ້ອມນາມສະກຸນ Apple, ແລະ :doc:`/"
"formats/wxl` ຕອນນີ້ເປັນຮູບແບບໄຟລ໌ທີ່ຮອງຮັບ."

msgid ""
"Added :setting:`REGISTRATION_ALLOW_DISPOSABLE_EMAILS` to optionally allow "
"disposable e-mail domains during registration (Docker "
"env: :envvar:`WEBLATE_REGISTRATION_ALLOW_DISPOSABLE_EMAILS`)."
msgstr ""
"ເພີ່ມ :setting:`REGISTRATION_ALLOW_DISPOSABLE_EMAILS` "
"ເພື່ອອະນຸຍາດໃຫ້ໂດເມນອີເມວທີ່ໃຊ້ແລ້ວຖິ້ມໄດ້ໃນລະຫວ່າງການລົງທະບຽນ (Docker "
"env: :envvar:`WEBLATE_REGISTRATION_ALLOW_DISPOSABLE_EMAILS`)."

msgid ""
"Improved documentation for translation states to clarify the difference "
"between :guilabel:`Needs editing`, :guilabel:`Needs rewriting`, "
"and :guilabel:`Needs checking` states."
msgstr ""
"ປັບປຸງເອກະສານສຳລັບສະຖານະການແປພາສາເພື່ອຊີ້ແຈງຄວາມແຕກຕ່າງລະຫວ່າງສະຖານະ :guilabel:`Needs "
"editing`, :guilabel:`Needs rewriting`, ແລະ :guilabel:`Needs checking`."

msgid ""
"Improved initial import of translations for :doc:`/formats/markdown` "
"and :doc:`/formats/html`."
msgstr ""
"ປັບປຸງການນຳເຂົ້າການແປພາສາເບື້ອງຕົ້ນສຳລັບ :doc:`/formats/markdown` ແລະ :doc:`/formats/"
"html`."

msgid ":ref:`addon-weblate.webhook.slack` properly delivers all events."
msgstr ":ref:`addon-weblate.webhook.slack` ສົ່ງເຫດການທັງໝົດຢ່າງຖືກຕ້ອງ."

msgid ":ref:`check-punctuation-spacing` better handles XML markup."
msgstr ":ref:`check-punctuation-spacing` ຈັດການ markup XML ໄດ້ດີຂຶ້ນ."

msgid ":doc:`/formats/stringsdict` better handle some plurals."
msgstr ":doc:`/formats/stringsdict` ຈັດການພະຫຸພົດບາງອັນໄດ້ດີຂຶ້ນ."

msgid "Improved plurals handling for language variants."
msgstr "ປັບປຸງການຈັດການພະຫຸພົດສຳລັບ variants ພາສາ."

msgid "Fixed API access control."
msgstr "ແກ້ໄຂການຄວບຄຸມການເຂົ້າເຖິງ API."

msgid "Users can manage their own notification subscriptions via the API."
msgstr "ຜູ້ໃຊ້ສາມາດຈັດການການສະໝັກຮັບແຈ້ງເຕືອນຂອງຕົນເອງຜ່ານ API."

msgid ""
"Project administrators can manage teams in their projects via the API, "
"according to access control rules."
msgstr ""
"ຜູ້ເບິ່ງແຍງໂຄງການສາມາດຈັດການທີມໃນໂຄງການຂອງເຂົາເຈົ້າຜ່ານ API, "
"ຕາມກົດລະບຽບການຄວບຄຸມການເຂົ້າເຖິງ."

msgid ""
"The add-ons listing in the API now correctly honors user permissions "
"(:cve:`2026-27457` / :ghsa:`wppc-7cq7-cgfv`)."
msgstr ""
"ລາຍການສ່ວນເສີມໃນ API ຕອນນີ້ປະຕິບັດຕາມສິດຂອງຜູ້ໃຊ້ຢ່າງຖືກຕ້ອງ "
"(:cve:`2026-27457` / :ghsa:`wppc-7cq7-cgfv`)."

msgid ""
"Fixed source column being cleared when translating monolingual :doc:`/"
"formats/csv`."
msgstr "ແກ້ໄຂຄໍລຳຕົ້ນສະບັບທີ່ຖືກລ້າງເມື່ອແປພາສາ :doc:`/formats/csv` ພາສາດຽວ."

msgid ""
"`All changes in detail <https://github.com/WeblateOrg/weblate/milestone/161?"
"closed=1>`__."
msgstr ""
"`ລາຍລະອຽດການປ່ຽນແປງທັງໝົດ <https://github.com/WeblateOrg/weblate/milestone/161?"
"closed=1>`__."

msgid "Weblate 5.16"
msgstr "Weblate 5.16"

msgid "*Released on February 16th 2026.*"
msgstr "*ອອກເຜີຍແຜ່ເມື່ອວັນທີ 16 ກຸມພາ 2026.*"

msgid ":ref:`check-multiple-capital` quality check."
msgstr "ການກວດສອບຄຸນນະພາບ :ref:`check-multiple-capital`."

msgid ""
":ref:`check-xml-chars-around-tags` reduce translation errors for strings "
"with XML entities."
msgstr ""
":ref:`check-xml-chars-around-tags` ຫຼຸດຜ່ອນຂໍ້ຜິດພາດການແປພາສາສຳລັບຂໍ້ຄວາມທີ່ມີ XML "
"entities."

msgid "Bulk accepting suggestions from a specific user in :ref:`suggestions`."
msgstr "ການຍອມຮັບຄຳແນະນຳແບບກຸ່ມຈາກຜູ້ໃຊ້ສະເພາະໃນ :ref:`suggestions`."

msgid "Cloning suggestions into translation in :ref:`suggestions`."
msgstr "ການຄັດລອກຄຳແນະນຳໄປສູ່ການແປພາສາໃນ :ref:`suggestions`."

msgid ""
":setting:`HIDE_SHARED_GLOSSARY_COMPONENTS` to hide glossaries shared into "
"other projects."
msgstr ""
":setting:`HIDE_SHARED_GLOSSARY_COMPONENTS` ເພື່ອເຊື່ອງ glossaries "
"ທີ່ແບ່ງປັນໄປໂຄງການອື່ນ."

msgid ""
"Added new management command :wladmin:`list_change_events`, which lists all "
"possible change events, :ref:`addon-choice-events`."
msgstr ""
"ເພີ່ມຄຳສັ່ງຈັດການໃໝ່ :wladmin:`list_change_events`, "
"ເຊິ່ງສະແດງລາຍການເຫດການການປ່ຽນແປງທັງໝົດທີ່ເປັນໄປໄດ້, :ref:`addon-choice-events`."

msgid "Added Anthropic machinery integration, see :ref:`mt-anthropic`."
msgstr "ເພີ່ມການເຊື່ອມຕໍ່ Anthropic machinery, ເບິ່ງ :ref:`mt-anthropic`."

msgid ""
"Encoding for :ref:`formats` can now be configured "
"using :ref:`file_format_params` (e.g., ``csv_encoding``, "
"``properties_encoding``)."
msgstr ""
"Encoding ສຳລັບ :ref:`formats` ຕອນນີ້ສາມາດຕັ້ງຄ່າໄດ້ໂດຍໃຊ້ :ref:`file_format_params` "
"(ເຊັ່ນ: ``csv_encoding``, ``properties_encoding``)."

msgid ""
"Added support for anonymous commit names "
"via :setting:`PRIVATE_COMMIT_NAME_TEMPLATE`."
msgstr ""
"ເພີ່ມການຮອງຮັບຊື່ commit ແບບບໍ່ລະບຸຕົວຕົນຜ່ານ :setting:`PRIVATE_COMMIT_NAME_TEMPLATE`."

msgid ""
"Consolidating identical strings in :ref:`markdown`, :ref:`html`, "
"and :ref:`txt` files using ``*merge_duplicates`` parameters "
"in :ref:`file_format_params`."
msgstr ""
"ການລວມຂໍ້ຄວາມທີ່ຄືກັນໃນໄຟລ໌ :ref:`markdown`, :ref:`html`, ແລະ :ref:`txt` "
"ໂດຍໃຊ້ພາລາມິເຕີ ``*merge_duplicates`` ໃນ :ref:`file_format_params`."

msgid ""
"Delete announcements permission can be assigned to teams, "
"see :ref:`privileges`."
msgstr "ສິດໃນການລຶບການປະກາດສາມາດຖືກມອບໝາຍໃຫ້ກັບທີມງານ, ເບິ່ງ :ref:`privileges`."

msgid ":doc:`/user/search` better reports errors in the query strings."
msgstr ":doc:`/user/search` ລາຍງານຂໍ້ຜິດພາດໃນຂໍ້ຄວາມຄຳສັ່ງໄດ້ດີຂຶ້ນ."

msgid "Regular repository maintenance is now performed in the background."
msgstr "ການບຳລຸງຮັກສາ repository ປົກກະຕິຕອນນີ້ຖືກປະຕິບັດໃນພື້ນຫຼັງ."

msgid "Repository cleanup now recovers failed merges or rebases."
msgstr "ການທຳຄວາມສະອາດ repository ຕອນນີ້ກູ້ຄືນການລວມ ຫຼື rebases ທີ່ລົ້ມເຫຼວ."

msgid "Better visibility of :ref:`project-commit_policy` to translators."
msgstr "ການເບິ່ງເຫັນ :ref:`project-commit_policy` ທີ່ດີຂຶ້ນສຳລັບນັກແປພາສາ."

msgid ""
"Validation of VCS settings :ref:`code-hosting-push-options` has been "
"extended."
msgstr "ການຢືນຢັນການຕັ້ງຄ່າ VCS :ref:`code-hosting-push-options` ໄດ້ຖືກຂະຫຍາຍ."

msgid ""
"The default values for :ref:`project-translation_review` and :ref:`project-"
"source_review` can be configured in settings."
msgstr ""
"ຄ່າເລີ່ມຕົ້ນສຳລັບ :ref:`project-translation_review` ແລະ :ref:`project-"
"source_review` ສາມາດຕັ້ງຄ່າໄດ້ໃນການຕັ້ງຄ່າ."

msgid ""
"The :setting:`PRIVATE_COMMIT_EMAIL_TEMPLATE` now supports the ``{user_id}`` "
"and ``{site_title}`` variables."
msgstr ""
":setting:`PRIVATE_COMMIT_EMAIL_TEMPLATE` ຕອນນີ້ຮອງຮັບຕົວແປ ``{user_id}`` ແລະ "
"``{site_title}``."

msgid ""
"The default value for personal translation memory contribution is now based "
"on the :setting:`DEFAULT_AUTOCLEAN_TM` configuration."
msgstr "ຄ່າເລີ່ມຕົ້ນສຳລັບການປະກອບສ່ວນໜ່ວຍຄວາມຈຳການແປພາສາສ່ວນບຸກຄົນຕອນນີ້ອີງໃສ່ການຕັ້ງຄ່າ :setting:`DEFAULT_AUTOCLEAN_TM`."

msgid ""
"Argument injection in the management console "
"(:cve:`2026-24126` / :ghsa:`33fm-6gp7-4p47`)."
msgstr ""
"ການສີດ Argument ໃນຄອນໂຊນການຈັດການ (:cve:`2026-24126` / :ghsa:`33fm-6gp7-4p47`)."

msgid ""
"Adding plural strings with singular matching existing string is now "
"prohibited for bilingual translations (see :ref:`bimono`)."
msgstr ""
"ການເພີ່ມຂໍ້ຄວາມພະຫຸພົດທີ່ມີຂໍ້ຄວາມເອກະພົດທີ່ກົງກັບຂໍ້ຄວາມທີ່ມີຢູ່ຕອນນີ້ຖືກຫ້າມສຳລັບການແປພາສາສອງພາສາ "
"(ເບິ່ງ :ref:`bimono`)."

msgid "Automatic :ref:`component-repoweb` URL for common code hosting sites."
msgstr "URL :ref:`component-repoweb` ອັດຕະໂນມັດສຳລັບເວັບໄຊໂຮດຕິ້ງໂຄ້ດທົ່ວໄປ."

msgid ""
"Improved cache isolation for suggestion checks to avoid interference with "
"the parent unit checks."
msgstr "ປັບປຸງການແຍກແຄຊສຳລັບການກວດສອບຄຳແນະນຳເພື່ອຫຼີກເວັ້ນການແຊກແຊງກັບການກວດສອບໜ່ວຍແມ່."

msgid "Gracefully handle invalid check flags in :ref:`custom-checks`."
msgstr "ຈັດການທຸງການກວດສອບທີ່ບໍ່ຖືກຕ້ອງໃນ :ref:`custom-checks` ຢ່າງສະຫງ່າງາມ."

msgid ":doc:`/formats/appstore` no longer rewrites unchanged files."
msgstr ":doc:`/formats/appstore` ບໍ່ຂຽນໄຟລ໌ທີ່ບໍ່ມີການປ່ຽນແປງຄືນໃໝ່ອີກຕໍ່ໄປ."

msgid ""
":ref:`check-regex` no longer marks matched portions as non-translatable to "
"allow generic regular-expression-based checking of strings. Use :ref:`check-"
"placeholders` for checking regular expression matched placeholders."
msgstr ""
":ref:`check-regex` "
"ບໍ່ໝາຍສ່ວນທີ່ຈັບຄູ່ເປັນສິ່ງທີ່ບໍ່ສາມາດແປໄດ້ອີກຕໍ່ໄປເພື່ອອະນຸຍາດໃຫ້ມີການກວດສອບຂໍ້ຄວາມໂດຍອີງໃສ່ Regular "
"Expression ທົ່ວໄປ. ໃຊ້ :ref:`check-placeholders` ສຳລັບການກວດສອບຕົວແທນທີ່ຈັບຄູ່ Regular "
"Expression."

msgid ""
"The default value for :setting:`WEBLATE_FORMATS` changed because of the "
"removal of encoding-specific formats."
msgstr ""
"ຄ່າເລີ່ມຕົ້ນສຳລັບ :setting:`WEBLATE_FORMATS` ປ່ຽນແປງເນື່ອງຈາກການລົບຮູບແບບສະເພາະ "
"encoding."

msgid ""
"File formats that only differed in encoding (CSV, GWT Properties, Java "
"Properties, iOS Strings) have been merged into single formats."
msgstr ""
"ຮູບແບບໄຟລ໌ທີ່ຕ່າງກັນພຽງແຕ່ໃນ encoding (CSV, GWT Properties, Java Properties, iOS "
"Strings) ໄດ້ຖືກລວມເຂົ້າເປັນຮູບແບບດຽວ."

msgid "Fonts used by Weblate are now shipped in a standalone package."
msgstr "ຟອນຕ໌ທີ່ Weblate ໃຊ້ຕອນນີ້ຖືກສົ່ງໃນແພັກເກັດແບບຢືນຢັນດ້ວຍຕົນເອງ."

msgid "Dropped deprecated compatibility wrappers some classes with typos."
msgstr "ຍົກເລີກ wrappers ຄວາມເຂົ້າກັນໄດ້ທີ່ລ້າສະໄໝບາງຄລາດທີ່ມີຄຳຜິດ."

msgid ""
"`All changes in detail <https://github.com/WeblateOrg/weblate/milestone/156?"
"closed=1>`__."
msgstr ""
"`ລາຍລະອຽດການປ່ຽນແປງທັງໝົດ <https://github.com/WeblateOrg/weblate/milestone/156?"
"closed=1>`__."

msgid "Weblate 5.15.2"
msgstr "Weblate 5.15.2"

msgid "*Released on January 14th 2026.*"
msgstr "*ອອກເຜີຍແຜ່ເມື່ອວັນທີ 14 ມັງກອນ 2026.*"

msgid ""
":ref:`addon-weblate.generate.generate` is now triggered upon installation."
msgstr ":ref:`addon-weblate.generate.generate` ຕອນນີ້ຖືກກະຕຸ້ນເມື່ອຕິດຕັ້ງ."

msgid "Screenshots updated from the repository have proper history."
msgstr "ພາບໜ້າຈໍທີ່ອັບເດດຈາກ repository ມີປະຫວັດທີ່ເໝາະສົມ."

msgid ":ref:`check-rst-syntax` now reports unintended list conversion."
msgstr ":ref:`check-rst-syntax` ຕອນນີ້ລາຍງານການປ່ຽນລາຍການທີ່ບໍ່ໄດ້ຕັ້ງໃຈ."

msgid ":ref:`check-same` check ignores AsciiDoc source code blocks."
msgstr ":ref:`check-same` ລະເລີຍບລັອກໂຄ້ດຕົ້ນສະບັບ AsciiDoc."

msgid ""
"Information leak via screenshots "
"(:cve:`2026-21889` / :ghsa:`3g2f-4rjg-9385`)."
msgstr "ຂໍ້ມູນຮົ່ວໄຫຼຜ່ານພາບໜ້າຈໍ (:cve:`2026-21889` / :ghsa:`3g2f-4rjg-9385`)."

msgid "Explanation sync in :doc:`/formats/tbx`."
msgstr "ການຊິ້ງຂໍ້ມູນຄຳອະທິບາຍໃນ :doc:`/formats/tbx`."

msgid "User interface fixes."
msgstr "ການແກ້ໄຂອິນເຕີເຟສຜູ້ໃຊ້."

msgid "Clarified needs editing/checking/rewriting states."
msgstr "ຊີ້ແຈງສະຖານະຕ້ອງການແກ້ໄຂ/ກວດສອບ/ຂຽນໃໝ່."

msgid "Automatically translated flag with bulk approvals."
msgstr "ທຸງການແປພາສາອັດຕະໂນມັດພ້ອມການອະນຸມັດແບບກຸ່ມ."

msgid "GitHub forks no longer trigger actions."
msgstr "GitHub forks ບໍ່ກະຕຸ້ນການກະທຳອີກຕໍ່ໄປ."

msgid ""
"Tighter validation of user provided websites to avoid confusing homoglyphs."
msgstr "ການຢືນຢັນເວັບໄຊທີ່ຜູ້ໃຊ້ສະໜອງໃຫ້ຢ່າງເຂັ້ມງວດຂຶ້ນເພື່ອຫຼີກເວັ້ນ homoglyphs ທີ່ສັບສົນ."

msgid "Glossary support in :ref:`mt-google-translate-api-v3`."
msgstr "ການຮອງຮັບ Glossary ໃນ :ref:`mt-google-translate-api-v3`."

msgid "Invitations accepting when :setting:`REQUIRE_LOGIN` is turned on."
msgstr "ການຍອມຮັບຄຳເຊີນເມື່ອ :setting:`REQUIRE_LOGIN` ຖືກເປີດໃຊ້ງານ."

msgid ":ref:`mt-cyrtranslit` installation."
msgstr "ການຕິດຕັ້ງ :ref:`mt-cyrtranslit`."

msgid ""
"Screenshot images are no longer served directly by the HTTP server, please "
"adjust your HTTP server by removing serving of :file:`/media/`."
msgstr ""
"ຮູບພາບພາບໜ້າຈໍບໍ່ຖືກໃຫ້ບໍລິການໂດຍກົງໂດຍເຊີບເວີ HTTP ອີກຕໍ່ໄປ, ກະລຸນາປັບເຊີບເວີ HTTP "
"ຂອງທ່ານໂດຍການລົບການໃຫ້ບໍລິການ :file:`/media/`."

msgid ""
"To make the fix for :cve:`2026-21889` effective, the serving of :file:`/"
"media/` path should be removed from the HTTP server configuration; "
"see :ref:`static-files`."
msgstr ""
"ເພື່ອເຮັດໃຫ້ການແກ້ໄຂສຳລັບ :cve:`2026-21889` ມີປະສິດທິຜົນ, ການໃຫ້ບໍລິການເສັ້ນທາງ :file:`/"
"media/` ຄວນຖືກລົບອອກຈາກການຕັ້ງຄ່າເຊີບເວີ HTTP; ເບິ່ງ :ref:`static-files`."

msgid ""
"`All changes in detail <https://github.com/WeblateOrg/weblate/milestone/160?"
"closed=1>`__."
msgstr ""
"`ລາຍລະອຽດການປ່ຽນແປງທັງໝົດ <https://github.com/WeblateOrg/weblate/milestone/160?"
"closed=1>`__."

msgid "Weblate 5.15.1"
msgstr "Weblate 5.15.1"

msgid "*Released on December 18th 2025.*"
msgstr "*ອອກເຜີຍແຜ່ເມື່ອວັນທີ 18 ທັນວາ 2025.*"

msgid ""
"Added :http:get:`/api/projects/(string:project)/languages/"
"(string:language_code)/file/` to download a ZIP file of all component "
"translations of a project for a specified language."
msgstr ""
"ເພີ່ມ :http:get:`/api/projects/(string:project)/languages/"
"(string:language_code)/file/` ເພື່ອດາວໂຫຼດໄຟລ໌ ZIP "
"ຂອງທຸກການແປພາສາອົງປະກອບຂອງໂຄງການສຳລັບພາສາທີ່ລະບຸ."

msgid "Updated list of OpenAI models."
msgstr "ອັບເດດລາຍການ OpenAI models."

msgid ""
"Added :doc:`/devel/migration` guide to help users migrate from other "
"localization platforms."
msgstr "ເພີ່ມຄຳແນະນຳ :doc:`/devel/migration` ເພື່ອຊ່ວຍຜູ້ໃຊ້ຍ້າຍຈາກແພລັດຟອມການແປພາສາອື່ນ."

msgid "Gracefully handle unreachable authentication providers."
msgstr "ຈັດການຜູ້ໃຫ້ບໍລິການການຢືນຢັນຕົວຕົນທີ່ເຂົ້າເຖິງບໍ່ໄດ້ຢ່າງສະຫງ່າງາມ."

msgid "Update language definitions to CLDR 48."
msgstr "ອັບເດດຄຳນິຍາມພາສາເປັນ CLDR 48."

msgid ""
"Git config file overwrite remote code execution "
"(:cve:`2025-68398` / :ghsa:`8vcg-cfxj-p5m3`)."
msgstr ""
"ການຂຽນທັບໄຟລ໌ Git config ເພື່ອປະຕິບັດໂຄ້ດທາງໄກ (:cve:`2025-68398` / :ghsa:`8vcg-"
"cfxj-p5m3`)."

msgid ""
"Arbitrary file read via symbolic links (:cve:`2025-68279` / :ghsa:`g925-"
"f788-4jh7`)."
msgstr ""
"ການອ່ານໄຟລ໌ຕາມໃຈຜ່ານ symbolic links (:cve:`2025-68279` / :ghsa:`g925-"
"f788-4jh7`)."

msgid "Locking error that prevented updating linked components."
msgstr "ຂໍ້ຜິດພາດການລັອກທີ່ປ້ອງກັນການອັບເດດອົງປະກອບທີ່ເຊື່ອມໂຍງ."

msgid "Fixed e-mail SSL configuration in Docker container."
msgstr "ແກ້ໄຂການຕັ້ງຄ່າ SSL ອີເມວໃນ Docker container."

msgid "Invitations on sites with required authentication."
msgstr "ຄຳເຊີນໃນເວັບໄຊທີ່ມີການຢືນຢັນຕົວຕົນທີ່ຕ້ອງການ."

msgid ""
"`All changes in detail <https://github.com/WeblateOrg/weblate/milestone/159?"
"closed=1>`__."
msgstr ""
"`ລາຍລະອຽດການປ່ຽນແປງທັງໝົດ <https://github.com/WeblateOrg/weblate/milestone/159?"
"closed=1>`__."

msgid "Weblate 5.15"
msgstr "Weblate 5.15"

msgid "*Released on December 15th 2025.*"
msgstr "*ອອກເຜີຍແຜ່ເມື່ອວັນທີ 15 ທັນວາ 2025.*"

msgid ""
"Batch automatic translation can now be manually triggered at project "
"language, category or component level, see :ref:`auto-translation`."
msgstr ""
"ການແປພາສາອັດຕະໂນມັດແບບແບັດຕອນນີ້ສາມາດກະຕຸ້ນດ້ວຍຕົນເອງໃນລະດັບພາສາໂຄງການ, ໝວດໝູ່ ຫຼື "
"ອົງປະກອບ, ເບິ່ງ :ref:`auto-translation`."

msgid ""
"Added ability to completely disable the admin contact form by "
"setting :setting:`CONTACT_FORM` to ``\"disabled\"``."
msgstr ""
"ເພີ່ມຄວາມສາມາດໃນການປິດໃຊ້ງານຟອມຕິດຕໍ່ຜູ້ເບິ່ງແຍງລະບົບຢ່າງສົມບູນໂດຍການຕັ້ງ :setting:`CONTACT_FORM` "
"ເປັນ ``\"disabled\"``."

msgid ""
"Added new Ollama machinery tool for local Ollama AI model integration, "
"see :ref:`mt-ollama`."
msgstr ""
"ເພີ່ມເຄື່ອງມື Ollama machinery ໃໝ່ສຳລັບການເຊື່ອມຕໍ່โมເດລ AI Ollama ທ້ອງຖິ່ນ, ເບິ່ງ :ref:`mt-"
"ollama`."

msgid ""
"Added :http:get:`/api/units/(int:id)/comments/` to get a list of comments "
"for the given translation unit."
msgstr ""
"ເພີ່ມ :http:get:`/api/units/(int:id)/comments/` "
"ເພື່ອເອົາລາຍການຄວາມຄິດເຫັນສຳລັບໜ່ວຍການແປພາສາທີ່ກຳນົດ."

msgid "Memory contents imported from TMX files include string context."
msgstr "ເນື້ອຫາໜ່ວຍຄວາມຈຳທີ່ນຳເຂົ້າຈາກໄຟລ໌ TMX ລວມເຖິງສະພາບການຂໍ້ຄວາມ."

msgid ""
":doc:`/formats/xliff2`, :doc:`/formats/nextcloud-json`, :doc:`/formats/"
"resjson`, and :doc:`/formats/toml` are now supported file formats."
msgstr ""
":doc:`/formats/xliff2`, :doc:`/formats/nextcloud-json`, :doc:`/formats/"
"resjson`, ແລະ :doc:`/formats/toml` ຕອນນີ້ເປັນຮູບແບບໄຟລ໌ທີ່ຮອງຮັບ."

msgid ""
":ref:`addon-weblate.fedora_messaging.publish` integration is now available "
"as add-on."
msgstr ""
"ການເຊື່ອມຕໍ່ :ref:`addon-weblate.fedora_messaging.publish` ຕອນນີ້ມີໃຫ້ເປັນສ່ວນເສີມ."

msgid "Added :ref:`check-laravel-format` quality check."
msgstr "ເພີ່ມການກວດສອບຄຸນນະພາບ :ref:`check-laravel-format`."

msgid "Added disk usage overview in :ref:`manage-performance`."
msgstr "ເພີ່ມພາບລວມການໃຊ້ງານດິດໃນ :ref:`manage-performance`."

msgid ":http:get:`/api/groups/` now includes ``admins``."
msgstr ":http:get:`/api/groups/` ຕອນນີ້ລວມມີ ``admins`` ແລ້ວ."

msgid ":ref:`mt-modernmt` better supports language variants."
msgstr ":ref:`mt-modernmt` ຮອງຮັບຮູບແບບພາສາໄດ້ດີຂຶ້ນ."

msgid ""
"Automatically translated strings are now identified by a dedicated flag "
"instead of a label."
msgstr "ຂໍ້ຄວາມທີ່ແປອັດຕະໂນມັດຕອນນີ້ຖືກລະບຸດ້ວຍທຸງສະເພາະແທນທີ່ຈະເປັນປ້າຍກຳກັບ."

msgid ""
":ref:`addon-weblate.discovery.discovery` preserves :ref:`file_format_params`."
msgstr ""
":ref:`addon-weblate.discovery.discovery` ຮັກສາຄ່າ :ref:`file_format_params` ໄວ້."

msgid ":ref:`mt-cyrtranslit` now supports Belarusian and Greek."
msgstr ":ref:`mt-cyrtranslit` ຕອນນີ້ຮອງຮັບພາສາເບລາຣັດ ແລະ ເກຣັກ."

msgid ""
":ref:`block-user` now accepts internal notes that are not visible to the "
"user."
msgstr ":ref:`block-user` ຕອນນີ້ສາມາດບັນທຶກໝາຍເຫດພາຍໃນທີ່ຜູ້ໃຊ້ເບິ່ງບໍ່ເຫັນ."

msgid ""
":ref:`addon-weblate.webhook.slack` and :ref:`addon-weblate.webhook.webhook` "
"can be installed multiple times."
msgstr ""
":ref:`addon-weblate.webhook.slack` ແລະ :ref:`addon-weblate.webhook.webhook` "
"ສາມາດຕິດຕັ້ງຫຼາຍຄັ້ງໄດ້."

msgid "Compatibility with Git SHA256 repositories."
msgstr "ຮອງຮັບການໃຊ້ງານກັບ Git SHA256."

msgid ""
"The allowed version control URLs can now be configured "
"using :setting:`VCS_ALLOW_SCHEMES` and :setting:`VCS_ALLOW_HOSTS`."
msgstr ""
"URLs ຄວບຄຸມເວີຊັນທີ່ອະນຸຍາດ ສາມາດຕັ້ງຄ່າໄດ້ໂດຍໃຊ້ :setting:`VCS_ALLOW_SCHEMES` "
"ແລະ :setting:`VCS_ALLOW_HOSTS`."

msgid ""
"The API timeout for creating pull requests or forking can now be configured "
"via :setting:`VCS_API_TIMEOUT`."
msgstr ""
"ເວລາ API timeout ສຳລັບການສ້າງ pull requests ຫຼື forking "
"ສາມາດຕັ້ງຄ່າໄດ້ຜ່ານ :setting:`VCS_API_TIMEOUT`."

msgid ""
"Improved VCS integration documentation to clarify Docker environment "
"variables, commit authorship, hosted vs. self-hosted setup, and "
"authentication options."
msgstr ""
"ປັບປຸງເອກະສານການເຊື່ອມຕໍ່ VCS ໃຫ້ຈະແຈ້ງຂຶ້ນກ່ຽວກັບຕົວປ່ຽນສະພາບແວດລ້ອມ Docker, ຜູ້ຂຽນ commit, "
"ການຕັ້ງຄ່າແບບ hosted ແລະ self-hosted, ແລະ ທາງເລືອກການຢືນຢັນຕົວຕົນ."

msgid "Timestamps from past are now shown with more detail."
msgstr "ເວລາໃນອະດີດຕອນນີ້ສະແດງລະອຽດຂຶ້ນ."

msgid ""
"Added two new :ref:`states` to provide more detailed tracking of work-in-"
"progress translations."
msgstr ""
"ເພີ່ມ :ref:`states` ໃໝ່ສອງຢ່າງ ເພື່ອໃຫ້ການຕິດຕາມວຽກງານແປທີ່ກຳລັງດຳເນີນຢູ່ມີຄວາມລະອຽດຫຼາຍຂຶ້ນ."

msgid ""
"Improper invitation validation upon accepting "
"(:cve:`2025-64725` / :ghsa:`m6hq-f4w9-qrjj`)."
msgstr ""
"ການກວດສອບຄຳເຊີນທີ່ບໍ່ຖືກຕ້ອງໃນຂະນະກຳລັງຍອມຮັບ (:cve:`2025-64725` / :ghsa:`m6hq-f4w9-"
"qrjj`)."

msgid ""
"Server-Side Request Forgery while cloning repository "
"(:cve:`2025-66407` / :ghsa:`hfpv-mc5v-p9mm`)."
msgstr ""
"ການປອມແປງຄຳຮ້ອງຂໍຝັ່ງເຊີບເວີ (Server-Side Request Forgery) ໃນຂະນະ cloning "
"repository (:cve:`2025-66407` / :ghsa:`hfpv-mc5v-p9mm`)."

msgid ""
"Over‑permissive webhook endpoint enabling mass repository updates plus "
"component enumeration (:cve:`2025-67492` / :ghsa:`pj86-258h-qrvf`)."
msgstr ""
"Webhook endpoint ທີ່ໃຫ້ສິດຫຼາຍເກີນໄປ ເຊິ່ງເຮັດໃຫ້ອັບເດດ repository ຈຳນວນຫຼາຍໄດ້ ແລະ "
"ອ່ານຂໍ້ມູນ component ໄດ້ (:cve:`2025-67492` / :ghsa:`pj86-258h-qrvf`)."

msgid ""
"Notification settings disclosure via Weblate API "
"(:cve:`2025-67715` / :ghsa:`3pmh-24wp-xpf4`)."
msgstr ""
"ການເປີດເຜີຍການຕັ້ງຄ່າການແຈ້ງເຕືອນຜ່ານ Weblate API "
"(:cve:`2025-67715` / :ghsa:`3pmh-24wp-xpf4`)."

msgid ""
":ref:`mt-deepl` integration now correctly handles translating to Chinese "
"variants."
msgstr ":ref:`mt-deepl` ເຊື່ອມຕໍ່ຕອນນີ້ຈັດການການແປເປັນພາສາຈີນຮູບແບບຕ່າງໆໄດ້ຢ່າງຖືກຕ້ອງ."

msgid ""
":doc:`/formats/csv` format saving translations with empty source fields when "
"using monolingual base files."
msgstr ":doc:`/formats/csv` ບັນທຶກການແປທີ່ມີຊ່ອງຕົ້ນສະບັບຫວ່າງເປົ່າ ເມື່ອໃຊ້ໄຟລ໌ຖານແບບພາສາດຽວ."

msgid ""
"Tighter validation of user and full names to avoid confusing homoglyphs."
msgstr "ການກວດສອບຊື່ຜູ້ໃຊ້ ແລະ ຊື່ເຕັມທີ່ເຂັ້ມງວດຂຶ້ນ ເພື່ອປ້ອງກັນການໃຊ້ຕົວອັກສອນທີ່ຄ້າຍຄືກັນສັບສົນ."

msgid "Avoid false positive checks upon committing pending changes."
msgstr "ປ້ອງກັນການກວດສອບຜິດພາດ (false positive) ໃນຂະນະ commit ການປ່ຽນແປງທີ່ຄ້າງຢູ່."

msgid "Performance improvements for file upload."
msgstr "ປັບປຸງປະສິດທິພາບການອັບໂຫຼດໄຟລ໌."

msgid "Show glossary matches for the source language."
msgstr "ສະແດງຄຳສັບທີ່ກົງກັນໃນອຸທານຸກົມສຳລັບພາສາຕົ້ນສະບັບ."

msgid "Pull/merge requests are now only created when necessary."
msgstr "Pull/merge requests ຕອນນີ້ຈະຖືກສ້າງຂຶ້ນເມື່ອຈຳເປັນເທົ່ານັ້ນ."

msgid ""
"Replaced custom ``RequireLoginMiddleware`` with Django 5.1's "
"``LoginRequiredMiddleware``. This makes settings ``LOGIN_REQUIRED_URLS`` and "
"``LOGIN_REQUIRED_URLS_EXCEPTIONS`` no longer supported, including their "
"Docker environment variable counterparts."
msgstr ""
"ປ່ຽນ ``RequireLoginMiddleware`` ແບບກຳນົດເອງດ້ວຍ ``LoginRequiredMiddleware`` ຂອງ "
"Django 5.1. ເຮັດໃຫ້ການຕັ້ງຄ່າ ``LOGIN_REQUIRED_URLS`` ແລະ "
"``LOGIN_REQUIRED_URLS_EXCEPTIONS`` ບໍ່ຖືກຮອງຮັບອີກຕໍ່ໄປ, ລວມເຖິງຕົວປ່ຽນສະພາບແວດລ້ອມ "
"Docker ທີ່ກ່ຽວຂ້ອງ."

msgid ""
":ref:`addon-weblate.webhook.webhook` secret length is now validated to match "
"the Standard Webhooks specification."
msgstr ""
"ຄວາມຍາວຂອງລະຫັດລັບ :ref:`addon-weblate.webhook.webhook` "
"ຕອນນີ້ຖືກກວດສອບໃຫ້ກົງກັບຂໍ້ກຳນົດ Standard Webhooks."

msgid "Python 3.12 or newer is now required."
msgstr "ຕ້ອງການ Python 3.12 ຫຼືໃໝ່ກວ່າ."

msgid "GLib 2.80 or newer is now required."
msgstr "ຕ້ອງການ GLib 2.80 ຫຼືໃໝ່ກວ່າ."

msgid "Dropped support for Web Monetization."
msgstr "ຍົກເລີກການຮອງຮັບ Web Monetization."

msgid ""
":doc:`/formats/laravel` no longer includes ``return`` prefix in the keys."
msgstr ":doc:`/formats/laravel` ບໍ່ລວມຄຳນຳໜ້າ ``return`` ໃນຄີ (keys) ອີກຕໍ່ໄປ."

msgid ""
"There are several changes in :file:`settings_example.py`, most notable are "
"changed settings ``CRISPY_ALLOWED_TEMPLATE_PACKS`` and ``INSTALLED_APPS``; "
"please adjust your settings accordingly."
msgstr ""
"ມີການປ່ຽນແປງຫຼາຍຢ່າງໃນ :file:`settings_example.py`, ສິ່ງທີ່ສຳຄັນທີ່ສຸດຄືການຕັ້ງຄ່າ "
"``CRISPY_ALLOWED_TEMPLATE_PACKS`` ແລະ ``INSTALLED_APPS``; "
"ກະລຸນາປັບການຕັ້ງຄ່າຂອງທ່ານໃຫ້ສອດຄ່ອງ."

msgid ""
"`All changes in detail <https://github.com/WeblateOrg/weblate/milestone/152?"
