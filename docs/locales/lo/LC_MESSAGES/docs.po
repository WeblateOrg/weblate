msgstr ""
":ref:`check-icu-message-format` ຈັດການ plurals ແບບນັຍ (implicit) ໄດ້ຢ່າງຖືກຕ້ອງ."

msgid ""
"Avoid storing inviting user information in the invited user audit log "
"(:cve:`2025-64326` / :ghsa:`gr35-vpx2-qxhc`)."
msgstr ""
"ຫຼີກເວັ້ນການເກັບຂໍ້ມູນຜູ້ເຊີນໃນບັນທຶກການກວດສອບ (audit log) ຂອງຜູ້ທີ່ຖືກເຊີນ "
"(:cve:`2025-64326` / :ghsa:`gr35-vpx2-qxhc`)."

msgid "Omit admin IP address from audit log."
msgstr "ບໍ່ຕ້ອງລວມ IP ແອັດມິນໃນ audit log."

msgid "Counting outgoing commits in the repository status."
msgstr "ການນັບ commits ທີ່ສົ່ງອອກໃນສະຖານະ repository."

msgid "Listing of other translations."
msgstr "ການສະແດງລາຍການການແປອື່ນໆ."

msgid "SAML configuration in the Docker container."
msgstr "ການຕັ້ງຄ່າ SAML ໃນ Docker container."

msgid ""
":ref:`project-commit_policy` could miss some changes in certain situations."
msgstr ":ref:`project-commit_policy` ອາດພາດບາງການປ່ຽນແປງໃນບາງສະຖານະການ."

msgid ""
"`All changes in detail <https://github.com/WeblateOrg/weblate/milestone/154?"
"closed=1>`__."
msgstr ""
"`ລາຍລະອຽດການປ່ຽນແປງທັງໝົດ <https://github.com/WeblateOrg/weblate/milestone/154?"
"closed=1>`__."

msgid "Weblate 5.14"
msgstr "Weblate 5.14"

msgid "*Released on October 22nd 2025.*"
msgstr "*ປ່ອຍອອກເມື່ອວັນທີ 22 ຕຸລາ 2025.*"

msgid ""
":ref:`addon-weblate.flags.target_repo_update` is now available as an add-on."
msgstr ""
":ref:`addon-weblate.flags.target_repo_update` ຕອນນີ້ໃຊ້ງານໄດ້ໃນຖານະ add-on."

msgid ":http:delete:`/api/projects/(string:project)/labels/(int:label_id)/`."
msgstr ":http:delete:`/api/projects/(string:project)/labels/(int:label_id)/`."

msgid "Added multivalue CSV in :ref:`download` for multivalue formats."
msgstr "ເພີ່ມ CSV ແບບຫຼາຍຄ່າໃນ :ref:`download` ສຳລັບຮູບແບບທີ່ມີຫຼາຍຄ່າ."

msgid ""
"New global permissions have been added to control viewing teams, users and "
"roles without edit rights, see :ref:`privileges`."
msgstr ""
"ເພີ່ມສິດທິທົ່ວລະບົບໃໝ່ ເພື່ອຄວບຄຸມການເບິ່ງທີມ, ຜູ້ໃຊ້ ແລະ ບົດບາດໂດຍບໍ່ມີສິດແກ້ໄຂ, "
"ເບິ່ງ :ref:`privileges`."

msgid ""
"New ``unit.bulk_edit`` permission for bulk editing operations, replacing the "
"overloaded use of ``translation.auto`` permission, see :ref:`privileges`."
msgstr ""
"ສິດທິ ``unit.bulk_edit`` ໃໝ່ສຳລັບການແກ້ໄຂແບບເປັນກຸ່ມ, ເຊິ່ງມາແທນທີ່ການໃຊ້ສິດ "
"``translation.auto`` ແບບເດີມ, ເບິ່ງ :ref:`privileges`."

msgid ":ref:`date-search`."
msgstr ":ref:`date-search`."

msgid "Last changed lookup in :ref:`search-strings`."
msgstr "ການຄົ້ນຫາການປ່ຽນແປງຫຼ້າສຸດໃນ :ref:`search-strings`."

msgid ":doc:`/security/localization-threat` documentation."
msgstr "ເອກະສານ :doc:`/security/localization-threat`."

msgid ":ref:`component-hide_glossary_matches` component setting."
msgstr "ການຕັ້ງຄ່າ component :ref:`component-hide_glossary_matches`."

msgid "Screenshots now can be uploaded from a URL, see :ref:`screenshots`."
msgstr "ຕອນນີ້ສາມາດອັບໂຫຼດພາບໜ້າຈໍຈາກ URL ໄດ້, ເບິ່ງ :ref:`screenshots`."

msgid ":ref:`hooks` improvements."
msgstr "ປັບປຸງ :ref:`hooks`."

msgid "Now follows :ref:`api-errors`."
msgstr "ຕອນນີ້ປະຕິບັດຕາມ :ref:`api-errors`."

msgid "Available in the OpenAPI."
msgstr "ມີໃຫ້ໃຊ້ໃນ OpenAPI."

msgid "Dropped long-deprecated endpoints."
msgstr "ຍົກເລີກ endpoints ທີ່ບໍ່ໄດ້ໃຊ້ງານດົນແລ້ວ."

msgid ""
"Improved activity logging for :ref:`addon-weblate.consistency.languages` add-"
"on."
msgstr ""
"ປັບປຸງການບັນທຶກກິດຈະກຳສຳລັບ add-on :ref:`addon-weblate.consistency.languages`."

msgid ""
":ref:`check-rst-references` and :ref:`check-rst-syntax` now support "
"substitutions."
msgstr ""
":ref:`check-rst-references` ແລະ :ref:`check-rst-syntax` ຕອນນີ້ຮອງຮັບການແທນຄ່າ "
"(substitutions)."

msgid ""
"Improved performance for :ref:`check-multiple-failures` and :ref:`check-long-"
"untranslated` checks with batch operations."
msgstr ""
"ປັບປຸງປະສິດທິພາບສຳລັບການກວດສອບ :ref:`check-multiple-failures` ແລະ :ref:`check-"
"long-untranslated` ດ້ວຍການເຮັດວຽກແບບ batch."

msgid ":ref:`file_format_params` can now be configured via the :ref:`api`."
msgstr ":ref:`file_format_params` ຕອນນີ້ສາມາດຕັ້ງຄ່າຜ່ານ :ref:`api` ໄດ້."

msgid "Admins can configure :ref:`expiring-accounts`."
msgstr "ແອັດມິນສາມາດຕັ້ງຄ່າ :ref:`expiring-accounts`."

msgid ""
"Rate limiting of notification e-mails, configurable "
"by :setting:`RATELIMIT_NOTIFICATION_LIMITS`."
msgstr ""
"ການຈຳກັດອັດຕາການສົ່ງອີເມວແຈ້ງເຕືອນ, "
"ສາມາດຕັ້ງຄ່າໄດ້ໂດຍ :setting:`RATELIMIT_NOTIFICATION_LIMITS`."

msgid ""
":guilabel:`Repository maintenance` now supports resetting the repository "
"while keeping the current state of translations in Weblate."
msgstr ""
":guilabel:`Repository maintenance` ຕອນນີ້ຮອງຮັບການຣີເຊັດ repository "
"ໂດຍຮັກສາສະຖານະປັດຈຸບັນຂອງການແປໃນ Weblate."

msgid ""
"Improved listing of :ref:`addon-weblate.autotranslate.autotranslate` "
"configuration."
msgstr ""
"ປັບປຸງການສະແດງລາຍການຕັ້ງຄ່າ :ref:`addon-weblate.autotranslate.autotranslate`."

msgid "Plurals and :ref:`file_format_params` handling on file upload."
msgstr "ການຈັດການ Plurals ແລະ :ref:`file_format_params` ເມື່ອອັບໂຫຼດໄຟລ໌."

msgid ":ref:`team-admins` can no longer edit teams besides membership."
msgstr ":ref:`team-admins` ບໍ່ສາມາດແກ້ໄຂທີມນອກເໜືອຈາກສະມາຊິກໄດ້ອີກ."

msgid "Highlighting syntax of overlapping elements."
msgstr "ການໄຮໄລ້ (highlight) ໄວຍາກອນຂອງອົງປະກອບທີ່ຊ້ອນກັນ."

msgid "Searching case sensitivity for short strings."
msgstr "ການຄົ້ນຫາແບບແຍກຕົວພິມນ້ອຍ-ໃຫຍ່ສຳລັບຂໍ້ຄວາມສັ້ນ."

msgid "Inconsistent file formatting for new translations."
msgstr "ຮູບແບບໄຟລ໌ບໍ່ສອດຄ່ອງສຳລັບການແປໃໝ່."

msgid ""
"Memory contents imported via the :wladmin:`import_memory` command are marked "
"as active."
msgstr "ເນື້ອຫາຄວາມຈຳທີ່ນຳເຂົ້າຜ່ານຄຳສັ່ງ :wladmin:`import_memory` ຖືກໝາຍເປັນ active."

msgid "Importing some strings from :doc:`/formats/xliff`."
msgstr "ການນຳເຂົ້າບາງຂໍ້ຄວາມຈາກ :doc:`/formats/xliff`."

msgid ""
"The default attributes for :ref:`saml-auth` in Docker container now matches "
"non-Docker defaults."
msgstr ""
"ຄຸນລັກສະນະເລີ່ມຕົ້ນສຳລັບ :ref:`saml-auth` ໃນ Docker container ຕອນນີ້ກົງກັບຄ່າເລີ່ມຕົ້ນແບບ "
"non-Docker."

msgid ""
"Dropped long-deprecated :http:get:`/hooks/update/(string:project)/"
"(string:component)/` and :http:get:`/hooks/update/(string:project)/`."
msgstr ""
"ຍົກເລີກ :http:get:`/hooks/update/(string:project)/(string:component)/` "
"ແລະ :http:get:`/hooks/update/(string:project)/` ທີ່ບໍ່ໄດ້ໃຊ້ງານດົນແລ້ວ."

msgid ""
"Removed Akismet spam protection integration as it was no longer effective "
"and used an unmaintained Python library."
msgstr ""
"ລຶບການເຊື່ອມຕໍ່ປ້ອງກັນສະແປມ Akismet ອອກ ເນື່ອງຈາກມັນບໍ່ມີປະສິດທິພາບແລ້ວ ແລະ ໃຊ້ຫ້ອງສະໝຸດ Python "
"ທີ່ບໍ່ມີການອັບເດດ."

msgid ""
"New positional argument (`activity_log_id`) passed to the add-on event "
"handlers, see :class:`weblate.addons.base.BaseAddon`. Adjust any custom "
"subclass accordingly."
msgstr ""
