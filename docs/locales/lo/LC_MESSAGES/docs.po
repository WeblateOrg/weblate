msgid "Weblate 0.9"
msgstr "Weblate 0.9"

msgid "*Released on April 18th 2012.*"
msgstr "*ອອກວັນທີ 18 ເມສາ 2012.*"

msgid "Fixed import of unknown languages."
msgstr "ແກ້ໄຂການນຳເຂົ້າພາສາທີ່ບໍ່ຮູ້ຈັກ."

msgid "Improved listing of nearby messages."
msgstr "ປັບປຸງການສະແດງລາຍການຂໍ້ຄວາມໃກ້ຄຽງ."

msgid "Improved several checks."
msgstr "ປັບປຸງການກວດສອບຫຼາຍຢ່າງ."

msgid "Documentation updates."
msgstr "ອັບເດດເອກະສານ."

msgid "Added definition for several more languages."
msgstr "ເພີ່ມຄໍານິຍາມສໍາລັບພາສາເພີ່ມເຕີມອີກຫຼາຍພາສາ."

msgid "Various code cleanups."
msgstr "ທໍາຄວາມສະອາດລະຫັດຕ່າງໆ."

msgid "Documentation improvements."
msgstr "ປັບປຸງເອກະສານ."

msgid "Changed file layout."
msgstr "ປ່ຽນຮູບແບບໄຟລ໌."

msgid "Update helper scripts to Django 1.4."
msgstr "ອັບເດດສະຄຣິບຊ່ວຍເຫຼືອເປັນ Django 1.4."

msgid "Improved navigation while translating."
msgstr "ປັບປຸງການນຳທາງໃນຂະນະແປ."

msgid "Better handling of po file renames."
msgstr "ຈັດການການປ່ຽນຊື່ໄຟລ໌ po ໄດ້ດີຂຶ້ນ."

msgid "Better validation while creating component."
msgstr "ການກວດສອບຄວາມຖືກຕ້ອງດີຂຶ້ນໃນຂະນະສ້າງອົງປະກອບ."

msgid "Integrated full setup into syncdb."
msgstr "ລວມການຕັ້ງຄ່າທັງໝົດເຂົ້າໃນ syncdb."

msgid "Added list of recent changes to all translation pages."
msgstr "ເພີ່ມລາຍການການປ່ຽນແປງຫຼ້າສຸດໃສ່ທຸກໜ້າການແປ."

msgid "Check for untranslated strings ignores format string only messages."
msgstr "ການກວດສອບຂໍ້ຄວາມທີ່ບໍ່ໄດ້ແປ ຈະລະເລີຍຂໍ້ຄວາມທີ່ມີພຽງແຕ່ format string."

msgid "Weblate 0.8"
msgstr "Weblate 0.8"

msgid "*Released on April 3rd 2012.*"
msgstr "*ອອກວັນທີ 3 ເມສາ 2012.*"

msgid "Replaced own full text search with Whoosh."
msgstr "ປ່ຽນແທນການຄົ້ນຫາຂໍ້ຄວາມເຕັມຂອງຕົນເອງດ້ວຍ Whoosh."

msgid "Various fixes and improvements to checks."
msgstr "ການແກ້ໄຂ ແລະ ປັບປຸງການກວດສອບຕ່າງໆ."

msgid "New command updatechecks."
msgstr "ຄໍາສັ່ງໃໝ່ updatechecks."

msgid "Lot of translation updates."
msgstr "ອັບເດດການແປຫຼາຍຢ່າງ."

msgid "Added dictionary for storing most frequently used terms."
msgstr "ເພີ່ມວັດຈະນານຸກົມສໍາລັບເກັບຄໍາສັບທີ່ໃຊ້ເລື້ອຍໆ."

msgid "Added /admin/report/ for overview of repositories status."
msgstr "ເພີ່ມ /admin/report/ ສໍາລັບພາບລວມຂອງສະຖານະຄັງເກັບລະຫັດ."

msgid "Machine translation services no longer block page loading."
msgstr "ບໍລິການແປດ້ວຍເຄື່ອງຈັກບໍ່ຂັດຂວາງການໂຫຼດໜ້າເວັບອີກຕໍ່ໄປ."

msgid "Management interface now contains also useful actions to update data."
msgstr "ອິນເຕີເຟດການຈັດການຕອນນີ້ຍັງມີການກະທຳທີ່ມີປະໂຫຍດໃນການອັບເດດຂໍ້ມູນ."

msgid "Records log of changes made by users."
msgstr "ບັນທຶກປະຫວັດການປ່ຽນແປງໂດຍຜູ້ໃຊ້."

msgid ""
"Ability to postpone commit to Git to generate less commits from single user."
msgstr "ຄວາມສາມາດໃນການເລື່ອນການ commit ໄປຍັງ Git ເພື່ອຫຼຸດຈໍານວນ commits ຈາກຜູ້ໃຊ້ຄົນດຽວ."

msgid "Possibility to browse failing checks."
msgstr "ຄວາມເປັນໄປໄດ້ໃນການຊອກຫາການກວດສອບທີ່ລົ້ມເຫຼວ."

msgid "Automatic translation using already translated strings."
msgstr "ການແປອັດຕະໂນມັດໂດຍໃຊ້ຂໍ້ຄວາມທີ່ແປແລ້ວ."

msgid "New about page showing used versions."
msgstr "ໜ້າກ່ຽວກັບໃໝ່ທີ່ສະແດງເວີຊັນທີ່ໃຊ້."

msgid "Django 1.4 compatibility."
msgstr "ຄວາມເຂົ້າກັນໄດ້ກັບ Django 1.4."

msgid "Ability to push changes to remote repo from web interface."
msgstr "ຄວາມສາມາດໃນການ push ການປ່ຽນແປງໄປຍັງ repo ທາງໄກຈາກອິນເຕີເຟດເວັບ."

msgid "Added review of translations done by others."
msgstr "ເພີ່ມການທົບທວນການແປໂດຍຜູ້ອື່ນ."

msgid "Weblate 0.7"
msgstr "Weblate 0.7"

msgid "*Released on February 16th 2012.*"
msgstr "*ອອກວັນທີ 16 ກຸມພາ 2012.*"

msgid "Direct support for GitHub notifications."
msgstr "ຮອງຮັບການແຈ້ງເຕືອນ GitHub ໂດຍກົງ."

msgid "Added support for cleaning up orphaned checks and translations."
msgstr "ເພີ່ມການຮອງຮັບສໍາລັບການລ້າງການກວດສອບ ແລະ ການແປທີ່ບໍ່ມີເຈົ້າຂອງ."

msgid "Displays nearby strings while translating."
msgstr "ສະແດງຂໍ້ຄວາມໃກ້ຄຽງໃນຂະນະແປ."

msgid "Displays similar strings while translating."
msgstr "ສະແດງຂໍ້ຄວາມທີ່ຄ້າຍຄືກັນໃນຂະນະແປ."

msgid "Improved searching for string."
msgstr "ປັບປຸງການຄົ້ນຫາຂໍ້ຄວາມ."

msgid "Weblate 0.6"
msgstr "Weblate 0.6"

msgid "*Released on February 14th 2012.*"
msgstr "*ອອກວັນທີ 14 ກຸມພາ 2012.*"

msgid "Added various checks for translated messages."
msgstr "ເພີ່ມການກວດສອບຕ່າງໆສໍາລັບຂໍ້ຄວາມທີ່ແປ."

msgid "Tunable access control."
msgstr "ການຄວບຄຸມການເຂົ້າເຖິງທີ່ປັບແຕ່ງໄດ້."

msgid "Improved handling of translations with new lines."
msgstr "ປັບປຸງການຈັດການການແປທີ່ມີແຖວໃໝ່."

msgid "Added client side sorting of tables."
msgstr "ເພີ່ມການຈັດລຽງຕາຕະລາງຝັ່ງລູກຄ້າ."

msgid "Please check upgrading instructions in case you are upgrading."
msgstr "ກະລຸນາກວດສອບຄໍາແນະນໍາການອັບເກຣດໃນກໍລະນີທີ່ທ່ານກໍາລັງອັບເກຣດ."

msgid "Weblate 0.5"
msgstr "Weblate 0.5"

msgid "*Released on February 12th 2012.*"
msgstr "*ອອກວັນທີ 12 ກຸມພາ 2012.*"

msgid "Support for machine translation using following online services:"
msgstr "ຮອງຮັບການແປດ້ວຍເຄື່ອງຈັກໂດຍໃຊ້ບໍລິການອອນລາຍຕໍ່ໄປນີ້:"

msgid "Several new translations."
msgstr "ການແປໃໝ່ຫຼາຍພາສາ."

msgid "Improved merging of upstream changes."
msgstr "ປັບປຸງການລວມການປ່ຽນແປງຈາກຕົ້ນທາງ."

msgid "Better handle concurrent git pull and translation."
msgstr "ຈັດການການ git pull ແລະ ການແປພ້ອມກັນໄດ້ດີຂຶ້ນ."

msgid "Propagating works for fuzzy changes as well."
msgstr "ການເຜີຍແຜ່ (propagating) ໃຊ້ໄດ້ກັບການປ່ຽນແປງແບບ fuzzy ນຳ."

msgid "Propagating works also for file upload."
msgstr "ການເຜີຍແຜ່ (propagating) ໃຊ້ໄດ້ກັບການອັບໂຫຼດໄຟລ໌ນຳ."

msgid "Fixed file downloads while using FastCGI (and possibly others)."
msgstr "ແກ້ໄຂການດາວໂຫຼດໄຟລ໌ໃນຂະນະທີ່ໃຊ້ FastCGI (ແລະ ອາດມີອັນອື່ນ)."

msgid "Weblate 0.4"
msgstr "Weblate 0.4"

msgid "*Released on February 8th 2012.*"
msgstr "*ອອກວັນທີ 8 ກຸມພາ 2012.*"

msgid "Added usage guide to documentation."
msgstr "ເພີ່ມຄູ່ມືການໃຊ້ງານໃສ່ເອກະສານ."

msgid "Fixed API hooks not to require CSRF protection."
msgstr "ແກ້ໄຂ API hooks ບໍ່ໃຫ້ຕ້ອງການການປ້ອງກັນ CSRF."

msgid "Weblate 0.3"
msgstr "Weblate 0.3"

msgid "Better display of source for plural translations."
msgstr "ສະແດງຕົ້ນສະບັບສໍາລັບການແປພົດພະຈານໄດ້ດີຂຶ້ນ."

msgid "New documentation in Sphinx format."
msgstr "ເອກະສານໃໝ່ໃນຮູບແບບ Sphinx."

msgid "Displays secondary languages while translating."
msgstr "ສະແດງພາສາຮອງໃນຂະນະແປ."

msgid "Improved error page to give list of existing projects."
msgstr "ປັບປຸງໜ້າຂໍ້ຜິດພາດເພື່ອໃຫ້ລາຍການໂຄງການທີ່ມີຢູ່."

msgid "New per language stats."
msgstr "ສະຖິຕິໃໝ່ແຍກຕາມພາສາ."

msgid "Weblate 0.2"
msgstr "Weblate 0.2"

msgid "*Released on February 7th 2012.*"
msgstr "*ອອກວັນທີ 7 ກຸມພາ 2012.*"

msgid "Improved validation of several forms."
msgstr "ປັບປຸງການກວດສອບຄວາມຖືກຕ້ອງຂອງແບບຟອມຕ່າງໆ."

msgid "Warn users on profile upgrade."
msgstr "ເຕືອນຜູ້ໃຊ້ເມື່ອມີການອັບເກຣດໂປຣໄຟລ໌."

msgid "Remember URL for login."
msgstr "ຈື່ URL ສໍາລັບການເຂົ້າສູ່ລະບົບ."

msgid "Naming of text areas while entering plural forms."
msgstr "ການຕັ້ງຊື່ພື້ນທີ່ຂໍ້ຄວາມໃນຂະນະປ້ອນຮູບແບບພົດພະຈານ."

msgid "Automatic expanding of translation area."
msgstr "ການຂະຫຍາຍພື້ນທີ່ການແປອັດຕະໂນມັດ."

msgid "Weblate 0.1"
msgstr "Weblate 0.1"

msgid "*Released on February 6th 2012.*"
msgstr "*ເຜີຍແຜ່ເມື່ອວັນທີ 6 ກຸມພາ 2012.*"

msgid "Initial release."
msgstr "ການເຜີຍແຜ່ຄັ້ງທຳອິດ."

msgid "Weblate 1.x series"
msgstr "ຊຸດ Weblate 1.x"

msgid "Weblate 1.9"
msgstr "Weblate 1.9"

msgid "*Released on May 6th 2014.*"
msgstr "*ອອກວັນທີ 6 ພຶດສະພາ 2014.*"

msgid "Django 1.6 compatibility."
msgstr "ຄວາມເຂົ້າກັນໄດ້ກັບ Django 1.6."

msgid "No longer maintained compatibility with Django 1.4."
msgstr "ບໍ່ຮັກສາຄວາມເຂົ້າກັນໄດ້ກັບ Django 1.4 ອີກຕໍ່ໄປ."

msgid "Management commands for locking/unlocking translations."
msgstr "ຄໍາສັ່ງຈັດການສໍາລັບການລັອກ/ປົດລັອກການແປ."

msgid "Improved support for Qt TS files."
msgstr "ປັບປຸງການຮອງຮັບສໍາລັບໄຟລ໌ Qt TS."

msgid "Users can now delete their account."
msgstr "ຜູ້ໃຊ້ສາມາດລຶບບັນຊີຂອງຕົນເອງໄດ້ແລ້ວ."

msgid "Avatars can be disabled."
msgstr "ສາມາດປິດການໃຊ້ງານຮູບໂປຣໄຟລ໌ໄດ້."

msgid "Merged first and last name attributes."
msgstr "ລວມແອດທຣິບິວຊື່ ແລະ ນາມສະກຸນເຂົ້າກັນ."

msgid "Avatars are now fetched and cached server side."
msgstr "ຕອນນີ້ຮູບໂປຣໄຟລ໌ຖືກດຶງ ແລະ ແຄດໄວ້ທີ່ຝັ່ງເຊີບເວີ."

msgid "Added support for shields.io badge."
msgstr "ເພີ່ມການຮອງຮັບສັນຍາລັກ shields.io."

msgid "Weblate 1.8"
msgstr "Weblate 1.8"

msgid "*Released on November 7th 2013.*"
msgstr "*ອອກວັນທີ 7 ພະຈິກ 2013.*"

msgid "Please check manual for upgrade instructions."
msgstr "ກະລຸນາກວດສອບຄູ່ມືສໍາລັບຄໍາແນະນໍາການອັບເກຣດ."

msgid "Nicer listing of project summary."
msgstr "ລາຍການສະຫຼຸບໂຄງການທີ່ເບິ່ງງ່າຍຂຶ້ນ."

msgid "Better visible options for sharing."
msgstr "ຕົວເລືອກສໍາລັບການແບ່ງປັນທີ່ເຫັນໄດ້ຊັດເຈນຂຶ້ນ."

msgid "More control over anonymous users privileges."
msgstr "ການຄວບຄຸມສິດທິຂອງຜູ້ໃຊ້ທີ່ບໍ່ລະບຸຕົວຕົນຫຼາຍຂຶ້ນ."

msgid ""
"Supports login using third party services, check manual for more details."
msgstr "ຮອງຮັບການເຂົ້າສູ່ລະບົບໂດຍໃຊ້ບໍລິການຂອງບຸກຄົນທີສາມ, ກວດສອບຄູ່ມືສໍາລັບລາຍລະອຽດເພີ່ມເຕີມ."

msgid "Users can login by e-mail instead of username."
msgstr "ຜູ້ໃຊ້ສາມາດເຂົ້າສູ່ລະບົບດ້ວຍອີເມວແທນຊື່ຜູ້ໃຊ້."

msgid "Improved source strings review."
msgstr "ປັບປຸງການທົບທວນຂໍ້ຄວາມຕົ້ນສະບັບ."

msgid "Searching across all strings."
msgstr "ການຄົ້ນຫາທົ່ວທຸກຂໍ້ຄວາມ."

msgid "Better tracking of source strings."
msgstr "ການຕິດຕາມຂໍ້ຄວາມຕົ້ນສະບັບທີ່ດີຂຶ້ນ."

msgid "Captcha protection for registration."
msgstr "ການປ້ອງກັນ Captcha ສໍາລັບການລົງທະບຽນ."

msgid "Weblate 1.7"
msgstr "Weblate 1.7"

msgid "*Released on October 7th 2013.*"
msgstr "*ອອກວັນທີ 7 ຕຸລາ 2013.*"

msgid "Support for checking Python brace format string."
msgstr "ຮອງຮັບການກວດສອບຂໍ້ຄວາມຮູບແບບວົງເລັບ Python."

msgid "Per component customization of quality checks."
msgstr "ການປັບແຕ່ງການກວດສອບຄຸນນະພາບແຍກຕາມອົງປະກອບ."

msgid "Detailed per translation stats."
msgstr "ສະຖິຕິລະອຽດແຍກຕາມການແປ."

msgid "Changed way of linking suggestions, checks and comments to strings."
msgstr "ປ່ຽນວິທີການເຊື່ອມໂຍງຄໍາແນະນໍາ, ການກວດສອບ ແລະ ຄວາມຄິດເຫັນກັບຂໍ້ຄວາມ."

msgid "Users can now add text to commit message."
msgstr "ຜູ້ໃຊ້ສາມາດເພີ່ມຂໍ້ຄວາມໃສ່ commit message ໄດ້ແລ້ວ."

msgid "Support for subscribing on new language requests."
msgstr "ຮອງຮັບການສະໝັກຮັບການແຈ້ງເຕືອນເມື່ອມີຄໍາຮ້ອງຂໍພາສາໃໝ່."

msgid "Support for adding new translations."
msgstr "ຮອງຮັບການເພີ່ມການແປໃໝ່."

msgid ""
"Widgets and charts are now rendered using Pillow instead of Pango + Cairo."
msgstr "ຕອນນີ້ Widgets ແລະ ແຜນພູມຖືກເຣັນເດີໂດຍໃຊ້ Pillow ແທນ Pango + Cairo."

msgid "Add status badge widget."
msgstr "ເພີ່ມ widget ສັນຍາລັກສະຖານະ."

msgid "Dropped invalid text direction check."
msgstr "ຍົກເລີກການກວດສອບທິດທາງຂໍ້ຄວາມທີ່ບໍ່ຖືກຕ້ອງ."

msgid "Changes in dictionary are now logged in history."
msgstr "ການປ່ຽນແປງໃນວັດຈະນານຸກົມຖືກບັນທຶກໄວ້ໃນປະຫວັດແລ້ວ."

msgid "Performance improvements for translation view."
msgstr "ປັບປຸງປະສິດທິພາບສໍາລັບມຸມມອງການແປ."

msgid "Weblate 1.6"
msgstr "Weblate 1.6"

msgid "*Released on July 25th 2013.*"
msgstr "*ອອກວັນທີ 25 ກໍລະກົດ 2013.*"

msgid "Nicer error handling on registration."
msgstr "ການຈັດການຂໍ້ຜິດພາດທີ່ດີຂຶ້ນໃນການລົງທະບຽນ."

msgid "Browsing of changes."
msgstr "ການຊອກຫາການປ່ຽນແປງ."

msgid "Fixed sorting of machine translation suggestions."
msgstr "ແກ້ໄຂການຈັດລຽງຄໍາແນະນໍາການແປດ້ວຍເຄື່ອງຈັກ."

msgid "Improved support for MyMemory machine translation."
msgstr "ປັບປຸງການຮອງຮັບການແປດ້ວຍເຄື່ອງຈັກ MyMemory."

msgid "Added support for Amagama machine translation."
msgstr "ເພີ່ມການຮອງຮັບການແປດ້ວຍເຄື່ອງຈັກ Amagama."

msgid "Various optimizations on frequently used pages."
msgstr "ການປັບປຸງໃຫ້ເໝາະສົມຕ່າງໆໃນໜ້າທີ່ໃຊ້ເລື້ອຍໆ."

msgid "Highlights searched phrase in search results."
msgstr "ເນັ້ນຄໍາທີ່ຄົ້ນຫາໃນຜົນການຄົ້ນຫາ."

msgid "Support for automatic fixups while saving the message."
msgstr "ຮອງຮັບການແກ້ໄຂອັດຕະໂນມັດໃນຂະນະບັນທຶກຂໍ້ຄວາມ."

msgid "Tracking of translation history and option to revert it."
msgstr "ການຕິດຕາມປະຫວັດການແປ ແລະ ຕົວເລືອກໃນການຍົກເລີກການປ່ຽນແປງ."

msgid "Added support for Google Translate API."
msgstr "ເພີ່ມການຮອງຮັບ Google Translate API."

msgid "Added support for managing SSH host keys."
msgstr "ເພີ່ມການຮອງຮັບສໍາລັບການຈັດການ SSH host keys."

msgid "Various form validation improvements."
msgstr "ການປັບປຸງການກວດສອບແບບຟອມຕ່າງໆ."

msgid "Various quality checks improvements."
msgstr "ການປັບປຸງການກວດສອບຄຸນນະພາບຕ່າງໆ."

msgid "Performance improvements for import."
msgstr "ປັບປຸງປະສິດທິພາບສໍາລັບການນຳເຂົ້າ."

msgid "Added support for voting on suggestions."
msgstr "ເພີ່ມການຮອງຮັບການລົງຄະແນນສຽງສໍາລັບຄໍາແນະນໍາ."

msgid "Cleanup of admin interface."
msgstr "ການທໍາຄວາມສະອາດອິນເຕີເຟດຜູ້ເບິ່ງແລ."

msgid "Weblate 1.5"
msgstr "Weblate 1.5"

msgid "*Released on April 16th 2013.*"
msgstr "*ອອກວັນທີ 16 ເມສາ 2013.*"

msgid "Added public user pages."
msgstr "ເພີ່ມໜ້າຜູ້ໃຊ້ສາທາລະນະ."

msgid "Better naming of plural forms."
msgstr "ການຕັ້ງຊື່ຮູບແບບພົດພະຈານທີ່ດີຂຶ້ນ."

msgid "Added support for TBX export of glossary."
msgstr "ເພີ່ມການຮອງຮັບສໍາລັບການສົ່ງອອກອະພິທານສັບໃນຮູບແບບ TBX."

msgid "Added support for Bitbucket notifications."
msgstr "ເພີ່ມການຮອງຮັບສໍາລັບການແຈ້ງເຕືອນ Bitbucket."

msgid ""
"Activity charts are now available for each translation, language or user."
msgstr "ຕອນນີ້ມີແຜນພູມກິດຈະກຳສໍາລັບແຕ່ລະການແປ, ພາສາ, ຫຼື ຜູ້ໃຊ້."

msgid "Extended options of import_project admin command."
msgstr "ຂະຫຍາຍຕົວເລືອກຂອງຄໍາສັ່ງຜູ້ເບິ່ງແລ import_project."

msgid "Compatible with Django 1.5."
msgstr "ເຂົ້າກັນໄດ້ກັບ Django 1.5."

msgid "Avatars are now shown using libravatar."
msgstr "ຕອນນີ້ຮູບໂປຣໄຟລ໌ຖືກສະແດງໂດຍໃຊ້ libravatar."

msgid "Added possibility to pretty print JSON export."
msgstr "ເພີ່ມຄວາມເປັນໄປໄດ້ໃນການພິມ JSON ທີ່ສົ່ງອອກໃຫ້ອ່ານງ່າຍ (pretty print)."

msgid "Various performance improvements."
msgstr "ການປັບປຸງປະສິດທິພາບຕ່າງໆ."

msgid ""
"Indicate failing checks or fuzzy strings in progress bars for projects or "
"languages as well."
msgstr ""
"ສະແດງການກວດສອບທີ່ລົ້ມເຫຼວ ຫຼື ຂໍ້ຄວາມແບບ fuzzy ໃນແຖບຄວາມຄືບໜ້າສໍາລັບໂຄງການ ຫຼື ພາສາດ້ວຍ."

msgid ""
"Added support for custom pre-commit hooks and committing additional files."
msgstr "ເພີ່ມການຮອງຮັບ hooks ກ່ອນການ commit ແບບກຳນົດເອງ ແລະ ການ commit ໄຟລ໌ເພີ່ມເຕີມ."

msgid "Rewritten search for better performance and user experience."
msgstr "ຂຽນການຄົ້ນຫາໃໝ່ເພື່ອປະສິດທິພາບ ແລະ ປະສົບການຜູ້ໃຊ້ທີ່ດີຂຶ້ນ."

msgid "New interface for machine translations."
msgstr "ອິນເຕີເຟດໃໝ່ສໍາລັບການແປດ້ວຍເຄື່ອງຈັກ."

msgid "Added support for monolingual po files."
msgstr "ເພີ່ມການຮອງຮັບໄຟລ໌ po ແບບພາສາດຽວ (monolingual)."

msgid "Extend amount of cached metadata to improve speed of various searches."
msgstr "ຂະຫຍາຍຈໍານວນ metadata ທີ່ແຄດໄວ້ເພື່ອປັບປຸງຄວາມໄວຂອງການຄົ້ນຫາຕ່າງໆ."

msgid "Now shows word counts as well."
msgstr "ຕອນນີ້ສະແດງຈໍານວນຄໍາສັບນຳ."

msgid "Weblate 1.4"
msgstr "Weblate 1.4"

msgid "*Released on January 23rd 2013.*"
msgstr "*ອອກວັນທີ 23 ມັງກອນ 2013.*"

msgid "Fixed deleting of checks/comments on string deletion."
msgstr "ແກ້ໄຂການລຶບການກວດສອບ/ຄວາມຄິດເຫັນເມື່ອລຶບຂໍ້ຄວາມ."

msgid "Added option to disable automatic propagation of translations."
msgstr "ເພີ່ມຕົວເລືອກໃນການປິດການເຜີຍແຜ່ການແປແບບອັດຕະໂນມັດ."

msgid "Added option to subscribe for merge failures."
msgstr "ເພີ່ມຕົວເລືອກສໍາລັບການສະໝັກຮັບການແຈ້ງເຕືອນຄວາມຜິດພາດໃນການຮວມ (merge)."

msgid "Correctly import on projects which needs custom ttkit loader."
msgstr "ນຳເຂົ້າໄດ້ຢ່າງຖືກຕ້ອງໃນໂຄງການທີ່ຕ້ອງການ ttkit loader ແບບກຳນົດເອງ."

msgid "Added sitemaps to allow easier access by crawlers."
msgstr "ເພີ່ມ sitemaps ເພື່ອອະນຸຍາດໃຫ້ crawlers ເຂົ້າເຖິງໄດ້ງ່າຍຂຶ້ນ."

msgid "Provide direct links to string in notification e-mails or feeds."
msgstr "ໃຫ້ລິ້ງໂດຍກົງໄປຍັງຂໍ້ຄວາມໃນອີເມວແຈ້ງເຕືອນ ຫຼື feeds."

msgid "Various improvements to admin interface."
msgstr "ການປັບປຸງຕ່າງໆຕໍ່ອິນເຕີເຟດຜູ້ເບິ່ງແລ."

msgid "Provide hints for production setup in admin interface."
msgstr "ໃຫ້ຄໍາແນະນໍາສໍາລັບການຕັ້ງຄ່າການຜະລິດ (production setup) ໃນອິນເຕີເຟດຜູ້ເບິ່ງແລ."

msgid "Added per language widgets and engage page."
msgstr "ເພີ່ມ widgets ແຍກຕາມພາສາ ແລະ ໜ້າ engage."

msgid "Improved translation locking handling."
msgstr "ປັບປຸງການຈັດການການລັອກການແປ."

msgid "Show code snippets for widgets in more variants."
msgstr "ສະແດງ snippets ລະຫັດສໍາລັບ widgets ໃນຫຼາຍຮູບແບບ."

msgid "Indicate failing checks or fuzzy strings in progress bars."
msgstr "ສະແດງການກວດສອບທີ່ລົ້ມເຫຼວ ຫຼື ຂໍ້ຄວາມແບບ fuzzy ໃນແຖບຄວາມຄືບໜ້າ."

msgid "More options for formatting commit message."
msgstr "ຕົວເລືອກເພີ່ມເຕີມສໍາລັບການຈັດຮູບແບບ commit message."

msgid "Fixed error handling with machine translation services."
msgstr "ແກ້ໄຂການຈັດການຂໍ້ຜິດພາດກັບບໍລິການແປດ້ວຍເຄື່ອງຈັກ."

msgid "Improved automatic translation locking behaviour."
msgstr "ປັບປຸງພຶດຕິກໍາການລັອກການແປອັດຕະໂນມັດ."

msgid "Support for showing changes from previous source string."
msgstr "ຮອງຮັບການສະແດງການປ່ຽນແປງຈາກຂໍ້ຄວາມຕົ້ນສະບັບກ່ອນໜ້າ."

msgid "Added support for substring search."
msgstr "ເພີ່ມການຮອງຮັບສໍາລັບການຄົ້ນຫາຂໍ້ຄວາມຍ່ອຍ."

msgid "Support for per project ACL."
msgstr "ຮອງຮັບ ACL ແຍກຕາມໂຄງການ."

msgid "Basic code coverage by unit tests."
msgstr "ການກວດສອບລະຫັດພື້ນຖານດ້ວຍ unit tests."

msgid "Weblate 1.3"
msgstr "Weblate 1.3"

msgid "*Released on November 16th 2012.*"
msgstr "*ອອກວັນທີ 16 ພະຈິກ 2012.*"

msgid "Compatibility with PostgreSQL database backend."
msgstr "ຄວາມເຂົ້າກັນໄດ້ກັບຖານຂໍ້ມູນ PostgreSQL."

msgid "Removes languages removed in upstream git repository."
msgstr "ລຶບພາສາທີ່ຖືກລຶບອອກຈາກ git repository ຕົ້ນທາງ."

msgid "Improved quality checks processing."
msgstr "ປັບປຸງການປະມວນຜົນການກວດສອບຄຸນນະພາບ."

msgid "Added new checks (BBCode, XML markup and newlines)."
msgstr "ເພີ່ມການກວດສອບໃໝ່ (BBCode, XML markup ແລະ ແຖວໃໝ່)."

msgid "Support for optional rebasing instead of merge."
msgstr "ຮອງຮັບການ rebasing ທາງເລືອກແທນການ merge."

msgid ""
"Possibility to relocate Weblate (for example to run it under /weblate path)."
msgstr "ຄວາມເປັນໄປໄດ້ໃນການຍ້າຍ Weblate (ຕົວຢ່າງ: ເພື່ອດໍາເນີນການພາຍໃຕ້ path /weblate)."

msgid "Support for manually choosing file type in case autodetection fails."
msgstr "ຮອງຮັບການເລືອກປະເພດໄຟລ໌ດ້ວຍຕົນເອງໃນກໍລະນີການກວດຫາອັດຕະໂນມັດລົ້ມເຫຼວ."

msgid "Better support for Android resources."
msgstr "ຮອງຮັບແຫຼ່ງຂໍ້ມູນ Android ໄດ້ດີຂຶ້ນ."

msgid "Support for generating SSH key from web interface."
msgstr "ຮອງຮັບການສ້າງ SSH key ຈາກອິນເຕີເຟດເວັບ."

msgid "More visible data exports."
msgstr "ການສົ່ງອອກຂໍ້ມູນທີ່ເຫັນໄດ້ຊັດເຈນຂຶ້ນ."

msgid "New buttons to enter some special characters."
msgstr "ປຸ່ມໃໝ່ສໍາລັບປ້ອນຕົວອັກສອນພິເສດບາງຢ່າງ."

msgid "Support for exporting dictionary."
msgstr "ຮອງຮັບການສົ່ງອອກວັດຈະນານຸກົມ."

msgid "Support for locking down whole Weblate installation."
msgstr "ຮອງຮັບການລັອກການຕິດຕັ້ງ Weblate ທັງໝົດ."

msgid "Checks for source strings and support for source strings review."
msgstr "ການກວດສອບສໍາລັບຂໍ້ຄວາມຕົ້ນສະບັບ ແລະ ຮອງຮັບການທົບທວນຂໍ້ຄວາມຕົ້ນສະບັບ."

msgid "Support for user comments for both translations and source strings."
msgstr "ຮອງຮັບຄວາມຄິດເຫັນຂອງຜູ້ໃຊ້ສໍາລັບທັງການແປ ແລະ ຂໍ້ຄວາມຕົ້ນສະບັບ."

msgid "Better changes log tracking."
msgstr "ການຕິດຕາມບັນທຶກການປ່ຽນແປງທີ່ດີຂຶ້ນ."

msgid "Changes can now be monitored using RSS."
msgstr "ຕອນນີ້ສາມາດຕິດຕາມການປ່ຽນແປງໂດຍໃຊ້ RSS."

msgid "Improved support for RTL languages."
msgstr "ປັບປຸງການຮອງຮັບສໍາລັບພາສາ RTL (ຂວາໄປຊ້າຍ)."

msgid "Weblate 1.2"
msgstr "Weblate 1.2"

msgid "*Released on August 14th 2012.*"
msgstr "*ອອກວັນທີ 14 ສິງຫາ 2012.*"

msgid ""
"Weblate now uses South for database migration, please check upgrade "
"instructions if you are upgrading."
msgstr ""
"ຕອນນີ້ Weblate ໃຊ້ South ສໍາລັບການຍ້າຍຖານຂໍ້ມູນ, "
"ກະລຸນາກວດສອບຄໍາແນະນໍາການອັບເກຣດຖ້າທ່ານກໍາລັງອັບເກຣດ."

msgid "Fixed minor issues with linked git repos."
msgstr "ແກ້ໄຂບັນຫາເລັກນ້ອຍກັບ git repos ທີ່ເຊື່ອມໂຍງໄວ້."

msgid ""
"New introduction page for engaging people with translating using Weblate."
msgstr "ໜ້າແນະນໍາໃໝ່ສໍາລັບການດຶງດູດຜູ້ຄົນໃຫ້ມາແປໂດຍໃຊ້ Weblate."

msgid "Added widgets which can be used for promoting translation projects."
msgstr "ເພີ່ມ widgets ທີ່ສາມາດໃຊ້ສໍາລັບການໂຄສະນາໂຄງການແປ."

msgid "Added option to reset repository to origin (for privileged users)."
msgstr "ເພີ່ມຕົວເລືອກໃນການຣີເຊັດຄັງເກັບລະຫັດໄປຍັງ origin (ສໍາລັບຜູ້ໃຊ້ທີ່ມີສິດພິເສດ)."

msgid "Project or component can now be locked for translations."
msgstr "ໂຄງການ ຫຼື ອົງປະກອບສາມາດຖືກລັອກສໍາລັບການແປໄດ້ແລ້ວ."

msgid "Possibility to disable some translations."
msgstr "ຄວາມເປັນໄປໄດ້ໃນການປິດໃຊ້ງານການແປບາງຢ່າງ."

msgid "Configurable options for adding new translations."
msgstr "ຕົວເລືອກທີ່ສາມາດກຳນົດຄ່າໄດ້ສໍາລັບການເພີ່ມການແປໃໝ່."

msgid "Configuration of git commits per project."
msgstr "ການຕັ້ງຄ່າ git commits ແຍກຕາມໂຄງການ."

msgid "Simple antispam protection."
msgstr "ການປ້ອງກັນສະແປມແບບງ່າຍດາຍ."

msgid "Better layout of main page."
msgstr "ໂຄງຮ່າງໜ້າຫຼັກທີ່ດີຂຶ້ນ."

msgid "Support for automatically pushing changes on every commit."
msgstr "ຮອງຮັບການ push ການປ່ຽນແປງໂດຍອັດຕະໂນມັດໃນທຸກໆ commit."

msgid "Support for e-mail notifications of translators."
msgstr "ຮອງຮັບການແຈ້ງເຕືອນທາງອີເມວຂອງນັກແປ."

msgid "List only used languages in preferences."
msgstr "ສະແດງສະເພາະພາສາທີ່ໃຊ້ໃນການຕັ້ງຄ່າ."

msgid "Improved handling of not known languages when importing project."
msgstr "ປັບປຸງການຈັດການພາສາທີ່ບໍ່ຮູ້ຈັກເມື່ອນໍາເຂົ້າໂຄງການ."

msgid "Support for locking translation by translator."
msgstr "ຮອງຮັບການລັອກການແປໂດຍນັກແປ."

msgid "Optionally maintain ``Language-Team`` header in po file."
msgstr "ຮັກສາສ່ວນຫົວ ``Language-Team`` ໃນໄຟລ໌ po ທາງເລືອກ."

msgid "Include some statistics in about page."
msgstr "ລວມສະຖິຕິບາງຢ່າງໃນໜ້າກ່ຽວກັບ."

msgid "Supports (and requires) django-registration 0.8."
msgstr "ຮອງຮັບ (ແລະ ຕ້ອງການ) django-registration 0.8."

msgid "Caching counts of strings with failing checks."
msgstr "ການແຄດຈໍານວນຂໍ້ຄວາມທີ່ມີການກວດສອບທີ່ລົ້ມເຫຼວ."

msgid "Checking of requirements during setup."
msgstr "ການກວດສອບຄວາມຕ້ອງການໃນລະຫວ່າງການຕັ້ງຄ່າ."

msgid "Weblate 1.1"
msgstr "Weblate 1.1"

msgid "*Released on July 4th 2012.*"
msgstr "*ອອກວັນທີ 4 ກໍລະກົດ 2012.*"

msgid "Improved several translations."
msgstr "ປັບປຸງການແປຫຼາຍຢ່າງ."

msgid "Added support for shared git repositories across components."
msgstr "ເພີ່ມການຮອງຮັບ git repositories ທີ່ໃຊ້ຮ່ວມກັນໃນແຕ່ລະອົງປະກອບ."

msgid "Do not necessary commit on every attempt to pull remote repo."
msgstr "ບໍ່ຈຳເປັນຕ້ອງ commit ໃນທຸກຄັ້ງທີ່ມີການ pull ຈາກ remote repo."

msgid "Added support for offloading indexing."
msgstr "ເພີ່ມການຮອງຮັບການໂອນຍ້າຍການຈັດດັດສະນີ (indexing)."

msgid "Weblate 1.0"
msgstr "Weblate 1.0"

msgid "*Released on May 10th 2012.*"
msgstr "*ປ່ອຍອອກເມື່ອວັນທີ 10 ພຶດສະພາ 2012.*"

msgid "Improved validation while adding/saving component."
msgstr "ປັບປຸງການກວດສອບຄວາມຖືກຕ້ອງໃນຂະນະເພີ່ມ/ບັນທຶກອົງປະກອບ."

msgid "Experimental support for Android component files (needs patched ttkit)."
msgstr "ການຮອງຮັບແບບທົດລອງສຳລັບໄຟລ໌ອົງປະກອບ Android (ຕ້ອງການ ttkit ທີ່ຖືກ patched)."

msgid "Updates from hooks are run in background."
msgstr "ການອັບເດດຈາກ hooks ຈະຖືກດຳເນີນການໃນພື້ນຫຼັງ."

msgid "Improved installation instructions."
msgstr "ປັບປຸງຄຳແນະນຳການຕິດຕັ້ງ."

msgid "Improved navigation in dictionary."
msgstr "ປັບປຸງການນຳທາງໃນວັດຈະນານຸກົມ."

msgid "Weblate 2.x series"
msgstr "ຊຸດ Weblate 2.x"

msgid "Weblate 2.20"
msgstr "Weblate 2.20"

msgid "*Released on April 4th 2018.*"
msgstr "*ປ່ອຍອອກເມື່ອວັນທີ 4 ເມສາ 2018.*"

msgid "Improved speed of cloning subversion repositories."
msgstr "ປັບປຸງຄວາມໄວໃນການ clone subversion repositories."

msgid "Changed repository locking to use third party library."
msgstr "ປ່ຽນການລັອກ repository ມາໃຊ້ຫໍສະໝຸດ (library) ຂອງພາກສ່ວນທີສາມ."

msgid "Added support for downloading only strings needing action."
msgstr "ເພີ່ມການຮອງຮັບການດາວໂຫຼດສະເພາະຂໍ້ຄວາມທີ່ຕ້ອງການການດຳເນີນການ."

msgid "Added support for searching in several languages at once."
msgstr "ເພີ່ມການຮອງຮັບການຄົ້ນຫາຫຼາຍພາສາພ້ອມກັນ."

msgid "New add-on to configure gettext output wrapping."
msgstr "ສ່ວນເສີມໃໝ່ສຳລັບຕັ້ງຄ່າການຫໍ່ (wrapping) ຜົນລັດຂອງ gettext."

msgid "New add-on to configure JSON formatting."
msgstr "ສ່ວນເສີມໃໝ່ສຳລັບຕັ້ງຄ່າຮູບແບບ JSON."

msgid ""
"Added support for authentication in API using RFC 6750 compatible Bearer "
"authentication."
msgstr ""
"ເພີ່ມການຮອງຮັບການພິສູດຕົວຕົນໃນ API ໂດຍໃຊ້ Bearer authentication ທີ່ເຂົ້າກັນໄດ້ກັບ RFC 6750."

msgid ""
"Added support for automatic translation using machine translation services."
msgstr "ເພີ່ມການຮອງຮັບການແປອັດຕະໂນມັດໂດຍໃຊ້ບໍລິການແປພາສາດ້ວຍເຄື່ອງຈັກ."

msgid "Added support for HTML markup in whiteboard messages."
msgstr "ເພີ່ມການຮອງຮັບ HTML markup ໃນຂໍ້ຄວາມກະດານຂາວ (whiteboard)."

msgid "Added support for mass changing state of strings."
msgstr "ເພີ່ມການຮອງຮັບການປ່ຽນສະຖານະຂໍ້ຄວາມຈຳນວນຫຼາຍ."

msgid ""
"Translate-toolkit at least 2.3.0 is now required, older versions are no "
"longer supported."
msgstr "ຕ້ອງການ Translate-toolkit ເວີຊັນ 2.3.0 ຂຶ້ນໄປ, ເວີຊັນເກົ່າກວ່ານີ້ຈະບໍ່ຖືກຮອງຮັບອີກຕໍ່ໄປ."

msgid "Added built-in translation memory."
msgstr "ເພີ່ມໜ່ວຍຄວາມຈຳການແປ (translation memory) ແບບໃນຕົວ."

msgid ""
"Added componentlists overview to dashboard and per component list overview "
"pages."
msgstr ""
"ເພີ່ມພາບລວມລາຍການອົງປະກອບ (componentlists) ໃສ່ dashboard "
"ແລະໜ້າພາບລວມລາຍການຂອງແຕ່ລະອົງປະກອບ."

msgid "Added support for DeepL machine translation service."
msgstr "ເພີ່ມການຮອງຮັບບໍລິການແປພາສາ DeepL."

msgid "Machine translation results are now cached inside Weblate."
msgstr "ຜົນລັດການແປດ້ວຍເຄື່ອງຈັກຈະຖືກເກັບໄວ້ (cache) ພາຍໃນ Weblate ແລ້ວ."

msgid "Added support for reordering committed changes."
msgstr "ເພີ່ມການຮອງຮັບການຈັດລຽງລຳດັບການປ່ຽນແປງທີ່ commit ແລ້ວ."

msgid "Weblate 2.19.1"
msgstr "Weblate 2.19.1"

msgid "*Released on February 20th 2018.*"
msgstr "*ປ່ອຍອອກເມື່ອວັນທີ 20 ກຸມພາ 2018.*"

msgid "Fixed migration issue on upgrade from 2.18."
msgstr "ແກ້ໄຂບັນຫາການຍ້າຍຂໍ້ມູນ (migration) ເມື່ອອັບເກຣດຈາກ 2.18."

msgid "Improved file upload API validation."
msgstr "ປັບປຸງການກວດສອບ API ສຳລັບການອັບໂຫຼດໄຟລ໌."

msgid "Weblate 2.19"
msgstr "Weblate 2.19"

msgid "*Released on February 15th 2018.*"
msgstr "*ປ່ອຍອອກເມື່ອວັນທີ 15 ກຸມພາ 2018.*"

msgid "Fixed imports across some file formats."
msgstr "ແກ້ໄຂການນຳເຂົ້າໃນບາງຮູບແບບໄຟລ໌."

msgid "Display human friendly browser information in audit log."
msgstr "ສະແດງຂໍ້ມູນບຣາວເຊີທີ່ອ່ານເຂົ້າໃຈງ່າຍໃນ audit log."

msgid "Added TMX exporter for files."
msgstr "ເພີ່ມຕົວສົ່ງອອກ TMX ສຳລັບໄຟລ໌."

msgid "Various performance improvements for loading translation files."
msgstr "ປັບປຸງປະສິດທິພາບຫຼາຍຢ່າງສຳລັບການໂຫຼດໄຟລ໌ແປພາສາ."

msgid ""
"Added option to disable access management in Weblate in favor of Django one."
msgstr "ເພີ່ມທາງເລືອກໃນການປິດການຈັດການການເຂົ້າເຖິງໃນ Weblate ເພື່ອໃຊ້ຂອງ Django ແທນ."

msgid "Improved glossary lookup speed for large strings."
msgstr "ປັບປຸງຄວາມໄວໃນການຄົ້ນຫາວັດຈະນານຸກົມສຳລັບຂໍ້ຄວາມຍາວ."

msgid "Compatibility with django_auth_ldap 1.3.0."
msgstr "ຮອງຮັບການເຮັດວຽກຮ່ວມກັບ django_auth_ldap 1.3.0."

msgid "Configuration errors are now stored and reported persistently."
msgstr "ຂໍ້ຜິດພາດໃນການຕັ້ງຄ່າຈະຖືກເກັບບັນທຶກ ແລະລາຍງານຢ່າງຖາວອນ."

msgid "Honor ignore flags in whitespace autofixer."
msgstr "ນຳໃຊ້ທຸງ (flags) ການລະເລີຍໃນຕົວແກ້ໄຂຊ່ອງຫວ່າງອັດຕະໂນມັດ."

msgid "Improved compatibility with some Subversion setups."
msgstr "ປັບປຸງຄວາມເຂົ້າກັນໄດ້ກັບບາງການຕັ້ງຄ່າ Subversion."

msgid "Improved built-in machine translation service."
msgstr "ປັບປຸງບໍລິການແປພາສາດ້ວຍເຄື່ອງຈັກທີ່ຕິດມາໃນຕົວ."

msgid "Added support for SAP Translation Hub service."
msgstr "ເພີ່ມການຮອງຮັບບໍລິການ SAP Translation Hub."

msgid "Added support for Microsoft Terminology service."
msgstr "ເພີ່ມການຮອງຮັບບໍລິການ Microsoft Terminology."

msgid "Removed support for advertisement in notification e-mails."
msgstr "ເອົາການຮອງຮັບໂຄສະນາໃນອີເມວແຈ້ງເຕືອນອອກ."

msgid "Improved translation progress reporting at language level."
msgstr "ປັບປຸງການລາຍງານຄວາມຄືບໜ້າການແປໃນລະດັບພາສາ."

msgid "Improved support for different plural formulas."
msgstr "ປັບປຸງການຮອງຮັບສູດພົດ (plural formulas) ທີ່ແຕກຕ່າງກັນ."

msgid "Added support for Subversion repositories not using stdlayout."
msgstr "ເພີ່ມການຮອງຮັບ Subversion repositories ທີ່ບໍ່ໄດ້ໃຊ້ stdlayout."

msgid "Added add-ons to customize translation workflows."
msgstr "ເພີ່ມສ່ວນເສີມເພື່ອປັບແຕ່ງຂັ້ນຕອນການເຮັດວຽກຂອງການແປ."

msgid "Weblate 2.18"
msgstr "Weblate 2.18"

msgid "*Released on December 15th 2017.*"
msgstr "*ປ່ອຍອອກເມື່ອວັນທີ 15 ທັນວາ 2017.*"

msgid "Extended contributor stats."
msgstr "ຂະຫຍາຍສະຖິຕິຜູ້ປະກອບສ່ວນ."

msgid "Improved configuration of special characters virtual keyboard."
msgstr "ປັບປຸງການຕັ້ງຄ່າແປ້ນພິມສະເໝືອນສຳລັບຕົວອັກສອນພິເສດ."

msgid "Added support for DTD file format."
msgstr "ເພີ່ມການຮອງຮັບໄຟລ໌ຮູບແບບ DTD."

msgid ""
"Changed keyboard shortcuts to less likely collide with browser/system ones."
msgstr "ປ່ຽນປຸ່ມລັດແປ້ນພິມເພື່ອຫຼຸດຜ່ອນການທັບຊ້ອນກັບຂອງບຣາວເຊີ/ລະບົບ."

msgid "Improved support for approved flag in XLIFF files."
msgstr "ປັບປຸງການຮອງຮັບທຸງ 'ອະນຸມັດ' (approved flag) ໃນໄຟລ໌ XLIFF."

msgid "Added support for not wrapping long strings in gettext PO files."
msgstr "ເພີ່ມການຮອງຮັບການບໍ່ຫໍ່ຂໍ້ຄວາມຍາວໃນໄຟລ໌ gettext PO."

msgid "Added button to copy permalink for current translation."
msgstr "ເພີ່ມປຸ່ມສຳລັບສຳເນົາລິ້ງຖາວອນ (permalink) ຂອງການແປປັດຈຸບັນ."

msgid "Dropped support for Django 1.10 and added support for Django 2.0."
msgstr "ຍົກເລີກການຮອງຮັບ Django 1.10 ແລະເພີ່ມການຮອງຮັບ Django 2.0."

msgid "Removed locking of translations while translating."
msgstr "ເອົາການລັອກການແປອອກໃນຂະນະກຳລັງແປ."

msgid "Added support for adding new strings to monolingual translations."
msgstr "ເພີ່ມການຮອງຮັບການເພີ່ມຂໍ້ຄວາມໃໝ່ສຳລັບການແປແບບພາສາດຽວ (monolingual)."

msgid "Added support for translation workflows with dedicated reviewers."
msgstr "ເພີ່ມການຮອງຮັບຂັ້ນຕອນການແປທີ່ມີຜູ້ກວດສອບໂດຍສະເພາະ."

msgid "Weblate 2.17.1"
msgstr "Weblate 2.17.1"

msgid "*Released on October 13th 2017.*"
msgstr "*ປ່ອຍອອກເມື່ອວັນທີ 13 ຕຸລາ 2017.*"

msgid "Fixed running testsuite in some specific situations."
msgstr "ແກ້ໄຂການແລ່ນ testsuite ໃນບາງສະຖານະການສະເພາະ."

msgid "Locales updates."
msgstr "ອັບເດດພາສາ (Locales)."

msgid "Weblate 2.17"
msgstr "Weblate 2.17"

msgid "Weblate by default does shallow Git clones now."
msgstr "ຕອນນີ້ Weblate ໃຊ້ shallow Git clones ເປັນຄ່າເລີ່ມຕົ້ນ."

msgid "Improved performance when updating large translation files."
msgstr "ປັບປຸງປະສິດທິພາບໃນການອັບເດດໄຟລ໌ແປພາສາຂະໜາດໃຫຍ່."

msgid "Added support for blocking certain e-mails from registration."
msgstr "ເພີ່ມການຮອງຮັບການບລັອກບາງອີເມວຈາກການລົງທະບຽນ."

msgid "Users can now delete their own comments."
msgstr "ຕອນນີ້ຜູ້ໃຊ້ສາມາດລຶບຄຳເຫັນຂອງຕົນເອງໄດ້ແລ້ວ."

msgid "Added preview step to search and replace feature."
msgstr "ເພີ່ມຂັ້ນຕອນການເບິ່ງຕົວຢ່າງສຳລັບຟີເຈີຄົ້ນຫາ ແລະແທນທີ່."

msgid "Client side persistence of settings in search and upload forms."
msgstr "ການເກັບຄ່າຕ່າງໆໃນຝັ່ງ Client ສຳລັບແບບຟອມຄົ້ນຫາ ແລະອັບໂຫຼດ."

msgid "Extended search capabilities."
msgstr "ຂະຫຍາຍຄວາມສາມາດໃນການຄົ້ນຫາ."

msgid "More fine grained per project ACL configuration."
msgstr "ການຕັ້ງຄ່າ ACL ແບບລະອຽດຕໍ່ໂຄງການ."

msgid "Default value of BASE_DIR has been changed."
msgstr "ຄ່າເລີ່ມຕົ້ນຂອງ BASE_DIR ຖືກປ່ຽນແລ້ວ."

msgid "Added two step account removal to prevent accidental removal."
msgstr "ເພີ່ມຂັ້ນຕອນການລຶບບັນຊີແບບສອງຂັ້ນຕອນເພື່ອປ້ອງກັນການລຶບໂດຍບໍ່ຕັ້ງໃຈ."

msgid "Project access control settings is now editable."
msgstr "ຕອນນີ້ການຕັ້ງຄ່າການຄວບຄຸມການເຂົ້າເຖິງໂຄງການສາມາດແກ້ໄຂໄດ້ແລ້ວ."

msgid "Added optional spam protection for suggestions using Akismet."
msgstr "ເພີ່ມການປ້ອງກັນສະແປມແບບທາງເລືອກສຳລັບຄຳແນະນຳໂດຍໃຊ້ Akismet."

msgid "Weblate 2.16"
msgstr "Weblate 2.16"

msgid "*Released on August 11th 2017.*"
msgstr "*ປ່ອຍອອກເມື່ອວັນທີ 11 ສິງຫາ 2017.*"

msgid "Added support for nested JSON format."
msgstr "ເພີ່ມການຮອງຮັບຮູບແບບ JSON ແບບຊ້ອນ."

msgid "Added support for WebExtension JSON format."
msgstr "ເພີ່ມການຮອງຮັບຮູບແບບ WebExtension JSON."

msgid "Fixed git exporter authentication."
msgstr "ແກ້ໄຂການພິສູດຕົວຕົນຂອງ git exporter."

msgid "Improved CSV import in certain situations."
msgstr "ປັບປຸງການນຳເຂົ້າ CSV ໃນບາງສະຖານະການ."

msgid "Improved look of Other translations widget."
msgstr "ປັບປຸງຮູບລັກສະນະຂອງວິດເຈັດ 'ການແປອື່ນໆ'."

msgid "The max-length checks is now enforcing length of text in form."
msgstr "ຕອນນີ້ການກວດສອບຄວາມຍາວສູງສຸດ (max-length) ຈະບັງຄັບຄວາມຍາວຂອງຂໍ້ຄວາມໃນແບບຟອມ."

msgid "Make the commit_pending age configurable per component."
msgstr "ເຮັດໃຫ້ອາຍຸຂອງ commit_pending ສາມາດຕັ້ງຄ່າໄດ້ຕໍ່ອົງປະກອບ."

msgid "Various user interface cleanups."
msgstr "ການທຳຄວາມສະອາດອິນເຕີເຟດຜູ້ໃຊ້ຕ່າງໆ."

msgid "Fixed component/project/site wide search for translations."
msgstr "ແກ້ໄຂການຄົ້ນຫາການແປໃນລະດັບອົງປະກອບ/ໂຄງການ/ເວັບໄຊທ໌."

msgid "Weblate 2.15"
msgstr "Weblate 2.15"

msgid "*Released on June 30th 2017.*"
msgstr "*ປ່ອຍອອກເມື່ອວັນທີ 30 ມິຖຸນາ 2017.*"

msgid "Show more related translations in other translations."
msgstr "ສະແດງການແປທີ່ກ່ຽວຂ້ອງເພີ່ມເຕີມໃນການແປອື່ນໆ."

msgid "Add option to see translations of current string to other languages."
msgstr "ເພີ່ມທາງເລືອກໃນການເບິ່ງການແປຂອງຂໍ້ຄວາມປັດຈຸບັນໃນພາສາອື່ນ."

msgid "Use 4 plural forms for Lithuanian by default."
msgstr "ໃຊ້ 4 ຮູບແບບພົດສຳລັບພາສາລີທົວນຽນເປັນຄ່າເລີ່ມຕົ້ນ."

msgid "Fixed upload for monolingual files of different format."
msgstr "ແກ້ໄຂການອັບໂຫຼດສຳລັບໄຟລ໌ແບບພາສາດຽວໃນຮູບແບບອື່ນ."

msgid "Improved error messages on failed authentication."
msgstr "ປັບປຸງຂໍ້ຄວາມຂໍ້ຜິດພາດເມື່ອການພິສູດຕົວຕົນລົ້ມເຫຼວ."

msgid "Keep page state when removing word from glossary."
msgstr "ຮັກສາສະຖານະໜ້າເວັບເມື່ອລຶບຄຳສັບອອກຈາກວັດຈະນານຸກົມ."

msgid "Added direct link to edit secondary language translation."
msgstr "ເພີ່ມລິ້ງໂດຍກົງເພື່ອແກ້ໄຂການແປພາສາສຳຮອງ."

msgid "Added Perl format quality check."
msgstr "ເພີ່ມການກວດສອບຄຸນນະພາບຮູບແບບ Perl."

msgid "Added support for rejecting reused passwords."
msgstr "ເພີ່ມການຮອງຮັບການປະຕິເສດລະຫັດຜ່ານທີ່ໃຊ້ຊ້ຳ."

msgid "Extended toolbar for editing RTL languages."
msgstr "ຂະຫຍາຍແຖບເຄື່ອງມືສຳລັບການແກ້ໄຂພາສາແບບຂວາໄປຊ້າຍ (RTL)."

msgid "Weblate 2.14.1"
msgstr "Weblate 2.14.1"

msgid "*Released on May 24th 2017.*"
msgstr "*ປ່ອຍອອກເມື່ອວັນທີ 24 ພຶດສະພາ 2017.*"

msgid "Fixed possible error when paginating search results."
msgstr "ແກ້ໄຂຂໍ້ຜິດພາດທີ່ອາດເກີດຂຶ້ນເມື່ອແບ່ງໜ້າຜົນການຄົ້ນຫາ."

msgid "Fixed migrations from older versions in some corner cases."
msgstr "ແກ້ໄຂການຍ້າຍຂໍ້ມູນຈາກເວີຊັນເກົ່າໃນບາງກໍລະນີພິເສດ."

msgid "Fixed possible CSRF on project watch and unwatch."
msgstr "ແກ້ໄຂຄວາມສ່ຽງ CSRF ທີ່ອາດເກີດຂຶ້ນເມື່ອຕິດຕາມ ຫຼື ຍົກເລີກການຕິດຕາມໂຄງການ."

msgid "The password reset no longer authenticates user."
msgstr "ການຣີເຊັດລະຫັດຜ່ານຈະບໍ່ພິສູດຕົວຕົນຜູ້ໃຊ້ອີກຕໍ່ໄປ."

msgid "Fixed possible CAPTCHA bypass on forgotten password."
msgstr "ແກ້ໄຂການຂ້າມ CAPTCHA ທີ່ອາດເກີດຂຶ້ນໃນກໍລະນີລືມລະຫັດຜ່ານ."

msgid "Weblate 2.14"
msgstr "Weblate 2.14"

msgid "*Released on May 17th 2017.*"
msgstr "*ປ່ອຍອອກເມື່ອວັນທີ 17 ພຶດສະພາ 2017.*"

msgid "Add glossary entries using AJAX."
msgstr "ເພີ່ມລາຍການວັດຈະນານຸກົມໂດຍໃຊ້ AJAX."

msgid "The logout now uses POST to avoid CSRF."
msgstr "ຕອນນີ້ການອອກຈາກລະບົບໃຊ້ POST ເພື່ອຫຼີກລ່ຽງ CSRF."

msgid "The API key token reset now uses POST to avoid CSRF."
msgstr "ຕອນນີ້ການຣີເຊັດ API key token ໃຊ້ POST ເພື່ອຫຼີກລ່ຽງ CSRF."

msgid "Weblate sets Content-Security-Policy by default."
msgstr "Weblate ຕັ້ງຄ່າ Content-Security-Policy ເປັນຄ່າເລີ່ມຕົ້ນ."

msgid "The local editor URL is validated to avoid self-XSS."
msgstr "URL ຂອງຕົວແກ້ໄຂໃນເຄື່ອງຖືກກວດສອບເພື່ອຫຼີກລ່ຽງ self-XSS."

msgid "The password is now validated against common flaws by default."
msgstr "ຕອນນີ້ລະຫັດຜ່ານຖືກກວດສອບຂໍ້ບົກພ່ອງທົ່ວໄປເປັນຄ່າເລີ່ມຕົ້ນ."

msgid ""
"Notify users about important activity with their account such as password "
"change."
msgstr "ແຈ້ງເຕືອນຜູ້ໃຊ້ກ່ຽວກັບກິດຈະກຳທີ່ສຳຄັນຂອງບັນຊີ ເຊັ່ນ: ການປ່ຽນລະຫັດຜ່ານ."

msgid "The CSV exports now escape potential formulas."
msgstr "ການສົ່ງອອກ CSV ຕອນນີ້ມີການປ້ອງກັນ (escape) ສູດທີ່ອາດເປັນອັນຕະລາຍ."

msgid "Various minor improvements in security."
msgstr "ການປັບປຸງຄວາມປອດໄພຍ່ອຍໆຕ່າງໆ."

msgid "The authentication attempts are now rate limited."
msgstr "ຕອນນີ້ຄວາມພະຍາຍາມໃນການພິສູດຕົວຕົນມີການຈຳກັດອັດຕາ (rate limited)."

msgid "Suggestion content is stored in the history."
msgstr "ເນື້ອຫາຄຳແນະນຳຈະຖືກເກັບໄວ້ໃນປະຫວັດ."

msgid "Store important account activity in audit log."
msgstr "ເກັບກິດຈະກຳບັນຊີທີ່ສຳຄັນໄວ້ໃນ audit log."

msgid ""
"Ask for password confirmation when removing account or adding new "
"associations."
msgstr "ຂໍການຢືນຢັນລະຫັດຜ່ານເມື່ອລຶບບັນຊີ ຫຼື ເພີ່ມການເຊື່ອມຕໍ່ໃໝ່."

msgid "Show time when suggestion has been made."
msgstr "ສະແດງເວລາທີ່ຄຳແນະນຳຖືກສ້າງຂຶ້ນ."

msgid "There is new quality check for trailing semicolon."
msgstr "ມີການກວດສອບຄຸນນະພາບໃໝ່ສຳລັບເຄື່ອງໝາຍອັດຕາພາກ (semicolon) ຕໍ່ທ້າຍ."

msgid "Ensure that search links can be shared."
msgstr "ຮັບປະກັນວ່າລິ້ງການຄົ້ນຫາສາມາດແບ່ງປັນໄດ້."

msgid "Included source string information and screenshots in the API."
msgstr "ລວມຂໍ້ມູນຂໍ້ຄວາມຕົ້ນສະບັບ ແລະຮູບໜ້າຈໍເຂົ້າໃນ API ແລ້ວ."

msgid "Allow to overwrite translations through API upload."
msgstr "ອະນຸຍາດໃຫ້ຂຽນທັບການແປຜ່ານການອັບໂຫຼດ API."

msgid "Weblate 2.13.1"
msgstr "Weblate 2.13.1"

msgid "*Released on Apr 12th 2017.*"
msgstr "*ປ່ອຍອອກເມື່ອວັນທີ 12 ເມສາ 2017.*"

msgid "Fixed listing of managed projects in profile."
msgstr "ແກ້ໄຂການສະແດງລາຍການໂຄງການທີ່ຈັດການຢູ່ໃນໂປຣໄຟລ໌."

msgid "Fixed migration issue where some permissions were missing."
msgstr "ແກ້ໄຂບັນຫາການຍ້າຍຂໍ້ມູນທີ່ບາງສິດທິຫາຍໄປ."

msgid "Fixed listing of current file format in translation download."
msgstr "ແກ້ໄຂການສະແດງຮູບແບບໄຟລ໌ປັດຈຸບັນໃນການດາວໂຫຼດການແປ."

msgid ""
"Return HTTP 404 when trying to access project where user lacks privileges."
msgstr "ສົ່ງຄ່າ HTTP 404 ເມື່ອພະຍາຍາມເຂົ້າເຖິງໂຄງການທີ່ຜູ້ໃຊ້ບໍ່ມີສິດທິ."

msgid "Weblate 2.13"
msgstr "Weblate 2.13"

msgid "Fixed quality checks on translation templates."
msgstr "ແກ້ໄຂການກວດສອບຄຸນນະພາບເທນເພລດການແປ."

msgid "Added quality check to trigger on losing translation."
msgstr "ເພີ່ມການກວດສອບຄຸນນະພາບເພື່ອແຈ້ງເຕືອນເມື່ອການແປສູນຫາຍ."

msgid "Add option to view pending suggestions from user."
msgstr "ເພີ່ມທາງເລືອກໃນການເບິ່ງຄຳແນະນຳທີ່ຄ້າງຢູ່ຈາກຜູ້ໃຊ້."

msgid "Add option to automatically build component lists."
msgstr "ເພີ່ມທາງເລືອກໃນການສ້າງລາຍການອົງປະກອບອັດຕະໂນມັດ."

msgid "Default dashboard for unauthenticated users can be configured."
msgstr "Dashboard ເລີ່ມຕົ້ນສຳລັບຜູ້ໃຊ້ທີ່ບໍ່ໄດ້ພິສູດຕົວຕົນສາມາດຕັ້ງຄ່າໄດ້."

msgid "Add option to browse 25 random strings for review."
msgstr "ເພີ່ມທາງເລືອກໃນການເບິ່ງຂໍ້ຄວາມແບບສຸ່ມ 25 ຂໍ້ຄວາມເພື່ອທົບທວນ."

msgid "History now indicates string change."
msgstr "ຕອນນີ້ປະຫວັດມີການລະບຸການປ່ຽນແປງຂໍ້ຄວາມແລ້ວ."

msgid "Better error reporting when adding new translation."
msgstr "ການລາຍງານຂໍ້ຜິດພາດທີ່ດີຂຶ້ນເມື່ອເພີ່ມການແປໃໝ່."

msgid "Added per language search within project."
msgstr "ເພີ່ມການຄົ້ນຫາຕໍ່ພາສາພາຍໃນໂຄງການ."

msgid "Group ACLs can now be limited to certain permissions."
msgstr "Group ACLs ຕອນນີ້ສາມາດຖືກຈຳກັດໃຫ້ມີບາງສິດທິໄດ້."

msgid "The per project ACLs are now implemented using Group ACL."
msgstr "ACLs ຕໍ່ໂຄງການຕອນນີ້ຖືກນຳໃຊ້ໂດຍໃຊ້ Group ACL."

msgid "Added more fine grained privileges control."
msgstr "ເພີ່ມການຄວບຄຸມສິດທິແບບລະອຽດຫຼາຍຂຶ້ນ."

msgid "Various minor UI improvements."
msgstr "ການປັບປຸງ UI ຍ່ອຍໆຕ່າງໆ."

msgid "Weblate 2.12"
msgstr "Weblate 2.12"

msgid "*Released on Mar 3rd 2017.*"
msgstr "*ປ່ອຍອອກເມື່ອວັນທີ 3 ມີນາ 2017.*"

msgid "Improved admin interface for groups."
msgstr "ປັບປຸງອິນເຕີເຟດຜູ້ເບິ່ງແລສຳລັບກຸ່ມ."

msgid "Added support for Yandex Translate API."
msgstr "ເພີ່ມການຮອງຮັບ Yandex Translate API."

msgid "Improved speed of site wide search."
msgstr "ປັບປຸງຄວາມໄວຂອງການຄົ້ນຫາທົ່ວທັງເວັບໄຊທ໌."

msgid "Added project and component wide search."
msgstr "ເພີ່ມການຄົ້ນຫາໃນລະດັບໂຄງການ ແລະອົງປະກອບ."

msgid "Added project and component wide search and replace."
msgstr "ເພີ່ມການຄົ້ນຫາ ແລະແທນທີ່ໃນລະດັບໂຄງການ ແລະອົງປະກອບ."

msgid "Improved rendering of inconsistent translations."
msgstr "ປັບປຸງການສະແດງຜົນຂອງການແປທີ່ບໍ່ສອດຄ່ອງ."

msgid "Added support for opening source files in local editor."
msgstr "ເພີ່ມການຮອງຮັບການເປີດໄຟລ໌ຕົ້ນສະບັບໃນຕົວແກ້ໄຂໃນເຄື່ອງ."

msgid "Added support for configuring visual keyboard with special characters."
msgstr "ເພີ່ມການຮອງຮັບການຕັ້ງຄ່າແປ້ນພິມພາບທີ່ມີຕົວອັກສອນພິເສດ."

msgid ""
"Improved screenshot management with OCR support for matching source strings."
msgstr "ປັບປຸງການຈັດການຮູບໜ້າຈໍພ້ອມຮອງຮັບ OCR ສຳລັບການຈັບຄູ່ຂໍ້ຄວາມຕົ້ນສະບັບ."

msgid "Default commit message now includes translation information and URL."
msgstr "ຕອນນີ້ຂໍ້ຄວາມ commit ເລີ່ມຕົ້ນລວມຂໍ້ມູນການແປ ແລະ URL."

msgid "Added support for Joomla translation format."
msgstr "ເພີ່ມການຮອງຮັບຮູບແບບການແປຂອງ Joomla."

msgid "Improved reliability of import across file formats."
msgstr "ປັບປຸງຄວາມໜ້າເຊື່ອຖືຂອງການນຳເຂົ້າໃນທຸກຮູບແບບໄຟລ໌."

msgid "Weblate 2.11"
msgstr "Weblate 2.11"

msgid "*Released on Jan 31st 2017.*"
msgstr "*ປ່ອຍອອກເມື່ອວັນທີ 31 ມັງກອນ 2017.*"

msgid "Include language detailed information on language page."
msgstr "ລວມຂໍ້ມູນລະອຽດກ່ຽວກັບພາສາໃນໜ້າພາສາ."

msgid "Mercurial backend improvements."
msgstr "ການປັບປຸງ Mercurial backend."

msgid "Added option to specify translation component priority."
msgstr "ເພີ່ມທາງເລືອກໃນການລະບຸຄວາມສຳຄັນຂອງອົງປະກອບການແປ."

msgid "More consistent usage of Group ACL even with less used permissions."
msgstr "ການໃຊ້ Group ACL ທີ່ສອດຄ່ອງກັນຫຼາຍຂຶ້ນ ເຖິງແມ່ນວ່າຈະໃຊ້ສິດທິທີ່ບໍ່ຄ່ອຍໄດ້ໃຊ້."

msgid "Added WL_BRANCH variable to hook scripts."
msgstr "ເພີ່ມຕົວແປ WL_BRANCH ໃຫ້ກັບ hook scripts."

msgid "Improved developer documentation."
msgstr "ປັບປຸງເອກະສານສຳລັບນັກພັດທະນາ."

msgid "Better compatibility with various Git versions in Git exporter add-on."
msgstr "ຄວາມເຂົ້າກັນໄດ້ທີ່ດີຂຶ້ນກັບ Git ເວີຊັນຕ່າງໆໃນສ່ວນເສີມ Git exporter."

msgid "Included per project and component stats."
msgstr "ລວມສະຖິຕິຕໍ່ໂຄງການ ແລະອົງປະກອບ."

msgid ""
"Added language code mapping for better support of Microsoft Translate API."
msgstr "ເພີ່ມການຈັບຄູ່ລະຫັດພາສາເພື່ອການຮອງຮັບ Microsoft Translate API ທີ່ດີຂຶ້ນ."

msgid ""
"Moved fulltext cleanup to background job to make translation removal faster."
msgstr "ຍ້າຍການທຳຄວາມສະອາດ fulltext ໄປເປັນວຽກເບື້ອງຫຼັງເພື່ອໃຫ້ການລຶບການແປໄວຂຶ້ນ."

msgid ""
"Fixed displaying of plural source for languages with single plural form."
msgstr "ແກ້ໄຂການສະແດງພົດຕົ້ນສະບັບສຳລັບພາສາທີ່ມີຮູບແບບພົດດຽວ."

msgid "Improved error handling in import_project."
msgstr "ປັບປຸງການຈັດການຂໍ້ຜິດພາດໃນ import_project."

msgid "Weblate 2.10.1"
msgstr "Weblate 2.10.1"

msgid "*Released on Jan 20th 2017.*"
msgstr "*ປ່ອຍອອກເມື່ອວັນທີ 20 ມັງກອນ 2017.*"

msgid ""
"Do not leak account existence on password reset form (:cve:`2017-5537`)."
msgstr "ຢ່າເປີດເຜີຍການມີຢູ່ຂອງບັນຊີໃນແບບຟອມຣີເຊັດລະຫັດຜ່ານ (:cve:`2017-5537`)."

msgid "Weblate 2.10"
msgstr "Weblate 2.10"

msgid "*Released on Dec 15th 2016.*"
msgstr "*ປ່ອຍອອກເມື່ອວັນທີ 15 ທັນວາ 2016.*"

msgid ""
"Added quality check to check whether plurals are translated differently."
msgstr "ເພີ່ມການກວດສອບຄຸນນະພາບເພື່ອກວດສອບວ່າພົດຖືກແປແຕກຕ່າງກັນຫຼືບໍ່."

msgid "Fixed GitHub hooks for repositories with authentication."
msgstr "ແກ້ໄຂ GitHub hooks ສຳລັບ repositories ທີ່ມີການພິສູດຕົວຕົນ."

msgid "Added optional Git exporter module."
msgstr "ເພີ່ມໂມດູນ Git exporter ແບບທາງເລືອກ."

msgid "Support for Microsoft Cognitive Services Translator API."
msgstr "ຮອງຮັບ Microsoft Cognitive Services Translator API."

msgid "Simplified project and component user interface."
msgstr "ເຮັດໃຫ້ອິນເຕີເຟດຜູ້ໃຊ້ຂອງໂຄງການ ແລະອົງປະກອບງ່າຍຂຶ້ນ."

msgid "Added automatic fix to remove control characters."
msgstr "ເພີ່ມການແກ້ໄຂອັດຕະໂນມັດເພື່ອລຶບຕົວອັກສອນຄວບຄຸມ."

msgid "Added per language overview to project."
msgstr "ເພີ່ມພາບລວມຕໍ່ພາສາໃຫ້ກັບໂຄງການ."

msgid "Added support for CSV export."
msgstr "ເພີ່ມການຮອງຮັບການສົ່ງອອກ CSV."

msgid "Added CSV download for stats."
msgstr "ເພີ່ມການດາວໂຫຼດ CSV ສຳລັບສະຖິຕິ."

msgid "Added matrix view for quick overview of all translations."
msgstr "ເພີ່ມມຸມມອງ matrix ສຳລັບພາບລວມດ່ວນຂອງການແປທັງໝົດ."

msgid "Added basic API for changes and strings."
msgstr "ເພີ່ມ API ພື້ນຖານສຳລັບການປ່ຽນແປງ ແລະຂໍ້ຄວາມ."

msgid "Added support for Apertium APy server for machine translations."
msgstr "ເພີ່ມການຮອງຮັບເຊີຟເວີ Apertium APy ສຳລັບການແປດ້ວຍເຄື່ອງຈັກ."

msgid "Weblate 2.9"
msgstr "Weblate 2.9"

msgid "*Released on Nov 4th 2016.*"
msgstr "*ປ່ອຍອອກເມື່ອວັນທີ 4 ພະຈິກ 2016.*"

msgid "Extended parameters for createadmin management command."
msgstr "ຂະຫຍາຍພາຣາມິເຕີສຳລັບຄຳສັ່ງຈັດການ createadmin."

msgid "Extended import_json to be able to handle with existing components."
msgstr "ຂະຫຍາຍ import_json ໃຫ້ສາມາດຈັດການກັບອົງປະກອບທີ່ມີຢູ່ໄດ້."

msgid "Added support for YAML files."
msgstr "ເພີ່ມການຮອງຮັບໄຟລ໌ YAML."

msgid ""
"Project owners can now configure translation component and project details."
msgstr "ຕອນນີ້ເຈົ້າຂອງໂຄງການສາມາດຕັ້ງຄ່າອົງປະກອບການແປ ແລະລາຍລະອຽດໂຄງການໄດ້ແລ້ວ."

msgid "Use \"Watched\" instead of \"Subscribed\" projects."
msgstr "ໃຊ້ \"Watched\" ແທນ \"Subscribed\" ກັບໂຄງການ."

msgid "Projects can be watched directly from project page."
msgstr "ສາມາດຕິດຕາມໂຄງການໂດຍກົງຈາກໜ້າໂຄງການ."

msgid "Added multi language status widget."
msgstr "ເພີ່ມວິດເຈັດສະຖານະຫຼາຍພາສາ."

msgid "Highlight secondary language if not showing source."
msgstr "ເນັ້ນພາສາສຳຮອງຖ້າບໍ່ສະແດງພາສາຕົ້ນສະບັບ."

msgid "Record suggestion deletion in history."
msgstr "ບັນທຶກການລຶບຄຳແນະນຳໃນປະຫວັດ."

msgid "Improved UX of languages selection in profile."
msgstr "ປັບປຸງ UX ຂອງການເລືອກພາສາໃນໂປຣໄຟລ໌."

msgid "Fixed showing whiteboard messages for component."
msgstr "ແກ້ໄຂການສະແດງຂໍ້ຄວາມກະດານຂາວສຳລັບອົງປະກອບ."

msgid "Keep preferences tab selected after saving."
msgstr "ຮັກສາແຖບການຕັ້ງຄ່າໃຫ້ຖືກເລືອກໄວ້ຫຼັງຈາກບັນທຶກ."

msgid "Show source string comment more prominently."
msgstr "ສະແດງຄຳເຫັນຂໍ້ຄວາມຕົ້ນສະບັບໃຫ້ເດັ່ນຊັດຂຶ້ນ."

msgid "Automatically install Gettext PO merge driver for Git repositories."
msgstr "ຕິດຕັ້ງ Gettext PO merge driver ໂດຍອັດຕະໂນມັດສຳລັບ Git repositories."

msgid "Added search and replace feature."
msgstr "ເພີ່ມຟີເຈີຄົ້ນຫາ ແລະແທນທີ່."

msgid ""
"Added support for uploading visual context (screenshots) for translations."
msgstr "ເພີ່ມການຮອງຮັບການອັບໂຫຼດບໍລິບົດພາບ (ຮູບໜ້າຈໍ) ສຳລັບການແປ."

msgid "Weblate 2.8"
msgstr "Weblate 2.8"

msgid "*Released on Aug 31st 2016.*"
msgstr "*ປ່ອຍອອກເມື່ອວັນທີ 31 ສິງຫາ 2016.*"

msgid "Translations."
msgstr "ການແປ."

msgid "Updated bundled JavaScript libraries."
msgstr "ອັບເດດຫໍສະໝຸດ JavaScript ທີ່ຕິດມາດ້ວຍ."

msgid "Added list_translators management command."
msgstr "ເພີ່ມຄຳສັ່ງຈັດການ list_translators."

msgid "Django 1.8 is no longer supported."
msgstr "Django 1.8 ບໍ່ຖືກຮອງຮັບອີກຕໍ່ໄປ."

msgid "Fixed compatibility with Django 1.10."
msgstr "ແກ້ໄຂຄວາມເຂົ້າກັນໄດ້ກັບ Django 1.10."

msgid "Added Subversion support."
msgstr "ເພີ່ມການຮອງຮັບ Subversion."

msgid "Separated XML validity check from XML mismatched tags."
msgstr "ແຍກການກວດສອບຄວາມຖືກຕ້ອງ XML ອອກຈາກການກວດສອບແທັກ XML ທີ່ບໍ່ກົງກັນ."

msgid "Fixed API to honor HIDE_REPO_CREDENTIALS settings."
msgstr "ແກ້ໄຂ API ໃຫ້ປະຕິບັດຕາມການຕັ້ງຄ່າ HIDE_REPO_CREDENTIALS."

msgid "Show source change in Zen mode."
msgstr "ສະແດງການປ່ຽນແປງຕົ້ນສະບັບໃນໂໝດ Zen."

msgid "Alt+PageUp/PageDown/Home/End now works in Zen mode as well."
msgstr "Alt+PageUp/PageDown/Home/End ຕອນນີ້ໃຊ້ໄດ້ໃນໂໝດ Zen ເຊັ່ນກັນ."

msgid "Add tooltip showing exact time of changes."
msgstr "ເພີ່ມ Tooltip ສະແດງເວລາທີ່ແນ່ນອນຂອງການປ່ຽນແປງ."

msgid "Add option to select filters and search from translation page."
msgstr "ເພີ່ມທາງເລືອກໃນການເລືອກຕົວກອງ ແລະຄົ້ນຫາຈາກໜ້າການແປ."

msgid "Added UI for translation removal."
msgstr "ເພີ່ມ UI ສຳລັບການລຶບການແປ."

msgid "Improved behavior when inserting placeables."
msgstr "ປັບປຸງການເຮັດວຽກເມື່ອໃສ່ placeables."

msgid "Fixed auto locking issues in Zen mode."
msgstr "ແກ້ໄຂບັນຫາການລັອກອັດຕະໂນມັດໃນໂໝດ Zen."

msgid "Weblate 2.7"
msgstr "Weblate 2.7"

msgid "*Released on Jul 10th 2016.*"
msgstr "*ປ່ອຍອອກເມື່ອວັນທີ 10 ກໍລະກົດ 2016.*"

msgid "Removed Google web translate machine translation."
msgstr "ເອົາ Google web translate machine translation ອອກ."

msgid "Improved commit message when adding translation."
msgstr "ປັບປຸງຂໍ້ຄວາມ commit ເມື່ອເພີ່ມການແປ."

msgid "Fixed Google Translate API for Hebrew language."
msgstr "ແກ້ໄຂ Google Translate API ສຳລັບພາສາຮີບຣິວ."

msgid "Compatibility with Mercurial 3.8."
msgstr "ຮອງຮັບການເຮັດວຽກຮ່ວມກັບ Mercurial 3.8."

msgid "Added import_json management command."
msgstr "ເພີ່ມຄຳສັ່ງຈັດການ import_json."

msgid "Correct ordering of listed translations."
msgstr "ການຈັດລຽງລາຍການແປທີ່ຖືກຕ້ອງ."

msgid "Show full suggestion text, not only a diff."
msgstr "ສະແດງຂໍ້ຄວາມຄຳແນະນຳເຕັມ ບໍ່ແມ່ນສະເພາະຄວາມແຕກຕ່າງ (diff)."

msgid "Extend API (detailed repository status, statistics, …)."
msgstr "ຂະຫຍາຍ API (ສະຖານະ repository ລະອຽດ, ສະຖິຕິ, …)."

msgid "Testsuite no longer requires network access to test repositories."
msgstr "Testsuite ບໍ່ຕ້ອງການການເຂົ້າເຖິງເຄືອຂ່າຍເພື່ອທົດສອບ repositories ອີກຕໍ່ໄປ."

msgid "Weblate 2.6"
msgstr "Weblate 2.6"

msgid "*Released on Apr 28th 2016.*"
msgstr "*ປ່ອຍອອກເມື່ອວັນທີ 28 ເມສາ 2016.*"

msgid "Fixed validation of components with language filter."
msgstr "ແກ້ໄຂການກວດສອບອົງປະກອບດ້ວຍຕົວກອງພາສາ."

msgid "Improved support for XLIFF files."
msgstr "ປັບປຸງການຮອງຮັບໄຟລ໌ XLIFF."

msgid "Fixed machine translation for non English sources."
msgstr "ແກ້ໄຂການແປດ້ວຍເຄື່ອງຈັກສຳລັບຕົ້ນສະບັບທີ່ບໍ່ແມ່ນພາສາອັງກິດ."

msgid "Added REST API."
msgstr "ເພີ່ມ REST API."

msgid "Django 1.10 compatibility."
msgstr "ຮອງຮັບການເຮັດວຽກຮ່ວມກັບ Django 1.10."

msgid "Added categories to whiteboard messages."
msgstr "ເພີ່ມໝວດໝູ່ໃຫ້ກັບຂໍ້ຄວາມກະດານຂາວ."

msgid "Weblate 2.5"
msgstr "Weblate 2.5"

msgid "*Released on Mar 10th 2016.*"
msgstr "*ປ່ອຍອອກເມື່ອວັນທີ 10 ມີນາ 2016.*"

msgid "Fixed automatic translation for project owners."
msgstr "ແກ້ໄຂການແປອັດຕະໂນມັດສຳລັບເຈົ້າຂອງໂຄງການ."

msgid "Improved performance of commit and push operations."
msgstr "ປັບປຸງປະສິດທິພາບຂອງການດຳເນີນການ commit ແລະ push."

msgid "New management command to add suggestions from command-line."
msgstr "ຄຳສັ່ງຈັດການໃໝ່ເພື່ອເພີ່ມຄຳແນະນຳຈາກ command-line."

msgid "Added support for merging comments on file upload."
msgstr "ເພີ່ມການຮອງຮັບການລວມຄຳເຫັນໃນການອັບໂຫຼດໄຟລ໌."

msgid "Added support for some GNU extensions to C printf format."
msgstr "ເພີ່ມການຮອງຮັບ GNU extensions ບາງຢ່າງສຳລັບຮູບແບບ C printf."

msgid "Added support for generating translator credits."
msgstr "ເພີ່ມການຮອງຮັບການສ້າງລາຍຊື່ຜູ້ແປ."

msgid "Added support for generating contributor stats."
msgstr "ເພີ່ມການຮອງຮັບການສ້າງສະຖິຕິຜູ້ປະກອບສ່ວນ."

msgid "Site wide search can search only in one language."
msgstr "ການຄົ້ນຫາທົ່ວເວັບໄຊທ໌ສາມາດຄົ້ນຫາໄດ້ພຽງພາສາດຽວ."

msgid "Improve quality checks for Armenian."
msgstr "ປັບປຸງການກວດສອບຄຸນນະພາບສຳລັບພາສາອາກເມນຽນ."

msgid ""
"Support for starting translation components without existing translations."
msgstr "ຮອງຮັບການເລີ່ມອົງປະກອບການແປໂດຍບໍ່ມີການແປທີ່ມີຢູ່."

msgid "Support for adding new translations in Qt TS."
msgstr "ຮອງຮັບການເພີ່ມການແປໃໝ່ໃນ Qt TS."

msgid "Improved support for translating PHP files."
msgstr "ປັບປຸງການຮອງຮັບການແປໄຟລ໌ PHP."

msgid "Performance improvements for quality checks."
msgstr "ປັບປຸງປະສິດທິພາບສຳລັບການກວດສອບຄຸນນະພາບ."

msgid "Fixed site wide search for failing checks."
msgstr "ແກ້ໄຂການຄົ້ນຫາທົ່ວເວັບໄຊທ໌ສຳລັບການກວດສອບທີ່ຜິດພາດ."

msgid "Added option to specify source language."
msgstr "ເພີ່ມທາງເລືອກໃນການລະບຸພາສາຕົ້ນສະບັບ."

msgid "Extended list of options for import_project."
msgstr "ຂະຫຍາຍລາຍການທາງເລືອກສຳລັບ import_project."

msgid "Improved targeting for whiteboard messages."
msgstr "ປັບປຸງການກຳນົດເປົ້າໝາຍສຳລັບຂໍ້ຄວາມກະດານຂາວ."

msgid "Support for automatic translation across projects."
msgstr "ຮອງຮັບການແປອັດຕະໂນມັດຂ້າມໂຄງການ."

msgid "Optimized fulltext search index."
msgstr "ປັບປຸງດັດສະນີການຄົ້ນຫາ fulltext ໃຫ້ເໝາະສົມ."

msgid "Added management command for auto translation."
msgstr "ເພີ່ມຄຳສັ່ງຈັດການສຳລັບການແປອັດຕະໂນມັດ."

msgid "Added placeables highlighting."
msgstr "ເພີ່ມການເນັ້ນ placeables."

msgid ""
"Added keyboard shortcuts for placeables, checks and machine translations."
msgstr "ເພີ່ມປຸ່ມລັດແປ້ນພິມສຳລັບ placeables, ການກວດສອບ ແລະການແປດ້ວຍເຄື່ອງຈັກ."

msgid "Improved translation locking."
msgstr "ປັບປຸງການລັອກການແປ."

msgid "Added quality check for AngularJS interpolation."
msgstr "ເພີ່ມການກວດສອບຄຸນນະພາບສຳລັບ AngularJS interpolation."

msgid "Added extensive group based ACLs."
msgstr "ເພີ່ມ ACLs ທີ່ອີງໃສ່ກຸ່ມຢ່າງກວ້າງຂວາງ."

msgid "Clarified terminology on strings needing edit (formerly fuzzy)."
msgstr "ຊີ້ແຈງຄຳສັບກ່ຽວກັບຂໍ້ຄວາມທີ່ຕ້ອງການການແກ້ໄຂ (ເມື່ອກ່ອນຄື fuzzy)."

msgid ""
"Clarified terminology on strings needing action and untranslated strings."
msgstr "ຊີ້ແຈງຄຳສັບກ່ຽວກັບຂໍ້ຄວາມທີ່ຕ້ອງການການດຳເນີນການ ແລະຂໍ້ຄວາມທີ່ຍັງບໍ່ໄດ້ແປ."

msgid "Support for Python 3."
msgstr "ຮອງຮັບ Python 3."

msgid "Dropped support for Django 1.7."
msgstr "ຍົກເລີກການຮອງຮັບ Django 1.7."

msgid "Dropped dependency on msginit for creating new gettext PO files."
msgstr "ຍົກເລີກການເພິ່ງພາ msginit ສຳລັບການສ້າງໄຟລ໌ gettext PO ໃໝ່."

msgid "Added configurable dashboard views."
msgstr "ເພີ່ມມຸມມອງ dashboard ທີ່ຕັ້ງຄ່າໄດ້."

msgid "Improved notifications on parse errors."
msgstr "ປັບປຸງການແຈ້ງເຕືອນກ່ຽວກັບຂໍ້ຜິດພາດໃນການແຍກວິເຄາະ."

msgid ""
"Added option to import components with duplicate name to import_project."
msgstr "ເພີ່ມທາງເລືອກໃນການນຳເຂົ້າອົງປະກອບທີ່ມີຊື່ຊ້ຳກັນເຂົ້າໃນ import_project."

msgid "Added XLIFF export for dictionary."
msgstr "ເພີ່ມການສົ່ງອອກ XLIFF ສຳລັບວັດຈະນານຸກົມ."

msgid "Added XLIFF and gettext PO export for all translations."
msgstr "ເພີ່ມການສົ່ງອອກ XLIFF ແລະ gettext PO ສຳລັບການແປທັງໝົດ."

msgid "Added support for configurable automatic group assignments."
msgstr "ເພີ່ມການຮອງຮັບການມອບໝາຍກຸ່ມອັດຕະໂນມັດທີ່ຕັ້ງຄ່າໄດ້."

msgid "Improved adding of new translations."
msgstr "ປັບປຸງການເພີ່ມການແປໃໝ່."

msgid "Weblate 2.4"
msgstr "Weblate 2.4"

msgid "*Released on Sep 20th 2015.*"
msgstr "*ປ່ອຍອອກເມື່ອວັນທີ 20 ກັນຍາ 2015.*"

msgid "Improved support for PHP files."
msgstr "ປັບປຸງການຮອງຮັບໄຟລ໌ PHP."

msgid "Ability to add ACL to anonymous user."
msgstr "ຄວາມສາມາດໃນການເພີ່ມ ACL ໃຫ້ກັບຜູ້ໃຊ້ທີ່ບໍ່ລະບຸຕົວຕົນ."

msgid "Improved configurability of import_project command."
msgstr "ປັບປຸງຄວາມສາມາດໃນການຕັ້ງຄ່າຂອງຄຳສັ່ງ import_project."

msgid "Added CSV dump of history."
msgstr "ເພີ່ມການ dump ປະຫວັດເປັນ CSV."

msgid "Avoid copy/paste errors with whitespace characters."
msgstr "ຫຼີກລ່ຽງຂໍ້ຜິດພາດໃນການສຳເນົາ/ວາງກັບຕົວອັກສອນຊ່ອງຫວ່າງ."

msgid "Added support for Bitbucket webhooks."
msgstr "ເພີ່ມການຮອງຮັບ Bitbucket webhooks."

msgid "Tighter control on fuzzy strings on translation upload."
msgstr "ການຄວບຄຸມຂໍ້ຄວາມ fuzzy ທີ່ເຂັ້ມງວດຂຶ້ນໃນການອັບໂຫຼດການແປ."

msgid "Several URLs have changed, you might have to update your bookmarks."
msgstr "URL ຫຼາຍອັນໄດ້ປ່ຽນແປງ, ທ່ານອາດຈະຕ້ອງອັບເດດບຸກມາກຂອງທ່ານ."

msgid "Hook scripts are executed with VCS root as current directory."
msgstr "Hook scripts ຖືກປະຕິບັດໂດຍໃຊ້ VCS root ເປັນໄດເລກະທໍລີປັດຈຸບັນ."

msgid ""
"Hook scripts are executed with environment variables describing current "
"component."
msgstr "Hook scripts ຖືກປະຕິບັດດ້ວຍຕົວແປສະພາບແວດລ້ອມທີ່ອະທິບາຍອົງປະກອບປັດຈຸບັນ."

msgid "Add management command to optimize fulltext index."
msgstr "ເພີ່ມຄຳສັ່ງຈັດການເພື່ອປັບດັດສະນີ fulltext ໃຫ້ເໝາະສົມ."

msgid "Added support for error reporting to Rollbar."
msgstr "ເພີ່ມການຮອງຮັບການລາຍງານຂໍ້ຜິດພາດໄປຍັງ Rollbar."

msgid "Projects now can have multiple owners."
msgstr "ຕອນນີ້ໂຄງການສາມາດມີເຈົ້າຂອງຫຼາຍຄົນໄດ້."

msgid "Project owners can manage themselves."
msgstr "ເຈົ້າຂອງໂຄງການສາມາດຈັດການຕົວເອງໄດ້."

msgid "Added support for ``javascript-format`` used in gettext PO."
msgstr "ເພີ່ມການຮອງຮັບ ``javascript-format`` ທີ່ໃຊ້ໃນ gettext PO."

msgid "Support for adding new translations in XLIFF."
msgstr "ຮອງຮັບການເພີ່ມການແປໃໝ່ໃນ XLIFF."

msgid "Improved file format autodetection."
msgstr "ປັບປຸງການກວດສອບຮູບແບບໄຟລ໌ອັດຕະໂນມັດ."

msgid "Extended keyboard shortcuts."
msgstr "ຂະຫຍາຍປຸ່ມລັດແປ້ນພິມ."

msgid "Improved dictionary matching for several languages."
msgstr "ປັບປຸງການຈັບຄູ່ວັດຈະນານຸກົມສຳລັບຫຼາຍພາສາ."

msgid "Improved layout of most of pages."
msgstr "ປັບປຸງຮູບແບບຂອງໜ້າເວັບສ່ວນໃຫຍ່."

msgid "Support for adding words to dictionary while translating."
msgstr "ຮອງຮັບການເພີ່ມຄຳສັບໃສ່ວັດຈະນານຸກົມໃນຂະນະແປ."

msgid "Added support for filtering languages to be managed by Weblate."
msgstr "ເພີ່ມການຮອງຮັບການກັ່ນຕອງພາສາທີ່ຈະຖືກຈັດການໂດຍ Weblate."

msgid "Added support for translating and importing CSV files."
msgstr "ເພີ່ມການຮອງຮັບການແປ ແລະນຳເຂົ້າໄຟລ໌ CSV."

msgid "Rewritten handling of static files."
msgstr "ຂຽນໃໝ່ການຈັດການໄຟລ໌ສະຖິດ."

msgid ""
"Direct login/registration links to third-party service if that's the only "
"one."
msgstr "ລິ້ງເຂົ້າສູ່ລະບົບ/ລົງທະບຽນໂດຍກົງໄປຫາບໍລິການພາກສ່ວນທີສາມຖ້າມີພຽງອັນດຽວ."

msgid "Commit pending changes on account removal."
msgstr "Commit ການປ່ຽນແປງທີ່ຄ້າງຢູ່ເມື່ອລຶບບັນຊີ."

msgid "Add management command to change site name."
msgstr "ເພີ່ມຄຳສັ່ງຈັດການເພື່ອປ່ຽນຊື່ເວັບໄຊທ໌."

msgid "Add option to configure default committer."
msgstr "ເພີ່ມທາງເລືອກໃນການຕັ້ງຄ່າຜູ້ commit ເລີ່ມຕົ້ນ."

msgid "Add hook after adding new translation."
msgstr "ເພີ່ມ hook ຫຼັງຈາກເພີ່ມການແປໃໝ່."

msgid "Add option to specify multiple files to add to commit."
msgstr "ເພີ່ມທາງເລືອກໃນການລະບຸຫຼາຍໄຟລ໌ເພື່ອເພີ່ມໃສ່ commit."

msgid "Weblate 2.3"
msgstr "Weblate 2.3"

msgid "*Released on May 22nd 2015.*"
msgstr "*ປ່ອຍອອກເມື່ອວັນທີ 22 ພຶດສະພາ 2015.*"

msgid "Dropped support for Django 1.6 and South migrations."
msgstr "ຍົກເລີກການຮອງຮັບ Django 1.6 ແລະ South migrations."

msgid "Support for adding new translations when using Java Property files."
msgstr "ຮອງຮັບການເພີ່ມການແປໃໝ່ເມື່ອໃຊ້ໄຟລ໌ Java Property."

msgid "Allow to accept suggestion without editing."
msgstr "ອະນຸຍາດໃຫ້ຍອມຮັບຄຳແນະນຳໂດຍບໍ່ຕ້ອງແກ້ໄຂ."

msgid "Improved support for Google OAuth 2.0."
msgstr "ປັບປຸງການຮອງຮັບ Google OAuth 2.0."

msgid "Added support for Microsoft .resx files."
msgstr "ເພີ່ມການຮອງຮັບໄຟລ໌ Microsoft .resx."

msgid "Tuned default robots.txt to disallow big crawling of translations."
msgstr "ປັບ robots.txt ເລີ່ມຕົ້ນເພື່ອບໍ່ອະນຸຍາດໃຫ້ມີການຄົ້ນຫາ (crawl) ການແປຈຳນວນຫຼາຍ."

msgid "Simplified workflow for accepting suggestions."
msgstr "ເຮັດໃຫ້ຂັ້ນຕອນການຍອມຮັບຄຳແນະນຳງ່າຍຂຶ້ນ."

msgid "Added project owners who always receive important notifications."
msgstr "ເພີ່ມເຈົ້າຂອງໂຄງການທີ່ຈະໄດ້ຮັບການແຈ້ງເຕືອນທີ່ສຳຄັນສະເໝີ."

msgid "Allow to disable editing of monolingual template."
msgstr "ອະນຸຍາດໃຫ້ປິດການແກ້ໄຂເທນເພລດແບບພາສາດຽວ."

msgid "More detailed repository status view."
msgstr "ມຸມມອງສະຖານະ repository ທີ່ລະອຽດຂຶ້ນ."

msgid "Direct link for editing template when changing translation."
msgstr "ລິ້ງໂດຍກົງສຳລັບການແກ້ໄຂເທນເພລດເມື່ອປ່ຽນການແປ."

msgid "Allow to add more permissions to project owners."
msgstr "ອະນຸຍາດໃຫ້ເພີ່ມສິດທິເພີ່ມເຕີມໃຫ້ກັບເຈົ້າຂອງໂຄງການ."

msgid "Allow to show secondary language in Zen mode."
msgstr "ອະນຸຍາດໃຫ້ສະແດງພາສາສຳຮອງໃນໂໝດ Zen."

msgid "Support for hiding source string in favor of secondary language."
msgstr "ຮອງຮັບການເຊື່ອງຂໍ້ຄວາມຕົ້ນສະບັບເພື່ອສະແດງພາສາສຳຮອງແທນ."

msgid "Weblate 2.2"
msgstr "Weblate 2.2"

msgid "*Released on Feb 19th 2015.*"
msgstr "*ປ່ອຍອອກເມື່ອວັນທີ 19 ກຸມພາ 2015.*"

msgid "Performance improvements."
msgstr "ການປັບປຸງປະສິດທິພາບ."

msgid "Fulltext search on location and comments fields."
msgstr "ການຄົ້ນຫາ fulltext ໃນຊ່ອງຂໍ້ມູນສະຖານທີ່ ແລະຄຳເຫັນ."

msgid "New SVG/JavaScript-based activity charts."
msgstr "ແຜນວາດກິດຈະກຳໃໝ່ທີ່ອີງໃສ່ SVG/JavaScript."

msgid "Support for Django 1.8."
msgstr "ຮອງຮັບ Django 1.8."

msgid "Support for deleting comments."
msgstr "ຮອງຮັບການລຶບຄຳເຫັນ."

msgid "Added own SVG badge."
msgstr "ເພີ່ມ SVG badge ຂອງຕົວເອງ."

msgid "Added support for Google Analytics."
msgstr "ເພີ່ມການຮອງຮັບ Google Analytics."

msgid "Improved handling of translation filenames."
msgstr "ປັບປຸງການຈັດການຊື່ໄຟລ໌ການແປ."

msgid "Added support for monolingual JSON translations."
msgstr "ເພີ່ມການຮອງຮັບການແປ JSON ແບບພາສາດຽວ."

msgid "Record component locking in a history."
msgstr "ບັນທຶກການລັອກອົງປະກອບໃນປະຫວັດ."

msgid ""
"Support for editing source (template) language for monolingual translations."
msgstr "ຮອງຮັບການແກ້ໄຂພາສາຕົ້ນສະບັບ (ເທນເພລດ) ສຳລັບການແປແບບພາສາດຽວ."

msgid "Added basic support for Gerrit."
msgstr "ເພີ່ມການຮອງຮັບ Gerrit ຂັ້ນພື້ນຖານ."

msgid "Weblate 2.1"
msgstr "Weblate 2.1"

msgid "*Released on Dec 5th 2014.*"
msgstr "*ປ່ອຍອອກເມື່ອວັນທີ 5 ທັນວາ 2014.*"

msgid "Added support for Mercurial repositories."
msgstr "ເພີ່ມການຮອງຮັບ Mercurial repositories."

msgid "Replaced Glyphicon font by Awesome."
msgstr "ປ່ຽນຟອນ Glyphicon ດ້ວຍ Awesome."

msgid "Added icons for social authentication services."
msgstr "ເພີ່ມໄອຄອນສຳລັບບໍລິການພິສູດຕົວຕົນຜ່ານສື່ສັງຄົມ."

msgid "Better consistency of button colors and icons."
msgstr "ຄວາມສອດຄ່ອງກັນທີ່ດີຂຶ້ນຂອງສີປຸ່ມ ແລະໄອຄອນ."

msgid "Various bugfixes."
msgstr "ການແກ້ໄຂຂໍ້ຜິດພາດຕ່າງໆ."

msgid "Automatic hiding of columns in translation listing for small screens."
msgstr "ການເຊື່ອງຄໍລຳອັດຕະໂນມັດໃນລາຍການແປສຳລັບໜ້າຈໍຂະໜາດນ້ອຍ."

msgid "Changed configuration of filesystem paths."
msgstr "ປ່ຽນການຕັ້ງຄ່າເສັ້ນທາງລະບົບໄຟລ໌."

msgid "Improved SSH keys handling and storage."
msgstr "ປັບປຸງການຈັດການ ແລະການເກັບຮັກສາ SSH keys."

msgid "Improved repository locking."
msgstr "ປັບປຸງການລັອກ repository."

msgid "Customizable quality checks per source string."
msgstr "ການກວດສອບຄຸນນະພາບທີ່ຕັ້ງຄ່າໄດ້ຕໍ່ຂໍ້ຄວາມຕົ້ນສະບັບ."

msgid "Allow to hide completed translations from dashboard."
msgstr "ອະນຸຍາດໃຫ້ເຊື່ອງການແປທີ່ສຳເລັດແລ້ວອອກຈາກ dashboard."

msgid "Weblate 2.0"
msgstr "Weblate 2.0"

msgid "*Released on Nov 6th 2014.*"
msgstr "*ປ່ອຍອອກເມື່ອວັນທີ 6 ພະຈິກ 2014.*"

msgid "New responsive UI using Bootstrap."
msgstr "UI ແບບ responsive ໃໝ່ທີ່ໃຊ້ Bootstrap."

msgid "Rewritten VCS backend."
msgstr "ຂຽນ VCS backend ໃໝ່."

msgid "Added whiteboard for site wide messages."
msgstr "ເພີ່ມກະດານຂາວສຳລັບຂໍ້ຄວາມທົ່ວເວັບໄຊທ໌."

msgid "Configurable strings priority."
msgstr "ຄວາມສຳຄັນຂອງຂໍ້ຄວາມທີ່ຕັ້ງຄ່າໄດ້."

msgid "Added support for JSON file format."
msgstr "ເພີ່ມການຮອງຮັບຮູບແບບໄຟລ໌ JSON."

msgid "Fixed generating mo files in certain cases."
msgstr "ແກ້ໄຂການສ້າງໄຟລ໌ mo ໃນບາງກໍລະນີ."

msgid "Added support for GitLab notifications."
msgstr "ເພີ່ມການຮອງຮັບການແຈ້ງເຕືອນ GitLab."

msgid "Added support for disabling translation suggestions."
msgstr "ເພີ່ມການຮອງຮັບການປິດການແນະນຳການແປ."

msgid "Django 1.7 support."
msgstr "ຮອງຮັບ Django 1.7."

msgid "ACL projects now have user management."
msgstr "ຕອນນີ້ໂຄງການ ACL ມີການຈັດການຜູ້ໃຊ້ແລ້ວ."

msgid "Extended search possibilities."
msgstr "ຂະຫຍາຍຄວາມສາມາດໃນການຄົ້ນຫາ."

msgid "Give more hints to translators about plurals."
msgstr "ໃຫ້ຄຳແນະນຳເພີ່ມເຕີມແກ່ຜູ້ແປກ່ຽວກັບພົດ."

msgid "Fixed Git repository locking."
msgstr "ແກ້ໄຂການລັອກ Git repository."

msgid "Compatibility with older Git versions."
msgstr "ຮອງຮັບການເຮັດວຽກຮ່ວມກັບ Git ເວີຊັນເກົ່າ."

msgid "Improved ACL support."
msgstr "ປັບປຸງການຮອງຮັບ ACL."

msgid "Added buttons for per language quotes and other special characters."
msgstr "ເພີ່ມປຸ່ມສຳລັບເຄື່ອງໝາຍວົງຢືມ ແລະຕົວອັກສອນພິເສດອື່ນໆຕາມພາສາ."

msgid "Support for exporting stats as JSONP."
msgstr "ຮອງຮັບການສົ່ງອອກສະຖິຕິເປັນ JSONP."

msgid "Weblate 3.x series"
msgstr "ຊຸດ Weblate 3.x"

msgid "Weblate 3.11.3"
msgstr "Weblate 3.11.3"

msgid "*Released on March 11th 2020.*"
msgstr "*ປ່ອຍອອກເມື່ອວັນທີ 11 ມີນາ 2020.*"

msgid "Fixed searching for fields with certain priority."
msgstr "ແກ້ໄຂການຄົ້ນຫາຊ່ອງຂໍ້ມູນທີ່ມີຄວາມສຳຄັນສະເພາະ."

msgid "Fixed predefined query for recently added strings."
msgstr "ແກ້ໄຂຄຳສັ່ງຄົ້ນຫາທີ່ກຳນົດໄວ້ລ່ວງໜ້າສຳລັບຂໍ້ຄວາມທີ່ເພີ່ມໃໝ່."

msgid "Fixed searching returning duplicate matches."
msgstr "ແກ້ໄຂການຄົ້ນຫາທີ່ສົ່ງຜົນລັດຊ້ຳກັນ."

msgid "Fixed notifications rendering in Gmail."
msgstr "ແກ້ໄຂການສະແດງຜົນການແຈ້ງເຕືອນໃນ Gmail."

msgid "Fixed reverting changes from the history."
msgstr "ແກ້ໄຂການຍົກເລີກການປ່ຽນແປງຈາກປະຫວັດ."

msgid "Added links to events in digest notifications."
msgstr "ເພີ່ມລິ້ງໄປຫາກິດຈະກຳຕ່າງໆໃນການແຈ້ງເຕືອນແບບລວມຍອດ."

msgid "Fixed email for account removal confirmation."
msgstr "ແກ້ໄຂອີເມວສຳລັບການຢືນຢັນການລຶບບັນຊີ."

msgid "Added support for Slack authentication in Docker container."
msgstr "ເພີ່ມການຮອງຮັບການພິສູດຕົວຕົນ Slack ໃນ Docker container."

msgid "Avoid sending notifications for not subscribed languages."
msgstr "ຫຼີກລ່ຽງການສົ່ງການແຈ້ງເຕືອນສຳລັບພາສາທີ່ບໍ່ໄດ້ຕິດຕາມ."

msgid "Include Celery queues in performance overview."
msgstr "ລວມ Celery queues ໃນພາບລວມປະສິດທິພາບ."

msgid "Fixed documentation links for add-ons."
msgstr "ແກ້ໄຂລິ້ງເອກະສານສຳລັບສ່ວນເສີມ."

msgid "Reduced false negatives for unchanged translation check."
msgstr "ຫຼຸດຜ່ອນຜົນລັດທີ່ບໍ່ຖືກຕ້ອງ (false negatives) ສຳລັບການກວດສອບການແປທີ່ບໍ່ມີການປ່ຽນແປງ."

msgid "Raised bleach dependency to address :cve:`2020-6802`."
msgstr "ຍົກລະດັບການເພິ່ງພາ bleach ເພື່ອແກ້ໄຂ :cve:`2020-6802`."

msgid "Fixed listing project level changes in history."
msgstr "ແກ້ໄຂການສະແດງລາຍການການປ່ຽນແປງລະດັບໂຄງການໃນປະຫວັດ."

msgid "Fixed stats invalidation in some corner cases."
msgstr "ແກ້ໄຂການຍົກເລີກສະຖິຕິໃນບາງກໍລະນີພິເສດ."

msgid "Fixed searching for certain string states."
msgstr "ແກ້ໄຂການຄົ້ນຫາສະຖານະຂໍ້ຄວາມບາງຢ່າງ."

msgid "Improved format string checks behavior on missing percent."
msgstr "ປັບປຸງການເຮັດວຽກຂອງການກວດສອບຮູບແບບຂໍ້ຄວາມໃນກໍລະນີທີ່ຂາດເຄື່ອງໝາຍເປີເຊັນ."

msgid "Fixed authentication using some third party providers."
msgstr "ແກ້ໄຂການພິສູດຕົວຕົນໂດຍໃຊ້ຜູ້ໃຫ້ບໍລິການພາກສ່ວນທີສາມບາງອັນ."

msgid "Weblate 3.11.2"
msgstr "Weblate 3.11.2"

msgid "*Released on February 22nd 2020.*"
msgstr "*ປ່ອຍອອກເມື່ອວັນທີ 22 ກຸມພາ 2020.*"

msgid "Fixed rendering of suggestions."
msgstr "ແກ້ໄຂການສະແດງຜົນຂອງຄຳແນະນຳ."

msgid "Fixed some strings wrongly reported as having no words."
msgstr "ແກ້ໄຂຂໍ້ຄວາມບາງຂໍ້ທີ່ຖືກລາຍງານຢ່າງຜິດພາດວ່າບໍ່ມີຄຳສັບ."

msgid "Weblate 3.11.1"
msgstr "Weblate 3.11.1"

msgid "*Released on February 20th 2020.*"
msgstr "*ປ່ອຍອອກເມື່ອວັນທີ 20 ກຸມພາ 2020.*"

msgid "Documented Celery setup changes."
msgstr "ບັນທຶກການປ່ຽນແປງການຕັ້ງຄ່າ Celery."

msgid "Improved filename validation on component creation."
msgstr "ປັບປຸງການກວດສອບຊື່ໄຟລ໌ເມື່ອສ້າງອົງປະກອບ."

msgid "Fixed minimal versions of some dependencies."
msgstr "ແກ້ໄຂເວີຊັນຂັ້ນຕໍ່າສຸດຂອງບາງອັນທີ່ເພິ່ງພາອາໄສ."

msgid "Fixed adding groups with certain Django versions."
msgstr "ແກ້ໄຂການເພີ່ມກຸ່ມດ້ວຍ Django ບາງເວີຊັນ."

msgid "Fixed manual pushing to upstream repository."
msgstr "ແກ້ໄຂການ push ດ້ວຍຕົນເອງໄປຍັງ repository ຕົ້ນທາງ."

msgid "Improved glossary matching."
msgstr "ປັບປຸງການຈັບຄູ່ວັດຈະນານຸກົມ."

msgid "Weblate 3.11"
msgstr "Weblate 3.11"

msgid "*Released on February 17th 2020.*"
msgstr "*ປ່ອຍອອກເມື່ອວັນທີ 17 ກຸມພາ 2020.*"

msgid "Allow using VCS push URL during component creation via API."
msgstr "ອະນຸຍາດໃຫ້ໃຊ້ VCS push URL ໃນຂະນະສ້າງອົງປະກອບຜ່ານ API."

msgid "Rendered width check now shows image with the render."
msgstr "ການກວດສອບຄວາມກວ້າງທີ່ສະແດງຜົນຕອນນີ້ຈະສະແດງຮູບພາບພ້ອມກັບການສະແດງຜົນ."

msgid "Fixed links in notifications e-mails."
msgstr "ແກ້ໄຂລິ້ງໃນອີເມວແຈ້ງເຕືອນ."

msgid "Improved look of plaintext e-mails."
msgstr "ປັບປຸງຮູບລັກສະນະຂອງອີເມວແບບຂໍ້ຄວາມທຳມະດາ."

msgid "Display ignored checks and allow to make them active again."
msgstr "ສະແດງການກວດສອບທີ່ຖືກລະເລີຍ ແລະອະນຸຍາດໃຫ້ເຮັດໃຫ້ພວກມັນກັບມາໃຊ້ງານໄດ້ອີກ."

msgid "Display nearby keys on monolingual translations."
msgstr "ສະແດງປຸ່ມທີ່ຢູ່ໃກ້ຄຽງໃນການແປແບບພາສາດຽວ."

msgid "Added support for grouping string shapings."
msgstr "ເພີ່ມການຮອງຮັບການຈັດກຸ່ມການປັບຮູບຮ່າງຂໍ້ຄວາມ."

msgid "Recommend upgrade to new Weblate versions in the system checks."
msgstr "ແນະນຳໃຫ້ອັບເກຣດເປັນ Weblate ເວີຊັນໃໝ່ໃນການກວດສອບລະບົບ."

msgid "Provide more detailed analysis for duplicate language alert."
msgstr "ສະໜອງການວິເຄາະທີ່ລະອຽດກວ່າສຳລັບການແຈ້ງເຕືອນພາສາຊ້ຳ."

msgid "Include more detailed license info on the project pages."
msgstr "ລວມຂໍ້ມູນໃບອະນຸຍາດທີ່ລະອຽດຂຶ້ນໃນໜ້າໂຄງການ."

msgid "Automatically unshallow local copies if needed."
msgstr "ຍົກເລີກການເປັນ shallow local copies ໂດຍອັດຕະໂນມັດຖ້າຈຳເປັນ."

msgid "Fixed download of strings needing action."
msgstr "ແກ້ໄຂການດາວໂຫຼດຂໍ້ຄວາມທີ່ຕ້ອງການການດຳເນີນການ."

msgid "New alert to warn about using the same file mask twice."
msgstr "ການແຈ້ງເຕືອນໃໝ່ເພື່ອເຕືອນກ່ຽວກັບການໃຊ້ file mask ອັນດຽວກັນສອງຄັ້ງ."

msgid "Improve XML placeables extraction."
msgstr "ປັບປຸງການສະກັດ XML placeables."

msgid ""
"The :setting:`SINGLE_PROJECT` can now enforce redirection to chosen project."
msgstr ":setting:`SINGLE_PROJECT` ຕອນນີ້ສາມາດບັງຄັບການປ່ຽນເສັ້ນທາງໄປຍັງໂຄງການທີ່ເລືອກໄດ້."

msgid "Added option to resolve comments."
msgstr "ເພີ່ມທາງເລືອກໃນການແກ້ໄຂຄຳເຫັນ."

msgid "Added bulk editing of flags."
msgstr "ເພີ່ມການແກ້ໄຂທຸງ (flags) ຈຳນວນຫຼາຍ."

msgid "Added support for :ref:`labels`."
msgstr "ເພີ່ມການຮອງຮັບ :ref:`labels`."

msgid "Added bulk edit add-on."
msgstr "ເພີ່ມສ່ວນເສີມການແກ້ໄຂຈຳນວນຫຼາຍ."

msgid "Added option for :ref:`enforcing-checks`."
msgstr "ເພີ່ມທາງເລືອກສຳລັບ :ref:`enforcing-checks`."

msgid "Increased default validity of confirmation links."
msgstr "ເພີ່ມອາຍຸເລີ່ມຕົ້ນຂອງລິ້ງຢືນຢັນ."

msgid "Improved Matomo integration."
msgstr "ປັບປຸງການເຊື່ອມໂຍງ Matomo."

msgid "Fixed :ref:`check-translated` to correctly handle source string change."
msgstr "ແກ້ໄຂ :ref:`check-translated` ໃຫ້ຈັດການການປ່ຽນແປງຂໍ້ຄວາມຕົ້ນສະບັບໄດ້ຢ່າງຖືກຕ້ອງ."

msgid "Extended automatic updates configuration by :setting:`AUTO_UPDATE`."
msgstr "ຂະຫຍາຍການຕັ້ງຄ່າການອັບເດດອັດຕະໂນມັດໂດຍ :setting:`AUTO_UPDATE`."

msgid "LINGUAS add-ons now do full sync of translations in Weblate."
msgstr "ສ່ວນເສີມ LINGUAS ຕອນນີ້ເຮັດການຊິງຄ໌ການແປຢ່າງເຕັມຮູບແບບໃນ Weblate."

msgid "Weblate 3.10.3"
msgstr "Weblate 3.10.3"

msgid "*Released on January 18th 2020.*"
msgstr "*ປ່ອຍອອກເມື່ອວັນທີ 18 ມັງກອນ 2020.*"

msgid "Support for translate-toolkit 2.5.0."
msgstr "ຮອງຮັບ translate-toolkit 2.5.0."

msgid "Weblate 3.10.2"
msgstr "Weblate 3.10.2"

msgid "Add lock indication to projects."
msgstr "ເພີ່ມການສະແດງການລັອກໃຫ້ກັບໂຄງການ."

msgid "Fixed CSS bug causing flickering in some web browsers."
msgstr "ແກ້ໄຂບັນຫາ CSS ທີ່ເຮັດໃຫ້ເກີດການກະພິບໃນບາງບຣາວເຊີ."

msgid "Fixed searching on systems with non-English locales."
msgstr "ແກ້ໄຂການຄົ້ນຫາໃນລະບົບທີ່ມີພາສາທີ່ບໍ່ແມ່ນພາສາອັງກິດ."

msgid "Improved repository matching for GitHub and Bitbucket hooks."
msgstr "ປັບປຸງການຈັບຄູ່ repository ສຳລັບ GitHub ແລະ Bitbucket hooks."

msgid "Fixed data migration on some Python 2.7 installations."
msgstr "ແກ້ໄຂການຍ້າຍຂໍ້ມູນໃນບາງການຕິດຕັ້ງ Python 2.7."

msgid "Allow configuration of Git shallow cloning."
msgstr "ອະນຸຍາດໃຫ້ຕັ້ງຄ່າ Git shallow cloning."

msgid "Improved background notification processing."
msgstr "ປັບປຸງການປະມວນຜົນການແຈ້ງເຕືອນເບື້ອງຫຼັງ."

msgid "Fixed broken form submission when navigating back in web browser."
msgstr "ແກ້ໄຂແບບຟອມທີ່ສົ່ງບໍ່ໄດ້ເມື່ອຍ້ອນກັບໃນບຣາວເຊີ."

msgid "New add-on to configure YAML formatting."
msgstr "ສ່ວນເສີມໃໝ່ສຳລັບຕັ້ງຄ່າຮູບແບບ YAML."

msgid "Fixed same plurals check to not fire on single plural form languages."
msgstr "ແກ້ໄຂການກວດສອບພົດດຽວກັນບໍ່ໃຫ້ເຮັດວຽກໃນພາສາທີ່ມີຮູບແບບພົດດຽວ."

msgid "Fixed regex search on some fields."
msgstr "ແກ້ໄຂການຄົ້ນຫາ regex ໃນບາງຊ່ອງຂໍ້ມູນ."

msgid "Weblate 3.10.1"
msgstr "Weblate 3.10.1"

msgid "*Released on January 9th 2020.*"
msgstr "*ປ່ອຍອອກເມື່ອວັນທີ 9 ມັງກອນ 2020.*"

msgid "Extended API with translation creation."
msgstr "ຂະຫຍາຍ API ດ້ວຍການສ້າງການແປ."

msgid "Fixed several corner cases in data migrations."
msgstr "ແກ້ໄຂກໍລະນີພິເສດຫຼາຍຢ່າງໃນການຍ້າຍຂໍ້ມູນ."

msgid "Compatibility with Django 3.0."
msgstr "ຮອງຮັບການເຮັດວຽກຮ່ວມກັບ Django 3.0."

msgid "Improved data clean-up performance."
msgstr "ປັບປຸງປະສິດທິພາບການທຳຄວາມສະອາດຂໍ້ມູນ."

msgid "Added support for customizable security.txt."
msgstr "ເພີ່ມການຮອງຮັບ security.txt ທີ່ປັບແຕ່ງໄດ້."

msgid "Improved breadcrumbs in changelog."
msgstr "ປັບປຸງ breadcrumbs ໃນ changelog."

msgid "Improved translations listing on dashboard."
msgstr "ປັບປຸງລາຍການແປໃນ dashboard."

msgid "Improved HTTP responses for webhooks."
msgstr "ປັບປຸງການຕອບສະໜອງ HTTP ສຳລັບ webhooks."

msgid "Added support for GitLab merge requests in Docker container."
msgstr "ເພີ່ມການຮອງຮັບ GitLab merge requests ໃນ Docker container."

msgid "Weblate 3.10"
msgstr "Weblate 3.10"

msgid "*Released on December 20th 2019.*"
msgstr "*ປ່ອຍອອກເມື່ອວັນທີ 20 ທັນວາ 2019.*"

msgid "Improved application user interface."
msgstr "ປັບປຸງອິນເຕີເຟດຜູ້ໃຊ້ຂອງແອັບພລິເຄຊັນ."

msgid "Added doublespace check."
msgstr "ເພີ່ມການກວດສອບຊ່ອງຫວ່າງສອງເທົ່າ."

msgid "Fixed creating new languages."
msgstr "ແກ້ໄຂການສ້າງພາສາໃໝ່."

msgid "Avoid sending auditlog notifications to deleted e-mails."
msgstr "ຫຼີກລ່ຽງການສົ່ງການແຈ້ງເຕືອນ auditlog ໄປຫາອີເມວທີ່ຖືກລຶບ."

msgid "Added support for read-only strings."
msgstr "ເພີ່ມການຮອງຮັບຂໍ້ຄວາມແບບອ່ານຢ່າງດຽວ."

msgid "Added support for Markdown in comments."
msgstr "ເພີ່ມການຮອງຮັບ Markdown ໃນຄຳເຫັນ."

msgid "Allow placing translation instruction text in project info."
msgstr "ອະນຸຍາດໃຫ້ໃສ່ຂໍ້ຄວາມຄຳແນະນຳການແປໃນຂໍ້ມູນໂຄງການ."

msgid "Add copy to clipboard for secondary languages."
msgstr "ເພີ່ມການສຳເນົາໃສ່ຄລິບບອດສຳລັບພາສາສຳຮອງ."

msgid "Improved support for Mercurial."
msgstr "ປັບປຸງການຮອງຮັບ Mercurial."

msgid "Improved Git repository fetching performance."
msgstr "ປັບປຸງປະສິດທິພາບການດຶງຂໍ້ມູນ Git repository."

msgid "Add search lookup for age of string."
msgstr "ເພີ່ມການຄົ້ນຫາໂດຍອີງຕາມອາຍຸຂອງຂໍ້ຄວາມ."

msgid "Show source language for all translations."
msgstr "ສະແດງພາສາຕົ້ນສະບັບສຳລັບການແປທັງໝົດ."

msgid "Show context for nearby strings."
msgstr "ສະແດງບໍລິບົດສຳລັບຂໍ້ຄວາມທີ່ຢູ່ໃກ້ຄຽງ."

msgid "Added support for notifications on repository operations."
msgstr "ເພີ່ມການຮອງຮັບການແຈ້ງເຕືອນໃນການດຳເນີນການ repository."

msgid "Improved translation listings."
msgstr "ປັບປຸງລາຍການການແປ."

msgid "Added support for automatic translation strings marked for editing."
msgstr "ເພີ່ມການຮອງຮັບການແປອັດຕະໂນມັດສຳລັບຂໍ້ຄວາມທີ່ຖືກໝາຍໄວ້ເພື່ອແກ້ໄຂ."

msgid "Avoid sending duplicate notifications for linked component alerts."
msgstr "ຫຼີກລ່ຽງການສົ່ງການແຈ້ງເຕືອນຊ້ຳກັນສຳລັບການແຈ້ງເຕືອນອົງປະກອບທີ່ເຊື່ອມໂຍງ."

msgid "Improve default merge request message."
msgstr "ປັບປຸງຂໍ້ຄວາມ merge request ເລີ່ມຕົ້ນ."

msgid "Better indicate string state in Zen mode."
msgstr "ສະແດງສະຖານະຂໍ້ຄວາມໃນໂໝດ Zen ໄດ້ດີຂຶ້ນ."

msgid "Added support for more languages in Yandex Translate."
msgstr "ເພີ່ມການຮອງຮັບພາສາເພີ່ມເຕີມໃນ Yandex Translate."

msgid "Improved look of notification e-mails."
msgstr "ປັບປຸງຮູບລັກສະນະຂອງອີເມວແຈ້ງເຕືອນ."

msgid "Provide choice for translation license."
msgstr "ມີທາງເລືອກສຳລັບສິດທິບັດການແປ."

msgid "Weblate 3.9.1"
msgstr "Weblate 3.9.1"

msgid "*Released on October 28th 2019.*"
msgstr "*ອອກວັນທີ 28 ຕຸລາ 2019.*"

msgid "Remove some unneeded files from backups."
msgstr "ລຶບໄຟລ໌ທີ່ບໍ່ຈຳເປັນບາງຢ່າງອອກຈາກການສຳຮອງຂໍ້ມູນ."

msgid "Fixed potential crash in reports."
msgstr "ແກ້ໄຂການຂັດຂ້ອງທີ່ອາດເກີດຂຶ້ນໃນລາຍງານ."

msgid "Fixed cross database migration failure."
msgstr "ແກ້ໄຂຄວາມລົ້ມເຫຼວໃນການຍ້າຍຂໍ້ມູນລະຫວ່າງຖານຂໍ້ມູນ."

msgid "Added support for force pushing Git repositories."
msgstr "ເພີ່ມການຮອງຮັບສຳລັບການບັງຄັບ Push ໃຫ້ Git."

msgid "Reduced risk of registration token invalidation."
msgstr "ຫຼຸດຜ່ອນຄວາມສ່ຽງຂອງການທີ່ Token ລົງທະບຽນໃຊ້ບໍ່ໄດ້."

msgid "Fixed account removal hitting rate limiter."
msgstr "ແກ້ໄຂບັນຫາການລຶບບັນຊີຖືກຈຳກັດອັດຕາການເຮັດວຽກ."

msgid "Added search based on priority."
msgstr "ເພີ່ມການຄົ້ນຫາໂດຍອີງຕາມຄວາມສຳຄັນ."

msgid "Fixed possible crash on adding strings to JSON file."
msgstr "ແກ້ໄຂການຂັດຂ້ອງທີ່ອາດເກີດຂຶ້ນເມື່ອເພີ່ມຂໍ້ຄວາມເຂົ້າໃນໄຟລ໌ JSON."

msgid "Safe HTML check and fixup now honor source string markup."
msgstr "ການກວດສອບແລະແກ້ໄຂ HTML ແບບປອດໄພ ຕອນນີ້ຮອງຮັບ Markup ໃນຂໍ້ຄວາມຕົ້ນສະບັບແລ້ວ."

msgid "Avoid sending notifications to invited and deleted users."
msgstr "ຫຼີກເວັ້ນການສົ່ງແຈ້ງເຕືອນຫາຜູ້ໃຊ້ທີ່ຖືກເຊີນແລະຜູ້ໃຊ້ທີ່ຖືກລຶບ."

msgid "Fix SSL connection to redis in Celery in Docker container."
msgstr "ແກ້ໄຂການເຊື່ອມຕໍ່ SSL ຫາ Redis ໃນ Celery ພາຍໃນ Docker."

msgid "Weblate 3.9"
msgstr "Weblate 3.9"

msgid "*Released on October 15th 2019.*"
msgstr "*ອອກວັນທີ 15 ຕຸລາ 2019.*"

msgid "Include Weblate metadata in downloaded files."
msgstr "ລວມ Metadata ຂອງ Weblate ໃນໄຟລ໌ທີ່ດາວໂຫຼດ."

msgid "Improved UI for failing checks."
msgstr "ປັບປຸງສ່ວນຕິດຕໍ່ຜູ້ໃຊ້ສຳລັບການກວດສອບທີ່ບໍ່ຜ່ານ."

msgid "Indicate missing strings in format checks."
msgstr "ຊີ້ບອກຂໍ້ຄວາມທີ່ຂາດຫາຍໄປໃນການກວດສອບຮູບແບບ."

msgid "Separate check for French punctuation spacing."
msgstr "ແຍກການກວດສອບສຳລັບການເວັ້ນວັກເຄື່ອງໝາຍວັກຕອນພາສາຝຣັ່ງ."

msgid "Add support for fixing some of quality checks errors."
msgstr "ເພີ່ມການຮອງຮັບການແກ້ໄຂຂໍ້ຜິດພາດບາງຢ່າງຈາກການກວດສອບຄຸນນະພາບ."

msgid "Add separate permission to create new projects."
msgstr "ເພີ່ມສິດທິສະເພາະໃນການສ້າງໂຄງການໃໝ່."

msgid "Extend stats for char counts."
msgstr "ຂະຫຍາຍສະຖິຕິສຳລັບການນັບຈຳນວນຕົວອັກສອນ."

msgid "Improve support for Java style language codes."
msgstr "ປັບປຸງການຮອງຮັບລະຫັດພາສາແບບ Java."

msgid "Added new generic check for placeholders."
msgstr "ເພີ່ມການກວດສອບທົ່ວໄປແບບໃໝ່ສຳລັບ Placeholder."

msgid "Added support for WebExtension JSON placeholders."
msgstr "ເພີ່ມການຮອງຮັບ Placeholder ສຳລັບ WebExtension JSON."

msgid "Added support for flat XML format."
msgstr "ເພີ່ມການຮອງຮັບຮູບແບບ XML ແບບແປ."

msgid ""
"Extended API with project, component and translation removal and creation."
msgstr "ຂະຫຍາຍ API ໃຫ້ຮອງຮັບການສ້າງແລະລຶບໂຄງການ, ອົງປະກອບ ແລະ ການແປ."

msgid "Added support for Gitea and Gitee webhooks."
msgstr "ເພີ່ມການຮອງຮັບ Webhook ສຳລັບ Gitea ແລະ Gitee."

msgid "Added new custom regex based check."
msgstr "ເພີ່ມການກວດສອບໃໝ່ໂດຍອີງຕາມ Regex ທີ່ກຳນົດເອງ."

msgid "Allow to configure contributing to shared translation memory."
msgstr "ອະນຸຍາດໃຫ້ຕັ້ງຄ່າການປະກອບສ່ວນເຂົ້າໃນໜ່ວຍຄວາມຈຳການແປແບບໃຊ້ຮ່ວມກັນ."

msgid "Added ZIP download for more translation files."
msgstr "ເພີ່ມການດາວໂຫຼດແບບ ZIP ສຳລັບໄຟລ໌ການແປເພີ່ມເຕີມ."

msgid "Make XLIFF standard compliant parsing of maxwidth and font."
msgstr "ເຮັດໃຫ້ການແຍກວິເຄາະ maxwidth ແລະ font ເປັນໄປຕາມມາດຕະຖານ XLIFF."

msgid ""
"Added new check and fixer for safe HTML markup for translating web "
"applications."
msgstr "ເພີ່ມການກວດສອບແລະແກ້ໄຂໃໝ່ສຳລັບ HTML markup ທີ່ປອດໄພໃນການແປແອັບພລິເຄຊັນເວັບ."

msgid "Add component alert on unsupported configuration."
msgstr "ເພີ່ມການແຈ້ງເຕືອນອົງປະກອບເມື່ອພົບການຕັ້ງຄ່າທີ່ບໍ່ຮອງຮັບ."

msgid "Added automatic translation add-on to bootstrap translations."
msgstr "ເພີ່ມ Add-on ການແປອັດຕະໂນມັດເພື່ອເລີ່ມຕົ້ນການແປ."

msgid "Extend automatic translation to add suggestions."
msgstr "ຂະຫຍາຍການແປອັດຕະໂນມັດໃຫ້ເພີ່ມຄຳແນະນຳ."

msgid "Display add-on parameters on overview."
msgstr "ສະແດງພາລາມິເຕີຂອງ Add-on ໃນໜ້າສະຫຼຸບ."

msgid "Sentry is now supported through modern Sentry SDK instead of Raven."
msgstr "Sentry ຕອນນີ້ຮອງຮັບຜ່ານ Sentry SDK ສະໄໝໃໝ່ແທນທີ່ Raven."

msgid "Changed example settings to be better fit for production environment."
msgstr "ປ່ຽນການຕັ້ງຄ່າຕົວຢ່າງໃຫ້ເໝາະສົມກັບສະພາບແວດລ້ອມການໃຊ້ງານຈິງຫຼາຍຂຶ້ນ."

msgid "Added automated backups using BorgBackup."
msgstr "ເພີ່ມການສຳຮອງຂໍ້ມູນອັດຕະໂນມັດໂດຍໃຊ້ BorgBackup."

msgid "Split cleanup add-on for RESX to avoid unwanted file updates."
msgstr "ແຍກ Add-on ການລ້າງຂໍ້ມູນສຳລັບ RESX ເພື່ອຫຼີກເວັ້ນການອັບເດດໄຟລ໌ທີ່ບໍ່ຕ້ອງການ."

msgid "Added advanced search capabilities."
msgstr "ເພີ່ມຄວາມສາມາດໃນການຄົ້ນຫາຂັ້ນສູງ."

msgid "Allow users to download their own reports."
msgstr "ອະນຸຍາດໃຫ້ຜູ້ໃຊ້ດາວໂຫຼດລາຍງານຂອງຕົນເອງ."

msgid "Added localization guide to help configuring components."
msgstr "ເພີ່ມຄູ່ມືການແປພາສາເພື່ອຊ່ວຍໃນການຕັ້ງຄ່າອົງປະກອບ."

msgid "Added support for GitLab merge requests."
msgstr "ເພີ່ມການຮອງຮັບ GitLab Merge Request."

msgid "Improved display of repository status."
msgstr "ປັບປຸງການສະແດງສະຖານະຂອງ Repository."

msgid "Perform automated translation in the background."
msgstr "ດຳເນີນການແປອັດຕະໂນມັດໃນພື້ນຫຼັງ."

msgid "Weblate 3.8"
msgstr "Weblate 3.8"

msgid "*Released on August 15th 2019.*"
msgstr "*ອອກວັນທີ 15 ສິງຫາ 2019.*"

msgid "Added support for simplified creating of similar components."
msgstr "ເພີ່ມການຮອງຮັບການສ້າງອົງປະກອບທີ່ຄ້າຍຄືກັນແບບງ່າຍ."

msgid ""
"Added support for parsing translation flags from the XML based file formats."
msgstr "ເພີ່ມການຮອງຮັບການແຍກວິເຄາະທຸງການແປຈາກຮູບແບບໄຟລ໌ XML."

msgid "Log exceptions into Celery log."
msgstr "ບັນທຶກ Exception ລົງໃນ Log ຂອງ Celery."

msgid "Improve performance of repository scoped add-ons."
msgstr "ປັບປຸງປະສິດທິພາບຂອງ Add-on ລະດັບ Repository."

msgid "Fixed password reset behavior."
msgstr "ແກ້ໄຂການເຮັດວຽກຂອງການຣີເຊັດລະຫັດຜ່ານ."

msgid "Improved performance on most of translation pages."
msgstr "ປັບປຸງປະສິດທິພາບໃນໜ້າການແປສ່ວນໃຫຍ່."

msgid "Fixed listing of languages not known to Weblate."
msgstr "ແກ້ໄຂລາຍການພາສາທີ່ Weblate ບໍ່ຮູ້ຈັກ."

msgid "Add support for cloning add-ons to discovered components."
msgstr "ເພີ່ມການຮອງຮັບການ Clone Add-on ໄປຍັງອົງປະກອບທີ່ຖືກຄົ້ນພົບ."

msgid "Add support for replacing file content with uploaded."
msgstr "ເພີ່ມການຮອງຮັບການແທນທີ່ເນື້ອຫາໄຟລ໌ດ້ວຍໄຟລ໌ທີ່ອັບໂຫຼດ."

msgid "Add support for translating non VCS based content."
msgstr "ເພີ່ມການຮອງຮັບການແປເນື້ອຫາທີ່ບໍ່ໄດ້ອີງຕາມ VCS."

msgid "Added OpenGraph widget image to use on social networks."
msgstr "ເພີ່ມຮູບພາບ Widget OpenGraph ສຳລັບໃຊ້ໃນສື່ສັງຄົມອອນລາຍ."

msgid "Added support for animated screenshots."
msgstr "ເພີ່ມການຮອງຮັບຮູບພາບໜ້າຈໍແບບເຄື່ອນໄຫວ."

msgid "Improved handling of monolingual XLIFF files."
msgstr "ປັບປຸງການຈັດການໄຟລ໌ XLIFF ແບບພາສາດຽວ."

msgid "Avoid sending multiple notifications for single event."
msgstr "ຫຼີກເວັ້ນການສົ່ງແຈ້ງເຕືອນຫຼາຍຄັ້ງສຳລັບເຫດການດຽວ."

msgid "Add support for filtering changes."
msgstr "ເພີ່ມການຮອງຮັບການກັ່ນຕອງການປ່ຽນແປງ."

msgid "Extended predefined periods for reporting."
msgstr "ຂະຫຍາຍໄລຍະເວລາທີ່ກຳນົດໄວ້ລ່ວງໜ້າສຳລັບລາຍງານ."

msgid "Added webhook support for Azure Repos."
msgstr "ເພີ່ມການຮອງຮັບ Webhook ສຳລັບ Azure Repos."

msgid ""
"New opt-in notifications on pending suggestions or untranslated strings."
msgstr "ການແຈ້ງເຕືອນແບບໃໝ່ສຳລັບຄຳແນະນຳທີ່ຍັງຄ້າງ ຫຼື ຂໍ້ຄວາມທີ່ຍັງບໍ່ທັນໄດ້ແປ."

msgid "Add one click unsubscribe link to notification e-mails."
msgstr "ເພີ່ມລິ້ງຍົກເລີກການຮັບຂ່າວສານແບບຄລິກດຽວໃນອີເມວແຈ້ງເຕືອນ."

msgid "Fixed false positives with Has been translated check."
msgstr "ແກ້ໄຂການກວດສອບ \"ໄດ້ຮັບການແປແລ້ວ\" ທີ່ສະແດງຜົນຜິດພາດ."

msgid "New management interface for admins."
msgstr "ສ່ວນຕິດຕໍ່ການຈັດການໃໝ່ສຳລັບຜູ້ດູແລ."

msgid "String priority can now be specified using flags."
msgstr "ຄວາມສຳຄັນຂອງຂໍ້ຄວາມຕອນນີ້ສາມາດລະບຸໄດ້ໂດຍໃຊ້ທຸງ."

msgid "Added language management views."
msgstr "ເພີ່ມມຸມມອງການຈັດການພາສາ."

msgid "Add checks for Qt library and Ruby format strings."
msgstr "ເພີ່ມການກວດສອບສຳລັບ Qt library ແລະ Ruby format string."

msgid "Added configuration to better fit single project installations."
msgstr "ເພີ່ມການຕັ້ງຄ່າເພື່ອໃຫ້ເໝາະສົມກັບການຕິດຕັ້ງໂຄງການດຽວຫຼາຍຂຶ້ນ."

msgid ""
"Notify about new string on source string change on monolingual translations."
msgstr "ແຈ້ງເຕືອນກ່ຽວກັບຂໍ້ຄວາມໃໝ່ເມື່ອມີການປ່ຽນແປງຂໍ້ຄວາມຕົ້ນສະບັບໃນການແປພາສາດຽວ."

msgid "Added separate view for translation memory with search capability."
msgstr "ເພີ່ມມຸມມອງແຍກຕ່າງຫາກສຳລັບໜ່ວຍຄວາມຈຳການແປພ້ອມຄວາມສາມາດໃນການຄົ້ນຫາ."

msgid "Weblate 3.7.1"
msgstr "Weblate 3.7.1"

msgid "*Released on June 28th 2019.*"
msgstr "*ອອກວັນທີ 28 ມິຖຸນາ 2019.*"

msgid "Fixed some requirements constraints."
msgstr "ແກ້ໄຂຂໍ້ກຳນົດບາງຢ່າງ."

msgid "Updated language database."
msgstr "ອັບເດດຖານຂໍ້ມູນພາສາ."

msgid "Localization updates."
msgstr "ອັບເດດການແປພາສາ."

msgid "Various user interface tweaks."
msgstr "ການປັບປ່ຽນສ່ວນຕິດຕໍ່ຜູ້ໃຊ້ຕ່າງໆ."

msgid "Improved handling of unsupported but discovered translation files."
msgstr "ປັບປຸງການຈັດການໄຟລ໌ການແປທີ່ບໍ່ຮອງຮັບແຕ່ຖືກຄົ້ນພົບ."

msgid "More verbosely report missing file format requirements."
msgstr "ລາຍງານຂໍ້ກຳນົດຮູບແບບໄຟລ໌ທີ່ຂາດຫາຍໄປຢ່າງລະອຽດ."

msgid "Weblate 3.7"
msgstr "Weblate 3.7"

msgid "*Released on June 21st 2019.*"
msgstr "*ອອກວັນທີ 21 ມິຖຸນາ 2019.*"

msgid "Added separate Celery queue for notifications."
msgstr "ເພີ່ມຄິວ Celery ແຍກຕ່າງຫາກສຳລັບການແຈ້ງເຕືອນ."

msgid "Use consistent look with application for API browsing."
msgstr "ໃຊ້ຮູບແບບທີ່ສອດຄ່ອງກັບແອັບພລິເຄຊັນສຳລັບການເບິ່ງ API."

msgid "Include approved stats in the reports."
msgstr "ລວມສະຖິຕິທີ່ໄດ້ຮັບການອະນຸມັດໃນລາຍງານ."

msgid "Report progress when updating translation component."
msgstr "ລາຍງານຄວາມຄືບໜ້າເມື່ອອັບເດດອົງປະກອບການແປ."

msgid "Allow to abort running background component update."
msgstr "ອະນຸຍາດໃຫ້ຍົກເລີກການອັບເດດອົງປະກອບທີ່ກຳລັງເຮັດວຽກຢູ່ເບື້ອງຫຼັງ."

msgid "Extend template language for filename manipulations."
msgstr "ຂະຫຍາຍພາສາ Template ສຳລັບການຈັດການຊື່ໄຟລ໌."

msgid "Use templates for editor link and repository browser URL."
msgstr "ໃຊ້ Template ສຳລັບລິ້ງຕົວແກ້ໄຂ ແລະ URL ຂອງ Repository browser."

msgid ""
"Indicate max length and current characters count when editing translation."
msgstr "ຊີ້ບອກຄວາມຍາວສູງສຸດແລະຈຳນວນຕົວອັກສອນປັດຈຸບັນເມື່ອແກ້ໄຂຄຳແປ."

msgid "Improved handling of abbreviations in unchanged translation check."
msgstr "ປັບປຸງການຈັດການຕົວຫຍໍ້ໃນການກວດສອບການແປທີ່ບໍ່ປ່ຽນແປງ."

msgid "Refreshed landing page for new contributors."
msgstr "ປັບປຸງໜ້າ Landing page ສຳລັບຜູ້ປະກອບສ່ວນໃໝ່."

msgid "Add support for configuring msgmerge add-on."
msgstr "ເພີ່ມການຮອງຮັບການຕັ້ງຄ່າ Add-on msgmerge."

msgid "Delay opening SMTP connection when sending notifications."
msgstr "ຊະລໍການເປີດການເຊື່ອມຕໍ່ SMTP ເມື່ອສົ່ງແຈ້ງເຕືອນ."

msgid "Improved error logging."
msgstr "ປັບປຸງການບັນທຶກຂໍ້ຜິດພາດ."

msgid "Allow custom location in MO generating add-on."
msgstr "ອະນຸຍາດໃຫ້ກຳນົດຕຳແໜ່ງເອງໃນ Add-on ສ້າງໄຟລ໌ MO."

msgid "Added add-ons to cleanup old suggestions or comments."
msgstr "ເພີ່ມ Add-on ເພື່ອລ້າງຄຳແນະນຳຫຼືຄຳເຫັນເກົ່າ."

msgid "Added option to enable horizontal mode in the Zen editor."
msgstr "ເພີ່ມຕົວເລືອກເພື່ອເປີດໃຊ້ໂໝດແນວນອນໃນ Zen editor."

msgid "Improved import performance with many linked components."
msgstr "ປັບປຸງປະສິດທິພາບການນຳເຂົ້າທີ່ມີອົງປະກອບເຊື່ອມໂຍງຫຼາຍອັນ."

msgid "Fixed examples installation in some cases."
msgstr "ແກ້ໄຂການຕິດຕັ້ງຕົວຢ່າງໃນບາງກໍລະນີ."

msgid "Improved rendering of alerts in changes."
msgstr "ປັບປຸງການສະແດງການແຈ້ງເຕືອນໃນສ່ວນການປ່ຽນແປງ."

msgid "Added new horizontal stats widget."
msgstr "ເພີ່ມ Widget ສະຖິຕິແນວນອນໃໝ່."

msgid "Improved format strings check on plurals."
msgstr "ປັບປຸງການກວດສອບ Format string ໃນຮູບແບບພົດ (Plurals)."

msgid "Added font management tool."
msgstr "ເພີ່ມເຄື່ອງມືຈັດການຟອນ."

msgid "New check for rendered text dimensions."
msgstr "ການກວດສອບໃໝ່ສຳລັບມິຕິຂອງຂໍ້ຄວາມທີ່ສະແດງຜົນ."

msgid "Added support for subtitle formats."
msgstr "ເພີ່ມການຮອງຮັບຮູບແບບໄຟລ໌ຄຳບັນຍາຍ (Subtitle)."

msgid "Include overall completion stats for languages."
msgstr "ລວມສະຖິຕິຄວາມສຳເລັດໂດຍລວມສຳລັບພາສາ."

msgid "Added reporting at project and global scope."
msgstr "ເພີ່ມການລາຍງານໃນລະດັບໂຄງການແລະທົ່ວໂລກ."

msgid "Improved user interface when showing translation status."
msgstr "ປັບປຸງສ່ວນຕິດຕໍ່ຜູ້ໃຊ້ເມື່ອສະແດງສະຖານະການແປ."

msgid "New Weblate logo and color scheme."
msgstr "ໂລໂກ້ແລະໂທນສີ Weblate ໃໝ່."

msgid "New look of bitmap badges."
msgstr "ຮູບລັກສະນະໃໝ່ຂອງ Bitmap badge."

msgid "Weblate 3.6.1"
msgstr "Weblate 3.6.1"

msgid "*Released on April 26th 2019.*"
msgstr "*ອອກວັນທີ 26 ເມສາ 2019.*"

msgid "Fixed digest notifications in some corner cases."
msgstr "ແກ້ໄຂການແຈ້ງເຕືອນແບບລວມ (Digest) ໃນບາງກໍລະນີພິເສດ."

msgid "Fixed add-on script error alert."
msgstr "ແກ້ໄຂການແຈ້ງເຕືອນຂໍ້ຜິດພາດຂອງສະຄຣິບ Add-on."

msgid "Fixed generating MO file for monolingual PO files."
msgstr "ແກ້ໄຂການສ້າງໄຟລ໌ MO ສຳລັບໄຟລ໌ PO ພາສາດຽວ."

msgid "Fixed display of uninstalled checks."
msgstr "ແກ້ໄຂການສະແດງການກວດສອບທີ່ບໍ່ໄດ້ຕິດຕັ້ງ."

msgid "Indicate administered projects on project listing."
msgstr "ຊີ້ບອກໂຄງການທີ່ຖືກດູແລໃນລາຍການໂຄງການ."

msgid "Allow update to recover from missing VCS repository."
msgstr "ອະນຸຍາດໃຫ້ອັບເດດຟື້ນຟູຈາກການທີ່ VCS Repository ຫາຍໄປ."

msgid "Weblate 3.6"
msgstr "Weblate 3.6"

msgid "*Released on April 20th 2019.*"
msgstr "*ອອກວັນທີ 20 ເມສາ 2019.*"

msgid "Add support for downloading user data."
msgstr "ເພີ່ມການຮອງຮັບການດາວໂຫຼດຂໍ້ມູນຜູ້ໃຊ້."

msgid "Add-ons are now automatically triggered upon installation."
msgstr "Add-on ຈະຖືກເຮັດວຽກໂດຍອັດຕະໂນມັດເມື່ອຕິດຕັ້ງ."

msgid "Improved instructions for resolving merge conflicts."
msgstr "ປັບປຸງຄຳແນະນຳສຳລັບການແກ້ໄຂຄວາມຂັດແຍ້ງໃນການ Merge."

msgid "Cleanup add-on is now compatible with app store metadata translations."
msgstr "Add-on ລ້າງຂໍ້ມູນຕອນນີ້ສາມາດໃຊ້ຮ່ວມກັບການແປ Metadata ຂອງ App store."

msgid "Configurable language code syntax when adding new translations."
msgstr "ສາມາດຕັ້ງຄ່າ Syntax ຂອງລະຫັດພາສາໄດ້ເມື່ອເພີ່ມການແປໃໝ່."

msgid ""
"Warn about using Python 2 with planned termination of support in April 2020."
msgstr "ແຈ້ງເຕືອນກ່ຽວກັບການໃຊ້ Python 2 ເຊິ່ງມີແຜນຈະຍົກເລີກການຮອງຮັບໃນເດືອນເມສາ 2020."

msgid "Extract special characters from the source string for visual keyboard."
msgstr "ສະກັດຕົວອັກສອນພິເສດຈາກຂໍ້ຄວາມຕົ້ນສະບັບສຳລັບແປ້ນພິມຈຳລອງ."

msgid "Extended contributor stats to reflect both source and target counts."
msgstr "ຂະຫຍາຍສະຖິຕິຜູ້ປະກອບສ່ວນໃຫ້ສະທ້ອນທັງຈຳນວນຕົ້ນສະບັບແລະເປົ້າໝາຍ."

msgid ""
"Admins and consistency add-ons can now add translations even if disabled for "
"users."
msgstr ""
"ຜູ້ດູແລແລະ Add-on ຄວາມສອດຄ່ອງຕອນນີ້ສາມາດເພີ່ມການແປໄດ້ເຖິງແມ່ນວ່າຈະຖືກປິດໃຊ້ງານສຳລັບຜູ້ໃຊ້."

msgid ""
"Fixed description of toggle disabling ``Language-Team`` header manipulation."
msgstr "ແກ້ໄຂຄຳອະທິບາຍຂອງປຸ່ມປິດໃຊ້ງານການຈັດການ Header ``Language-Team``."

msgid "Notify users mentioned in comments."
msgstr "ແຈ້ງເຕືອນຜູ້ໃຊ້ທີ່ຖືກກ່າວເຖິງໃນຄຳເຫັນ."

msgid "Removed file format autodetection from component setup."
msgstr "ລຶບການກວດສອບຮູບແບບໄຟລ໌ອັດຕະໂນມັດອອກຈາກການຕັ້ງຄ່າອົງປະກອບ."

msgid "Added digest notifications."
msgstr "ເພີ່ມການແຈ້ງເຕືອນແບບລວມ (Digest)."

msgid "Added support for muting component notifications."
msgstr "ເພີ່ມການຮອງຮັບການປິດສຽງແຈ້ງເຕືອນອົງປະກອບ."

msgid "Added notifications for new alerts, whiteboard messages or components."
msgstr "ເພີ່ມການແຈ້ງເຕືອນສຳລັບການເຕືອນໃໝ່, ຂໍ້ຄວາມ Whiteboard ຫຼື ອົງປະກອບ."

msgid "Notifications for administered projects can now be configured."
msgstr "ສາມາດຕັ້ງຄ່າການແຈ້ງເຕືອນສຳລັບໂຄງການທີ່ຖືກດູແລ."

msgid "Improved handling of three letter language codes."
msgstr "ປັບປຸງການຈັດການລະຫັດພາສາສາມຕົວອັກສອນ."

msgid "Weblate 3.5.1"
msgstr "Weblate 3.5.1"

msgid "*Released on March 10th 2019.*"
msgstr "*ອອກວັນທີ 10 ມີນາ 2019.*"

msgid "Fixed Celery systemd unit example."
msgstr "ແກ້ໄຂຕົວຢ່າງ Celery systemd unit."

msgid "Fixed notifications from HTTP repositories with login."
msgstr "ແກ້ໄຂການແຈ້ງເຕືອນຈາກ HTTP Repository ທີ່ມີການເຂົ້າສູ່ລະບົບ."

msgid ""
"Fixed race condition in editing source string for monolingual translations."
msgstr "ແກ້ໄຂບັນຫາ Race condition ໃນການແກ້ໄຂຂໍ້ຄວາມຕົ້ນສະບັບສຳລັບການແປພາສາດຽວ."

msgid "Include output of failed add-on execution in the logs."
msgstr "ລວມຜົນລັພຂອງການເຮັດວຽກ Add-on ທີ່ລົ້ມເຫຼວໃນ Log."

msgid "Improved validation of choices for adding new language."
msgstr "ປັບປຸງການກວດສອບຕົວເລືອກສຳລັບການເພີ່ມພາສາໃໝ່."

msgid "Allow to edit file format in component settings."
msgstr "ອະນຸຍາດໃຫ້ແກ້ໄຂຮູບແບບໄຟລ໌ໃນການຕັ້ງຄ່າອົງປະກອບ."

msgid "Update installation instructions to prefer Python 3."
msgstr "ອັບເດດຄຳແນະນຳການຕິດຕັ້ງໃຫ້ໃຊ້ Python 3 ເປັນຕົ້ນຕໍ."

msgid "Performance and consistency improvements for loading translations."
msgstr "ປັບປຸງປະສິດທິພາບແລະຄວາມສອດຄ່ອງສຳລັບການໂຫຼດການແປ."

msgid ""
"Make Microsoft Terminology service compatible with current Zeep releases."
msgstr "ເຮັດໃຫ້ບໍລິການ Microsoft Terminology ສາມາດໃຊ້ຮ່ວມກັບ Zeep ລຸ້ນປັດຈຸບັນໄດ້."

msgid "Weblate 3.5"
msgstr "Weblate 3.5"

msgid "*Released on March 3rd 2019.*"
msgstr "*ອອກວັນທີ 3 ມີນາ 2019.*"

msgid "Improved performance of built-in translation memory."
msgstr "ປັບປຸງປະສິດທິພາບຂອງໜ່ວຍຄວາມຈຳການແປທີ່ມີມາໃຫ້."

msgid "Added interface to manage global translation memory."
msgstr "ເພີ່ມອິນເຕີເຟສເພື່ອຈັດການໜ່ວຍຄວາມຈຳການແປທົ່ວໂລກ."

msgid "Improved alerting on bad component state."
msgstr "ປັບປຸງການແຈ້ງເຕືອນເມື່ອອົງປະກອບຢູ່ໃນສະຖານະທີ່ບໍ່ດີ."

msgid "Added user interface to manage whiteboard messages."
msgstr "ເພີ່ມອິນເຕີເຟສຜູ້ໃຊ້ເພື່ອຈັດການຂໍ້ຄວາມ Whiteboard."

msgid "Add-on commit message now can be configured."
msgstr "ຕອນນີ້ສາມາດຕັ້ງຄ່າຂໍ້ຄວາມ Commit ຂອງ Add-on ໄດ້ແລ້ວ."

msgid "Reduce number of commits when updating upstream repository."
msgstr "ຫຼຸດຈຳນວນການ Commit ເມື່ອອັບເດດ Upstream repository."

msgid "Fixed possible metadata loss when moving component between projects."
msgstr "ແກ້ໄຂການສູນເສຍ Metadata ທີ່ອາດເກີດຂຶ້ນເມື່ອຍ້າຍອົງປະກອບລະຫວ່າງໂຄງການ."

msgid "Improved navigation in the Zen mode."
msgstr "ປັບປຸງການນຳທາງໃນໂໝດ Zen."

msgid "Added several new quality checks (Markdown related and URL)."
msgstr "ເພີ່ມການກວດສອບຄຸນນະພາບໃໝ່ຫຼາຍຢ່າງ (ທີ່ກ່ຽວຂ້ອງກັບ Markdown ແລະ URL)."

msgid "Added support for app store metadata files."
msgstr "ເພີ່ມການຮອງຮັບໄຟລ໌ Metadata ຂອງ App store."

msgid "Added support for toggling GitHub or Gerrit integration."
msgstr "ເພີ່ມການຮອງຮັບການສະຫຼັບການເຊື່ອມຕໍ່ກັບ GitHub ຫຼື Gerrit."

msgid "Added check for Kashida letters."
msgstr "ເພີ່ມການກວດສອບຕົວອັກສອນ Kashida."

msgid "Added option to squash commits based on authors."
msgstr "ເພີ່ມຕົວເລືອກໃນການລວມ (Squash) Commit ໂດຍອີງຕາມຜູ້ຂຽນ."

msgid "Improved support for XLSX file format."
msgstr "ປັບປຸງການຮອງຮັບຮູບແບບໄຟລ໌ XLSX."

msgid "Compatibility with Tesseract 4.0."
msgstr "ສາມາດໃຊ້ຮ່ວມກັບ Tesseract 4.0 ໄດ້."

msgid "Billing add-on now removes projects for unpaid billings after 45 days."
msgstr "Add-on ການເກັບເງິນຕອນນີ້ຈະລຶບໂຄງການທີ່ບໍ່ໄດ້ຈ່າຍເງິນຫຼັງຈາກ 45 ມື້."

msgid "Weblate 3.4"
msgstr "Weblate 3.4"

msgid "*Released on January 22nd 2019.*"
msgstr "*ອອກວັນທີ 22 ມັງກອນ 2019.*"

msgid "Added support for XLIFF placeholders."
msgstr "ເພີ່ມການຮອງຮັບ Placeholder ຂອງ XLIFF."

msgid "Celery can now utilize multiple task queues."
msgstr "Celery ຕອນນີ້ສາມາດໃຊ້ Task queue ຫຼາຍອັນໄດ້."

msgid "Added support for renaming and moving projects and components."
msgstr "ເພີ່ມການຮອງຮັບການປ່ຽນຊື່ແລະຍ້າຍໂຄງການແລະອົງປະກອບ."

msgid "Include characters counts in reports."
msgstr "ລວມຈຳນວນຕົວອັກສອນໃນລາຍງານ."

msgid ""
"Added guided adding of translation components with automatic detection of "
"translation files."
msgstr "ເພີ່ມການແນະນຳການເພີ່ມອົງປະກອບການແປພ້ອມການກວດສອບໄຟລ໌ການແປໂດຍອັດຕະໂນມັດ."

msgid "Customizable merge commit messages for Git."
msgstr "ສາມາດປັບແຕ່ງຂໍ້ຄວາມ Merge commit ສຳລັບ Git ໄດ້."

msgid "Added visual indication of component alerts in navigation."
msgstr "ເພີ່ມການຊີ້ບອກການແຈ້ງເຕືອນອົງປະກອບໃນເມນູນຳທາງ."

msgid "Improved performance of loading translation files."
msgstr "ປັບປຸງປະສິດທິພາບການໂຫຼດໄຟລ໌ການແປ."

msgid "New add-on to squash commits prior to push."
msgstr "Add-on ໃໝ່ສຳລັບລວມ Commit ກ່ອນ Push."

msgid "Improved displaying of translation changes."
msgstr "ປັບປຸງການສະແດງການປ່ຽນແປງການແປ."

msgid "Changed default merge style to rebase and made that configurable."
msgstr "ປ່ຽນຮູບແບບ Merge ເລີ່ມຕົ້ນເປັນ Rebase ແລະສາມາດຕັ້ງຄ່າໄດ້."

msgid "Better handle private use subtags in language code."
msgstr "ຈັດການ Subtag ການໃຊ້ງານສ່ວນຕົວໃນລະຫັດພາສາໄດ້ດີຂຶ້ນ."

msgid "Improved performance of fulltext index updates."
msgstr "ປັບປຸງປະສິດທິພາບການອັບເດດດັດສະນີ Fulltext."

msgid "Extended file upload API to support more parameters."
msgstr "ຂະຫຍາຍ API ການອັບໂຫຼດໄຟລ໌ໃຫ້ຮອງຮັບພາລາມິເຕີເພີ່ມເຕີມ."

msgid "Weblate 3.3"
msgstr "Weblate 3.3"

msgid "*Released on November 30th 2018.*"
msgstr "*ອອກວັນທີ 30 ພະຈິກ 2018.*"

msgid "Added support for component and project removal."
msgstr "ເພີ່ມການຮອງຮັບການລຶບອົງປະກອບແລະໂຄງການ."

msgid "Improved performance for some monolingual translations."
msgstr "ປັບປຸງປະສິດທິພາບສຳລັບການແປພາສາດຽວບາງຢ່າງ."

msgid ""
"Added translation component alerts to highlight problems with a translation."
msgstr "ເພີ່ມການແຈ້ງເຕືອນອົງປະກອບການແປເພື່ອເນັ້ນບັນຫາການແປ."

msgid "Expose XLIFF string ``resname`` as context when available."
msgstr "ສະແດງ ``resname`` ຂອງຂໍ້ຄວາມ XLIFF ເປັນບໍລິບົດເມື່ອມີໃຫ້."

msgid "Added support for XLIFF states."
msgstr "ເພີ່ມການຮອງຮັບສະຖານະຂອງ XLIFF."

msgid "Added check for non writable files in DATA_DIR."
msgstr "ເພີ່ມການກວດສອບໄຟລ໌ທີ່ຂຽນບໍ່ໄດ້ໃນ DATA_DIR."

msgid "Improved CSV export for changes."
msgstr "ປັບປຸງການສົ່ງອອກ CSV ສຳລັບການປ່ຽນແປງ."

msgid "Weblate 3.2.2"
msgstr "Weblate 3.2.2"

msgid "*Released on October 20th 2018.*"
msgstr "*ອອກວັນທີ 20 ຕຸລາ 2018.*"

msgid "Remove no longer needed Babel dependency."
msgstr "ລຶບ Dependency Babel ທີ່ບໍ່ຈຳເປັນອອກ."

msgid "Updated language definitions."
msgstr "ອັບເດດຄຳນິຍາມພາສາ."

msgid "Improve documentation for add-ons, LDAP and Celery."
msgstr "ປັບປຸງເອກະສານສຳລັບ Add-on, LDAP ແລະ Celery."

msgid "Fixed enabling new dos-eol and auto-java-messageformat flags."
msgstr "ແກ້ໄຂການເປີດໃຊ້ທຸງ dos-eol ແລະ auto-java-messageformat ໃໝ່."

msgid "Fixed running setup.py test from PyPI package."
msgstr "ແກ້ໄຂການເຮັດວຽກ setup.py test ຈາກແພັກເກດ PyPI."

msgid "Improved plurals handling."
msgstr "ປັບປຸງການຈັດການຮູບແບບພົດ."

msgid "Fixed translation upload API failure in some corner cases."
msgstr "ແກ້ໄຂຄວາມລົ້ມເຫຼວຂອງ API ການອັບໂຫຼດການແປໃນບາງກໍລະນີ."

msgid "Fixed updating Git configuration in case it was changed manually."
msgstr "ແກ້ໄຂການອັບເດດການຕັ້ງຄ່າ Git ໃນກໍລະນີທີ່ມີການປ່ຽນແປງດ້ວຍຕົນເອງ."

msgid "Weblate 3.2.1"
msgstr "Weblate 3.2.1"

msgid "*Released on October 10th 2018.*"
msgstr "*ອອກວັນທີ 10 ຕຸລາ 2018.*"

msgid "Document dependency on backports.csv on Python 2.7."
msgstr "ເອກະສານ Dependency ຂອງ backports.csv ໃນ Python 2.7."

msgid "Fix running tests under root."
msgstr "ແກ້ໄຂການທົດສອບພາຍໃຕ້ Root."

msgid "Improved error handling in gitexport module."
msgstr "ປັບປຸງການຈັດການຂໍ້ຜິດພາດໃນໂມດູນ gitexport."

msgid "Fixed progress reporting for newly added languages."
msgstr "ແກ້ໄຂການລາຍງານຄວາມຄືບໜ້າສຳລັບພາສາທີ່ເພີ່ມໃໝ່."

msgid "Correctly report Celery worker errors to Sentry."
msgstr "ລາຍງານຂໍ້ຜິດພາດຂອງ Celery worker ໄປຍັງ Sentry ຢ່າງຖືກຕ້ອງ."

msgid "Fixed creating new translations with Qt Linguist."
msgstr "ແກ້ໄຂການສ້າງການແປໃໝ່ດ້ວຍ Qt Linguist."

msgid "Fixed occasional fulltext index update failures."
msgstr "ແກ້ໄຂຄວາມລົ້ມເຫຼວໃນການອັບເດດດັດສະນີ Fulltext ເປັນບາງຄັ້ງ."

msgid "Improved validation when creating new components."
msgstr "ປັບປຸງການກວດສອບເມື່ອສ້າງອົງປະກອບໃໝ່."

msgid "Added support for cleanup of old suggestions."
msgstr "ເພີ່ມການຮອງຮັບການລ້າງຄຳແນະນຳເກົ່າ."

msgid "Weblate 3.2"
msgstr "Weblate 3.2"

msgid "*Released on October 6th 2018.*"
msgstr "*ອອກວັນທີ 6 ຕຸລາ 2018.*"

msgid "Add install_addon management command for automated add-on installation."
msgstr "ເພີ່ມຄຳສັ່ງຈັດການ install_addon ສຳລັບການຕິດຕັ້ງ Add-on ອັດຕະໂນມັດ."

msgid "Allow more fine grained :ref:`rate-limit` settings."
msgstr "ອະນຸຍາດໃຫ້ຕັ້ງຄ່າ :ref:`rate-limit` ທີ່ລະອຽດຂຶ້ນ."

msgid "Added support for export and import of Excel files."
msgstr "ເພີ່ມການຮອງຮັບການສົ່ງອອກແລະນຳເຂົ້າໄຟລ໌ Excel."

msgid ""
"Improve component cleanup in case of multiple component discovery add-ons."
msgstr "ປັບປຸງການລ້າງຂໍ້ມູນອົງປະກອບໃນກໍລະນີທີ່ມີ Add-on ຄົ້ນຫາອົງປະກອບຫຼາຍອັນ."

msgid "Rewritten Microsoft Terminology machine translation backend."
msgstr "ຂຽນ Backend ການແປພາສາດ້ວຍເຄື່ອງ Microsoft Terminology ໃໝ່."

msgid "Weblate now uses Celery to offload some processing."
msgstr "Weblate ຕອນນີ້ໃຊ້ Celery ເພື່ອແບ່ງເບົາການປະມວນຜົນບາງຢ່າງ."

msgid "Improved search capabilities and added regular expression search."
msgstr "ປັບປຸງຄວາມສາມາດໃນການຄົ້ນຫາແລະເພີ່ມການຄົ້ນຫາແບບ Regular expression."

msgid "Added support for Youdao Zhiyun API machine translation."
msgstr "ເພີ່ມການຮອງຮັບການແປພາສາດ້ວຍເຄື່ອງ Youdao Zhiyun API."

msgid "Added support for Baidu API machine translation."
msgstr "ເພີ່ມການຮອງຮັບການແປພາສາດ້ວຍເຄື່ອງ Baidu API."

msgid "Integrated maintenance and cleanup tasks using Celery."
msgstr "ລວມວຽກງານບຳລຸງຮັກສາແລະລ້າງຂໍ້ມູນໂດຍໃຊ້ Celery."

msgid "Improved performance of loading translations by almost 25%."
msgstr "ປັບປຸງປະສິດທິພາບການໂຫຼດການແປຂຶ້ນເກືອບ 25%."

msgid "Removed support for merging headers on upload."
msgstr "ລຶບການຮອງຮັບການ Merge header ຕອນອັບໂຫຼດ."

msgid "Removed support for custom commit messages."
msgstr "ລຶບການຮອງຮັບຂໍ້ຄວາມ Commit ແບບກຳນົດເອງ."

msgid "Configurable editing mode (zen/full)."
msgstr "ໂໝດການແກ້ໄຂທີ່ຕັ້ງຄ່າໄດ້ (zen/full)."

msgid "Added support for error reporting to Sentry."
msgstr "ເພີ່ມການຮອງຮັບການລາຍງານຂໍ້ຜິດພາດຫາ Sentry."

msgid "Added support for automated daily update of repositories."
msgstr "ເພີ່ມການຮອງຮັບການອັບເດດ Repository ປະຈຳວັນແບບອັດຕະໂນມັດ."

msgid "Added support for creating projects and components by users."
msgstr "ເພີ່ມການຮອງຮັບໃຫ້ຜູ້ໃຊ້ສ້າງໂຄງການແລະອົງປະກອບໄດ້."

msgid "Built-in translation memory now automatically stores translations done."
msgstr "ໜ່ວຍຄວາມຈຳການແປທີ່ມີມາໃຫ້ຕອນນີ້ຈັດເກັບການແປທີ່ເຮັດສຳເລັດໂດຍອັດຕະໂນມັດ."

msgid "Users and projects can import their existing translation memories."
msgstr "ຜູ້ໃຊ້ແລະໂຄງການສາມາດນຳເຂົ້າໜ່ວຍຄວາມຈຳການແປທີ່ມີຢູ່ຂອງຕົນເອງໄດ້."

msgid "Better management of related strings for screenshots."
msgstr "ຈັດການຂໍ້ຄວາມທີ່ກ່ຽວຂ້ອງສຳລັບຮູບພາບໜ້າຈໍໄດ້ດີຂຶ້ນ."

msgid "Added support for checking Java MessageFormat."
msgstr "ເພີ່ມການຮອງຮັບການກວດສອບ Java MessageFormat."

msgid ""
"See `3.2 milestone on GitHub <https://github.com/WeblateOrg/weblate/"
"milestone/36?closed=1>`_ for detailed list of addressed issues."
msgstr ""
"ເບິ່ງ `3.2 milestone on GitHub <https://github.com/WeblateOrg/weblate/"
"milestone/36?closed=1>`_ ສຳລັບລາຍລະອຽດຂອງບັນຫາທີ່ຖືກແກ້ໄຂ."

msgid "Weblate 3.1.1"
msgstr "Weblate 3.1.1"

msgid "*Released on July 27th 2018.*"
msgstr "*ອອກວັນທີ 27 ກໍລະກົດ 2018.*"

msgid "Fix testsuite failure on some setups."
msgstr "ແກ້ໄຂຄວາມລົ້ມເຫຼວຂອງ Testsuite ໃນບາງການຕັ້ງຄ່າ."

msgid "Weblate 3.1"
msgstr "Weblate 3.1"

msgid "Upgrades from older version than 3.0.1 are not supported."
msgstr "ບໍ່ຮອງຮັບການອັບເກຣດຈາກເວີຊັນທີ່ເກົ່າກວ່າ 3.0.1."

msgid "Allow to override default commit messages from settings."
msgstr "ອະນຸຍາດໃຫ້ແທນທີ່ຂໍ້ຄວາມ Commit ເລີ່ມຕົ້ນຈາກການຕັ້ງຄ່າ."

msgid "Improve webhooks compatibility with self hosted environments."
msgstr "ປັບປຸງຄວາມເຂົ້າກັນໄດ້ຂອງ Webhook ກັບສະພາບແວດລ້ອມທີ່ໂຮສເອງ."

msgid "Added support for Amazon Translate."
msgstr "ເພີ່ມການຮອງຮັບ Amazon Translate."

msgid "Compatibility with Django 2.1."
msgstr "ສາມາດໃຊ້ຮ່ວມກັບ Django 2.1 ໄດ້."

msgid ""
"Django system checks are now used to diagnose problems with installation."
msgstr "ຕອນນີ້ໃຊ້ Django system check ເພື່ອວິນິດໄສບັນຫາການຕິດຕັ້ງ."

msgid "Removed support for soon shutdown libravatar service."
msgstr "ລຶບການຮອງຮັບບໍລິການ libravatar ທີ່ກຳລັງຈະປິດຕົວລົງ."

msgid "New add-on to mark unchanged translations as needing edit."
msgstr "Add-on ໃໝ່ສຳລັບໝາຍການແປທີ່ບໍ່ມີການປ່ຽນແປງວ່າຕ້ອງການການແກ້ໄຂ."

msgid "Add support for jumping to specific location while translating."
msgstr "ເພີ່ມການຮອງຮັບການໂດດໄປຍັງຕຳແໜ່ງສະເພາະໃນຂະນະແປ."

msgid "Downloaded translations can now be customized."
msgstr "ຕອນນີ້ສາມາດປັບແຕ່ງການແປທີ່ດາວໂຫຼດໄດ້."

msgid ""
"Improved calculation of string similarity in translation memory matches."
msgstr "ປັບປຸງການຄິດໄລ່ຄວາມຄ້າຍຄືກັນຂອງຂໍ້ຄວາມໃນການຈັບຄູ່ໜ່ວຍຄວາມຈຳການແປ."

msgid "Added support by signing Git commits by GnuPG."
msgstr "ເພີ່ມການຮອງຮັບການເຊັນ Git commit ດ້ວຍ GnuPG."

msgid "Weblate 3.0.1"
msgstr "Weblate 3.0.1"

msgid "*Released on June 10th 2018.*"
msgstr "*ອອກວັນທີ 10 ມິຖຸນາ 2018.*"

msgid "Fixed possible migration issue from 2.20."
msgstr "ແກ້ໄຂບັນຫາການຍ້າຍຂໍ້ມູນທີ່ອາດເກີດຂຶ້ນຈາກ 2.20."

msgid "Removed obsolete hook examples."
msgstr "ລຶບຕົວຢ່າງ Hook ທີ່ລ້າສະໄໝອອກ."

msgid "Improved caching documentation."
msgstr "ປັບປຸງເອກະສານການແຄດ (Caching)."

msgid "Fixed displaying of admin documentation."
msgstr "ແກ້ໄຂການສະແດງເອກະສານສຳລັບຜູ້ດູແລ."

msgid "Improved handling of long language names."
msgstr "ປັບປຸງການຈັດການຊື່ພາສາທີ່ຍາວ."

msgid "Weblate 3.0"
msgstr "Weblate 3.0"

msgid "*Released on June 1st 2018.*"
msgstr "*ອອກວັນທີ 1 ມິຖຸນາ 2018.*"

msgid "Rewritten access control."
msgstr "ຂຽນການຄວບຄຸມການເຂົ້າເຖິງໃໝ່."

msgid "Several code cleanups that lead to moved and renamed modules."
msgstr "ການລ້າງໂຄ້ດຫຼາຍຢ່າງທີ່ນຳໄປສູ່ການຍ້າຍແລະປ່ຽນຊື່ໂມດູນ."

msgid "New add-on for automatic component discovery."
msgstr "Add-on ໃໝ່ສຳລັບການຄົ້ນຫາອົງປະກອບອັດຕະໂນມັດ."

msgid ""
"The import_project management command has now slightly different parameters."
msgstr "ຄຳສັ່ງຈັດການ import_project ຕອນນີ້ມີພາລາມິເຕີທີ່ແຕກຕ່າງກັນເລັກນ້ອຍ."

msgid "Added basic support for Windows RC files."
msgstr "ເພີ່ມການຮອງຮັບພື້ນຖານສຳລັບໄຟລ໌ Windows RC."

msgid "New add-on to store contributor names in PO file headers."
msgstr "Add-on ໃໝ່ເພື່ອເກັບຊື່ຜູ້ປະກອບສ່ວນໃນ Header ຂອງໄຟລ໌ PO."

msgid "The per component hook scripts are removed, use add-ons instead."
msgstr "ສະຄຣິບ Hook ແຕ່ລະອົງປະກອບຖືກລຶບອອກ, ໃຫ້ໃຊ້ Add-on ແທນ."

msgid "Add support for collecting contributor agreements."
msgstr "ເພີ່ມການຮອງຮັບການເກັບຂໍ້ຕົກລົງຜູ້ປະກອບສ່ວນ."

msgid "Access control changes are now tracked in history."
msgstr "ການປ່ຽນແປງການຄວບຄຸມການເຂົ້າເຖິງຈະຖືກຕິດຕາມໃນປະຫວັດ."

msgid ""
"New add-on to ensure all components in a project have same translations."
msgstr "Add-on ໃໝ່ເພື່ອຮັບປະກັນວ່າທຸກອົງປະກອບໃນໂຄງການມີການແປດຽວກັນ."

msgid "Support for more variables in commit message templates."
msgstr "ຮອງຮັບຕົວແປເພີ່ມເຕີມໃນ Template ຂໍ້ຄວາມ Commit."

msgid "Add support for providing additional textual context."
msgstr "ເພີ່ມການຮອງຮັບການສະໜອງບໍລິບົດຂໍ້ຄວາມເພີ່ມເຕີມ."

msgid "Weblate 4.x series"
msgstr "Weblate ຊຸດ 4.x"

msgid "Weblate 4.18.2"
msgstr "Weblate 4.18.2"

msgid "*Released on June 30th 2023.*"
msgstr "*ອອກວັນທີ 30 ມິຖຸນາ 2023.*"

msgid "Fixed parsing notes from TBX."
msgstr "ແກ້ໄຂການແຍກວິເຄາະໝາຍເຫດຈາກ TBX."

msgid "Fixed query parsing in navigation bar search."
msgstr "ແກ້ໄຂການແຍກວິເຄາະ Query ໃນການຄົ້ນຫາແຖບນຳທາງ."

msgid "Fixed language filtering in reports."
msgstr "ແກ້ໄຂການກັ່ນຕອງພາສາໃນລາຍງານ."

msgid "Improved ModernMT languages mapping."
msgstr "ປັບປຸງການ Map ພາສາຂອງ ModernMT."

msgid "Disabled reused checks on languages with a single plural form."
msgstr "ປິດໃຊ້ງານການກວດສອບການໃຊ້ຊ້ຳໃນພາສາທີ່ມີຮູບແບບພົດດຽວ."

msgid ""
"`All changes in detail <https://github.com/WeblateOrg/weblate/milestone/102?"
"closed=1>`__."
msgstr ""
"`ລາຍລະອຽດການປ່ຽນແປງທັງໝົດ <https://github.com/WeblateOrg/weblate/milestone/102?"
"closed=1>`__."

msgid "Weblate 4.18.1"
msgstr "Weblate 4.18.1"

msgid "*Released on June 16th 2023.*"
msgstr "*ອອກວັນທີ 16 ມິຖຸນາ 2023.*"

msgid "Fixed language code format for i18next."
msgstr "ແກ້ໄຂຮູບແບບລະຫັດພາສາສຳລັບ i18next."

msgid "Fixed CSS compression with dark theme."
msgstr "ແກ້ໄຂການບີບອັດ CSS ດ້ວຍຮູບແບບສີມືດ (Dark theme)."

msgid ""
"`All changes in detail <https://github.com/WeblateOrg/weblate/milestone/101?"
"closed=1>`__."
msgstr ""
"`ລາຍລະອຽດການປ່ຽນແປງທັງໝົດ <https://github.com/WeblateOrg/weblate/milestone/101?"
"closed=1>`__."

msgid "Weblate 4.18"
msgstr "Weblate 4.18"

msgid "*Released on June 15th 2023.*"
msgstr "*ອອກວັນທີ 15 ມິຖຸນາ 2023.*"

msgid "Improved API error messages on permission denied."
msgstr "ປັບປຸງຂໍ້ຄວາມຂໍ້ຜິດພາດຂອງ API ເມື່ອຖືກປະຕິເສດສິດ."

msgid "Reduced false positives of the XML checks."
msgstr "ຫຼຸດຜ່ອນການກວດສອບ XML ທີ່ຜິດພາດ (False positives)."

msgid "Translated check accuracy has been improved."
msgstr "ປັບປຸງຄວາມຖືກຕ້ອງຂອງການກວດສອບການແປ."

msgid "Extended support for Fluent file format."
msgstr "ຂະຫຍາຍການຮອງຮັບຮູບແບບໄຟລ໌ Fluent."

msgid "Avoiding signing-out user in some rate-limits."
msgstr "ຫຼີກເວັ້ນການລັອກເອົາຜູ້ໃຊ້ໃນບາງກໍລະນີທີ່ຖືກຈຳກັດອັດຕາ."

msgid "Added support for storing glossary explanation in TBX format."
msgstr "ເພີ່ມການຮອງຮັບການຈັດເກັບຄຳອະທິບາຍຄຳສັບໃນຮູບແບບ TBX."

msgid "Added support for ordering strings by last update."
msgstr "ເພີ່ມການຮອງຮັບການຈັດລຽງຂໍ້ຄວາມຕາມການອັບເດດຫຼ້າສຸດ."

msgid "Extended search capabilities for finding users."
msgstr "ຂະຫຍາຍຄວາມສາມາດໃນການຄົ້ນຫາຜູ້ໃຊ້."

msgid "Support for automatic update of screenshots from a repository."
msgstr "ຮອງຮັບການອັບເດດຮູບພາບໜ້າຈໍຈາກ Repository ໂດຍອັດຕະໂນມັດ."

msgid "Improved translation memory performance."
msgstr "ປັບປຸງປະສິດທິພາບໜ່ວຍຄວາມຈຳການແປ."

msgid ""
"Project stats exports to JSON/CSV now include more details; it now matches "
"content available in the API."
msgstr ""
"ການສົ່ງອອກສະຖິຕິໂຄງການເປັນ JSON/CSV ຕອນນີ້ມີລາຍລະອຽດເພີ່ມຂຶ້ນ; ຕອນນີ້ມັນກົງກັບເນື້ອຫາທີ່ມີໃນ API."

msgid "Added check for reused translation."
msgstr "ເພີ່ມການກວດສອບສຳລັບການແປທີ່ໃຊ້ຊ້ຳ."

msgid "Highlight suggested change in automatic suggestions."
msgstr "ເນັ້ນການປ່ຽນແປງທີ່ແນະນຳໃນຄຳແນະນຳອັດຕະໂນມັດ."

msgid "Added dark theme; browser-following and manual setting are available."
msgstr "ເພີ່ມຮູບແບບສີມືດ (Dark theme); ມີໃຫ້ເລືອກຕາມ Browser ແລະຕັ້ງຄ່າດ້ວຍຕົນເອງ."

msgid "The Docker container can now be used with read-only root filesystem."
msgstr "Docker container ຕອນນີ້ສາມາດໃຊ້ກັບ Read-only root filesystem ໄດ້ແລ້ວ."

msgid "Added username autocompletion when adding users to a project."
msgstr "ເພີ່ມການຕື່ມຊື່ຜູ້ໃຊ້ໂດຍອັດຕະໂນມັດເມື່ອເພີ່ມຜູ້ໃຊ້ເຂົ້າໃນໂຄງການ."

msgid "Added site-wide search for projects, components, languages and users."
msgstr "ເພີ່ມການຄົ້ນຫາທັງເວັບໄຊສຳລັບໂຄງການ, ອົງປະກອບ, ພາສາ ແລະ ຜູ້ໃຊ້."

msgid "New add-on Fill read-only strings with source."
msgstr "Add-on ໃໝ່ Fill read-only strings with source."

msgid ""
"`All changes in detail <https://github.com/WeblateOrg/weblate/milestone/97?"
"closed=1>`__."
msgstr ""
"`ລາຍລະອຽດການປ່ຽນແປງທັງໝົດ <https://github.com/WeblateOrg/weblate/milestone/97?"
"closed=1>`__."

msgid ""
"Dropped support for PostgreSQL 10, 11, MySQL 5.7 and MariaDB 10.2, 10.3."
msgstr "ຢຸດການຮອງຮັບ PostgreSQL 10, 11, MySQL 5.7 ແລະ MariaDB 10.2, 10.3."

msgid "Dropped support for Python 3.7."
msgstr "ຢຸດການຮອງຮັບ Python 3.7."

msgid ""
"The :ref:`fluent` format changed identification of some strings, you might "
"need to force reloading of the translation files to see the changes."
msgstr ""
"ຮູບແບບ :ref:`fluent` ໄດ້ປ່ຽນແປງການລະບຸຂໍ້ຄວາມບາງຢ່າງ, "
"ທ່ານອາດຕ້ອງບັງຄັບໂຫຼດໄຟລ໌ການແປໃໝ່ເພື່ອເບິ່ງການປ່ຽນແປງ."

msgid ""
"There are several changes in :file:`settings_example.py`, most notable is "
"change in ``COMPRESS_OFFLINE_CONTEXT``, please adjust your settings "
"accordingly."
msgstr ""
"ມີການປ່ຽນແປງຫຼາຍຢ່າງໃນ :file:`settings_example.py`, ສິ່ງທີ່ສຳຄັນທີ່ສຸດແມ່ນການປ່ຽນແປງໃນ "
"``COMPRESS_OFFLINE_CONTEXT``, ກະລຸນາປັບການຕັ້ງຄ່າຂອງທ່ານໃຫ້ສອດຄ່ອງ."

msgid "Weblate 4.17"
msgstr "Weblate 4.17"

msgid "*Released on April 17th 2023.*"
msgstr "*ອອກວັນທີ 17 ເມສາ 2023.*"

msgid "Allow to filter on language in reports."
msgstr "ອະນຸຍາດໃຫ້ກັ່ນຕອງພາສາໃນລາຍງານ."

msgid "Dropped deprecated command ``cleanup_celery``."
msgstr "ລຶບຄຳສັ່ງທີ່ບໍ່ແນະນຳໃຫ້ໃຊ້ ``cleanup_celery`` ອອກ."

msgid "Fixed private project visibility for some teams."
msgstr "ແກ້ໄຂການເບິ່ງເຫັນໂຄງການສ່ວນຕົວສຳລັບບາງທີມ."

msgid ""
"Automatic translation now honors target state when translating from other "
"components."
msgstr "ການແປອັດຕະໂນມັດຕອນນີ້ຈະຮັກສາສະຖານະເປົ້າໝາຍເມື່ອແປຈາກອົງປະກອບອື່ນ."

msgid "Improved performance of public user profiles."
msgstr "ປັບປຸງປະສິດທິພາບຂອງໂປຣໄຟລ໌ຜູ້ໃຊ້ສາທາລະນະ."

msgid "Improved Sentry performance monitoring integration."
msgstr "ປັບປຸງການເຊື່ອມຕໍ່ການຕິດຕາມປະສິດທິພາບ Sentry."

msgid "Added support for Ed25519 SSH key."
msgstr "ເພີ່ມການຮອງຮັບຄີ SSH ແບບ Ed25519."

msgid "Rewritten metrics storage."
msgstr "ຂຽນການຈັດເກັບ Metrics ໃໝ່."

msgid "Added support for searching strings by position."
msgstr "ເພີ່ມການຮອງຮັບການຄົ້ນຫາຂໍ້ຄວາມຕາມຕຳແໜ່ງ."

msgid ""
"Unchanged translation check can honor untranslatable terms from glossary."
msgstr "ການກວດສອບການແປທີ່ບໍ່ປ່ຽນແປງສາມາດຮັກສາຄຳສັບທີ່ແປບໍ່ໄດ້ຈາກ Glossary."

msgid "Added automatic fixup for Devanagari danda."
msgstr "ເພີ່ມການແກ້ໄຂອັດຕະໂນມັດສຳລັບ Devanagari danda."

msgid "Allow downloading project translation memory per language."
msgstr "ອະນຸຍາດໃຫ້ດາວໂຫຼດໜ່ວຍຄວາມຈຳການແປຂອງໂຄງການຕາມພາສາ."

msgid "Added new alert on unused components."
msgstr "ເພີ່ມການແຈ້ງເຕືອນໃໝ່ສຳລັບອົງປະກອບທີ່ບໍ່ໄດ້ໃຊ້."

msgid ""
"`All changes in detail <https://github.com/WeblateOrg/weblate/milestone/93?"
"closed=1>`__."
msgstr ""
"`ລາຍລະອຽດການປ່ຽນແປງທັງໝົດ <https://github.com/WeblateOrg/weblate/milestone/93?"
"closed=1>`__."

msgid ""
"Migration to rewritten metrics storage might take considerable time on "
"larger Weblate instance (expect around 15 minutes per GB of "
"``metrics_metric`` table). To reduce downtime, you can copy :file:`weblate/"
"metrics/migrations/*.py` from Weblate 4.17 to 4.16 and start the migration "
"in the background. Once it is completed, perform full upgrade as usual."
msgstr ""
"ການຍ້າຍຂໍ້ມູນໄປຍັງການຈັດເກັບ Metrics ແບບໃໝ່ອາດໃຊ້ເວລາດົນໃນ Instance Weblate ຂະໜາດໃຫຍ່ "
"(ຄາດວ່າປະມານ 15 ນາທີຕໍ່ GB ຂອງຕາຕະລາງ ``metrics_metric``). ເພື່ອຫຼຸດເວລາ Downtime, "
"ທ່ານສາມາດຄັດລອກ :file:`weblate/metrics/migrations/*.py` ຈາກ Weblate 4.17 ໄປ "
"4.16 ແລະເລີ່ມການຍ້າຍຂໍ້ມູນໃນພື້ນຫຼັງ. ເມື່ອສຳເລັດ, ໃຫ້ດຳເນີນການອັບເກຣດເຕັມຮູບແບບຕາມປົກກະຕິ."

msgid ""
"Docker container now requires PostgreSQL 12 or newer, please "
"see :ref:`docker-postgres-upgrade` for upgrade instructions. Weblate itself "
"supports older versions as well, when appropriate Django version is "
"installed."
msgstr ""
"Docker container ຕອນນີ້ຕ້ອງການ PostgreSQL 12 ຫຼື ໃໝ່ກວ່າ, ກະລຸນາເບິ່ງ :ref:`docker-"
"postgres-upgrade` ສຳລັບຄຳແນະນຳການອັບເກຣດ. ຕົວ Weblate ເອງຮອງຮັບເວີຊັນທີ່ເກົ່າກວ່າດ້ວຍ, "
"ເມື່ອຕິດຕັ້ງ Django ເວີຊັນທີ່ເໝາະສົມ."

msgid ""
"Migration on MySQL will try to load all metrics into memory due to "
"limitation of the Python database driver. You might need to prune metrics "
"prior to migration if you want to continue using MySQL. Please consider "
"switching to PostgreSQL, see :ref:`database-migration`."
msgstr ""
"ການຍ້າຍຂໍ້ມູນໃນ MySQL ຈະພະຍາຍາມໂຫຼດ Metrics ທັງໝົດເຂົ້າໃນໜ່ວຍຄວາມຈຳເນື່ອງຈາກຂໍ້ຈຳກັດຂອງ "
"Python database driver. ທ່ານອາດຕ້ອງລຶບ Metrics ອອກກ່ອນການຍ້າຍຂໍ້ມູນຖ້າທ່ານຕ້ອງການໃຊ້ "
"MySQL ຕໍ່ໄປ. ກະລຸນາພິຈາລະນາປ່ຽນໄປໃຊ້ PostgreSQL, ເບິ່ງ :ref:`database-migration`."

msgid "Weblate 4.16.4"
msgstr "Weblate 4.16.4"

msgid "*Released on March 16th 2023.*"
msgstr "*ອອກວັນທີ 16 ມີນາ 2023.*"

msgid "Dependencies updates."
msgstr "ອັບເດດ Dependencies."

msgid "Improved background tasks scheduling."
msgstr "ປັບປຸງການຈັດຕາຕະລາງວຽກໃນພື້ນຫຼັງ."

msgid ""
"`All changes in detail <https://github.com/WeblateOrg/weblate/milestone/96?"
