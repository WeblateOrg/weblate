msgid "Performs translation using `OpenAI`_."
msgstr "ແປພາສາໂດຍໃຊ້ `OpenAI`_."

msgid ""
"The OpenAI API is powered by a diverse set of models with different "
"capabilities and price points. Automatic selection chooses the best model "
"available, but you might want to choose a specific model that matches your "
"needs."
msgstr ""
"OpenAI API ເຮັດວຽກດ້ວຍຊຸດໂມເດວທີ່ຫຼາກຫຼາຍ ເຊິ່ງມີຄວາມສາມາດ ແລະ ລາຄາທີ່ແຕກຕ່າງກັນ. "
"ການເລືອກອັດຕະໂນມັດຈະເລືອກໂມເດວທີ່ດີທີ່ສຸດທີ່ມີຢູ່, ແຕ່ທ່ານອາດຈະຕ້ອງການເລືອກໂມເດວສະເພາະ "
"ທີ່ກົງກັບຄວາມຕ້ອງການຂອງທ່ານ."

msgid ""
"Automatic and predefined model selection queries the service model-listing "
"endpoint. Automatic selection prefers current general-purpose models that "
"balance translation quality, response time, and price, using older GPT "
"models only as compatibility fallbacks. Choose :guilabel:`Custom model` when "
"using an OpenAI-compatible gateway that does not provide model discovery; "
"Weblate sends the configured model identifier directly to the chat "
"completions endpoint."
msgstr ""

msgid ""
"Use persona and style fields to further fine-tune translations. These will "
"be used in a prompt for OpenAI and allow you to change the style of the "
"translations."
msgstr ""
"ໃຊ້ຊ່ອງບຸກຄະລິກ (persona) ແລະ ຮູບແບບ (style) ເພື່ອປັບແຕ່ງການແປໃຫ້ລະອຽດຕື່ມ. "
"ສິ່ງເຫຼົ່ານີ້ຈະຖືກໃຊ້ໃນຄຳສັ່ງ (prompt) ສຳລັບ OpenAI ແລະ ຊ່ວຍໃຫ້ທ່ານສາມາດປ່ຽນຮູບແບບການແປໄດ້."

msgid "Support for custom model and base URL was added."
msgstr "ເພີ່ມການຮອງຮັບໂມເດວທີ່ກຳນົດເອງ ແລະ base URL ແລ້ວ."

msgid "`OpenAI models <https://platform.openai.com/docs/models>`_"
msgstr "`ໂມເດວ OpenAI <https://platform.openai.com/docs/models>`_"

msgid "`OpenAI API keys <https://platform.openai.com/api-keys>`_"
msgstr "`ຄີ OpenAI API <https://platform.openai.com/api-keys>`_"

msgid "SAP username"
msgstr "ຊື່ຜູ້ໃຊ້ SAP"

msgid "SAP password"
msgstr "ລະຫັດຜ່ານ SAP"

msgid "Enable machine translation"
msgstr "ເປີດໃຊ້ງານການແປດ້ວຍເຄື່ອງ"

msgid "Translation domain"
msgstr "ໂດເມນການແປ"

msgid ""
"The ID of a translation domain, for example, BC. If you do not specify a "
"domain, the method searches for translations in all available domains."
msgstr ""
"ID ຂອງໂດເມນການແປ, ຕົວຢ່າງ: BC. ຖ້າທ່ານບໍ່ລະບຸໂດເມນ, ລະບົບຈະຄົ້ນຫາການແປໃນທຸກໂດເມນທີ່ມີຢູ່."

msgid "Machine translation service provided by SAP."
msgstr "ບໍລິການການແປດ້ວຍເຄື່ອງທີ່ໃຫ້ໂດຍ SAP."

msgid ""
"You need to have a SAP account (and the SAP Translation Hub enabled in the "
"SAP Cloud Platform) to use this service."
msgstr ""
"ທ່ານຈຳເປັນຕ້ອງມີບັນຊີ SAP (ແລະ ເປີດໃຊ້ງານ SAP Translation Hub ໃນ SAP Cloud Platform) "
"ເພື່ອໃຊ້ບໍລິການນີ້."

msgid ""
"You can also configure whether to also use machine translation services, in "
"addition to the term database."
msgstr "ທ່ານຍັງສາມາດຕັ້ງຄ່າວ່າຈະໃຊ້ບໍລິການການແປດ້ວຍເຄື່ອງຫຼືບໍ່, ນອກເໜືອໄປຈາກຖານຂໍ້ມູນຄຳສັບ."

msgid "To access the Sandbox API, you need to set ``url`` and ``key``."
msgstr "ເພື່ອເຂົ້າເຖິງ Sandbox API, ທ່ານຈຳເປັນຕ້ອງຕັ້ງຄ່າ ``url`` ແລະ ``key``."

msgid ""
"To access the productive API, you need to set ``url``, ``username`` and "
"``password``."
msgstr ""
"ເພື່ອເຂົ້າເຖິງ API ຕົວຈິງ, ທ່ານຈຳເປັນຕ້ອງຕັ້ງຄ່າ ``url``, ``username`` ແລະ ``password``."

msgid ""
"`What is SAP Translation Hub <https://help.sap.com/docs/translation-hub/sap-"
"translation-hub/what-is-sap-translation-hub>`_"
msgstr ""
"`SAP Translation Hub ແມ່ນຫຍັງ <https://help.sap.com/docs/translation-hub/sap-"
"translation-hub/what-is-sap-translation-hub>`_"

msgid ""
"`SAP Translation Hub API <https://api.sap.com/api/translationhub/overview>`_"
msgstr ""
"`SAP Translation Hub API <https://api.sap.com/api/translationhub/overview>`_"

msgid "Machine translation service provided by Systran."
msgstr "ບໍລິການການແປດ້ວຍເຄື່ອງທີ່ໃຫ້ໂດຍ Systran."

msgid ""
"This service uses an API, and you need to obtain API key at <https://"
"translate.systran.net/en/account>."
msgstr ""
"ບໍລິການນີ້ໃຊ້ API, ແລະ ທ່ານຈຳເປັນຕ້ອງຂໍຄີ API ທີ່ <https://translate.systran.net/en/"
"account>."

msgid ""
"You can run your own translation memory server by using a tmserver protocol."
msgstr "ທ່ານສາມາດເປີດເຊີເວີໜ່ວຍຄວາມຈຳການແປຂອງທ່ານເອງໄດ້ໂດຍການໃຊ້ໂປຣໂຕຄອນ tmserver."

msgid ""
"The original :program:`tmserver` was bundled with the translate-toolkit."
msgstr "ໂປຣແກຣມ :program:`tmserver` ດັ້ງເດີມແມ່ນຖືກລວມມາກັບ translate-toolkit."

msgid "amaGama server is an enhanced version of tmserver."
msgstr "ເຊີເວີ amaGama ແມ່ນລຸ້ນທີ່ຖືກພັດທະນາໃຫ້ດີຂຶ້ນຂອງ tmserver."

msgid "There currently does not seem to be a maintained server for this."
msgstr "ໃນປັດຈຸບັນ ເບິ່ງຄືວ່າຈະບໍ່ມີເຊີເວີທີ່ຖືກເບິ່ງແຍງຮັກສາສຳລັບສິ່ງນີ້."

msgid "`This service has no configuration.`"
msgstr "`ບໍລິການນີ້ບໍ່ມີການຕັ້ງຄ່າ.`"

msgid ""
"Weblate machine translation service can provide translations based on the "
"exact matches of a string in the currently existing strings in "
"a :guilabel:`Translated`, :guilabel:`Approved`, or :guilabel:`Read-"
"only` :ref:`states <states>` inside Weblate."
msgstr ""
"ບໍລິການການແປດ້ວຍເຄື່ອງຂອງ Weblate ສາມາດໃຫ້ການແປໂດຍອີງໃສ່ຂໍ້ຄວາມທີ່ກົງກັນທຸກປະການ "
"ຈາກຂໍ້ຄວາມທີ່ມີຢູ່ໃນປັດຈຸບັນໃນສະຖານະ :guilabel:`ແປແລ້ວ`, :guilabel:`ອະນຸມັດແລ້ວ`, "
"ຫຼື :guilabel:`ອ່ານຢ່າງດຽວ` :ref:`states <states>` ພາຍໃນ Weblate."

msgid ""
"Use :ref:`translation-memory` as a machine translation service. Any string "
"that has been translated before (or uploaded to the translation memory) can "
"be translated in this way. This suggestion source works with fuzzy matching."
msgstr ""
"ໃຊ້ :ref:`translation-memory` ເປັນບໍລິການການແປດ້ວຍເຄື່ອງ. ທຸກຂໍ້ຄວາມທີ່ເຄີຍຖືກແປມາກ່ອນ (ຫຼື "
"ຖືກອັບໂຫຼດໄປຍັງໜ່ວຍຄວາມຈຳການແປ) ສາມາດແປໄດ້ດ້ວຍວິທີນີ້. ແຫຼ່ງຄຳແນະນຳນີ້ເຮັດວຽກດ້ວຍການຈັບຄູ່ແບບຟັດຊີ "
"(fuzzy matching)."

msgid ""
"Recreating :ref:`translation-memory` reduces capabilities of this TM source."
msgstr "ການສ້າງ :ref:`translation-memory` ໃໝ່ຈະຫຼຸດຄວາມສາມາດຂອງແຫຼ່ງຂໍ້ມູນ TM ນີ້."

msgid "Machine translation service provided by Yandex."
msgstr "ບໍລິການການແປດ້ວຍເຄື່ອງທີ່ໃຫ້ໂດຍ Yandex."

msgid ""
"This service uses a Translation API, and you need to obtain an API key from "
"Yandex."
msgstr "ບໍລິການນີ້ໃຊ້ Translation API, ແລະ ທ່ານຈຳເປັນຕ້ອງຂໍຄີ API ຈາກ Yandex."

msgid "`Yandex Translate API <https://yandex.com/dev/translate/>`_"
msgstr "`Yandex Translate API <https://yandex.com/dev/translate/>`_"

msgid ""
"This service uses a Translation API, and you need to obtain an API key from "
"Yandex Cloud."
msgstr "ບໍລິການນີ້ໃຊ້ Translation API, ແລະ ທ່ານຈຳເປັນຕ້ອງຂໍຄີ API ຈາກ Yandex Cloud."

msgid ""
"`Yandex Translate API v2 <https://aistudio.yandex.ru/docs/en/translate/api-"
"ref/authentication.html>`_"
msgstr ""
"`Yandex Translate API v2 <https://aistudio.yandex.ru/docs/en/translate/api-"
"ref/authentication.html>`_"

msgid "Machine translation service provided by Youdao."
