"ມີຂະໜາດໃຫຍ່ພຽງພໍສຳລັບໄຟລ໌ສຳຮອງຂໍ້ມູນທີ່ອັບໂຫຼດ."

msgid "Configures :setting:`PROJECT_BACKUP_IMPORT_MAX_MEMBERS`."
msgstr "ຕັ້ງຄ່າ :setting:`PROJECT_BACKUP_IMPORT_MAX_MEMBERS`."

msgid "Configures :setting:`PROJECT_BACKUP_IMPORT_MAX_TOTAL_UNCOMPRESSED_SIZE`."
msgstr "ຕັ້ງຄ່າ :setting:`PROJECT_BACKUP_IMPORT_MAX_TOTAL_UNCOMPRESSED_SIZE`."

msgid "Configures :setting:`PROJECT_BACKUP_IMPORT_MAX_COMPRESSED_ENTRY_SIZE`."
msgstr "ຕັ້ງຄ່າ :setting:`PROJECT_BACKUP_IMPORT_MAX_COMPRESSED_ENTRY_SIZE`."

msgid "Configures :setting:`PROJECT_BACKUP_IMPORT_MIN_RATIO_SIZE`."
msgstr "ຕັ້ງຄ່າ :setting:`PROJECT_BACKUP_IMPORT_MIN_RATIO_SIZE`."

