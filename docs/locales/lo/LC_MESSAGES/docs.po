msgid "Add as translation"
msgstr "ເພີ່ມເປັນການແປ"

msgid "Add as \"Needing edit\""
msgstr "ເພີ່ມເປັນ \"ຕ້ອງການການແກ້ໄຂ\""

msgid "Query"
msgstr "ຄຳສອບຖາມ"

msgid ""
