msgid "Weblate 5.13.2"
msgstr "Weblate 5.13.2"

msgid "*Released on September 5th 2025.*"
msgstr "*ປ່ອຍອອກເມື່ອວັນທີ 5 ກັນຍາ 2025.*"

msgid "Error reporting upon validation of the file upload method."
msgstr "ການລາຍງານຂໍ້ຜິດພາດເມື່ອກວດສອບວິທີການອັບໂຫຼດໄຟລ໌."

msgid "Detailed language information in new language notifications."
msgstr "ຂໍ້ມູນພາສາຢ່າງລະອຽດໃນການແຈ້ງເຕືອນພາສາໃໝ່."

msgid "Sign-in could not be completed with LDAP."
msgstr "ບໍ່ສາມາດເຂົ້າສູ່ລະບົບດ້ວຍ LDAP."

msgid "Nonspacing mark changes highlighting in history."
msgstr "ການໄຮໄລ້ການປ່ຽນແປງຂອງເຄື່ອງໝາຍ Nonspacing ໃນປະຫວັດ."

msgid ""
"`All changes in detail <https://github.com/WeblateOrg/weblate/milestone/151?"
"closed=1>`__."
msgstr ""
"`ລາຍລະອຽດການປ່ຽນແປງທັງໝົດ <https://github.com/WeblateOrg/weblate/milestone/151?"
"closed=1>`__."

msgid "Weblate 5.13.1"
msgstr "Weblate 5.13.1"

msgid "*Released on September 4th 2025.*"
msgstr "*ປ່ອຍອອກເມື່ອວັນທີ 4 ກັນຍາ 2025.*"

msgid "Smarter retries of unwritable pending changes."
msgstr "ການລອງໃໝ່ (retries) ທີ່ສະຫຼາດຂຶ້ນສຳລັບການປ່ຽນແປງທີ່ຄ້າງຢູ່ແຕ່ຂຽນບໍ່ໄດ້."

msgid "Failed :ref:`2fa` is visible in :ref:`audit-log`."
msgstr ":ref:`2fa` ທີ່ລົ້ມເຫຼວຈະເຫັນໄດ້ໃນ :ref:`audit-log`."

msgid "Sign-in form not shown for LDAP."
msgstr "ຟອມເຂົ້າສູ່ລະບົບບໍ່ສະແດງສຳລັບ LDAP."

msgid "Access control for :http:get:`/api/users/(str:username)/`."
msgstr "ການຄວບຄຸມການເຂົ້າເຖິງສຳລັບ :http:get:`/api/users/(str:username)/`."

msgid ":ref:`check-rst-references` allows translatable reference names."
msgstr ":ref:`check-rst-references` ອະນຸຍາດໃຫ້ໃຊ້ຊື່ອ້າງອີງທີ່ແປໄດ້."

msgid ":ref:`file_format_params` were not properly applied in some situations."
msgstr ":ref:`file_format_params` ບໍ່ຖືກນຳໃຊ້ຢ່າງຖືກຕ້ອງໃນບາງກໍລະນີ."

msgid "Removed stale :ref:`addon-weblate.xml.customize`."
msgstr "ລຶບ :ref:`addon-weblate.xml.customize` ທີ່ເກົ່າແກ່ອອກ."

msgid ":ref:`mt-libretranslate` compatibility with LibreTranslate 1.7.0."
msgstr "ຄວາມເຂົ້າກັນໄດ້ຂອງ :ref:`mt-libretranslate` ກັບ LibreTranslate 1.7.0."

msgid "Username autocompletion in comments."
msgstr "ການຕື່ມຊື່ຜູ້ໃຊ້ອັດຕະໂນມັດໃນຄຳເຫັນ."

msgid ""
"Shorten session expiry while in :ref:`2fa` (:cve:`2025-58352` / :ghsa:`377j-"
"wj38-4728`)."
msgstr ""
"ຫຼຸດເວລາໝົດອາຍຸຂອງເຊສຊັນໃນຂະນະທີ່ຢູ່ໃນ :ref:`2fa` (:cve:`2025-58352` / :ghsa:`377j-"
"wj38-4728`)."

msgid "Statistics when using :ref:`component-links`."
msgstr "ສະຖິຕິເມື່ອໃຊ້ :ref:`component-links`."

msgid ":ref:`componentlists` are no longer blocking dashboard loading."
msgstr ":ref:`componentlists` ບໍ່ໄດ້ຂັດຂວາງການໂຫຼດ dashboard ອີກຕໍ່ໄປ."

msgid "OpenMetrics API format."
msgstr "ຮູບແບບ OpenMetrics API."

msgid "Removed support for no longer working :ref:`mt-ibm`."
msgstr "ຍົກເລີກການຮອງຮັບ :ref:`mt-ibm` ທີ່ບໍ່ເຮັດວຽກແລ້ວ."

msgid ""
"There are several changes in :file:`settings_example.py`, most notably, "
"``django_otp.middleware.OTPMiddleware`` was removed from ``MIDDLEWARE``; "
"please adjust your settings accordingly."
msgstr ""
"ມີການປ່ຽນແປງຫຼາຍຢ່າງໃນ :file:`settings_example.py`, ສິ່ງທີ່ສຳຄັນທີ່ສຸດຄື "
"``django_otp.middleware.OTPMiddleware`` ຖືກລຶບອອກຈາກ ``MIDDLEWARE``; "
"ກະລຸນາປັບການຕັ້ງຄ່າຂອງທ່ານໃຫ້ສອດຄ່ອງ."

msgid ""
"`All changes in detail <https://github.com/WeblateOrg/weblate/milestone/150?"
"closed=1>`__."
msgstr ""
"`ລາຍລະອຽດການປ່ຽນແປງທັງໝົດ <https://github.com/WeblateOrg/weblate/milestone/150?"
"closed=1>`__."

msgid "Weblate 5.13"
msgstr "Weblate 5.13"

msgid "*Released on August 15th 2025.*"
msgstr "*ປ່ອຍອອກເມື່ອວັນທີ 15 ສິງຫາ 2025.*"

msgid ""
"Enhanced :ref:`translation-memory` management with configurable status "
"control, see :ref:`memory-status`."
msgstr ""
"ປັບປຸງການຈັດການ :ref:`translation-memory` ດ້ວຍການຄວບຄຸມສະຖານະທີ່ຕັ້ງຄ່າໄດ້, "
"ເບິ່ງ :ref:`memory-status`."

msgid ""
"Added :wladmin:`cleanup_memory` management command to remove obsolete "
"translation memory entries."
msgstr "ເພີ່ມຄຳສັ່ງຈັດການ :wladmin:`cleanup_memory` ເພື່ອລຶບລາຍການຄວາມຈຳການແປທີ່ລ້າສະໄໝ."

msgid ":doc:`/formats/catkeys`."
msgstr ":doc:`/formats/catkeys`."

msgid ""
"Some flags are now added to a string by default, based on locations; "
"see :ref:`location-based-flags`."
msgstr ""
"ບາງທຸງຖືກເພີ່ມເຂົ້າໃນຂໍ້ຄວາມໂດຍອັດຕະໂນມັດ, ອີງຕາມສະຖານທີ່; ເບິ່ງ :ref:`location-based-"
"flags`."

msgid ""
"Added :ref:`project-commit_policy` setting to control which translations are "
"included when committing changes."
msgstr ""
"ເພີ່ມການຕັ້ງຄ່າ :ref:`project-commit_policy` ເພື່ອຄວບຄຸມການແປໃດທີ່ລວມຢູ່ເມື່ອ commit "
"ການປ່ຽນແປງ."

msgid ":ref:`file_format_params` can now be configured at the component level."
msgstr ":ref:`file_format_params` ຕອນນີ້ສາມາດຕັ້ງຄ່າໃນລະດັບ component ໄດ້."

msgid ""
"New management command :wladmin:`list_file_format_params` to list all "
"available file format parameters."
msgstr ""
"ຄຳສັ່ງຈັດການໃໝ່ :wladmin:`list_file_format_params` "
"ເພື່ອສະແດງລາຍການພາລາມິເຕີຮູບແບບໄຟລ໌ທັງໝົດທີ່ມີ."

msgid ""
"Tag and attribute names can now be customized for :ref:`flatxml` "
"with :ref:`file_format_params`."
msgstr ""
"ຊື່ແທັກ (tag) ແລະ ຄຸນລັກສະນະ (attribute) ຕອນນີ້ສາມາດປັບແຕ່ງສຳລັບ :ref:`flatxml` "
"ດ້ວຍ :ref:`file_format_params`."

msgid ":ref:`search-strings` supports ``labels_count:NUMBER`` lookup."
msgstr ":ref:`search-strings` ຮອງຮັບການຄົ້ນຫາດ້ວຍ ``labels_count:NUMBER``."

msgid ""
"A new :envvar:`SENTRY_MONITOR_BEAT_TASKS` setting allows disabling Sentry "
"monitoring of Celery Beat tasks."
msgstr ""
"ການຕັ້ງຄ່າ :envvar:`SENTRY_MONITOR_BEAT_TASKS` ໃໝ່ຊ່ວຍໃຫ້ສາມາດປິດການຕິດຕາມ Sentry "
"ຂອງ Celery Beat tasks."

msgid ""
":envvar:`WEBLATE_SOCIAL_AUTH_OIDC_TITLE` "
"and :envvar:`WEBLATE_SOCIAL_AUTH_OIDC_IMAGE` allow configuring the "
"appearance of the generic OIDC authentication."
msgstr ""
":envvar:`WEBLATE_SOCIAL_AUTH_OIDC_TITLE` "
"ແລະ :envvar:`WEBLATE_SOCIAL_AUTH_OIDC_IMAGE` "
"ຊ່ວຍໃຫ້ສາມາດປັບແຕ່ງຮູບລັກສະນະຂອງການຢືນຢັນຕົວຕົນ OIDC ທົ່ວໄປ."

msgid "Background commits are now identified by an internal user."
msgstr "ການອັບເດດພື້ນຫຼັງຖືກລະບຸໂດຍຜູ້ໃຊ້ພາຍໃນແລ້ວ."

msgid "Reorganized navigation menu."
msgstr "ຈັດລະບຽບເມນູການນຳທາງໃໝ່."

msgid ""
"When editing a language definition, a warning about automated updates is "
"shown; see :ref:`included-languages`."
msgstr ""
"ເມື່ອແກ້ໄຂຄຳນິຍາມພາສາ, ຈະມີການສະແດງຄຳເຕືອນກ່ຽວກັບການອັບເດດອັດຕະໂນມັດ; "
"ເບິ່ງ :ref:`included-languages`."

msgid "Avatars for API and internal accounts."
msgstr "ຮູບໂປຣໄຟລ໌ສຳລັບ API ແລະ ບັນຊີພາຍໃນ."

msgid ""
"Adding a new TOTP device removes the existing one by default; checkbox for "
"not removing previous ones available."
msgstr "ການເພີ່ມອຸປະກອນ TOTP ໃໝ່ຈະລຶບອັນເກົ່າອອກໂດຍເລີ່ມຕົ້ນ; ມີຊ່ອງໃຫ້ຕິກເພື່ອບໍ່ໃຫ້ລຶບອັນເກົ່າ."

msgid ""
"Creating pull or merge requests to remote repositories is no longer blocked "
"by merge conflicts."
msgstr ""
"ການສ້າງ pull ຫຼື merge requests ໄປຍັງ remote repositories ບໍ່ຖືກຂັດຂວາງໂດຍ merge "
"conflicts ອີກຕໍ່ໄປ."

msgid ""
":ref:`check-rst-references` correctly handles Unicode punctuation and "
"detects more issues."
msgstr ""
":ref:`check-rst-references` ຈັດການເຄື່ອງໝາຍວັກຕອນ Unicode ໄດ້ຢ່າງຖືກຕ້ອງ ແລະ "
"ກວດພົບບັນຫາຕ່າງໆໄດ້ຫຼາຍຂຶ້ນ."

msgid ""
"Migration towards Bootstrap 5 has started, selected views now use Bootstrap "
"5."
msgstr ""
"ການຍ້າຍໄປສູ່ Bootstrap 5 ໄດ້ເລີ່ມຕົ້ນຂຶ້ນແລ້ວ, ບາງມຸມມອງ (views) ຕອນນີ້ໃຊ້ Bootstrap 5."

msgid ""
":ref:`xliff` now supports starting from scratch when :ref:`adding-projects`."
msgstr ":ref:`xliff` ຕອນນີ້ຮອງຮັບການເລີ່ມຕົ້ນໃໝ່ຕັ້ງແຕ່ຕົ້ນ ເມື່ອ :ref:`adding-projects`."

msgid ":ref:`mt-openai` compatibility with latest models."
msgstr "ຄວາມເຂົ້າກັນໄດ້ຂອງ :ref:`mt-openai` ກັບໂມເດວລ່າສຸດ."

msgid ""
":ref:`upload` correctly tracks authorship when using :guilabel:`Replace "
"existing translation file`."
msgstr ""
":ref:`upload` ຕິດຕາມຜູ້ຂຽນໄດ້ຢ່າງຖືກຕ້ອງເມື່ອໃຊ້ :guilabel:`Replace existing "
"translation file`."

msgid ""
":ref:`mt-deepl` integration now correctly handles all supported source "
"languages."
msgstr ":ref:`mt-deepl` ເຊື່ອມຕໍ່ຕອນນີ້ຈັດການພາສາຕົ້ນສະບັບທີ່ຮອງຮັບທັງໝົດໄດ້ຢ່າງຖືກຕ້ອງ."

msgid "Possible crash on macOS 15 in :samp:`strxfrm`."
msgstr "ຄວາມເປັນໄປໄດ້ທີ່ລະບົບຈະຄ້າງ (crash) ໃນ macOS 15 ທີ່ :samp:`strxfrm`."

msgid "Internal server error on permission denied while uploading files."
msgstr "ຂໍ້ຜິດພາດເຊີບເວີພາຍໃນ ເມື່ອບໍ່ມີສິດໃນການອັບໂຫຼດໄຟລ໌."

msgid ""
"Some addons have been deprecated and replaced "
"by :ref:`file_format_params`: :ref:`addon-"
"weblate.gettext.customize`, :ref:`addon-weblate.json.customize`, :ref:`addon-"
"weblate.yaml.customize`, :ref:`addon-weblate.xml.customize`."
msgstr ""
"ບາງ addons ຖືກຍົກເລີກ ແລະ ປ່ຽນແທນດ້ວຍ :ref:`file_format_params`: :ref:`addon-"
"weblate.gettext.customize`, :ref:`addon-weblate.json.customize`, :ref:`addon-"
"weblate.yaml.customize`, :ref:`addon-weblate.xml.customize`."

msgid ""
":ref:`machine-translation`, :ref:`addon-weblate.autotranslate.autotranslate` "
"and :http:post:`/api/translations/(string:project)/(string:component)/"
"(string:language)/autotranslate/` now support all search operators, not only "
"limited filters. Existing add-on configuration has been migrated. API users "
"will need to adjust invocation."
msgstr ""
":ref:`machine-translation`, :ref:`addon-weblate.autotranslate.autotranslate` "
"ແລະ :http:post:`/api/translations/(string:project)/(string:component)/"
