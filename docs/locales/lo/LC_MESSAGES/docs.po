msgstr "ຊື່ຄ່າ FlatXML"

msgid "gwt_encoding"
msgstr "gwt_encoding"

msgid "Encoding used for GWT Properties files"
msgstr "ລະຫັດຕົວອັກສອນທີ່ໃຊ້ສຳລັບໄຟລ໌ GWT Properties"

msgid "json_indent"
msgstr "json_indent"

msgid "JSON indentation"
msgstr "ການຫຍໍ້ໜ້າ JSON"

