msgstr "ຕັ້ງຄ່າ :setting:`PRIVATE_COMMIT_NAME_OPT_IN`."

msgid "Configures :setting:`UNUSED_ALERT_DAYS`."
msgstr "ຕັ້ງຄ່າ :setting:`UNUSED_ALERT_DAYS`."

msgid "Configures :setting:`REPORT_EXPIRY`."
msgstr "ຕັ້ງຄ່າ :setting:`REPORT_EXPIRY`."

