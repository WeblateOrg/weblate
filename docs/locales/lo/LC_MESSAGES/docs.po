msgstr ""
"`ການປ່ຽນແປງທັງໝົດໂດຍລະອຽດ <https://github.com/WeblateOrg/weblate/milestone/118?"
"closed=1>`__."

msgid "Weblate 5.5.1"
msgstr "Weblate 5.5.1"

msgid ":doc:`/user/search` supports ``source_changed:DATETIME``."
msgstr ":doc:`/user/search` ຮອງຮັບ ``source_changed:DATETIME``."

msgid "Added several new :ref:`component-language_code_style`."
msgstr "ເພີ່ມ :ref:`component-language_code_style` ໃໝ່ຫຼາຍຢ່າງ."

msgid "Display more details on source string change in history."
msgstr "ສະແດງລາຍລະອຽດເພີ່ມເຕີມເມື່ອມີການປ່ຽນແປງຂໍ້ຄວາມຕົ້ນສະບັບໃນປະຫວັດ."

msgid ":ref:`mt-microsoft-translator` now supports using custom translators."
msgstr ":ref:`mt-microsoft-translator` ຕອນນີ້ຮອງຮັບການໃຊ້ຜູ້ແປແບບກຳນົດເອງ."

msgid "Improved error handling in :ref:`invite-user`."
msgstr "ປັບປຸງການຈັດການຂໍ້ຜິດພາດໃນ :ref:`invite-user`."

msgid "Added PNG status badge."
msgstr "ເພີ່ມປ້າຍສະຖານະ PNG."

msgid "Added list of managed projects to the dashboard view."
msgstr "ເພີ່ມລາຍການໂຄງການທີ່ຈັດການເຂົ້າໃນມຸມມອງແດສບອດ."

msgid "More detailed status of outgoing commits."
msgstr "ສະຖານະລະອຽດເພີ່ມເຕີມຂອງຄອມມິດທີ່ສົ່ງອອກ."

msgid "Fixed skipped component update with some add-ons enabled."
msgstr "ແກ້ໄຂການຂ້າມການອັບເດດອົງປະກອບເມື່ອເປີດໃຊ້ບາງອັດອອນ."

msgid "Daily execution of project and site wide add-ons."
msgstr "ການເຮັດວຽກປະຈຳວັນຂອງອັດອອນໃນລະດັບໂຄງການ ແລະ ເວັບໄຊ."

msgid "Allow editing strings when the source is marked for editing."
msgstr "ອະນຸຍາດໃຫ້ແກ້ໄຂຂໍ້ຄວາມເມື່ອຕົ້ນສະບັບຖືກໝາຍວ່າຕ້ອງການການແກ້ໄຂ."

msgid "Updates of the last updated timestamp of a string."
msgstr "ອັບເດດເວລາການປັບປຸງຫຼ້າສຸດຂອງຂໍ້ຄວາມ."

msgid ""
"Fixed project and site wide installation of :ref:`addon-weblate.git.squash` "
"and :ref:`addon-weblate.discovery.discovery` add-ons."
msgstr ""
"ແກ້ໄຂການຕິດຕັ້ງ :ref:`addon-weblate.git.squash` ແລະ :ref:`addon-"
"weblate.discovery.discovery` ໃນລະດັບໂຄງການ ແລະ ເວັບໄຊ."

msgid "Graceful handling of locking errors in the :ref:`api`."
msgstr "ການຈັດການຂໍ້ຜິດພາດການລັອກໃນ :ref:`api` ຢ່າງມີປະສິດທິພາບ."

msgid ""
"There is a change in ``REST_FRAMEWORK`` setting (newly added "
"``EXCEPTION_HANDLER``)."
msgstr "ມີການປ່ຽນແປງໃນການຕັ້ງຄ່າ ``REST_FRAMEWORK`` (ເພີ່ມ ``EXCEPTION_HANDLER`` ໃໝ່)."

msgid ""
"`All changes in detail <https://github.com/WeblateOrg/weblate/milestone/117?"
"closed=1>`__."
msgstr ""
"`ການປ່ຽນແປງທັງໝົດໂດຍລະອຽດ <https://github.com/WeblateOrg/weblate/milestone/117?"
"closed=1>`__."

msgid "Weblate 5.5"
msgstr "Weblate 5.5"

msgid "*Released on April 20th 2024.*"
msgstr "*ອອກວັນທີ 20 ເມສາ 2024.*"

msgid ":ref:`addons` can be now installed project-wide and site-wide."
msgstr ":ref:`addons` ສາມາດຕິດຕັ້ງໄດ້ທົ່ວໂຄງການ ແລະ ທົ່ວເວັບໄຊແລ້ວ."

msgid "API improvements."
msgstr "ການປັບປຸງ API."

msgid "Added :http:get:`/api/categories/(int:id)/statistics/`."
msgstr "ເພີ່ມ :http:get:`/api/categories/(int:id)/statistics/`."

msgid "Added :http:get:`/api/projects/(string:project)/file/`."
msgstr "ເພີ່ມ :http:get:`/api/projects/(string:project)/file/`."

msgid "Added :http:post:`/api/groups/(int:id)/admins/`."
msgstr "ເພີ່ມ :http:post:`/api/groups/(int:id)/admins/`."

msgid "Added :http:delete:`/api/groups/(int:id)/admins/(int:user_id)`."
msgstr "ເພີ່ມ :http:delete:`/api/groups/(int:id)/admins/(int:user_id)`."

msgid ""
"Improved :http:post:`/api/translations/(string:project)/(string:component)/"
"(string:language)/units/`."
msgstr ""
"ປັບປຸງ :http:post:`/api/translations/(string:project)/(string:component)/"
"(string:language)/units/`."

msgid "Added :ref:`mt-systran` automatic translation support."
msgstr "ເພີ່ມການຮອງຮັບການແປອັດຕະໂນມັດ :ref:`mt-systran`."

msgid ""
"Docker container now validates user password strength by default, "
"see :envvar:`WEBLATE_MIN_PASSWORD_SCORE`."
msgstr ""
"ຄອນເທນເນີ Docker ຈະກວດສອບຄວາມແຂງແກ່ນຂອງລະຫັດຜ່ານໂດຍເລີ່ມຕົ້ນ, "
"ເບິ່ງທີ່ :envvar:`WEBLATE_MIN_PASSWORD_SCORE`."

msgid "Improved error reporting in :ref:`machine-translation-setup`."
msgstr "ປັບປຸງການລາຍງານຂໍ້ຜິດພາດໃນ :ref:`machine-translation-setup`."

msgid ":ref:`check-max-size` better displays rendered text."
msgstr ":ref:`check-max-size` ສະແດງຂໍ້ຄວາມທີ່ແປງແລ້ວໄດ້ດີຂຶ້ນ."

msgid "Admins can now specify username and full name when :ref:`invite-user`."
msgstr "ຜູ້ເບິ່ງແລສາມາດລະບຸຊື່ຜູ້ໃຊ້ ແລະ ຊື່ເຕັມເມື່ອ :ref:`invite-user` ໄດ້."

msgid "Added :ref:`check-end-interrobang`."
msgstr "ເພີ່ມ :ref:`check-end-interrobang`."

msgid ":ref:`alerts` are now refreshed when needed, not just daily."
msgstr ":ref:`alerts` ຈະຖືກຣີເຟຣຊເມື່ອຈຳເປັນ, ບໍ່ແມ່ນແຕ່ປະຈຳວັນ."

msgid ":doc:`/devel/reporting` uses specific word count for CJK languages."
msgstr ":doc:`/devel/reporting` ໃຊ້ການນັບຄຳສະເພາະສຳລັບພາສາ CJK."

msgid "Team membership changes are now tracked in :ref:`audit-log`."
msgstr "ການປ່ຽນແປງສະມາຊິກທີມຈະຖືກຕິດຕາມໃນ :ref:`audit-log`."

msgid ""
":ref:`check-check-glossary` works better for languages not using whitespace."
msgstr ":ref:`check-check-glossary` ເຮັດວຽກໄດ້ດີຂຶ້ນສຳລັບພາສາທີ່ບໍ່ໃຊ້ຊ່ອງຫວ່າງ."

msgid ":ref:`alerts` better handle non-latin source languages."
msgstr ":ref:`alerts` ຈັດການກັບພາສາຕົ້ນສະບັບທີ່ບໍ່ແມ່ນພາສາລາຕິນໄດ້ດີຂຶ້ນ."

msgid ":ref:`check-max-size` sometimes ignored ``font-spacing:SPACING`` flag."
msgstr ":ref:`check-max-size` ບາງຄັ້ງລະເລີຍທຸງ ``font-spacing:SPACING``."

msgid "Fixed per-language statistics on nested categories."
msgstr "ແກ້ໄຂສະຖິຕິລາຍພາສາໃນໝວດໝູ່ທີ່ຊ້ອນກັນ."

msgid "Fixed categories listing on per-language pages."
msgstr "ແກ້ໄຂການສະແດງລາຍການໝວດໝູ່ໃນໜ້າລາຍພາສາ."

msgid "Fixed :guilabel:`Needs editing` state calculation."
msgstr "ແກ້ໄຂການຄຳນວນສະຖານະ :guilabel:`Needs editing`."

msgid "Fixed changing :ref:`component-push` with :ref:`code-hosting-gerrit`."
msgstr "ແກ້ໄຂການປ່ຽນແປງ :ref:`component-push` ກັບ :ref:`code-hosting-gerrit`."

msgid ""
"Fixed using categorized components in :ref:`manage`, :ref:`memory` "
"or :ref:`auto-translation`."
msgstr ""
"ແກ້ໄຂການໃຊ້ອົງປະກອບທີ່ມີໝວດໝູ່ໃນ :ref:`manage`, :ref:`memory` ຫຼື :ref:`auto-"
"translation`."

msgid ""
"Several API calls might be affected by stricter validation of boolean fields "
"by Django REST Framework. For example :http:post:`/api/projects/"
"(string:project)/components/`."
msgstr ""
"ການເອີ້ນ API ຫຼາຍຢ່າງອາດໄດ້ຮັບຜົນກະທົບຈາກການກວດສອບຊ່ອງຂໍ້ມູນບູລີນທີ່ເຂັ້ມງວດຂຶ້ນໂດຍ Django REST "
"Framework. ຕົວຢ່າງ :http:post:`/api/projects/(string:project)/components/`."

msgid ""
"Uniqueness of name and slug of a component is now enforced at the database "
"level on PostgreSQL 15+."
msgstr ""
"ການບັງຄັບໃຊ້ຄວາມເປັນເອກະລັກຂອງຊື່ ແລະ ສະລັກຂອງອົງປະກອບໃນລະດັບຖານຂໍ້ມູນເທິງ PostgreSQL 15+."

msgid ""
"Docker image now ships Python packages in :file:`/app/venv` and installs "
"using :program:`uv`."
msgstr ""
"ອີເມຈ Docker ຕອນນີ້ສົ່ງແພັກເກັດ Python ໃນ :file:`/app/venv` ແລະ "
"ຕິດຕັ້ງໂດຍໃຊ້ :program:`uv`."

msgid ""
"There are several changes in :file:`settings_example.py`, most notable is "
"changes in ``INSTALLED_APPS`` and ``LOGOUT_REDIRECT_URL``, please adjust "
"your settings accordingly."
msgstr ""
"ມີການປ່ຽນແປງຫຼາຍຢ່າງໃນ :file:`settings_example.py` ທີ່ສຳຄັນແມ່ນການປ່ຽນແປງໃນ "
"``INSTALLED_APPS`` ແລະ ``LOGOUT_REDIRECT_URL``, ກະລຸນາປັບການຕັ້ງຄ່າຂອງທ່ານໃຫ້ສອດຄ່ອງ."

msgid "Weblate now requires Python 3.10 and Django 5.0."
msgstr "Weblate ຕອນນີ້ຕ້ອງການ Python 3.10 ແລະ Django 5.0."

msgid ""
"`All changes in detail <https://github.com/WeblateOrg/weblate/milestone/111?"
"closed=1>`__."
msgstr ""
"`ການປ່ຽນແປງທັງໝົດໂດຍລະອຽດ <https://github.com/WeblateOrg/weblate/milestone/111?"
"closed=1>`__."

msgid "Weblate 5.4.3"
msgstr "Weblate 5.4.3"

msgid "*Released on March 26th 2024.*"
msgstr "*ອອກວັນທີ 26 ມີນາ 2024.*"

msgid "Superuser access to components with :ref:`component-restricted`."
msgstr "ການເຂົ້າເຖິງອົງປະກອບແບບ Superuser ດ້ວຍ :ref:`component-restricted`."

msgid ""
"Adjusted default ``LOGIN_REQUIRED_URLS_EXCEPTIONS`` to not "
"block :ref:`manage-appearance`."
msgstr ""
"ປັບປ່ຽນ ``LOGIN_REQUIRED_URLS_EXCEPTIONS`` ເລີ່ມຕົ້ນເພື່ອບໍ່ໃຫ້ບລັອກ :ref:`manage-"
"appearance`."

msgid "Avoid crash on pushing changes to diverged repository."
msgstr "ຫຼີກເວັ້ນການປິດໂຕເອງເມື່ອ push ການປ່ຽນແປງໄປຍັງບ່ອນເກັບຂໍ້ມູນທີ່ແຍກອອກໄປ."

msgid "Avoid crash when installing :ref:`addon-weblate.generate.pseudolocale`."
msgstr "ຫຼີກເວັ້ນການປິດໂຕເອງເມື່ອຕິດຕັ້ງ :ref:`addon-weblate.generate.pseudolocale`."

msgid ""
":ref:`Azure Repos notifications <code-hosting-azure-repos-notifications>` "
"gracefully handles repositories with spaces in URL."
msgstr ""
":ref:`Azure Repos notifications <code-hosting-azure-repos-notifications>` "
