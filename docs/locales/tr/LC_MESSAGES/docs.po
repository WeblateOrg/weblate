msgid "Severity levels and SLAs"
msgstr "Önem düzeyleri ve hizmet düzeyi anlaşmaları"

msgid "Severity"
msgstr "Önem düzeyi"

msgid "Definition"
msgstr "Tanım"

msgid "Target Acknowledge"
msgstr "Hedefin kabul edilmesi"

msgid "Target Initial Action"
msgstr "İlk hedef işlemi"

msgid "Critical"
msgstr "Kritik"

msgid ""
"Total outage; Admin compromise; Active data breach; requires immediate "
