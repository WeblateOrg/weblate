msgid "Untranslatable terms"
msgstr "Çevrilemez terimler"

#, fuzzy
#| msgid ""
#| "Flagging certain glossary term translations ``read-only`` by bulk-"
#| "editing, typing in the flag, or by using :guilabel:`Tools` "
