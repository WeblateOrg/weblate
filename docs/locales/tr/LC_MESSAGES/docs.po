msgid "Web server"
msgstr "İnternet sunucusu"

msgid "Handling incoming HTTP requests, :ref:`static-files`."
msgstr "Gelen HTTP isteklerinin işlenmesi, :ref:`static-files`."

msgid "Celery workers"
msgstr "Celery işlemleri"

