msgstr "Khóa tăng tốc"

msgid "Summary"
msgstr "Tóm tắt"

msgid "Source and translation contain inconsistent accelerator keys."
msgstr "Bản gốc và bản dịch chứa các phím tắt không nhất quán."

msgid "translated strings"
msgstr "các chuỗi đã dịch"

