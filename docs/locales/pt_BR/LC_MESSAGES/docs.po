msgstr "Weblate 4.18.1"

msgid "*Released on June 16th 2023.*"
msgstr "*Atualizado em 16 de junho de 2023.*"

msgid "Fixed language code format for i18next."
msgstr "Corrigido o formato de código de idioma para i18next."

msgid "Fixed CSS compression with dark theme."
msgstr "Corrigida a compressão de CSS com o tema escuro."

