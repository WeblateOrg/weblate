msgid "Weblate 0.x series"
msgstr "Série 0.x do Weblate"

msgid "Weblate 0.9"
msgstr "Weblate 0.9"

msgid "*Released on April 18th 2012.*"
msgstr "*Atualizado em 18 de abril de 2012.*"

msgid "Fixed import of unknown languages."
msgstr "Corrigida a importação de idiomas desconhecidos."

msgid "Improved listing of nearby messages."
msgstr "Melhorada a lista de mensagens próximas."

msgid "Improved several checks."
msgstr "Melhoradas várias verificações."

msgid "Documentation updates."
msgstr "Atualizações de documentação."

msgid "Added definition for several more languages."
msgstr "Adicionada definição para vários outros idiomas."

msgid "Various code cleanups."
msgstr "Várias limpezas de código."

msgid "Documentation improvements."
msgstr "Melhorias na documentação."

msgid "Changed file layout."
msgstr "Alterado o layout de arquivo."

msgid "Update helper scripts to Django 1.4."
msgstr "Atualiza scripts auxiliares para Django 1.4."

msgid "Improved navigation while translating."
msgstr "Melhorada a navegação durante a tradução."

msgid "Better handling of po file renames."
msgstr "Melhor tratamento de renomeações de arquivos po."

msgid "Better validation while creating component."
msgstr "Melhor validação durante a criação do componente."

msgid "Integrated full setup into syncdb."
msgstr "Integrada a configuração completa no syncdb."

msgid "Added list of recent changes to all translation pages."
msgstr ""
"Adicionada lista de mudanças recentes para todas as páginas de tradução."

msgid "Check for untranslated strings ignores format string only messages."
msgstr ""
"A verificação de textos não traduzidos ignora mensagens de texto apenas de "
"formato."

msgid "Weblate 0.8"
msgstr "Weblate 0.8"

msgid "*Released on April 3rd 2012.*"
msgstr "*Atualizado em 3 de abril de 2012.*"

msgid "Replaced own full text search with Whoosh."
msgstr "Substituída a própria busca de texto completo por Whoosh."

msgid "Various fixes and improvements to checks."
msgstr "Várias correções e melhorias nas verificações."

msgid "New command updatechecks."
msgstr "Novo comando updatechecks."

msgid "Lot of translation updates."
msgstr "Muitas atualizações de tradução."

msgid "Added dictionary for storing most frequently used terms."
msgstr ""
"Adicionado dicionário para armazenar os termos usados com mais frequência."

msgid "Added /admin/report/ for overview of repositories status."
msgstr ""
"Adicionado /admin/report/ para uma visão geral do status dos repositórios."

msgid "Machine translation services no longer block page loading."
msgstr ""
"Os serviços de tradução automática não bloqueiam mais o carregamento da "
"página."

msgid "Management interface now contains also useful actions to update data."
msgstr ""
"A interface de gerenciamento agora também contém ações úteis para atualizar "
"dados."

msgid "Records log of changes made by users."
msgstr "Registra o log de alterações feitas pelos usuários."

msgid ""
"Ability to postpone commit to Git to generate less commits from single user."
msgstr ""
"Capacidade de adiar o commit para Git para gerar menos commits de um único "
"usuário."

msgid "Possibility to browse failing checks."
msgstr "Possibilidade de navegar nas verificações com falha."

msgid "Automatic translation using already translated strings."
msgstr "Tradução automática usando textos já traduzidos."

msgid "New about page showing used versions."
msgstr "Novo sobre a página que mostra as versões usadas."

msgid "Django 1.4 compatibility."
msgstr "Compatibilidade com Django 1.4."

msgid "Ability to push changes to remote repo from web interface."
msgstr ""
"Capacidade de enviar alterações ao repositório remoto a partir da interface "
"web."

msgid "Added review of translations done by others."
msgstr "Adicionada revisão de traduções feitas por outros."

msgid "Weblate 0.7"
msgstr "Weblate 0.7"

msgid "*Released on February 16th 2012.*"
msgstr "*Atualizado em 16 de fevereiro de 2012.*"

msgid "Direct support for GitHub notifications."
msgstr "Suporte direto para notificações GitHub."

msgid "Added support for cleaning up orphaned checks and translations."
msgstr "Adicionado suporte para limpar verificações e traduções órfãos."

msgid "Displays nearby strings while translating."
msgstr "Exibe textos próximos durante a tradução."

msgid "Displays similar strings while translating."
msgstr "Exibe textos semelhantes durante a tradução."

msgid "Improved searching for string."
msgstr "Melhorada busca de texto."

msgid "Weblate 0.6"
msgstr "Weblate 0.6"

msgid "*Released on February 14th 2012.*"
msgstr "*Atualizado em 14 de fevereiro de 2012.*"

msgid "Added various checks for translated messages."
msgstr "Adicionadas várias verificações para mensagens traduzidas."

msgid "Tunable access control."
msgstr "Controle de acesso ajustável."

msgid "Improved handling of translations with new lines."
msgstr "Melhorado o tratamento de traduções com novas linhas."

msgid "Added client side sorting of tables."
msgstr "Adicionada classificação de tabelas do lado do cliente."

msgid "Please check upgrading instructions in case you are upgrading."
msgstr "Verifique as instruções de atualização caso você esteja atualizando."

msgid "Weblate 0.5"
msgstr "Weblate 0.5"

msgid "*Released on February 12th 2012.*"
msgstr "*Atualizado em 12 de fevereiro de 2012.*"

msgid "Support for machine translation using following online services:"
msgstr "Suporte para tradução automática usando os seguintes serviços online:"

msgid "Several new translations."
msgstr "Várias novas traduções."

msgid "Improved merging of upstream changes."
msgstr "Melhorada mesclagem de mudanças do upstream."

msgid "Better handle concurrent git pull and translation."
msgstr "Melhor tratamento de git pull e tradução simultâneos."

msgid "Propagating works for fuzzy changes as well."
msgstr "A propagação também funciona para mudanças aproximadas."

msgid "Propagating works also for file upload."
msgstr "A propagação também funciona para envio de arquivos."

msgid "Fixed file downloads while using FastCGI (and possibly others)."
msgstr ""
"Downloads de arquivos corrigidos ao usar FastCGI (e possivelmente outros)."

msgid "Weblate 0.4"
msgstr "Weblate 0.4"

msgid "*Released on February 8th 2012.*"
msgstr "*Atualizado em 8 de fevereiro de 2012.*"

msgid "Added usage guide to documentation."
msgstr "Adicionado guia de uso à documentação."

msgid "Fixed API hooks not to require CSRF protection."
msgstr "Corrigidos ganchos de API para não exigir proteção CSRF."

msgid "Weblate 0.3"
msgstr "Weblate 0.3"

msgid "Better display of source for plural translations."
msgstr "Melhor exibição da fonte para traduções plurais."

msgid "New documentation in Sphinx format."
msgstr "Nova documentação em formato Sphinx."

msgid "Displays secondary languages while translating."
msgstr "Exibe idiomas secundários durante a tradução."

msgid "Improved error page to give list of existing projects."
msgstr ""
"Melhorada a página de erro para fornecer uma lista de projetos existentes."

msgid "New per language stats."
msgstr "Novas estatísticas por idioma."

msgid "Weblate 0.2"
msgstr "Weblate 0.2"

msgid "*Released on February 7th 2012.*"
msgstr "*Atualizado em 7 de fevereiro de 2012.*"

msgid "Improved validation of several forms."
msgstr "Melhorada a validação de vários formulários."

msgid "Warn users on profile upgrade."
msgstr "Avisa os usuários sobre a atualização do perfil."

msgid "Remember URL for login."
msgstr "Lembre-se de URL para fazer o login."

msgid "Naming of text areas while entering plural forms."
msgstr "Nomenclatura de áreas de texto ao inserir formas plurais."

msgid "Automatic expanding of translation area."
msgstr "Expansão automática da área de tradução."

msgid "Weblate 0.1"
msgstr "Weblate 0.1"

msgid "*Released on February 6th 2012.*"
msgstr "*Atualizado em 6 de fevereiro de 2012.*"

msgid "Initial release."
msgstr "Lançamento inicial."

msgid "Weblate 1.x series"
msgstr "Série 1.x do Weblate"

msgid "Weblate 1.9"
msgstr "Weblate 1.9"

msgid "*Released on May 6th 2014.*"
msgstr "*Atualizado em 6 de maio de 2014.*"

msgid "Django 1.6 compatibility."
msgstr "Compatibilidade com Django 1.6."

msgid "No longer maintained compatibility with Django 1.4."
msgstr "Compatibilidade descontinuada com Django 1.4."

msgid "Management commands for locking/unlocking translations."
msgstr "Comandos de gerenciamento para bloquear/desbloquear traduções."

msgid "Improved support for Qt TS files."
msgstr "Melhorado suporte para arquivos Qt TS."

msgid "Users can now delete their account."
msgstr "Os usuários agora podem excluir sua conta."

msgid "Avatars can be disabled."
msgstr "Avatares podem ser desabilitados."

msgid "Merged first and last name attributes."
msgstr "Mesclados os atributos de nome e sobrenome."

msgid "Avatars are now fetched and cached server side."
msgstr "Avatares agora são obtidos e armazenados em cache no lado do servidor."

msgid "Added support for shields.io badge."
msgstr "Adicionado suporte para emblema do shields.io."

msgid "Weblate 1.8"
msgstr "Weblate 1.8"

msgid "*Released on November 7th 2013.*"
msgstr "*Atualizado em 7 de novembro de 2013.*"

msgid "Please check manual for upgrade instructions."
msgstr "Confira o manual para as instruções de atualização."

msgid "Nicer listing of project summary."
msgstr "Melhor listagem de resumo de projeto."

msgid "Better visible options for sharing."
msgstr "Opções mais visíveis para compartilhamento."

msgid "More control over anonymous users privileges."
msgstr "Mais controle sobre privilégios de usuários anônimos."

msgid ""
"Supports login using third party services, check manual for more details."
msgstr ""
"Suporte a login usando serviços de terceiros, confira o manual para obter "
"mais detalhes."

msgid "Users can login by e-mail instead of username."
msgstr "Os usuários podem fazer login por e-mail em vez de nome de usuário."

msgid "Improved source strings review."
msgstr "Melhorada a revisão de textos fontes."

msgid "Searching across all strings."
msgstr "Busca em todos os textos."

msgid "Better tracking of source strings."
msgstr "Melhor rastreamento de textos fonte."

msgid "Captcha protection for registration."
msgstr "Proteção por captcha para registro."

msgid "Weblate 1.7"
msgstr "Weblate 1.7"

msgid "*Released on October 7th 2013.*"
msgstr "*Atualizado em 7 de outubro de 2013.*"

msgid "Support for checking Python brace format string."
msgstr "Suporte para verificar a texto de formatação com chaves do Python."

msgid "Per component customization of quality checks."
msgstr "Personalização por componente de verificações de qualidade."

msgid "Detailed per translation stats."
msgstr "Estatísticas detalhadas por tradução."

msgid "Changed way of linking suggestions, checks and comments to strings."
msgstr ""
"Alterada a forma de vinculação de sugestões, verificações e comentários de "
"textos."

msgid "Users can now add text to commit message."
msgstr "Usuários podem agora adicionar texto à mensagem de commit."

msgid "Support for subscribing on new language requests."
msgstr "Suporte a assinatura por novas solicitações de idiomas."

msgid "Support for adding new translations."
msgstr "Suporte a adição de novas traduções."

msgid ""
"Widgets and charts are now rendered using Pillow instead of Pango + Cairo."
msgstr ""
"Widgets e gráficos são agora renderizados usando Pillow em vez de Pango + "
"Cairo."

msgid "Add status badge widget."
msgstr "Adiciona widget emblema de status."

msgid "Dropped invalid text direction check."
msgstr "Removida a verificação inválida de direção do texto."

msgid "Changes in dictionary are now logged in history."
msgstr "As alterações no dicionário estão agora registradas no histórico."

msgid "Performance improvements for translation view."
msgstr "Melhorias de desempenho para a visualização de tradução."

msgid "Weblate 1.6"
msgstr "Weblate 1.6"

msgid "*Released on July 25th 2013.*"
msgstr "*Atualizado em 25 de julho de 2013.*"

msgid "Nicer error handling on registration."
msgstr "Melhor tratamento de erros no registro."

msgid "Browsing of changes."
msgstr "Navegação de mudanças."

msgid "Fixed sorting of machine translation suggestions."
msgstr "Corrigida a classificação para sugestões de tradução automática."

msgid "Improved support for MyMemory machine translation."
msgstr "Melhorado o suporte para a tradução automática do MyMemory."

msgid "Added support for Amagama machine translation."
msgstr "Adicionado suporte à tradução automática de Amagama."

msgid "Various optimizations on frequently used pages."
msgstr "Várias otimizações sobre páginas usadas com frequência."

msgid "Highlights searched phrase in search results."
msgstr "Realça frases buscadas em resultados de busca."

msgid "Support for automatic fixups while saving the message."
msgstr "Suporte para correções automáticas enquanto salva a mensagem."

msgid "Tracking of translation history and option to revert it."
msgstr "Rastreamento do histórico de tradução e opção para revertê-lo."

msgid "Added support for Google Translate API."
msgstr "Adicionado suporte para API do Google Tradutor."

msgid "Added support for managing SSH host keys."
msgstr "Suporte adicional para gerenciamento de chaves de host SSH."

msgid "Various form validation improvements."
msgstr "Várias melhorias de validação de formulários."

msgid "Various quality checks improvements."
msgstr "Várias melhorias de verificação de qualidade."

msgid "Performance improvements for import."
msgstr "Melhorias de desempenho para importação."

msgid "Added support for voting on suggestions."
msgstr "Adicionado suporte para votação das sugestões."

msgid "Cleanup of admin interface."
msgstr "Limpeza da interface administrativa."

msgid "Weblate 1.5"
msgstr "Weblate 1.5"

msgid "*Released on April 16th 2013.*"
msgstr "*Atualizado em 16 de abril de 2013.*"

msgid "Added public user pages."
msgstr "Adicionadas páginas públicas de usuários."

msgid "Better naming of plural forms."
msgstr "Melhor nomenclatura de formas plurais."

msgid "Added support for TBX export of glossary."
msgstr "Adicionado suporte para exportação de glossário TBX."

msgid "Added support for Bitbucket notifications."
msgstr "Adicionado suporte para notificações bitbucket."

msgid ""
"Activity charts are now available for each translation, language or user."
msgstr ""
"Os gráficos de atividade já estão disponíveis para cada tradução, idioma ou "
"usuário."

msgid "Extended options of import_project admin command."
msgstr "Opções estendidas de comando administrativo import_project."

msgid "Compatible with Django 1.5."
msgstr "Compatível com Django 1.5."

msgid "Avatars are now shown using libravatar."
msgstr "Avatares são agora mostrados usando libravatar."

msgid "Added possibility to pretty print JSON export."
msgstr "Adicionada possibilidade de impressão bonita da exportação JSON."

msgid "Various performance improvements."
msgstr "Várias melhorias de desempenho."

msgid ""
"Indicate failing checks or fuzzy strings in progress bars for projects or "
"languages as well."
msgstr ""
"Indica verificações de falha ou textos aproximados em barras de progresso "
"para projetos ou idiomas também."

msgid ""
"Added support for custom pre-commit hooks and committing additional files."
msgstr ""
"Adicionado suporte para ganchos personalizados pré-commit e fazer commit de "
"arquivos adicionais."

msgid "Rewritten search for better performance and user experience."
msgstr "Reescrita a busca para melhor desempenho e experiência do usuário."

msgid "New interface for machine translations."
msgstr "Nova interface para traduções automáticas."

msgid "Added support for monolingual po files."
msgstr "Adicionado suporte para arquivos po monolíngues."

msgid "Extend amount of cached metadata to improve speed of various searches."
msgstr ""
"Estende a quantidade de metadados armazenados em cache para melhorar a "
"velocidade de várias buscas."

msgid "Now shows word counts as well."
msgstr "Agora mostra contagem de palavras também."

msgid "Weblate 1.4"
msgstr "Weblate 1.4"

msgid "*Released on January 23rd 2013.*"
msgstr "*Atualizado em 23 de janeiro de 2013.*"

msgid "Fixed deleting of checks/comments on string deletion."
msgstr ""
"Corrigida a exclusão de verificações/comentários sobre exclusão de texto."

msgid "Added option to disable automatic propagation of translations."
msgstr "Adicionada opção para desativar a propagação automática de traduções."

msgid "Added option to subscribe for merge failures."
msgstr "Adicionada opção para se inscrever para falhas de mesclagem."

msgid "Correctly import on projects which needs custom ttkit loader."
msgstr ""
"Importa corretamente em projetos que precisem de carregador ttkit "
"personalizado."

msgid "Added sitemaps to allow easier access by crawlers."
msgstr ""
"Adicionados mapas de site para permitir um acesso mais fácil por "
"rastreadores."

msgid "Provide direct links to string in notification e-mails or feeds."
msgstr "Fornece links diretos para textos em e-mails de notificação ou feeds."

msgid "Various improvements to admin interface."
msgstr "Várias melhorias na interface administrativa."

msgid "Provide hints for production setup in admin interface."
msgstr ""
"Fornece dicas para a configuração da produção na interface administrativa."

msgid "Added per language widgets and engage page."
msgstr "Adicionados widgets e página de engajamento por idioma."

msgid "Improved translation locking handling."
msgstr "Melhorado o manuseio de bloqueio de tradução."

msgid "Show code snippets for widgets in more variants."
msgstr "Mostra trechos de código para widgets em mais variantes."

msgid "Indicate failing checks or fuzzy strings in progress bars."
msgstr ""
"Indica verificações de falha ou textos aproximados em barras de progresso."

msgid "More options for formatting commit message."
msgstr "Mais opções para formatar mensagem de commit."

msgid "Fixed error handling with machine translation services."
msgstr "Correção para tratamento de erros com serviços de tradução automática."

msgid "Improved automatic translation locking behaviour."
msgstr "Melhorado o comportamento de bloqueio de tradução automática."

msgid "Support for showing changes from previous source string."
msgstr "Suporte para mostrar alterações do texto fonte anterior."

msgid "Added support for substring search."
msgstr "Adicionado suporte para busca de subtexto."

msgid "Support for per project ACL."
msgstr "Suporte para ACL por projeto."

msgid "Basic code coverage by unit tests."
msgstr "Cobertura de código básica por testes unitários."

msgid "Weblate 1.3"
msgstr "Weblate 1.3"

msgid "*Released on November 16th 2012.*"
msgstr "*Atualizado em 16 de novembro de 2012.*"

msgid "Compatibility with PostgreSQL database backend."
msgstr "Compatibilidade com backend de banco de dados PostgreSQL."

msgid "Removes languages removed in upstream git repository."
msgstr "Remove idiomas removidos no repositório git upstream."

msgid "Improved quality checks processing."
msgstr "Melhorado o processamento de verificações de qualidade."

msgid "Added new checks (BBCode, XML markup and newlines)."
msgstr "Adicionadas novas verificações (BBCode, marcação XML e novas linhas)."

msgid "Support for optional rebasing instead of merge."
msgstr "Suporte para opcionalmente fazer rebase em vez de mesclar."

msgid ""
"Possibility to relocate Weblate (for example to run it under /weblate path)."
msgstr ""
"Possibilidade de realocar o Weblate (por exemplo, executá-lo no caminho /"
"weblate)."

msgid "Support for manually choosing file type in case autodetection fails."
msgstr ""
"Suporte para escolher manualmente o tipo de arquivo no caso de falha na "
"autodetecção."

msgid "Better support for Android resources."
msgstr "Melhor suporte para recursos Android."

msgid "Support for generating SSH key from web interface."
msgstr "Suporte para gerar chave SSH a partir da interface web."

msgid "More visible data exports."
msgstr "Exportações de dados mais visíveis."

msgid "New buttons to enter some special characters."
msgstr "Novos botões para inserir alguns caracteres especiais."

msgid "Support for exporting dictionary."
msgstr "Suporte para exportação de dicionário."

msgid "Support for locking down whole Weblate installation."
msgstr "Suporte para bloquear toda a instalação do Weblate."

msgid "Checks for source strings and support for source strings review."
msgstr "Verificações para texto fonte e suporte para revisão de texto fonte."

msgid "Support for user comments for both translations and source strings."
msgstr "Suporte para comentários de usuários para traduções e textos fonte."

msgid "Better changes log tracking."
msgstr "Melhor rastreamento de logs de alteração."

msgid "Changes can now be monitored using RSS."
msgstr "As alterações agora podem ser monitoradas usando RSS."

msgid "Improved support for RTL languages."
msgstr "Melhorado o suporte para idiomas RTL."

msgid "Weblate 1.2"
msgstr "Weblate 1.2"

msgid "*Released on August 14th 2012.*"
msgstr "*Atualizado em 14 de agosto de 2012.*"

msgid ""
"Weblate now uses South for database migration, please check upgrade "
"instructions if you are upgrading."
msgstr ""
"O Weblate agora usa o South para migração do banco de dados. Confira as "
"instruções de atualização se você estiver atualizando."

msgid "Fixed minor issues with linked git repos."
msgstr "Corrigidos pequenos problemas com repositórios git vinculados."

msgid ""
"New introduction page for engaging people with translating using Weblate."
msgstr ""
"Nova página de introdução para engajar as pessoas com tradução usando "
"Weblate."

msgid "Added widgets which can be used for promoting translation projects."
msgstr ""
"Adicionados widgets que podem ser usados para promover projetos de tradução."

msgid "Added option to reset repository to origin (for privileged users)."
msgstr ""
"Adicionada opção para redefinir o repositório para a origem (para usuários "
"privilegiados)."

msgid "Project or component can now be locked for translations."
msgstr "O projeto ou componente agora pode ser bloqueado para traduções."

msgid "Possibility to disable some translations."
msgstr "Possibilidade de desabilitar algumas traduções."

msgid "Configurable options for adding new translations."
msgstr "Opções configuráveis para adicionar novas traduções."

msgid "Configuration of git commits per project."
msgstr "Configuração de git commits por projeto."

msgid "Simple antispam protection."
msgstr "Proteção antispam simples."

msgid "Better layout of main page."
msgstr "Melhor layout da página principal."

msgid "Support for automatically pushing changes on every commit."
msgstr "Suporte para enviar automaticamente mudanças em cada commit."

msgid "Support for e-mail notifications of translators."
msgstr "Suporte para notificações por e-mail de tradutores."

msgid "List only used languages in preferences."
msgstr "Lista apenas os idiomas usados nas preferências."

msgid "Improved handling of not known languages when importing project."
msgstr ""
"Melhorado o tratamento de idiomas desconhecidos durante a importação de "
"projetos."

msgid "Support for locking translation by translator."
msgstr "Suporte para bloqueio de tradução por tradutor."

msgid "Optionally maintain ``Language-Team`` header in po file."
msgstr "Opcionalmente, mantém o cabeçalho ``Language-Team`` no arquivo po."

msgid "Include some statistics in about page."
msgstr "Inclui algumas estatísticas na página Sobre."

msgid "Supports (and requires) django-registration 0.8."
msgstr "Adiciona suporte (e exige) django-registration 0.8."

msgid "Caching counts of strings with failing checks."
msgstr "Fazer cache de contagens de textos contendo verificações com falha."

msgid "Checking of requirements during setup."
msgstr "Verificação de requisitos durante a configuração."

msgid "Weblate 1.1"
msgstr "Weblate 1.1"

msgid "*Released on July 4th 2012.*"
msgstr "*Atualizado em 4 de julho de 2012.*"

msgid "Improved several translations."
msgstr "Melhoradas várias traduções."

msgid "Added support for shared git repositories across components."
msgstr ""
"Adicionado suporte para repositórios git compartilhados entre componentes."

msgid "Do not necessary commit on every attempt to pull remote repo."
msgstr ""
"Não é necessário fazer commit em todas as tentativas de fazer pull do "
"repositório remoto."

msgid "Added support for offloading indexing."
msgstr "Adicionado suporte para descarregar a indexação."

msgid "Weblate 1.0"
msgstr "Weblate 1.0"

msgid "*Released on May 10th 2012.*"
msgstr "*Atualizado em 10 de maio de 2012.*"

msgid "Improved validation while adding/saving component."
msgstr "Melhorada a validação ao adicionar/salvar componente."

msgid "Experimental support for Android component files (needs patched ttkit)."
msgstr ""
"Suporte experimental para arquivos de componentes do Android (precisa de "
"ttkit com patch aplicado)."

msgid "Updates from hooks are run in background."
msgstr "As atualizações dos ganchos são executadas em segundo plano."

msgid "Improved installation instructions."
msgstr "Melhoradas as instruções de instalação."

msgid "Improved navigation in dictionary."
msgstr "Melhorada a navegação no dicionário."

msgid "Weblate 2.x series"
msgstr "Série 2.x do Weblate"

msgid "Weblate 2.20"
msgstr "Weblate 2.20"

msgid "*Released on April 4th 2018.*"
msgstr "*Atualizado em 4 de abril de 2018.*"

msgid "Improved speed of cloning subversion repositories."
msgstr "Melhorada a velocidade de clonagem de repositórios de subversion."

msgid "Changed repository locking to use third party library."
msgstr "Alterado o bloqueio de repositório para usar biblioteca de terceiros."

msgid "Added support for downloading only strings needing action."
msgstr "Adicionado suporte para baixar apenas textos que necessitam ação."

msgid "Added support for searching in several languages at once."
msgstr "Adicionado suporte para busca em vários idiomas ao mesmo tempo."

msgid "New add-on to configure gettext output wrapping."
msgstr "Novo complemento para configurar a quebra de linha da saída gettext."

msgid "New add-on to configure JSON formatting."
msgstr "Novo complemento para configurar a formatação JSON."

msgid ""
"Added support for authentication in API using RFC 6750 compatible Bearer "
"authentication."
msgstr ""
"Adicionado suporte para autenticação em API usando autenticação Bearer "
"compatível com RFC 6750."

msgid ""
"Added support for automatic translation using machine translation services."
msgstr ""
"Adicionado suporte para tradução automática usando serviços de tradução de "
"máquina."

msgid "Added support for HTML markup in whiteboard messages."
msgstr ""
"Adicionado suporte para marcação HTML em mensagens de quadro de comunicações."

msgid "Added support for mass changing state of strings."
msgstr "Adicionado suporte para alteração em massa do status dos textos."

msgid ""
"Translate-toolkit at least 2.3.0 is now required, older versions are no "
"longer supported."
msgstr ""
"O translate-toolkit pelo menos 2.3.0 agora é necessário, as versões mais "
"antigas não são mais suportadas."

msgid "Added built-in translation memory."
msgstr "Adicionada memória de tradução embutida."

msgid ""
"Added componentlists overview to dashboard and per component list overview "
"pages."
msgstr ""
"Adicionada uma visão geral com as listas de componentes ao painel e páginas "
"de visão geral de cada lista de componentes."

msgid "Added support for DeepL machine translation service."
msgstr "Adicionado suporte para serviço de tradução automática DeepL."

msgid "Machine translation results are now cached inside Weblate."
msgstr ""
"Os resultados da tradução automática agora são armazenados em cache no "
"Weblate."

msgid "Added support for reordering committed changes."
msgstr "Adicionado suporte para reordenar alterações de commits feitos."

msgid "Weblate 2.19.1"
msgstr "Weblate 2.19.1"

msgid "*Released on February 20th 2018.*"
msgstr "*Atualizado em 20 de fevereiro de 2018.*"

msgid "Fixed migration issue on upgrade from 2.18."
msgstr "Corrigido o problema de migração na atualização do 2.18."

msgid "Improved file upload API validation."
msgstr "Melhorada a validação de API de envio de arquivo."

msgid "Weblate 2.19"
msgstr "Weblate 2.19"

msgid "*Released on February 15th 2018.*"
msgstr "*Atualizado em 15 de fevereiro de 2018.*"

msgid "Fixed imports across some file formats."
msgstr "Corrigidas as importações em alguns formatos de arquivo."

msgid "Display human friendly browser information in audit log."
msgstr ""
"Exibe informações de navegador amigáveis para humanos no registro de "
"auditoria."

msgid "Added TMX exporter for files."
msgstr "Adicionado um exportador TMX para arquivos."

msgid "Various performance improvements for loading translation files."
msgstr "Várias melhorias de desempenho para carregar arquivos de tradução."

msgid ""
"Added option to disable access management in Weblate in favor of Django one."
msgstr ""
"Adicionada opção para desabilitar o gerenciamento de acesso no Weblate em "
"favor do gerenciamento do Django."

msgid "Improved glossary lookup speed for large strings."
msgstr "Melhorada a velocidade de busca de glossário para textos grandes."

msgid "Compatibility with django_auth_ldap 1.3.0."
msgstr "Compatibilidade com django_auth_ldap 1.3.0."

msgid "Configuration errors are now stored and reported persistently."
msgstr ""
"Os erros de configuração agora são armazenados e relatados de forma "
"persistente."

msgid "Honor ignore flags in whitespace autofixer."
msgstr "Honra ignorar marcadores na correção automática de espaço em branco."

msgid "Improved compatibility with some Subversion setups."
msgstr "Melhorada a compatibilidade com algumas configurações do Subversion."

msgid "Improved built-in machine translation service."
msgstr "Melhorado o serviço de tradução automática embutido."

msgid "Added support for SAP Translation Hub service."
msgstr "Adicionado suporte para serviço SAP Translation Hub."

msgid "Added support for Microsoft Terminology service."
msgstr "Adicionado suporte para serviço de Terminologia da Microsoft."

msgid "Removed support for advertisement in notification e-mails."
msgstr "Suporte removido para anúncio em e-mails de notificação."

msgid "Improved translation progress reporting at language level."
msgstr "Melhorado o relatório de progresso de tradução a nível de idioma."

msgid "Improved support for different plural formulas."
msgstr "Melhorado o suporte para diferentes fórmulas plurais."

msgid "Added support for Subversion repositories not using stdlayout."
msgstr ""
"Adicionado suporte para repositórios Subversion que não usam stdlayout."

msgid "Added add-ons to customize translation workflows."
msgstr "Adicionados complementos para personalizar fluxos de tradução."

msgid "Weblate 2.18"
msgstr "Weblate 2.18"

msgid "*Released on December 15th 2017.*"
msgstr "*Atualizado em 15 de dezembro de 2017.*"

msgid "Extended contributor stats."
msgstr "Estatísticas estendidas de colaborador."

msgid "Improved configuration of special characters virtual keyboard."
msgstr "Melhor configuração do teclado virtual de caracteres especiais."

msgid "Added support for DTD file format."
msgstr "Adicionado suporte para formato de arquivo DTD."

msgid ""
"Changed keyboard shortcuts to less likely collide with browser/system ones."
msgstr ""
"Alterados os atalhos do teclado para reduzir a chance de colisão com os do "
"navegador/sistema."

msgid "Improved support for approved flag in XLIFF files."
msgstr "Melhorado o suporte para marcador de aprovado em arquivos XLIFF."

msgid "Added support for not wrapping long strings in gettext PO files."
msgstr ""
"Adicionado suporte para não agrupar textos longos em arquivos PO gettext."

msgid "Added button to copy permalink for current translation."
msgstr "Adicionado botão para copiar o link permanente para a tradução atual."

msgid "Dropped support for Django 1.10 and added support for Django 2.0."
msgstr "Removido o suporte ao Django 1.10 e adicionado suporte ao Django 2.0."

msgid "Removed locking of translations while translating."
msgstr "Removido o bloqueio de traduções durante a tradução."

msgid "Added support for adding new strings to monolingual translations."
msgstr ""
"Adicionado suporte para adicionar novos textos a traduções monolíngues."

msgid "Added support for translation workflows with dedicated reviewers."
msgstr "Adicionado suporte para fluxos de tradução com revisores dedicados."

msgid "Weblate 2.17.1"
msgstr "Weblate 2.17.1"

msgid "*Released on October 13th 2017.*"
msgstr "*Atualizado em 13 de outubro de 2017.*"

msgid "Fixed running testsuite in some specific situations."
msgstr ""
"Corrigido o conjunto de testes em execução em algumas situações específicas."

msgid "Locales updates."
msgstr "Atualizações de localidades."

msgid "Weblate 2.17"
msgstr "Weblate 2.17"

msgid "Weblate by default does shallow Git clones now."
msgstr "O Weblate por padrão agora faz clones rasos do Git."

msgid "Improved performance when updating large translation files."
msgstr "Melhorado o desempenho ao atualizar grandes arquivos de tradução."

msgid "Added support for blocking certain e-mails from registration."
msgstr "Adicionado suporte para bloquear o registro de certos e-mails."

msgid "Users can now delete their own comments."
msgstr "Os usuários agora podem excluir seus próprios comentários."

msgid "Added preview step to search and replace feature."
msgstr ""
"Adicionada etapa de visualização para a função de busca e substituição."

msgid "Client side persistence of settings in search and upload forms."
msgstr ""
"Persistência das configurações do lado do cliente em formulários de busca e "
"envio."

msgid "Extended search capabilities."
msgstr "Capacidades de busca estendidos."

msgid "More fine grained per project ACL configuration."
msgstr "Mais granularidade por configuração de ACL do projeto."

msgid "Default value of BASE_DIR has been changed."
msgstr "O valor padrão de BASE_DIR foi alterado."

msgid "Added two step account removal to prevent accidental removal."
msgstr ""
"Adicionada a remoção da conta em duas etapas para evitar a remoção acidental."

msgid "Project access control settings is now editable."
msgstr ""
"As configurações de controle de acesso do projeto agora podem ser editadas."

msgid "Added optional spam protection for suggestions using Akismet."
msgstr ""
"Adicionada proteção opcional contra spam para sugestões usando Akismet."

msgid "Weblate 2.16"
msgstr "Weblate 2.16"

msgid "*Released on August 11th 2017.*"
msgstr "*Atualizado em 11 de agosto de 2017.*"

msgid "Added support for nested JSON format."
msgstr "Adicionado suporte para o formato JSON aninhado."

msgid "Added support for WebExtension JSON format."
msgstr "Adicionado suporte para o formato WebExtension JSON."

msgid "Fixed git exporter authentication."
msgstr "Corrigida a autenticação com exportador git."

msgid "Improved CSV import in certain situations."
msgstr "Melhorada a importação de CSV em certas situações."

msgid "Improved look of Other translations widget."
msgstr "Melhorada a aparência do widget Outras traduções."

msgid "The max-length checks is now enforcing length of text in form."
msgstr ""
"As verificações de comprimento máximo agora estão impondo o comprimento do "
"texto no formulário."

msgid "Make the commit_pending age configurable per component."
msgstr "Torna a idade de commit_pending configurável por componente."

msgid "Various user interface cleanups."
msgstr "Várias limpezas de interface do usuário."

msgid "Fixed component/project/site wide search for translations."
msgstr "Corrigida a busca em componente /projeto/tido o site por traduções."

msgid "Weblate 2.15"
msgstr "Weblate 2.15"

msgid "*Released on June 30th 2017.*"
msgstr "*Atualizado em 30 de junho de 2017.*"

msgid "Show more related translations in other translations."
msgstr "Mostra mais traduções relacionadas em outras traduções."

msgid "Add option to see translations of current string to other languages."
msgstr "Adiciona a opção de ver as traduções do texto atual em outros idiomas."

msgid "Use 4 plural forms for Lithuanian by default."
msgstr "Usa 4 formas plurais para lituano por padrão."

msgid "Fixed upload for monolingual files of different format."
msgstr "Corrigido o envio para arquivos monolíngues de formato diferente."

msgid "Improved error messages on failed authentication."
msgstr "Melhoradas as mensagens de erro na autenticação com falha."

msgid "Keep page state when removing word from glossary."
msgstr "Mantelém o status da página ao remover a palavra do glossário."

msgid "Added direct link to edit secondary language translation."
msgstr "Adicionado link direto para editar a tradução do idioma secundário."

msgid "Added Perl format quality check."
msgstr "Adicionada verificação de qualidade do formato Perl."

msgid "Added support for rejecting reused passwords."
msgstr "Adicionado suporte para rejeitar senhas reutilizadas."

msgid "Extended toolbar for editing RTL languages."
msgstr "Estendida a barra de ferramentas para edição de idiomas RTL."

msgid "Weblate 2.14.1"
msgstr "Weblate 2.14.1"

msgid "*Released on May 24th 2017.*"
msgstr "*Atualizado em 24 de maio de 2017.*"

msgid "Fixed possible error when paginating search results."
msgstr "Corrigido um possível erro ao paginar os resultados da busca."

msgid "Fixed migrations from older versions in some corner cases."
msgstr ""
"Corrigidas as migrações de versões mais antigas em alguns casos complexos."

msgid "Fixed possible CSRF on project watch and unwatch."
msgstr "Corrigido possível CSRF ao monitorar e deixar de monitorar um projeto."

msgid "The password reset no longer authenticates user."
msgstr "A redefinição de senha não autentica mais o usuário."

msgid "Fixed possible CAPTCHA bypass on forgotten password."
msgstr "Corrigido um possível desvio de CAPTCHA em caso de senha esquecida."

msgid "Weblate 2.14"
msgstr "Weblate 2.14"

msgid "*Released on May 17th 2017.*"
msgstr "*Atualizado em 17 de maio de 2017.*"

msgid "Add glossary entries using AJAX."
msgstr "Adiciona entradas de glossário usando AJAX."

msgid "The logout now uses POST to avoid CSRF."
msgstr "O logout agora usa POST para evitar CSRF."

msgid "The API key token reset now uses POST to avoid CSRF."
msgstr ""
"A redefinição do token da chave de API usa agora POST para evitar CSRF."

msgid "Weblate sets Content-Security-Policy by default."
msgstr "Weblate define Content-Security-Policy por padrão."

msgid "The local editor URL is validated to avoid self-XSS."
msgstr "A URL do editor local é validada para evitar auto-XSS."

msgid "The password is now validated against common flaws by default."
msgstr "A senha agora é validada contra falhas comuns por padrão."

msgid ""
"Notify users about important activity with their account such as password "
"change."
msgstr ""
"Notifique os usuários sobre atividades importantes em suas contas, como "
"alteração de senha."

msgid "The CSV exports now escape potential formulas."
msgstr "As exportações de CSV agora escapam de fórmulas potenciais."

msgid "Various minor improvements in security."
msgstr "Várias pequenas melhorias na segurança."

msgid "The authentication attempts are now rate limited."
msgstr "As tentativas de autenticação agora têm taxa limitada."

msgid "Suggestion content is stored in the history."
msgstr "O conteúdo da sugestão é armazenado no histórico."

msgid "Store important account activity in audit log."
msgstr "Armazena atividades importantes da conta no registro de auditoria."

msgid ""
"Ask for password confirmation when removing account or adding new "
"associations."
msgstr ""
"Pede a confirmação da senha ao remover a conta ou adicionar novas "
"associações."

msgid "Show time when suggestion has been made."
msgstr "Mostra a hora em que a sugestão foi feita."

msgid "There is new quality check for trailing semicolon."
msgstr "Há uma nova verificação de qualidade para o ponto-e-vírgula à direita."

msgid "Ensure that search links can be shared."
msgstr "Garante que os links de busca podem ser compartilhados."

msgid "Included source string information and screenshots in the API."
msgstr "Incluídas informações do texto fonte e capturas de tela na API."

msgid "Allow to overwrite translations through API upload."
msgstr "Permite sobrescrever traduções por meio de envio pela API."

msgid "Weblate 2.13.1"
msgstr "Weblate 2.13.1"

msgid "*Released on Apr 12th 2017.*"
msgstr "*Atualizado em 12 de abril de 2017.*"

msgid "Fixed listing of managed projects in profile."
msgstr "Corrigida a listagem de projetos gerenciados no perfil."

msgid "Fixed migration issue where some permissions were missing."
msgstr ""
"Corrigido o problema de migração em que algumas permissões estavam faltando."

msgid "Fixed listing of current file format in translation download."
msgstr "Corrigida a listagem do formato de arquivo atual ao baixar a tradução."

msgid ""
"Return HTTP 404 when trying to access project where user lacks privileges."
msgstr ""
"Retorna HTTP 404 ao tentar acessar o projeto onde o usuário não tem "
"privilégios."

msgid "Weblate 2.13"
msgstr "Weblate 2.13"

msgid "Fixed quality checks on translation templates."
msgstr "Corrigidas verificações de qualidade em modelos de tradução."

msgid "Added quality check to trigger on losing translation."
msgstr "Adicionada verificação de qualidade para acionar na perda de tradução."

msgid "Add option to view pending suggestions from user."
msgstr "Adiciona uma opção para ver sugestões pendentes de um usuário."

msgid "Add option to automatically build component lists."
msgstr "Adiciona opção para construir listas de componentes automaticamente."

msgid "Default dashboard for unauthenticated users can be configured."
msgstr "O painel padrão para usuários não autenticados pode ser configurado."

msgid "Add option to browse 25 random strings for review."
msgstr "Adiciona a opção de navegar por 25 textos aleatórios para revisão."

msgid "History now indicates string change."
msgstr "O histórico agora indica mudança de texto."

msgid "Better error reporting when adding new translation."
msgstr "Melhor relatório de erros ao adicionar uma nova tradução."

msgid "Added per language search within project."
msgstr "Adicionado busca por idioma dentro do projeto."

msgid "Group ACLs can now be limited to certain permissions."
msgstr "ACLs de grupo agora podem ser limitados a certas permissões."

msgid "The per project ACLs are now implemented using Group ACL."
msgstr "Os ACLs por projeto agora são implementados usando ACL de grupo."

msgid "Added more fine grained privileges control."
msgstr "Adicionado controle de privilégios mais refinado."

msgid "Various minor UI improvements."
msgstr "Várias pequenas melhorias na interface do usuário."

msgid "Weblate 2.12"
msgstr "Weblate 2.12"

msgid "*Released on Mar 3rd 2017.*"
msgstr "*Atualizado em 3 de março de 2017.*"

msgid "Improved admin interface for groups."
msgstr "Melhorada a interface administrativa para grupos."

msgid "Added support for Yandex Translate API."
msgstr "Adicionado suporte à API do Yandex Translate."

msgid "Improved speed of site wide search."
msgstr "Maior velocidade de busca em todo o site."

msgid "Added project and component wide search."
msgstr "Adicionada busca ampla de projeto e componente."

msgid "Added project and component wide search and replace."
msgstr "Adicionada busca e substituição em todo o projeto e componente."

msgid "Improved rendering of inconsistent translations."
msgstr "Melhorada a renderização de traduções inconsistentes."

msgid "Added support for opening source files in local editor."
msgstr "Adicionado suporte para abrir arquivos fonte no editor local."

msgid "Added support for configuring visual keyboard with special characters."
msgstr ""
"Adicionado suporte para configuração de teclado visual com caracteres "
"especiais."

msgid ""
"Improved screenshot management with OCR support for matching source strings."
msgstr ""
"Melhorado o gerenciamento de captura de tela com suporte OCR para "
"correspondência de textos fonte."

msgid "Default commit message now includes translation information and URL."
msgstr ""
"A mensagem de commit padrão agora inclui informações de tradução e URL."

msgid "Added support for Joomla translation format."
msgstr "Adicionado suporte para o formato de tradução do Joomla."

msgid "Improved reliability of import across file formats."
msgstr "Maior confiabilidade de importação em formatos de arquivo."

msgid "Weblate 2.11"
msgstr "Weblate 2.11"

msgid "*Released on Jan 31st 2017.*"
msgstr "*Atualizado em 31 de janeiro de 2017.*"

msgid "Include language detailed information on language page."
msgstr "Inclui informações detalhadas sobre o idioma na página de idioma."

msgid "Mercurial backend improvements."
msgstr "Melhorias no back-end do Mercurial."

msgid "Added option to specify translation component priority."
msgstr ""
"Adicionada opção para especificar a prioridade do componente de tradução."

msgid "More consistent usage of Group ACL even with less used permissions."
msgstr ""
"Uso mais consistente da ACL de grupo, mesmo com menos permissões usadas."

msgid "Added WL_BRANCH variable to hook scripts."
msgstr "Adicionada variável WL_BRANCH para criar scripts."

msgid "Improved developer documentation."
msgstr "Melhorada a documentação de desenvolvedor."

msgid "Better compatibility with various Git versions in Git exporter add-on."
msgstr ""
"Melhor compatibilidade com várias versões git no complemento do exportador "
"git."

msgid "Included per project and component stats."
msgstr "Incluído por projeto e estatísticas de componentes."

msgid ""
"Added language code mapping for better support of Microsoft Translate API."
msgstr ""
"Adicionado mapeamento de código de idioma para melhor suporte da API do "
"Microsoft Translate."

msgid ""
"Moved fulltext cleanup to background job to make translation removal faster."
msgstr ""
"A limpeza do texto completo foi movida para o trabalho em segundo plano para "
"tornar a remoção da tradução mais rápida."

msgid ""
"Fixed displaying of plural source for languages with single plural form."
msgstr "Exibição fixa de fonte plural para idiomas com forma plural única."

msgid "Improved error handling in import_project."
msgstr "Melhorado o tratamento de erros em import_project."

msgid "Weblate 2.10.1"
msgstr "Weblate 2.10.1"

msgid "*Released on Jan 20th 2017.*"
msgstr "*Atualizado em 20 de janeiro de 2017.*"

msgid ""
"Do not leak account existence on password reset form (:cve:`2017-5537`)."
msgstr ""
"Não revele a existência da conta no formulário de redefinição de senha "
"(:cve:`2017-5537`)."

msgid "Weblate 2.10"
msgstr "Weblate 2.10"

msgid "*Released on Dec 15th 2016.*"
msgstr "*Atualizado em 15 de dezembro de 2016.*"

msgid ""
"Added quality check to check whether plurals are translated differently."
msgstr ""
"Adicionada verificação de qualidade para verificar se os plurais são "
"traduzidos de forma diferente."

msgid "Fixed GitHub hooks for repositories with authentication."
msgstr "Corrigidos ganchos so GitHub para repositórios com autenticação."

msgid "Added optional Git exporter module."
msgstr "Adicionado módulo opcional de exportador git."

msgid "Support for Microsoft Cognitive Services Translator API."
msgstr "Suporte para API Microsoft Cognitive Services Translator."

msgid "Simplified project and component user interface."
msgstr "Simplificadas as interfaces de usuário de projeto e componente."

msgid "Added automatic fix to remove control characters."
msgstr "Adicionada correção automática para remover caracteres de controle."

msgid "Added per language overview to project."
msgstr "Adicionada visão geral por idioma ao projeto."

msgid "Added support for CSV export."
msgstr "Adicionado suporte para exportação de CSV."

msgid "Added CSV download for stats."
msgstr "Adicionado download de CSV para estatísticas."

msgid "Added matrix view for quick overview of all translations."
msgstr ""
"Adicionada visualização de matriz para uma visão geral rápida de todas as "
"traduções."

msgid "Added basic API for changes and strings."
msgstr "Adicionada API básica para mudanças e textos."

msgid "Added support for Apertium APy server for machine translations."
msgstr ""
"Adicionado suporte ao servidor Apertium APy para traduções automáticas."

msgid "Weblate 2.9"
msgstr "Weblate 2.9"

msgid "*Released on Nov 4th 2016.*"
msgstr "*Atualizado em 4 de novembro de 2016.*"

msgid "Extended parameters for createadmin management command."
msgstr "Parâmetros estendidos para o comando de gerenciamento createadmin."

msgid "Extended import_json to be able to handle with existing components."
msgstr ""
"Estendido import_json para ser capaz de lidar com componentes existentes."

msgid "Added support for YAML files."
msgstr "Adicionado suporte para arquivos YAML."

msgid ""
"Project owners can now configure translation component and project details."
msgstr ""
"Donos de projeto agora podem configurar detalhes de componente e projeto de "
"tradução."

msgid "Use \"Watched\" instead of \"Subscribed\" projects."
msgstr "Usa projetos \"Observados\" em vez de \"Assinados\"."

msgid "Projects can be watched directly from project page."
msgstr ""
"Projetos podem ser monitorados diretamente a partir da página do projeto."

msgid "Added multi language status widget."
msgstr "Adicionado widget de status multi-idioma."

msgid "Highlight secondary language if not showing source."
msgstr "Realça o idioma secundário se não mostrar o fonte."

msgid "Record suggestion deletion in history."
msgstr "Registra exclusão de sugestão no histórico."

msgid "Improved UX of languages selection in profile."
msgstr "Melhorada a UX de seleção de idiomas no perfil."

msgid "Fixed showing whiteboard messages for component."
msgstr ""
"Corrigida a exibição de mensagens do quadro de comunicações de componente."

msgid "Keep preferences tab selected after saving."
msgstr "Mantém a aba de preferências selecionada após salvar."

msgid "Show source string comment more prominently."
msgstr "Mostra o comentário do texto fonte com mais destaque."

msgid "Automatically install Gettext PO merge driver for Git repositories."
msgstr ""
"Instala automaticamente o driver de mesclagem Gettext PO para repositórios "
"Git."

msgid "Added search and replace feature."
msgstr "Adicionado recurso de busca e substituição."

msgid ""
"Added support for uploading visual context (screenshots) for translations."
msgstr ""
"Adicionado suporte para enviar contexto visual (captura de telas) para "
"traduções."

msgid "Weblate 2.8"
msgstr "Weblate 2.8"

msgid "*Released on Aug 31st 2016.*"
msgstr "*Atualizado em 31 de agosto de 2016.*"

msgid "Translations."
msgstr "Traduções."

msgid "Updated bundled JavaScript libraries."
msgstr "Atualizadas as bibliotecas JavaScript empacotadas."

msgid "Added list_translators management command."
msgstr "Adicionado o comando de gerenciamento list_translators."

msgid "Django 1.8 is no longer supported."
msgstr "Django 1.8 não é mais compatível."

msgid "Fixed compatibility with Django 1.10."
msgstr "Corrigida a compatibilidade com Django 1.10."

msgid "Added Subversion support."
msgstr "Adicionado suporte a Subversion."

msgid "Separated XML validity check from XML mismatched tags."
msgstr ""
"A verificação de validade de XML foi separada de tags XML incompatíveis."

msgid "Fixed API to honor HIDE_REPO_CREDENTIALS settings."
msgstr ""
"Corrigida a API para respeitar as configurações de HIDE_REPO_CREDENTIALS."

msgid "Show source change in Zen mode."
msgstr "Mostra a alteração do fonte no modo Zen."

msgid "Alt+PageUp/PageDown/Home/End now works in Zen mode as well."
msgstr "Alt+PageUp/PageDown/Home/End agora funciona no modo Zen também."

msgid "Add tooltip showing exact time of changes."
msgstr "Adiciona uma dica de ferramenta mostrando a hora exata das alterações."

msgid "Add option to select filters and search from translation page."
msgstr ""
"Adiciona uma opção para selecionar filtros e buscar na página de tradução."

msgid "Added UI for translation removal."
msgstr "Adicionada UI para remoção de tradução."

msgid "Improved behavior when inserting placeables."
msgstr "Melhorado o comportamento ao inserir objetos colocáveis."

msgid "Fixed auto locking issues in Zen mode."
msgstr "Corrigidos problemas de bloqueio automático no modo Zen."

msgid "Weblate 2.7"
msgstr "Weblate 2.7"

msgid "*Released on Jul 10th 2016.*"
msgstr "*Atualizado em 10 de julho de 2016.*"

msgid "Removed Google web translate machine translation."
msgstr "Removida a tradução automática do Google Web Translate."

msgid "Improved commit message when adding translation."
msgstr "Melhorada a mensagem de commit ao adicionar tradução."

msgid "Fixed Google Translate API for Hebrew language."
msgstr "Corrigida a API do Google Tradutor para o idioma hebraico."

msgid "Compatibility with Mercurial 3.8."
msgstr "Compatibilidade com Mercurial 3.8."

msgid "Added import_json management command."
msgstr "Adicionado comando de gerenciamento import_json."

msgid "Correct ordering of listed translations."
msgstr "Ordenação correta das traduções listadas."

msgid "Show full suggestion text, not only a diff."
msgstr "Mostra o texto completo da sugestão, não apenas uma diferença."

msgid "Extend API (detailed repository status, statistics, …)."
msgstr "Estende a API (status de repositório detalhado, estatísticas, ...)."

msgid "Testsuite no longer requires network access to test repositories."
msgstr ""
"O conjunto de testes não requer mais acesso à rede para testar repositórios."

msgid "Weblate 2.6"
msgstr "Weblate 2.6"

msgid "*Released on Apr 28th 2016.*"
msgstr "*Atualizado em 28 de abril de 2016.*"

msgid "Fixed validation of components with language filter."
msgstr "Coeeigida a validação de componentes com filtro de idioma."

msgid "Improved support for XLIFF files."
msgstr "Melhorado suporte para arquivos XLIFF."

msgid "Fixed machine translation for non English sources."
msgstr "Corrigida a tradução automática para fontes não inglesas."

msgid "Added REST API."
msgstr "Adicionada API REST."

msgid "Django 1.10 compatibility."
msgstr "Compatibilidade com Django 1.10."

msgid "Added categories to whiteboard messages."
msgstr "Adicionadas categorias às mensagens do quadro de comunicações."

msgid "Weblate 2.5"
msgstr "Weblate 2.5"

msgid "*Released on Mar 10th 2016.*"
msgstr "*Atualizado em 10 de março de 2016.*"

msgid "Fixed automatic translation for project owners."
msgstr "Corrigida a tradução automática para proprietários de projetos."

msgid "Improved performance of commit and push operations."
msgstr "Melhorado o desempenho de operações de commit e push."

msgid "New management command to add suggestions from command-line."
msgstr ""
"Novo comando de gerenciamento para adicionar sugestões a partir da linha de "
"comando."

msgid "Added support for merging comments on file upload."
msgstr "Adicionado suporte para mesclar comentários ao enviar arquivo."

msgid "Added support for some GNU extensions to C printf format."
msgstr ""
"Adicionado suporte para alguns complementos GNU ao formato printf da "
"linguagem C."

msgid "Added support for generating translator credits."
msgstr "Adicionado suporte para gerar créditos de tradutores."

msgid "Added support for generating contributor stats."
msgstr "Adicionado suporte para gerar estatísticas de colaboradores."

msgid "Site wide search can search only in one language."
msgstr "A busca em todo o site pode procurar apenas em um idioma."

msgid "Improve quality checks for Armenian."
msgstr "Melhora as verificações de qualidade para armênio."

msgid ""
"Support for starting translation components without existing translations."
msgstr "Suporte para iniciar componentes de tradução sem traduções existentes."

msgid "Support for adding new translations in Qt TS."
msgstr "Suporte para adicionar novas traduções em Qt TS."

msgid "Improved support for translating PHP files."
msgstr "Melhorado suporte para tradução de arquivos PHP."

msgid "Performance improvements for quality checks."
msgstr "Melhorias de desempenho para verificações de qualidade."

msgid "Fixed site wide search for failing checks."
msgstr "Corrigida a busca para todo o site por verificações com falha."

msgid "Added option to specify source language."
msgstr "Adicionada opção para especificar o idioma fonte."

msgid "Extended list of options for import_project."
msgstr "Estendida a lista de opções para import_project."

msgid "Improved targeting for whiteboard messages."
msgstr "Melhoria da segmentação para mensagens do quadro de avisos."

msgid "Support for automatic translation across projects."
msgstr "Suporte para tradução automática entre projetos."

msgid "Optimized fulltext search index."
msgstr "Otimizado o índice de busca de texto completo."

msgid "Added management command for auto translation."
msgstr "Adicionado comando de gerenciamento para tradução automática."

msgid "Added placeables highlighting."
msgstr "Adicionado realce de objetos colocáveis."

msgid ""
"Added keyboard shortcuts for placeables, checks and machine translations."
msgstr ""
"Adicionado teclas de atalho para objetos colocáveis, verificações e "
"traduções automáticas."

msgid "Improved translation locking."
msgstr "Melhorado o bloqueio de tradução."

msgid "Added quality check for AngularJS interpolation."
msgstr "Adicionada verificação de qualidade para interpolação AngularJS."

msgid "Added extensive group based ACLs."
msgstr "Adicionadas ACLs extensivas baseadas em grupos ."

msgid "Clarified terminology on strings needing edit (formerly fuzzy)."
msgstr ""
"Esclarecida a terminologia sobre textis que necessitam edição (anteriormente "
"\"fuzzy\")."

msgid ""
"Clarified terminology on strings needing action and untranslated strings."
msgstr ""
"Esclarecida a terminologia sobre textos que necessitam ação e textos não "
"traduzidas."

msgid "Support for Python 3."
msgstr "Suporte para Python 3."

msgid "Dropped support for Django 1.7."
msgstr "Removido o suporte ao Django 1.7."

msgid "Dropped dependency on msginit for creating new gettext PO files."
msgstr ""
"Removida a dependência do msginit para a criação de novos arquivos gettext "
"PO."

msgid "Added configurable dashboard views."
msgstr "Adicionadas visualizações de painel configuráveis."

msgid "Improved notifications on parse errors."
msgstr "Melhoradas notificações sobre erros de análise."

msgid ""
"Added option to import components with duplicate name to import_project."
msgstr ""
"Adicionada opção para importar componentes com nome duplicado para "
"import_project."

msgid "Added XLIFF export for dictionary."
msgstr "Adicionada exportação XLIFF para dicionário."

msgid "Added XLIFF and gettext PO export for all translations."
msgstr "Adicionada exportação de XLIFF e gettext PO para todas as traduções."

msgid "Added support for configurable automatic group assignments."
msgstr ""
"Adicionado suporte para atribuições de grupo automáticas configuráveis."

msgid "Improved adding of new translations."
msgstr "Melhorada a adição de novas traduções."

msgid "Weblate 2.4"
msgstr "Weblate 2.4"

msgid "*Released on Sep 20th 2015.*"
msgstr "*Atualizado em 20 de setembro de 2015.*"

msgid "Improved support for PHP files."
msgstr "Melhorado o suporte para arquivos PHP."

msgid "Ability to add ACL to anonymous user."
msgstr "Capacidade de adicionar ACL a usuário anônimo."

msgid "Improved configurability of import_project command."
msgstr "Melhorada a capacidade de configuração do comando import_project."

msgid "Added CSV dump of history."
msgstr "Adicionado despejo de histórico em CSV."

msgid "Avoid copy/paste errors with whitespace characters."
msgstr "Evita erros de copiar/colar com caracteres de espaço em branco."

msgid "Added support for Bitbucket webhooks."
msgstr "Adicionado suporte para webhooks do Bitbucket."

msgid "Tighter control on fuzzy strings on translation upload."
msgstr "Controle mais rígido em textos aproximados ao enviar a tradução."

msgid "Several URLs have changed, you might have to update your bookmarks."
msgstr ""
"Várias URLs foram alteradas, pode ser necessário atualizar seus favoritos."

msgid "Hook scripts are executed with VCS root as current directory."
msgstr ""
"Os scripts de gancho são executados com a raiz VCS como diretório atual."

msgid ""
"Hook scripts are executed with environment variables describing current "
"component."
msgstr ""
"Os scripts de gancho são executados com variáveis de ambiente que descrevem "
"o componente atual."

msgid "Add management command to optimize fulltext index."
msgstr ""
"Adiciona o comando de gerenciamento para otimizar o índice de texto completo."

msgid "Added support for error reporting to Rollbar."
msgstr "Adicionado suporte para relatórios de erros para Rollbar."

msgid "Projects now can have multiple owners."
msgstr "Os projetos agora podem ter vários donos."

msgid "Project owners can manage themselves."
msgstr "Donos de projeto podem gerenciar a si próprio."

msgid "Added support for ``javascript-format`` used in gettext PO."
msgstr "Adicionado suporte para ``javascript-format`` usado em gettext PO."

msgid "Support for adding new translations in XLIFF."
msgstr "Suporte para adicionar novas traduções em XLIFF."

msgid "Improved file format autodetection."
msgstr "Melhorada a autodetecção de formato de arquivo."

msgid "Extended keyboard shortcuts."
msgstr "Teclas de atalho estendidas."

msgid "Improved dictionary matching for several languages."
msgstr "Melhor correspondência de dicionário para vários idiomas."

msgid "Improved layout of most of pages."
msgstr "Melhorado o layout da maioria das páginas."

msgid "Support for adding words to dictionary while translating."
msgstr "Suporte para adicionar palavras ao dicionário durante a tradução."

msgid "Added support for filtering languages to be managed by Weblate."
msgstr ""
"Adicionado suporte para filtragem de idiomas a serem gerenciados pelo "
"Weblate."

msgid "Added support for translating and importing CSV files."
msgstr "Adicionado suporte para tradução e importação de arquivos CSV."

msgid "Rewritten handling of static files."
msgstr "Reescrito o tratamento de arquivos estáticos."

msgid ""
"Direct login/registration links to third-party service if that's the only "
"one."
msgstr ""
"Links diretos de login/registro para serviço de terceiros, se for o único."

msgid "Commit pending changes on account removal."
msgstr "Faz commit de alterações pendentes na remoção da conta."

msgid "Add management command to change site name."
msgstr "Adiciona o comando de gerenciamento para alterar o nome do site."

msgid "Add option to configure default committer."
msgstr "Adiciona a opção para configurar o committer padrão."

msgid "Add hook after adding new translation."
msgstr "Adiciona um gancho após adicionar uma nova tradução."

msgid "Add option to specify multiple files to add to commit."
msgstr ""
"Adiciona opção para especificar vários arquivos para adicionar para commit."

msgid "Weblate 2.3"
msgstr "Weblate 2.3"

msgid "*Released on May 22nd 2015.*"
msgstr "*Atualizado em 22 de maio de 2015.*"

msgid "Dropped support for Django 1.6 and South migrations."
msgstr "Removido o suporte a migrações para Django 1.6 e South."

msgid "Support for adding new translations when using Java Property files."
msgstr ""
"Suporte para adicionar novas traduções ao usar arquivos de propriedade Java."

msgid "Allow to accept suggestion without editing."
msgstr "Permita aceitar sugestão sem edição."

msgid "Improved support for Google OAuth 2.0."
msgstr "Melhorado o suporte para Google OAuth 2.0."

msgid "Added support for Microsoft .resx files."
msgstr "Adicionado suporte para arquivos .resx da Microsoft."

msgid "Tuned default robots.txt to disallow big crawling of translations."
msgstr ""
"O robots.txt padrão ajustado para impedir o grande rastreamento de traduções."

msgid "Simplified workflow for accepting suggestions."
msgstr "Fluxo de trabalho simplificado para aceitar sugestões."

msgid "Added project owners who always receive important notifications."
msgstr ""
"Adicionados donos de projetos que sempre recebem notificações importantes."

msgid "Allow to disable editing of monolingual template."
msgstr "Permite desabilitar a edição do modelo monolíngue."

msgid "More detailed repository status view."
msgstr "Visualização mais detalhada do status do repositório."

msgid "Direct link for editing template when changing translation."
msgstr "Link direto para editar o modelo ao alterar a tradução."

msgid "Allow to add more permissions to project owners."
msgstr "Permitir adicionar mais permissões aos donos do projeto."

msgid "Allow to show secondary language in Zen mode."
msgstr "Permite mostrar o idioma secundário no modo Zen."

msgid "Support for hiding source string in favor of secondary language."
msgstr "Suporte para ocultar o texto fonte em favor do idioma secundário."

msgid "Weblate 2.2"
msgstr "Weblate 2.2"

msgid "*Released on Feb 19th 2015.*"
msgstr "*Atualizado em 19 de fevereiro de 2015.*"

msgid "Performance improvements."
msgstr "Melhorias de desempenho."

msgid "Fulltext search on location and comments fields."
msgstr "Busca por texto completo nos campos de localização e comentários."

msgid "New SVG/JavaScript-based activity charts."
msgstr "Novos gráficos de atividades baseados em SVG/JavaScript."

msgid "Support for Django 1.8."
msgstr "Suporte para Django 1.8."

msgid "Support for deleting comments."
msgstr "Suporte para exclusão de comentários."

msgid "Added own SVG badge."
msgstr "Adicionado o próprio emblema SVG."

msgid "Added support for Google Analytics."
msgstr "Adicionado suporte para o Google Analytics."

msgid "Improved handling of translation filenames."
msgstr "Melhorado o tratamento de nomes de arquivos de tradução."

msgid "Added support for monolingual JSON translations."
msgstr "Adicionado suporte para traduções JSON monolíngues."

msgid "Record component locking in a history."
msgstr "Registra o bloqueio de componentes em um histórico."

msgid ""
"Support for editing source (template) language for monolingual translations."
msgstr ""
"Suporte para edição de idioma fonte (modelo) para traduções monolíngues."

msgid "Added basic support for Gerrit."
msgstr "Adicionado suporte básico para Gerrit."

msgid "Weblate 2.1"
msgstr "Weblate 2.1"

msgid "*Released on Dec 5th 2014.*"
msgstr "*Atualizado em 5 de dezembro de 2014.*"

msgid "Added support for Mercurial repositories."
msgstr "Adicionado suporte para repositórios Mercurial."

msgid "Replaced Glyphicon font by Awesome."
msgstr "Fonte Glyphicon substituída por Awesome."

msgid "Added icons for social authentication services."
msgstr "Adicionados ícones para serviços de autenticação social."

msgid "Better consistency of button colors and icons."
msgstr "Melhor consistência das cores e ícones dos botões."

msgid "Various bugfixes."
msgstr "Várias correções de bugs."

msgid "Automatic hiding of columns in translation listing for small screens."
msgstr ""
"Ocultação automática de colunas na listagem de tradução para telas pequenas."

msgid "Changed configuration of filesystem paths."
msgstr "Alterada a configuração dos caminhos do sistema de arquivos."

msgid "Improved SSH keys handling and storage."
msgstr "Melhorado o tratamento e armazenamento de chaves SSH."

msgid "Improved repository locking."
msgstr "Melhorado o bloqueio de repositório."

msgid "Customizable quality checks per source string."
msgstr "Verificações de qualidade personalizadas por texto fonte."

msgid "Allow to hide completed translations from dashboard."
msgstr "Permite ocultar traduções concluídas a partir do painel."

msgid "Weblate 2.0"
msgstr "Weblate 2.0"

msgid "*Released on Nov 6th 2014.*"
msgstr "*Atualizado em 6 de novembro de 2014.*"

msgid "New responsive UI using Bootstrap."
msgstr "Nova UI responsiva usando Bootstrap."

msgid "Rewritten VCS backend."
msgstr "Backend VCS reescrito."

msgid "Added whiteboard for site wide messages."
msgstr "Adicionado quadro de comunicações para mensagens para todo o site."

msgid "Configurable strings priority."
msgstr "Prioridade de textos configurável."

msgid "Added support for JSON file format."
msgstr "Adicionado suporte ao formato de arquivo JSON."

msgid "Fixed generating mo files in certain cases."
msgstr "Corrigida a geração de arquivos mo em certos casos."

msgid "Added support for GitLab notifications."
msgstr "Adicionado suporte a notificações do GitLab."

msgid "Added support for disabling translation suggestions."
msgstr "Adicionado suporte a desabilitar sugestões de tradução."

msgid "Django 1.7 support."
msgstr "Suporte ao Django 1.7."

msgid "ACL projects now have user management."
msgstr "Os projetos com ACL agora têm gerenciamento de usuários."

msgid "Extended search possibilities."
msgstr "Estendidas as possibilidades de busca."

msgid "Give more hints to translators about plurals."
msgstr "Fornece mais dicas aos tradutores sobre os plurais."

msgid "Fixed Git repository locking."
msgstr "Corrigido o bloqueio de repositório Git."

msgid "Compatibility with older Git versions."
msgstr "Compatibilidade com versões mais antigas do Git."

msgid "Improved ACL support."
msgstr "Melhorado o suporte a ACLs."

msgid "Added buttons for per language quotes and other special characters."
msgstr ""
"Adicionados botões para aspas por idioma e outros caracteres especiais."

msgid "Support for exporting stats as JSONP."
msgstr "Suporte para exportação de estatísticas como JSONP."

msgid "Weblate 3.x series"
msgstr "Série 3.x do Weblate"

msgid "Weblate 3.11.3"
msgstr "Weblate 3.11.3"

msgid "*Released on March 11th 2020.*"
msgstr "*Atualizado em 11 de março de 2020.*"

msgid "Fixed searching for fields with certain priority."
msgstr "Corrigida a busca de campos com certa prioridade."

msgid "Fixed predefined query for recently added strings."
msgstr "Corrigida a consulta predefinida para textos adicionados recentemente."

msgid "Fixed searching returning duplicate matches."
msgstr "Corrigida a busca que retornava correspondências duplicadas."

msgid "Fixed notifications rendering in Gmail."
msgstr "Corrigido o processamento de notificações no Gmail."

msgid "Fixed reverting changes from the history."
msgstr "Corrigida a reversão das alterações do histórico."

msgid "Added links to events in digest notifications."
msgstr "Adicionados links para eventos nas notificações de resumo."

msgid "Fixed email for account removal confirmation."
msgstr "Corrigido o e-mail para confirmação de remoção de conta."

msgid "Added support for Slack authentication in Docker container."
msgstr "Adicionado suporte para autenticação Slack no contêiner Docker."

msgid "Avoid sending notifications for not subscribed languages."
msgstr "Evita enviar notificações para idiomas não assinados."

msgid "Include Celery queues in performance overview."
msgstr "Inclusão de filas do Celery na visão geral de desempenho."

msgid "Fixed documentation links for add-ons."
msgstr "Corrigidos os links da documentação para complementos."

msgid "Reduced false negatives for unchanged translation check."
msgstr "Redução de falso-negativos para verificação de tradução inalterada."

msgid "Raised bleach dependency to address :cve:`2020-6802`."
msgstr "Elevada a dependência do bleach para abordar :cve:`2020-6802`."

msgid "Fixed listing project level changes in history."
msgstr "Corrigida a lista de mudanças de nível de projeto no histórico."

msgid "Fixed stats invalidation in some corner cases."
msgstr "Corrigida a invalidação de estatísticas em alguns casos complexos."

msgid "Fixed searching for certain string states."
msgstr "Corrigida a busca de determinados status de texto."

msgid "Improved format string checks behavior on missing percent."
msgstr ""
"Corrigido o comportamento de verificação de formato de texto em caso de "
"faltar porcentagem."

msgid "Fixed authentication using some third party providers."
msgstr "Corrigida a autenticação usando alguns provedores de terceiros."

msgid "Weblate 3.11.2"
msgstr "Weblate 3.11.2"

msgid "*Released on February 22nd 2020.*"
msgstr "*Atualizado em 22 de fevereiro de 2020.*"

msgid "Fixed rendering of suggestions."
msgstr "Corrigida a renderização de sugestões."

msgid "Fixed some strings wrongly reported as having no words."
msgstr ""
"Corrigidos alguns textos relatados incorretamente como não tendo palavras."

msgid "Weblate 3.11.1"
msgstr "Weblate 3.11.1"

msgid "*Released on February 20th 2020.*"
msgstr "*Atualizado em 20 de fevereiro de 2020.*"

msgid "Documented Celery setup changes."
msgstr "Documentadas as alterações de configuração no Celery."

msgid "Improved filename validation on component creation."
msgstr "Melhorada a validação de nome de arquivo na criação de componentes."

msgid "Fixed minimal versions of some dependencies."
msgstr "Corrigidas as versões mínimas de algumas dependências."

msgid "Fixed adding groups with certain Django versions."
msgstr "Corrigida a adição de grupos com certas versões do Django."

msgid "Fixed manual pushing to upstream repository."
msgstr "Corrigido o push manual para o repositório upstream."

msgid "Improved glossary matching."
msgstr "Melhorada a correspondência de glossário."

msgid "Weblate 3.11"
msgstr "Weblate 3.11"

msgid "*Released on February 17th 2020.*"
msgstr "*Atualizado em 17 de fevereiro de 2020.*"

msgid "Allow using VCS push URL during component creation via API."
msgstr ""
"Permite o uso de URL de push VCS durante a criação do componente via API."

msgid "Rendered width check now shows image with the render."
msgstr ""
"A verificação de largura renderizada agora mostra a imagem com a "
"renderização."

msgid "Fixed links in notifications e-mails."
msgstr "Corrigidos os links em e-mails de notificação."

msgid "Improved look of plaintext e-mails."
msgstr "Melhorada a aparência de e-mails em texto simples."

msgid "Display ignored checks and allow to make them active again."
msgstr "Exibe verificações ignoradas e permite torná-las ativas novamente."

msgid "Display nearby keys on monolingual translations."
msgstr "Exibe as teclas próximas em traduções monolíngues."

msgid "Added support for grouping string shapings."
msgstr "Adicionado suporte para agrupar formas de textos."

msgid "Recommend upgrade to new Weblate versions in the system checks."
msgstr ""
"Recomenda a atualização para novas versões do Weblate nas verificações do "
"sistema."

msgid "Provide more detailed analysis for duplicate language alert."
msgstr "Fornece uma análise mais detalhada para alerta de idioma duplicado."

msgid "Include more detailed license info on the project pages."
msgstr ""
"Inclui informações mais detalhadas sobre a licença nas páginas do projeto."

msgid "Automatically unshallow local copies if needed."
msgstr "Automaticamente desfaz shallow em cópias locais, se necessário."

msgid "Fixed download of strings needing action."
msgstr "Corrigido o download de textos que necessitam ação."

msgid "New alert to warn about using the same file mask twice."
msgstr ""
"Novo alerta para alertar sobre o uso da mesma máscara de arquivo duas vezes."

msgid "Improve XML placeables extraction."
msgstr "Melhorar a extração de objetos colocáveis XML."

msgid ""
"The :setting:`SINGLE_PROJECT` can now enforce redirection to chosen project."
msgstr ""
"O :setting:`SINGLE_PROJECT` agora pode forçar o redirecionamento para o "
"projeto escolhido."

msgid "Added option to resolve comments."
msgstr "Adicionada opção para resolver comentários."

msgid "Added bulk editing of flags."
msgstr "Adicionada edição em massa de marcadores."

msgid "Added support for :ref:`labels`."
msgstr "Adicionado suporte para :ref:`labels`."

msgid "Added bulk edit add-on."
msgstr "Adicionado complemento de edição em massa."

msgid "Added option for :ref:`enforcing-checks`."
msgstr "Adicionada opção para :ref:`enforcing-checks`."

msgid "Increased default validity of confirmation links."
msgstr "Aumento da validade padrão dos links de confirmação."

msgid "Improved Matomo integration."
msgstr "Melhorada integração com o Matomo."

msgid "Fixed :ref:`check-translated` to correctly handle source string change."
msgstr ""
"Corrigido :ref:`check-translated` para tratar corretamente da mudança do "
"texto fonte."

msgid "Extended automatic updates configuration by :setting:`AUTO_UPDATE`."
msgstr ""
"Configuração estendida de atualizações automáticas "
"por :setting:`AUTO_UPDATE`."

msgid "LINGUAS add-ons now do full sync of translations in Weblate."
msgstr ""
"Complementos de LINGUAS agora fazem sincronização completa de tradução no "
"Weblate."

msgid "Weblate 3.10.3"
msgstr "Weblate 3.10.3"

msgid "*Released on January 18th 2020.*"
msgstr "*Atualizado em 18 de janeiro de 2020.*"

msgid "Support for translate-toolkit 2.5.0."
msgstr "Suporte para translate-toolkit 2.5.0."

msgid "Weblate 3.10.2"
msgstr "Weblate 3.10.2"

msgid "Add lock indication to projects."
msgstr "Adicionar indicação de bloqueio aos projetos."

msgid "Fixed CSS bug causing flickering in some web browsers."
msgstr "Corrigido erro CSS que causava cintilação em alguns navegadores web."

msgid "Fixed searching on systems with non-English locales."
msgstr "Corrigida a busca em sistemas com localidades diferentes do inglês."

msgid "Improved repository matching for GitHub and Bitbucket hooks."
msgstr ""
"Melhorada correspondência de repositório para hooks do GitHub e do Bitbucket."

msgid "Fixed data migration on some Python 2.7 installations."
msgstr "Corrigida migração de dados em algumas instalações do Python 2.7."

msgid "Allow configuration of Git shallow cloning."
msgstr "Permitir a configuração da clonagem rasa de Git."

msgid "Improved background notification processing."
msgstr "Melhorado processamento de notificações de segundo plano."

msgid "Fixed broken form submission when navigating back in web browser."
msgstr ""
"Corrigido o envio de formulários quebrados ao navegar de volta no navegador "
"da web."

msgid "New add-on to configure YAML formatting."
msgstr "Novo complemento para configurar a formatação YAML."

msgid "Fixed same plurals check to not fire on single plural form languages."
msgstr ""
"Corrigida a verificação de mesmos plurais para não disparar em idiomas de "
"forma plural única."

msgid "Fixed regex search on some fields."
msgstr "Corrigida busca por expressões regulares em alguns campos."

msgid "Weblate 3.10.1"
msgstr "Weblate 3.10.1"

msgid "*Released on January 9th 2020.*"
msgstr "*Atualizado em 9 de janeiro de 2020.*"

msgid "Extended API with translation creation."
msgstr "API estendida com criação de tradução."

msgid "Fixed several corner cases in data migrations."
msgstr "Corrigidos diversos casos especiais em migrações de dados."

msgid "Compatibility with Django 3.0."
msgstr "Compatibilidade com Django 3.0."

msgid "Improved data clean-up performance."
msgstr "Aprimorado o desempenho da limpeza de dados."

msgid "Added support for customizable security.txt."
msgstr "Adicionado suporte ao security.txt customizável."

msgid "Improved breadcrumbs in changelog."
msgstr "Melhorado a estrutura de navegação no changelog."

msgid "Improved translations listing on dashboard."
msgstr "Melhorada listagem de traduções no painel."

msgid "Improved HTTP responses for webhooks."
msgstr "Melhorada respostas HTTP para webhooks."

msgid "Added support for GitLab merge requests in Docker container."
msgstr "Adicionado suporte aos merge requests do GitLab no contêiner Docker."

msgid "Weblate 3.10"
msgstr "Weblate 3.10"

msgid "*Released on December 20th 2019.*"
msgstr "*Atualizado em 20 de dezembro de 2019.*"

msgid "Improved application user interface."
msgstr "Melhorada a interface do usuário da aplicação."

msgid "Added doublespace check."
msgstr "Adicionada checagem de duplos espaços."

msgid "Fixed creating new languages."
msgstr "Consertada criação de novos idiomas."

msgid "Avoid sending auditlog notifications to deleted e-mails."
msgstr "Evita enviar notificações de log de auditoria para e-mails excluídos."

msgid "Added support for read-only strings."
msgstr "Adicionado suporte à textos somente leitura."

msgid "Added support for Markdown in comments."
msgstr "Adicionado suporte a Markdown nos comentários."

msgid "Allow placing translation instruction text in project info."
msgstr ""
"Permitir posicionamento de textos de instruções de tradução nas informações "
"do projeto."

msgid "Add copy to clipboard for secondary languages."
msgstr "Adicionar cópia para área de transferência para idiomas secundários."

msgid "Improved support for Mercurial."
msgstr "Melhorado suporte ao Mercurial."

msgid "Improved Git repository fetching performance."
msgstr "Melhorado desempenho de busca do repositório Git."

msgid "Add search lookup for age of string."
msgstr "Adicionada busca pela idade do texto."

msgid "Show source language for all translations."
msgstr "Mostrar idioma fonte para todas as traduções."

msgid "Show context for nearby strings."
msgstr "Mostrar contexto para textos próximos."

msgid "Added support for notifications on repository operations."
msgstr "Adicionado suporte para notificações nas operações do repositório."

msgid "Improved translation listings."
msgstr "Melhoradas listagens de tradução."

msgid "Added support for automatic translation strings marked for editing."
msgstr ""
"Adicionado suporte para tradução automática de textos marcados para edição."

msgid "Avoid sending duplicate notifications for linked component alerts."
msgstr ""
"Evitar o envio de notificações duplicadas para alertas de componentes "
"vinculados."

msgid "Improve default merge request message."
msgstr "Melhorada a mensagem da merge request padrão."

msgid "Better indicate string state in Zen mode."
msgstr "Melhor indicação do status do texto no modo Zen."

msgid "Added support for more languages in Yandex Translate."
msgstr "Adicionado suporte a mais idiomas no Yandex Translate."

msgid "Improved look of notification e-mails."
msgstr "Visual melhorado de notificações de e-mails."

msgid "Provide choice for translation license."
msgstr "Fornecer seleção para a licença de tradução."

msgid "Weblate 3.9.1"
msgstr "Weblate 3.9.1"

msgid "*Released on October 28th 2019.*"
msgstr "*Atualizado em 28 de outubro de 2019.*"

msgid "Remove some unneeded files from backups."
msgstr "Remover alguns arquivos desnecessários dos backups."

msgid "Fixed potential crash in reports."
msgstr "Corrigida possível falha nos relatórios."

msgid "Fixed cross database migration failure."
msgstr "Corrigida uma falha de migração cruzada de bancos de dados."

msgid "Added support for force pushing Git repositories."
msgstr "Adicionado suporte para forçar o push de repositórios Git."

msgid "Reduced risk of registration token invalidation."
msgstr "Reduzido o risco de invalidação de token de registro."

msgid "Fixed account removal hitting rate limiter."
msgstr "Corrigido o limitador de taxa de acerto de remoção de conta."

msgid "Added search based on priority."
msgstr "Adicionada busca baseada em prioridade."

msgid "Fixed possible crash on adding strings to JSON file."
msgstr "Consertada possível falha ao adicionar textos para um arquivo JSON."

msgid "Safe HTML check and fixup now honor source string markup."
msgstr ""
"A verificação e correção de HTML seguro agora respeitam a marcação do texto "
"fonte."

msgid "Avoid sending notifications to invited and deleted users."
msgstr "Impedir o envio de notificações para usuários convidados e deletados."

msgid "Fix SSL connection to redis in Celery in Docker container."
msgstr "Consertar a conexão SSL para o redis no Celery num contêiner Docker."

msgid "Weblate 3.9"
msgstr "Weblate 3.9"

msgid "*Released on October 15th 2019.*"
msgstr "*Atualizado em 15 de outubro de 2019.*"

msgid "Include Weblate metadata in downloaded files."
msgstr "Incluir metadados do Weblate em arquivos baixados."

msgid "Improved UI for failing checks."
msgstr "Melhorada IU para verificações com falha."

msgid "Indicate missing strings in format checks."
msgstr "Indica textos ausentes nas verificações de formatação."

msgid "Separate check for French punctuation spacing."
msgstr "Verificação separada para o espaçamento de pontuação francês."

msgid "Add support for fixing some of quality checks errors."
msgstr ""
"Adicionado suporte para consertar alguns erros de verificação de qualidade."

msgid "Add separate permission to create new projects."
msgstr "Adicionada permissão separada para criar novos projetos."

msgid "Extend stats for char counts."
msgstr "Estender estatísticas para a contagem de caracteres."

msgid "Improve support for Java style language codes."
msgstr "Melhorado o suporte aos códigos de idioma no estilo Java."

msgid "Added new generic check for placeholders."
msgstr "Adicionada nova verificação genérica para espaços reservados."

msgid "Added support for WebExtension JSON placeholders."
msgstr "Adicionado suporte para espaços reservados de WebExtension JSON."

msgid "Added support for flat XML format."
msgstr "Adicionado suporte para formato XML simples."

msgid ""
"Extended API with project, component and translation removal and creation."
msgstr ""
"API estendida com remoção e criação de tradução de projeto, componente e "
"tradução."

msgid "Added support for Gitea and Gitee webhooks."
msgstr "Adicionado suporte para webhooks do Gitea e Gitee."

msgid "Added new custom regex based check."
msgstr "Adicionada nova verificação de expressões regulares personalizadas."

msgid "Allow to configure contributing to shared translation memory."
msgstr ""
"Permitida a configuração de contribuições para a memória de tradução "
"compartilhada."

msgid "Added ZIP download for more translation files."
msgstr "Adicionado o download ZIP para mais arquivos de tradução."

msgid "Make XLIFF standard compliant parsing of maxwidth and font."
msgstr ""
"Tornada a análise compatível com o padrão XLIFF de altura máxima e fonte."

msgid ""
"Added new check and fixer for safe HTML markup for translating web "
"applications."
msgstr ""
"Adicionados uma nova verificação e correção para marcação HTML segura para "
"traduzir aplicativos web."

msgid "Add component alert on unsupported configuration."
msgstr "Adicionado um alerta de componente em configuração sem suporte."

msgid "Added automatic translation add-on to bootstrap translations."
msgstr ""
"Adicionado um complemento de tradução automática para inicializar traduções."

msgid "Extend automatic translation to add suggestions."
msgstr "Estender tradução automática para adicionar sugestões."

msgid "Display add-on parameters on overview."
msgstr "Mostrar parâmetros adicionais na visão geral."

msgid "Sentry is now supported through modern Sentry SDK instead of Raven."
msgstr "Sentry agora é compatível com o moderno Sentry SDK em vez do Raven."

msgid "Changed example settings to be better fit for production environment."
msgstr ""
"Alteradas as configurações de exemplo para se adequarem melhor ao ambiente "
"de produção."

msgid "Added automated backups using BorgBackup."
msgstr "Adicionados backups automatizados usando BorgBackup."

msgid "Split cleanup add-on for RESX to avoid unwanted file updates."
msgstr ""
"Divida o complemento de limpeza para RESX para evitar atualizações "
"indesejadas de arquivos."

msgid "Added advanced search capabilities."
msgstr "Adicionados recursos de busca avançada."

msgid "Allow users to download their own reports."
msgstr "Permitido que os usuários baixem seus próprios relatórios."

msgid "Added localization guide to help configuring components."
msgstr ""
"Adicionado guia de localização para ajudar na configuração de componentes."

msgid "Added support for GitLab merge requests."
msgstr "Adicionado suporte para merge requests do GitLab."

msgid "Improved display of repository status."
msgstr "Melhorada a exibição do status do repositório."

msgid "Perform automated translation in the background."
msgstr "Realiza tradução automática em segundo plano."

msgid "Weblate 3.8"
msgstr "Weblate 3.8"

msgid "*Released on August 15th 2019.*"
msgstr "*Atualizado em 15 de agosto de 2019.*"

msgid "Added support for simplified creating of similar components."
msgstr ""
"Adicionado suporte para criação simplificada de componentes semelhantes."

msgid ""
"Added support for parsing translation flags from the XML based file formats."
msgstr ""
"Adicionado suporte para analisar marcadores de tradução de formatos de "
"arquivo baseados em XML."

msgid "Log exceptions into Celery log."
msgstr "Registra as exceções no log do Celery."

msgid "Improve performance of repository scoped add-ons."
msgstr "Melhoria no desempenho de complementos com escopo de repositório."

msgid "Fixed password reset behavior."
msgstr "Correção do comportamento de redefinição de senha."

msgid "Improved performance on most of translation pages."
msgstr "Corrigido o desempenho na maioria das páginas de tradução."

msgid "Fixed listing of languages not known to Weblate."
msgstr "Corrigida a lista de idiomas não conhecidos pelo Weblate."

msgid "Add support for cloning add-ons to discovered components."
msgstr ""
"Adiciona suporte para clonar complementos para componentes descobertos."

msgid "Add support for replacing file content with uploaded."
msgstr "Adiciona suporte para substituir o conteúdo do arquivo com o enviado."

msgid "Add support for translating non VCS based content."
msgstr "Adicionado suporte para tradução de conteúdo não baseado em VCS."

msgid "Added OpenGraph widget image to use on social networks."
msgstr "Adicionada a imagem de widget OpenGraph para uso em redes sociais."

msgid "Added support for animated screenshots."
msgstr "Adicionado suporte para capturas de tela animadas."

msgid "Improved handling of monolingual XLIFF files."
msgstr "Melhorado o manuseio de arquivos XLIFF monolíngues."

msgid "Avoid sending multiple notifications for single event."
msgstr "Evita enviar várias notificações para um único evento."

msgid "Add support for filtering changes."
msgstr "Adicionado suporte para filtrar alterações."

msgid "Extended predefined periods for reporting."
msgstr "Estendidos os períodos predefinidos para relatórios."

msgid "Added webhook support for Azure Repos."
msgstr "Adicionado suporte de webhook para Azure Repos."

msgid ""
"New opt-in notifications on pending suggestions or untranslated strings."
msgstr ""
"Novas notificações opcionais sobre sugestões pendentes ou textos não "
"traduzidos."

msgid "Add one click unsubscribe link to notification e-mails."
msgstr ""
"Adicionado um link de cancelamento de assinatura, por meio de um clique "
"único, aos e-mails de notificação."

msgid "Fixed false positives with Has been translated check."
msgstr "Corrigidos falsos positivos com a verificação \"Foi traduzido\"."

msgid "New management interface for admins."
msgstr "Nova interface de gerenciamento para administradores."

msgid "String priority can now be specified using flags."
msgstr "A prioridade do texto agora pode ser especificada usando marcadores."

msgid "Added language management views."
msgstr "Adicionadas visões de gerenciamento de idioma."

msgid "Add checks for Qt library and Ruby format strings."
msgstr "Adicionadas verificações da bibliotecas Qt e textos de formato Ruby."

msgid "Added configuration to better fit single project installations."
msgstr ""
"Adicionada configuração para melhor se adequar às instalações de um único "
"projeto."

msgid ""
"Notify about new string on source string change on monolingual translations."
msgstr ""
"Notificação sobre novo texto na mudança do texto fonte em traduções "
"monolíngues."

msgid "Added separate view for translation memory with search capability."
msgstr ""
"Adicionada visão separada para memória de tradução com capacidade de busca."

msgid "Weblate 3.7.1"
msgstr "Weblate 3.7.1"

msgid "*Released on June 28th 2019.*"
msgstr "*Atualizado em 28 de junho de 2019.*"

msgid "Fixed some requirements constraints."
msgstr "Corrigidas algumas restrições de requisitos."

msgid "Updated language database."
msgstr "Atualizado o banco de dados do idioma."

msgid "Localization updates."
msgstr "Atualizações de localização."

msgid "Various user interface tweaks."
msgstr "Vários ajustes da interface do usuário."

msgid "Improved handling of unsupported but discovered translation files."
msgstr ""
"Melhorado o tratamento de arquivos de tradução não suportados, mas "
"descobertos."

msgid "More verbosely report missing file format requirements."
msgstr ""
"Relata mais detalhadamente os requisitos de formato de arquivo ausentes."

msgid "Weblate 3.7"
msgstr "Weblate 3.7"

msgid "*Released on June 21st 2019.*"
msgstr "*Atualizado em 21 de junho de 2019.*"

msgid "Added separate Celery queue for notifications."
msgstr "Adicionada fila Celery separada para notificações."

msgid "Use consistent look with application for API browsing."
msgstr "Usa uma aparência consistente com o aplicativo para navegação na API."

msgid "Include approved stats in the reports."
msgstr "Incluir estatísticas aprovadas nos relatórios."

msgid "Report progress when updating translation component."
msgstr "Reportar progresso quando atualizar um componente de tradução."

msgid "Allow to abort running background component update."
msgstr "Permite abortar a atualização do componente em segundo plano."

msgid "Extend template language for filename manipulations."
msgstr "Estendida a linguagem do modelo para manipulações de nome de arquivo."

msgid "Use templates for editor link and repository browser URL."
msgstr "Usa modelos para link do editor e URL do navegador do repositório."

msgid ""
"Indicate max length and current characters count when editing translation."
msgstr ""
"Indica o comprimento máximo e a contagem atual de caracteres ao editar a "
"tradução."

msgid "Improved handling of abbreviations in unchanged translation check."
msgstr ""
"Melhorado o tratamento de abreviações na verificação de tradução inalterada."

msgid "Refreshed landing page for new contributors."
msgstr "Página de destino atualizada para novos colaboradores."

msgid "Add support for configuring msgmerge add-on."
msgstr "Adiciona suporte para configurar complementos de msgmerge."

msgid "Delay opening SMTP connection when sending notifications."
msgstr "Atraso na abertura da conexão SMTP ao enviar notificações."

msgid "Improved error logging."
msgstr "Melhorado o registro de erros."

msgid "Allow custom location in MO generating add-on."
msgstr "Permite local personalizado no complemento de geração de MO."

msgid "Added add-ons to cleanup old suggestions or comments."
msgstr "Adicionados complementos para limpar sugestões ou comentários antigos."

msgid "Added option to enable horizontal mode in the Zen editor."
msgstr "Adicionada a opção para habilitar o modo horizontal no editor Zen."

msgid "Improved import performance with many linked components."
msgstr ""
"Melhorado o desempenho de importação com muitos componentes vinculados."

msgid "Fixed examples installation in some cases."
msgstr "Corrigida a instalação de exemplos em alguns casos."

msgid "Improved rendering of alerts in changes."
msgstr "Melhorada a renderização de alertas em mudanças."

msgid "Added new horizontal stats widget."
msgstr "Adicionado novo widget de estatísticas horizontais."

msgid "Improved format strings check on plurals."
msgstr "Melhorada a verificação de textos de formato em plurais."

msgid "Added font management tool."
msgstr "Adicionada ferramenta de gerenciamento de fontes."

msgid "New check for rendered text dimensions."
msgstr "Nova verificação das dimensões do texto renderizado."

msgid "Added support for subtitle formats."
msgstr "Adicionado suporte para formatos de legenda."

msgid "Include overall completion stats for languages."
msgstr "Inclui estatísticas gerais de conclusão para idiomas."

msgid "Added reporting at project and global scope."
msgstr "Adicionados relatórios no escopo global e no de projeto."

msgid "Improved user interface when showing translation status."
msgstr "Melhorada a interface de usuário ao mostrar o status da tradução."

msgid "New Weblate logo and color scheme."
msgstr "Novo logotipo e esquema de cores do Weblate."

msgid "New look of bitmap badges."
msgstr "Nova aparência de emblemas de bitmap."

msgid "Weblate 3.6.1"
msgstr "Weblate 3.6.1"

msgid "*Released on April 26th 2019.*"
msgstr "*Atualizado em 26 de abril de 2019.*"

msgid "Fixed digest notifications in some corner cases."
msgstr "Corrigidas as notificações de resumo em alguns casos complexos."

msgid "Fixed add-on script error alert."
msgstr "Alerta de erro no script de complemento foram corrigidos."

msgid "Fixed generating MO file for monolingual PO files."
msgstr "Corrigido o arquivo de geração de MO para arquivos PO monolíngues."

msgid "Fixed display of uninstalled checks."
msgstr "Corrigida a exibição de verificações desinstaladas."

msgid "Indicate administered projects on project listing."
msgstr "Indica projetos administrados na lista de projetos."

msgid "Allow update to recover from missing VCS repository."
msgstr "Permite que a atualização se recupere de um repositório VCS ausente."

msgid "Weblate 3.6"
msgstr "Weblate 3.6"

msgid "*Released on April 20th 2019.*"
msgstr "*Atualizado em 20 de abril de 2019.*"

msgid "Add support for downloading user data."
msgstr "Adiciona suporte para baixar dados do usuário."

msgid "Add-ons are now automatically triggered upon installation."
msgstr "Complementos agora são acionados automaticamente após a instalação."

msgid "Improved instructions for resolving merge conflicts."
msgstr "Melhoradas as instruções para resolver conflitos de mesclagem."

msgid "Cleanup add-on is now compatible with app store metadata translations."
msgstr ""
"O complemento de limpeza agora é compatível com traduções de metadados da "
"loja de aplicativos."

msgid "Configurable language code syntax when adding new translations."
msgstr "Sintaxe do código de idioma configurável ao adicionar novas traduções."

msgid ""
"Warn about using Python 2 with planned termination of support in April 2020."
msgstr ""
"Avisa sobre o uso de Python 2 com encerramento planejado do suporte em abril "
"de 2020."

msgid "Extract special characters from the source string for visual keyboard."
msgstr "Extrai caracteres especiais do texto fonte para o teclado visual."

msgid "Extended contributor stats to reflect both source and target counts."
msgstr ""
"Estendidas as estatísticas de colaboradores para refletir as contagens fonte "
"e destino."

msgid ""
"Admins and consistency add-ons can now add translations even if disabled for "
"users."
msgstr ""
"Os administradores e complementos de consistência agora podem adicionar "
"traduções, mesmo se desativado para os usuários."

msgid ""
"Fixed description of toggle disabling ``Language-Team`` header manipulation."
msgstr ""
"Corrigida a descrição de alternar desabilitando a manipulação do cabeçalho "
"``Language-Team``."

msgid "Notify users mentioned in comments."
msgstr "Notifica os usuários mencionados nos comentários."

msgid "Removed file format autodetection from component setup."
msgstr ""
"Removida a detecção automática do formato de arquivo da configuração do "
"componente."

msgid "Added digest notifications."
msgstr "Adicionadas notificações de resumo."

msgid "Added support for muting component notifications."
msgstr "Adicionado suporte para silenciar notificações de componentes."

msgid "Added notifications for new alerts, whiteboard messages or components."
msgstr ""
"Adicionadas notificações para novos alertas, mensagens do quadro de "
"comunicações ou componentes."

msgid "Notifications for administered projects can now be configured."
msgstr ""
"As notificações para projetos administrados agora podem ser configuradas."

msgid "Improved handling of three letter language codes."
msgstr "Melhorado o tratamento de códigos de idioma de três letras."

msgid "Weblate 3.5.1"
msgstr "Weblate 3.5.1"

msgid "*Released on March 10th 2019.*"
msgstr "*Atualizado em 10 de março de 2019.*"

msgid "Fixed Celery systemd unit example."
msgstr "Corrigido o exemplo da unidade do systemd do Celery."

msgid "Fixed notifications from HTTP repositories with login."
msgstr "Corrigidas as notificações de repositórios HTTP com login."

msgid ""
"Fixed race condition in editing source string for monolingual translations."
msgstr ""
"Corrigida a condição de corrida na edição de texto fonte para traduções "
"monolíngues."

msgid "Include output of failed add-on execution in the logs."
msgstr "Inclui a saída da execução do complemento com falha nos logs."

msgid "Improved validation of choices for adding new language."
msgstr "Melhorada a validação de opções para adicionar novo idioma."

msgid "Allow to edit file format in component settings."
msgstr "Permite editar o formato do arquivo nas configurações do componente."

msgid "Update installation instructions to prefer Python 3."
msgstr "Atualiza as instruções de instalação para preferir o Python 3."

msgid "Performance and consistency improvements for loading translations."
msgstr "Melhorias de desempenho e consistência para carregar traduções."

msgid ""
"Make Microsoft Terminology service compatible with current Zeep releases."
msgstr ""
"Torne o serviço de Terminologia da Microsoft compatível com as versões "
"atuais da Zeep."

msgid "Weblate 3.5"
msgstr "Weblate 3.5"

msgid "*Released on March 3rd 2019.*"
msgstr "*Atualizado em 3 de março de 2019.*"

msgid "Improved performance of built-in translation memory."
msgstr "Melhorado o desempenho da memória de tradução embutida."

msgid "Added interface to manage global translation memory."
msgstr "Adicionada interface para gerenciar a memória de tradução global."

msgid "Improved alerting on bad component state."
msgstr "Melhorado o alerta sobre status inválido do componente."

msgid "Added user interface to manage whiteboard messages."
msgstr ""
"Adicionada interface de usuário para gerenciar mensagens do quadro de "
"comunicações."

msgid "Add-on commit message now can be configured."
msgstr "A mensagem de comit do complemento agora pode ser configurada."

msgid "Reduce number of commits when updating upstream repository."
msgstr "Reduz o número de commit ao atualizar o repositório upstream."

msgid "Fixed possible metadata loss when moving component between projects."
msgstr ""
"Corrigida a possível perda de metadados ao mover um componente entre "
"projetos."

msgid "Improved navigation in the Zen mode."
msgstr "Melhorada a navegação no modo Zen."

msgid "Added several new quality checks (Markdown related and URL)."
msgstr ""
"Adicionadas várias novas verificações de qualidade (relacionadas a Markdown "
"e URL)."

msgid "Added support for app store metadata files."
msgstr "Adicionado suporte para arquivos de metadados de loja de aplicativos."

msgid "Added support for toggling GitHub or Gerrit integration."
msgstr "Adicionado suporte para alternar a integração GitHub ou Gerrit."

msgid "Added check for Kashida letters."
msgstr "Adicionada verificação de letras Kashida."

msgid "Added option to squash commits based on authors."
msgstr "Adicionada opção para fazer squash de commits com base nos autores."

msgid "Improved support for XLSX file format."
msgstr "Melhorado o suporte ao formato de arquivo XLSX."

msgid "Compatibility with Tesseract 4.0."
msgstr "Compatibilidade com Tesseract 4.0."

msgid "Billing add-on now removes projects for unpaid billings after 45 days."
msgstr ""
"O complemento de cobrança agora remove projetos para cobranças não pagas "
"após 45 dias."

msgid "Weblate 3.4"
msgstr "Weblate 3.4"

msgid "*Released on January 22nd 2019.*"
msgstr "*Atualizado em 22 de janeiro de 2019.*"

msgid "Added support for XLIFF placeholders."
msgstr "Adicionado suporte para espaços reservados do XLIFF."

msgid "Celery can now utilize multiple task queues."
msgstr "O Celery agora pode utilizar várias filas de tarefas."

msgid "Added support for renaming and moving projects and components."
msgstr "Adicionado suporte para renomear e mover projetos e componentes."

msgid "Include characters counts in reports."
msgstr "Inclui contagens de caracteres em relatórios."

msgid ""
"Added guided adding of translation components with automatic detection of "
"translation files."
msgstr ""
"Adicionada adição guiada de componentes de tradução com detecção automática "
"de arquivos de tradução."

msgid "Customizable merge commit messages for Git."
msgstr "Mensagens de commit de mesclagem personalizáveis para Git."

msgid "Added visual indication of component alerts in navigation."
msgstr "Adicionada indicação visual de alertas de componentes na navegação."

msgid "Improved performance of loading translation files."
msgstr "Melhorado o desempenho de carregamento de arquivos de tradução."

msgid "New add-on to squash commits prior to push."
msgstr "Novo complemento para fazer squash de commits antes de fazer push."

msgid "Improved displaying of translation changes."
msgstr "Melhorada a exibição de alterações de tradução."

msgid "Changed default merge style to rebase and made that configurable."
msgstr ""
"Alterado o estilo de mesclagem padrão ao fazer rebase e tornado-o "
"configurável."

msgid "Better handle private use subtags in language code."
msgstr "Melhor tratamento de subtags de uso particular no código de idioma."

msgid "Improved performance of fulltext index updates."
msgstr "Melhorado o desempenho de atualizações de índice de texto completo."

msgid "Extended file upload API to support more parameters."
msgstr ""
"Estendida a API de envio de arquivo para oferecer suporte a mais parâmetros."

msgid "Weblate 3.3"
msgstr "Weblate 3.3"

msgid "*Released on November 30th 2018.*"
msgstr "*Atualizado em 30 de novembro de 2018.*"

msgid "Added support for component and project removal."
msgstr "Adicionado suporte para remoção de componentes e projetos."

msgid "Improved performance for some monolingual translations."
msgstr "Melhorado o desempenho para algumas traduções monolíngues."

msgid ""
"Added translation component alerts to highlight problems with a translation."
msgstr ""
"Adicionados alertas de componente de tradução para destacar problemas com "
"uma tradução."

msgid "Expose XLIFF string ``resname`` as context when available."
msgstr "Expõe a ``resname`` do XLIFF como contexto quando disponível."

msgid "Added support for XLIFF states."
msgstr "Adicionado suporte para status XLIFF."

msgid "Added check for non writable files in DATA_DIR."
msgstr ""
"Adicionada verificação de arquivos que não podem ser escritos dentro do "
"DATA_DIR."

msgid "Improved CSV export for changes."
msgstr "Melhorada a exportação de CSV para alterações."

msgid "Weblate 3.2.2"
msgstr "Weblate 3.2.2"

msgid "*Released on October 20th 2018.*"
msgstr "*Atualizado em 20 de outubro de 2018.*"

msgid "Remove no longer needed Babel dependency."
msgstr "Remove a dependência Babel que não é mais necessária."

msgid "Updated language definitions."
msgstr "Definições de idioma atualizadas."

msgid "Improve documentation for add-ons, LDAP and Celery."
msgstr "Melhora a documentação para complementos, LDAP e Celery."

msgid "Fixed enabling new dos-eol and auto-java-messageformat flags."
msgstr ""
"Corrigida a ativação de novos marcadores dos-eol e auto-java-messageformat."

msgid "Fixed running setup.py test from PyPI package."
msgstr "Corrigido o teste setup.py em execução do pacote PyPI."

msgid "Improved plurals handling."
msgstr "Melhorado o tratamento de plurais."

msgid "Fixed translation upload API failure in some corner cases."
msgstr ""
"Corrigida a falha da API de envio de tradução em alguns casos complexos."

msgid "Fixed updating Git configuration in case it was changed manually."
msgstr ""
"Corrigida a atualização da configuração do Git caso ela fosse alterada "
"manualmente."

msgid "Weblate 3.2.1"
msgstr "Weblate 3.2.1"

msgid "*Released on October 10th 2018.*"
msgstr "*Atualizado em 10 de outubro de 2018.*"

msgid "Document dependency on backports.csv on Python 2.7."
msgstr "Documenta a dependência de backports.csv no Python 2.7."

msgid "Fix running tests under root."
msgstr "Corrige os testes em execução como root."

msgid "Improved error handling in gitexport module."
msgstr "Melhorado o tratamento de erros no módulo gitexport."

msgid "Fixed progress reporting for newly added languages."
msgstr "Corrigido o relatório de progresso para idiomas recém-adicionados."

msgid "Correctly report Celery worker errors to Sentry."
msgstr "Comunica corretamente os erros do worker do Celery ao Sentry."

msgid "Fixed creating new translations with Qt Linguist."
msgstr "Corrigida a criação de novas traduções com o Qt Linguist."

msgid "Fixed occasional fulltext index update failures."
msgstr ""
"Corrigidas falhas ocasionais de atualização de índice de texto completo."

msgid "Improved validation when creating new components."
msgstr "Melhorada a validação ao criar novos componentes."

msgid "Added support for cleanup of old suggestions."
msgstr "Adicionado suporte para limpeza de sugestões antigas."

msgid "Weblate 3.2"
msgstr "Weblate 3.2"

msgid "*Released on October 6th 2018.*"
msgstr "*Atualizado em 6 de outubro de 2018.*"

msgid "Add install_addon management command for automated add-on installation."
msgstr ""
"Adicione o comando de gerenciamento install_addon para instalação "
"automatizada de complementos."

msgid "Allow more fine grained :ref:`rate-limit` settings."
msgstr "Permite configurações mais refinadas de :ref:`rate-limit`."

msgid "Added support for export and import of Excel files."
msgstr "Adicionado suporte para exportação e importação de arquivos Excel."

msgid ""
"Improve component cleanup in case of multiple component discovery add-ons."
msgstr ""
"Melhora a limpeza de componentes no caso de complementos de descoberta de "
"vários componentes."

msgid "Rewritten Microsoft Terminology machine translation backend."
msgstr ""
"Reescrito o back-end de tradução automática de Terminologia da Microsoft."

msgid "Weblate now uses Celery to offload some processing."
msgstr "Weblate agora usa Celery para descarregar algum processamento."

msgid "Improved search capabilities and added regular expression search."
msgstr ""
"Melhorados os recursos de busca e adicionada a busca de expressão regular."

msgid "Added support for Youdao Zhiyun API machine translation."
msgstr "Adicionado suporte para tradução automática da API Youdao Zhiyun."

msgid "Added support for Baidu API machine translation."
msgstr "Adicionado suporte para tradução automática da API do Baidu."

msgid "Integrated maintenance and cleanup tasks using Celery."
msgstr "Tarefas integradas de manutenção e limpeza usando o Celery."

msgid "Improved performance of loading translations by almost 25%."
msgstr "Melhor desempenho de carregamento de traduções em quase 25%."

msgid "Removed support for merging headers on upload."
msgstr "Removido o suporte para mesclar cabeçalhos no envio."

msgid "Removed support for custom commit messages."
msgstr "Removido o suporte para mensagens de commit personalizadas."

msgid "Configurable editing mode (zen/full)."
msgstr "Modo de edição configurável (zen/full)."

msgid "Added support for error reporting to Sentry."
msgstr "Adicionado suporte para relatórios de erros para o Sentry."

msgid "Added support for automated daily update of repositories."
msgstr ""
"Adicionado suporte para atualização diária automatizada de repositórios."

msgid "Added support for creating projects and components by users."
msgstr ""
"Adicionado suporte para a criação de projetos e componentes por usuários."

msgid "Built-in translation memory now automatically stores translations done."
msgstr ""
"Memória de tradução embutida agora armazena automaticamente as traduções "
"feitas."

msgid "Users and projects can import their existing translation memories."
msgstr ""
"Usuários e projetos podem importar suas memórias de tradução existentes."

msgid "Better management of related strings for screenshots."
msgstr "Melhor gerenciamento de textos relacionados às capturas de tela."

msgid "Added support for checking Java MessageFormat."
msgstr "Adicionado suporte para verificar Java MessageFormat."

msgid ""
"See `3.2 milestone on GitHub <https://github.com/WeblateOrg/weblate/"
"milestone/36?closed=1>`_ for detailed list of addressed issues."
msgstr ""
"Consulte o `marco 3.2 no GitHub <https://github.com/WeblateOrg/weblate/"
"milestone/36?closed=1>`_ para uma lista detalhada dos problemas resolvidos."

msgid "Weblate 3.1.1"
msgstr "Weblate 3.1.1"

msgid "*Released on July 27th 2018.*"
msgstr "*Atualizado em 27 de julho de 2018.*"

msgid "Fix testsuite failure on some setups."
msgstr "Corrigida a falha do conjunto de teste em algumas configurações."

msgid "Weblate 3.1"
msgstr "Weblate 3.1"

msgid "Upgrades from older version than 3.0.1 are not supported."
msgstr "Atualizações de versões anteriores a 3.0.1 não são suportadas."

msgid "Allow to override default commit messages from settings."
msgstr "Permite substituir mensagens de commit padrão das configurações."

msgid "Improve webhooks compatibility with self hosted environments."
msgstr ""
"Melhora a compatibilidade dos webhooks com ambientes de hospedagem própria."

msgid "Added support for Amazon Translate."
msgstr "Adicionado suporte para o Amazon Translate."

msgid "Compatibility with Django 2.1."
msgstr "Compatibilidade com Django 2.1."

msgid ""
"Django system checks are now used to diagnose problems with installation."
msgstr ""
"As verificações do sistema Django agora são usadas para diagnosticar "
"problemas com a instalação."

msgid "Removed support for soon shutdown libravatar service."
msgstr ""
"Removido o suporte para o serviço libravatar que será encerrado em breve."

msgid "New add-on to mark unchanged translations as needing edit."
msgstr ""
"Novo complemento para marcar traduções não alteradas como necessitando de "
"edição."

msgid "Add support for jumping to specific location while translating."
msgstr ""
"Adiciona suporte para pular para um local específico durante a tradução."

msgid "Downloaded translations can now be customized."
msgstr "As traduções baixadas agora podem ser personalizadas."

msgid ""
"Improved calculation of string similarity in translation memory matches."
msgstr ""
"Melhorado o cálculo de similaridade de texto em correspondências de memória "
"de tradução."

msgid "Added support by signing Git commits by GnuPG."
msgstr "Adicionado suporte para assinar commits do Git pelo GnuPG."

msgid "Weblate 3.0.1"
msgstr "Weblate 3.0.1"

msgid "*Released on June 10th 2018.*"
msgstr "*Atualizado em 10 de junho de 2018.*"

msgid "Fixed possible migration issue from 2.20."
msgstr "Corrigido um possível problema de migração do 2.20."

msgid "Removed obsolete hook examples."
msgstr "Removidos exemplos de ganchos obsoletos."

msgid "Improved caching documentation."
msgstr "Documentação de cache aprimorada."

msgid "Fixed displaying of admin documentation."
msgstr "Exibição corrigida da documentação do administrador."

msgid "Improved handling of long language names."
msgstr "Tratamento aprimorado de nomes longos do idioma."

msgid "Weblate 3.0"
msgstr "Weblate 3.0"

msgid "*Released on June 1st 2018.*"
msgstr "*Atualizado em 1º de junho de 2018.*"

msgid "Rewritten access control."
msgstr "Controle de acesso reescrito."

msgid "Several code cleanups that lead to moved and renamed modules."
msgstr "Várias limpezas de código que levam a módulos movidos e renomeados."

msgid "New add-on for automatic component discovery."
msgstr "Novo complemento para descoberta automática de componentes."

msgid ""
"The import_project management command has now slightly different parameters."
msgstr ""
"O comando de gerenciamento import_project agora tem parâmetros ligeiramente "
"diferentes."

msgid "Added basic support for Windows RC files."
msgstr "Adicionado suporte básico para arquivos Windows RC."

msgid "New add-on to store contributor names in PO file headers."
msgstr ""
"Novo complemento para armazenar nomes de colaboradores em cabeçalhos de "
"arquivos PO."

msgid "The per component hook scripts are removed, use add-ons instead."
msgstr ""
"Os scripts de gancho por componente foram removidos; em vez disso, use "
"complementos."

msgid "Add support for collecting contributor agreements."
msgstr "Adiciona suporte para coletar acordos de colaborador."

msgid "Access control changes are now tracked in history."
msgstr "As alterações de controle de acesso agora são rastreadas no histórico."

msgid ""
"New add-on to ensure all components in a project have same translations."
msgstr ""
"Novo complemento para garantir que todos os componentes em um projeto tenham "
"as mesmas traduções."

msgid "Support for more variables in commit message templates."
msgstr "Suporte para mais variáveis em modelos de mensagem de commit."

msgid "Add support for providing additional textual context."
msgstr "Adiciona suporte para fornecer contexto textual adicional."

