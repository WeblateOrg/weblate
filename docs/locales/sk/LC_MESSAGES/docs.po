msgid "Improved translation locking."
msgstr "Vylepšené uzamykanie prekladov."

msgid "Added quality check for AngularJS interpolation."
msgstr "Pridaná kontrola kvality pre interpoláciu AngularJS."

msgid "Added extensive group based ACLs."
msgstr "Pridané rozsiahle ACL založené na skupinách."

msgid "Clarified terminology on strings needing edit (formerly fuzzy)."
msgstr "Objasnená terminológia pre reťazce vyžadujúce úpravu (predtým fuzzy)."

