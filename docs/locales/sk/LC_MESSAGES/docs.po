"Clarified terminology on strings needing action and untranslated strings."
msgstr ""
"Objasnená terminológia pre reťazce vyžadujúce akciu a nepreložené reťazce."

msgid "Support for Python 3."
msgstr "Podpora pre Python 3."

msgid "Dropped support for Django 1.7."
msgstr "Zrušená podpora pre Django 1.7."

msgid "Dropped dependency on msginit for creating new gettext PO files."
msgstr "Zrušená závislosť na msginit pre vytváranie nových súborov gettext PO."

msgid "Added configurable dashboard views."
msgstr "Pridané konfigurovateľné pohľady na nástenku."

msgid "Improved notifications on parse errors."
msgstr "Vylepšené notifikácie pri chybách parsingu."

msgid ""
