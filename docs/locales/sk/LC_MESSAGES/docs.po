msgstr "Pridané používateľské rozhranie pre odstránenie prekladu."

msgid "Improved behavior when inserting placeables."
msgstr "Vylepšené správanie pri vkladaní umiestniteľných prvkov."

msgid "Fixed auto locking issues in Zen mode."
msgstr "Opravené problémy s automatickým uzamykaním v režime Zen."

msgid "Weblate 2.7"
msgstr "Weblate 2.7"

msgid "*Released on Jul 10th 2016.*"
msgstr "*Vydané 10. júla 2016.*"

msgid "Removed Google web translate machine translation."
msgstr "Odstránený strojový preklad Google web translate."

