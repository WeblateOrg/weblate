msgid "Weblate 2.4"
msgstr "Weblate 2.4"

msgid "*Released on Sep 20th 2015.*"
msgstr "*Vydané 20. septembra 2015.*"

msgid "Improved support for PHP files."
msgstr "Vylepšená podpora pre súbory PHP."

msgid "Ability to add ACL to anonymous user."
msgstr "Schopnosť pridať ACL anonymnému používateľovi."

