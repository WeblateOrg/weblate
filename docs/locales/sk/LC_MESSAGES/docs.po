msgstr "*Vydané 7. februára 2012.*"

msgid "Improved validation of several forms."
msgstr "Vylepšené overovanie niekoľkých formulárov."

msgid "Warn users on profile upgrade."
msgstr "Upozornenie používateľov pri aktualizácii profilu."

msgid "Remember URL for login."
msgstr "Zapamätať URL adresu pre prihlásenie."

msgid "Naming of text areas while entering plural forms."
msgstr "Pomenovanie textových polí pri zadávaní tvarov množného čísla."

