msgstr ""
"Testovacia sada už nevyžaduje sieťový prístup na testovanie repozitárov."

msgid "Weblate 2.6"
msgstr "Weblate 2.6"

msgid "*Released on Apr 28th 2016.*"
msgstr "*Vydané 28. apríla 2016.*"

msgid "Fixed validation of components with language filter."
msgstr "Opravené overovanie komponentov s filtrom jazyka."

msgid "Improved support for XLIFF files."
msgstr "Vylepšená podpora pre súbory XLIFF."

msgid "Fixed machine translation for non English sources."
msgstr "Opravený strojový preklad pre zdroje iné ako angličtina."

msgid "Added REST API."
msgstr "Pridané REST API."

msgid "Django 1.10 compatibility."
msgstr "Kompatibilita s Django 1.10."

msgid "Added categories to whiteboard messages."
msgstr "Pridané kategórie k správam na nástenke."

