msgstr "Automatické rozširovanie oblasti prekladu."

msgid "Weblate 0.1"
msgstr "Weblate 0.1"

msgid "*Released on February 6th 2012.*"
msgstr "*Vydané 6. februára 2012.*"

msgid "Initial release."
msgstr "Počiatočné vydanie."

msgid "Weblate 1.x series"
msgstr "Séria Weblate 1.x"

msgid "Weblate 1.9"
msgstr "Weblate 1.9"

msgid "*Released on May 6th 2014.*"
msgstr "*Vydané 6. mája 2014.*"

msgid "Django 1.6 compatibility."
msgstr "Kompatibilita s Django 1.6."

msgid "No longer maintained compatibility with Django 1.4."
msgstr "Už nie je udržiavaná kompatibilita s Django 1.4."

