msgstr "Weblate 0.4"

msgid "*Released on February 8th 2012.*"
msgstr "*Vydané 8. februára 2012.*"

msgid "Added usage guide to documentation."
msgstr "Pridaný návod na použitie do dokumentácie."

msgid "Fixed API hooks not to require CSRF protection."
msgstr "Opravené háky API, aby nevyžadovali ochranu CSRF."

msgid "Weblate 0.3"
msgstr "Weblate 0.3"

msgid "Better display of source for plural translations."
msgstr "Lepšie zobrazenie zdroja pre preklady množných čísel."

msgid "New documentation in Sphinx format."
msgstr "Nová dokumentácia vo formáte Sphinx."

msgid "Displays secondary languages while translating."
msgstr "Zobrazuje sekundárne jazyky počas prekladu."

msgid "Improved error page to give list of existing projects."
msgstr "Vylepšená chybová stránka zobrazujúca zoznam existujúcich projektov."

msgid "New per language stats."
msgstr "Nové štatistiky pre každý jazyk."

msgid "Weblate 0.2"
msgstr "Weblate 0.2"

