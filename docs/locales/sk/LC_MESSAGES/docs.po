msgstr "Majitelia projektov sa môžu spravovať sami."

msgid "Added support for ``javascript-format`` used in gettext PO."
msgstr "Pridaná podpora pre ``javascript-format`` používaný v gettext PO."

msgid "Support for adding new translations in XLIFF."
msgstr "Podpora pre pridávanie nových prekladov v XLIFF."

msgid "Improved file format autodetection."
msgstr "Vylepšená automatická detekcia formátu súboru."

msgid "Extended keyboard shortcuts."
msgstr "Rozšírené klávesové skratky."

