msgid "Added support for shields.io badge."
msgstr "Pridaná podpora pre odznak shields.io."

msgid "Weblate 1.8"
msgstr "Weblate 1.8"

msgid "*Released on November 7th 2013.*"
msgstr "*Vydané 7. novembra 2013.*"

msgid "Please check manual for upgrade instructions."
msgstr "Prosím, skontrolujte manuál pre pokyny na aktualizáciu."

msgid "Nicer listing of project summary."
msgstr "Krajší zoznam súhrnu projektu."

msgid "Better visible options for sharing."
msgstr "Lepšie viditeľné možnosti zdieľania."

msgid "More control over anonymous users privileges."
msgstr "Viac kontroly nad oprávneniami anonymných používateľov."

msgid ""
"Supports login using third party services, check manual for more details."
msgstr ""
"Podporuje prihlasovanie pomocou služieb tretích strán, viac podrobností "
