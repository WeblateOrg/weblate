"Možnosť odosielať zmeny do vzdialeného repozitára z webového rozhrania."

msgid "Added review of translations done by others."
msgstr "Pridaná kontrola prekladov vykonaných inými."

msgid "Weblate 0.7"
msgstr "Weblate 0.7"

msgid "*Released on February 16th 2012.*"
msgstr "*Vydané 16. februára 2012.*"

msgid "Direct support for GitHub notifications."
msgstr "Priama podpora pre notifikácie GitHubu."

msgid "Added support for cleaning up orphaned checks and translations."
msgstr "Pridaná podpora pre čistenie osamelých kontrol a prekladov."

msgid "Displays nearby strings while translating."
msgstr "Zobrazuje blízke reťazce počas prekladu."

msgid "Displays similar strings while translating."
msgstr "Zobrazuje podobné reťazce počas prekladu."

msgid "Improved searching for string."
msgstr "Vylepšené vyhľadávanie reťazca."

msgid "Weblate 0.6"
msgstr "Weblate 0.6"

msgid "*Released on February 14th 2012.*"
msgstr "*Vydané 14. februára 2012.*"

msgid "Added various checks for translated messages."
msgstr "Pridané rôzne kontroly pre preložené správy."

msgid "Tunable access control."
msgstr "Nastaviteľné riadenie prístupu."

