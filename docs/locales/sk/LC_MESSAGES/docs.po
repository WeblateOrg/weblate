msgstr ""
"Používatelia sa môžu prihlásiť pomocou e-mailu namiesto používateľského mena."

msgid "Improved source strings review."
msgstr "Vylepšená kontrola zdrojových reťazcov."

msgid "Searching across all strings."
msgstr "Vyhľadávanie vo všetkých reťazcoch."

msgid "Better tracking of source strings."
msgstr "Lepšie sledovanie zdrojových reťazcov."

msgid "Captcha protection for registration."
msgstr "Ochrana Captcha pre registráciu."

msgid "Weblate 1.7"
msgstr "Weblate 1.7"

msgid "*Released on October 7th 2013.*"
msgstr "*Vydané 7. októbra 2013.*"

msgid "Support for checking Python brace format string."
msgstr "Podpora kontroly formátovacích reťazcov Pythonu so zátvorkami."

msgid "Per component customization of quality checks."
msgstr "Prispôsobenie kontrol kvality pre každý komponent."

msgid "Detailed per translation stats."
msgstr "Podrobné štatistiky pre každý preklad."

msgid "Changed way of linking suggestions, checks and comments to strings."
msgstr "Zmenený spôsob prepojenia návrhov, kontrol a komentárov s reťazcami."

msgid "Users can now add text to commit message."
msgstr "Používatelia teraz môžu pridať text do správy zápisu."

msgid "Support for subscribing on new language requests."
msgstr "Podpora prihlasovania sa na odber žiadostí o nový jazyk."

msgid "Support for adding new translations."
msgstr "Podpora pridávania nových prekladov."

msgid ""
"Widgets and charts are now rendered using Pillow instead of Pango + Cairo."
msgstr ""
"Widgety a grafy sa teraz vykresľujú pomocou Pillow namiesto Pango + Cairo."

msgid "Add status badge widget."
msgstr "Pridaný widget stavového odznaku."

msgid "Dropped invalid text direction check."
msgstr "Zrušená kontrola neplatného smeru textu."

msgid "Changes in dictionary are now logged in history."
msgstr "Zmeny v slovníku sa teraz zaznamenávajú do histórie."

msgid "Performance improvements for translation view."
msgstr "Vylepšenia výkonu pre zobrazenie prekladu."

msgid "Weblate 1.6"
msgstr "Weblate 1.6"

msgid "*Released on July 25th 2013.*"
msgstr "*Vydané 25. júla 2013.*"

msgid "Nicer error handling on registration."
msgstr "Krajšie spracovanie chýb pri registrácii."

msgid "Browsing of changes."
msgstr "Prehliadanie zmien."

msgid "Fixed sorting of machine translation suggestions."
msgstr "Opravené triedenie návrhov strojového prekladu."

msgid "Improved support for MyMemory machine translation."
msgstr "Vylepšená podpora pre strojový preklad MyMemory."

msgid "Added support for Amagama machine translation."
msgstr "Pridaná podpora pre strojový preklad Amagama."

msgid "Various optimizations on frequently used pages."
msgstr "Rôzne optimalizácie na často používaných stránkach."

msgid "Highlights searched phrase in search results."
msgstr "Zvýrazňuje hľadanú frázu vo výsledkoch vyhľadávania."

msgid "Support for automatic fixups while saving the message."
msgstr "Podpora automatických opráv pri ukladaní správy."

msgid "Tracking of translation history and option to revert it."
msgstr "Sledovanie histórie prekladu a možnosť jej vrátenia späť."

msgid "Added support for Google Translate API."
msgstr "Pridaná podpora pre API Google Translate."

msgid "Added support for managing SSH host keys."
msgstr "Pridaná podpora pre správu hostiteľských kľúčov SSH."

msgid "Various form validation improvements."
msgstr "Rôzne vylepšenia overovania formulárov."

msgid "Various quality checks improvements."
msgstr "Rôzne vylepšenia kontrol kvality."

msgid "Performance improvements for import."
msgstr "Vylepšenia výkonu pre import."

msgid "Added support for voting on suggestions."
msgstr "Pridaná podpora hlasovania o návrhoch."

msgid "Cleanup of admin interface."
msgstr "Vyčistenie administrátorského rozhrania."

msgid "Weblate 1.5"
msgstr "Weblate 1.5"

msgid "*Released on April 16th 2013.*"
msgstr "*Vydané 16. apríla 2013.*"

msgid "Added public user pages."
msgstr "Pridané verejné stránky používateľov."

msgid "Better naming of plural forms."
msgstr "Lepšie pomenovanie tvarov množného čísla."

msgid "Added support for TBX export of glossary."
msgstr "Pridaná podpora pre export slovníka do formátu TBX."

msgid "Added support for Bitbucket notifications."
msgstr "Pridaná podpora pre notifikácie Bitbucketu."

msgid ""
"Activity charts are now available for each translation, language or user."
msgstr ""
"Grafy aktivity sú teraz dostupné pre každý preklad, jazyk alebo používateľa."

msgid "Extended options of import_project admin command."
msgstr "Rozšírené možnosti správcovského príkazu import_project."

msgid "Compatible with Django 1.5."
msgstr "Kompatibilné s Django 1.5."

msgid "Avatars are now shown using libravatar."
msgstr "Avatary sa teraz zobrazujú pomocou libravatar."

msgid "Added possibility to pretty print JSON export."
msgstr "Pridaná možnosť pekného formátovania JSON exportu."

msgid "Various performance improvements."
msgstr "Rôzne vylepšenia výkonu."

msgid ""
"Indicate failing checks or fuzzy strings in progress bars for projects or "
"languages as well."
msgstr ""
"Označenie nevyhovujúcich kontrol alebo fuzzy reťazcov v ukazovateľoch "
"priebehu pre projekty alebo jazyky."

msgid ""
"Added support for custom pre-commit hooks and committing additional files."
msgstr ""
"Pridaná podpora pre vlastné háky pred zápisom a zapisovanie dodatočných "
"súborov."

msgid "Rewritten search for better performance and user experience."
msgstr "Prepísané vyhľadávanie pre lepší výkon a používateľský zážitok."

msgid "New interface for machine translations."
msgstr "Nové rozhranie pre strojové preklady."

msgid "Added support for monolingual po files."
msgstr "Pridaná podpora pre jednojazyčné súbory po."

msgid "Extend amount of cached metadata to improve speed of various searches."
msgstr ""
"Rozšírené množstvo metadát vo vyrovnávacej pamäti na zlepšenie rýchlosti "
"rôznych vyhľadávaní."

msgid "Now shows word counts as well."
msgstr "Teraz zobrazuje aj počty slov."

msgid "Weblate 1.4"
msgstr "Weblate 1.4"

msgid "*Released on January 23rd 2013.*"
msgstr "*Vydané 23. januára 2013.*"

msgid "Fixed deleting of checks/comments on string deletion."
msgstr "Opravené mazanie kontrol/komentárov pri mazaní reťazca."

msgid "Added option to disable automatic propagation of translations."
msgstr "Pridaná možnosť zakázať automatickú propagáciu prekladov."

msgid "Added option to subscribe for merge failures."
msgstr "Pridaná možnosť prihlásiť sa na odber zlyhaní zlučovania."

msgid "Correctly import on projects which needs custom ttkit loader."
msgstr "Správny import pre projekty, ktoré potrebujú vlastný načítač ttkit."

msgid "Added sitemaps to allow easier access by crawlers."
msgstr "Pridané sitemapy na umožnenie ľahšieho prístupu pre crawlery."

msgid "Provide direct links to string in notification e-mails or feeds."
msgstr ""
"Poskytovanie priamych odkazov na reťazec v notifikačných e-mailoch alebo "
"kanáloch."

msgid "Various improvements to admin interface."
msgstr "Rôzne vylepšenia administrátorského rozhrania."

msgid "Provide hints for production setup in admin interface."
msgstr ""
"Poskytovanie tipov pre produkčné nastavenie v administrátorskom rozhraní."

msgid "Added per language widgets and engage page."
msgstr "Pridané widgety pre každý jazyk a stránka Zapojiť sa."

msgid "Improved translation locking handling."
msgstr "Vylepšené spracovanie uzamykania prekladov."

msgid "Show code snippets for widgets in more variants."
msgstr "Zobrazenie ukážok kódu pre widgety vo viacerých variantoch."

msgid "Indicate failing checks or fuzzy strings in progress bars."
msgstr ""
"Označenie nevyhovujúcich kontrol alebo fuzzy reťazcov v ukazovateľoch "
"priebehu."

msgid "More options for formatting commit message."
msgstr "Viac možností pre formátovanie správy zápisu."

msgid "Fixed error handling with machine translation services."
msgstr "Opravené spracovanie chýb so službami strojového prekladu."

msgid "Improved automatic translation locking behaviour."
msgstr "Vylepšené správanie automatického uzamykania prekladu."

msgid "Support for showing changes from previous source string."
msgstr "Podpora zobrazovania zmien z predchádzajúceho zdrojového reťazca."

msgid "Added support for substring search."
msgstr "Pridaná podpora vyhľadávania podreťazca."

msgid "Support for per project ACL."
msgstr "Podpora ACL pre každý projekt."

msgid "Basic code coverage by unit tests."
msgstr "Základné pokrytie kódu unit testami."

msgid "Weblate 1.3"
msgstr "Weblate 1.3"

msgid "*Released on November 16th 2012.*"
msgstr "*Vydané 16. novembra 2012.*"

msgid "Compatibility with PostgreSQL database backend."
msgstr "Kompatibilita s databázovým backendom PostgreSQL."

msgid "Removes languages removed in upstream git repository."
msgstr "Odstraňuje jazyky odstránené v hlavnom git repozitári."

msgid "Improved quality checks processing."
msgstr "Vylepšené spracovanie kontrol kvality."

msgid "Added new checks (BBCode, XML markup and newlines)."
msgstr "Pridané nové kontroly (BBCode, XML značky a nové riadky)."

msgid "Support for optional rebasing instead of merge."
msgstr "Podpora voliteľného rebasovania namiesto zlučovania."

msgid ""
"Possibility to relocate Weblate (for example to run it under /weblate path)."
msgstr "Možnosť presunúť Weblate (napríklad na spustenie pod cestou /weblate)."

msgid "Support for manually choosing file type in case autodetection fails."
msgstr ""
"Podpora manuálneho výberu typu súboru v prípade, že automatická detekcia "
"zlyhá."

msgid "Better support for Android resources."
msgstr "Lepšia podpora pre zdroje Androidu."

msgid "Support for generating SSH key from web interface."
msgstr "Podpora generovania SSH kľúča z webového rozhrania."

msgid "More visible data exports."
msgstr "Viditeľnejšie exporty dát."

msgid "New buttons to enter some special characters."
msgstr "Nové tlačidlá na zadávanie niektorých špeciálnych znakov."

msgid "Support for exporting dictionary."
msgstr "Podpora exportu slovníka."

msgid "Support for locking down whole Weblate installation."
msgstr "Podpora uzamknutia celej inštalácie Weblate."

msgid "Checks for source strings and support for source strings review."
msgstr "Kontroly pre zdrojové reťazce a podpora kontroly zdrojových reťazcov."

msgid "Support for user comments for both translations and source strings."
msgstr "Podpora používateľských komentárov pre preklady aj zdrojové reťazce."

msgid "Better changes log tracking."
msgstr "Lepšie sledovanie protokolu zmien."

msgid "Changes can now be monitored using RSS."
msgstr "Zmeny je teraz možné monitorovať pomocou RSS."

msgid "Improved support for RTL languages."
msgstr "Vylepšená podpora pre jazyky písané sprava doľava (RTL)."

msgid "Weblate 1.2"
msgstr "Weblate 1.2"

msgid "*Released on August 14th 2012.*"
msgstr "*Vydané 14. augusta 2012.*"

msgid ""
"Weblate now uses South for database migration, please check upgrade "
"instructions if you are upgrading."
msgstr ""
"Weblate teraz používa South pre migráciu databázy, prosím, skontrolujte "
"pokyny na aktualizáciu, ak vykonávate aktualizáciu."

msgid "Fixed minor issues with linked git repos."
msgstr "Opravené drobné problémy s prepojenými git repozitármi."

msgid ""
"New introduction page for engaging people with translating using Weblate."
msgstr "Nová úvodná stránka na zapojenie ľudí do prekladania pomocou Weblate."

msgid "Added widgets which can be used for promoting translation projects."
msgstr ""
"Pridané widgety, ktoré môžu byť použité na propagáciu prekladových projektov."

msgid "Added option to reset repository to origin (for privileged users)."
msgstr ""
"Pridaná možnosť resetovať repozitár na pôvodný stav (pre privilegovaných "
"používateľov)."

msgid "Project or component can now be locked for translations."
msgstr "Projekt alebo komponent môže byť teraz uzamknutý pre preklady."

msgid "Possibility to disable some translations."
msgstr "Možnosť zakázať niektoré preklady."

msgid "Configurable options for adding new translations."
msgstr "Konfigurovateľné možnosti pre pridávanie nových prekladov."

msgid "Configuration of git commits per project."
msgstr "Konfigurácia git zápisov pre každý projekt."

msgid "Simple antispam protection."
msgstr "Jednoduchá ochrana proti spamu."

msgid "Better layout of main page."
msgstr "Lepšie rozloženie hlavnej stránky."

msgid "Support for automatically pushing changes on every commit."
msgstr "Podpora automatického odosielania zmien pri každom zápise."

msgid "Support for e-mail notifications of translators."
msgstr "Podpora e-mailových notifikácií pre prekladateľov."

msgid "List only used languages in preferences."
msgstr "Zobraziť v preferenciách iba používané jazyky."

msgid "Improved handling of not known languages when importing project."
msgstr "Vylepšené spracovanie neznámych jazykov pri importe projektu."

msgid "Support for locking translation by translator."
msgstr "Podpora uzamykania prekladu prekladateľom."

msgid "Optionally maintain ``Language-Team`` header in po file."
msgstr "Voliteľná údržba hlavičky ``Language-Team`` v súbore po."

msgid "Include some statistics in about page."
msgstr "Zahrnutie niektorých štatistík na stránke O nás."

msgid "Supports (and requires) django-registration 0.8."
msgstr "Podporuje (a vyžaduje) django-registration 0.8."

msgid "Caching counts of strings with failing checks."
msgstr ""
"Ukladanie do vyrovnávacej pamäte počtov reťazcov s nevyhovujúcimi kontrolami."

msgid "Checking of requirements during setup."
msgstr "Kontrola požiadaviek počas nastavenia."

msgid "Weblate 1.1"
msgstr "Weblate 1.1"

msgid "*Released on July 4th 2012.*"
msgstr "*Vydané 4. júla 2012.*"

msgid "Improved several translations."
msgstr "Vylepšených niekoľko prekladov."

msgid "Added support for shared git repositories across components."
msgstr "Pridaná podpora pre zdieľané git repozitáre naprieč komponentmi."

msgid "Do not necessary commit on every attempt to pull remote repo."
msgstr ""
"Nie je nutné zapisovať pri každom pokuse o stiahnutie vzdialeného repozitára."

msgid "Added support for offloading indexing."
msgstr "Pridaná podpora pre odľahčenie indexovania."

msgid "Weblate 1.0"
msgstr "Weblate 1.0"

msgid "*Released on May 10th 2012.*"
msgstr "*Vydané 10. mája 2012.*"

msgid "Improved validation while adding/saving component."
msgstr "Vylepšené overovanie pri pridávaní/ukladaní komponentu."

msgid "Experimental support for Android component files (needs patched ttkit)."
msgstr ""
"Experimentálna podpora pre súbory komponentov Androidu (potrebuje "
"opatchovaný ttkit)."

msgid "Updates from hooks are run in background."
msgstr "Aktualizácie z hákov sa spúšťajú na pozadí."

msgid "Improved installation instructions."
msgstr "Vylepšené inštalačné pokyny."

msgid "Improved navigation in dictionary."
msgstr "Vylepšená navigácia v slovníku."

msgid "Weblate 2.x series"
msgstr "Séria Weblate 2.x"

msgid "Weblate 2.20"
msgstr "Weblate 2.20"

msgid "*Released on April 4th 2018.*"
msgstr "*Vydané 4. apríla 2018.*"

msgid "Improved speed of cloning subversion repositories."
msgstr "Vylepšená rýchlosť klonovania repozitárov Subversion."

msgid "Changed repository locking to use third party library."
msgstr "Zmenené uzamykanie repozitára na použitie knižnice tretej strany."

msgid "Added support for downloading only strings needing action."
msgstr "Pridaná podpora pre sťahovanie iba reťazcov vyžadujúcich akciu."

msgid "Added support for searching in several languages at once."
msgstr "Pridaná podpora pre vyhľadávanie vo viacerých jazykoch naraz."

msgid "New add-on to configure gettext output wrapping."
msgstr "Nový doplnok na konfiguráciu zalamovania výstupu gettext."

msgid "New add-on to configure JSON formatting."
msgstr "Nový doplnok na konfiguráciu formátovania JSON."

msgid ""
"Added support for authentication in API using RFC 6750 compatible Bearer "
"authentication."
msgstr ""
"Pridaná podpora pre autentifikáciu v API pomocou Bearer autentifikácie "
"kompatibilnej s RFC 6750."

msgid ""
"Added support for automatic translation using machine translation services."
msgstr ""
"Pridaná podpora pre automatický preklad pomocou služieb strojového prekladu."

msgid "Added support for HTML markup in whiteboard messages."
msgstr "Pridaná podpora pre HTML značky v správach na nástenke."

msgid "Added support for mass changing state of strings."
msgstr "Pridaná podpora pre hromadnú zmenu stavu reťazcov."

msgid ""
"Translate-toolkit at least 2.3.0 is now required, older versions are no "
"longer supported."
msgstr ""
"Vyžaduje sa translate-toolkit aspoň vo verzii 2.3.0, staršie verzie už nie "
"sú podporované."

msgid "Added built-in translation memory."
msgstr "Pridaná vstavaná prekladová pamäť."

msgid ""
"Added componentlists overview to dashboard and per component list overview "
"pages."
msgstr ""
"Pridaný prehľad zoznamov komponentov na nástenku a na stránky prehľadu "
"zoznamu komponentov."

msgid "Added support for DeepL machine translation service."
msgstr "Pridaná podpora pre službu strojového prekladu DeepL."

msgid "Machine translation results are now cached inside Weblate."
msgstr ""
"Výsledky strojového prekladu sa teraz ukladajú do vyrovnávacej pamäte vo "
"Weblate."

msgid "Added support for reordering committed changes."
msgstr "Pridaná podpora pre preusporiadanie zapísaných zmien."

msgid "Weblate 2.19.1"
msgstr "Weblate 2.19.1"

msgid "*Released on February 20th 2018.*"
msgstr "*Vydané 20. februára 2018.*"

msgid "Fixed migration issue on upgrade from 2.18."
msgstr "Opravený problém s migráciou pri aktualizácii z verzie 2.18."

msgid "Improved file upload API validation."
msgstr "Vylepšené overovanie API pre nahrávanie súborov."

msgid "Weblate 2.19"
msgstr "Weblate 2.19"

msgid "*Released on February 15th 2018.*"
msgstr "*Vydané 15. februára 2018.*"

msgid "Fixed imports across some file formats."
msgstr "Opravené importy pre niektoré formáty súborov."

msgid "Display human friendly browser information in audit log."
msgstr ""
"Zobrazenie ľudsky čitateľných informácií o prehliadači v audítorskom "
"protokole."

msgid "Added TMX exporter for files."
msgstr "Pridaný exportér TMX pre súbory."

msgid "Various performance improvements for loading translation files."
msgstr "Rôzne vylepšenia výkonu pre načítavanie prekladových súborov."

msgid ""
"Added option to disable access management in Weblate in favor of Django one."
msgstr ""
"Pridaná možnosť zakázať správu prístupu vo Weblate v prospech tej z Django."

msgid "Improved glossary lookup speed for large strings."
msgstr "Vylepšená rýchlosť vyhľadávania v slovníku pre dlhé reťazce."

msgid "Compatibility with django_auth_ldap 1.3.0."
msgstr "Kompatibilita s django_auth_ldap 1.3.0."

msgid "Configuration errors are now stored and reported persistently."
msgstr "Chyby konfigurácie sa teraz ukladajú a hlásia trvalo."

msgid "Honor ignore flags in whitespace autofixer."
msgstr ""
"Rešpektovanie príznakov ignorovania v automatickej oprave bielych znakov."

msgid "Improved compatibility with some Subversion setups."
msgstr "Vylepšená kompatibilita s niektorými nastaveniami Subversion."

msgid "Improved built-in machine translation service."
msgstr "Vylepšená vstavaná služba strojového prekladu."

msgid "Added support for SAP Translation Hub service."
msgstr "Pridaná podpora pre službu SAP Translation Hub."

msgid "Added support for Microsoft Terminology service."
msgstr "Pridaná podpora pre službu Microsoft Terminology."

msgid "Removed support for advertisement in notification e-mails."
msgstr "Odstránená podpora reklám v notifikačných e-mailoch."

msgid "Improved translation progress reporting at language level."
msgstr "Vylepšené hlásenie priebehu prekladu na úrovni jazyka."

msgid "Improved support for different plural formulas."
msgstr "Vylepšená podpora pre rôzne vzorce množného čísla."

msgid "Added support for Subversion repositories not using stdlayout."
msgstr ""
"Pridaná podpora pre repozitáre Subversion, ktoré nepoužívajú stdlayout."

msgid "Added add-ons to customize translation workflows."
msgstr "Pridané doplnky na prispôsobenie pracovných postupov prekladu."

msgid "Weblate 2.18"
msgstr "Weblate 2.18"

msgid "*Released on December 15th 2017.*"
msgstr "*Vydané 15. decembra 2017.*"

msgid "Extended contributor stats."
msgstr "Rozšírené štatistiky prispievateľov."

msgid "Improved configuration of special characters virtual keyboard."
msgstr "Vylepšená konfigurácia virtuálnej klávesnice so špeciálnymi znakmi."

msgid "Added support for DTD file format."
msgstr "Pridaná podpora pre formát súboru DTD."

msgid ""
"Changed keyboard shortcuts to less likely collide with browser/system ones."
msgstr ""
"Zmenené klávesové skratky, aby menej kolidovali s tými z prehliadača/systému."

msgid "Improved support for approved flag in XLIFF files."
msgstr "Vylepšená podpora pre príznak schválenia v súboroch XLIFF."

msgid "Added support for not wrapping long strings in gettext PO files."
msgstr ""
"Pridaná podpora pre nezalamovanie dlhých reťazcov v súboroch gettext PO."

msgid "Added button to copy permalink for current translation."
msgstr "Pridané tlačidlo na kopírovanie trvalého odkazu pre aktuálny preklad."

msgid "Dropped support for Django 1.10 and added support for Django 2.0."
msgstr "Zrušená podpora pre Django 1.10 a pridaná podpora pre Django 2.0."

msgid "Removed locking of translations while translating."
msgstr "Odstránené uzamykanie prekladov počas prekladania."

msgid "Added support for adding new strings to monolingual translations."
msgstr ""
"Pridaná podpora pre pridávanie nových reťazcov do jednojazyčných prekladov."

msgid "Added support for translation workflows with dedicated reviewers."
msgstr ""
"Pridaná podpora pre pracovné postupy prekladu s vyhradenými recenzentmi."

msgid "Weblate 2.17.1"
msgstr "Weblate 2.17.1"

msgid "*Released on October 13th 2017.*"
msgstr "*Vydané 13. októbra 2017.*"

msgid "Fixed running testsuite in some specific situations."
msgstr ""
"Opravené spúšťanie testovacej sady v niektorých špecifických situáciách."

msgid "Locales updates."
msgstr "Aktualizácie lokalizácií."

msgid "Weblate 2.17"
msgstr "Weblate 2.17"

msgid "Weblate by default does shallow Git clones now."
msgstr "Weblate teraz predvolene robí plytké klony Gitu."

msgid "Improved performance when updating large translation files."
msgstr "Vylepšený výkon pri aktualizácii veľkých prekladových súborov."

msgid "Added support for blocking certain e-mails from registration."
msgstr "Pridaná podpora pre blokovanie určitých e-mailov pri registrácii."

msgid "Users can now delete their own comments."
msgstr "Používatelia si teraz môžu mazať vlastné komentáre."

msgid "Added preview step to search and replace feature."
msgstr "Pridaný krok náhľadu k funkcii vyhľadávania a nahradzovania."

msgid "Client side persistence of settings in search and upload forms."
msgstr ""
"Trvalosť nastavení na strane klienta vo formulároch vyhľadávania a "
"nahrávania."

msgid "Extended search capabilities."
msgstr "Rozšírené možnosti vyhľadávania."

msgid "More fine grained per project ACL configuration."
msgstr "Jemnejšie nastavenie ACL pre každý projekt."

msgid "Default value of BASE_DIR has been changed."
msgstr "Predvolená hodnota BASE_DIR bola zmenená."

msgid "Added two step account removal to prevent accidental removal."
msgstr ""
"Pridané dvojstupňové odstránenie účtu na zabránenie náhodnému odstráneniu."

msgid "Project access control settings is now editable."
msgstr "Nastavenia riadenia prístupu k projektu sú teraz upraviteľné."

msgid "Added optional spam protection for suggestions using Akismet."
msgstr ""
"Pridaná voliteľná ochrana proti spamu pre návrhy pomocou služby Akismet."

msgid "Weblate 2.16"
msgstr "Weblate 2.16"

msgid "*Released on August 11th 2017.*"
msgstr "*Vydané 11. augusta 2017.*"

msgid "Added support for nested JSON format."
msgstr "Pridaná podpora pre vnorený formát JSON."

msgid "Added support for WebExtension JSON format."
msgstr "Pridaná podpora pre formát JSON WebExtension."

msgid "Fixed git exporter authentication."
msgstr "Opravená autentifikácia exportéra git."

msgid "Improved CSV import in certain situations."
msgstr "Vylepšený import CSV v určitých situáciách."

msgid "Improved look of Other translations widget."
msgstr "Vylepšený vzhľad widgetu Ďalšie preklady."

msgid "The max-length checks is now enforcing length of text in form."
msgstr "Kontroly max-length teraz vynucujú dĺžku textu vo formulári."

msgid "Make the commit_pending age configurable per component."
msgstr "Urobiť vek čakajúcich zápisov konfigurovateľným pre každý komponent."

msgid "Various user interface cleanups."
msgstr "Rôzne vyčistenia používateľského rozhrania."

msgid "Fixed component/project/site wide search for translations."
msgstr ""
"Opravené vyhľadávanie prekladov v rámci komponentu/projektu/celého webu."

msgid "Weblate 2.15"
msgstr "Weblate 2.15"

msgid "*Released on June 30th 2017.*"
msgstr "*Vydané 30. júna 2017.*"

msgid "Show more related translations in other translations."
msgstr "Zobraziť viac súvisiacich prekladov v iných prekladoch."

msgid "Add option to see translations of current string to other languages."
msgstr "Pridať možnosť zobraziť preklady aktuálneho reťazca do iných jazykov."

msgid "Use 4 plural forms for Lithuanian by default."
msgstr "Predvolene použiť 4 tvary množného čísla pre litovčinu."

msgid "Fixed upload for monolingual files of different format."
msgstr "Opravené nahrávanie pre jednojazyčné súbory rôzneho formátu."

msgid "Improved error messages on failed authentication."
msgstr "Vylepšené chybové správy pri neúspešnej autentifikácii."

msgid "Keep page state when removing word from glossary."
msgstr "Zachovať stav stránky pri odstraňovaní slova zo slovníka."

msgid "Added direct link to edit secondary language translation."
msgstr "Pridaný priamy odkaz na úpravu prekladu sekundárneho jazyka."

msgid "Added Perl format quality check."
msgstr "Pridaná kontrola kvality formátu Perl."

msgid "Added support for rejecting reused passwords."
msgstr "Pridaná podpora pre zamietanie opätovne použitých hesiel."

msgid "Extended toolbar for editing RTL languages."
msgstr "Rozšírený panel nástrojov pre úpravu jazykov RTL."

msgid "Weblate 2.14.1"
msgstr "Weblate 2.14.1"

msgid "*Released on May 24th 2017.*"
msgstr "*Vydané 24. mája 2017.*"

msgid "Fixed possible error when paginating search results."
msgstr "Opravená možná chyba pri stránkovaní výsledkov vyhľadávania."

msgid "Fixed migrations from older versions in some corner cases."
msgstr ""
"Opravené migrácie zo starších verzií v niektorých hraničných prípadoch."

msgid "Fixed possible CSRF on project watch and unwatch."
msgstr "Opravená možná CSRF pri sledovaní a nesledovaní projektu."

msgid "The password reset no longer authenticates user."
msgstr "Resetovanie hesla už neautentifikuje používateľa."

msgid "Fixed possible CAPTCHA bypass on forgotten password."
msgstr "Opravené možné obídenie CAPTCHA pri zabudnutom hesle."

msgid "Weblate 2.14"
msgstr "Weblate 2.14"

msgid "*Released on May 17th 2017.*"
msgstr "*Vydané 17. mája 2017.*"

msgid "Add glossary entries using AJAX."
msgstr "Pridávanie položiek slovníka pomocou AJAXu."

msgid "The logout now uses POST to avoid CSRF."
msgstr "Odhlásenie teraz používa POST na zabránenie CSRF."

msgid "The API key token reset now uses POST to avoid CSRF."
msgstr "Resetovanie tokenu API kľúča teraz používa POST na zabránenie CSRF."

msgid "Weblate sets Content-Security-Policy by default."
msgstr "Weblate predvolene nastavuje Content-Security-Policy."

msgid "The local editor URL is validated to avoid self-XSS."
msgstr "URL lokálneho editora je overovaná na zabránenie self-XSS."

msgid "The password is now validated against common flaws by default."
msgstr "Heslo je teraz predvolene overované proti bežným chybám."

msgid ""
"Notify users about important activity with their account such as password "
"change."
msgstr ""
"Upozorniť používateľov na dôležitú aktivitu s ich účtom, ako je zmena hesla."

msgid "The CSV exports now escape potential formulas."
msgstr "Exporty CSV teraz escapujú potenciálne vzorce."

msgid "Various minor improvements in security."
msgstr "Rôzne drobné vylepšenia v bezpečnosti."

msgid "The authentication attempts are now rate limited."
msgstr "Pokusy o autentifikáciu sú teraz obmedzené rýchlosťou."

msgid "Suggestion content is stored in the history."
msgstr "Obsah návrhu je ukladaný do histórie."

msgid "Store important account activity in audit log."
msgstr "Ukladanie dôležitej aktivity účtu do audítorského protokolu."

msgid ""
"Ask for password confirmation when removing account or adding new "
"associations."
msgstr ""
"Vyžiadať potvrdenie heslom pri odstraňovaní účtu alebo pridávaní nových "
"priradení."

msgid "Show time when suggestion has been made."
msgstr "Zobraziť čas, kedy bol návrh vytvorený."

msgid "There is new quality check for trailing semicolon."
msgstr "Existuje nová kontrola kvality pre koncovú bodkočiarku."

msgid "Ensure that search links can be shared."
msgstr "Zabezpečiť, aby boli odkazy na vyhľadávanie zdieľateľné."

msgid "Included source string information and screenshots in the API."
msgstr "Zahrnuté informácie o zdrojovom reťazci a snímky obrazovky v API."

msgid "Allow to overwrite translations through API upload."
msgstr "Umožniť prepisovanie prekladov prostredníctvom nahrávania API."

msgid "Weblate 2.13.1"
msgstr "Weblate 2.13.1"

msgid "*Released on Apr 12th 2017.*"
msgstr "*Vydané 12. apríla 2017.*"

msgid "Fixed listing of managed projects in profile."
msgstr "Opravený zoznam spravovaných projektov v profile."

msgid "Fixed migration issue where some permissions were missing."
msgstr "Opravený problém s migráciou, kde chýbali niektoré oprávnenia."

msgid "Fixed listing of current file format in translation download."
msgstr "Opravený zoznam aktuálneho formátu súboru pri sťahovaní prekladu."

msgid ""
"Return HTTP 404 when trying to access project where user lacks privileges."
msgstr ""
"Vrátiť HTTP 404 pri pokuse o prístup k projektu, kde používateľ nemá "
"oprávnenia."

msgid "Weblate 2.13"
msgstr "Weblate 2.13"

msgid "Fixed quality checks on translation templates."
msgstr "Opravené kontroly kvality na šablónach prekladov."

msgid "Added quality check to trigger on losing translation."
msgstr "Pridaná kontrola kvality, ktorá sa spustí pri strate prekladu."

msgid "Add option to view pending suggestions from user."
msgstr "Pridať možnosť zobraziť čakajúce návrhy od používateľa."

msgid "Add option to automatically build component lists."
msgstr "Pridať možnosť automaticky zostavovať zoznamy komponentov."

msgid "Default dashboard for unauthenticated users can be configured."
msgstr ""
"Predvolená nástenka pre neoverených používateľov môže byť konfigurovaná."

msgid "Add option to browse 25 random strings for review."
msgstr "Pridať možnosť prehliadať 25 náhodných reťazcov na kontrolu."

msgid "History now indicates string change."
msgstr "História teraz indikuje zmenu reťazca."

msgid "Better error reporting when adding new translation."
msgstr "Lepšie hlásenie chýb pri pridávaní nového prekladu."

msgid "Added per language search within project."
msgstr "Pridané vyhľadávanie pre každý jazyk v rámci projektu."

msgid "Group ACLs can now be limited to certain permissions."
msgstr "Skupinové ACL môžu byť teraz obmedzené na určité oprávnenia."

msgid "The per project ACLs are now implemented using Group ACL."
msgstr "ACL pre každý projekt sú teraz implementované pomocou skupinového ACL."

msgid "Added more fine grained privileges control."
msgstr "Pridaná jemnejšia kontrola oprávnení."

msgid "Various minor UI improvements."
msgstr "Rôzne drobné vylepšenia používateľského rozhrania."

msgid "Weblate 2.12"
msgstr "Weblate 2.12"

msgid "*Released on Mar 3rd 2017.*"
msgstr "*Vydané 3. marca 2017.*"

msgid "Improved admin interface for groups."
msgstr "Vylepšené administrátorské rozhranie pre skupiny."

msgid "Added support for Yandex Translate API."
msgstr "Pridaná podpora pre API Yandex Translate."

msgid "Improved speed of site wide search."
msgstr "Vylepšená rýchlosť vyhľadávania na celom webe."

msgid "Added project and component wide search."
msgstr "Pridané vyhľadávanie v rámci projektu a komponentu."

msgid "Added project and component wide search and replace."
msgstr "Pridané vyhľadávanie a nahradzovanie v rámci projektu a komponentu."

msgid "Improved rendering of inconsistent translations."
msgstr "Vylepšené vykresľovanie nekonzistentných prekladov."

msgid "Added support for opening source files in local editor."
msgstr "Pridaná podpora pre otváranie zdrojových súborov v lokálnom editore."

msgid "Added support for configuring visual keyboard with special characters."
msgstr ""
"Pridaná podpora pre konfiguráciu vizuálnej klávesnice so špeciálnymi znakmi."

msgid ""
"Improved screenshot management with OCR support for matching source strings."
msgstr ""
"Vylepšená správa snímok obrazovky s podporou OCR na zhodu zdrojových "
"reťazcov."

msgid "Default commit message now includes translation information and URL."
msgstr "Predvolená správa zápisu teraz obsahuje informácie o preklade a URL."

msgid "Added support for Joomla translation format."
msgstr "Pridaná podpora pre formát prekladu Joomla."

msgid "Improved reliability of import across file formats."
msgstr "Vylepšená spoľahlivosť importu naprieč formátmi súborov."

msgid "Weblate 2.11"
msgstr "Weblate 2.11"

msgid "*Released on Jan 31st 2017.*"
msgstr "*Vydané 31. januára 2017.*"

msgid "Include language detailed information on language page."
msgstr "Zahrnúť podrobné informácie o jazyku na stránke jazyka."

msgid "Mercurial backend improvements."
msgstr "Vylepšenia backendu Mercurial."

msgid "Added option to specify translation component priority."
msgstr "Pridaná možnosť špecifikovať prioritu prekladového komponentu."

msgid "More consistent usage of Group ACL even with less used permissions."
msgstr ""
"Konzistentnejšie používanie skupinového ACL aj pri menej používaných "
"oprávneniach."

msgid "Added WL_BRANCH variable to hook scripts."
msgstr "Pridaná premenná WL_BRANCH do skriptov hákov."

msgid "Improved developer documentation."
msgstr "Vylepšená dokumentácia pre vývojárov."

msgid "Better compatibility with various Git versions in Git exporter add-on."
msgstr "Lepšia kompatibilita s rôznymi verziami Gitu v doplnku Git exporter."

msgid "Included per project and component stats."
msgstr "Zahrnuté štatistiky pre každý projekt a komponent."

msgid ""
"Added language code mapping for better support of Microsoft Translate API."
msgstr ""
"Pridané mapovanie kódov jazykov pre lepšiu podporu API Microsoft Translate."

msgid ""
"Moved fulltext cleanup to background job to make translation removal faster."
msgstr ""
"Presunuté čistenie fulltextu na úlohu na pozadí na zrýchlenie odstraňovania "
"prekladov."

msgid ""
"Fixed displaying of plural source for languages with single plural form."
msgstr ""
"Opravené zobrazovanie zdroja množného čísla pre jazyky s jedným tvarom "
"množného čísla."

msgid "Improved error handling in import_project."
msgstr "Vylepšené spracovanie chýb v import_project."

msgid "Weblate 2.10.1"
msgstr "Weblate 2.10.1"

msgid "*Released on Jan 20th 2017.*"
msgstr "*Vydané 20. januára 2017.*"

msgid ""
"Do not leak account existence on password reset form (:cve:`2017-5537`)."
msgstr ""
"Neuniká existencia účtu vo formulári na resetovanie hesla (:cve:`2017-5537`)."

msgid "Weblate 2.10"
msgstr "Weblate 2.10"

msgid "*Released on Dec 15th 2016.*"
msgstr "*Vydané 15. decembra 2016.*"

msgid ""
"Added quality check to check whether plurals are translated differently."
msgstr ""
"Pridaná kontrola kvality na overenie, či sú množné čísla preložené rôzne."

msgid "Fixed GitHub hooks for repositories with authentication."
msgstr "Opravené háky GitHubu pre repozitáre s autentifikáciou."

msgid "Added optional Git exporter module."
msgstr "Pridaný voliteľný modul Git exporter."

msgid "Support for Microsoft Cognitive Services Translator API."
msgstr "Podpora pre API Microsoft Cognitive Services Translator."

msgid "Simplified project and component user interface."
msgstr "Zjednodušené používateľské rozhranie projektu a komponentu."

msgid "Added automatic fix to remove control characters."
msgstr "Pridaná automatická oprava na odstránenie riadiacich znakov."

msgid "Added per language overview to project."
msgstr "Pridaný prehľad pre každý jazyk k projektu."

msgid "Added support for CSV export."
msgstr "Pridaná podpora pre export CSV."

msgid "Added CSV download for stats."
msgstr "Pridané sťahovanie CSV pre štatistiky."

msgid "Added matrix view for quick overview of all translations."
msgstr "Pridaný maticový pohľad pre rýchly prehľad všetkých prekladov."

msgid "Added basic API for changes and strings."
msgstr "Pridané základné API pre zmeny a reťazce."

msgid "Added support for Apertium APy server for machine translations."
msgstr "Pridaná podpora pre server Apertium APy pre strojové preklady."

msgid "Weblate 2.9"
msgstr "Weblate 2.9"

msgid "*Released on Nov 4th 2016.*"
msgstr "*Vydané 4. novembra 2016.*"

msgid "Extended parameters for createadmin management command."
msgstr "Rozšírené parametre pre správcovský príkaz createadmin."

msgid "Extended import_json to be able to handle with existing components."
msgstr ""
"Rozšírený import_json, aby bol schopný pracovať s existujúcimi komponentmi."

msgid "Added support for YAML files."
msgstr "Pridaná podpora pre súbory YAML."

msgid ""
"Project owners can now configure translation component and project details."
msgstr ""
"Majitelia projektov teraz môžu konfigurovať podrobnosti prekladového "
"komponentu a projektu."

msgid "Use \"Watched\" instead of \"Subscribed\" projects."
msgstr "Použiť \"Sledované\" namiesto \"Odoberané\" projekty."

msgid "Projects can be watched directly from project page."
msgstr "Projekty môžu byť sledované priamo zo stránky projektu."

msgid "Added multi language status widget."
msgstr "Pridaný widget stavu pre viac jazykov."

