msgstr "Opravené API Google Translate pre hebrejčinu."

msgid "Compatibility with Mercurial 3.8."
msgstr "Kompatibilita s Mercurial 3.8."

msgid "Added import_json management command."
msgstr "Pridaný správcovský príkaz import_json."

msgid "Correct ordering of listed translations."
msgstr "Správne usporiadanie uvedených prekladov."

msgid "Show full suggestion text, not only a diff."
msgstr "Zobraziť celý text návrhu, nielen rozdiel (diff)."

