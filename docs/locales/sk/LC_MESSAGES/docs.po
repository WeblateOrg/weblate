msgid "Weblate 4.11"
msgstr "Weblate 4.11"

msgid "*Released on February 25th 2022.*"
msgstr "*Vydané 25. februára 2022.*"

msgid ""
"Fixes stored XSS - :cve:`2022-24710`, see :ghsa:`6jp6-9rf9-gc66` for more "
"details."
msgstr ""
"Opravy uloženého XSS - :cve:`2022-24710`, viac detailov nájdete "
