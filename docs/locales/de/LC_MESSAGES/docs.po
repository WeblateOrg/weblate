msgstr "Weblate 4.18.1"

msgid "*Released on June 16th 2023.*"
msgstr "*Veröffentlicht am 16. Juni 2023.*"

msgid "Fixed language code format for i18next."
msgstr "Das Format des Sprachcodes für i18next korrigiert."

msgid "Fixed CSS compression with dark theme."
msgstr "CSS-Komprimierung mit dunklem Design korrigiert."

msgid ""
"`All changes in detail <https://github.com/WeblateOrg/weblate/milestone/101?"
"closed=1>`__."
msgstr ""
"`Alle Änderungen im Detail <https://github.com/WeblateOrg/weblate/milestone/"
