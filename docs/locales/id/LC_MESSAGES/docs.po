msgstr "Status ``translated`` atau lebih baik (``approved``)."

msgid "Changed between two given dates (inclusive)."
msgstr "Diubah antara dua tanggal yang diberikan (inklusif)."

msgid "Strings with position between 10 and 100 (inclusive)."
msgstr "String dengan posisi antara 10 dan 100 (inklusif)."

msgid "Searching for DATETIME fields"
