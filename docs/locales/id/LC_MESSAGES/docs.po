msgid "From version control"
msgstr "Dari kontrol versi"

msgid "Creates component from remote version control repository."
msgstr "Membuat komponen dari repositori kontrol versi jarak jauh."

msgid "From existing component"
msgstr "Dari komponen yang ada"

msgid ""
