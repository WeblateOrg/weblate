msgstr ""
"Menambahkan perintah pengelolaan :wladmin:`cleanup_memory` untuk menghapus "
"entri memori terjemahan yang usang."

msgid ":doc:`/formats/catkeys`."
msgstr ":doc:`/formats/catkeys`."

