msgid "Weblate 5.16"
msgstr "Weblate 5.16"

msgid "*Released on February 16th 2026.*"
msgstr "*Dirilis pada 16 Februari 2026.*"

msgid ":ref:`check-multiple-capital` quality check."
msgstr "Pemeriksaan kualitas :ref:`check-multiple-capital`."

