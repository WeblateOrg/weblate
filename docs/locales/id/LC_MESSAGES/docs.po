msgid "Weblate 0.x series"
msgstr "Seri Weblate 0.x"

msgid "Weblate 0.9"
msgstr "Weblate 0.9"

msgid "*Released on April 18th 2012.*"
msgstr "*Dirilis pada 18 April 2012.*"

msgid "Fixed import of unknown languages."
msgstr "Memperbaiki impor bahasa yang tidak dikenal."

msgid "Improved listing of nearby messages."
msgstr "Meningkatkan daftar pesan terdekat."

msgid "Improved several checks."
msgstr "Memperbaiki beberapa pemeriksaan."

msgid "Documentation updates."
msgstr "Pembaruan dokumentasi."

msgid "Added definition for several more languages."
msgstr "Menambahkan definisi untuk beberapa bahasa lainnya."

msgid "Various code cleanups."
msgstr "Berbagai pembersihan kode."

msgid "Documentation improvements."
msgstr "Peningkatan dokumentasi."

msgid "Changed file layout."
msgstr "Tata letak berkas diubah."

msgid "Update helper scripts to Django 1.4."
msgstr "Perbarui skrip pembantu ke Django 1.4."

msgid "Improved navigation while translating."
msgstr "Meningkatkan navigasi saat menerjemahkan."

msgid "Better handling of po file renames."
msgstr "Penanganan penggantian nama berkas po yang lebih baik."

msgid "Better validation while creating component."
msgstr "Validasi yang lebih baik saat membuat komponen."

msgid "Integrated full setup into syncdb."
msgstr "Pengaturan lengkap terintegrasi ke dalam syncdb."

msgid "Added list of recent changes to all translation pages."
msgstr "Menambahkan daftar perubahan terkini ke semua halaman terjemahan."

msgid "Check for untranslated strings ignores format string only messages."
msgstr ""
"Pemeriksaan string yang tidak diterjemahkan mengabaikan pesan string format "
"saja."

msgid "Weblate 0.8"
msgstr "Weblate 0.8"

msgid "*Released on April 3rd 2012.*"
msgstr "*Dirilis pada tanggal 3 April 2012.*"

msgid "Replaced own full text search with Whoosh."
msgstr "Mengganti pencarian teks lengkap sendiri dengan Whoosh."

msgid "Various fixes and improvements to checks."
msgstr "Berbagai perbaikan dan peningkatan pada pemeriksaan."

msgid "New command updatechecks."
msgstr "Pembaruan pemeriksaan perintah baru."

msgid "Lot of translation updates."
msgstr "Banyak pembaruan terjemahan."

msgid "Added dictionary for storing most frequently used terms."
msgstr ""
"Menambahkan kamus untuk menyimpan istilah yang paling sering digunakan."

msgid "Added /admin/report/ for overview of repositories status."
msgstr "Menambahkan /admin/report/ untuk ikhtisar status repositori."

msgid "Machine translation services no longer block page loading."
msgstr "Layanan terjemahan mesin tidak lagi memblokir pemuatan halaman."

msgid "Management interface now contains also useful actions to update data."
msgstr ""
"Antarmuka pengelolaan sekarang juga berisi tindakan yang berguna untuk "
"memperbarui data."

msgid "Records log of changes made by users."
msgstr "Merekam catatan perubahan yang dibuat oleh pengguna."

msgid ""
"Ability to postpone commit to Git to generate less commits from single user."
msgstr ""
"Kemampuan untuk menunda komit pada Git untuk menghasilkan komit lebih "
"sedikit dari satu pengguna."

msgid "Possibility to browse failing checks."
msgstr "Kemungkinan untuk menelusuri pemeriksaan yang gagal."

msgid "Automatic translation using already translated strings."
msgstr "Terjemahan otomatis menggunakan string yang sudah diterjemahkan."

msgid "New about page showing used versions."
msgstr "Halaman tentang baru yang menunjukkan versi yang digunakan."

msgid "Django 1.4 compatibility."
msgstr "Kompatibilitas Django 1.4."

msgid "Ability to push changes to remote repo from web interface."
msgstr ""
"Kemampuan untuk mendorong perubahan ke repo jarak jauh dari antarmuka web."

msgid "Added review of translations done by others."
msgstr "Menambahkan tinjauan atas terjemahan yang dilakukan oleh orang lain."

msgid "Weblate 0.7"
msgstr "Weblate 0.7"

msgid "*Released on February 16th 2012.*"
msgstr "*Dirilis pada 16 Februari 2012.*"

msgid "Direct support for GitHub notifications."
msgstr "Dukungan langsung untuk notifikasi GitHub."

msgid "Added support for cleaning up orphaned checks and translations."
msgstr ""
"Menambahkan dukungan untuk membersihkan pemeriksaan dan terjemahan yang "
"tidak terpakai."

msgid "Displays nearby strings while translating."
msgstr "Menampilkan string terdekat saat menerjemahkan."

msgid "Displays similar strings while translating."
msgstr "Menampilkan string yang serupa saat menerjemahkan."

msgid "Improved searching for string."
msgstr "Pencarian string ditingkatkan."

msgid "Weblate 0.6"
msgstr "Weblate 0.6"

msgid "*Released on February 14th 2012.*"
msgstr "*Dirilis pada 14 Februari 2012.*"

msgid "Added various checks for translated messages."
msgstr "Menambahkan berbagai pemeriksaan untuk pesan yang diterjemahkan."

msgid "Tunable access control."
msgstr "Kontrol akses yang dapat disesuaikan."

msgid "Improved handling of translations with new lines."
msgstr "Peningkatan penanganan terjemahan dengan baris baru."

msgid "Added client side sorting of tables."
msgstr "Menambahkan penyortiran tabel di sisi klien."

msgid "Please check upgrading instructions in case you are upgrading."
msgstr "Silakan periksa petunjuk peningkatan jika Anda meningkatkan."

msgid "Weblate 0.5"
msgstr "Weblate 0.5"

msgid "*Released on February 12th 2012.*"
msgstr "*Dirilis pada 12 Februari 2012.*"

msgid "Support for machine translation using following online services:"
msgstr "Dukungan untuk terjemahan mesin menggunakan layanan daring berikut:"

msgid "Several new translations."
msgstr "Beberapa terjemahan baru."

msgid "Improved merging of upstream changes."
msgstr "Meningkatkan penggabungan perubahan hulu."

msgid "Better handle concurrent git pull and translation."
msgstr "Menangani penarikan git dan terjemahan bersamaan dengan lebih baik."

msgid "Propagating works for fuzzy changes as well."
msgstr "Propagasi juga berfungsi untuk perubahan fuzzy."

msgid "Propagating works also for file upload."
msgstr "Propagasi juga berfungsi untuk mengunggah berkas."

msgid "Fixed file downloads while using FastCGI (and possibly others)."
msgstr ""
"Memperbaiki pengunduhan berkas saat menggunakan FastCGI (dan mungkin yang "
"lain)."

msgid "Weblate 0.4"
msgstr "Weblate 0.4"

msgid "*Released on February 8th 2012.*"
msgstr "*Dirilis pada 8 Februari 2012.*"

msgid "Added usage guide to documentation."
msgstr "Menambahkan panduan penggunaan ke dokumentasi."

msgid "Fixed API hooks not to require CSRF protection."
msgstr "Memperbaiki kait API yang tidak memerlukan perlindungan CSRF."

msgid "Weblate 0.3"
msgstr "Weblate 0.3"

msgid "Better display of source for plural translations."
msgstr "Tampilan sumber yang lebih baik untuk terjemahan jamak."

msgid "New documentation in Sphinx format."
msgstr "Dokumentasi baru dalam format Sphinx."

msgid "Displays secondary languages while translating."
msgstr "Menampilkan bahasa kedua saat menerjemahkan."

msgid "Improved error page to give list of existing projects."
msgstr "Memperbaiki halaman galat untuk memberikan daftar proyek yang ada."

msgid "New per language stats."
msgstr "Statistik per bahasa baru."

msgid "Weblate 0.2"
msgstr "Weblate 0.2"

msgid "*Released on February 7th 2012.*"
msgstr "*Dirilis pada 7 Februari 2012.*"

msgid "Improved validation of several forms."
msgstr "Meningkatkan validasi beberapa formulir."

msgid "Warn users on profile upgrade."
msgstr "Peringatkan pengguna saat peningkatan profil."

msgid "Remember URL for login."
msgstr "Ingat URL untuk masuk."

msgid "Naming of text areas while entering plural forms."
msgstr "Penamaan area teks saat memasukkan bentuk jamak."

msgid "Automatic expanding of translation area."
msgstr "Perluasan area terjemahan otomatis."

msgid "Weblate 0.1"
msgstr "Weblate 0.1"

msgid "*Released on February 6th 2012.*"
msgstr "*Dirilis pada 6 Februari 2012.*"

msgid "Initial release."
msgstr "Rilis awal."

msgid "Weblate 1.x series"
msgstr "Weblate seri 1.x"

msgid "Weblate 1.9"
msgstr "Weblate 1.9"

msgid "*Released on May 6th 2014.*"
msgstr "*Dirilis pada 6 Mei 2014.*"

msgid "Django 1.6 compatibility."
msgstr "Kompatibilitas Django 1.6."

msgid "No longer maintained compatibility with Django 1.4."
msgstr "Tidak lagi mengelola kompatibilitas dengan Django 1.4."

msgid "Management commands for locking/unlocking translations."
msgstr "Perintah pengelolaan untuk mengunci/membuka kunci terjemahan."

msgid "Improved support for Qt TS files."
msgstr "Meningkatkan dukungan untuk berkas Qt TS."

msgid "Users can now delete their account."
msgstr "Pengguna sekarang dapat menghapus akun mereka."

msgid "Avatars can be disabled."
msgstr "Avatar dapat dinonaktifkan."

msgid "Merged first and last name attributes."
msgstr "Atribut nama depan dan belakang digabungkan."

msgid "Avatars are now fetched and cached server side."
msgstr "Avatar sekarang diambil dan disimpan di sisi server."

msgid "Added support for shields.io badge."
msgstr "Menambahkan dukungan untuk lencana shields.io."

msgid "Weblate 1.8"
msgstr "Weblate 1.8"

msgid "*Released on November 7th 2013.*"
msgstr "*Dirilis pada 7 November 2013.*"

msgid "Please check manual for upgrade instructions."
msgstr "Silakan periksa manual untuk petunjuk peningkatan."

msgid "Nicer listing of project summary."
msgstr "Daftar ringkasan proyek yang lebih bagus."

msgid "Better visible options for sharing."
msgstr "Pilihan yang lebih terlihat untuk berbagi."

msgid "More control over anonymous users privileges."
msgstr "Kontrol lebih besar atas hak akses pengguna anonim."

msgid ""
"Supports login using third party services, check manual for more details."
msgstr ""
"Mendukung masuk menggunakan layanan pihak ketiga, periksa manual untuk "
"rincian lebih lanjut."

msgid "Users can login by e-mail instead of username."
msgstr "Pengguna dapat masuk menggunakan surel, bukan nama pengguna."

msgid "Improved source strings review."
msgstr "Meningkatkan tinjauan string sumber."

msgid "Searching across all strings."
msgstr "Mencari di seluruh string."

msgid "Better tracking of source strings."
msgstr "Pelacakan string sumber yang lebih baik."

msgid "Captcha protection for registration."
msgstr "Perlindungan captcha untuk pendaftaran."

msgid "Weblate 1.7"
msgstr "Weblate 1.7"

msgid "*Released on October 7th 2013.*"
msgstr "*Dirilis pada 7 Oktober 2013.*"

msgid "Support for checking Python brace format string."
msgstr "Dukungan untuk memeriksa string format Python bertanda kurung."

msgid "Per component customization of quality checks."
msgstr "Penyesuaian pemeriksaan kualitas per komponen."

msgid "Detailed per translation stats."
msgstr "Statistik terperinci per terjemahan."

msgid "Changed way of linking suggestions, checks and comments to strings."
msgstr ""
"Mengubah cara menghubungkan saran, pemeriksaan, dan komentar ke string."

msgid "Users can now add text to commit message."
msgstr "Pengguna sekarang dapat menambahkan teks untuk mengkomit pesan."

msgid "Support for subscribing on new language requests."
msgstr "Dukungan untuk berlangganan permintaan bahasa baru."

msgid "Support for adding new translations."
msgstr "Dukungan untuk menambahkan terjemahan baru."

msgid ""
"Widgets and charts are now rendered using Pillow instead of Pango + Cairo."
msgstr ""
"Widget dan grafik sekarang ditampilkan menggunakan Pillow, bukan Pango + "
"Cairo."

msgid "Add status badge widget."
msgstr "Tambahkan widget lencana status."

msgid "Dropped invalid text direction check."
msgstr "Membatalkan pemeriksaan arah teks yang tidak valid."

msgid "Changes in dictionary are now logged in history."
msgstr "Perubahan dalam kamus sekarang dicatat dalam riwayat."

msgid "Performance improvements for translation view."
msgstr "Peningkatan kinerja untuk tampilan terjemahan."

msgid "Weblate 1.6"
msgstr "Weblate 1.6"

msgid "*Released on July 25th 2013.*"
msgstr "*Dirilis pada 25 Juli 2013.*"

msgid "Nicer error handling on registration."
msgstr "Penanganan galat yang lebih baik dalam registrasi."

msgid "Browsing of changes."
msgstr "Penelusuran perubahan."

msgid "Fixed sorting of machine translation suggestions."
msgstr "Memperbaiki penyortiran saran terjemahan mesin."

msgid "Improved support for MyMemory machine translation."
msgstr "Meningkatkan dukungan untuk terjemahan mesin MyMemory."

msgid "Added support for Amagama machine translation."
msgstr "Menambahkan dukungan untuk terjemahan mesin Amagama."

msgid "Various optimizations on frequently used pages."
msgstr "Berbagai pengoptimalan pada halaman yang sering digunakan."

msgid "Highlights searched phrase in search results."
msgstr "Menyorot frasa yang dicari pada hasil pencarian."

msgid "Support for automatic fixups while saving the message."
msgstr "Dukungan untuk perbaikan otomatis saat menyimpan pesan."

msgid "Tracking of translation history and option to revert it."
msgstr "Pelacakan riwayat terjemahan dan opsi untuk mengembalikannya."

msgid "Added support for Google Translate API."
msgstr "Menambahkan dukungan untuk API Google Translate."

msgid "Added support for managing SSH host keys."
msgstr "Menambahkan dukungan untuk mengelola kunci hos SSH."

msgid "Various form validation improvements."
msgstr "Berbagai peningkatan validasi formulir."

msgid "Various quality checks improvements."
msgstr "Berbagai peningkatan pemeriksaan kualitas."

msgid "Performance improvements for import."
msgstr "Peningkatan kinerja untuk impor."

msgid "Added support for voting on suggestions."
msgstr "Menambahkan dukungan untuk pemungutan suara pada saran."

msgid "Cleanup of admin interface."
msgstr "Pembersihan antarmuka admin."

msgid "Weblate 1.5"
msgstr "Weblate 1.5"

msgid "*Released on April 16th 2013.*"
msgstr "*Dirilis pada 16 April 2013.*"

msgid "Added public user pages."
msgstr "Menambahkan halaman pengguna publik."

msgid "Better naming of plural forms."
msgstr "Penamaan bentuk jamak yang lebih baik."

msgid "Added support for TBX export of glossary."
msgstr "Menambahkan dukungan untuk ekspor glosarium TBX."

msgid "Added support for Bitbucket notifications."
msgstr "Menambahkan dukungan untuk notifikasi Bitbucket."

msgid ""
"Activity charts are now available for each translation, language or user."
msgstr ""
"Bagan aktivitas sekarang tersedia untuk setiap terjemahan, bahasa, atau "
"pengguna."

msgid "Extended options of import_project admin command."
msgstr "Opsi lanjutan dari perintah admin import_project."

msgid "Compatible with Django 1.5."
msgstr "Kompatibel dengan Django 1.5."

msgid "Avatars are now shown using libravatar."
msgstr "Avatar sekarang ditampilkan menggunakan libravatar."

msgid "Added possibility to pretty print JSON export."
msgstr "Menambahkan kemungkinan untuk mempercantik ekspor JSON."

msgid "Various performance improvements."
msgstr "Berbagai peningkatan kinerja."

msgid ""
"Indicate failing checks or fuzzy strings in progress bars for projects or "
"languages as well."
msgstr ""
"Menunjukkan pemeriksaan yang gagal atau string fuzzy pada bilah kemajuan "
"untuk proyek atau bahasa juga."

msgid ""
"Added support for custom pre-commit hooks and committing additional files."
msgstr ""
"Dukungan tambahan untuk kait pra-komit khusus dan mengkomit berkas tambahan."

msgid "Rewritten search for better performance and user experience."
msgstr ""
"Pencarian yang ditulis ulang untuk kinerja dan pengalaman pengguna yang "
"lebih baik."

msgid "New interface for machine translations."
msgstr "Antarmuka baru untuk terjemahan mesin."

msgid "Added support for monolingual po files."
msgstr "Menambahkan dukungan untuk berkas po ekabahasa."

msgid "Extend amount of cached metadata to improve speed of various searches."
msgstr ""
"Luaskan jumlah metadata yang disimpan untuk meningkatkan kecepatan berbagai "
"pencarian."

msgid "Now shows word counts as well."
msgstr "Sekarang menampilkan jumlah kata juga."

msgid "Weblate 1.4"
msgstr "Weblate 1.4"

msgid "*Released on January 23rd 2013.*"
msgstr "*Dirilis pada 23 Januari 2013.*"

msgid "Fixed deleting of checks/comments on string deletion."
msgstr "Memperbaiki penghapusan pemeriksaan/komentar pada penghapusan string."

msgid "Added option to disable automatic propagation of translations."
msgstr ""
"Menambahkan opsi untuk menonaktifkan propagasi terjemahan secara otomatis."

msgid "Added option to subscribe for merge failures."
msgstr "Menambahkan opsi untuk berlangganan jika penggabungan gagal."

msgid "Correctly import on projects which needs custom ttkit loader."
msgstr "Impor dengan benar pada proyek yang memerlukan pemuat ttkit kustom."

msgid "Added sitemaps to allow easier access by crawlers."
msgstr ""
"Menambahkan peta situs untuk memungkinkan akses yang lebih mudah oleh "
"perayap."

msgid "Provide direct links to string in notification e-mails or feeds."
msgstr "Sediakan tautan langsung ke string dalam surel atau umpan notifikasi."

msgid "Various improvements to admin interface."
msgstr "Berbagai peningkatan pada antarmuka admin."

msgid "Provide hints for production setup in admin interface."
msgstr "Berikan petunjuk untuk penyiapan produksi di antarmuka admin."

msgid "Added per language widgets and engage page."
msgstr "Ditambahkan per widget bahasa dan halaman keterlibatan."

msgid "Improved translation locking handling."
msgstr "Perbaikan penanganan penguncian terjemahan."

msgid "Show code snippets for widgets in more variants."
msgstr "Tampilkan cuplikan kode untuk widget dalam lebih banyak varian."

msgid "Indicate failing checks or fuzzy strings in progress bars."
msgstr ""
"Menunjukkan pemeriksaan yang gagal atau string fuzzy pada bilah kemajuan."

msgid "More options for formatting commit message."
msgstr "Opsi lainnya untuk memformat pesan komit."

msgid "Fixed error handling with machine translation services."
msgstr "Memperbaiki penanganan galat pada layanan terjemahan mesin."

msgid "Improved automatic translation locking behaviour."
msgstr "Meningkatkan perilaku penguncian terjemahan otomatis."

msgid "Support for showing changes from previous source string."
msgstr "Dukungan untuk menampilkan perubahan dari string sumber sebelumnya."

msgid "Added support for substring search."
msgstr "Menambahkan dukungan untuk pencarian substring."

msgid "Support for per project ACL."
msgstr "Dukungan untuk ACL per proyek."

msgid "Basic code coverage by unit tests."
msgstr "Cakupan kode dasar berdasarkan pengujian unit."

msgid "Weblate 1.3"
msgstr "Weblate 1.3"

msgid "*Released on November 16th 2012.*"
msgstr "*Dirilis pada 16 November 2012.*"

msgid "Compatibility with PostgreSQL database backend."
msgstr "Kompatibilitas dengan backend basis data PostgreSQL."

msgid "Removes languages removed in upstream git repository."
msgstr "Menghapus bahasa yang dihapus di repositori git hulu."

msgid "Improved quality checks processing."
msgstr "Meningkatkan pemrosesan pemeriksaan kualitas."

msgid "Added new checks (BBCode, XML markup and newlines)."
msgstr "Menambahkan pemeriksaan baru (BBCode, markah XML, dan baris baru)."

msgid "Support for optional rebasing instead of merge."
msgstr "Dukungan untuk membasis ulang opsional sebagai ganti penggabungan."

msgid ""
"Possibility to relocate Weblate (for example to run it under /weblate path)."
msgstr ""
"Kemungkinan untuk merelokasi Weblate (misalnya menjalankannya di jalur /"
"weblate)."

msgid "Support for manually choosing file type in case autodetection fails."
msgstr ""
"Dukungan untuk memilih jenis berkas secara manual jika deteksi otomatis "
"gagal."

msgid "Better support for Android resources."
msgstr "Dukungan yang lebih baik untuk sumber daya Android."

msgid "Support for generating SSH key from web interface."
msgstr "Dukungan untuk menghasilkan kunci SSH dari antarmuka web."

msgid "More visible data exports."
msgstr "Ekspor data yang lebih terlihat."

msgid "New buttons to enter some special characters."
msgstr "Tombol baru untuk memasukkan beberapa karakter spesial."

msgid "Support for exporting dictionary."
msgstr "Dukungan untuk mengekspor kamus."

msgid "Support for locking down whole Weblate installation."
msgstr "Dukungan untuk mengunci seluruh pemasangan Weblate."

msgid "Checks for source strings and support for source strings review."
msgstr "Memeriksa string sumber dan dukungan untuk peninjauan string sumber."

msgid "Support for user comments for both translations and source strings."
msgstr "Dukungan untuk komentar pengguna untuk terjemahan dan string sumber."

msgid "Better changes log tracking."
msgstr "Pelacakan catatan perubahan yang lebih baik."

msgid "Changes can now be monitored using RSS."
msgstr "Perubahan sekarang dapat dipantau menggunakan RSS."

msgid "Improved support for RTL languages."
msgstr "Peningkatan dukungan untuk bahasa RTL."

msgid "Weblate 1.2"
msgstr "Weblate 1.2"

msgid "*Released on August 14th 2012.*"
msgstr "*Dirilis pada 14 Agustus 2012.*"

msgid ""
"Weblate now uses South for database migration, please check upgrade "
"instructions if you are upgrading."
msgstr ""
"Weblate sekarang menggunakan South untuk migrasi basis data, silakan periksa "
"petunjuk peningkatan jika Anda meningkatkan."

msgid "Fixed minor issues with linked git repos."
msgstr "Memperbaiki isu kecil dengan repo git yang tertaut."

msgid ""
"New introduction page for engaging people with translating using Weblate."
msgstr ""
"Halaman pengenalan baru untuk melibatkan orang dalam terjemahan menggunakan "
"Weblate."

msgid "Added widgets which can be used for promoting translation projects."
msgstr ""
"Menambahkan widget yang dapat digunakan untuk mempromosikan proyek "
"terjemahan."

msgid "Added option to reset repository to origin (for privileged users)."
msgstr ""
"Menambahkan opsi untuk mengatur ulang repositori ke asal (untuk pengguna "
"berhak akses)."

msgid "Project or component can now be locked for translations."
msgstr "Proyek atau komponen sekarang dapat dikunci untuk terjemahan."

msgid "Possibility to disable some translations."
msgstr "Kemungkinan untuk menonaktifkan beberapa terjemahan."

msgid "Configurable options for adding new translations."
msgstr "Opsi yang dapat dikonfigurasikan untuk menambahkan terjemahan baru."

msgid "Configuration of git commits per project."
msgstr "Konfigurasi komit git per proyek."

msgid "Simple antispam protection."
msgstr "Perlindungan antispam sederhana."

msgid "Better layout of main page."
msgstr "Tata letak halaman utama yang lebih baik."

msgid "Support for automatically pushing changes on every commit."
msgstr "Dukungan untuk mendorong perubahan secara otomatis pada setiap komit."

msgid "Support for e-mail notifications of translators."
msgstr "Dukungan untuk notifikasi surel penerjemah."

msgid "List only used languages in preferences."
msgstr "Cantumkan hanya bahasa yang digunakan dalam preferensi."

msgid "Improved handling of not known languages when importing project."
msgstr ""
"Meningkatkan penanganan bahasa yang tidak diketahui saat mengimpor proyek."

msgid "Support for locking translation by translator."
msgstr "Dukungan untuk penguncian terjemahan berdasarkan penerjemah."

msgid "Optionally maintain ``Language-Team`` header in po file."
msgstr "Secara opsional mengelola kepala ``Language-Team`` dalam berkas po."

msgid "Include some statistics in about page."
msgstr "Sertakan beberapa statistik di halaman tentang."

msgid "Supports (and requires) django-registration 0.8."
msgstr "Mendukung (dan memerlukan) django-registration 0.8."

msgid "Caching counts of strings with failing checks."
msgstr "Menyimpan jumlah string dengan pemeriksaan yang gagal."

msgid "Checking of requirements during setup."
msgstr "Pemeriksaan persyaratan selama penyiapan."

msgid "Weblate 1.1"
msgstr "Weblate 1.1"

msgid "*Released on July 4th 2012.*"
msgstr "*Dirilis pada 4 Juli 2012.*"

msgid "Improved several translations."
msgstr "Meningkatkan beberapa terjemahan."

msgid "Added support for shared git repositories across components."
msgstr "Menambahkan dukungan untuk repositori git bersama di seluruh komponen."

msgid "Do not necessary commit on every attempt to pull remote repo."
msgstr ""
"Tidak perlu mengkomit pada setiap percobaan untuk menarik repo jarak jauh."

msgid "Added support for offloading indexing."
msgstr "Menambahkan dukungan untuk pengindeksan pembongkaran."

msgid "Weblate 1.0"
msgstr "Weblate 1.0"

msgid "*Released on May 10th 2012.*"
msgstr "*Dirilis pada 10 Mei 2012.*"

msgid "Improved validation while adding/saving component."
msgstr "Peningkatan validasi saat menambahkan/menyimpan komponen."

msgid "Experimental support for Android component files (needs patched ttkit)."
msgstr ""
"Dukungan eksperimental untuk berkas komponen Android (perlu ttkit yang di-"
"patch)."

msgid "Updates from hooks are run in background."
msgstr "Pembaruan dari kait dijalankan di latar belakang."

msgid "Improved installation instructions."
msgstr "Meningkatkan petunjuk pemasangan."

msgid "Improved navigation in dictionary."
msgstr "Meningkatkan navigasi dalam kamus."

msgid "Weblate 2.x series"
msgstr "Seri Weblate 2.x"

msgid "Weblate 2.20"
msgstr "Weblate 2.20"

msgid "*Released on April 4th 2018.*"
msgstr "*Dirilis pada tanggal 4 April 2018.*"

msgid "Improved speed of cloning subversion repositories."
msgstr "Meningkatkan kecepatan saat mengkloning repositori Subversion."

msgid "Changed repository locking to use third party library."
msgstr "Mengubah penguncian repositori untuk menggunakan pustaka pihak ketiga."

msgid "Added support for downloading only strings needing action."
msgstr ""
"Menambahkan dukungan untuk mengunduh hanya string yang memerlukan tindakan."

msgid "Added support for searching in several languages at once."
msgstr "Menambahkan dukungan untuk pencarian dalam beberapa bahasa sekaligus."

msgid "New add-on to configure gettext output wrapping."
msgstr "Pengaya baru untuk mengkonfigurasikan pemecahan keluaran gettext."

msgid "New add-on to configure JSON formatting."
msgstr "Pengaya baru untuk mengkonfigurasikan pemformatan JSON."

msgid ""
"Added support for authentication in API using RFC 6750 compatible Bearer "
"authentication."
msgstr ""
"Menambahkan dukungan untuk autentikasi dalam API menggunakan autentikasi "
"Bearer yang kompatibel dengan RFC 6750."

msgid ""
"Added support for automatic translation using machine translation services."
msgstr ""
"Menambahkan dukungan untuk terjemahan otomatis menggunakan layanan "
"terjemahan mesin."

msgid "Added support for HTML markup in whiteboard messages."
msgstr "Menambahkan dukungan untuk markah HTML dalam pesan papan tulis."

msgid "Added support for mass changing state of strings."
msgstr "Menambahkan dukungan untuk perubahan status string secara massal."

msgid ""
"Translate-toolkit at least 2.3.0 is now required, older versions are no "
"longer supported."
msgstr ""
"Translate-toolkit minimal versi 2.3.0 sekarang diperlukan, versi lama tidak "
"lagi didukung."

msgid "Added built-in translation memory."
msgstr "Menambahkan memori terjemahan bawaan."

msgid ""
"Added componentlists overview to dashboard and per component list overview "
"pages."
msgstr ""
"Menambahkan ikhtisar daftar komponen ke dasbor dan halaman ikhtisar per "
"daftar komponen."

msgid "Added support for DeepL machine translation service."
msgstr "Menambahkan dukungan untuk layanan terjemahan mesin DeepL."

msgid "Machine translation results are now cached inside Weblate."
msgstr "Hasil terjemahan mesin sekarang disimpan di dalam Weblate."

msgid "Added support for reordering committed changes."
msgstr "Menambahkan dukungan untuk mengurutkan ulang perubahan yang dikomit."

msgid "Weblate 2.19.1"
msgstr "Weblate 2.19.1"

msgid "*Released on February 20th 2018.*"
msgstr "*Dirilis pada 20 Februari 2018.*"

msgid "Fixed migration issue on upgrade from 2.18."
msgstr "Memperbaiki isu migrasi pada peningkatan dari 2.18."

msgid "Improved file upload API validation."
msgstr "Meningkatkan validasi API unggahan berkas."

msgid "Weblate 2.19"
msgstr "Weblate 2.19"

msgid "*Released on February 15th 2018.*"
msgstr "*Dirilis pada 15 Februari 2018.*"

msgid "Fixed imports across some file formats."
msgstr "Memperbaiki impor di beberapa format berkas."

msgid "Display human friendly browser information in audit log."
msgstr ""
"Menampilkan informasi peramban yang mudah dipahami manusia dalam catatan "
"audit."

msgid "Added TMX exporter for files."
msgstr "Menambahkan eksportir TMX untuk berkas."

msgid "Various performance improvements for loading translation files."
msgstr "Berbagai peningkatan kinerja untuk memuat berkas terjemahan."

msgid ""
"Added option to disable access management in Weblate in favor of Django one."
msgstr ""
"Menambahkan opsi untuk menonaktifkan pengelolaan akses di Weblate dan "
"menggantinya dengan Django."

msgid "Improved glossary lookup speed for large strings."
msgstr "Meningkatkan kecepatan pencarian glosarium untuk string besar."

msgid "Compatibility with django_auth_ldap 1.3.0."
msgstr "Kompatibilitas dengan django_auth_ldap 1.3.0."

msgid "Configuration errors are now stored and reported persistently."
msgstr "Galat konfigurasi sekarang disimpan dan dilaporkan secara persisten."

msgid "Honor ignore flags in whitespace autofixer."
msgstr "Hormati penanda abaikan pada perbaikan otomatis spasi."

msgid "Improved compatibility with some Subversion setups."
msgstr "Meningkatkan kompatibilitas dengan beberapa pengaturan Subversion."

msgid "Improved built-in machine translation service."
msgstr "Meningkatkan layanan terjemahan mesin bawaan."

msgid "Added support for SAP Translation Hub service."
msgstr "Menambahkan dukungan untuk layanan SAP Translation Hub."

msgid "Added support for Microsoft Terminology service."
msgstr "Menambahkan dukungan untuk layanan Microsoft Terminology."

msgid "Removed support for advertisement in notification e-mails."
msgstr "Menghapus dukungan untuk iklan dalam surel notifikasi."

msgid "Improved translation progress reporting at language level."
msgstr "Meningkatkan pelaporan progres terjemahan pada tingkat bahasa."

msgid "Improved support for different plural formulas."
msgstr "Meningkatkan dukungan untuk rumus jamak yang berbeda."

msgid "Added support for Subversion repositories not using stdlayout."
msgstr ""
"Menambahkan dukungan untuk repositori Subversion yang tidak menggunakan "
"stdlayout."

msgid "Added add-ons to customize translation workflows."
msgstr "Menambahkan pengaya untuk menyesuaikan alur kerja terjemahan."

msgid "Weblate 2.18"
msgstr "Weblate 2.18"

msgid "*Released on December 15th 2017.*"
msgstr "*Dirilis pada 15 Desember 2017.*"

msgid "Extended contributor stats."
msgstr "Statistik kontributor yang diluaskan."

msgid "Improved configuration of special characters virtual keyboard."
msgstr "Meningkatkan konfigurasi papan ketik virtual karakter spesial."

msgid "Added support for DTD file format."
msgstr "Menambahkan dukungan untuk format berkas DTD."

msgid ""
"Changed keyboard shortcuts to less likely collide with browser/system ones."
msgstr ""
"Mengubah pintasan papan ketik agar kecil kemungkinannya bertabrakan dengan "
"pintasan peramban/sistem."

msgid "Improved support for approved flag in XLIFF files."
msgstr "Meningkatkan dukungan untuk penanda yang disetujui dalam berkas XLIFF."

msgid "Added support for not wrapping long strings in gettext PO files."
msgstr ""
"Menambahkan dukungan untuk tidak memecah string panjang dalam berkas PO "
"gettext."

msgid "Added button to copy permalink for current translation."
msgstr ""
"Menambahkan tombol untuk menyalin tautan permanen untuk terjemahan saat ini."

msgid "Dropped support for Django 1.10 and added support for Django 2.0."
msgstr ""
"Menghapus dukungan untuk Django 1.10 dan menambahkan dukungan untuk Django "
"2.0."

msgid "Removed locking of translations while translating."
msgstr "Menghapus penguncian terjemahan saat menerjemahkan."

msgid "Added support for adding new strings to monolingual translations."
msgstr ""
"Menambahkan dukungan untuk menambahkan string baru ke terjemahan ekabahasa."

msgid "Added support for translation workflows with dedicated reviewers."
msgstr ""
"Menambahkan dukungan untuk alur kerja terjemahan dengan peninjau khusus."

msgid "Weblate 2.17.1"
msgstr "Weblate 2.17.1"

msgid "*Released on October 13th 2017.*"
msgstr "*Dirilis pada 13 Oktober 2017.*"

msgid "Fixed running testsuite in some specific situations."
msgstr ""
"Memperbaiki rangkaian pengujian yang berjalan dalam beberapa situasi "
"tertentu."

msgid "Locales updates."
msgstr "Pembaruan lokalisasi."

msgid "Weblate 2.17"
msgstr "Weblate 2.17"

msgid "Weblate by default does shallow Git clones now."
msgstr "Weblate secara bawaan sekarang mengkloning Git yang dangkal."

msgid "Improved performance when updating large translation files."
msgstr "Meningkatkan kinerja saat memperbarui berkas terjemahan besar."

msgid "Added support for blocking certain e-mails from registration."
msgstr "Menambahkan dukungan untuk memblokir surel tertentu dari pendaftaran."

msgid "Users can now delete their own comments."
msgstr "Pengguna sekarang dapat menghapus komentar mereka sendiri."

msgid "Added preview step to search and replace feature."
msgstr "Menambahkan langkah pratinjau untuk mencari dan mengganti fitur."

msgid "Client side persistence of settings in search and upload forms."
msgstr ""
"Persistensi pengaturan sisi klien pada formulir pencarian dan pengunggahan."

msgid "Extended search capabilities."
msgstr "Kemampuan pencarian yang diluaskan."

msgid "More fine grained per project ACL configuration."
msgstr "Konfigurasi ACL per proyek yang lebih rinci."

msgid "Default value of BASE_DIR has been changed."
msgstr "Nilai bawaan BASE_DIR telah diubah."

msgid "Added two step account removal to prevent accidental removal."
msgstr ""
"Menambahkan penghapusan akun dua langkah untuk mencegah penghapusan yang "
"tidak disengaja."

msgid "Project access control settings is now editable."
msgstr "Pengaturan kontrol akses proyek sekarang dapat disunting."

msgid "Added optional spam protection for suggestions using Akismet."
msgstr ""
"Menambahkan perlindungan spam opsional untuk saran menggunakan Akismet."

msgid "Weblate 2.16"
msgstr "Weblate 2.16"

msgid "*Released on August 11th 2017.*"
msgstr "*Dirilis pada 11 Agustus 2017.*"

msgid "Added support for nested JSON format."
msgstr "Menambahkan dukungan untuk format JSON bersarang."

msgid "Added support for WebExtension JSON format."
msgstr "Menambahkan dukungan untuk format WebExtension JSON."

msgid "Fixed git exporter authentication."
msgstr "Memperbaiki autentikasi pengekspor git."

msgid "Improved CSV import in certain situations."
msgstr "Meningkatkan impor CSV dalam situasi tertentu."

msgid "Improved look of Other translations widget."
msgstr "Meningkatkan tampilan widget Terjemahan lainnya."

msgid "The max-length checks is now enforcing length of text in form."
msgstr ""
"Pemeriksaan panjang maks sekarang memberlakukan panjang teks dalam formulir."

msgid "Make the commit_pending age configurable per component."
msgstr "Jadikan usia commit_pending dapat dikonfigurasikan per komponen."

msgid "Various user interface cleanups."
msgstr "Berbagai pembersihan antarmuka pengguna."

msgid "Fixed component/project/site wide search for translations."
msgstr "Memperbaiki pencarian terjemahan di seluruh komponen/proyek/situs."

msgid "Weblate 2.15"
msgstr "Weblate 2.15"

msgid "*Released on June 30th 2017.*"
msgstr "*Dirilis pada 30 Juni 2017.*"

msgid "Show more related translations in other translations."
msgstr "Tampilkan lebih banyak terjemahan terkait dalam terjemahan lain."

msgid "Add option to see translations of current string to other languages."
msgstr ""
"Tambahkan opsi untuk melihat terjemahan string saat ini ke bahasa lain."

msgid "Use 4 plural forms for Lithuanian by default."
msgstr "Gunakan 4 bentuk jamak untuk Lituania secara bawaan."

msgid "Fixed upload for monolingual files of different format."
msgstr "Memperbaiki unggahan untuk berkas ekabahasa dengan format berbeda."

msgid "Improved error messages on failed authentication."
msgstr "Memperbaiki pesan galat pada autentikasi yang gagal."

msgid "Keep page state when removing word from glossary."
msgstr "Pertahankan status halaman saat menghapus kata dari glosarium."

msgid "Added direct link to edit secondary language translation."
msgstr "Menambahkan tautan langsung untuk menyunting terjemahan bahasa kedua."

msgid "Added Perl format quality check."
msgstr "Menambahkan pemeriksaan kualitas format Perl."

msgid "Added support for rejecting reused passwords."
msgstr "Menambahkan dukungan untuk menolak kata sandi yang digunakan kembali."

msgid "Extended toolbar for editing RTL languages."
msgstr "Bilah alat yang diluaskan untuk menyunting bahasa RTL."

msgid "Weblate 2.14.1"
msgstr "Weblate 2.14.1"

msgid "*Released on May 24th 2017.*"
msgstr "*Dirilis pada 24 Mei 2017.*"

msgid "Fixed possible error when paginating search results."
msgstr ""
"Memperbaiki kemungkinan galat saat membagi hasil pencarian menjadi beberapa "
"halaman."

msgid "Fixed migrations from older versions in some corner cases."
msgstr "Memperbaiki migrasi dari versi lama pada beberapa kasus khusus."

msgid "Fixed possible CSRF on project watch and unwatch."
msgstr ""
"Memperbaiki kemungkinan CSRF pada pemantauan dan penghentian pemantauan "
"proyek."

msgid "The password reset no longer authenticates user."
msgstr "Pengaturan ulang kata sandi tidak lagi mengautentikasikan pengguna."

msgid "Fixed possible CAPTCHA bypass on forgotten password."
msgstr "Memperbaiki kemungkinan melewati CAPTCHA jika kata sandi terlupa."

msgid "Weblate 2.14"
msgstr "Weblate 2.14"

msgid "*Released on May 17th 2017.*"
msgstr "*Dirilis pada 17 Mei 2017.*"

msgid "Add glossary entries using AJAX."
msgstr "Tambahkan entri glosarium menggunakan AJAX."

msgid "The logout now uses POST to avoid CSRF."
msgstr "Keluar sekarang menggunakan POST untuk menghindari CSRF."

msgid "The API key token reset now uses POST to avoid CSRF."
msgstr ""
"Pengaturan ulang token kunci API sekarang menggunakan POST untuk menghindari "
"CSRF."

msgid "Weblate sets Content-Security-Policy by default."
msgstr "Weblate mengatur Kebijakan Keamanan Konten secara bawaan."

msgid "The local editor URL is validated to avoid self-XSS."
msgstr "URL penyunting lokal divalidasi untuk menghindari XSS sendiri."

msgid "The password is now validated against common flaws by default."
msgstr "Kata sandi sekarang divalidasi terhadap kelemahan umum secara bawaan."

msgid ""
"Notify users about important activity with their account such as password "
"change."
msgstr ""
"Beritahukan pengguna tentang aktivitas penting dengan akun mereka seperti "
"perubahan kata sandi."

msgid "The CSV exports now escape potential formulas."
msgstr "Ekspor CSV sekarang lolos dari rumus potensial."

msgid "Various minor improvements in security."
msgstr "Berbagai perbaikan kecil dalam keamanan."

msgid "The authentication attempts are now rate limited."
msgstr "Percobaan autentikasi sekarang dibatasi."

msgid "Suggestion content is stored in the history."
msgstr "Konten saran disimpan dalam riwayat."

msgid "Store important account activity in audit log."
msgstr "Simpan aktivitas akun penting dalam catatan audit."

msgid ""
"Ask for password confirmation when removing account or adding new "
"associations."
msgstr ""
"Tanyakan konfirmasi kata sandi saat menghapus akun atau menambahkan asosiasi "
"baru."

msgid "Show time when suggestion has been made."
msgstr "Tampilkan waktu saat saran telah dibuat."

msgid "There is new quality check for trailing semicolon."
msgstr "Ada pemeriksaan kualitas baru untuk titik koma di akhir."

msgid "Ensure that search links can be shared."
msgstr "Pastikan tautan pencarian dapat dibagikan."

msgid "Included source string information and screenshots in the API."
msgstr "Menyertakan informasi string sumber dan tangkapan layar dalam API."

msgid "Allow to overwrite translations through API upload."
msgstr "Izinkan untuk menimpa terjemahan melalui unggahan API."

msgid "Weblate 2.13.1"
msgstr "Weblate 2.13.1"

msgid "*Released on Apr 12th 2017.*"
msgstr "*Dirilis pada 12 April 2017.*"

msgid "Fixed listing of managed projects in profile."
msgstr "Memperbaiki daftar proyek yang dikelola di profil."

msgid "Fixed migration issue where some permissions were missing."
msgstr "Memperbaiki masalah migrasi di mana beberapa izin hilang."

msgid "Fixed listing of current file format in translation download."
msgstr "Memperbaiki daftar format berkas saat ini dalam unduhan terjemahan."

msgid ""
"Return HTTP 404 when trying to access project where user lacks privileges."
msgstr ""
"Mengembalikan HTTP 404 saat mencoba mengakses proyek yang penggunanya tidak "
"memiliki hak akses."

msgid "Weblate 2.13"
msgstr "Weblate 2.13"

msgid "Fixed quality checks on translation templates."
msgstr "Memperbaiki pemeriksaan kualitas pada templat terjemahan."

msgid "Added quality check to trigger on losing translation."
msgstr "Menambahkan pemeriksaan kualitas untuk memicu hilangnya terjemahan."

msgid "Add option to view pending suggestions from user."
msgstr "Tambahkan opsi untuk melihat saran yang tertunda dari pengguna."

msgid "Add option to automatically build component lists."
msgstr "Tambahkan opsi untuk membuat daftar komponen secara otomatis."

msgid "Default dashboard for unauthenticated users can be configured."
msgstr ""
"Dasbor bawaan untuk pengguna yang tidak diautentikasikan dapat "
"dikonfigurasikan."

msgid "Add option to browse 25 random strings for review."
msgstr "Tambahkan opsi untuk menelusuri 25 string acak untuk ditinjau."

msgid "History now indicates string change."
msgstr "Riwayat sekarang menunjukkan perubahan string."

msgid "Better error reporting when adding new translation."
msgstr "Pelaporan galat yang lebih baik saat menambahkan terjemahan baru."

msgid "Added per language search within project."
msgstr "Ditambahkan per pencarian bahasa dalam proyek."

msgid "Group ACLs can now be limited to certain permissions."
msgstr "ACL grup sekarang dapat dibatasi pada izin tertentu."

msgid "The per project ACLs are now implemented using Group ACL."
msgstr "ACL per proyek sekarang diimplementasikan menggunakan ACL Grup."

msgid "Added more fine grained privileges control."
msgstr "Menambahkan kontrol hak akses yang lebih rinci."

msgid "Various minor UI improvements."
msgstr "Berbagai perbaikan UI kecil."

msgid "Weblate 2.12"
msgstr "Weblate 2.12"

msgid "*Released on Mar 3rd 2017.*"
msgstr "*Dirilis pada 3 Maret 2017.*"

msgid "Improved admin interface for groups."
msgstr "Meningkatkan antarmuka admin untuk grup."

msgid "Added support for Yandex Translate API."
msgstr "Menambahkan dukungan untuk API Yandex Translate."

msgid "Improved speed of site wide search."
msgstr "Meningkatkan kecepatan pencarian di seluruh situs."

msgid "Added project and component wide search."
msgstr "Menambahkan pencarian di seluruh proyek dan komponen."

msgid "Added project and component wide search and replace."
msgstr "Menambahkan pencarian dan penggantian di seluruh proyek dan komponen."

msgid "Improved rendering of inconsistent translations."
msgstr "Meningkatkan rendering terjemahan yang tidak konsisten."

msgid "Added support for opening source files in local editor."
msgstr ""
"Menambahkan dukungan untuk membuka berkas sumber di penyuntingan lokal."

msgid "Added support for configuring visual keyboard with special characters."
msgstr ""
"Menambahkan dukungan untuk mengkonfigurasikan papan ketik visual dengan "
"karakter khusus."

msgid ""
"Improved screenshot management with OCR support for matching source strings."
msgstr ""
"Peningkatan pengelolaan tangkapan layar dengan dukungan OCR untuk "
"mencocokkan string sumber."

msgid "Default commit message now includes translation information and URL."
msgstr "Pesan komit bawaan sekarang menyertakan informasi terjemahan dan URL."

msgid "Added support for Joomla translation format."
msgstr "Menambahkan dukungan untuk format terjemahan Joomla."

msgid "Improved reliability of import across file formats."
msgstr "Meningkatkan keandalan impor lintas format berkas."

msgid "Weblate 2.11"
msgstr "Weblate 2.11"

msgid "*Released on Jan 31st 2017.*"
msgstr "*Dirilis pada 31 Januari 2017.*"

msgid "Include language detailed information on language page."
msgstr "Sertakan informasi bahasa secara rinci pada halaman bahasa."

msgid "Mercurial backend improvements."
msgstr "Peningkatan backend Mercurial."

msgid "Added option to specify translation component priority."
msgstr ""
"Menambahkan opsi untuk menspesifikasikan prioritas komponen terjemahan."

msgid "More consistent usage of Group ACL even with less used permissions."
msgstr ""
"Penggunaan ACL Grup yang lebih konsisten bahkan dengan izin yang lebih "
"jarang digunakan."

msgid "Added WL_BRANCH variable to hook scripts."
msgstr "Menambahkan variabel WL_BRANCH untuk mengaitkan skrip."

msgid "Improved developer documentation."
msgstr "Meningkatkan dokumentasi pengembang."

msgid "Better compatibility with various Git versions in Git exporter add-on."
msgstr ""
"Kompatibilitas yang lebih baik dengan berbagai versi Git di pengaya "
"eksportir Git."

msgid "Included per project and component stats."
msgstr "Menyertakan per statistik proyek dan komponen."

msgid ""
"Added language code mapping for better support of Microsoft Translate API."
msgstr ""
"Menambahkan pemetaan kode bahasa untuk dukungan API Microsoft Translate yang "
"lebih baik."

msgid ""
"Moved fulltext cleanup to background job to make translation removal faster."
msgstr ""
"Memindahkan pembersihan teks lengkap ke pekerjaan latar belakang untuk "
"mempercepat penghapusan terjemahan."

msgid ""
"Fixed displaying of plural source for languages with single plural form."
msgstr ""
"Memperbaiki tampilan sumber jamak untuk bahasa dengan bentuk jamak tunggal."

msgid "Improved error handling in import_project."
msgstr "Peningkatan penanganan galat di import_project."

msgid "Weblate 2.10.1"
msgstr "Weblate 2.10.1"

msgid "*Released on Jan 20th 2017.*"
msgstr "*Dirilis pada 20 Januari 2017.*"

msgid ""
"Do not leak account existence on password reset form (:cve:`2017-5537`)."
msgstr ""
"Jangan bocorkan keberadaan akun pada formulir pengaturan ulang kata sandi "
"(:cve:`2017-5537`)."

msgid "Weblate 2.10"
msgstr "Weblate 2.10"

msgid "*Released on Dec 15th 2016.*"
msgstr "*Dirilis pada 15 Desember 2016.*"

msgid ""
"Added quality check to check whether plurals are translated differently."
msgstr ""
"Menambahkan pemeriksaan kualitas untuk memeriksa apakah bentuk jamak "
"diterjemahkan secara berbeda."

msgid "Fixed GitHub hooks for repositories with authentication."
msgstr "Memperbaiki kaitan GitHub untuk repositori dengan autentikasi."

msgid "Added optional Git exporter module."
msgstr "Menambahkan modul pengekspor Git opsional."

msgid "Support for Microsoft Cognitive Services Translator API."
msgstr "Dukungan untuk API Microsoft Cognitive Services Translator."

msgid "Simplified project and component user interface."
msgstr "Antarmuka pengguna proyek dan komponen yang disederhanakan."

msgid "Added automatic fix to remove control characters."
msgstr "Menambahkan perbaikan otomatis untuk menghapus karakter kontrol."

msgid "Added per language overview to project."
msgstr "Menambahkan per ikhtisar bahasa ke proyek."

msgid "Added support for CSV export."
msgstr "Menambahkan dukungan untuk ekspor CSV."

msgid "Added CSV download for stats."
msgstr "Menambahkan unduhan CSV untuk statistik."

msgid "Added matrix view for quick overview of all translations."
msgstr "Menambahkan tampilan matriks untuk ikhtisar cepat semua terjemahan."

msgid "Added basic API for changes and strings."
msgstr "Menambahkan API dasar untuk perubahan dan string."

msgid "Added support for Apertium APy server for machine translations."
msgstr "Menambahkan dukungan untuk server Apertium APy untuk terjemahan mesin."

msgid "Weblate 2.9"
msgstr "Weblate 2.9"

msgid "*Released on Nov 4th 2016.*"
msgstr "*Dirilis pada 4 November 2016.*"

msgid "Extended parameters for createadmin management command."
msgstr "Parameter yang diluaskan untuk perintah pengelolaan createadmin."

msgid "Extended import_json to be able to handle with existing components."
msgstr "import_json diluaskan agar dapat ditangani dengan komponen yang ada."

msgid "Added support for YAML files."
msgstr "Menambahkan dukungan untuk berkas YAML."

msgid ""
"Project owners can now configure translation component and project details."
msgstr ""
"Pemilik proyek sekarang dapat mengkonfigurasikan komponen terjemahan dan "
"rincian proyek."

msgid "Use \"Watched\" instead of \"Subscribed\" projects."
msgstr "Gunakan proyek \"Dipantau\", bukan \"Berlanggan\"."

msgid "Projects can be watched directly from project page."
msgstr "Proyek dapat dipantau langsung dari halaman proyek."

msgid "Added multi language status widget."
msgstr "Menambahkan widget status multi bahasa."

msgid "Highlight secondary language if not showing source."
msgstr "Sorot bahasa kedua jika tidak menampilkan sumber."

msgid "Record suggestion deletion in history."
msgstr "Rekam penghapusan saran dalam riwayat."

msgid "Improved UX of languages selection in profile."
msgstr "Meningkatkan UX pemilihan bahasa di profil."

msgid "Fixed showing whiteboard messages for component."
msgstr "Memperbaiki tampilan pesan papan tulis untuk komponen."

msgid "Keep preferences tab selected after saving."
msgstr "Pertahankan tab preferensi dipilih setelah menyimpan."

msgid "Show source string comment more prominently."
msgstr "Tampilkan komentar string sumber secara lebih menonjol."

msgid "Automatically install Gettext PO merge driver for Git repositories."
msgstr ""
"Pasang driver gabungan Gettext PO secara otomatis untuk repositori Git."

msgid "Added search and replace feature."
msgstr "Menambahkan fitur pencarian dan penggantian."

msgid ""
"Added support for uploading visual context (screenshots) for translations."
msgstr ""
"Menambahkan dukungan untuk mengunggah konteks visual (tangkapan layar) untuk "
"terjemahan."

msgid "Weblate 2.8"
msgstr "Weblate 2.8"

msgid "*Released on Aug 31st 2016.*"
msgstr "*Dirilis pada 31 Agustus 2016.*"

msgid "Translations."
msgstr "Terjemahan."

msgid "Updated bundled JavaScript libraries."
msgstr "Memperbarui pustaka JavaScript yang dibundel."

msgid "Added list_translators management command."
msgstr "Menambahkan perintah pengelolaan list_translators."

msgid "Django 1.8 is no longer supported."
msgstr "Django 1.8 tidak lagi didukung."

msgid "Fixed compatibility with Django 1.10."
msgstr "Memperbaiki kompatibilitas dengan Django 1.10."

msgid "Added Subversion support."
msgstr "Menambahkan dukungan Subversion."

msgid "Separated XML validity check from XML mismatched tags."
msgstr ""
"Pemeriksaan validitas XML yang dipisahkan dari tag XML yang tidak cocok."

msgid "Fixed API to honor HIDE_REPO_CREDENTIALS settings."
msgstr "Memperbaiki API untuk menghormati pengaturan HIDE_REPO_CREDENTIALS."

msgid "Show source change in Zen mode."
msgstr "Tampilkan perubahan sumber dalam mode Zen."

msgid "Alt+PageUp/PageDown/Home/End now works in Zen mode as well."
msgstr "Alt+PageUp/PageDown/Home/End sekarang juga berfungsi dalam mode Zen."

msgid "Add tooltip showing exact time of changes."
msgstr "Tambahkan tooltip yang menunjukkan waktu perubahan yang tepat."

msgid "Add option to select filters and search from translation page."
msgstr ""
"Tambahkan opsi untuk memilih filter dan pencarian dari halaman terjemahan."

msgid "Added UI for translation removal."
msgstr "Menambahkan UI untuk penghapusan terjemahan."

msgid "Improved behavior when inserting placeables."
msgstr "Meningkatkan perilaku saat memasukkan penempatan."

msgid "Fixed auto locking issues in Zen mode."
msgstr "Memperbaiki isu penguncian otomatis dalam mode Zen."

msgid "Weblate 2.7"
msgstr "Weblate 2.7"

msgid "*Released on Jul 10th 2016.*"
msgstr "*Dirilis pada 10 Juli 2016.*"

msgid "Removed Google web translate machine translation."
msgstr "Menghapus terjemahan mesin Google web translate."

msgid "Improved commit message when adding translation."
msgstr "Meningkatkan pesan komit saat menambahkan terjemahan."

msgid "Fixed Google Translate API for Hebrew language."
msgstr "Memperbaiki API Google Translate untuk Ibrani."

msgid "Compatibility with Mercurial 3.8."
msgstr "Kompatibilitas dengan Mercurial 3.8."

msgid "Added import_json management command."
msgstr "Menambahkan perintah pengelolaan import_json."

msgid "Correct ordering of listed translations."
msgstr "Urutan terjemahan yang benar."

msgid "Show full suggestion text, not only a diff."
msgstr "Tampilkan teks saran secara lengkap, bukan hanya yang berbeda."

msgid "Extend API (detailed repository status, statistics, …)."
msgstr "Luaskan API (status repositori terperinci, statistik, …)."

msgid "Testsuite no longer requires network access to test repositories."
msgstr ""
"Rangkaian pengujian tidak lagi memerlukan akses jaringan untuk menguji "
"repositori."

msgid "Weblate 2.6"
msgstr "Weblate 2.6"

msgid "*Released on Apr 28th 2016.*"
msgstr "*Dirilis pada 28 April 2016.*"

msgid "Fixed validation of components with language filter."
msgstr "Memperbaiki validasi komponen dengan filter bahasa."

msgid "Improved support for XLIFF files."
msgstr "Meningkatkan dukungan untuk berkas XLIFF."

msgid "Fixed machine translation for non English sources."
msgstr "Memperbaiki terjemahan mesin untuk sumber non Inggris."

msgid "Added REST API."
msgstr "Menambahkan REST API."

msgid "Django 1.10 compatibility."
msgstr "Kompatibilitas Django 1.10."

msgid "Added categories to whiteboard messages."
msgstr "Menambahkan kategori ke pesan papan tulis."

msgid "Weblate 2.5"
msgstr "Weblate 2.5"

msgid "*Released on Mar 10th 2016.*"
msgstr "*Dirilis pada 10 Maret 2016.*"

msgid "Fixed automatic translation for project owners."
msgstr "Memperbaiki terjemahan otomatis untuk pemilik proyek."

msgid "Improved performance of commit and push operations."
msgstr "Meningkatkan kinerja operasi komit dan dorong."

msgid "New management command to add suggestions from command-line."
msgstr "Perintah pengelolaan baru untuk menambahkan saran dari baris perintah."

msgid "Added support for merging comments on file upload."
msgstr ""
"Menambahkan dukungan untuk menggabungkan komentar pada unggahan berkas."

msgid "Added support for some GNU extensions to C printf format."
msgstr "Menambahkan dukungan untuk beberapa ekstensi GNU ke format printf C."

msgid "Added support for generating translator credits."
msgstr "Menambahkan dukungan untuk menghasilkan kredit penerjemah."

msgid "Added support for generating contributor stats."
msgstr "Menambahkan dukungan untuk menghasilkan statistik kontributor."

msgid "Site wide search can search only in one language."
msgstr "Pencarian seluruh situs hanya dapat mencari dalam satu bahasa."

msgid "Improve quality checks for Armenian."
msgstr "Tingkatkan pemeriksaan kualitas untuk Armenia."

msgid ""
"Support for starting translation components without existing translations."
msgstr "Dukungan untuk memulai komponen terjemahan tanpa terjemahan yang ada."

msgid "Support for adding new translations in Qt TS."
msgstr "Dukungan untuk menambahkan terjemahan baru di Qt TS."

msgid "Improved support for translating PHP files."
msgstr "Meningkatkan dukungan untuk menerjemahkan berkas PHP."

msgid "Performance improvements for quality checks."
msgstr "Peningkatan kinerja untuk pemeriksaan kualitas."

msgid "Fixed site wide search for failing checks."
msgstr "Memperbaiki pencarian seluruh situs untuk pemeriksaan yang gagal."

msgid "Added option to specify source language."
msgstr "Menambahkan opsi untuk menspesifikasikan bahasa sumber."

msgid "Extended list of options for import_project."
msgstr "Daftar opsi yang diluaskan untuk import_project."

msgid "Improved targeting for whiteboard messages."
msgstr "Meningkatkan penargetan untuk pesan papan tulis."

msgid "Support for automatic translation across projects."
msgstr "Dukungan untuk terjemahan otomatis di seluruh proyek."

msgid "Optimized fulltext search index."
msgstr "Indeks pencarian teks lengkap yang dioptimalkan."

msgid "Added management command for auto translation."
msgstr "Menambahkan perintah pengelolaan untuk terjemahan otomatis."

msgid "Added placeables highlighting."
msgstr "Menambahkan penyorotan penempatan."

msgid ""
"Added keyboard shortcuts for placeables, checks and machine translations."
msgstr ""
"Menambahkan pintasan papan ketik untuk penempatan, pemeriksaan, dan "
"terjemahan mesin."

msgid "Improved translation locking."
msgstr "Meningkatkan penguncian terjemahan."

msgid "Added quality check for AngularJS interpolation."
msgstr "Menambahkan pemeriksaan kualitas untuk interpolasi AngularJS."

msgid "Added extensive group based ACLs."
msgstr "Menambahkan ACL berbasis grup yang luas."

msgid "Clarified terminology on strings needing edit (formerly fuzzy)."
msgstr ""
"Mengklarifikasikan terminologi pada string yang memerlukan penyuntingan "
"(sebelumnya fuzzy)."

msgid ""
"Clarified terminology on strings needing action and untranslated strings."
msgstr ""
"Mengklarifikasikan terminologi pada string yang memerlukan tindakan dan "
"string yang belum diterjemahkan."

msgid "Support for Python 3."
msgstr "Dukungan untuk Python 3."

msgid "Dropped support for Django 1.7."
msgstr "Menghapus dukungan untuk Django 1.7."

msgid "Dropped dependency on msginit for creating new gettext PO files."
msgstr ""
"Menghapus dependensi pada msginit untuk membuat berkas PO gettext baru."

msgid "Added configurable dashboard views."
msgstr "Menambahkan tampilan dasbor yang dapat dikonfigurasikan."

msgid "Improved notifications on parse errors."
msgstr "Meningkatkan notifikasi pada galat penguraian."

msgid ""
"Added option to import components with duplicate name to import_project."
msgstr ""
"Menambahkan opsi untuk mengimpor komponen dengan nama ganda ke "
"import_project."

msgid "Added XLIFF export for dictionary."
msgstr "Menambahkan ekspor XLIFF untuk kamus."

msgid "Added XLIFF and gettext PO export for all translations."
msgstr "Menambahkan ekspor XLIFF dan gettext PO untuk semua terjemahan."

msgid "Added support for configurable automatic group assignments."
msgstr ""
"Menambahkan dukungan untuk penugasan grup otomatis yang dapat "
"dikonfigurasikan."

msgid "Improved adding of new translations."
msgstr "Meningkatkan penambahan terjemahan baru."

msgid "Weblate 2.4"
msgstr "Weblate 2.4"

msgid "*Released on Sep 20th 2015.*"
msgstr "*Dirilis pada 20 September 2015.*"

msgid "Improved support for PHP files."
msgstr "Meningkatkan dukungan untuk berkas PHP."

msgid "Ability to add ACL to anonymous user."
msgstr "Kemampuan untuk menambahkan ACL ke pengguna anonim."

msgid "Improved configurability of import_project command."
msgstr "Meningkatkan konfigurasi perintah import_project."

msgid "Added CSV dump of history."
msgstr "Menambahkan buangan CSV riwayat."

msgid "Avoid copy/paste errors with whitespace characters."
msgstr "Hindari galat salin/tempel dengan karakter spasi."

msgid "Added support for Bitbucket webhooks."
msgstr "Menambahkan dukungan untuk kait web Bitbucket."

msgid "Tighter control on fuzzy strings on translation upload."
msgstr "Kontrol yang lebih ketat pada string fuzzy pada unggahan terjemahan."

msgid "Several URLs have changed, you might have to update your bookmarks."
msgstr ""
"Beberapa URL telah berubah, Anda mungkin harus memperbarui markah Anda."

msgid "Hook scripts are executed with VCS root as current directory."
msgstr "Skrip kait dieksekusi dengan root VCS sebagai direktori saat ini."

msgid ""
"Hook scripts are executed with environment variables describing current "
"component."
msgstr ""
"Skrip kait dieksekusi dengan variabel lingkungan yang menjelaskan komponen "
"saat ini."

msgid "Add management command to optimize fulltext index."
msgstr "Tambahkan perintah manajemen untuk mengoptimalkan indeks teks lengkap."

msgid "Added support for error reporting to Rollbar."
msgstr "Menambahkan dukungan untuk pelaporan galat ke Rollbar."

msgid "Projects now can have multiple owners."
msgstr "Proyek sekarang dapat memiliki banyak pemilik."

msgid "Project owners can manage themselves."
msgstr "Pemilik proyek dapat mengelolanya sendiri."

msgid "Added support for ``javascript-format`` used in gettext PO."
msgstr ""
"Menambahkan dukungan untuk ``javascript-format`` yang digunakan dalam "
"gettext PO."

msgid "Support for adding new translations in XLIFF."
msgstr "Dukungan untuk menambahkan terjemahan baru di XLIFF."

msgid "Improved file format autodetection."
msgstr "Meningkatkan deteksi otomatis format berkas."

msgid "Extended keyboard shortcuts."
msgstr "Pintasan papan ketik yang diluaskan."

msgid "Improved dictionary matching for several languages."
msgstr "Meningkatkan pencocokan kamus untuk beberapa bahasa."

msgid "Improved layout of most of pages."
msgstr "Meningkatkan tata letak sebagian besar halaman."

msgid "Support for adding words to dictionary while translating."
msgstr "Dukungan untuk menambahkan kata ke kamus saat menerjemahkan."

msgid "Added support for filtering languages to be managed by Weblate."
msgstr ""
"Menambahkan dukungan untuk memfilter bahasa yang akan dikelola oleh Weblate."

msgid "Added support for translating and importing CSV files."
msgstr "Menambahkan dukungan untuk menerjemahkan dan mengimpor berkas CSV."

msgid "Rewritten handling of static files."
msgstr "Penanganan berkas statis yang ditulis ulang."

msgid ""
"Direct login/registration links to third-party service if that's the only "
"one."
msgstr ""
"Tautan masuk/registrasi langsung ke layanan pihak ketiga jika itu satu-"
"satunya."

msgid "Commit pending changes on account removal."
msgstr "Komit perubahan yang tertunda pada penghapusan akun."

msgid "Add management command to change site name."
msgstr "Tambahkan perintah pengelolaan untuk mengubah nama situs."

msgid "Add option to configure default committer."
msgstr "Tambahkan opsi untuk mengkonfigurasikan komiter bawaan."

msgid "Add hook after adding new translation."
msgstr "Tambahkan kait setelah menambahkan terjemahan baru."

msgid "Add option to specify multiple files to add to commit."
msgstr ""
"Tambahkan opsi untuk menspesifikasikan beberapa berkas yang akan ditambahkan "
"untuk dikomit."

msgid "Weblate 2.3"
msgstr "Weblate 2.3"

msgid "*Released on May 22nd 2015.*"
msgstr "*Dirilis pada 22 Maret 2015.*"

msgid "Dropped support for Django 1.6 and South migrations."
msgstr "Menghapus dukungan untuk Django 1.6 dan migrasi South."

msgid "Support for adding new translations when using Java Property files."
msgstr ""
"Dukungan untuk menambahkan terjemahan baru saat menggunakan berkas Properti "
"Java."

msgid "Allow to accept suggestion without editing."
msgstr "Izinkan untuk menerima saran tanpa menyunting."

msgid "Improved support for Google OAuth 2.0."
msgstr "Meningkatkan dukungan untuk Google OAuth 2.0."

msgid "Added support for Microsoft .resx files."
msgstr "Menambahkan dukungan untuk berkas Microsoft .resx."

msgid "Tuned default robots.txt to disallow big crawling of translations."
msgstr ""
"Mengatur robots.txt bawaan untuk melarang perayapan terjemahan yang besar."

msgid "Simplified workflow for accepting suggestions."
msgstr "Alur kerja yang disederhanakan untuk menerima saran."

msgid "Added project owners who always receive important notifications."
msgstr "Menambahkan pemilik proyek yang selalu menerima notifikasi penting."

msgid "Allow to disable editing of monolingual template."
msgstr "Izinkan untuk menonaktifkan penyuntingan templat ekabahasa."

msgid "More detailed repository status view."
msgstr "Tampilan status repositori yang lebih rinci."

msgid "Direct link for editing template when changing translation."
msgstr "Tautan langsung untuk menyunting templat saat mengubah terjemahan."

msgid "Allow to add more permissions to project owners."
msgstr "Izinkan untuk menambahkan lebih banyak izin ke pemilik proyek."

msgid "Allow to show secondary language in Zen mode."
msgstr "Izinkan untuk menampilkan bahasa kedua dalam mode Zen."

msgid "Support for hiding source string in favor of secondary language."
msgstr "Dukungan untuk menyembunyikan string sumber demi bahasa kedua."

msgid "Weblate 2.2"
msgstr "Weblate 2.2"

msgid "*Released on Feb 19th 2015.*"
msgstr "*Dirilis pada 19 Februari 2015.*"

msgid "Performance improvements."
msgstr "Peningkatan kinerja."

msgid "Fulltext search on location and comments fields."
msgstr "Pencarian teks lengkap pada lokasi dan kolom komentar."

msgid "New SVG/JavaScript-based activity charts."
msgstr "Bagan aktivitas baru berbasis SVG/JavaScript."

msgid "Support for Django 1.8."
msgstr "Dukungan untuk Django 1.8."

msgid "Support for deleting comments."
msgstr "Dukungan untuk menghapus komentar."

msgid "Added own SVG badge."
msgstr "Menambahkan lencana SVG sendiri."

msgid "Added support for Google Analytics."
msgstr "Menambahkan dukungan untuk Google Analytics."

msgid "Improved handling of translation filenames."
msgstr "Meningkatkan penanganan nama berkas terjemahan."

msgid "Added support for monolingual JSON translations."
msgstr "Menambahkan dukungan untuk terjemahan JSON ekabahasa."

msgid "Record component locking in a history."
msgstr "Rekam komponen penguncian dalam riwayat."

msgid ""
"Support for editing source (template) language for monolingual translations."
msgstr ""
"Dukungan untuk menyunting bahasa sumber (templat) untuk terjemahan ekabahasa."

msgid "Added basic support for Gerrit."
msgstr "Menambahkan dukungan dasar untuk Gerrit."

msgid "Weblate 2.1"
msgstr "Weblate 2.1"

msgid "*Released on Dec 5th 2014.*"
msgstr "*Dirilis pada 5 Desember 2014.*"

msgid "Added support for Mercurial repositories."
msgstr "Menambahkan dukungan untuk repositori Mercurial."

msgid "Replaced Glyphicon font by Awesome."
msgstr "Mengganti huruf Glyphicon dengan Awesome."

msgid "Added icons for social authentication services."
msgstr "Menambahkan ikon untuk layanan autentikasi sosial."

msgid "Better consistency of button colors and icons."
msgstr "Konsistensi warna tombol dan ikon yang lebih baik."

msgid "Various bugfixes."
msgstr "Berbagai perbaikan kerusakan."

msgid "Automatic hiding of columns in translation listing for small screens."
msgstr ""
"Menyembunyikan kolom secara otomatis dalam daftar terjemahan untuk layar "
"kecil."

msgid "Changed configuration of filesystem paths."
msgstr "Mengubah konfigurasi jalur sistem berkas."

msgid "Improved SSH keys handling and storage."
msgstr "Meningkatkan penanganan dan penyimpanan kunci SSH."

msgid "Improved repository locking."
msgstr "Meningkatkan penguncian repositori."

msgid "Customizable quality checks per source string."
msgstr "Pemeriksaan kualitas yang dapat disesuaikan per string sumber."

msgid "Allow to hide completed translations from dashboard."
msgstr "Izinkan untuk menyembunyikan terjemahan yang selesai dari dasbor."

msgid "Weblate 2.0"
msgstr "Weblate 2.0"

msgid "*Released on Nov 6th 2014.*"
msgstr "*Dirilis pada 6 November 2014.*"

msgid "New responsive UI using Bootstrap."
msgstr "UI responsif baru menggunakan Bootstrap."

msgid "Rewritten VCS backend."
msgstr "Backend VCS yang ditulis ulang."

msgid "Added whiteboard for site wide messages."
msgstr "Menambahkan papan tulis untuk pesan di seluruh situs."

msgid "Configurable strings priority."
msgstr "Prioritas string yang dapat dikonfigurasikan."

msgid "Added support for JSON file format."
msgstr "Menambahkan dukungan untuk format berkas JSON."

msgid "Fixed generating mo files in certain cases."
msgstr "Memperbaiki penghasilan berkas mo dalam kasus tertentu."

msgid "Added support for GitLab notifications."
msgstr "Menambahkan dukungan untuk notifikasi GitLab."

msgid "Added support for disabling translation suggestions."
msgstr "Menambahkan dukungan untuk menonaktifkan saran terjemahan."

msgid "Django 1.7 support."
msgstr "Dukungan Django 1.7."

msgid "ACL projects now have user management."
msgstr "Proyek ACL sekarang memiliki pengelolaan pengguna."

msgid "Extended search possibilities."
msgstr "Kemungkinan pencarian yang diluaskan."

msgid "Give more hints to translators about plurals."
msgstr "Berikan lebih banyak petunjuk kepada penerjemah tentang jamak."

msgid "Fixed Git repository locking."
msgstr "Memperbaiki penguncian repositori Git."

msgid "Compatibility with older Git versions."
msgstr "Kompatibilitas dengan versi Git yang lebih lama."

msgid "Improved ACL support."
msgstr "Meningkatkan dukungan ACL."

msgid "Added buttons for per language quotes and other special characters."
msgstr ""
"Menambahkan tombol untuk kutipan per bahasa dan karakter spesial lainnya."

msgid "Support for exporting stats as JSONP."
msgstr "Dukungan untuk mengekspor statistik sebagai JSONP."

msgid "Weblate 3.x series"
msgstr "Seri Weblate 3.x"

msgid "Weblate 3.11.3"
msgstr "Weblate 3.11.3"

msgid "*Released on March 11th 2020.*"
msgstr "*Dirilis pada 11 Maret 2020.*"

msgid "Fixed searching for fields with certain priority."
msgstr "Memperbaiki pencarian kolom dengan prioritas tertentu."

msgid "Fixed predefined query for recently added strings."
msgstr ""
"Memperbaiki kueri yang telah ditetapkan sebelumnya untuk string yang baru "
"saja ditambahkan."

msgid "Fixed searching returning duplicate matches."
msgstr "Memperbaiki pencarian yang mengembalikan kecocokan ganda."

msgid "Fixed notifications rendering in Gmail."
msgstr "Memperbaiki notifikasi yang ditampilkan di Gmail."

msgid "Fixed reverting changes from the history."
msgstr "Memperbaiki pengembalian perubahan dari riwayat."

msgid "Added links to events in digest notifications."
msgstr "Menambahkan tautan ke peristiwa dalam notifikasi intisari."

msgid "Fixed email for account removal confirmation."
msgstr "Memperbaiki surel untuk konfirmasi penghapusan akun."

msgid "Added support for Slack authentication in Docker container."
msgstr "Menambahkan dukungan untuk autentikasi Slack dalam kontainer Docker."

msgid "Avoid sending notifications for not subscribed languages."
msgstr "Hindari mengirimkan notifikasi untuk bahasa yang tidak berlangganan."

msgid "Include Celery queues in performance overview."
msgstr "Sertakan antrian Celery dalam ikhtisar kinerja."

msgid "Fixed documentation links for add-ons."
msgstr "Memperbaiki tautan dokumentasi untuk pengaya."

msgid "Reduced false negatives for unchanged translation check."
msgstr ""
"Mengurangi negatif palsu untuk pemeriksaan terjemahan yang tidak berubah."

msgid "Raised bleach dependency to address :cve:`2020-6802`."
msgstr "Meningkatkan dependensi pemutih untuk mengatasi :cve:`2020-6802`."

msgid "Fixed listing project level changes in history."
msgstr "Memperbaiki perubahan tingkat proyek yang tercantum dalam riwayat."

msgid "Fixed stats invalidation in some corner cases."
msgstr "Memperbaiki statistik yang tidak valid pada beberapa kasus khusus."

msgid "Fixed searching for certain string states."
msgstr "Memperbaiki pencarian untuk status string tertentu."

msgid "Improved format string checks behavior on missing percent."
msgstr ""
"Meningkatkan pemeriksaan string format pada perilaku persentase yang hilang."

msgid "Fixed authentication using some third party providers."
msgstr "Memperbaiki autentikasi menggunakan beberapa penyedia pihak ketiga."

msgid "Weblate 3.11.2"
msgstr "Weblate 3.11.2"

msgid "*Released on February 22nd 2020.*"
msgstr "*Dirilis pada 22 Februari 2020.*"

msgid "Fixed rendering of suggestions."
msgstr "Memperbaiki rendering saran."

msgid "Fixed some strings wrongly reported as having no words."
msgstr "Memperbaiki beberapa string yang salah dilaporkan tidak memiliki kata."

msgid "Weblate 3.11.1"
msgstr "Weblate 3.11.1"

msgid "*Released on February 20th 2020.*"
msgstr "*Dirilis pada 20 Februari 2020.*"

msgid "Documented Celery setup changes."
msgstr "Perubahan pengaturan Celery yang didokumentasikan."

msgid "Improved filename validation on component creation."
msgstr "Meningkatkan validasi nama berkas pada pembuatan komponen."

msgid "Fixed minimal versions of some dependencies."
msgstr "Memperbaiki versi minimal beberapa dependensi."

msgid "Fixed adding groups with certain Django versions."
msgstr "Memperbaiki penambahan grup dengan versi Django tertentu."

msgid "Fixed manual pushing to upstream repository."
msgstr "Memperbaiki dorongan manual ke repositori hulu."

msgid "Improved glossary matching."
msgstr "Meningkatkan pencocokan glosarium."

msgid "Weblate 3.11"
msgstr "Weblate 3.11"

msgid "*Released on February 17th 2020.*"
msgstr "*Dirilis pada 17 Februari 2020.*"

msgid "Allow using VCS push URL during component creation via API."
msgstr ""
"Izinkan penggunaan URL dorong VCS selama pembuatan komponen melalui API."

msgid "Rendered width check now shows image with the render."
msgstr "Pemeriksaan lebar render sekarang menampilkan gambar dengan render."

msgid "Fixed links in notifications e-mails."
msgstr "Memperbaiki tautan dalam notifikasi surel."

msgid "Improved look of plaintext e-mails."
msgstr "Meningkatkan tampilan surel teks biasa."

msgid "Display ignored checks and allow to make them active again."
msgstr ""
"Tampilkan pemeriksaan yang diabaikan dan izinkannya diaktifkan kembali."

msgid "Display nearby keys on monolingual translations."
msgstr "Tampilkan tombol terdekat pada terjemahan ekabahasa."

msgid "Added support for grouping string shapings."
msgstr "Menambahkan dukungan untuk penggrupan bentuk string."

msgid "Recommend upgrade to new Weblate versions in the system checks."
msgstr "Sarankan peningkatan ke versi Weblate baru dalam pemeriksaan sistem."

msgid "Provide more detailed analysis for duplicate language alert."
msgstr "Berikan analisis yang lebih rinci untuk peringatan ganda bahasa."

msgid "Include more detailed license info on the project pages."
msgstr "Sertakan info lisensi yang lebih rinci pada halaman proyek."

msgid "Automatically unshallow local copies if needed."
msgstr ""
"Secara otomatis membuka kembali salinan lokal yang dangkal jika diperlukan."

msgid "Fixed download of strings needing action."
msgstr "Memperbaiki pengunduhan string yang memerlukan tindakan."

msgid "New alert to warn about using the same file mask twice."
msgstr ""
"Peringatan baru untuk memperingatkan tentang penggunaan mask berkas yang "
"sama dua kali."

msgid "Improve XML placeables extraction."
msgstr "Tingkatkan ekstraksi penempatan XML."

msgid ""
"The :setting:`SINGLE_PROJECT` can now enforce redirection to chosen project."
msgstr ""
":setting:`SINGLE_PROJECT` sekarang dapat memaksakan pengalihan ke proyek "
"yang dipilih."

msgid "Added option to resolve comments."
msgstr "Menambahkan opsi untuk menyelesaikan komentar."

msgid "Added bulk editing of flags."
msgstr "Menambahkan penyuntingan massal pada penanda."

msgid "Added support for :ref:`labels`."
msgstr "Menambahkan dukungan untuk :ref:`labels`."

msgid "Added bulk edit add-on."
msgstr "Menambahkan pengaya penyuntingan massal."

msgid "Added option for :ref:`enforcing-checks`."
msgstr "Menambahkan opsi untuk :ref:`enforcing-checks`."

msgid "Increased default validity of confirmation links."
msgstr "Peningkatan validitas bawaan tautan konfirmasi."

msgid "Improved Matomo integration."
msgstr "Meningkatkan integrasi Matomo."

msgid "Fixed :ref:`check-translated` to correctly handle source string change."
msgstr ""
"Memperbaiki :ref:`check-translated` untuk menangani perubahan string sumber "
"dengan benar."

msgid "Extended automatic updates configuration by :setting:`AUTO_UPDATE`."
msgstr ""
"Konfigurasi pembaruan otomatis diluaskan dengan :setting:`AUTO_UPDATE`."

msgid "LINGUAS add-ons now do full sync of translations in Weblate."
msgstr ""
"Pengaya LINGUAS sekarang melakukan sinkron terjemahan secara penuh di "
"Weblate."

msgid "Weblate 3.10.3"
msgstr "Weblate 3.10.3"

msgid "*Released on January 18th 2020.*"
msgstr "*Dirilis pada 18 Januari 2020.*"

msgid "Support for translate-toolkit 2.5.0."
msgstr "Dukungan untuk translate-toolkit 2.5.0."

msgid "Weblate 3.10.2"
msgstr "Weblate 3.10.2"

msgid "Add lock indication to projects."
msgstr "Tambahkan indikasi kunci ke proyek."

msgid "Fixed CSS bug causing flickering in some web browsers."
msgstr ""
"Memperbaiki kerusakan CSS yang menyebabkan kedipan pada beberapa peramban "
"web."

msgid "Fixed searching on systems with non-English locales."
msgstr "Memperbaiki pencarian pada sistem dengan lokalisasi non-Inggris."

msgid "Improved repository matching for GitHub and Bitbucket hooks."
msgstr "Meningkatkan pencocokan repositori untuk kait GitHub dan Bitbucket."

msgid "Fixed data migration on some Python 2.7 installations."
msgstr "Memperbaiki migrasi data pada beberapa pemasangan Python 2.7."

msgid "Allow configuration of Git shallow cloning."
msgstr "Izinkan konfigurasi kloning dangkal Git."

msgid "Improved background notification processing."
msgstr "Peningkatan pemrosesan notifikasi latar belakang."

msgid "Fixed broken form submission when navigating back in web browser."
msgstr ""
"Memperbaiki pengiriman formulir yang rusak saat menavigasi kembali di "
"peramban web."

msgid "New add-on to configure YAML formatting."
msgstr "Pengaya baru untuk mengkonfigurasikan pemformatan YAML."

msgid "Fixed same plurals check to not fire on single plural form languages."
msgstr ""
"Memperbaiki pemeriksaan jamak yang sama agar tidak diaktifkan pada bahasa "
"dengan bentuk jamak tunggal."

msgid "Fixed regex search on some fields."
msgstr "Memperbaiki pencarian regex di beberapa kolom."

msgid "Weblate 3.10.1"
msgstr "Weblate 3.10.1"

msgid "*Released on January 9th 2020.*"
msgstr "*Dirilis pada 9 Januari 2020.*"

msgid "Extended API with translation creation."
msgstr "API yang diluaskan dengan pembuatan terjemahan."

msgid "Fixed several corner cases in data migrations."
msgstr "Memperbaiki beberapa kasus khusus dalam migrasi data."

msgid "Compatibility with Django 3.0."
msgstr "Kompatibilitas dengan Django 3.0."

msgid "Improved data clean-up performance."
msgstr "Meningkatkan kinerja pembersihan data."

msgid "Added support for customizable security.txt."
msgstr "Menambahkan dukungan untuk security.txt yang dapat disesuaikan."

msgid "Improved breadcrumbs in changelog."
msgstr "Meningkatkan breadcrumb pada catatan perubahan."

msgid "Improved translations listing on dashboard."
msgstr "Meningkatkan daftar terjemahan pada dasbor."

msgid "Improved HTTP responses for webhooks."
msgstr "Meningkatkan respons HTTP untuk kait web."

msgid "Added support for GitLab merge requests in Docker container."
msgstr ""
"Menambahkan dukungan untuk permintaan penggabungan GitLab dalam kontainer "
"Docker."

msgid "Weblate 3.10"
msgstr "Weblate 3.10"

msgid "*Released on December 20th 2019.*"
msgstr "*Dirilis pada 20 Desember 2019.*"

msgid "Improved application user interface."
msgstr "Meningkatkan antarmuka pengguna aplikasi."

msgid "Added doublespace check."
msgstr "Menambahkan pemeriksaan spasi ganda."

msgid "Fixed creating new languages."
msgstr "Memperbaiki pembuatan bahasa baru."

msgid "Avoid sending auditlog notifications to deleted e-mails."
msgstr "Hindari pengiriman notifikasi catatan audit untuk menghapus surel."

msgid "Added support for read-only strings."
msgstr "Menambahkan dukungan untuk string hanya baca."

msgid "Added support for Markdown in comments."
msgstr "Menambahkan dukungan untuk Markdown dalam komentar."

msgid "Allow placing translation instruction text in project info."
msgstr "Izinkan penempatan teks instruksi terjemahan dalam info proyek."

msgid "Add copy to clipboard for secondary languages."
msgstr "Tambahkan salinan ke papan klip untuk bahasa kedua."

msgid "Improved support for Mercurial."
msgstr "Meningkatkan dukungan untuk Mercurial."

msgid "Improved Git repository fetching performance."
msgstr "Meningkatkan kinerja pengambilan repositori Git."

msgid "Add search lookup for age of string."
msgstr "Tambahkan pencarian untuk usia string."

msgid "Show source language for all translations."
msgstr "Tampilkan bahasa sumber untuk semua terjemahan."

msgid "Show context for nearby strings."
msgstr "Tampilkan konteks untuk string terdekat."

msgid "Added support for notifications on repository operations."
msgstr "Menambahkan dukungan untuk notifikasi pada operasi repositori."

msgid "Improved translation listings."
msgstr "Meningkatkan daftar terjemahan."

msgid "Added support for automatic translation strings marked for editing."
msgstr ""
"Menambahkan dukungan untuk string terjemahan otomatis yang ditandai untuk "
"disunting."

msgid "Avoid sending duplicate notifications for linked component alerts."
msgstr ""
"Hindari pengiriman notifikasi ganda untuk peringatan komponen yang tertaut."

msgid "Improve default merge request message."
msgstr "Memperbaiki pesan permintaan penggabungan bawaan."

msgid "Better indicate string state in Zen mode."
msgstr "Lebih baik menunjukkan status string dalam mode Zen."

msgid "Added support for more languages in Yandex Translate."
msgstr "Menambahkan dukungan untuk lebih banyak bahasa di Yandex Translate."

msgid "Improved look of notification e-mails."
msgstr "Meningkatkan tampilan surel notifikasi."

msgid "Provide choice for translation license."
msgstr "Berikan pilihan untuk lisensi terjemahan."

msgid "Weblate 3.9.1"
msgstr "Weblate 3.9.1"

msgid "*Released on October 28th 2019.*"
msgstr "*Dirilis pada 28 Oktober 2019.*"

msgid "Remove some unneeded files from backups."
msgstr "Menghapus beberapa berkas yang tidak diperlukan dari cadangan."

msgid "Fixed potential crash in reports."
msgstr "Memperbaiki potensi mogok dalam laporan."

msgid "Fixed cross database migration failure."
msgstr "Memperbaiki kegagalan migrasi lintas basis data."

msgid "Added support for force pushing Git repositories."
msgstr "Menambahkan dukungan untuk mendorong repositori Git secara paksa."

msgid "Reduced risk of registration token invalidation."
msgstr "Mengurangi risiko pembatalan token registrasi."

msgid "Fixed account removal hitting rate limiter."
msgstr "Memperbaiki penghapusan akun yang memengaruhi pembatas akses."

msgid "Added search based on priority."
msgstr "Menambahkan pencarian berdasarkan prioritas."

msgid "Fixed possible crash on adding strings to JSON file."
msgstr "Memperbaiki kemungkinan mogok saat menambahkan string ke berkas JSON."

msgid "Safe HTML check and fixup now honor source string markup."
msgstr ""
"Pemeriksaan dan perbaikan HTML yang aman kini menghormati markah string "
"sumber."

msgid "Avoid sending notifications to invited and deleted users."
msgstr ""
"Hindari pengiriman notifikasi kepada pengguna yang diundang dan dihapus."

msgid "Fix SSL connection to redis in Celery in Docker container."
msgstr "Memperbaiki sambungan SSL ke redis di Celery dalam kontainer Docker."

msgid "Weblate 3.9"
msgstr "Weblate 3.9"

msgid "*Released on October 15th 2019.*"
msgstr "*Dirilis pada 15 Oktober 2019.*"

msgid "Include Weblate metadata in downloaded files."
msgstr "Sertakan metadata Weblate dalam berkas yang diunduh."

msgid "Improved UI for failing checks."
msgstr "Meningkatkan UI untuk pemeriksaan yang gagal."

msgid "Indicate missing strings in format checks."
msgstr "Tunjukkan string yang hilang dalam pemeriksaan format."

msgid "Separate check for French punctuation spacing."
msgstr "Pemeriksaan terpisah untuk spasi tanda baca Prancis."

msgid "Add support for fixing some of quality checks errors."
msgstr ""
"Tambahkan dukungan untuk memperbaiki beberapa galat pemeriksaan kualitas."

msgid "Add separate permission to create new projects."
msgstr "Tambahkan izin terpisah untuk membuat proyek baru."

msgid "Extend stats for char counts."
msgstr "Luaskan statistik untuk jumlah karakter."

msgid "Improve support for Java style language codes."
msgstr "Meningkatkan dukungan untuk kode bahasa gaya Java."

msgid "Added new generic check for placeholders."
msgstr "Menambahkan pemeriksaan umum baru untuk pengganti."

msgid "Added support for WebExtension JSON placeholders."
msgstr "Menambahkan dukungan untuk pengganti WebExtension JSON."

msgid "Added support for flat XML format."
msgstr "Menambahkan dukungan untuk format XML datar."

msgid ""
"Extended API with project, component and translation removal and creation."
msgstr ""
"API yang diperluas dengan penghapusan dan pembuatan proyek, komponen, dan "
"terjemahan."

msgid "Added support for Gitea and Gitee webhooks."
msgstr "Menambahkan dukungan untuk kait web Gitea dan Gitee."

msgid "Added new custom regex based check."
msgstr "Menambahkan pemeriksaan berbasis regex khusus baru."

msgid "Allow to configure contributing to shared translation memory."
msgstr ""
"Izinkan untuk mengkonfigurasikan kontribusi pada memori terjemahan bersama."

msgid "Added ZIP download for more translation files."
msgstr "Menambahkan unduhan ZIP untuk lebih banyak berkas terjemahan."

msgid "Make XLIFF standard compliant parsing of maxwidth and font."
msgstr "Jadikan penguraian lebar maksimum dan huruf sesuai standar XLIFF."

msgid ""
"Added new check and fixer for safe HTML markup for translating web "
"applications."
msgstr ""
"Menambahkan pemeriksaan dan perbaikan baru untuk markah HTML yang aman untuk "
"menerjemahkan aplikasi web."

msgid "Add component alert on unsupported configuration."
msgstr "Tambahkan peringatan komponen pada konfigurasi yang tidak didukung."

msgid "Added automatic translation add-on to bootstrap translations."
msgstr "Menambahkan pengaya terjemahan otomatis ke terjemahan bootstrap."

msgid "Extend automatic translation to add suggestions."
msgstr "Luaskan terjemahan otomatis untuk menambahkan saran."

msgid "Display add-on parameters on overview."
msgstr "Menampilkan parameter pengaya pada ikhtisar."

msgid "Sentry is now supported through modern Sentry SDK instead of Raven."
msgstr "Sentry sekarang didukung melalui Sentry SDK modern, bukan Raven."

msgid "Changed example settings to be better fit for production environment."
msgstr ""
"Mengubah pengaturan contoh agar lebih sesuai dengan lingkungan produksi."

msgid "Added automated backups using BorgBackup."
msgstr "Menambahkan pencadangan otomatis menggunakan BorgBackup."

msgid "Split cleanup add-on for RESX to avoid unwanted file updates."
msgstr ""
"Pisahkan pengaya pembersihan untuk RESX demi menghindari pembaruan berkas "
"yang tidak diinginkan."

msgid "Added advanced search capabilities."
msgstr "Menambahkan kemampuan pencarian lanjutan."

msgid "Allow users to download their own reports."
msgstr "Izinkan pengguna mengunduh laporan mereka sendiri."

msgid "Added localization guide to help configuring components."
msgstr ""
"Menambahkan panduan lokalisasi untuk membantu mengkonfigurasikan komponen."

msgid "Added support for GitLab merge requests."
msgstr "Menambahkan dukungan untuk permintaan penggabungan GitLab."

msgid "Improved display of repository status."
msgstr "Meningkatkan tampilan status repositori."

msgid "Perform automated translation in the background."
msgstr "Lakukan terjemahan otomatis di latar belakang."

msgid "Weblate 3.8"
msgstr "Weblate 3.8"

msgid "*Released on August 15th 2019.*"
msgstr "*Dirilis pada 15 Agustus 2019.*"

msgid "Added support for simplified creating of similar components."
msgstr ""
"Menambahkan dukungan untuk pembuatan komponen serupa yang disederhanakan."

msgid ""
"Added support for parsing translation flags from the XML based file formats."
msgstr ""
"Menambahkan dukungan untuk mengurai penanda terjemahan dari format berkas "
"berbasis XML."

msgid "Log exceptions into Celery log."
msgstr "Catat pengecualian pada Catatan Celery."

msgid "Improve performance of repository scoped add-ons."
msgstr "Tingkatkan kinerja pengaya cakupan repositori."

msgid "Fixed password reset behavior."
msgstr "Memperbaiki perilaku pengaturan ulang kata sandi."

msgid "Improved performance on most of translation pages."
msgstr "Meningkatkan kinerja pada sebagian besar halaman terjemahan."

msgid "Fixed listing of languages not known to Weblate."
msgstr "Memperbaiki daftar bahasa yang tidak diketahui Weblate."

msgid "Add support for cloning add-ons to discovered components."
msgstr "Menambahkan dukungan untuk kloning pengaya ke komponen yang ditemukan."

msgid "Add support for replacing file content with uploaded."
msgstr "Tambahkan dukungan untuk mengganti konten berkas dengan yang diunggah."

msgid "Add support for translating non VCS based content."
msgstr "Tambahkan dukungan untuk menerjemahkan konten non VCS."

msgid "Added OpenGraph widget image to use on social networks."
msgstr ""
"Menambahkan gambar widget OpenGraph untuk digunakan di jejaring sosial."

msgid "Added support for animated screenshots."
msgstr "Menambahkan dukungan untuk tangkapan layar animasi."

msgid "Improved handling of monolingual XLIFF files."
msgstr "Meningkatkan penanganan berkas XLIFF ekabahasa."

msgid "Avoid sending multiple notifications for single event."
msgstr "Hindari pengiriman beberapa notifikasi untuk satu peristiwa."

msgid "Add support for filtering changes."
msgstr "Tambahkan dukungan untuk memfilter perubahan."

msgid "Extended predefined periods for reporting."
msgstr "Periode pelaporan yang telah didefinisikan sebelumnya diperpanjang."

msgid "Added webhook support for Azure Repos."
msgstr "Menambahkan dukungan kait web untuk Azure Repos."

msgid ""
"New opt-in notifications on pending suggestions or untranslated strings."
msgstr ""
"Notifikasi keikutsertaan baru pada saran yang tertunda atau string yang "
"belum diterjemahkan."

msgid "Add one click unsubscribe link to notification e-mails."
msgstr "Tambahkan satu tautan berhenti berlangganan ke surel notifikasi."

msgid "Fixed false positives with Has been translated check."
msgstr "Memperbaiki positif palsu dengan pemeriksaan Telah diterjemahkan."

msgid "New management interface for admins."
msgstr "Antarmuka pengelolaan baru untuk admin."

msgid "String priority can now be specified using flags."
msgstr "Prioritas string sekarang dapat dispesifikasikan menggunakan penanda."

msgid "Added language management views."
msgstr "Menambahkan tampilan pengelolaan bahasa."

msgid "Add checks for Qt library and Ruby format strings."
msgstr "Tambahkan pemeriksaan untuk pustaka Qt dan string format Ruby."

msgid "Added configuration to better fit single project installations."
msgstr ""
"Konfigurasi tambahan agar lebih sesuai dengan pemasangan proyek tunggal."

msgid ""
"Notify about new string on source string change on monolingual translations."
msgstr ""
"Beritahukan tentang string baru pada perubahan string sumber pada terjemahan "
"ekabahasa."

msgid "Added separate view for translation memory with search capability."
msgstr ""
"Menambahkan tampilan terpisah untuk memori terjemahan dengan kemampuan "
"pencarian."

msgid "Weblate 3.7.1"
msgstr "Weblate 3.7.1"

msgid "*Released on June 28th 2019.*"
msgstr "*Dirilis pada 28 Juni 2019.*"

msgid "Fixed some requirements constraints."
msgstr "Memperbaiki beberapa kendala persyaratan."

msgid "Updated language database."
msgstr "Basis data bahasa yang diperbarui."

msgid "Localization updates."
msgstr "Pembaruan lokalisasi."

msgid "Various user interface tweaks."
msgstr "Berbagai penyesuaian antarmuka pengguna."

msgid "Improved handling of unsupported but discovered translation files."
msgstr ""
"Meningkatkan penanganan berkas terjemahan yang tidak didukung tetapi "
"ditemukan."

msgid "More verbosely report missing file format requirements."
msgstr "Melaporkan persyaratan format berkas yang hilang dengan lebih rinci."

msgid "Weblate 3.7"
msgstr "Weblate 3.7"

msgid "*Released on June 21st 2019.*"
msgstr "*Dirilis pada 21 Juni 2019.*"

msgid "Added separate Celery queue for notifications."
msgstr "Menambahkan antrian Celery terpisah untuk notifikasi."

msgid "Use consistent look with application for API browsing."
msgstr "Gunakan tampilan yang konsisten dengan aplikasi untuk penelusuran API."

msgid "Include approved stats in the reports."
msgstr "Sertakan statistik yang disetujui dalam laporan."

msgid "Report progress when updating translation component."
msgstr "Laporkan progres saat memperbarui komponen terjemahan."

msgid "Allow to abort running background component update."
msgstr ""
"Izinkan untuk membatalkan pembaruan komponen latar belakang yang sedang "
"berjalan."

msgid "Extend template language for filename manipulations."
msgstr "Luaskan bahasa templat untuk manipulasi nama berkas."

msgid "Use templates for editor link and repository browser URL."
msgstr "Gunakan templat untuk tautan penyuntingan dan URL peramban repositori."

msgid ""
"Indicate max length and current characters count when editing translation."
msgstr ""
"Tunjukkan panjang maksimal dan jumlah karakter saat ini saat menyunting "
"terjemahan."

msgid "Improved handling of abbreviations in unchanged translation check."
msgstr ""
"Meningkatkan penanganan singkatan dalam pemeriksaan terjemahan yang tidak "
"berubah."

msgid "Refreshed landing page for new contributors."
msgstr "Halaman arahan yang diperbarui untuk kontributor baru."

msgid "Add support for configuring msgmerge add-on."
msgstr "Menambahkan dukungan untuk mengkonfigurasikan pengaya msgmerge."

msgid "Delay opening SMTP connection when sending notifications."
msgstr "Tunda pembukaan sambungan SMTP saat mengirim notifikasi."

msgid "Improved error logging."
msgstr "Meningkatkan pencatatan galat."

msgid "Allow custom location in MO generating add-on."
msgstr "Mengizinkan lokasi kustom di pengaya penghasil MO."

msgid "Added add-ons to cleanup old suggestions or comments."
msgstr ""
"Menambahkan pengaya untuk membersihkan saran atau komentar yang sudah lama."

msgid "Added option to enable horizontal mode in the Zen editor."
msgstr ""
"Menambahkan opsi untuk mengaktifkan mode horizontal di penyuntingan Zen."

msgid "Improved import performance with many linked components."
msgstr "Meningkatkan kinerja impor dengan banyak komponen yang terhubung."

msgid "Fixed examples installation in some cases."
msgstr "Memperbaiki contoh pemasangan dalam beberapa kasus."

msgid "Improved rendering of alerts in changes."
msgstr "Meningkatkan tampilan peringatan dalam perubahan."

msgid "Added new horizontal stats widget."
msgstr "Menambahkan widget statistik horizontal baru."

msgid "Improved format strings check on plurals."
msgstr "Meningkatkan format pemeriksaan string pada jamak."

msgid "Added font management tool."
msgstr "Menambahkan alat pengelolaan huruf."

msgid "New check for rendered text dimensions."
msgstr "Pemeriksaan baru untuk dimensi teks yang ditampilkan."

msgid "Added support for subtitle formats."
msgstr "Menambahkan dukungan untuk format takarir."

msgid "Include overall completion stats for languages."
msgstr "Sertakan statistik penyelesaian keseluruhan untuk bahasa."

msgid "Added reporting at project and global scope."
msgstr "Menambahkan pelaporan pada lingkup proyek dan global."

msgid "Improved user interface when showing translation status."
msgstr "Meningkatkan antarmuka pengguna saat menampilkan status terjemahan."

msgid "New Weblate logo and color scheme."
msgstr "Logo dan skema warna Weblate baru."

msgid "New look of bitmap badges."
msgstr "Tampilan baru lencana bitmap."

msgid "Weblate 3.6.1"
msgstr "Weblate 3.6.1"

msgid "*Released on April 26th 2019.*"
msgstr "*Dirilis pada 26 April 2019.*"

msgid "Fixed digest notifications in some corner cases."
msgstr "Memperbaiki notifikasi intisari dalam beberapa kasus khusus."

msgid "Fixed add-on script error alert."
msgstr "Memperbaiki peringatan galat skrip pengaya."

msgid "Fixed generating MO file for monolingual PO files."
msgstr "Memperbaiki pembuatan berkas MO untuk berkas PO ekabahasa."

msgid "Fixed display of uninstalled checks."
msgstr "Memperbaiki tampilan pemeriksaan yang belum terpasang."

msgid "Indicate administered projects on project listing."
msgstr "Tunjukkan proyek yang dikelola pada daftar proyek."

msgid "Allow update to recover from missing VCS repository."
msgstr "Izinkan pembaruan untuk memulihkan dari repositori VCS yang hilang."

msgid "Weblate 3.6"
msgstr "Weblate 3.6"

msgid "*Released on April 20th 2019.*"
msgstr "*Dirilis pada 20 April 2019.*"

msgid "Add support for downloading user data."
msgstr "Tambahkan dukungan untuk mengunduh data pengguna."

msgid "Add-ons are now automatically triggered upon installation."
msgstr ""
"Sekarang pengaya akan secara otomatis dipicu pada saat proses pemasangan."

msgid "Improved instructions for resolving merge conflicts."
msgstr "Meningkatkan petunjuk untuk menyelesaikan konflik penggabungan."

msgid "Cleanup add-on is now compatible with app store metadata translations."
msgstr ""
"Pengaya pembersihan sekarang kompatibel dengan terjemahan metadata toko "
"aplikasi."

msgid "Configurable language code syntax when adding new translations."
msgstr ""
"Sintaksis kode bahasa dapat dikonfigurasikan saat menambahkan terjemahan "
"baru."

msgid ""
"Warn about using Python 2 with planned termination of support in April 2020."
msgstr ""
"Peringatkan tentang penggunaan Python 2 dengan penghentian dukungan yang "
"direncanakan pada April 2020."

msgid "Extract special characters from the source string for visual keyboard."
msgstr "Ekstrak karakter khusus dari string sumber untuk papan ketik visual."

msgid "Extended contributor stats to reflect both source and target counts."
msgstr ""
"Statistik kontributor yang diluaskan untuk mencerminkan jumlah sumber dan "
"target."

msgid ""
"Admins and consistency add-ons can now add translations even if disabled for "
"users."
msgstr ""
"Admin dan pengaya konsistensi sekarang dapat menambahkan terjemahan meskipun "
"dinonaktifkan untuk pengguna."

msgid ""
"Fixed description of toggle disabling ``Language-Team`` header manipulation."
msgstr ""
"Memperbaiki deskripsi tentang penonaktifan pengubahan manipulasi kepala "
"``Language-Team``."

msgid "Notify users mentioned in comments."
msgstr "Beritahukan pengguna yang disebutkan dalam komentar."

msgid "Removed file format autodetection from component setup."
msgstr "Menghapus deteksi otomatis format berkas dari pengaturan komponen."

msgid "Added digest notifications."
msgstr "Menambahkan notifikasi intisari."

msgid "Added support for muting component notifications."
msgstr "Menambahkan dukungan untuk membisukan notifikasi komponen."

msgid "Added notifications for new alerts, whiteboard messages or components."
msgstr ""
"Menambahkan notifikasi untuk peringatan baru, pesan papan tulis, atau "
"komponen."

msgid "Notifications for administered projects can now be configured."
msgstr "Notifikasi untuk proyek yang dikelola sekarang dapat dikonfigurasikan."

msgid "Improved handling of three letter language codes."
msgstr "Meningkatkan penanganan kode bahasa tiga huruf."

msgid "Weblate 3.5.1"
msgstr "Weblate 3.5.1"

msgid "*Released on March 10th 2019.*"
msgstr "*Dirilis pada 10 Maret 2019.*"

msgid "Fixed Celery systemd unit example."
msgstr "Memperbaiki contoh unit systemd Celery."

msgid "Fixed notifications from HTTP repositories with login."
msgstr "Memperbaiki notifikasi dari repositori HTTP dengan masuk."

msgid ""
"Fixed race condition in editing source string for monolingual translations."
msgstr ""
"Memperbaiki kondisi akses saat menyunting string sumber untuk terjemahan "
"ekabahasa."

msgid "Include output of failed add-on execution in the logs."
msgstr "Sertakan keluaran eksekusi pengaya yang gagal dalam catatan."

msgid "Improved validation of choices for adding new language."
msgstr "Meningkatkan validasi pilihan untuk menambahkan bahasa baru."

msgid "Allow to edit file format in component settings."
msgstr "Izinkan untuk menyunting format berkas dalam pengaturan komponen."

msgid "Update installation instructions to prefer Python 3."
msgstr "Perbarui petunjuk pemasangan untuk memilih Python 3."

msgid "Performance and consistency improvements for loading translations."
msgstr "Peningkatan kinerja dan konsistensi untuk memuat terjemahan."

msgid ""
"Make Microsoft Terminology service compatible with current Zeep releases."
msgstr ""
"Jadikan layanan Microsoft Terminology kompatibel dengan rilis Zeep saat ini."

msgid "Weblate 3.5"
msgstr "Weblate 3.5"

msgid "*Released on March 3rd 2019.*"
msgstr "*Dirilis pada 3 Maret 2019.*"

msgid "Improved performance of built-in translation memory."
msgstr "Meningkatkan kinerja memori terjemahan bawaan."

msgid "Added interface to manage global translation memory."
msgstr "Menambahkan antarmuka untuk mengelola memori terjemahan global."

msgid "Improved alerting on bad component state."
msgstr "Meningkatkan peringatan pada status komponen yang buruk."

msgid "Added user interface to manage whiteboard messages."
msgstr "Menambahkan antarmuka pengguna untuk mengelola pesan papan tulis."

msgid "Add-on commit message now can be configured."
msgstr "Pesan komit pengaya sekarang dapat dikonfigurasikan."

msgid "Reduce number of commits when updating upstream repository."
msgstr "Kurangi jumlah komit saat memperbarui repositori hulu."

msgid "Fixed possible metadata loss when moving component between projects."
msgstr ""
"Memperbaiki kemungkinan hilangnya metadata saat memindahkan komponen antar "
"proyek."

msgid "Improved navigation in the Zen mode."
msgstr "Meningkatkan navigasi dalam mode Zen."

msgid "Added several new quality checks (Markdown related and URL)."
msgstr ""
"Menambahkan beberapa pemeriksaan kualitas baru (terkait Markdown dan URL)."

msgid "Added support for app store metadata files."
msgstr "Menambahkan dukungan untuk berkas metadata toko aplikasi."

msgid "Added support for toggling GitHub or Gerrit integration."
msgstr "Menambahkan dukungan untuk mengubah integrasi GitHub atau Gerrit."

msgid "Added check for Kashida letters."
msgstr "Menambahkan pemeriksaan untuk surat Kashida."

msgid "Added option to squash commits based on authors."
msgstr "Menambahkan opsi untuk melumatkan komit berdasarkan penulis."

msgid "Improved support for XLSX file format."
msgstr "Meningkatkan dukungan untuk format berkas XLSX."

msgid "Compatibility with Tesseract 4.0."
msgstr "Kompatibilitas dengan Tesseract 4.0."

msgid "Billing add-on now removes projects for unpaid billings after 45 days."
msgstr ""
"Pengaya tagihan sekarang menghapus proyek untuk tagihan yang belum dibayar "
"setelah 45 hari."

msgid "Weblate 3.4"
msgstr "Weblate 3.4"

msgid "*Released on January 22nd 2019.*"
msgstr "*Dirilis pada 22 Januari 2019.*"

msgid "Added support for XLIFF placeholders."
msgstr "Menambahkan dukungan untuk pengganti XLIFF."

msgid "Celery can now utilize multiple task queues."
msgstr "Celery sekarang dapat memanfaatkan beberapa antrian tugas."

msgid "Added support for renaming and moving projects and components."
msgstr ""
"Menambahkan dukungan untuk mengganti nama dan memindahkan proyek dan "
"komponen."

msgid "Include characters counts in reports."
msgstr "Sertakan jumlah karakter dalam laporan."

msgid ""
"Added guided adding of translation components with automatic detection of "
"translation files."
msgstr ""
"Menambahkan panduan penambahan komponen terjemahan dengan deteksi otomatis "
"berkas terjemahan."

msgid "Customizable merge commit messages for Git."
msgstr "Pesan komit gabungan yang dapat disesuaikan untuk Git."

msgid "Added visual indication of component alerts in navigation."
msgstr "Menambahkan indikasi visual peringatan komponen dalam navigasi."

msgid "Improved performance of loading translation files."
msgstr "Meningkatkan kinerja pemuatan berkas terjemahan."

msgid "New add-on to squash commits prior to push."
msgstr "Pengaya baru untuk melumatkan komit sebelum mendorong."

msgid "Improved displaying of translation changes."
msgstr "Meningkatkan tampilan perubahan terjemahan."

msgid "Changed default merge style to rebase and made that configurable."
msgstr ""
"Mengubah gaya penggabungan bawaan menjadi basis ulang dan membuatnya dapat "
"dikonfigurasikan."

msgid "Better handle private use subtags in language code."
msgstr ""
"Menangani subtag penggunaan privat dalam kode bahasa dengan lebih baik."

msgid "Improved performance of fulltext index updates."
msgstr "Meningkatkan kinerja pembaruan indeks teks lengkap."

msgid "Extended file upload API to support more parameters."
msgstr ""
"API unggah berkas yang diluaskan untuk mendukung lebih banyak parameter."

msgid "Weblate 3.3"
msgstr "Weblate 3.3"

msgid "*Released on November 30th 2018.*"
msgstr "*Dirilis pada 30 November 2018.*"

msgid "Added support for component and project removal."
msgstr "Menambahkan dukungan untuk penghapusan komponen dan proyek."

msgid "Improved performance for some monolingual translations."
msgstr "Meningkatkan kinerja untuk beberapa terjemahan ekabahasa."

msgid ""
"Added translation component alerts to highlight problems with a translation."
msgstr ""
"Menambahkan peringatan komponen terjemahan untuk menyoroti masalah dengan "
"terjemahan."

msgid "Expose XLIFF string ``resname`` as context when available."
msgstr "Paparkan string XLIFF ``resname`` sebagai konteks jika tersedia."

msgid "Added support for XLIFF states."
msgstr "Menambahkan dukungan untuk status XLIFF."

msgid "Added check for non writable files in DATA_DIR."
msgstr ""
"Menambahkan pemeriksaan untuk berkas yang tidak dapat ditulis dalam DATA_DIR."

msgid "Improved CSV export for changes."
msgstr "Meningkatkan ekspor CSV untuk perubahan."

msgid "Weblate 3.2.2"
msgstr "Weblate 3.2.2"

msgid "*Released on October 20th 2018.*"
msgstr "*Dirilis pada 20 Oktober 2018.*"

msgid "Remove no longer needed Babel dependency."
msgstr "Hapus dependensi Babel yang tidak lagi diperlukan."

msgid "Updated language definitions."
msgstr "Definisi bahasa yang diperbarui."

msgid "Improve documentation for add-ons, LDAP and Celery."
msgstr "Tingkatkan dokumentasi untuk pengaya, LDAP, dan Celery."

msgid "Fixed enabling new dos-eol and auto-java-messageformat flags."
msgstr ""
"Memperbaiki pengaktifan tanda dos-eol dan auto-java-messageformat yang baru."

msgid "Fixed running setup.py test from PyPI package."
msgstr "Memperbaiki pengujian setup.py yang berjalan dari paket PyPI."

msgid "Improved plurals handling."
msgstr "Meningkatkan penanganan jamak."

msgid "Fixed translation upload API failure in some corner cases."
msgstr ""
"Memperbaiki kegagalan API pengunggahan terjemahan di beberapa kasus khusus."

msgid "Fixed updating Git configuration in case it was changed manually."
msgstr "Memperbaiki pembaruan konfigurasi Git jika diubah secara manual."

msgid "Weblate 3.2.1"
msgstr "Weblate 3.2.1"

msgid "*Released on October 10th 2018.*"
msgstr "*Dirilis pada 10 Oktober 2018.*"

msgid "Document dependency on backports.csv on Python 2.7."
msgstr "Dependensi dokumen pada backports.csv pada Python 2.7."

msgid "Fix running tests under root."
msgstr "Perbaiki pengujian yang berjalan di bawah root."

msgid "Improved error handling in gitexport module."
msgstr "Meningkatkan penanganan galat dalam modul gitexport."

msgid "Fixed progress reporting for newly added languages."
msgstr "Memperbaiki pelaporan progres untuk bahasa yang baru ditambahkan."

msgid "Correctly report Celery worker errors to Sentry."
msgstr "Laporkan galat pekerja Celery ke Sentry."

msgid "Fixed creating new translations with Qt Linguist."
msgstr "Memperbaiki pembuatan terjemahan baru dengan Qt Linguist."

msgid "Fixed occasional fulltext index update failures."
msgstr ""
"Memperbaiki kegagalan pembaruan indeks teks lengkap yang kadang terjadi."

msgid "Improved validation when creating new components."
msgstr "Meningkatkan validasi saat membuat komponen baru."

msgid "Added support for cleanup of old suggestions."
msgstr "Menambahkan dukungan untuk pembersihan saran lama."

msgid "Weblate 3.2"
msgstr "Weblate 3.2"

msgid "*Released on October 6th 2018.*"
msgstr "*Dirilis pada 6 Oktober 2018.*"

msgid "Add install_addon management command for automated add-on installation."
msgstr ""
"Menambahkan perintah pengelolaan install_addon untuk pemasangan pengaya "
"secara otomatis."

msgid "Allow more fine grained :ref:`rate-limit` settings."
msgstr "Izinkan pengaturan :ref:`rate-limit` yang lebih rinci."

msgid "Added support for export and import of Excel files."
msgstr "Menambahkan dukungan untuk ekspor dan impor berkas Excel."

msgid ""
"Improve component cleanup in case of multiple component discovery add-ons."
msgstr ""
"Memperbaiki pembersihan komponen jika terdapat beberapa pengaya penemuan "
"komponen."

msgid "Rewritten Microsoft Terminology machine translation backend."
msgstr "Backend terjemahan mesin Microsoft Terminology yang ditulis ulang."

msgid "Weblate now uses Celery to offload some processing."
msgstr ""
"Weblate sekarang menggunakan Celery untuk memindahkan sebagian pemrosesan."

msgid "Improved search capabilities and added regular expression search."
msgstr ""
"Meningkatkan kemampuan pencarian dan penambahan pencarian ekspresi reguler."

msgid "Added support for Youdao Zhiyun API machine translation."
msgstr "Menambahkan dukungan untuk terjemahan mesin API Youdao Zhiyun."

msgid "Added support for Baidu API machine translation."
msgstr "Menambahkan dukungan untuk terjemahan mesin API Baidu."

msgid "Integrated maintenance and cleanup tasks using Celery."
msgstr ""
"Tugas pemeliharaan dan pembersihan yang diintegrasikan menggunakan Celery."

msgid "Improved performance of loading translations by almost 25%."
msgstr "Meningkatkan kinerja pemuatan terjemahan hampir 25%."

msgid "Removed support for merging headers on upload."
msgstr "Menghapus dukungan untuk menggabungkan kepala saat diunggah."

msgid "Removed support for custom commit messages."
msgstr "Menghapus dukungan untuk pesan komit kustom."

msgid "Configurable editing mode (zen/full)."
msgstr "Mode penyuntingan yang dapat dikonfigurasikan (zen/full)."

msgid "Added support for error reporting to Sentry."
msgstr "Menambahkan dukungan untuk pelaporan galat ke Sentry."

msgid "Added support for automated daily update of repositories."
msgstr "Menambahkan dukungan untuk pembaruan repositori harian otomatis."

msgid "Added support for creating projects and components by users."
msgstr "Menambahkan dukungan untuk membuat proyek dan komponen oleh pengguna."

msgid "Built-in translation memory now automatically stores translations done."
msgstr ""
"Memori terjemahan internal sekarang secara otomatis menyimpan terjemahan "
"yang sudah selesai."

msgid "Users and projects can import their existing translation memories."
msgstr "Pengguna dan proyek dapat mengimpor memori terjemahan yang ada."

msgid "Better management of related strings for screenshots."
msgstr "Pengelolaan string terkait yang lebih baik untuk tangkapan layar."

msgid "Added support for checking Java MessageFormat."
msgstr "Menambahkan dukungan untuk memeriksa Java MessageFormat."

msgid ""
"See `3.2 milestone on GitHub <https://github.com/WeblateOrg/weblate/"
"milestone/36?closed=1>`_ for detailed list of addressed issues."
msgstr ""
"Lihat `tonggak sejarah 3.2 di GitHub <https://github.com/WeblateOrg/weblate/"
"milestone/36?closed=1>`_ untuk daftar terperinci isu yang ditangani."

msgid "Weblate 3.1.1"
msgstr "Weblate 3.1.1"

msgid "*Released on July 27th 2018.*"
msgstr "*Dirilis pada 27 Juli 2018.*"

msgid "Fix testsuite failure on some setups."
msgstr "Memperbaiki kegagalan rangkaian pengujian pada beberapa pengaturan."

msgid "Weblate 3.1"
msgstr "Weblate 3.1"

msgid "Upgrades from older version than 3.0.1 are not supported."
msgstr "Peningkatan dari versi lama sebelum 3.0.1 tidak didukung."

msgid "Allow to override default commit messages from settings."
msgstr "Izinkan untuk menimpakan pesan komit bawaan dari pengaturan."

msgid "Improve webhooks compatibility with self hosted environments."
msgstr ""
"Meningkatkan kompatibilitas kait web dengan lingkungan yang dihos sendiri."

msgid "Added support for Amazon Translate."
msgstr "Menambahkan dukungan untuk Amazon Translate."

msgid "Compatibility with Django 2.1."
msgstr "Kompatibilitas dengan Django 2.1."

msgid ""
"Django system checks are now used to diagnose problems with installation."
msgstr ""
"Pemeriksaan sistem Django sekarang digunakan untuk mendiagnosis masalah "
"dengan pemasangan."

msgid "Removed support for soon shutdown libravatar service."
msgstr "Menghapus dukungan untuk segera menutup layanan libravatar."

msgid "New add-on to mark unchanged translations as needing edit."
msgstr ""
"Pengaya baru untuk menandai terjemahan yang tidak berubah karena perlu "
"disunting."

msgid "Add support for jumping to specific location while translating."
msgstr ""
"Tambahkan dukungan untuk melompat ke lokasi tertentu saat menerjemahkan."

msgid "Downloaded translations can now be customized."
msgstr "Terjemahan yang diunduh sekarang dapat disesuaikan."

msgid ""
"Improved calculation of string similarity in translation memory matches."
msgstr ""
"Meningkatkan perhitungan kesamaan string dalam pencocokan memori terjemahan."

msgid "Added support by signing Git commits by GnuPG."
msgstr "Menambahkan dukungan dengan menandatangani komit Git oleh GnuPG."

msgid "Weblate 3.0.1"
msgstr "Weblate 3.0.1"

msgid "*Released on June 10th 2018.*"
msgstr "*Dirilis pada 10 Juni 2018.*"

msgid "Fixed possible migration issue from 2.20."
msgstr "Memperbaiki kemungkinan isu migrasi dari 2.20."

msgid "Removed obsolete hook examples."
msgstr "Menghapus contoh kait yang usang."

msgid "Improved caching documentation."
msgstr "Meningkatkan dokumentasi penyimpanan."

msgid "Fixed displaying of admin documentation."
msgstr "Memperbaiki tampilan dokumentasi admin."

msgid "Improved handling of long language names."
msgstr "Meningkatkan penanganan nama bahasa yang panjang."

msgid "Weblate 3.0"
msgstr "Weblate 3.0"

msgid "*Released on June 1st 2018.*"
msgstr "*Dirilis pada 1 Juni 2018.*"

msgid "Rewritten access control."
msgstr "Kontrol akses yang ditulis ulang."

msgid "Several code cleanups that lead to moved and renamed modules."
msgstr ""
"Beberapa pembersihan kode yang mengarah pada pemindahan dan penggantian nama "
"modul."

msgid "New add-on for automatic component discovery."
msgstr "Pengaya baru untuk penemuan komponen secara otomatis."

msgid ""
"The import_project management command has now slightly different parameters."
msgstr ""
"Perintah pengelolaan import_project sekarang memiliki parameter yang sedikit "
"berbeda."

msgid "Added basic support for Windows RC files."
msgstr "Menambahkan dukungan dasar untuk berkas Windows RC."

msgid "New add-on to store contributor names in PO file headers."
msgstr "Pengaya baru untuk menyimpan nama kontributor di kepala berkas PO."

msgid "The per component hook scripts are removed, use add-ons instead."
msgstr "Skrip pengait per komponen dihapus, gunakan pengaya sebagai gantinya."

msgid "Add support for collecting contributor agreements."
msgstr "Tambahkan dukungan untuk mengumpulkan perjanjian kontributor."

msgid "Access control changes are now tracked in history."
msgstr "Perubahan kontrol akses sekarang dilacak dalam riwayat."

msgid ""
"New add-on to ensure all components in a project have same translations."
msgstr ""
"Pengaya baru untuk memastikan semua komponen dalam sebuah proyek memiliki "
"terjemahan yang sama."

msgid "Support for more variables in commit message templates."
msgstr "Dukungan untuk lebih banyak variabel dalam templat pesan komit."

msgid "Add support for providing additional textual context."
msgstr "Tambahkan dukungan untuk menyediakan konteks tekstual tambahan."

msgid "Weblate 4.x series"
msgstr "Seri Weblate 4.x"

msgid "Weblate 4.18.2"
msgstr "Weblate 4.18.2"

msgid "*Released on June 30th 2023.*"
msgstr "*Dirilis pada 30 Juni 2023.*"

msgid "Fixed parsing notes from TBX."
msgstr "Memperbaiki catatan penguraian dari TBX."

msgid "Fixed query parsing in navigation bar search."
msgstr "Memperbaiki penguraian kueri pada pencarian di bilah navigasi."

msgid "Fixed language filtering in reports."
msgstr "Memperbaiki pemfilteran bahasa dalam laporan."

msgid "Improved ModernMT languages mapping."
msgstr "Meningkatkan pemetaan bahasa ModernMT."

msgid "Disabled reused checks on languages with a single plural form."
msgstr ""
