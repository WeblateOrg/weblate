msgid "Weblate 3.3"
msgstr "வலைபெயர்ப்பு 3.3"

#: changes/v3.rst:382
msgid "*Released on November 30th 2018.*"
msgstr "*நவம்பர் 30, 2018 அன்று வெளியிடப்பட்டது.*"

#: changes/v3.rst:384
