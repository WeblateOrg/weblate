msgstr "Типичный :ref:`component` Weblate для двуязычного XLIFF"

msgid "`XLIFF Translation File`"
msgstr "`Файл перевода XLIFF`"

msgid "Typical Weblate :ref:`component` for monolingual XLIFF"
msgstr "Типичный :ref:`component` Weblate для одноязычного XLIFF"

msgid "XLIFF 2.0"
msgstr "XLIFF 2.0"

