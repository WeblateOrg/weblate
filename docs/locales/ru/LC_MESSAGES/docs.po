msgstr "Функция Weblate"

msgid "ASGI server for Weblate"
msgstr "ASGI-сервер для Weblate"

msgid ":ref:`mt-google-translate-api-v3` with glossary support"
msgstr ":ref:`mt-google-translate-api-v3` с поддержкой словаря"

msgid "PostgreSQL, see :ref:`database-setup`"
msgstr "PostgreSQL, см. :ref:`database-setup`"

