msgstr "Приглашайте и управляйте пользователями"

msgid "Invite translators"
msgstr "Пригласите переводчиков"

msgid "For **Protected** and **Private** projects:"
msgstr "Для проектов **Защищённый** и **Частный**:"

msgid "Navigate to :guilabel:`Operations` → :guilabel:`Users` in your project"
msgstr ""
"Перейдите в :guilabel:`Управление` → :guilabel:`Пользователи` в вашем проекте"

msgid "Use :guilabel:`Add user` to invite translators"
msgstr ""
"Используйте :guilabel:`Добавить пользователя` для приглашения переводчиков"

msgid "Assign them to appropriate teams:"
msgstr "Назначьте их соответствующим командам:"

