msgstr "Интеграция SAML 2 IDP в Weblate"

msgid ":pypi:`Sphinx`"
msgstr ":pypi:`Sphinx`"

msgid "Needed for :ref:`addon-weblate.gettext.sphinx`"
msgstr "Необходимо для :ref:`addon-weblate.gettext.sphinx`"

