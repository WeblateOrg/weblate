msgid "json_use_compact_separators"
msgstr "json_use_compact_separators"

msgid "Avoid spaces after separators"
msgstr "Избегайте пробелов после разделителей"

msgid "line_max_length"
msgstr "line_max_length"

msgid "Maximum line length"
msgstr "Максимальная длина линии"

msgid "The maximum number of characters for each line in the output file."
msgstr "Максимальное количество символов для каждой строки в выходном файле."

msgid "md_extract_code_blocks"
msgstr "md_extract_code_blocks"

msgid "Extract code blocks"
msgstr "Извлечение блоков кода"

msgid ""
"Whether to extract translatable content from code blocks in Markdown and MDX "
"files."
msgstr ""
"Следует ли извлекать переводимое содержимое из блоков кода в файлах Markdown "
"и MDX."

msgid "md_extract_frontmatter"
msgstr "md_extract_frontmatter"

msgid "Extract front matter"
msgstr "Извлечение фронтматтера"

msgid ""
"Whether to extract and translate YAML front matter blocks in Markdown and "
"MDX files."
msgstr ""
"Следует ли извлекать и переводить блоки YAML-фронтматтера в файлах Markdown "
"и MDX."

msgid "md_frontmatter_translate_values"
msgstr "md_frontmatter_translate_values"

msgid "Translate front matter values"
msgstr "Переводить значения front matter"

msgid ""
"Parse YAML front matter and translate only scalar string values. Keys, "
"structure, comments, and formatting are preserved when possible."
msgstr ""
"Анализировать YAML front matter и переводить только скалярные строковые "
"значения. Ключи, структура, комментарии и форматирование сохраняются, когда "
"это возможно."

msgid "md_no_placeholders"
msgstr "md_no_placeholders"

msgid "Disable placeholders"
msgstr "Отключить заполнители"

msgid ""
"Disables detection and processing of placeholders in Markdown and MDX files."
msgstr ""
"Отключает обнаружение и обработку заполнителей в файлах Markdown и MDX."

msgid "merge_duplicates"
msgstr "merge_duplicates"

msgid "Deduplicate identical strings"
msgstr "Удаление дубликатов идентичных строк"

msgid ""
"Consolidates identical source strings into a single translation unit. "
"Prevents translation loss during file restructuring or table reordering by "
"removing position-dependent context."
msgstr ""
"Объединяет идентичные исходные строки в одну единицу перевода. Предотвращает "
"потерю перевода при реструктуризации файлов или переупорядочивании таблиц "
"путём удаления контекста, зависящего от положения."

msgid "po_fuzzy_matching"
msgstr "po_fuzzy_matching"

msgid "Use fuzzy matching"
msgstr "Использовать неточное соответствие"

msgid "po_keep_previous"
msgstr "po_keep_previous"

msgid "Keep previous msgids of translated strings"
msgstr "Сохранять предыдущие msgid переведённых строк"

msgid "Controls previous msgid comments for fuzzy strings."
msgstr "Управляет комментариями предыдущего msgid для нечётких строк."

msgid "po_line_wrap"
msgstr "po_line_wrap"

msgid "Long lines wrapping"
msgstr "Перенос длинных строк"

msgid ""
"By default, gettext wraps lines at 77 characters and at newlines. With the "
"``--no-wrap`` parameter, wrapping is only done at newlines."
msgstr ""
"По умолчанию gettext переносит строки на 77 символах и на символах новой "
"строки. С параметром ``--no-wrap`` перенос выполняется только на символах "
"новой строки."

msgid "Wrap lines at 77 characters and at newlines (xgettext default)"
msgstr ""
"Переносить строки на 77-м символе и на символе перевода строки (по умолчанию "
"в xgettext)"

msgid "Only wrap lines at newlines (like ``xgettext --no-wrap``)"
msgstr ""
"Переносить строки только на символах новой строки (как ``xgettext --no-"
"wrap``)"

msgid "No line wrapping"
msgstr "Не переносить строки"

msgid "po_no_location"
msgstr "po_no_location"

msgid "Do not include location information in the file"
msgstr "Не включайте в файл информацию о местоположении"

msgid "po_remove_obsolete"
msgstr "po_remove_obsolete"

msgid "Remove obsolete strings"
msgstr "Удалить устаревшие строки"

msgid ""
"Remove obsolete entries from PO files when saving translation changes or "
"updating from a POT file."
msgstr ""
"Удалять устаревшие записи из PO-файлов при сохранении изменений перевода или "
"обновлении из POT-файла."

msgid "po_report_msgid_bugs_to"
msgstr "po_report_msgid_bugs_to"

msgid "Report msgid bugs to"
msgstr "Сообщение об ошибках msgid"

msgid ""
"Lets Weblate update the \"Report-Msgid-Bugs-To\" file header if Source "
"string bug reporting address is set."
msgstr ""
"Позволяет Weblate обновлять заголовок «Report-Msgid-Bugs-To» в файле, если "
"задан адрес сообщения об ошибке в исходной строке."

msgid "po_set_language_team"
msgstr "po_set_language_team"

msgid "Update language team header"
msgstr "Обновление заголовка языковой команды"

msgid "Lets Weblate update the \"Language-Team\" file header."
msgstr "Позволяет Weblate обновить заголовок «Language-Team» в файле."

msgid "po_set_last_translator"
msgstr "po_set_last_translator"

msgid "Update last translator header"
msgstr "Обновление заголовка последнего переводчика"

msgid "Lets Weblate update the \"Last-Translator\" file header."
msgstr "Позволяет Weblate обновлять заголовок «Last-Translator» в файле."

msgid "po_set_x_generator"
msgstr "po_set_x_generator"

msgid "Update X-Generator header"
msgstr "Обновить заголовок X-Generator"

msgid "Lets Weblate update the \"X-Generator\" file header."
msgstr "Позволяет Weblate обновлять заголовок «X-Generator» в файле."

