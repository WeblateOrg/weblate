{
  "$id": "https://weblate.org/schemas/weblate-userdata.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$defs": {},
  "title": "Weblate user data export",
  "required": [
    "basic",
    "profile",
    "auditlog"
  ],
  "properties": {
    "basic": {
      "title": "Basic",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "username",
        "full_name",
        "email",
        "date_joined"
      ],
      "properties": {
        "username": {
          "title": "Username",
          "type": "string",
          "default": "",
          "examples": [
            "admin"
          ]
        },
        "full_name": {
          "title": "Full name",
          "type": "string",
          "default": "",
          "examples": [
            "Weblate Admin"
          ]
        },
        "email": {
          "title": "E-mail",
          "type": "string",
          "format": "email",
          "default": "",
          "examples": [
            "noreply@example.com"
          ]
        },
        "date_joined": {
          "title": "Date joined",
          "type": "string",
          "format": "date-time",
          "default": "",
          "examples": [
            "2019-11-18T18:53:54.862Z"
          ]
        }
      }
    },
    "profile": {
      "title": "Profile",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "suggested",
        "translated",
        "uploaded",
        "hide_completed",
        "secondary_in_zen",
        "hide_source_secondary",
        "editor_link",
        "translate_mode",
        "zen_mode",
        "special_chars",
        "dashboard_view",
        "dashboard_component_list",
        "languages",
        "secondary_languages",
        "watched"
      ],
      "properties": {
        "language": {
          "title": "Language",
          "type": "string",
          "default": "",
          "examples": [
            "cs"
          ],
          "pattern": "^[^ ]*$"
        },
        "suggested": {
          "title": "Number of suggested strings",
          "type": "integer",
          "examples": [
            1
          ],
          "default": 0
        },
        "translated": {
          "title": "Number of translated strings",
          "type": "integer",
          "examples": [
            24
          ],
          "default": 0
        },
        "uploaded": {
          "title": "Number of uploaded screenshots",
          "type": "integer",
          "examples": [
            1
          ],
          "default": 0
        },
        "hide_completed": {
          "title": "Hide completed translations on the dashboard",
          "type": "boolean",
          "examples": [
            false
          ],
          "default": true
        },
        "secondary_in_zen": {
          "title": "Show secondary translations in the Zen mode",
          "type": "boolean",
          "examples": [
            true
          ],
          "default": true
        },
        "hide_source_secondary": {
          "title": "Hide source if a secondary translation exists",
          "type": "boolean",
          "examples": [
            false
          ],
          "default": true
        },
        "wide_tables": {
          "title": "Show all columns in lists using horizontal scrolling",
          "type": "boolean",
          "examples": [
            false
          ],
          "default": false
        },
        "listing_columns": {
          "title": "Visible columns in lists",
          "type": "array",
          "default": [
            "untranslated",
            "untranslated_words",
            "untranslated_chars",
            "nottranslated",
            "checks",
            "suggestions",
            "comments"
          ],
          "items": {
            "title": "Column",
            "type": "string",
            "enum": [
              "total",
              "untranslated",
              "untranslated_words",
              "untranslated_chars",
              "nottranslated",
              "checks",
              "suggestions",
              "comments"
            ],
            "examples": [
              "checks"
            ]
          }
        },
        "editor_link": {
          "title": "Editor link",
          "type": "string",
          "default": "",
          "examples": [
            ""
          ],
          "pattern": "^.*$"
        },
        "translate_mode": {
          "title": "Translation editor mode",
          "type": "integer",
          "examples": [
            0
          ],
          "default": 0
        },
        "zen_mode": {
          "title": "Zen editor mode",
          "type": "integer",
          "examples": [
            0
          ],
          "default": 0
        },
        "special_chars": {
          "title": "Special characters",
          "type": "string",
          "default": "",
          "examples": [
            "  "
          ],
          "pattern": "^.*$"
        },
        "theme": {
          "title": "Theme",
          "type": "string",
          "default": "auto",
          "examples": [
            "auto"
          ],
          "pattern": "^(auto|dark|light)$"
        },
        "dashboard_view": {
          "title": "Default dashboard view",
          "type": "integer",
          "examples": [
            1
          ],
          "default": 0
        },
        "dashboard_component_list": {
          "title": "Default component list",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer"
            }
          ],
          "default": null
        },
        "languages": {
          "title": "Translated languages",
          "type": "array",
          "default": [],
          "items": {
            "title": "Language code",
            "type": "string",
            "default": "",
            "examples": [
              "cs"
            ],
            "pattern": "^.*$"
          }
        },
        "secondary_languages": {
          "title": "Secondary languages",
          "type": "array",
          "default": [],
          "items": {
            "title": "Language code",
            "type": "string",
            "default": "",
            "examples": [
              "sk"
            ],
            "pattern": "^.*$"
          }
        },
        "watched": {
          "title": "Watched projects",
          "type": "array",
          "default": [],
          "items": {
            "title": "Project slug",
            "type": "string",
            "default": "",
            "examples": [
              "weblate"
            ],
            "pattern": "^.*$"
          }
        },
        "website": {
          "title": "Website URL",
          "type": "string"
        },
        "contact": {
          "title": "Contact URL",
          "type": "string"
        },
        "liberapay": {
          "title": "Liberapay username",
          "type": "string"
        },
        "fediverse": {
          "title": "Fediverse URL",
          "type": "string"
        },
        "codesite": {
          "title": "Code site URL",
          "type": "string"
        },
        "github": {
          "title": "GitHub username",
          "type": "string"
        },
        "twitter": {
          "title": "X username",
          "type": "string"
        },
        "linkedin": {
          "title": "LinkedIn profile name",
          "type": "string"
        },
        "location": {
          "title": "Location",
          "type": "string"
        },
        "company": {
          "title": "Company",
          "type": "string"
        },
        "public_email": {
          "title": "Public email",
          "type": "string"
        },
        "commit_email": {
          "title": "Commit email",
          "type": "string"
        },
        "nearby_strings": {
          "title": "Number of nearby strings",
          "type": "integer"
        },
        "commit_name": {
          "title": "Commit name choice",
          "type": "integer"
        },
        "auto_watch": {
          "title": "Automatically watch projects",
          "type": "boolean"
        },
        "contribute_personal_tm": {
          "title": "Contribute to personal translation memory",
          "type": "boolean"
        },
        "commented": {
          "title": "Number of commented strings",
          "type": "integer"
        },
        "last_2fa": {
          "title": "Last used two-factor method",
          "type": "string"
        }
      }
    },
    "auditlog": {
      "title": "Audit log",
      "type": "array",
      "default": [],
      "items": {
        "title": "Items",
        "type": "object",
        "required": [
          "address",
          "user_agent",
          "timestamp",
          "activity"
        ],
        "additionalProperties": false,
        "properties": {
          "address": {
            "title": "IP address",
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "default": "",
                "examples": [
                  "127.0.0.1"
                ],
                "pattern": "^.*$"
              }
            ]
          },
          "user_agent": {
            "title": "User agent",
            "type": "string",
            "default": "",
            "examples": [
              "PC / Linux / Firefox 70.0"
            ],
            "pattern": "^.*$"
          },
          "timestamp": {
            "title": "Timestamp",
            "type": "string",
            "format": "date-time",
            "default": "",
            "examples": [
              "2019-11-18T18:58:30.845Z"
            ]
          },
          "activity": {
            "title": "Activity",
            "type": "string",
            "default": "",
            "examples": [
              "login"
            ],
            "pattern": "^.*$"
          }
        }
      }
    },
    "notifications": {
      "title": "General notification settings",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "notification",
          "scope",
          "frequency",
          "project",
          "component",
          "onetime"
        ],
        "properties": {
          "notification": {
            "type": "string"
          },
          "scope": {
            "type": "integer"
          },
          "frequency": {
            "type": "integer"
          },
          "project": {
            "title": "Project slug",
            "type": [
              "string",
              "null"
            ]
          },
          "component": {
            "title": "Component path",
            "type": [
              "string",
              "null"
            ]
          },
          "onetime": {
            "title": "One-time notification",
            "type": "boolean"
          }
        }
      }
    },
    "saved_searches": {
      "title": "User saved searches",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "query",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "query": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  }
}
