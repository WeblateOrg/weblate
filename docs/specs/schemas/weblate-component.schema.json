{
  "$id": "https://weblate.org/schemas/weblate-component.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$defs": {},
  "title": "Weblate component backup",
  "additionalProperties": false,
  "required": [
    "component",
    "translations",
    "units",
    "screenshots"
  ],
  "properties": {
    "component": {
      "title": "Component configuration",
      "type": "object",
      "required": [
        "name",
        "slug",
        "vcs",
        "repo",
        "push",
        "repoweb",
        "report_source_bugs",
        "branch",
        "push_branch",
        "filemask",
        "template",
        "edit_template",
        "intermediate",
        "new_base",
        "file_format",
        "locked",
        "allow_translation_propagation",
        "enable_suggestions",
        "suggestion_voting",
        "suggestion_autoaccept",
        "check_flags",
        "enforced_checks",
        "license",
        "agreement",
        "new_lang",
        "language_code_style",
        "manage_units",
        "merge_style",
        "commit_message",
        "add_message",
        "delete_message",
        "merge_message",
        "addon_message",
        "pull_message",
        "push_on_commit",
        "commit_pending_age",
        "auto_lock_error",
        "source_language",
        "language_regex",
        "variant_regex",
        "priority",
        "restricted",
        "is_glossary",
        "glossary_color",
        "remote_revision",
        "local_revision"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Project name",
          "type": "string",
          "default": "",
          "examples": [
            "Hello"
          ]
        },
        "slug": {
          "title": "URL slug",
          "type": "string",
          "default": "",
          "examples": [
            "hello"
          ]
        },
        "category": {
          "title": "Full category URL slug excluding the project slug",
          "type": "string",
          "default": "",
          "examples": [
            "my-category",
            "my-category/my-subcategory"
          ]
        },
        "vcs": {
          "title": "Version control system",
          "type": "string"
        },
        "vcs_params": {
          "title": "Version control parameters",
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "integer",
              "boolean"
            ]
          },
          "default": {}
        },
        "repo": {
          "title": "Source code repository",
          "type": "string"
        },
        "push": {
          "title": "Repository push URL",
          "type": "string"
        },
        "repoweb": {
          "title": "Repository browser",
          "type": "string"
        },
        "repoweb_translations": {
          "title": "Repository browser for translations",
          "type": "string",
          "default": ""
        },
        "report_source_bugs": {
          "title": "Source string bug reporting address",
          "type": "string",
          "oneOf": [
            {
              "enum": [
                ""
              ]
            },
            {
              "format": "email"
            }
          ]
        },
        "branch": {
          "title": "Repository branch",
          "type": "string"
        },
        "push_branch": {
          "title": "Push branch",
          "type": "string"
        },
        "filemask": {
          "title": "File mask",
          "type": "string"
        },
        "screenshot_filemask": {
          "title": "Screenshot file mask",
          "type": "string",
          "default": ""
        },
        "template": {
          "title": "Monolingual base language file",
          "type": "string"
        },
        "edit_template": {
          "title": "Edit base file",
          "type": "boolean"
        },
        "intermediate": {
          "title": "Intermediate language file",
          "type": "string"
        },
        "new_base": {
          "title": "Template for new translations",
          "type": "string"
        },
        "file_format": {
          "title": "File format",
          "type": "string"
        },
        "file_format_params": {
          "title": "File format parameters",
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "integer",
              "boolean"
            ]
          },
          "default": {}
        },
        "locked": {
          "title": "Locked",
          "type": "boolean"
        },
        "hide_glossary_matches": {
          "title": "Do not show glossary matches",
          "type": "boolean",
          "default": false
        },
        "allow_translation_propagation": {
          "title": "Allow translation propagation",
          "type": "boolean"
        },
        "contribute_project_tm": {
          "title": "Contribute to project translation memory",
          "type": "boolean",
          "default": true
        },
        "enable_suggestions": {
          "title": "Turn on suggestions",
          "type": "boolean"
        },
        "suggestion_voting": {
          "title": "Suggestion voting",
          "type": "boolean"
        },
        "suggestion_autoaccept": {
          "title": "Autoaccept suggestions",
          "type": "integer"
        },
        "check_flags": {
          "title": "Translation flags",
          "type": "string"
        },
        "enforced_checks": {
          "title": "",
          "type": "array",
          "items": {
            "title": "Check name",
            "type": "string"
          }
        },
        "license": {
          "title": "Translation license",
          "type": "string"
        },
        "agreement": {
          "title": "Contributor agreement",
          "type": "string"
        },
        "new_lang": {
          "title": "Adding new translation",
          "type": "string"
        },
        "language_code_style": {
          "title": "Language code style",
          "type": "string"
        },
        "secondary_language": {
          "title": "Secondary language code",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "inherit_license": {
          "title": "Inherit translation license",
          "type": "boolean",
          "default": false
        },
        "inherit_agreement": {
          "title": "Inherit contributor agreement",
          "type": "boolean",
          "default": false
        },
        "inherit_new_lang": {
          "title": "Inherit adding new translation",
          "type": "boolean",
          "default": false
        },
        "inherit_language_code_style": {
          "title": "Inherit language code style",
          "type": "boolean",
          "default": false
        },
        "inherit_secondary_language": {
          "title": "Inherit secondary language",
          "type": "boolean",
          "default": false
        },
        "inherit_enforced_checks": {
          "title": "Inherit enforced checks",
          "type": "boolean",
          "default": false
        },
        "inherit_commit_message": {
          "title": "Inherit commit message when translating",
          "type": "boolean",
          "default": false
        },
        "inherit_add_message": {
          "title": "Inherit commit message when adding translation",
          "type": "boolean",
          "default": false
        },
        "inherit_delete_message": {
          "title": "Inherit commit message when removing translation",
          "type": "boolean",
          "default": false
        },
        "inherit_merge_message": {
          "title": "Inherit commit message when merging translation",
          "type": "boolean",
          "default": false
        },
        "inherit_addon_message": {
          "title": "Inherit commit message when add-on makes a change",
          "type": "boolean",
          "default": false
        },
        "inherit_pull_message": {
          "title": "Inherit merge request message",
          "type": "boolean",
          "default": false
        },
        "manage_units": {
          "title": "Manage strings",
          "type": "boolean"
        },
        "merge_style": {
          "title": "Merge style",
          "type": "string",
          "enum": [
            "merge",
            "rebase",
            "merge_noff"
          ]
        },
        "commit_message": {
          "title": "Commit message when translating",
          "type": "string"
        },
        "add_message": {
          "title": "Commit message when adding translation",
          "type": "string"
        },
        "delete_message": {
          "title": "Commit message when removing translation",
          "type": "string"
        },
        "merge_message": {
          "title": "Commit message when merging translation",
          "type": "string"
        },
        "addon_message": {
          "title": "Commit message when add-on makes a change",
          "type": "string"
        },
        "pull_message": {
          "title": "Merge request message",
          "type": "string"
        },
        "push_on_commit": {
          "title": "Push on commit",
          "type": "boolean"
        },
        "push_on_update": {
          "title": "Push on update",
          "type": "boolean",
          "default": true
        },
        "commit_pending_age": {
          "title": "Age of changes to commit",
          "type": "integer"
        },
        "auto_lock_error": {
          "title": "Lock on error",
          "type": "boolean"
        },
        "source_language": {
          "title": "Source language code",
          "type": "string"
        },
        "language_regex": {
          "title": "Language filter",
          "type": "string"
        },
        "key_filter": {
          "title": "Key filter",
          "type": "string",
          "default": ""
        },
        "variant_regex": {
          "title": "Variants regular expression",
          "type": "string"
        },
        "priority": {
          "title": "Priority",
          "type": "integer"
        },
        "restricted": {
          "title": "Restricted component",
          "type": "boolean"
        },
        "is_glossary": {
          "title": "Use as a glossary",
          "type": "boolean"
        },
        "glossary_color": {
          "title": "Glossary color",
          "type": "string"
        },
        "remote_revision": {
          "title": "Remote revision",
          "type": "string",
          "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})?$(?![\\s\\S])"
        },
        "local_revision": {
          "title": "Local revision",
          "type": "string",
          "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})?$(?![\\s\\S])"
        }
      }
    },
    "translations": {
      "title": "Translation data",
      "type": "array",
      "default": [],
      "items": {
        "title": "Items",
        "type": "object",
        "required": [
          "id",
          "language_code",
          "plural",
          "revision",
          "filename"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "title": "Primary key",
            "type": "integer"
          },
          "filename": {
            "title": "Filename",
            "type": "string"
          },
          "language_code": {
            "title": "Language code",
            "type": "string"
          },
          "plural": {
            "title": "Plural definition",
            "type": "object",
            "required": [
              "source",
              "number",
              "formula",
              "type"
            ],
            "additionalProperties": false,
            "properties": {
              "source": {
                "title": "Plural definition source",
                "type": "integer"
              },
              "number": {
                "title": "Number of plurals",
                "type": "integer"
              },
              "formula": {
                "title": "Plural formula",
                "type": "string"
              },
              "type": {
                "title": "Plural type",
                "type": "integer"
              }
            }
          },
          "revision": {
            "title": "File revision",
            "type": "string",
            "pattern": "^(?:[0-9a-f]{40}(?::[0-9]+)?(?:,[0-9a-f]{40}){0,2})?$(?![\\s\\S])"
          },
          "check_flags": {
            "title": "Translation flags",
            "type": "string"
          }
        }
      }
    },
    "units": {
      "title": "Unit data",
      "type": "array",
      "items": {
        "title": "Unit data",
        "type": "object",
        "required": [
          "translation_id",
          "id_hash",
          "location",
          "context",
          "note",
          "flags",
          "source",
          "previous_source",
          "target",
          "state",
          "original_state",
          "details",
          "position",
          "num_words",
          "priority",
          "timestamp",
          "extra_flags",
          "explanation",
          "labels",
          "comments",
          "checks",
          "suggestions"
        ],
        "additionalProperties": false,
        "properties": {
          "translation_id": {
            "title": "",
            "type": "integer"
          },
          "id_hash": {
            "title": "",
            "pattern": "^[0-9a-f]{16}$(?![\\s\\S])",
            "type": "string"
          },
          "location": {
            "title": "",
            "type": "string"
          },
          "context": {
            "title": "",
            "type": "string"
          },
          "note": {
            "title": "",
            "type": "string"
          },
          "flags": {
            "title": "",
            "type": "string"
          },
          "source": {
            "title": "",
            "type": "string"
          },
          "previous_source": {
            "title": "",
            "type": "string"
          },
          "target": {
            "title": "",
            "type": "string"
          },
          "state": {
            "title": "",
            "type": "integer"
          },
          "original_state": {
            "title": "",
            "type": "integer"
          },
          "details": {
            "title": "",
            "type": "object"
          },
          "position": {
            "title": "",
            "type": "integer"
          },
          "num_words": {
            "title": "",
            "type": "integer"
          },
          "priority": {
            "title": "",
            "type": "integer"
          },
          "pending": {
            "title": "",
            "type": "boolean"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "default": "",
            "examples": [
              "2019-11-18T18:53:54.862Z"
            ]
          },
          "extra_flags": {
            "title": "",
            "type": "string"
          },
          "explanation": {
            "title": "",
            "type": "string"
          },
          "labels": {
            "title": "",
            "type": "array",
            "items": {
              "title": "Unit labels",
              "type": "string"
            }
          },
          "comments": {
            "title": "",
            "type": "array",
            "items": {
              "title": "Unit comments",
              "type": "object",
              "required": [
                "user",
                "comment",
                "timestamp",
                "resolved"
              ],
              "additionalProperties": false,
              "properties": {
                "user": {
                  "type": "string"
                },
                "comment": {
                  "type": "string"
                },
                "timestamp": {
                  "type": "string",
                  "format": "date-time",
                  "default": "",
                  "examples": [
                    "2019-11-18T18:53:54.862Z"
                  ]
                },
                "resolved": {
                  "type": "boolean"
                }
              }
            }
          },
          "checks": {
            "title": "",
            "type": "array",
            "items": {
              "title": "Unit checks",
              "type": "object",
              "required": [
                "name",
                "dismissed"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "dismissed": {
                  "type": "boolean"
                }
              }
            }
          },
          "suggestions": {
            "title": "",
            "type": "array",
            "items": {
              "title": "Unit suggestions",
              "type": "object",
              "required": [
                "target",
                "user",
                "timestamp",
                "votes"
              ],
              "additionalProperties": false,
              "properties": {
                "target": {
                  "type": "string"
                },
                "user": {
                  "type": "string"
                },
                "timestamp": {
                  "type": "string",
                  "format": "date-time",
                  "default": "",
                  "examples": [
                    "2019-11-18T18:53:54.862Z"
                  ]
                },
                "votes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "user",
                      "value"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "user": {
                        "type": "string"
                      },
                      "value": {
                        "type": "integer",
                        "enum": [
                          -1,
                          1
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "screenshots": {
      "title": "Screenshot data",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "image",
          "translation_id",
          "units",
          "timestamp",
          "user"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "translation_id": {
            "title": "",
            "type": "integer"
          },
          "user": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "default": "",
            "examples": [
              "2019-11-18T18:53:54.862Z"
            ]
          },
          "units": {
            "type": "array",
            "items": {
              "pattern": "^[0-9a-f]{16}$(?![\\s\\S])",
              "type": "string"
            }
          }
        }
      }
    },
    "pending_unit_changes": {
      "title": "Pending unit changes data",
      "type": "array",
      "items": {
        "title": "Pending unit change data",
        "type": "object",
        "required": [
          "translation_id",
          "unit_id_hash",
          "author",
          "target",
          "explanation",
          "state",
          "timestamp",
          "add_unit",
          "source_unit_explanation"
        ],
        "additionalProperties": false,
        "properties": {
          "translation_id": {
            "title": "",
            "type": "integer"
          },
          "unit_id_hash": {
            "title": "",
            "type": "string",
            "pattern": "^[0-9a-f]{16}$(?![\\s\\S])",
            "examples": [
              "1234567890abcdef"
            ]
          },
          "author": {
            "title": "",
            "type": "string",
            "examples": [
              "weblate"
            ]
          },
          "target": {
            "title": "",
            "type": "string",
            "examples": [
              "hello"
            ]
          },
          "explanation": {
            "title": "",
            "type": "string",
            "examples": [
              "used as a greeting to begin conversation"
            ]
          },
          "state": {
            "title": "",
            "type": "integer",
            "examples": [
              0
            ]
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "default": "",
            "examples": [
              "2019-11-18T18:53:54.862Z"
            ]
          },
          "add_unit": {
            "title": "",
            "type": "boolean",
            "default": false,
            "examples": [
              true,
              false
            ]
          },
          "source_unit_explanation": {
            "title": "",
            "type": "string",
            "examples": [
              "used as a greeting to begin conversation"
            ]
          }
        }
      }
    }
  }
}
