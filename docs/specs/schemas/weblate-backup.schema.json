{
  "$id": "https://weblate.org/schemas/weblate-backup.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$defs": {
    "category": {
      "title": "Category",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "slug",
        "categories"
      ],
      "properties": {
        "name": {
          "title": "Category name",
          "type": "string",
          "default": "",
          "examples": [
            "My Category"
          ]
        },
        "slug": {
          "title": "Full URL slug excluding the project slug",
          "type": "string",
          "default": "",
          "examples": [
            "my-category",
            "my-category/my-subcategory"
          ]
        },
        "check_flags": {
          "title": "Translation flags",
          "type": "string",
          "default": ""
        },
        "enforced_checks": {
          "title": "Enforced checks",
          "type": "array",
          "items": {
            "title": "Check name",
            "type": "string"
          },
          "default": []
        },
        "license": {
          "title": "Translation license",
          "type": "string",
          "default": ""
        },
        "agreement": {
          "title": "Contributor agreement",
          "type": "string",
          "default": ""
        },
        "new_lang": {
          "title": "Adding new translation",
          "type": "string",
          "default": ""
        },
        "language_code_style": {
          "title": "Language code style",
          "type": "string",
          "default": ""
        },
        "secondary_language": {
          "title": "Secondary language code",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "commit_message": {
          "title": "Commit message when translating",
          "type": "string",
          "default": ""
        },
        "add_message": {
          "title": "Commit message when adding translation",
          "type": "string",
          "default": ""
        },
        "delete_message": {
          "title": "Commit message when removing translation",
          "type": "string",
          "default": ""
        },
        "merge_message": {
          "title": "Commit message when merging translation",
          "type": "string",
          "default": ""
        },
        "addon_message": {
          "title": "Commit message when add-on makes a change",
          "type": "string",
          "default": ""
        },
        "pull_message": {
          "title": "Merge request message",
          "type": "string",
          "default": ""
        },
        "inherit_license": {
          "title": "Inherit translation license",
          "type": "boolean",
          "default": false
        },
        "inherit_agreement": {
          "title": "Inherit contributor agreement",
          "type": "boolean",
          "default": false
        },
        "inherit_new_lang": {
          "title": "Inherit adding new translation",
          "type": "boolean",
          "default": false
        },
        "inherit_language_code_style": {
          "title": "Inherit language code style",
          "type": "boolean",
          "default": false
        },
        "inherit_secondary_language": {
          "title": "Inherit secondary language",
          "type": "boolean",
          "default": false
        },
        "inherit_enforced_checks": {
          "title": "Inherit enforced checks",
          "type": "boolean",
          "default": false
        },
        "inherit_commit_message": {
          "title": "Inherit commit message when translating",
          "type": "boolean",
          "default": false
        },
        "inherit_add_message": {
          "title": "Inherit commit message when adding translation",
          "type": "boolean",
          "default": false
        },
        "inherit_delete_message": {
          "title": "Inherit commit message when removing translation",
          "type": "boolean",
          "default": false
        },
        "inherit_merge_message": {
          "title": "Inherit commit message when merging translation",
          "type": "boolean",
          "default": false
        },
        "inherit_addon_message": {
          "title": "Inherit commit message when add-on makes a change",
          "type": "boolean",
          "default": false
        },
        "inherit_pull_message": {
          "title": "Inherit merge request message",
          "type": "boolean",
          "default": false
        },
        "categories": {
          "title": "Categories",
          "type": "array",
          "items": {
            "$ref": "#/$defs/category"
          },
          "default": []
        }
      }
    }
  },
  "title": "Weblate backup",
  "additionalProperties": false,
  "required": [
    "metadata",
    "project",
    "labels"
  ],
  "properties": {
    "metadata": {
      "title": "Export metadata",
      "type": "object",
      "required": [
        "version",
        "server",
        "domain",
        "timestamp"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "title": "Weblate version",
          "type": "string",
          "default": "",
          "examples": [
            "4.13"
          ]
        },
        "server": {
          "title": "Server name",
          "type": "string",
          "default": "",
          "examples": [
            "Weblate"
          ]
        },
        "domain": {
          "title": "Server domain",
          "type": "string",
          "format": "hostname",
          "default": "",
          "examples": [
            "weblate.example.com"
          ]
        },
        "timestamp": {
          "title": "Export timestamp",
          "type": "string",
          "format": "date-time",
          "default": "",
          "examples": [
            "2019-11-18T18:53:54.862Z"
          ]
        }
      }
    },
    "project": {
      "title": "Project",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "slug",
        "web",
        "instructions",
        "access_control",
        "language_aliases",
        "use_shared_tm",
        "contribute_shared_tm",
        "translation_review",
        "source_review",
        "enable_hooks"
      ],
      "properties": {
        "name": {
          "title": "Project name",
          "type": "string",
          "default": "",
          "examples": [
            "Hello"
          ]
        },
        "slug": {
          "title": "URL slug",
          "type": "string",
          "default": "",
          "examples": [
            "hello"
          ]
        },
        "web": {
          "title": "",
          "anyOf": [
            {
              "type": "string",
              "format": "iri"
            },
            {
              "type": "string",
              "maxLength": 0
            }
          ],
          "default": "Project website",
          "examples": [
            "https://weblate.org/"
          ]
        },
        "instructions": {
          "title": "Translation instructions",
          "type": "string",
          "default": ""
        },
        "access_control": {
          "title": "Access control",
          "type": "integer",
          "enum": [
            0,
            1,
            100,
            200
          ],
          "default": 0,
          "examples": [
            0
          ]
        },
        "public_sharing": {
          "title": "Public sharing",
          "type": "boolean",
          "default": false
        },
        "language_aliases": {
          "title": "Language aliases",
          "type": "string",
          "default": "",
          "examples": [
            ""
          ]
        },
        "set_language_team": {
          "title": "Set \"Language-Team\" header",
          "type": "boolean",
          "default": false
        },
        "use_shared_tm": {
          "title": "Use shared translation memory",
          "type": "boolean",
          "default": false
        },
        "contribute_shared_tm": {
          "title": "Contribute to shared translation memory",
          "type": "boolean",
          "default": false
        },
        "use_workspace_tm": {
          "title": "Use workspace translation memory",
          "type": "boolean",
          "default": false
        },
        "contribute_workspace_tm": {
          "title": "Contribute to workspace translation memory",
          "type": "boolean",
          "default": false
        },
        "autoclean_tm": {
          "title": "Autoclean translation memory",
          "type": "boolean",
          "default": false
        },
        "translation_review": {
          "title": "Enable reviews",
          "type": "boolean",
          "default": false
        },
        "source_review": {
          "title": "Enable source reviews",
          "type": "boolean",
          "default": false
        },
        "enforced_2fa": {
          "title": "Enforced two-factor authentication",
          "type": "boolean",
          "default": false
        },
        "commit_policy": {
          "title": "Translation quality filter",
          "type": "integer",
          "enum": [
            0,
            20,
            30
          ],
          "default": 0
        },
        "enable_hooks": {
          "title": "Enable hooks",
          "type": "boolean",
          "default": false
        },
        "check_flags": {
          "title": "Translation flags",
          "type": "string",
          "default": ""
        },
        "enforced_checks": {
          "title": "Enforced checks",
          "type": "array",
          "items": {
            "title": "Check name",
            "type": "string"
          },
          "default": []
        },
        "license": {
          "title": "Translation license",
          "type": "string",
          "default": ""
        },
        "agreement": {
          "title": "Contributor agreement",
          "type": "string",
          "default": ""
        },
        "new_lang": {
          "title": "Adding new translation",
          "type": "string",
          "default": ""
        },
        "language_code_style": {
          "title": "Language code style",
          "type": "string",
          "default": ""
        },
        "secondary_language": {
          "title": "Secondary language code",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "commit_message": {
          "title": "Commit message when translating",
          "type": "string",
          "default": ""
        },
        "add_message": {
          "title": "Commit message when adding translation",
          "type": "string",
          "default": ""
        },
        "delete_message": {
          "title": "Commit message when removing translation",
          "type": "string",
          "default": ""
        },
        "merge_message": {
          "title": "Commit message when merging translation",
          "type": "string",
          "default": ""
        },
        "addon_message": {
          "title": "Commit message when add-on makes a change",
          "type": "string",
          "default": ""
        },
        "pull_message": {
          "title": "Merge request message",
          "type": "string",
          "default": ""
        },
        "inherit_license": {
          "title": "Inherit translation license",
          "type": "boolean",
          "default": false
        },
        "inherit_agreement": {
          "title": "Inherit contributor agreement",
          "type": "boolean",
          "default": false
        },
        "inherit_new_lang": {
          "title": "Inherit adding new translation",
          "type": "boolean",
          "default": false
        },
        "inherit_language_code_style": {
          "title": "Inherit language code style",
          "type": "boolean",
          "default": false
        },
        "inherit_secondary_language": {
          "title": "Inherit secondary language",
          "type": "boolean",
          "default": false
        },
        "inherit_enforced_checks": {
          "title": "Inherit enforced checks",
          "type": "boolean",
          "default": false
        },
        "inherit_commit_message": {
          "title": "Inherit commit message when translating",
          "type": "boolean",
          "default": false
        },
        "inherit_add_message": {
          "title": "Inherit commit message when adding translation",
          "type": "boolean",
          "default": false
        },
        "inherit_delete_message": {
          "title": "Inherit commit message when removing translation",
          "type": "boolean",
          "default": false
        },
        "inherit_merge_message": {
          "title": "Inherit commit message when merging translation",
          "type": "boolean",
          "default": false
        },
        "inherit_addon_message": {
          "title": "Inherit commit message when add-on makes a change",
          "type": "boolean",
          "default": false
        },
        "inherit_pull_message": {
          "title": "Inherit merge request message",
          "type": "boolean",
          "default": false
        }
      }
    },
    "labels": {
      "title": "Project labels",
      "type": "array",
      "default": [],
      "items": {
        "title": "Items",
        "type": "object",
        "required": [
          "name",
          "color"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "title": "Label name",
            "type": "string",
            "default": "",
            "examples": [
              "Label"
            ]
          },
          "color": {
            "title": "Color",
            "type": "string",
            "default": "",
            "examples": [
              "navy"
            ],
            "enum": [
              "navy",
              "blue",
              "aqua",
              "teal",
              "olive",
              "green",
              "lime",
              "yellow",
              "orange",
              "red",
              "maroon",
              "fuchsia",
              "purple",
              "black",
              "gray",
              "silver"
            ]
          }
        }
      }
    },
    "categories": {
      "title": "Project Categories",
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/category"
      }
    },
    "teams": {
      "title": "Teams",
      "type": "array",
      "default": [],
      "items": {
        "title": "Team",
        "type": "object",
        "required": [
          "name",
          "roles",
          "components",
          "language_selection",
          "languages",
          "admins",
          "enforced_2fa",
          "members",
          "autogroups"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "title": "Team name",
            "type": "string",
            "default": "",
            "examples": [
              "My Team"
            ]
          },
          "internal": {
            "title": "Built-in team",
            "type": "boolean"
          },
          "roles": {
            "title": "Roles",
            "type": "array",
            "items": {
              "title": "Role name",
              "type": "string"
            },
            "default": [],
            "examples": [
              [
                "Translate",
                "Billing"
              ]
            ]
          },
          "components": {
            "title": "Components",
            "type": "array",
            "items": {
              "title": "Full component URL slug excluding the project slug",
              "type": "string"
            },
            "default": [],
            "examples": [
              [
                "my-category/my-component",
                "top-level-component"
              ]
            ]
          },
          "language_selection": {
            "title": "Language Selection",
            "type": "integer",
            "enum": [
              0,
              1
            ],
            "default": 0
          },
          "languages": {
            "title": "Languages",
            "type": "array",
            "items": {
              "title": "Language code",
              "type": "string"
            },
            "default": [],
            "examples": [
              [
                "en",
                "ru"
              ]
            ]
          },
          "admins": {
            "title": "Admins",
            "type": "array",
            "items": {
              "title": "Username",
              "type": "string"
            },
            "default": [],
            "examples": [
              [
                "admin"
              ]
            ]
          },
          "enforced_2fa": {
            "title": "Enforced two-factor authentication",
            "type": "boolean",
            "default": false
          },
          "members": {
            "title": "Members",
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "title": "Username",
                  "type": "string"
                },
                {
                  "title": "Team member",
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "username",
                    "limit_languages"
                  ],
                  "properties": {
                    "username": {
                      "title": "Username",
                      "type": "string"
                    },
                    "limit_languages": {
                      "title": "Limited languages",
                      "type": "array",
                      "items": {
                        "title": "Language code",
                        "type": "string"
                      },
                      "default": []
                    }
                  }
                }
              ]
            },
            "default": [],
            "examples": [
              [
                "user-1",
                {
                  "username": "reviewer-cs",
                  "limit_languages": [
                    "cs"
                  ]
                }
              ]
            ]
          },
          "autogroups": {
            "title": "Auto Groups",
            "type": "array",
            "items": {
              "title": "Regex to match",
              "type": "string"
            },
            "examples": [
              [
                "^.*$"
              ]
            ]
          }
        }
      }
    },
    "saved_searches": {
      "title": "Project saved searches",
      "type": "array",
      "default": [],
      "items": {
        "title": "Items",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "query",
          "description"
        ],
        "properties": {
          "name": {
            "title": "Saved search name",
            "type": "string",
            "maxLength": 190,
            "examples": [
              "Important"
            ]
          },
          "query": {
            "title": "Search query",
            "type": "string",
            "examples": [
              "priority:>100"
            ]
          },
          "description": {
            "title": "Search description",
            "type": "string",
            "maxLength": 250,
            "default": "",
            "examples": [
              "Translate first"
            ]
          }
        }
      }
    }
  }
}
