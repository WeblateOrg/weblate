msgid ""
"You will only receive these notifications for your translated languages in "
"%(project)s."
msgstr ""
"Só recibirá estas notificacións para os idiomas que traduce en %(project)s."

#, python-format
msgid ""
"You will only receive these notifications for your translated languages in "
"%(component)s."
msgstr ""
"Só recibirá estas notificacións para os idiomas que traduce en %(component)s."

