msgid "You will receive a notification for every such event in %(project)s."
msgstr "Recibirá unha notificación por cada evento deste tipo en %(project)s."

#, python-format
msgid "You will receive a notification for every such event in %(component)s."
msgstr ""
"Recibirá unha notificación por cada evento deste tipo en %(component)s."

