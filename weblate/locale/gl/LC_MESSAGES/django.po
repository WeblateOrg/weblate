msgctxt "No known user"
msgid "None"
msgstr "Ninguén"

msgid "User avatar"
msgstr "Avatar do usuario"

msgid ""
"This e-mail address is already in use. Please supply a different e-mail "
"address."
msgstr ""
"Este enderezo de correo xa está a ser usado. Forneza un enderezo diferente."

msgid "This username is already taken. Please pick something else."
msgstr "Este nome de usuario xa está a ser usado. Escolla outro."

