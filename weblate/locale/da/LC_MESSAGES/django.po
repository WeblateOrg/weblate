msgid "Automatic translation is waiting for another operation to finish."
msgstr "Automatisk oversættelse venter på, at en anden handling afsluttes."

msgid "Automatic translation failed. See the task log for details."
msgstr "Automatisk oversættelse mislykkedes. Se detaljer i opgaveloggen."

msgid "Task could not be completed. See the task log for details."
msgstr "Opgaven kunne ikke gennemføres. Se detaljer i opgaveloggen."

msgid "Automatic translation reported an error."
msgstr "Automatisk oversættelse meldte en fejl."

