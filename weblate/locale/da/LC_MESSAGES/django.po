msgid "Triggered by {username}."
msgstr "Aktiveret af  {username}."

msgid "Total strings"
msgstr "Samlet antal strenge"

msgid "Unfinished strings"
msgstr "Ufærdige strenge"

msgid "Unfinished words"
msgstr "Ufærdige ord"

msgid "Unfinished characters"
msgstr "Ufærdige tegn"

