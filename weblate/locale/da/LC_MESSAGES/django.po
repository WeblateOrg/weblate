msgstr "Denne tilføjelse kan ikke startes manuelt."

msgid "Format the Java properties file"
msgstr "Formatér Java Properties-filen"

msgid "Formats and sorts the Java properties file."
msgstr "Formaterer og sorterer Java Properties-filen."

msgid "Stale comment removal"
msgstr "Fjernelse af forældede kommentarer"

msgid "Set a timeframe for removal of comments."
msgstr "Indstil en tidsramme for fjernelse af kommentarer."

msgid "Stale suggestion removal"
msgstr "Fjernelse af forældede forslag"

msgid "Set a timeframe for removal of suggestions."
msgstr "Indstil en tidsramme for fjernelse af forslag."

msgid "Update RESX files"
msgstr "Opdater RESX-filer"

msgid ""
"Update all translation files to match the monolingual upstream base file. "
"Unused strings are removed, and new ones added as copies of the source "
"string."
msgstr ""
"Opdater alle oversættelsesfiler, så de matcher den etsprogede upstream-"
"basisfil. Ubrugte strenge fjernes, og nye tilføjes som kopier af "
"kildestrengen."

