"Updates the ALL_LINGUAS variable in \"configure\", \"configure.in\" or "
"\"configure.ac\" files, when a translation is added or removed."
msgstr ""
"Opdaterer variablen ALL_LINGUAS i filerne »configure«, »configure.in« eller »"
"configure.ac«, når en oversættelse tilføjes eller fjernes."

msgid "Update PO files to match POT (msgmerge)"
msgstr "Opdater PO-filer til at matche POT (msgmerge)"

msgid ""
"Updates all PO files (as configured by \"File mask\") to match the POT file "
"(as configured by \"Template for new translations\") using msgmerge."
msgstr ""
"Opdaterer alle PO-filer (som konfigureret af \"Filmaske\"), så de matcher "
"POT-filen (som konfigureret af \"Skabelon for nye oversættelser\") med "
"msgmerge."

msgid "Update POT file (xgettext)"
msgstr "Opdater POT-fil (xgettext)"

msgid "Updates the gettext template using xgettext on selected source files."
msgstr ""
"Opdaterer gettext-skabelonen ved at køre xgettext på udvalgte kildefiler."

msgid "Update POT file (Meson)"
msgstr "Opdater POT-fil (Meson)"

