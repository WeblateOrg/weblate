msgstr "Opdaterer gettext-skabelonen efter Mesons gettext-konventioner."

msgid "Update gettext template (Django)"
msgstr "Opdater gettext-skabelon (Django)"

msgid ""
"Updates the gettext template using Django's built-in makemessages command."
msgstr ""
"Opdaterer gettext-skabelonen med Djangos indbyggede kommando makemessages."

msgid "Update POT file (Sphinx)"
msgstr "Opdater POT-fil (Sphinx)"

