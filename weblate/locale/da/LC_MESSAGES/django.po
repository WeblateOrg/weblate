"Repositoriets HTTP-omdirigering indeholder legitimationsoplysninger og blev "
"afvist."

msgid ""
"The repository URL redirects to a different host. Automatic cross-host "
"redirects are disabled for security; update the repository URL manually."
msgstr ""
"Repositoriets URL omdirigerer til en anden vært. Automatiske omdirigeringer "
"mellem værter er af sikkerhedshensyn slået fra. Opdater repositoriets URL "
"manuelt."

msgid ""
"The repository URL redirects from HTTPS to an insecure URL and was rejected."
msgstr ""
"Repositoriets URL omdirigerer fra HTTPS til en usikker URL og blev afvist."

msgid "The repository returned an invalid HTTP redirect."
msgstr "Repositoriet returnerede en ugyldig HTTP-omdirigering."

msgid "The repository returned an HTTP redirect with an invalid hostname."
msgstr ""
"Repositoriet returnerede en HTTP-omdirigering med et ugyldigt værtsnavn."

msgid "The repository HTTP redirect contains a loop."
msgstr "Repositoriets HTTP-omdirigering danner en løkke."

msgid "The repository redirect target has no validated address."
msgstr ""
"Destinationen for repositoriets omdirigering har ingen valideret adresse."

msgid "The repository returned a permanent HTTP redirect without a target URL."
msgstr ""
"Repositoriet returnerede en permanent HTTP-omdirigering uden destinations-"
"URL."

msgid ""
"The repository HTTP redirect does not point to a Git smart HTTP endpoint."
msgstr ""
"Repositoriets HTTP-omdirigering peger ikke på et Git Smart HTTP-endepunkt."

#, python-format
msgid "Could not probe the repository HTTP redirect: %(error)s"
msgstr "Kunne ikke undersøge repositoriets HTTP-omdirigering: %(error)s"

msgid "The repository HTTP redirect unexpectedly changed the URL query."
msgstr ""
"Repositoriets HTTP-omdirigering ændrede uventet URL'ens forespørgselsstreng."

msgid "The repository HTTP redirect target could not be validated."
msgstr "Destinationen for repositoriets HTTP-omdirigering kunne ikke valideres."

msgid ""
"The repository HTTP redirect target could not be verified as a Git "
"repository."
msgstr ""
"Det kunne ikke bekræftes, at destinationen for repositoriets HTTP-"
"omdirigering er et Git-repositorium."

msgid "The repository returned too many HTTP redirects."
msgstr "Repositoriet returnerede for mange HTTP-omdirigeringer."

msgid "The repository URL redirects to an unsupported URL scheme."
msgstr "Repositoriets URL omdirigerer til et URL-skema, som ikke understøttes."

msgid ""
"Remote branch could not be verified against the shallow existing repository."
msgstr ""
"Den eksterne gren kunne ikke verificeres ud fra det eksisterende "
"repositoriums begrænsede historik."

msgid ""
"Remote branch does not share common history with the existing repository."
msgstr ""
"Den eksterne gren har ingen fælles historik med det eksisterende "
"repositorium."

msgid "Could not determine the effective SSH destination."
msgstr "Kunne ikke bestemme den faktiske SSH-destination."

#, python-format
msgid "Could not determine the effective SSH destination: %(error)s"
msgstr "Kunne ikke bestemme den faktiske SSH-destination: %(error)s"

#, python-format
