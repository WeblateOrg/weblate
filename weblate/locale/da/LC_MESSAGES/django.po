msgstr "Valgfrit præfiks, der sættes foran de genererede beskedemner."

msgid "CA certificate bundle (PEM)"
msgstr "Samling af CA-certifikater (PEM)"

msgid ""
"Paste only PEM certificate blocks, each starting with \"-----BEGIN "
"CERTIFICATE-----\" and ending with \"-----END CERTIFICATE-----\"."
msgstr ""
"Indsæt kun PEM-certifikatblokke. Hver blok skal begynde med »-----BEGIN "
"CERTIFICATE-----« og slutte med »-----END CERTIFICATE-----«."

msgid "Client private key (PEM)"
msgstr "Klientens private nøgle (PEM)"

