msgstr ""
"Tilføjede værtsnøgle for %(host)s med fingeraftrykket %(fingerprint)s (%"
"(keytype)s). Bekræft, at det er korrekt."

msgid "No validated SSH addresses available."
msgstr "Der er ingen validerede SSH-adresser tilgængelige."

msgid "Could not read stored host keys."
msgstr "Kunne ikke læse de gemte værtsnøgler."

msgid "Could not find the selected host key."
msgstr "Kunne ikke finde den valgte værtsnøgle."

msgid "Could not update stored host keys."
msgstr "Kunne ikke opdatere de gemte værtsnøgler."

#, python-format
msgid ""
"Removed host key for %(host)s with fingerprint %(fingerprint)s (%(keytype)s)."
msgstr ""
"Fjernede værtsnøglen for %(host)s med fingeraftrykket %(fingerprint)s (%"
"(keytype)s)."

#, python-format
msgid "Could not determine the effective SSH destination: %s"
msgstr "Kunne ikke bestemme den faktiske SSH-destination: %s"

msgid ""
"Create a workspace before connecting a GitHub account. GitHub App "
"connections are linked to workspaces."
msgstr ""
"Opret et arbejdsområde, før du tilknytter en GitHub-konto. Forbindelser til "
"GitHub-appen knyttes til arbejdsområder."

msgid ""
"GitHub could not uninstall the connected account. The connection was not "
"removed from Weblate, please try again."
msgstr ""
"GitHub kunne ikke afinstallere forbindelsen til kontoen. Forbindelsen er "
"bevaret i Weblate. Prøv igen."

#, python-format
msgid ""
"Removed connected GitHub account %(target)s. The Weblate GitHub App remains "
"installed because another workspace still uses it."
msgstr ""
"Tilknytningen til GitHub-kontoen %(target)s er fjernet. Weblates GitHub-app "
"forbliver installeret, fordi et andet arbejdsområde stadig bruger den."

#, python-format
msgid ""
"Removed connected GitHub account %(target)s and uninstalled the Weblate "
"GitHub App from GitHub."
msgstr ""
"Tilknytningen til GitHub-kontoen %(target)s er fjernet, og Weblates GitHub-"
"app er afinstalleret fra GitHub."

#, python-format
msgid ""
"Removed connected GitHub account %(target)s. GitHub no longer grants access "
"to this installation, so it was not uninstalled. Check on GitHub whether the "
"Weblate GitHub App is still installed."
msgstr ""
"Tilknytningen til GitHub-kontoen %(target)s er fjernet. GitHub giver ikke "
"længere adgang til installationen, så den blev ikke afinstalleret. "
"Kontrollér på GitHub, om Weblates GitHub-app stadig er installeret."

#, python-format
msgid ""
"Removed connected GitHub account %(target)s. The Weblate GitHub App is no "
"longer configured on this Weblate instance, so it could not be uninstalled, "
"please remove it on GitHub manually."
msgstr ""
"Tilknytningen til GitHub-kontoen %(target)s er fjernet. Weblates GitHub-app "
"er ikke længere konfigureret på denne Weblate-installation og kunne derfor "
"ikke afinstalleres. Fjern den manuelt på GitHub."

#, python-format
msgid ""
"Remove connected GitHub accounts on %(hostname)s before removing the app "
"credentials."
msgstr ""
"Fjern tilknyttede GitHub-konti på %(hostname)s, før du fjerner appens "
"legitimationsoplysninger."

#, python-format
msgid "Removed Weblate GitHub App credentials for %(hostname)s."
msgstr ""
"Legitimationsoplysningerne til Weblates GitHub-app på %(hostname)s er "
"fjernet."

msgid "Failed to refresh repositories from GitHub."
msgstr "Kunne ikke opdatere listen over repositorier fra GitHub."

#, python-format
msgid "Refreshed %(count)d repositories from GitHub."
msgstr "Opdaterede %(count)d repositorier fra GitHub."

msgid "Weblate GitHub app is not configured on this Weblate instance."
msgstr "Weblates GitHub-app er ikke konfigureret på denne Weblate-installation."

msgid "Select a workspace before connecting a GitHub account."
msgstr "Vælg et arbejdsområde, før du tilknytter en GitHub-konto."

msgid "Weblate GitHub app is not configured for the selected host."
msgstr "Weblates GitHub-app er ikke konfigureret for den valgte vært."

msgid "Connected GitHub account updated."
msgstr "Den tilknyttede GitHub-konto er opdateret."

msgid ""
"The Weblate GitHub app installation link is no longer valid. Start the "
"installation again."
msgstr ""
"Installationslinket til Weblates GitHub-app er ikke længere gyldigt. Start "
"installationen igen."

msgid "You do not have permission to connect GitHub to this workspace."
msgstr "Du har ikke tilladelse til at knytte GitHub til dette arbejdsområde."

msgid "GitHub did not return a valid installation ID."
msgstr "GitHub returnerede ikke et gyldigt installations-id."

msgid ""
"Too many GitHub account connection attempts. The GitHub installation was not "
"connected and might still be pending. Try connecting the account again later."
msgstr ""
"For mange forsøg på at tilknytte GitHub-kontoen. GitHub-installationen blev "
"ikke tilknyttet og afventer muligvis stadig. Prøv at tilknytte kontoen igen "
"senere."

msgid ""
"Weblate could not confirm that you can administer this GitHub installation. "
"Start the installation again with a GitHub user who owns the account or can "
"administer the organization."
msgstr ""
"Weblate kunne ikke bekræfte, at du kan administrere denne GitHub-"
"installation. Start installationen igen med en GitHub-bruger, der ejer "
"kontoen eller kan administrere organisationen."

msgid ""
"GitHub is still syncing the connected GitHub account. The connection is "
"pending and repositories might not appear yet. Try connecting the account "
"again later if they do not show up."
msgstr ""
"GitHub synkroniserer stadig den tilknyttede GitHub-konto. Forbindelsen "
"afventer, og repositorierne vises muligvis ikke endnu. Prøv at tilknytte "
"kontoen igen senere, hvis de ikke dukker op."

msgid ""
"The connected GitHub account was saved, but refreshing the repository list "
"failed. Try again in a moment."
msgstr ""
"Den tilknyttede GitHub-konto er gemt, men repositorielisten kunne ikke "
"opdateres. Prøv igen om et øjeblik."

msgid "Connected GitHub account added."
msgstr "GitHub-kontoen er tilknyttet."

#, python-format
msgid "Migrated one component to the Weblate GitHub App."
msgid_plural "Migrated %(count)d components to the Weblate GitHub App."
msgstr[0] "Én komponent er migreret til Weblates GitHub-app."
msgstr[1] "%(count)d komponenter er migreret til Weblates GitHub-app."

#, python-format
msgid ""
"One component was not migrated because its repository is no longer available."
msgid_plural ""
"%(count)d components were not migrated because their repositories are no "
"longer available."
msgstr[0] ""
"Én komponent blev ikke migreret, fordi dens repositorium ikke længere er "
"tilgængeligt."
msgstr[1] ""
"%(count)d komponenter blev ikke migreret, fordi deres repositorier ikke "
"længere er tilgængelige."

#, python-format
msgid "Could not migrate %(component)s: %(error)s"
msgstr "Kunne ikke migrere %(component)s: %(error)s"

msgid "Enter a valid GitHub App name and host."
msgstr "Angiv et gyldigt navn og en gyldig vært til GitHub-appen."

#, python-format
msgid ""
"A Weblate GitHub App is already registered for %(hostname)s. Remove it "
"before registering another one."
msgstr ""
"Der er allerede registreret en Weblate-GitHub-app på %(hostname)s. Fjern "
"den, før du registrerer en ny."

msgid "GitHub did not return a valid registration code."
msgstr "GitHub returnerede ikke en gyldig registreringskode."

msgid ""
"The GitHub App registration link is no longer valid. Start the registration "
