msgstr ""
"Hvor mange gange den variable tekst skal gentages, afhængigt af længden på "
"kildestrengen."

msgid "Include read-only strings"
msgstr "Inkluder skrivebeskyttede strenge"

msgid "Source and target"
msgstr "Kilde og mål"

