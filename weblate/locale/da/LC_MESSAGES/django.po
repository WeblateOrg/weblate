msgstr ""
"Registreringslinket til GitHub-appen er ikke længere gyldigt. Start "
"registreringen igen."

msgid "GitHub rejected the registration code. Start the registration again."
msgstr "GitHub afviste registreringskoden. Start registreringen igen."

msgid "GitHub returned an incomplete App registration response."
msgstr "GitHub returnerede et ufuldstændigt svar på registreringen af appen."

msgid "Weblate GitHub App registered. You can now connect a GitHub account."
msgstr ""
"Weblates GitHub-app er registreret. Du kan nu tilknytte en GitHub-konto."

msgid "Weblate GitHub App credentials updated."
msgstr "Legitimationsoplysningerne til Weblates GitHub-app er opdateret."

