msgstr "Tekst, der tilføjes først"

msgid "Appended text"
msgstr "Tekst, der tilføjes sidst"

msgid "Text expansion"
msgstr "Tekstudvidelse"

msgid "The source and target have to be different languages."
msgstr "Kilden og målet skal være forskellige sprog."

