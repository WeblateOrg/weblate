msgid ""
"You will receive a notification for every such event in non-watched projects."
msgstr ""
"Du modtager en notifikation om alle sådanne hændelser i ikke-overvågede "
"projekter."

msgid ""
"You will receive a notification for every such event in your watched "
"projects."
msgstr ""
"Du modtager en notifikation om alle sådanne hændelser i dine overvågede "
"projekter."

msgid ""
"You will receive a notification for every such event in projects where you "
"have admin permissions."
msgstr ""
"Du modtager en notifikation om alle sådanne hændelser i projekter, hvor du "
"har administratortilladelser."

#, python-format
msgid "You will receive a notification for every such event in %(project)s."
msgstr "Du modtager en notifikation om alle sådanne hændelser i %(project)s."

#, python-format
msgid "You will receive a notification for every such event in %(component)s."
msgstr "Du modtager en notifikation om alle sådanne hændelser i %(component)s."

msgid ""
"You will only receive these notifications for your translated languages in "
"non-watched projects."
msgstr ""
"Du modtager kun disse notifikationer for de sprog, du har oversat, i ikke-"
"overvågede projekter."

msgid ""
"You will only receive these notifications for your translated languages in "
"your watched projects."
msgstr ""
"Du modtager kun disse notifikationer for de sprog, du har oversat, i dine "
"overvågede projekter."

msgid ""
"You will only receive these notifications for your translated languages in "
"projects where you have admin permissions."
msgstr ""
"Du modtager kun disse notifikationer for de sprog, du har oversat, i "
"projekter, hvor du har administratortilladelser."

#, python-format
msgid ""
"You will only receive these notifications for your translated languages in "
"%(project)s."
msgstr ""
"Du modtager kun disse notifikationer for de sprog, du har oversat, i "
"%(project)s."

#, python-format
msgid ""
"You will only receive these notifications for your translated languages in "
"%(component)s."
msgstr ""
"Du modtager kun disse notifikationer for de sprog, du har oversat, i "
"%(component)s."

