msgstr "Intet billede fundet i udklipsholder"

msgid ""
"A pull or merge request will be created from a branch in the repository."
msgstr ""
"Der oprettes en pull- eller merge-anmodning fra en gren i repositoriet."

msgid ""
"A push URL is set but no push branch is given. Set a push branch that "
"differs from the translated branch."
msgstr ""
"Der er angivet en push-URL, men der er ikke angivet nogen push-gren. Angiv "
"en push-gren, der adskiller sig fra den oversatte gren."

msgid ""
"The push branch must differ from the translated branch when creating a pull "
"or merge request."
msgstr ""
"Push-grenen skal være forskellig fra den oversatte gren, når der oprettes en "
"pull- eller merge-anmodning."

msgid "A pull or merge request will be created from a fork of the repository."
msgstr ""
"Der oprettes en pull- eller merge-anmodning ud fra en fork af repositoriet."

#, javascript-format
msgid ""
"A pull or merge request will be created from the “%s” branch in the "
"repository."
msgstr ""
"Der oprettes en pull- eller merge-anmodning fra grenen »%s« i repositoriet."

#, javascript-format
msgid ""
"Changes will be sent as a Gerrit review request targeting the “%s” branch."
msgstr ""
"Ændringerne vil blive sendt som en Gerrit-gennemgangsanmodning rettet mod "
"grenen »%s«."

msgid "Changes will be sent as a Gerrit review request."
msgstr "Ændringerne vil blive sendt som en Gerrit-gennemgangsanmodning."

msgid ""
"Changes will not be pushed automatically. You can still push them manually "
"from the repository maintenance."
msgstr ""
"Ændringerne bliver ikke automatisk overført. Du kan stadig overføre dem "
"manuelt fra vedligeholdelse af repositoriet."

#, javascript-format
msgid ""
"Changes will be pushed directly to the “%s” branch in the push repository."
msgstr ""
"Ændringerne vil blive sendt direkte til grenen »%s« i push-repositoriet."

msgid ""
"Changes will be pushed directly to the default branch of the push repository."
msgstr ""
"Ændringerne vil blive sendt direkte til standardgrenen i push-repositoriet."

