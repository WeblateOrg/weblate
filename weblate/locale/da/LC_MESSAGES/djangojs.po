msgstr "Vælg en komponent for at indlæse grenene i dens repositorium."

msgid "Loading repository branches…"
msgstr "Indlæser repositoriets grene…"

msgid "Repository branches loaded."
msgstr "Repositoriets grene er indlæst."

msgid "No additional repository branches are available."
msgstr "Der er ingen yderligere grene i repositoriet."

msgid "Could not load repository branches. Please try again."
msgstr "Kunne ikke indlæse repositoriets grene. Prøv igen."

msgid "Weblate is now scanning the repository, please be patient."
msgstr "Vent, mens Weblate gennemgår repositoriet."

msgid "Nothing to preview."
msgstr "Intet at forhåndsvise."

msgid "Please sign in again."
msgstr "Log ind igen."

msgid ""
"Notification settings removed, please do not forget to save the changes."
msgstr "Notifikationsindstillingerne er fjernet. Husk at gemme ændringerne."

msgctxt "Alert to user when opening browser developer console"
msgid "Stop!"
msgstr "Stop!"

msgid ""
"This is a browser feature intended for developers. If someone told you to "
"copy-paste something here, they are likely trying to compromise your Weblate "
"account."
msgstr ""
"Denne browserfunktion er beregnet til udviklere. Hvis nogen har bedt dig om "
"at kopiere noget og indsætte det her, forsøger de sandsynligvis at få adgang "
"til din Weblate-konto."

msgid "See https://en.wikipedia.org/wiki/Self-XSS for more information."
msgstr "Se flere oplysninger på https://en.wikipedia.org/wiki/Self-XSS."

