msgid ""
"Your previous search results are no longer available. Refresh results to "
"continue."
msgstr ""
"Dine tidligere søgeresultater er ikke længere tilgængelige. Opdatér "
"resultaterne for at fortsætte."

msgid "There are some unsaved changes, are you sure you want to leave?"
msgstr "Du har ændringer, som ikke er gemt. Vil du alligevel forlade siden?"

msgid "Save or discard your changes before accepting a suggestion."
msgstr "Gem eller kassér dine ændringer, før du accepterer et forslag."

#, fuzzy, javascript-format
#| msgid "Accept suggestions"
msgid "%s suggestion"
msgid_plural "%s suggestions"
msgstr[0] "Acceptér forslag"
msgstr[1] "Acceptér forslag"

msgid ""
"The translation was changed while you were editing it, your unsaved changes "
"were kept."
msgstr ""
"Oversættelsen blev ændret, mens du redigerede den. Dine ugemte ændringer er "
"bevaret."

msgid "Hide suggestions"
msgstr "Skjul forslag"

msgid "Show suggestions"
msgstr "Vis forslag"

msgid "Processed %(processed)s of %(total)s entries."
msgstr "%(processed)s af %(total)s poster behandlet."

#, javascript-format
msgid "Results of action %s"
msgstr "Resultater af handlingen %s"

msgid "Not takes exactly one condition."
msgstr "»Ikke« kræver præcis én betingelse."

msgid "Automations can nest eight levels deep."
msgstr "En automatisering kan have op til otte indlejringsniveauer."

msgid "Automations can hold one hundred nodes."
msgstr "En automatisering kan indeholde op til 100 knudepunkter."

msgid "This workflow is not valid YAML, so the editor cannot show it."
msgstr ""
"Arbejdsgangen er skrevet i ugyldig YAML og kan derfor ikke vises i editoren."

msgid ""
"This workflow has something the editor cannot show, such as an unknown "
"action or a setting that is no longer available. Edit it as YAML."
msgstr ""
"Arbejdsgangen indeholder noget, som editoren ikke kan vise, f.eks. en ukendt "
"handling eller en indstilling, der ikke længere findes. Rediger "
"arbejdsgangen i YAML."

#, javascript-format
msgid "Added %s."
msgstr "Tilføjede %s."

#, javascript-format
msgid "Removed %s."
msgstr "Fjernede %s."

#, javascript-format
msgid "Moved %s."
msgstr "Flyttede %s."

msgid ""
"An action running on the whole component needs a query. Enter one or pick "
"another scope."
msgstr ""
"En handling, der gælder for hele komponenten, kræver en søgeforespørgsel. "
"Indtast en forespørgsel, eller vælg et andet omfang."

msgid "Security token missing. Please reload the page."
msgstr "Sikkerhedstokenet mangler. Genindlæs siden."

#, javascript-format
msgid "Loading suggestion count for %s"
msgstr "Henter antallet af forslag til %s"

msgid "Bulk accept cancelled."
msgstr "Samlet accept af forslag blev annulleret."

#, javascript-format
msgid "Scheduling bulk accept for %s"
msgstr "Planlægger samlet accept af forslag til %s"

msgid "Unknown error"
msgstr "Ukendt fejl"

#, javascript-format
msgid "Error: %s"
msgstr "Fejl: %s"

msgid "Network error"
msgstr "Netværksfejl"

msgid "Invalid server response"
msgstr "Ugyldigt serversvar"

msgid ""
"Accepting the suggestions takes longer than expected, reload the page to see "
"the result."
msgstr ""
"Det tager længere tid end forventet at acceptere forslagene. Genindlæs siden "
"for at se resultatet."

#, javascript-format
msgid "Server error (%s)"
msgstr "Serverfejl (%s)"

msgid "There are no pending suggestions from %(username)s in %(translation)s."
msgstr "Der er ingen afventende forslag fra %(username)s i %(translation)s."

msgid ""
"This will accept %(count)s suggestion from %(username)s in %(translation)s."
msgid_plural ""
"This will accept %(count)s suggestions from %(username)s in %(translation)s."
msgstr[0] ""
"Dette vil acceptere %(count)s forslag fra %(username)s i %(translation)s."
