msgstr "N'eo ket bet posupl kevreañ dre {method} ({name})."

#. Translators: Audit log entry
msgid "Account locked due to many failed sign in attempts."
msgstr ""
"Stanket eo ar gont abalamour ma'z eus bet klasket kevreañ re alies en aner."

#. Translators: Audit log entry
msgid "Account locked by the site administrator."
msgstr "Kont bet prennet gant merour al lec'hienn."

#. Translators: Audit log entry
msgid "Account and all private data removed."
msgstr "Dilamet eo bet ho kont ervat ha kement roadenn bersonel stag outi."

#. Translators: Audit log entry
#, python-brace-format
msgid "Account removal confirmation sent to {email}."
msgstr "Kaset ez eus bet ur postel da gadarnaat an dilam kont da {email}."

#. Translators: Audit log entry
#, python-brace-format
msgid "Agreement with General Terms and Conditions {date}."
msgstr "Asant war an termenoù hollek an aozioù implijout hollek {date}."

#. Translators: Audit log entry
#, python-brace-format
msgid "Invited to {site_title} by {username}."
msgstr "Bet pedet war {site_title} gant {username}."

#. Translators: Audit log entry
#, python-brace-format
msgid "Accepted invitation from {username}."
msgstr "Pedadenn {username} asantet."

#. Translators: Audit log entry
msgid "Started trial period."
msgstr "Prantad esae war ober."

#. Translators: Audit log entry
#, python-brace-format
msgid "Sent confirmation mail to {email}."
msgstr "Postel kadarnaat bet kaset da {email}."

#, fuzzy
msgid ""
"The system created a user to track authorship of translations uploaded by "
