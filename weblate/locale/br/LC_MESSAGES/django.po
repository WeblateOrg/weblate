msgstr ""
"Kadarnaet eo bet adderaouekadur ar ger-tremen. Diweredekaet eo bet ar ger-"
"tremen kozh."

#. Translators: Audit log entry
#, python-brace-format
msgid "Configured sign in using {method} ({name})."
msgstr "Kevreañ kefluniet dre {method} ({name})."

#. Translators: Audit log entry
