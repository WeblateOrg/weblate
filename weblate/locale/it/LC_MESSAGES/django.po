#, python-brace-format
msgid "Triggered by {username}."
msgstr "Attivato da {username}."

msgid "Total strings"
msgstr "Totale stringhe"

msgid "Unfinished strings"
msgstr "Stringhe non terminate"

msgid "Unfinished words"
msgstr "Parole non completate"

msgid "Unfinished characters"
msgstr "Caratteri non completati"

