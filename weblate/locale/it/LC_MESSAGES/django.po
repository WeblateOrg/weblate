msgctxt "No known user"
msgid "None"
msgstr "Nessuno"

msgid "User avatar"
msgstr "Avatar utente"

msgid ""
"This e-mail address is already in use. Please supply a different e-mail "
"address."
msgstr "Questo indirizzo e-mail è già in uso. Usa un indirizzo e-mail diverso."

msgid "This username is already taken. Please pick something else."
msgstr "Questo nome utente è già stato preso. Scegline un altro."

msgid "Full name"
msgstr "Nome e cognome"

msgid "Name is also used in version control commits."
msgstr "Il nome viene usato anche nei commit del controllo versione."

msgid "Commit e-mail"
msgstr "E-mail di commit"

msgid "Use account e-mail address"
msgstr "Usa indirizzo e-mail dell'account"

msgid ""
"Used in version-control commits. The address stays in the repository forever "
"once changes are committed by Weblate."
msgstr ""
"Usato nei commit del controllo della versione. L'indirizzo rimane nel "
"repository per sempre una volta che Weblate avrà effettuato il commit delle "
"modifiche."

msgid "Commit name"
msgstr "Nome commit"

msgid ""
"Used in version control commits. The name stays in the repository forever, "
"once changes are committed by Weblate."
msgstr ""
"Usato nei commit di controllo versione. Il nome rimane nel repository per "
"sempre, una volta che le modifiche vengono confermate da Weblate."

msgid "Public e-mail"
msgstr "E-mail pubblica"

msgid "Hide e-mail address from public view"
msgstr "Nascondi l'indirizzo e-mail dalla vista pubblica"

#, python-format
msgid "Component list: %s"
msgstr "Elenchi componenti: %s"

msgid "Account e-mail"
msgstr "Account e-mail"

msgid ""
"Used for e-mail notifications and as a commit e-mail if it is not configured "
"below."
msgstr ""
"Usato per le notifiche e-mail e come e-mail di commit se non è configurato "
"di seguito."

msgid "Human verification"
msgstr "Verifica umana"

#, python-format
msgctxt ""
"Question for a mathematics-based CAPTCHA, the %s is an arithmetic problem"
msgid "What is %s?"
msgstr "Quanto fa %s?"

#. Translators: Shown on wrong answer to the mathematics-based CAPTCHA
msgid "That was not correct, please try again."
msgstr "Non corretto, riprova."

msgid "Validation failed, please try again."
msgstr "Convalida non riuscita, riprova."

msgid "Subject"
msgstr "Soggetto"

msgid "Your name"
msgstr "Il tuo nome"

msgid "Your e-mail"
msgstr "La tua e-mail"

msgid "Message"
msgstr "Messaggio"

msgid ""
"Please contact us in English. Otherwise, we might not process your request."
msgstr ""
"Ti preghiamo di contattarci in inglese, altrimenti potremmo non elaborare la "
"tua richiesta."

msgid "E-mail"
msgstr "E-mail"

msgid "An e-mail with a confirmation link will be sent here."
msgstr "Verrà inviata qui un'e-mail con un link di conferma."

msgid "New password"
msgstr "Nuova password"

msgid "New password confirmation"
msgstr "Conferma nuova password"

msgid "Regenerate API key"
msgstr "Rigenera la chiave API"

msgid ""
"Leave enabled to revoke the current API key and generate a new one. This is "
"recommended if you suspect your password was compromised. Disable it to keep "
"your current API key active after changing your password."
msgstr ""
"Lasciare attiva l'opzione per rimuovere l'attuale chiave API e crearne una "
"nuova. È consigliato di farlo se si sospetta che la propria password sia "
"stata compromessa. Disabilitarla per mantenere l'attuale chiave API attiva "
"dopo aver modificato la password."

msgid "Your password has been changed."
msgstr "La tua password è stata modificata."

msgid "Current password"
msgstr "Password attuale"

msgid "Leave empty if you have not set a password yet."
msgstr "Lascia vuoto se non hai ancora impostato una password."

msgid "You have entered an invalid password."
msgstr "Hai inserito una password non valida."

msgid "Username or e-mail"
msgstr "Nome utente o e-mail"

msgid "Password"
msgstr "Password"

msgid "Please enter the correct username and password."
msgstr "Inserisci nome utente e password corretti."

msgid "This account is inactive."
msgstr "Questo account non è attivo."

msgid "Component wide notifications"
msgstr "Notifiche per tutti i componenti"

msgid "Translation notifications"
msgstr "Notifiche di traduzione"

msgid "Use default setting"
msgstr "Usa impostazioni predefinite"

msgid "Other projects"
msgstr "Altri progetti"

msgid "Watched projects"
msgstr "Progetti monitorati"

msgid "Managed projects"
msgstr "Progetti gestiti"

msgid "Project: {}"
msgstr "Progetto: {}"

msgid "Component: {}"
msgstr "Componente: {}"

msgid ""
"You will receive a notification for every such event in non-watched projects."
msgstr ""
"Riceverai una notifica per ogni evento simile nei progetti non monitorati."

msgid ""
"You will receive a notification for every such event in your watched "
"projects."
msgstr "Riceverai una notifica per ogni evento simile nei progetti monitorati."

msgid ""
"You will receive a notification for every such event in projects where you "
"have admin permissions."
msgstr ""
"Riceverai una notifica per ogni evento simile nei progetti in cui disponi "
"delle autorizzazioni di amministratore."

#, python-format
msgid "You will receive a notification for every such event in %(project)s."
msgstr "Riceverai una notifica per ogni evento simile in %(project)s."

#, python-format
msgid "You will receive a notification for every such event in %(component)s."
msgstr "Riceverai una notifica per ogni evento simile in %(component)s."

msgid ""
"You will only receive these notifications for your translated languages in "
"non-watched projects."
msgstr ""
"Riceverai queste notifiche solo per le lingue tradotte nei progetti non "
"monitorati."

msgid ""
"You will only receive these notifications for your translated languages in "
"your watched projects."
msgstr ""
"Riceverai queste notifiche solo per le lingue tradotte nei progetti "
"monitorati."

msgid ""
"You will only receive these notifications for your translated languages in "
"projects where you have admin permissions."
msgstr ""
"Riceverai queste notifiche solo per le lingue tradotte nei progetti in cui "
"disponi delle autorizzazioni di amministratore."

#, python-format
msgid ""
"You will only receive these notifications for your translated languages in "
"%(project)s."
msgstr "Riceverai queste notifiche solo per le lingue tradotte in %(project)s."

#, python-format
msgid ""
"You will only receive these notifications for your translated languages in "
"%(component)s."
msgstr ""
"Riceverai queste notifiche solo per le lingue tradotte in %(component)s."

msgid "Username"
msgstr "Nome utente"

msgid "Date joined"
msgstr "Data di adesione"

msgid "Translations made"
msgstr "Traduzioni completate"

msgid "Suggestions made"
msgstr "Suggerimenti fatti"

msgid "Comments made"
msgstr "Commenti fatti"

msgid "Screenshots uploaded"
msgstr "Screenshot caricati"

msgid "The chosen sorting is not supported."
msgstr "L'ordinamento scelto non è supportato."

msgid "Team"
msgstr "Squadra"

msgid "Add to a team"
msgstr "Aggiungi a una squadra"

msgid "Name your authentication app"
msgstr "Assegna un nome all'app di autenticazione"

msgid "Verify the code from the app"
msgstr "Verifica il codice dall'app"

msgid "Discard previously configured authentication apps"
msgstr "Ignora app di autenticazione configurate in precedenza"

msgid ""
"All previously configured authentication apps will be discarded upon "
"verification of the new app."
msgstr ""
"Tutte le app di autenticazione precedentemente configurate verranno "
"eliminate al momento della verifica della nuova app."

msgid ""
"Other two-factor methods (such as WebAuthn and security keys) won't be "
"affected."
msgstr ""
"Altri metodi a due fattori (come WebAuthn e chiavi di sicurezza) non saranno "
"interessati."

msgid "The entered token is not valid."
msgstr "Il token inserito non è valido."

msgid "Recovery token"
msgstr "Token di recupero"

msgid ""
"Recovery codes can only be used once. Remember to mark used ones as expired."
msgstr ""
"I codici di recupero possono essere utilizzati solo una volta. Ricordati di "
"contrassegnare quelli usati come scaduti."

msgid "Enter the code from the app"
msgstr "Inserisci il codice dall'app"

#. Translators: Audit log entry
msgid "Password changed."
msgstr "Password modificata."

#. Translators: Audit log entry
#, python-brace-format
msgid "Rate limit exceeded for {scope} at {path}."
msgstr "Limite di frequenza superato per {scope} su {path}."

#. Translators: Audit log entry
#, python-brace-format
msgid "Username changed from {old} to {new}."
msgstr "È cambiato il nome utente da {old} a {new}."

#. Translators: Audit log entry
#, python-brace-format
msgid "E-mail changed from {old} to {new}."
msgstr "È stata modificata l'e-mail da {old} a {new}."

#. Translators: Audit log entry
#, python-brace-format
msgid "Full name changed from {old} to {new}."
msgstr "È stato modificato il nome completo da {old} a {new}."

#. Translators: Audit log entry
msgid "Password reset requested."
msgstr "È richiesta la reimpostazione della password."

#. Translators: Audit log entry
msgid "Password reset confirmed, password turned off."
msgstr "Reimpostazione della password confermata, password disattivata."

#. Translators: Audit log entry
#, python-brace-format
msgid "Configured sign in using {method} ({name})."
msgstr "Configura accesso usando {method} ({name})."

#. Translators: Audit log entry
#, python-brace-format
msgid "Removed sign in using {method} ({name})."
msgstr "Rimuovi accesso usando {method} ({name})."

#. Translators: Audit log entry
#, python-brace-format
msgid "Signed in using {method} ({name})."
msgstr "Accesso eseguito usando {method} ({name})."

#. Translators: Audit log entry
#, python-brace-format
msgid "Signed in using {method} ({name}) from a new device."
msgstr "Accesso eseguito usando {method} ({name}) da un nuovo dispositivo."

#. Translators: Audit log entry
msgid "Somebody attempted to register with your e-mail."
msgstr "Qualcuno ha tentato di registrarsi con la tua e-mail."

msgid "Somebody attempted to register using your e-mail address."
msgstr "Qualcuno ha tentato di registrarsi usando il tuo indirizzo e-mail."

#. Translators: Audit log entry
#, python-brace-format
msgid "Could not sign in using {method} ({name})."
msgstr "Impossibile accedere usando {method} ({name})."

#. Translators: Audit log entry
msgid "Account locked due to many failed sign in attempts."
msgstr ""
"Account bloccato a causa di eccessivi tentativi di accesso non riusciti."

#. Translators: Audit log entry
msgid "Account locked by the site administrator."
msgstr "Account bloccato dall'amministratore del sito."

#. Translators: Audit log entry
msgid "Account and all private data removed."
msgstr "Account e tutti i dati privati rimossi."

#. Translators: Audit log entry
#, python-brace-format
msgid "Account removal confirmation sent to {email}."
msgstr "Conferma rimozione dell'account inviata a {email}."

#. Translators: Audit log entry
#, python-brace-format
msgid "Agreement with General Terms and Conditions {date}."
msgstr "Accordo con Termini e condizioni generali {date}."

#. Translators: Audit log entry
#, python-brace-format
msgid "Invited to {site_title} by {username}."
msgstr "Invito per {site_title} da {username}."

#. Translators: Audit log entry
#, python-brace-format
msgid "Accepted invitation from {username}."
msgstr "Invito accettato da {username}."

#. Translators: Audit log entry
msgid "Started trial period."
msgstr "Periodo di prova iniziato."

#. Translators: Audit log entry
#, python-brace-format
msgid "Sent confirmation mail to {email}."
msgstr "Invia e-mail di conferma a {email}."

msgid ""
"The system created a user to track authorship of translations uploaded by "
"other user."
msgstr ""
"Il sistema ha creato un utente per monitorare la paternità delle traduzioni "
"caricate da un altro utente."

msgid ""
"Account created externally from weblate.org for access to purchased services."
msgstr ""
"Account creato esternamente a weblate.org per l'accesso ai servizi "
"acquistati."

#. Translators: Audit log entry
#, python-brace-format
msgid "Access to project {project} was blocked."
msgstr "L’accesso al progetto {project} è stato bloccato."

#. Translators: Audit log entry
msgid "User was enabled by administrator."
msgstr "L'utente è stato abilitato dall'amministratore."

#. Translators: Audit log entry
msgid "User was disabled by administrator."
msgstr "L'utente è stato disabilitato dall'amministratore."

msgid "User was disabled because the access has expired."
msgstr "L'utente è stato disabilitato perché l'accesso è scaduto."

#, python-brace-format
msgid "User was added to the site-wide {team} team by {username}."
msgstr ""
"L'utente è stato aggiunto alla squadra a livello di sito {team} da {username}"
"."

#, python-brace-format
msgid "User access to the site-wide {team} team was changed by {username}."
msgstr ""
"L'accesso dell'utente alla squadra a livello di sito {team} è stato "
"modificato da {username}."

#, python-brace-format
msgid "User was removed from the site-wide {team} team by {username}."
msgstr ""
"L'utente è stato rimosso dalla squadra a livello di sito {team} da {username}"
"."

#. Translators: Audit log entry
msgid "Superuser privileges granted."
msgstr "Concessi privilegi da superuser."

#. Translators: Audit log entry
msgid "Superuser privileges revoked."
msgstr "Revocati privilegi da superuser."

#. Translators: Audit log entry
msgid "Semiannual support status review was displayed."
msgstr "È stata visualizzata la revisione semestrale dello stato del supporto."

#. Translators: Audit log entry
#, python-brace-format
msgid "User was added to the {team} team by {username}."
msgstr "L'utente è stato aggiunto alla squadra {team} da {username}."

#, python-brace-format
msgid "User access to the {team} team was changed by {username}."
msgstr ""
"L'accesso dell'utente alla squadra {team} è stato modificato da {username}."

#. Translators: Audit log entry
#, python-brace-format
msgid "User was removed from the {team} team by {username}."
msgstr "L'utente è stato rimosso dalla squadra {team} da {username}."

#. Translators: Audit log entry
#, python-brace-format
msgid "Project token for {project} was created."
msgstr "L’accesso al progetto {project} è stato creato."

#. Translators: Audit log entry
#, python-brace-format
msgid "Project token for {project} was removed."
msgstr "Il token del progetto {project} è stato rimosso."

msgid "Two-factor authentication recovery codes were generated"
msgstr ""
"Sono stati generati codici di ripristino dell'autenticazione a due fattori"

msgid "Two-factor authentication recovery codes were viewed"
msgstr ""
"Sono stati visualizzati i codici di ripristino dell'autenticazione a due "
"fattori"

#. Translators: Audit log entry
#, python-brace-format
msgid "Two-factor authentication added: {device}"
msgstr "Aggiunta autenticazione a due fattori: {device}"

#. Translators: Audit log entry
#, python-brace-format
msgid "Two-factor authentication removed: {device}"
msgstr "Rimossa autenticazione a due fattori: {device}"

#. Translators: Audit log entry
#, python-brace-format
msgid "Two-factor authentication sign in using {device}"
msgstr "Accedi con l'autenticazione a due fattori tramite {device}"

#, python-brace-format
msgid "Two-factor authentication failed using {device_type}"
msgstr "Autenticazione a due fattori non riuscita tramite {device_type}"

#. Translators: Audit log entry
msgid "Configured password to sign in."
msgstr "Password configurata per l'accesso."

#. Translators: Audit log entry
msgid "Signed in using password."
msgstr "Accesso eseguito con password."

#. Translators: Audit log entry
msgid "Signed in using password from a new device."
msgstr "Accesso eseguito con password da un nuovo dispositivo."

#. Translators: Audit log entry
msgid "Could not sign in using password."
msgstr "Impossibile accedere usando la password."

#. Translators: Audit log entry
#, python-brace-format
msgid "Invited to {project} by {username}."
msgstr "Invitato in {project} da {username}."

#. Translators: Audit log entry
msgid "Password configured."
msgstr "Password configurata."

msgid "To restore access to your account, please reset your password."
msgstr "Per ripristinare l'accesso al tuo account, reimposta la password."

msgid "Please contact project maintainers if you feel this is inappropriate."
msgstr ""
"Si prega di contattare i manutentori del progetto se si ritiene che questo "
"sia inappropriato."

msgid "If it was you, reset your password to regain access to your account."
msgstr ""
"Se sei stato tu, resetta la tua password per riottenere l'accesso "
"all'account."

