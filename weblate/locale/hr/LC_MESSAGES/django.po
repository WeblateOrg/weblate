msgctxt "No known user"
msgid "None"
msgstr "Nepoznat"

msgid "User avatar"
msgstr "Korisnički avatar"

msgid ""
"This e-mail address is already in use. Please supply a different e-mail "
"address."
msgstr "Ova se e-mail adresa već koristi. Upiši jednu drugu e-mail adresu."

msgid "This username is already taken. Please pick something else."
msgstr "Ovo se korisničko ime već koristi. Odaberi nešto drugo."

msgid "Full name"
msgstr "Ime i prezime"

msgid "Name is also used in version control commits."
msgstr "Ime se također koristi u promjenama kontrole verzija."

msgid "Commit e-mail"
msgstr "E-mail adresa podnositelja promjene"

msgid "Use account e-mail address"
msgstr "Koristi e-mail adresu računa"

msgid ""
"Used in version-control commits. The address stays in the repository forever "
"once changes are committed by Weblate."
msgstr ""
"Koristi se u promjenama u sustavu kontrole verzija. Adresa zauvijek ostaju u "
"repozitoriju nakon što se promjene izvrše na Weblateu."

msgid "Commit name"
msgstr "Ime promjene"

msgid ""
"Used in version control commits. The name stays in the repository forever, "
"once changes are committed by Weblate."
msgstr ""
"Koristi se u promjenama u sustavu kontrole verzija. Ime zauvijek ostaje u "
"repozitoriju nakon što se promjene izvrše na Weblateu."

msgid "Public e-mail"
msgstr "Javna e-mail adresa"

msgid "Hide e-mail address from public view"
msgstr "Sakrij e-mail adresu iz javnog prikaza"

#, python-format
msgid "Component list: %s"
msgstr "Popis komponenti: %s"

msgid "Account e-mail"
msgstr "E-mail adresa računa"

msgid ""
"Used for e-mail notifications and as a commit e-mail if it is not configured "
"below."
msgstr ""
"Koristi se za e-mail obavijesti i kao e-mail adresa podnositelja promjene "
"ako nije konfigurirano niže dolje."

msgid "Human verification"
msgstr "Ljudska provjera"

#, python-format
