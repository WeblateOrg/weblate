msgid "You will receive a notification for every such event in %(project)s."
msgstr "Magkakaroon ka ng abiso para sa bawat pangyayari sa %(project)s."

#, python-format
msgid "You will receive a notification for every such event in %(component)s."
msgstr "Magkakaroon ka ng abiso para sa bawat pangyayari sa %(component)s."

msgid ""
"You will only receive these notifications for your translated languages in "
"non-watched projects."
msgstr ""
"Matatanggap mo lamang ang mga abiso na ito para sa iyong mga sinasalin na "
"wika sa mga hindi pinapanood na proyekto."

msgid ""
"You will only receive these notifications for your translated languages in "
"your watched projects."
msgstr ""
"Matatanggap mo lamang ang mga abiso na ito para sa iyong mga sinasalin na "
"wika sa iyong mga pinapanood na proyekto."

msgid ""
"You will only receive these notifications for your translated languages in "
"projects where you have admin permissions."
msgstr ""
"Matatanggap mo lamang ang mga abiso na ito para sa iyong mga sinasalin na "
"wika sa mga proyekto kung saan may pangangasiwa ka na pahintulot."

#, python-format
msgid ""
"You will only receive these notifications for your translated languages in "
"%(project)s."
msgstr ""
"Matatanggap mo lamang ang mga abiso na ito para sa iyong mga sinasalin na "
"wika sa %(project)s."

#, python-format
msgid ""
"You will only receive these notifications for your translated languages in "
"%(component)s."
msgstr ""
"Matatanggap mo lamang ang mga abiso na ito para sa iyong mga sinasalin na "
"wika sa %(component)s."

