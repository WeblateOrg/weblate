msgid ""
"No matching flag found for \"%s\"; press Enter to add it as a custom flag."
msgstr ""
"Nenhuma `flag` correspondente foi encontrada para \"%s\", pressione `Enter` "
"para adicioná-la como uma `flag` personalizada."

msgid "Image Pasted!"
msgstr "Imagem colada!"

msgid "Press Ctrl+V or Command+V to paste an image."
msgstr "Pressione Ctrl+V ou Command+V para colar uma imagem."

msgid "No image found in clipboard"
msgstr "Nenhuma imagem encontrada na área de transferência"

