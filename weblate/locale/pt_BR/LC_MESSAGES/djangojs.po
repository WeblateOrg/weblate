msgstr "Erro: %s"

msgid "Network error"
msgstr "Erro de Rede"

msgid "Invalid server response"
msgstr "Resposta inválida do Servidor"

msgid ""
"Accepting the suggestions takes longer than expected, reload the page to see "
"the result."
msgstr ""
"A aceitação das sugestões está levando mais tempo do que o esperado, "
"recarregue a página para ver o resultado."

#, javascript-format
msgid "Server error (%s)"
msgstr "Erro do Servidor (%s)"

msgid "There are no pending suggestions from %(username)s in %(translation)s."
msgstr "Não há sugestões pendentes de %(username)s em %(translation)s."

msgid ""
"This will accept %(count)s suggestion from %(username)s in %(translation)s."
msgid_plural ""
"This will accept %(count)s suggestions from %(username)s in %(translation)s."
msgstr[0] "Isso aceitará %(count)s sugestão de %(username)s em %(translation)s."
msgstr[1] "Isso aceitará %(count)s sugestões de %(username)s em %(translation)s."

