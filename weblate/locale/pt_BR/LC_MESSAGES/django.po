msgctxt "No known user"
msgid "None"
msgstr "Nenhum"

msgid "User avatar"
msgstr "Avatar do usuário"

msgid ""
"This e-mail address is already in use. Please supply a different e-mail "
"address."
msgstr ""
"Este endereço de e-mail já está em uso. Por favor forneça um endereço de e-"
"mail diferente."

msgid "This username is already taken. Please pick something else."
msgstr "Este nome de usuário já está sendo usado. Por favor, escolha outro."

msgid "Full name"
msgstr "Nome completo"

msgid "Name is also used in version control commits."
msgstr "O nome também é usado em commits de controle de versão."

msgid "Commit e-mail"
msgstr "E-mail de commit"

msgid "Use account e-mail address"
msgstr "Usar endereço de e-mail da conta"

msgid ""
"Used in version-control commits. The address stays in the repository forever "
"once changes are committed by Weblate."
msgstr ""
"Usado em commits de controle de versão. O endereço permanece no repositório "
"para sempre uma vez que as alterações sejam commitadas pelo Weblate."

msgid "Commit name"
msgstr "Nome do commit"

msgid ""
"Used in version control commits. The name stays in the repository forever, "
"once changes are committed by Weblate."
msgstr ""
"Usado em commits de controle de versão. O nome permanece no repositório para "
"sempre uma vez que as alterações sejam enviadas pelo Weblate."

msgid "Public e-mail"
msgstr "E-mail público"

msgid "Hide e-mail address from public view"
msgstr "Manter endereços de e-mail privados"

#, python-format
msgid "Component list: %s"
msgstr "Lista de componentes: %s"

msgid "Account e-mail"
msgstr "E-mail da conta"

msgid ""
"Used for e-mail notifications and as a commit e-mail if it is not configured "
"below."
msgstr ""
"Usado para notificações por e-mail e como um e-mail de commit se não estiver "
"configurado abaixo."

msgid "Human verification"
msgstr "Verificação humana"

