msgctxt "No known user"
msgid "None"
msgstr "بلا"

msgid "User avatar"
msgstr "الصورة الرمزية للمستخدم"

msgid ""
"This e-mail address is already in use. Please supply a different e-mail "
"address."
msgstr ""
"هذا البريد الإلكتروني قيد الاستخدام بالفعل. يرجى تقديم عنوان بريد إلكتروني "
"مختلف."

msgid "This username is already taken. Please pick something else."
msgstr "اسم المستخدم هذا محجوز مسبقاً. يرجى اختيار غيره."

msgid "Full name"
msgstr "الاسم الكامل"

msgid "Name is also used in version control commits."
msgstr "يستعمل الاسم أيضا في إيداعات نظام التحكم بالإصدار."

msgid "Commit e-mail"
msgstr "البريد الإلكتروني للإيداع"

msgid "Use account e-mail address"
msgstr "استعمل البريد الإلكتروني في الحساب"

msgid ""
"Used in version-control commits. The address stays in the repository forever "
"once changes are committed by Weblate."
msgstr ""
"يستخدم في إيداعات التحكم بالإصدار. سيبقى هذا العنوان في المستودع إلى الأبد "
"بمجرد أن يودع Weblate التغييرات."

msgid "Commit name"
msgstr "اسم الإيداع"

msgid ""
"Used in version control commits. The name stays in the repository forever, "
"once changes are committed by Weblate."
msgstr ""
"يستخدم في إيداعات التحكم بالإصدار. سيبقى هذا الاسم في المستودع إلى الأبد "
"بمجرد أن يودع Weblate التغييرات."

msgid "Public e-mail"
msgstr "البريد الإلكتروني العمومي"

msgid "Hide e-mail address from public view"
msgstr "إخفاء عنوان البريد الإلكتروني عن العامة."

#, python-format
msgid "Component list: %s"
msgstr "قائمة المكونات: %s"

msgid "Account e-mail"
msgstr "البريد الإلكتروني للحساب"

msgid ""
"Used for e-mail notifications and as a commit e-mail if it is not configured "
"below."
msgstr "يُستخدم لإشعارات البريد الإلكتروني ويكون الإيداع به ما لم يخصص أدناه."

msgid "Human verification"
msgstr "تحقق يدوي"

