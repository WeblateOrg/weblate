msgstr "إعادة توليد مفتاح API"

msgid ""
"Leave enabled to revoke the current API key and generate a new one. This is "
"recommended if you suspect your password was compromised. Disable it to keep "
"your current API key active after changing your password."
msgstr ""
"‌اترك الخيار مُفعّلاً لإلغاء مفتاح API الحالي وإنشاء مفتاح جديد. يُنصح بهذا "
"الخيار إذا كنت تشك في اختراق كلمة مرورك. عطّله للحفاظ على مفتاح API الحالي "
"فعالاً بعد تغيير كلمة مرورك."

msgid "Your password has been changed."
msgstr "تم تغيير كلمة السر."

msgid "Current password"
msgstr "كلمة السر الحالية"

msgid "Leave empty if you have not set a password yet."
msgstr "اتركه فارغًا إن لم تعين كلمة سر."

msgid "You have entered an invalid password."
msgstr "لقد أدخلت كلمة سر خاطئة."

msgid "Username or e-mail"
msgstr "اسم المستخدم أو البريد الإلكتروني"

msgid "Password"
msgstr "كلمة السر"

msgid "Please enter the correct username and password."
msgstr "من فضلك أدخِل اسم المستخدم و كلمة السر الصحيحة."

msgid "This account is inactive."
msgstr "هذا الحساب ليس نشطًا."

msgid "Component wide notifications"
msgstr "إشعارات على نطاق المكونات"

msgid "Translation notifications"
msgstr "إشعارات الترجمة"

msgid "Use default setting"
msgstr "استخدام الإعداد الإفتراضي"

msgid "Other projects"
msgstr "مشاريع اخرى"

msgid "Watched projects"
msgstr "المشاريع المُراقبة"

msgid "Managed projects"
msgstr "المشاريع المُدارة"

msgid "Project: {}"
msgstr "المشروع: {}"

msgid "Component: {}"
msgstr "المكون: {}"

msgid ""
"You will receive a notification for every such event in non-watched projects."
msgstr "سوف تستقبل إشعارًا عند كل حدث يحدث في المشاريع التي لا تراقبها."

msgid ""
"You will receive a notification for every such event in your watched "
"projects."
msgstr "سوف تستقبل إشعارًا عند كل حدث يحدث في المشاريع التي تراقبها."

msgid ""
"You will receive a notification for every such event in projects where you "
"have admin permissions."
msgstr ""
"سوف تستقبل إشعارًا عند كل حدث يحدث في المشاريع التي لديك فيها أذونات إدارية."

#, python-format
msgid "You will receive a notification for every such event in %(project)s."
msgstr "سوف تستقبل إشعارًا عند كل حدث يحدث في %(project)s."

#, python-format
msgid "You will receive a notification for every such event in %(component)s."
msgstr "سوف تستقبل إشعارًا عند كل حدث يحدث في %(component)s."

msgid ""
"You will only receive these notifications for your translated languages in "
"non-watched projects."
msgstr ""
"سوف تستقبل هذا الإشعار فقط في اللغات التي تترجمها في المشاريع التي لا "
"تراقبها."

msgid ""
"You will only receive these notifications for your translated languages in "
"your watched projects."
msgstr ""
"سوف تستقبل هذا الإشعار فقط في اللغات التي تترجمها في المشاريع التي تراقبها."

msgid ""
"You will only receive these notifications for your translated languages in "
"projects where you have admin permissions."
msgstr ""
"سوف تتلقى فقط هذه الإشعارات للغاتك المترجمة في المشاريع التي لديك أذونات "
"المسؤول."

#, python-format
msgid ""
"You will only receive these notifications for your translated languages in "
"%(project)s."
msgstr "سوف تستقبل هذا الإشعار فقط في اللغات التي تترجم لها في %(project)s."

#, python-format
msgid ""
"You will only receive these notifications for your translated languages in "
"%(component)s."
msgstr ""
"سوف تستقبل هذه الإشعارات فقط في اللغات التي تترجم لها في %(component)s."

msgid "Username"
msgstr "اسم المستخدم"

msgid "Date joined"
msgstr "تاريخ الانضمام"

msgid "Translations made"
msgstr "الترجمات المُقدمة"

