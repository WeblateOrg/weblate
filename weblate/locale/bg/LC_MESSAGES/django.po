msgstr "Екип за целия уеб сайт"

msgid "Remove user from this team"
msgstr "Премахване на потребителя от този екип"

#, python-format
msgid "Blocked until %(expiry)s"
msgstr "Блокиран(а) до %(expiry)s"

msgid "Blocked permanently"
msgstr "Блокиран за постоянно"

msgid "Unblock user"
msgstr "Деблокиране на потребителя"

msgid "Add user to a team"
msgstr "Добавяне на потребител към екип"

msgid "Edit user"
msgstr "Редактиране на потребителя"

msgid "The user has two-factor authentication."
msgstr "Потребителят има двустепенно удостоверяване."

msgid "The user doesn't have two-factor authentication."
msgstr "Потребителят няма двустепенно удостоверяване."

msgid "Turn off two-factor authentication"
msgstr "Изключване на двустепенното удостоверяване"

msgid "Disables password authentication for the user."
msgstr "Изключва удостоверяването чрез парола за потребителя."

msgid "Leave enabled to revoke the current API key and generate a new one."
msgstr ""
"Оставете включено, за да се анулира текущия ключ за ППИ и да се създаде нов."

msgid "Disable password"
msgstr "Изключване на паролата"

msgid "Contribution cleanup"
msgstr "Изчистване на приноса"

#, python-format
msgid ""
"Clean up translations, suggestions, and comments from %(user)s across all "
"projects."
msgstr ""
"Изчистване на преводи, предложения и коментари направени от %(user)s във "
"всички проекти."

msgid "Choose cleanup actions"
msgstr "Изберете действия за изчистване"

msgid "Close"
msgstr "Затваряне"

#, python-format
msgid ""
"Choose which contributions by <b>%(user)s</b> to clean up across all "
"projects."
msgstr ""
"Изберете какво от направеното от <b>%(user)s</b> да бъде изчистено от всички "
"проекти."

msgid "Clean up selected contributions"
msgstr "Изчистване на избрани приноси"

msgid "Account removal deletes all user private data."
msgstr "Изтриването на акаунта ще премахне всички лични данни на потребителя."

msgid "Delete"
msgstr "Изтриване"

msgid "Are you absolutely sure?"
msgstr "Наистина ли искате това?"

#, python-format
msgid "This will remove <b>%(user)s</b> from Weblate."
msgstr "Това ще премахне <b>%(user)s</b> от Weblate."

#, python-format
msgid "You are leaving Weblate to open a profile link provided by %(user)s."
msgstr ""
"Напускате Weblate, за да отворите профилна връзка, предоставена от %(user)s."

#, python-format
msgid "Destination: %(link)s"
msgstr "Дестинация: %(link)s"

msgid "Only continue if you trust this destination."
msgstr "Продължете само, ако имате доверие на тази дестинация."

msgid "Continue"
msgstr "Продължаване"

msgid "Sign in using the security key"
msgstr "Вписване чрез секретен ключ"

msgid "Unfortunately, your browser has no WebAuthn support."
msgstr "За съжаление, браузърът Ви не поддържа WebAuthn."

msgid "Configuration"
msgstr "Настройка"

msgid "Logs"
msgstr "Журнал"

msgid "Add-ons"
msgstr "Добавки"

msgid "Manage"
msgstr "Управление"

msgid "Compatibility"
msgstr "Съвместимост"

msgid "Project root"
msgstr "Корен на проекта"

msgid "Compatible"
msgstr "Съвместимо"

msgid "Not compatible"
msgstr "Несъвместимо"

msgid "No components found."
msgstr "Няма намерени компоненти."

msgid "Configure add-on"
msgstr "Настройка на добавката"

msgid "This add-on has no settings."
msgstr "Тази добавка няма настройки."

msgid "Run add-on"
msgstr "Изпълнение на добавката"

msgid "Schedule this add-on to run as soon as possible."
msgstr "Насрочване на изпълнението на тази добавка възможно най-скоро."

msgid "Run now"
msgstr "Стартиране сега"

msgid "Danger zone"
msgstr "Опасна зона"

msgid ""
"Uninstalling the add-on stops it from running and removes its configuration."
msgstr ""
"Деинсталирането на добавката прекратява възможността тя да се изпълнява и "
"премахва настройките ѝ."

msgid "Uninstall"
msgstr "Деинсталиране"

msgid "The add-on can only be installed on the component."
msgstr "Добавката може да бъде инсталирана само за компонента."

msgid "This add-on is used for all components sharing this repository."
msgstr ""
"Тази добавка се използва за всички компоненти, споделящи това хранилище."

msgid "History"
msgstr "История"

msgid "No add-ons currently installed"
msgstr "В момента няма инсталирани добавки"

#, python-format
msgid "Installed %(count)s add-on"
msgid_plural "Installed %(count)s add-ons"
msgstr[0] "Инсталирана е %(count)s добавка"
msgstr[1] "Инсталирани са %(count)s добавки"

msgid "Inherited from"
msgstr "Наследено от"

msgid "Managed at a scope you do not have access to."
msgstr "Управлява се на ниво, до което нямате достъп."

msgid "Available add-ons"
msgstr "Налични добавки"

msgid "The add-on can only be installed on the component level."
msgstr "Добавката може да бъде инсталирана само на ниво компонент."

msgid "Install"
msgstr "Инсталиране"

msgid ""
"Could not find any additional add-ons compatible with this translation "
"component."
msgstr ""
"Не могат да бъдат открити добавки, съвместими с този компонент за превод."

msgid "Some add-ons will ask for additional configuration during installation."
msgstr ""
"Някои добавки ще изискват допълнителна настройка по време на инсталацията."

msgid "Browse all add-on changes"
msgstr "Всички промени по добавките"

msgid "Add-on Activity Logs"
msgstr "Дневник за действията на добавката"

msgid "Status"
msgstr "Състояние"

msgid "Event"
msgstr "Събитие"

msgid "Details"
msgstr "Подробности"

msgid "No add-on activity logs available."
msgstr "Няма налични дневници за действията на добавката."

msgid "Previous"
msgstr "Предходен"

msgid "Next"
