msgstr ""
"Запазваме си правото да отхвърляме неподходящо съдържание (еротика, хазарт и "
"т.н.)."

msgid "Get started"
msgstr "Начало"

msgid "Looking for commercial hosting?"
msgstr "Търсите ли платен хостинг?"

