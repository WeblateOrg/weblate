msgstr "Относно Weblate"

msgid "Support Weblate"
msgstr "Подкрепете Weblate"

msgid "Help <strong>Weblate</strong> keep thriving"
msgstr "Помогнете на <strong>Weblate</strong> да продължи да се развива"

msgid "Welcome and thank you for supporting Weblate"
msgstr "Добре дошли и благодарим, че използвате Weblate"

msgid "Welcome and thank you for choosing Weblate"
msgstr "Добре дошли и благодарим, че използвате Weblate"

