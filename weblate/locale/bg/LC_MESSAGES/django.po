msgstr "Име на работното пространство"

msgid "Managed name"
msgstr "Управлявано име"

msgid "Whether Weblate can update the name automatically."
msgstr "Дали Weblate може да обновява името автоматично."

msgid ""
"Uses the pool of shared translations between projects in this workspace."
msgstr ""
"Използва съвкупността от споделени преводи между проектите в това работно "
"пространство."

msgid ""
"Contributes translations to the pool shared between projects in this "
"workspace."
msgstr ""
"Допринася към съвкупността от споделените преводи между проектите в това "
"работно пространство."

msgid ""
"Contributor license agreement which needs to be approved before a user can "
"translate components in this workspace."
msgstr ""
"Лицензионно споразумение за принос, което трябва да бъде прието, преди "
"потребителят да може да превежда компоненти в това работно пространство."

msgid "The workspace cannot be removed because it is still being used."
msgstr ""
"Работното пространство не може да бъде премахнато, защото все още се "
"използва."

msgid "The workspace has been removed."
msgstr "Работното пространство е премахнато."

