msgstr "ໃຊ້ຂໍ້ຄວາມບັນທຶກການປ່ຽນແປງເມື່ອລວມການແປທີ່ກຳນົດໄວ້ໃນໝວດໝູ່ແມ່ ຫຼື ໂຄງການ."

msgid "Commit message when add-on makes a change"
msgstr "ຂໍ້ຄວາມບັນທຶກການປ່ຽນແປງເມື່ອສ່ວນເສີມເຮັດການປ່ຽນແປງ"

msgid "Inherit commit message when add-on makes a change"
msgstr "ສືບທອດຂໍ້ຄວາມບັນທຶກການປ່ຽນແປງເມື່ອສ່ວນເສີມເຮັດການປ່ຽນແປງ"

msgid ""
"Use the commit message when add-on makes a change configured in the parent "
"category or project."
msgstr "ໃຊ້ຂໍ້ຄວາມບັນທຶກການປ່ຽນແປງເມື່ອສ່ວນເສີມເຮັດການປ່ຽນແປງທີ່ກຳນົດໄວ້ໃນໝວດໝູ່ແມ່ ຫຼື ໂຄງການ."

msgid "Merge request message"
msgstr "ຂໍ້ຄວາມຄຳຮ້ອງຂໍລວມ (Merge request)"

msgid "Inherit merge request message"
msgstr "ສືບທອດຂໍ້ຄວາມຄຳຮ້ອງຂໍລວມ"

msgid ""
"Use the merge request message configured in the parent category or project."
msgstr "ໃຊ້ຂໍ້ຄວາມຄຳຮ້ອງຂໍລວມທີ່ກຳນົດໄວ້ໃນໝວດໝູ່ແມ່ ຫຼື ໂຄງການ."

msgid "Parent category has to be in the same project!"
msgstr "ໝວດໝູ່ແມ່ຕ້ອງຢູ່ໃນໂຄງການດຽວກັນ!"

msgid "Parent category has to be different!"
msgstr "ໝວດໝູ່ແມ່ຕ້ອງແຕກຕ່າງກັນ!"

msgid "Repository path for this category already exists and is not empty."
msgstr "ເສັ້ນທາງຄັງເກັບ (Repository) ສຳລັບໝວດໝູ່ນີ້ມີຢູ່ແລ້ວ ແລະ ບໍ່ໄດ້ວ່າງເປົ່າ."

msgid "Component created from scratch"
msgstr "ສ່ວນປະກອບຖືກສ້າງຂຶ້ນໃໝ່ທັງໝົດ"

msgid "Component created as a branch"
msgstr "ສ່ວນປະກອບຖືກສ້າງຂຶ້ນເປັນສາຂາ (Branch)"

msgid "Component created via API"
msgstr "ສ່ວນປະກອບຖືກສ້າງຂຶ້ນຜ່ານ API"

msgid "Component created from version control"
msgstr "ສ່ວນປະກອບຖືກສ້າງຂຶ້ນຈາກລະບົບຄວບຄຸມເວີຊັນ"

msgid "Component created via ZIP upload"
msgstr "ສ່ວນປະກອບຖືກສ້າງຂຶ້ນຜ່ານການອັບໂຫລດໄຟລ໌ ZIP"

msgid "Component created via document upload"
msgstr "ສ່ວນປະກອບຖືກສ້າງຂຶ້ນຜ່ານການອັບໂຫລດເອກະສານ"

#. Translators: condensed rendering of a change action in history
#, python-format
msgid "%(action)s at %(time)s on %(translation)s by %(user)s"
msgstr "%(action)s ເວລາ %(time)s ໃນ %(translation)s ໂດຍ %(user)s"

#. Translators: condensed rendering of a change action in history
#, python-format
msgid "%(action)s at %(time)s on %(translation)s"
msgstr "%(action)s ເວລາ %(time)s ໃນ %(translation)s"

msgid "Source needs review"
msgstr "ຕົ້ນສະບັບຕ້ອງການການກວດສອບ"

msgid "Merge"
msgstr "ລວມ (Merge)"

msgid "Rebase"
msgstr "Rebase"

msgid "Merge without fast-forward"
msgstr "ລວມໂດຍບໍ່ໃຊ້ fast-forward"

msgid ""
"Option is not available for linked repositories. Setting from linked "
"component will be used."
msgstr "ຕົວເລືອກນີ້ບໍ່ມີໃຫ້ສຳລັບຄັງເກັບທີ່ເຊື່ອມໂຍງ. ຈະໃຊ້ການຕັ້ງຄ່າຈາກສ່ວນປະກອບທີ່ເຊື່ອມໂຍງແທນ."

msgid ""
"This field is managed by the repository integration and can not be changed."
msgstr "ຟິນນີ້ຖືກຈັດການໂດຍການເຊື່ອມໂຍງຄັງເກັບ ແລະ ບໍ່ສາມາດປ່ຽນແປງໄດ້."

msgid ""
"Version control system to use to access your repository containing "
"translations. You can also choose additional integration with third party "
"providers to submit pull/merge requests."
msgstr ""
"ລະບົບຄວບຄຸມເວີຊັນທີ່ຈະໃຊ້ເພື່ອເຂົ້າເຖິງຄັງເກັບຂອງທ່ານທີ່ມີການແປ. "
"ທ່ານຍັງສາມາດເລືອກການເຊື່ອມໂຍງເພີ່ມເຕີມກັບຜູ້ໃຫ້ບໍລິການພາຍນອກເພື່ອສົ່ງ pull/merge requests."

#, fuzzy
#| msgid "Version control settings"
msgid "Version control parameters"
msgstr "ການຕັ້ງຄ່າລະບົບຄວບຄຸມເວີຊັນ"

msgid ""
"URL of a repository, use weblate://project/component to share it with other "
"component."
msgstr "URL ຂອງຄັງເກັບ, ໃຊ້ weblate://project/component ເພື່ອແບ່ງປັນກັບສ່ວນປະກອບອື່ນ."

msgid "Repository push URL"
msgstr "URL ສຳລັບ push ຄັງເກັບ"

msgid ""
"URL of a push repository, pushing is turned off if empty. When using pull/"
"merge requests, keep empty to fork the repository."
msgstr ""
"URL ຂອງຄັງເກັບສຳລັບ push, ການ push ຈະຖືກປິດຫາກວ່າງເປົ່າ. ເມື່ອໃຊ້ pull/merge requests, "
"ໃຫ້ປະຫວ່າງໄວ້ເພື່ອ fork ຄັງເກັບ."

msgid "Repository browser"
msgstr "ຕົວເບິ່ງຄັງເກັບ"

msgid ""
"Link to repository browser, use {{branch}} for branch, {{filename}} and "
"{{line}} as filename and line placeholders. You might want to strip leading "
"directory by using {{filename|parentdir}}."
msgstr ""
"ລິ້ງໄປຫາຕົວເບິ່ງຄັງເກັບ, ໃຊ້ {{branch}} ສຳລັບສາຂາ, {{filename}} ແລະ {{line}} "
"ເປັນບ່ອນວາງຊື່ໄຟລ໌ ແລະ ແຖວ. ທ່ານອາດຈະຕ້ອງການຕັດໂຟນເດີເລີ່ມຕົ້ນອອກໂດຍໃຊ້ {{filename|"
"parentdir}}."

msgid "Exported repository URL"
msgstr "URL ຄັງເກັບທີ່ສົ່ງອອກ"

msgid "URL of repository where users can fetch changes from Weblate"
msgstr "URL ຂອງຄັງເກັບທີ່ຜູ້ໃຊ້ສາມາດດຶງການປ່ຽນແປງຈາກ Weblate"

msgid "Source string bug reporting address"
msgstr "ທີ່ຢູ່ລາຍງານຂໍ້ຜິດພາດຂອງຂໍ້ຄວາມຕົ້ນສະບັບ"

msgid ""
"E-mail address for reports on errors in source strings. Leave empty for no e-"
"mails."
msgstr "ທີ່ຢູ່ອີເມວສຳລັບລາຍງານຂໍ້ຜິດພາດໃນຂໍ້ຄວາມຕົ້ນສະບັບ. ປະຫວ່າງໄວ້ຫາກບໍ່ຕ້ອງການອີເມວ."

msgid "Repository branch to translate"
msgstr "ສາຂາຄັງເກັບທີ່ຈະແປ"

msgid "Push branch"
msgstr "ສາຂາທີ່ຈະ push"

msgid ""
"Branch for pushing changes. Leave empty to use repository branch when "
"pushing directly to the repository. When using pull/merge requests, specify "
"a branch name different from the repository branch."
msgstr ""
"ສາຂາສຳລັບ push ການປ່ຽນແປງ. ປະຫວ່າງໄວ້ເພື່ອໃຊ້ສາຂາຄັງເກັບເມື່ອ push ໂດຍກົງຫາຄັງເກັບ. ເມື່ອໃຊ້ "
"pull/merge requests, ໃຫ້ລະບຸຊື່ສາຂາທີ່ແຕກຕ່າງຈາກສາຂາຄັງເກັບ."

msgid ""
"Path of files to translate relative to repository root, use * instead of "
"language code, for example: po/*.po or locale/*/LC_MESSAGES/django.po."
msgstr ""
"ເສັ້ນທາງຂອງໄຟລ໌ທີ່ຈະແປທຽບກັບຮາກຂອງຄັງເກັບ, ໃຊ້ * ແທນລະຫັດພາສາ, ຕົວຢ່າງ: po/*.po ຫຼື locale/"
"*/LC_MESSAGES/django.po."

msgid "Screenshot file mask"
msgstr "ໜ້າກາກໄຟລ໌ພາບໜ້າຈໍ"

msgid ""
"Path of screenshots relative to repository root, for example: docs/"
"screenshots/*.png."
msgstr "ເສັ້ນທາງຂອງພາບໜ້າຈໍທຽບກັບຮາກຂອງຄັງເກັບ, ຕົວຢ່າງ: docs/screenshots/*.png."

msgid ""
"Filename of translation base file, containing all strings and their source "
"for monolingual translations."
msgstr ""
"ຊື່ໄຟລ໌ຂອງໄຟລ໌ພື້ນຖານການແປ, ເຊິ່ງປະກອບດ້ວຍຂໍ້ຄວາມທັງໝົດ ແລະ "
"ຕົ້ນສະບັບສຳລັບການແປແບບພາສາພຽງຢ່າງດຽວ (Monolingual)."

msgid "Edit base file"
msgstr "ແກ້ໄຂໄຟລ໌ພື້ນຖານ"

msgid ""
"Whether users will be able to edit the base file for monolingual "
"translations."
msgstr "ຜູ້ໃຊ້ຈະສາມາດແກ້ໄຂໄຟລ໌ພື້ນຖານສຳລັບການແປແບບພາສາພຽງຢ່າງດຽວໄດ້ຫຼືບໍ່."

msgid ""
"Filename of intermediate translation file. In most cases this is a "
"translation file provided by developers and is used when creating actual "
"source strings."
msgstr ""
"ຊື່ໄຟລ໌ຂອງໄຟລ໌ການແປລະຫວ່າງກາງ. ສ່ວນຫຼາຍແມ່ນໄຟລ໌ການແປທີ່ນັກພັດທະນາສະໜອງໃຫ້ ແລະ "
"ຖືກໃຊ້ເມື່ອສ້າງຂໍ້ຄວາມຕົ້ນສະບັບຕົວຈິງ."

msgid ""
"Filename of file used for creating new translations. For gettext choose .pot "
"file."
msgstr "ຊື່ໄຟລ໌ຂອງໄຟລ໌ທີ່ໃຊ້ສຳລັບສ້າງການແປໃໝ່. ສຳລັບ gettext ໃຫ້ເລືອກໄຟລ໌ .pot."

msgid "File format parameters"
msgstr "ພາລາມິເຕີຮູບແບບໄຟລ໌"

msgid "Locked component will not get any translation updates."
msgstr "ສ່ວນປະກອບທີ່ຖືກລັອກຈະບໍ່ໄດ້ຮັບການອັບເດດການແປໃດໆ."

msgid "Do not show glossary matches"
msgstr "ບໍ່ຕ້ອງສະແດງຄຳສັບທີ່ກົງກັບອະພິທານສັບ"

msgid "Hides the glossary panel in the translation editor."
msgstr "ເຊື່ອງແຖບອະພິທານສັບໃນຕົວແກ້ໄຂການແປ."

msgid "Allow translation propagation"
msgstr "ອະນຸຍາດການກະຈາຍການແປ"

msgid ""
"Whether translation updates in other components will cause automatic "
"translation in this one"
msgstr "ການອັບເດດການແປໃນສ່ວນປະກອບອື່ນໆຈະເຮັດໃຫ້ເກີດການແປອັດຕະໂນມັດໃນສ່ວນປະກອບນີ້ຫຼືບໍ່"

msgid "Contribute to project translation memory"
msgstr "ປະກອບສ່ວນເຂົ້າໃນຄວາມຈຳການແປ (Translation memory) ຂອງໂຄງການ"

msgid ""
"Allow this component's translations to be added to the project-level "
"translation memory."
msgstr "ອະນຸຍາດໃຫ້ການແປຂອງສ່ວນປະກອບນີ້ຖືກເພີ່ມເຂົ້າໃນຄວາມຈຳການແປລະດັບໂຄງການ."

msgid "Turn on suggestions"
msgstr "ເປີດໃຊ້ການແນະນຳ"

msgid "Whether to allow translation suggestions at all."
msgstr "ຈະອະນຸຍາດໃຫ້ມີການແນະນຳການແປຫຼືບໍ່."

msgid "Suggestion voting"
msgstr "ການລົງຄະແນນສຽງການແນະນຳ"

msgid "Allows users to vote on suggestions."
msgstr "ອະນຸຍາດໃຫ້ຜູ້ໃຊ້ລົງຄະແນນສຽງໃນຄຳແນະນຳ."

msgid "Automatically accept suggestions"
msgstr "ຍອມຮັບການແນະນຳໂດຍອັດຕະໂນມັດ"

msgid ""
"Automatically accept suggestions with this number of votes, use 0 to turn it "
"off."
msgstr "ຍອມຮັບການແນະນຳໂດຍອັດຕະໂນມັດເມື່ອມີຄະແນນສຽງເຖິງຈຳນວນນີ້, ໃຊ້ 0 ເພື່ອປິດການໃຊ້ງານ."

msgid "Enforced checks"
msgstr "ການກວດສອບທີ່ບັງຄັບ"

msgid "List of checks which can not be dismissed."
msgstr "ລາຍການການກວດສອບທີ່ບໍ່ສາມາດຍົກເລີກໄດ້."

msgid "Use the translation license configured in the category or project."
msgstr "ໃຊ້ໃບອະນຸຍາດການແປທີ່ກຳນົດໄວ້ໃນໝວດໝູ່ ຫຼື ໂຄງການ."

msgid ""
"Contributor license agreement which needs to be approved before a user can "
"translate this component."
msgstr "ຂໍ້ຕົກລົງອະນຸຍາດຜູ້ປະກອບສ່ວນເຊິ່ງຕ້ອງໄດ້ຮັບການອະນຸມັດກ່ອນທີ່ຜູ້ໃຊ້ຈະສາມາດແປສ່ວນປະກອບນີ້ໄດ້."

msgid ""
"Use the contributor license agreement configured in the category or project."
msgstr "ໃຊ້ຂໍ້ຕົກລົງອະນຸຍາດຜູ້ປະກອບສ່ວນທີ່ກຳນົດໄວ້ໃນໝວດໝູ່ ຫຼື ໂຄງການ."

msgid ""
"Use the adding new translations setting configured in the category or "
"project."
msgstr "ໃຊ້ການຕັ້ງຄ່າການເພີ່ມການແປໃໝ່ທີ່ກຳນົດໄວ້ໃນໝວດໝູ່ ຫຼື ໂຄງການ."

msgid "Use the language code style configured in the category or project."
msgstr "ໃຊ້ຮູບແບບລະຫັດພາສາທີ່ກຳນົດໄວ້ໃນໝວດໝູ່ ຫຼື ໂຄງການ."

msgid "Manage strings"
msgstr "ຈັດການຂໍ້ຄວາມ"

msgid ""
"Enables adding and removing strings straight from Weblate. If your strings "
"are extracted from the source code or managed externally you probably want "
"to keep it disabled."
msgstr ""
"ເປີດໃຊ້ການເພີ່ມ ແລະ ລຶບຂໍ້ຄວາມໂດຍກົງຈາກ Weblate. ຫາກຂໍ້ຄວາມຂອງທ່ານຖືກສະກັດຈາກຊອດໂຄ້ດ ຫຼື "
"ຈັດການຈາກພາຍນອກ ທ່ານອາດຈະຕ້ອງການປິດອັນນີ້ໄວ້."

msgid "Merge style"
msgstr "ຮູບແບບການລວມ (Merge style)"

msgid ""
"Define whether Weblate should merge the upstream repository or rebase "
"changes onto it."
msgstr "ກຳນົດວ່າ Weblate ຄວນລວມຄັງເກັບຕົ້ນທາງ (Merge) ຫຼື Rebase ການປ່ຽນແປງໃສ່ມັນ."

msgid ""
"Use the commit message when translating configured in the category or "
"project."
msgstr "ໃຊ້ຂໍ້ຄວາມບັນທຶກການປ່ຽນແປງເມື່ອແປທີ່ກຳນົດໄວ້ໃນໝວດໝູ່ ຫຼື ໂຄງການ."

msgid ""
"Use the commit message when adding translation configured in the category or "
"project."
msgstr "ໃຊ້ຂໍ້ຄວາມບັນທຶກການປ່ຽນແປງເມື່ອເພີ່ມການແປທີ່ກຳນົດໄວ້ໃນໝວດໝູ່ ຫຼື ໂຄງການ."

msgid ""
"Use the commit message when removing translation configured in the category "
"or project."
msgstr "ໃຊ້ຂໍ້ຄວາມບັນທຶກການປ່ຽນແປງເມື່ອລຶບການແປທີ່ກຳນົດໄວ້ໃນໝວດໝູ່ ຫຼື ໂຄງການ."

msgid ""
"Use the commit message when merging translation configured in the category "
"or project."
msgstr "ໃຊ້ຂໍ້ຄວາມບັນທຶກການປ່ຽນແປງເມື່ອລວມການແປທີ່ກຳນົດໄວ້ໃນໝວດໝູ່ ຫຼື ໂຄງການ."

msgid ""
"Use the commit message when add-on makes a change configured in the category "
"or project."
msgstr "ໃຊ້ຂໍ້ຄວາມບັນທຶກການປ່ຽນແປງເມື່ອສ່ວນເສີມເຮັດການປ່ຽນແປງທີ່ກຳນົດໄວ້ໃນໝວດໝູ່ ຫຼື ໂຄງການ."

msgid "Use the merge request message configured in the category or project."
msgstr "ໃຊ້ຂໍ້ຄວາມຄຳຮ້ອງຂໍລວມທີ່ກຳນົດໄວ້ໃນໝວດໝູ່ ຫຼື ໂຄງການ."

msgid "Push on commit"
msgstr "Push ເມື່ອບັນທຶກການປ່ຽນແປງ (Commit)"

msgid "Whether the repository should be pushed upstream on every commit."
msgstr "ຄວນ push ຄັງເກັບໄປຍັງຕົ້ນທາງໃນທຸກໆການ commit ຫຼື ບໍ່."

msgid "Age of changes to commit"
msgstr "ອາຍຸຂອງການປ່ຽນແປງທີ່ຈະ commit"

msgid ""
"Time in hours after which any pending changes will be committed to the VCS."
msgstr "ເວລາເປັນຊົ່ວໂມງທີ່ການປ່ຽນແປງທີ່ຄ້າງຢູ່ຈະຖືກ commit ໄປຍັງ VCS."

msgid "Lock on error"
msgstr "ລັອກເມື່ອເກີດຂໍ້ຜິດພາດ"

msgid "Whether the component should be locked on repository errors."
msgstr "ສ່ວນປະກອບຄວນຖືກລັອກເມື່ອເກີດຂໍ້ຜິດພາດຂອງຄັງເກັບຫຼືບໍ່."

msgid "Language used for source strings in all components"
msgstr "ພາສາທີ່ໃຊ້ສຳລັບຂໍ້ຄວາມຕົ້ນສະບັບໃນທຸກສ່ວນປະກອບ"

msgid ""
"Regular expression used to filter translation files when scanning for file "
"mask."
msgstr "ນິພົດປົກກະຕິ (Regular expression) ທີ່ໃຊ້ເພື່ອຫາໄຟລ໌ການແປເມື່ອສະແກນຫາໜ້າກາກໄຟລ໌."

msgid "Variants regular expression"
msgstr "ນິພົດປົກກະຕິຂອງລຸ້ນຍ່ອຍ (Variants)"

msgid "Regular expression used to determine variants of a string."
msgstr "ນິພົດປົກກະຕິທີ່ໃຊ້ເພື່ອລະບຸລຸ້ນຍ່ອຍຂອງຂໍ້ຄວາມ."

msgid "Components with higher priority are offered first to translators."
msgstr "ສ່ວນປະກອບທີ່ມີລຳດັບຄວາມສຳຄັນສູງກວ່າຈະຖືກສະເໜີໃຫ້ຜູ້ແປກ່ອນ."

msgid "Restricted component"
msgstr "ສ່ວນປະກອບທີ່ຖືກຈຳກັດ"

msgid ""
"Restrict access to the component to only those explicitly given permission."
msgstr "ຈຳກັດການເຂົ້າເຖິງສ່ວນປະກອບສະເພາະຜູ້ທີ່ໄດ້ຮັບອະນຸຍາດຢ່າງຊັດເຈນເທົ່ານັ້ນ."

msgid "Choose additional projects where this component will be listed."
msgstr "ເລືອກໂຄງການເພີ່ມເຕີມທີ່ຈະສະແດງສ່ວນປະກອບນີ້."

msgid "Use as a glossary"
msgstr "ໃຊ້ເປັນອະພິທານສັບ"

msgid ""
"Glossaries are different from regular translations but help keep track of "
"and share consistent terminology."
msgstr "ອະພິທານສັບແຕກຕ່າງຈາກການແປທົ່ວໄປ ແຕ່ຊ່ວຍໃຫ້ຕິດຕາມ ແລະ ແບ່ງປັນຄຳສັບທີ່ສອດຄ່ອງກັນ."

msgid "Glossary color"
msgstr "ສີອະພິທານສັບ"

msgid "Key filter"
msgstr "ຕົວກັ່ນຕອງຄີ"

msgid ""
"Regular expression used to filter keys. This is only available for "
"monolingual formats."
msgstr "ນິພົດປົກກະຕິທີ່ໃຊ້ເພື່ອການກັ່ນຕອງຄີ. ອັນນີ້ມີໃຫ້ສະເພາະຮູບແບບພາສາພຽງຢ່າງດຽວເທົ່ານັ້ນ."

msgid "This setting is inherited from the project if left empty."
msgstr "ການຕັ້ງຄ່ານີ້ຈະຖືກສືບທອດມາຈາກໂຄງການຫາກປະຫວ່າງໄວ້."

msgid "Use the secondary language configured in the category or project."
msgstr "ໃຊ້ພາສາທີສອງທີ່ກຳນົດໄວ້ໃນໝວດໝູ່ ຫຼື ໂຄງການ."

msgid ""
"Could not verify the SSH host key. Please add it on the SSH page in the "
"admin interface."
msgstr "ບໍ່ສາມາດຢືນຢັນຄີ SSH host ໄດ້. ກະລຸນາເພີ່ມມັນຢູ່ໃນໜ້າ SSH ໃນສ່ວນຜູ້ດູແລ."

msgid ""
"The SSH host key for the repository has changed. Verify the new fingerprint, "
"remove the stored host key, and add the new one on the SSH page in the admin "
"interface."
msgstr ""
"ຄີ SSH host ສຳລັບຄັງເກັບມີການປ່ຽນແປງ. ກະລຸນາຢືນຢັນລາຍນິ້ວມືໃໝ່, ລຶບຄີ host ທີ່ເກັບໄວ້, ແລະ "
"ເເພີ່ມຄີໃໝ່ໃນໜ້າ SSH ໃນສ່ວນຜູ້ດູແລ."

msgid ""
"The repository requires authentication, please specify credentials in the "
"URL or use SSH access instead."
msgstr ""
"ຄັງເກັບຕ້ອງການການຢືນຢັນຕົວຕົນ, ກະລຸນາລະບຸຂໍ້ມູນປະຈຳຕົວໃນ URL ຫຼື ໃຊ້ການເຂົ້າເຖິງຜ່ານ SSH ແທນ."

#, python-format
msgid "Could not fetch the repository: %s"
msgstr "ບໍ່ສາມາດດຶງຂໍ້ມູນຄັງເກັບ (Fetch): %s"

msgid "File does not exist."
msgstr "ບໍ່ມີໄຟລ໌ນີ້."

#, python-format
msgid "Could not push %(component)s: %(error_text)s"
msgstr "ບໍ່ສາມາດ push %(component)s: %(error_text)s"

#, python-format
msgid "Push is turned off for %s."
msgstr "ການ push ຖືກປິດໄວ້ສຳລັບ %s."

#, python-format
msgid "Could not reset to remote branch on %s."
msgstr "ບໍ່ສາມາດ reset ໄປຫາສາຂາປາຍທາງໃນ %s."

#, python-format
msgid ""
"Reset the repository, but could not reapply pending translations because "
"%(files)s is missing. Pending changes were kept. To recover, add the file "
"upstream and rescan, or configure the component so Weblate can create the "
"translation file."
msgid_plural ""
"Reset the repository, but could not reapply pending translations because "
"these files are missing: %(files)s. Pending changes were kept. To recover, "
"add the files upstream and rescan, or configure the component so Weblate can "
"create the translation files."
msgstr[0] ""
"Reset ຄັງເກັບແລ້ວ, ແຕ່ບໍ່ສາມາດນຳໃຊ້ການແປທີ່ຄ້າງຢູ່ໄດ້ເນື່ອງຈາກໄຟລ໌ເຫຼົ່ານີ້ຫາຍໄປ: %(files)s. "
"ການປ່ຽນແປງທີ່ຄ້າງຢູ່ຖືກເກັບໄວ້. ເພື່ອກູ້ຄືນ, ໃຫ້ເພີ່ມໄຟລ໌ຢູ່ຕົ້ນທາງແລ້ວສະແກນໃໝ່, ຫຼື ຕັ້ງຄ່າສ່ວນປະກອບເພື່ອໃຫ້ "
"Weblate ສາມາດສ້າງໄຟລ໌ການແປໄດ້."

#, python-format
msgid ""
"File synchronization could not recreate %(files)s because it is missing. "
"Pending changes were kept. To recover, add the file upstream and rescan, or "
"configure the component so Weblate can create the translation file."
msgid_plural ""
"File synchronization could not recreate these files because they are "
"missing: %(files)s. Pending changes were kept. To recover, add the files "
"upstream and rescan, or configure the component so Weblate can create the "
"translation files."
msgstr[0] ""
"ການປະສານຂໍ້ມູນໄຟລ໌ບໍ່ສາມາດສ້າງ %(files)s ຂຶ້ນໃໝ່ໄດ້ເນື່ອງຈາກມັນຫາຍໄປ. "
"ການປ່ຽນແປງທີ່ຄ້າງຢູ່ຖືກເກັບໄວ້. ເພື່ອກູ້ຄືນ, ໃຫ້ເພີ່ມໄຟລ໌ຢູ່ຕົ້ນທາງແລ້ວສະແກນໃໝ່, ຫຼື ຕັ້ງຄ່າສ່ວນປະກອບເພື່ອໃຫ້ "
"Weblate ສາມາດສ້າງໄຟລ໌ການແປໄດ້."

#, python-format
msgid ""
"Reset the repository, but could not recreate %(file)s while reapplying "
"pending translations. Pending changes were kept."
msgstr ""
"Reset ຄັງເກັບແລ້ວ, ແຕ່ບໍ່ສາມາດສ້າງ %(file)s ຂຶ້ນໃໝ່ໃນຂະນະທີ່ນຳໃຊ້ການແປທີ່ຄ້າງຢູ່. "
"ການປ່ຽນແປງທີ່ຄ້າງຢູ່ຖືກເກັບໄວ້."

#, python-format
msgid ""
"File synchronization could not recreate %(file)s before committing pending "
"translations. Pending changes were kept."
msgstr ""
"ການປະສານຂໍ້ມູນໄຟລ໌ບໍ່ສາມາດສ້າງ %(file)s ຂຶ້ນໃໝ່ກ່ອນການ commit ການແປທີ່ຄ້າງຢູ່. "
"ການປ່ຽນແປງທີ່ຄ້າງຢູ່ຖືກເກັບໄວ້."

#, python-format
msgid ""
"Reset the repository, but could not recreate %(files)s while reapplying "
"pending translations. Pending changes were kept."
msgid_plural ""
"Reset the repository, but could not recreate these files while reapplying "
"pending translations: %(files)s. Pending changes were kept."
msgstr[0] ""
"Reset ຄັງເກັບແລ້ວ, ແຕ່ບໍ່ສາມາດສ້າງໄຟລ໌ເຫຼົ່ານີ້ຂຶ້ນໃໝ່ໃນຂະນະທີ່ນຳໃຊ້ການແປທີ່ຄ້າງຢູ່: %(files)s. "
"ການປ່ຽນແປງທີ່ຄ້າງຢູ່ຖືກເກັບໄວ້."

#, python-format
msgid ""
"File synchronization could not recreate %(files)s before committing pending "
"translations. Pending changes were kept."
msgid_plural ""
"File synchronization could not recreate these files before committing "
"pending translations: %(files)s. Pending changes were kept."
msgstr[0] ""
"ການປະສານຂໍ້ມູນໄຟລ໌ບໍ່ສາມາດສ້າງໄຟລ໌ເຫຼົ່ານີ້ຂຶ້ນໃໝ່ກ່ອນການ commit ການແປທີ່ຄ້າງຢູ່: %(files)s. "
"ການປ່ຽນແປງທີ່ຄ້າງຢູ່ຖືກເກັບໄວ້."

msgid ""
"Reset the repository, but could not recreate pending translations. Pending "
"changes were kept."
msgstr "Reset ຄັງເກັບແລ້ວ, ແຕ່ບໍ່ສາມາດສ້າງການແປທີ່ຄ້າງຢູ່ຂຶ້ນໃໝ່. ການປ່ຽນແປງທີ່ຄ້າງຢູ່ຖືກເກັບໄວ້."

msgid ""
"File synchronization could not recreate pending translations. Pending "
"changes were kept."
msgstr "ການປະສານຂໍ້ມູນໄຟລ໌ບໍ່ສາມາດສ້າງການແປທີ່ຄ້າງຢູ່ຂຶ້ນໃໝ່. ການປ່ຽນແປງທີ່ຄ້າງຢູ່ຖືກເກັບໄວ້."

#, python-format
msgid "Could not clean the repository on %s."
