msgid "You can point newcomers to the introduction page at %(engage_link)s."
msgstr "ທ່ານສາມາດແນະນຳຜູ້ມາໃໝ່ໄປຫາໜ້າແນະນຳໄດ້ທີ່ %(engage_link)s."

msgid "Promoting specific translations"
msgstr "ການໂປຣໂມດການແປສະເພາະຢ່າງ"

msgid ""
"Besides promoting the whole translation project, you can also choose a "
"specific language or component to promote:"
msgstr ""
"ນອກຈາກການໂປຣໂມດທັງໂຄງການແລ້ວ, ທ່ານຍັງສາມາດເລືອກພາສາ ຫຼື ສ່ວນປະກອບສະເພາະເພື່ອໂປຣໂມດໄດ້:"

msgid "Image widgets"
msgstr "ວິດເຈັດຮູບພາບ"

msgid ""
"You can use the following widgets to promote translation of your project. "
"They can increase the visibility of your translation projects and bring in "
"new contributors."
msgstr ""
"ທ່ານສາມາດໃຊ້ວິດເຈັດຕໍ່ໄປນີ້ເພື່ອໂປຣໂມດການແປຂອງໂຄງການ. ພວກມັນຈະຊ່ວຍເພີ່ມການເບິ່ງເຫັນ ແລະ "
"ດຶງດູດຜູ້ປະກອບສ່ວນໃໝ່ໆ."

msgid "Widget"
msgstr "ວິດເຈັດ"

msgid "Code"
msgstr "ໂຄ້ດ"

msgid "BBCode"
msgstr "BBCode"

msgid "Markdown"
msgstr "Markdown"

msgid "Textile code"
msgstr "ໂຄ້ດ Textile"

msgid "Live Preview"
msgstr "ຕົວຢ່າງສະແດງຜົນ"

msgid "Embed code copied to clipboard."
msgstr "ສຳເນົາໂຄ້ດຝັງ (embed code) ລົງໃນຄລິບບອດແລ້ວ."

msgid "Embed Code"
msgstr "ໂຄ້ດຝັງ (Embed Code)"

msgid "Browse all workspace changes"
msgstr "ເບິ່ງການປ່ຽນແປງທັງໝົດໃນພື້ນທີ່ເຮັດວຽກ"

msgid ""
"The workspace cannot be removed while it contains projects. Move or remove "
"the projects first."
msgstr "ພື້ນທີ່ເຮັດວຽກບໍ່ສາມາດຖືກລຶບອອກໄດ້ໃນຂະນະທີ່ມີໂຄງການຢູ່. ໃຫ້ຍ້າຍ ຫຼື ລຶບໂຄງການອອກກ່ອນ."

msgid "A workspace associated with billing cannot be removed."
msgstr "ພື້ນທີ່ເຮັດວຽກທີ່ກ່ຽວຂ້ອງກັບການຊຳລະເງິນບໍ່ສາມາດຖືກລຶບອອກໄດ້."

msgid "I understand the consequences, delete this workspace"
msgstr "ຂ້ອຍເຂົ້າໃຈຜົນທີ່ຕາມມາ, ລຶບພື້ນທີ່ເຮັດວຽກນີ້"

#, python-format
msgid ""
"This action cannot be undone. This will permanently delete the %(object)s "
"workspace and all related workspace data."
msgstr ""
"ການກະທຳນີ້ບໍ່ສາມາດຍົກເລີກໄດ້. ນີ້ຈະລຶບພື້ນທີ່ເຮັດວຽກ %(object)s ແລະ "
"ຂໍ້ມູນພື້ນທີ່ເຮັດວຽກທີ່ກ່ຽວຂ້ອງທັງໝົດຢ່າງຖາວອນ."

msgid ""
"This includes workspace access-control teams, translation memory, and code-"
"hosting connections."
msgstr ""
"ນີ້ລວມເຖິງທີມງານຄວບຄຸມການເຂົ້າເຖິງພື້ນທີ່ເຮັດວຽກ, ຄວາມຈຳການແປ, ແລະ ການເຊື່ອມຕໍ່ການໂຮສລະຫັດ."

msgid "Workspace to remove"
msgstr "ພື້ນທີ່ເຮັດວຽກທີ່ຈະລຶບອອກ"

msgid "Open in full editor"
msgstr "ເປີດໃນຕົວແກ້ໄຂແບບເຕັມ"

msgid "Collapse"
msgstr "ຍໍ້ລົງ"

msgid "The translation has come to an end."
msgstr "ການແປໄດ້ມາເຖິງຈຸດສິ້ນສຸດແລ້ວ."

msgid "Edit in single string mode"
msgstr "ແກ້ໄຂໃນໂໝດຂໍ້ຄວາມດຽວ"

msgid "Exit Zen"
msgstr "ອອກຈາກໂໝດ Zen"

msgid "A translation file was synchronized with its repository."
msgstr "ໄຟລ໌ການແປຖືກຊິງໂຄຣໄນກັບຄັງເກັບຂໍ້ມູນແລ້ວ."

msgid "Resource updated"
msgstr "ຊັບພະຍາກອນຖືກອັບເດດແລ້ວ"

msgid ""
"A language translation became fully translated after an individual edit. "
"Automatic translation, uploads, and bulk edits do not emit this event."
msgstr ""
"ການແປພາສານັ້ນສຳເລັດສົມບູນຫຼັງຈາກມີການແກ້ໄຂເປັນລາຍບຸກຄົນ. ການແປອັດຕະໂນມັດ, ການອັບໂຫຼດ ແລະ "
"ການແກ້ໄຂເປັນກຸ່ມຈະບໍ່ສ້າງເຫດການນີ້."

msgid "Translation completed"
msgstr "ການແປສຳເລັດແລ້ວ"

msgid "An existing translation was edited by a user."
msgstr "ການແປທີ່ມີຢູ່ຖືກແກ້ໄຂໂດຍຜູ້ໃຊ້."

msgid "Translation changed"
msgstr "ການແປມີການປ່ຽນແປງ"

msgid "A comment was added to a string."
msgstr "ມີການເພີ່ມຄຳຄິດເຫັນລົງໃນຂໍ້ຄວາມ."

msgid "Comment added"
msgstr "ເພີ່ມຄຳຄິດເຫັນແລ້ວ"

msgid "A translation suggestion was added."
msgstr "ມີການເພີ່ມຂໍ້ແນະນຳການແປ."

msgid "A previously untranslated string was translated by a user."
msgstr "ຂໍ້ຄວາມທີ່ຍັງບໍ່ເຄີຍແປມາກ່ອນ ຖືກແປໂດຍຜູ້ໃຊ້ແລ້ວ."

msgid "Translation added"
msgstr "ເພີ່ມການແປແລ້ວ"

msgid ""
"A translation was added or changed by automatic translation. This is emitted "
"instead of Translation added or Translation changed."
msgstr ""
"ການແປຖືກເພີ່ມ ຫຼື ປ່ຽນແປງໂດຍການແປອັດຕະໂນມັດ. ເຫດການນີ້ຈະສະແດງແທນການເພີ່ມ ຫຼື "
"ການປ່ຽນແປງການແປແບບປົກກະຕິ."

msgid "A translation suggestion was accepted as the translation."
msgstr "ຂໍ້ແນະນຳການແປຖືກຍອມຮັບໃຫ້ເປັນການແປຕົວຈິງ."

msgid "Suggestion accepted"
msgstr "ຍອມຮັບຂໍ້ແນະນຳແລ້ວ"

msgid "A translation was restored to an earlier value."
msgstr "ການແປຖືກກູ້ຄືນກັບໄປເປັນຄ່າກ່ອນໜ້ານີ້."

msgid "Translation reverted"
msgstr "ຍົກເລີກການປ່ຽນແປງການແປແລ້ວ"

msgid ""
"A translation was added or changed by a translation file upload. This is "
"emitted instead of Translation added or Translation changed."
msgstr ""
"ການແປຖືກເພີ່ມ ຫຼື ປ່ຽນແປງໂດຍການອັບໂຫຼດໄຟລ໌ການແປ. ເຫດການນີ້ຈະສະແດງແທນການເພີ່ມ ຫຼື "
"ການປ່ຽນແປງການແປແບບປົກກະຕິ."

msgid "Translation uploaded"
msgstr "ອັບໂຫຼດການແປແລ້ວ"

msgid "A source string was added outside repository or upload updates."
msgstr "ຂໍ້ຄວາມຕົ້ນສະບັບຖືກເພີ່ມຈາກພາຍນອກຄັງເກັບຂໍ້ມູນ ຫຼື ການອັບໂຫຼດ."

msgid "Source string added"
msgstr "ເພີ່ມຂໍ້ຄວາມຕົ້ນສະບັບແລ້ວ"

msgid "A component was locked for translation."
msgstr "ສ່ວນປະກອບຖືກລັອກບໍ່ໃຫ້ແປ."

msgid "Component locked"
msgstr "ສ່ວນປະກອບຖືກລັອກ"

msgid "A component was unlocked for translation."
msgstr "ສ່ວນປະກອບຖືກປົດລັອກເພື່ອໃຫ້ແປໄດ້."

msgid "Component unlocked"
msgstr "ສ່ວນປະກອບຖືກປົດລັອກ"

msgid "Pending component changes were committed."
msgstr "ການປ່ຽນແປງສ່ວນປະກອບທີ່ຄ້າງຢູ່ຖືກຄອມມິດແລ້ວ."

msgid "Changes committed"
msgstr "ຄອມມິດການປ່ຽນແປງແລ້ວ"

msgid "Repository changes were pushed upstream."
msgstr "ການປ່ຽນແປງໃນຄັງເກັບຂໍ້ມູນຖືກສົ່ງ (push) ໄປຕົ້ນທາງແລ້ວ."

msgid "Changes pushed"
msgstr "ສົ່ງ (push) ການປ່ຽນແປງແລ້ວ"

msgid "A repository was reset to its upstream state."
msgstr "ຄັງເກັບຂໍ້ມູນຖືກຕັ້ງຄ່າໃໝ່ (reset) ໃຫ້ຄືກັບສະພາບຕົ້ນທາງ."

msgid "Repository reset"
msgstr "ຣີເຊັດຄັງເກັບຂໍ້ມູນແລ້ວ"

msgid "Upstream repository changes were merged."
msgstr "ການປ່ຽນແປງຈາກຄັງເກັບຂໍ້ມູນຕົ້ນທາງຖືກຮວມ (merge) ແລ້ວ."

msgid "Repository merged"
msgstr "ຮວມຄັງເກັບຂໍ້ມູນແລ້ວ"

msgid "Repository changes were rebased on upstream."
msgstr "ການປ່ຽນແປງໃນຄັງເກັບຂໍ້ມູນຖືກ rebase ເທິງຕົ້ນທາງແລ້ວ."

msgid "Repository rebased"
msgstr "Rebase ຄັງເກັບຂໍ້ມູນແລ້ວ"

msgid "Merging upstream repository changes failed."
msgstr "ການຮວມ (merge) ການປ່ຽນແປງຈາກຕົ້ນທາງລົ້ມເຫຼວ."

msgid "Repository merge failed"
msgstr "ການຮວມຄັງເກັບຂໍ້ມູນລົ້ມເຫຼວ"

msgid "Rebasing repository changes failed."
msgstr "ການ Rebase ການປ່ຽນແປງໃນຄັງເກັບຂໍ້ມູນລົ້ມເຫຼວ."

msgid "Repository rebase failed"
msgstr "ການ Rebase ຄັງເກັບຂໍ້ມູນລົ້ມເຫຼວ"

msgid "Weblate could not parse a translation file."
msgstr "Weblate ບໍ່ສາມາດວິເຄາະໄຟລ໌ການແປໄດ້."

msgid "Parsing failed"
msgstr "ການວິເຄາະລົ້ມເຫຼວ"

msgid "A language translation was removed."
msgstr "ການແປພາສາຖືກລຶບອອກແລ້ວ."

msgid "Translation removed"
msgstr "ລຶບການແປອອກແລ້ວ"

msgid "A translation suggestion was removed."
msgstr "ຄຳແນະນຳການແປຖືກລຶບອອກແລ້ວ."

msgid "Suggestion removed"
msgstr "ລຶບຄຳແນະນຳອອກແລ້ວ"

msgid ""
"A translation was changed by a search-and-replace operation. This is emitted "
"instead of Translation changed."
msgstr "ການແປຖືກປ່ຽນແປງໂດຍການຄົ້ນຫາ ແລະ ແທນທີ່. ສິ່ງນີ້ຖືກສະແດງແທນທີ່ ການປ່ຽນແປງການແປ."

msgid "Translation replaced"
msgstr "ແທນທີ່ການແປແລ້ວ"

msgid "Pushing repository changes upstream failed."
msgstr "ການສົ່ງການປ່ຽນແປງຂອງຄັງເກັບຂໍ້ມູນຂຶ້ນໄປຕົ້ນທາງຫຼົ້ມເຫຼວ."

msgid "Repository push failed"
msgstr "ການສົ່ງຂໍ້ມູນຄັງເກັບຂໍ້ມູນຫຼົ້ມເຫຼວ"

msgid "An obsolete translation suggestion was removed during cleanup."
msgstr "ຄຳແນະນຳການແປທີ່ເລີກໃຊ້ແລ້ວຖືກລຶບອອກໃນລະຫວ່າງການອະນາໄມ."

msgid "Suggestion removed during cleanup"
msgstr "ລຶບຄຳແນະນຳອອກໃນລະຫວ່າງການອະນາໄມ"

msgid "A source string was edited in Weblate."
msgstr "ຂໍ້ຄວາມຕົ້ນສະບັບຖືກແກ້ໄຂໃນ Weblate."

msgid "Source string changed"
msgstr "ຂໍ້ຄວາມຕົ້ນສະບັບຖືກປ່ຽນແປງ"

msgid "A new string was added in Weblate."
msgstr "ເພີ່ມຂໍ້ຄວາມໃໝ່ໃນ Weblate ແລ້ວ."

msgid "String added"
msgstr "ເພີ່ມຂໍ້ຄວາມແລ້ວ"

msgid "The translation state of one or more strings was changed in bulk."
msgstr "ສະຖານະການແປຂອງໜຶ່ງຂໍ້ຄວາມ ຫຼື ຫຼາຍກວ່ານັ້ນຖືກປ່ຽນແປງແບບກຸ່ມ."

msgid "Bulk status changed"
msgstr "ສະຖານະແບບກຸ່ມຖືກປ່ຽນແປງ"

msgid "Project or component visibility was changed."
msgstr "ການເບິ່ງເຫັນຂອງໂຄງການ ຫຼື ສ່ວນປະກອບຖືກປ່ຽນແປງ."

msgid "Visibility changed"
msgstr "ການເບິ່ງເຫັນຖືກປ່ຽນແປງ"

msgid "A user was granted access."
msgstr "ຜູ້ໃຊ້ໄດ້ຮັບສິດເຂົ້າເຖິງແລ້ວ."

msgid "User added"
msgstr "ເພີ່ມຜູ້ໃຊ້ແລ້ວ"

msgid "A user's access was removed."
msgstr "ສິດເຂົ້າເຖິງຂອງຜູ້ໃຊ້ຖືກລຶບອອກແລ້ວ."

msgid "User removed"
msgstr "ລຶບຜູ້ໃຊ້ອອກແລ້ວ"

msgid "A translation was approved during review."
msgstr "ການແປຖືກອະນຸມັດໃນລະຫວ່າງການກວດສອບ."

msgid "Translation approved"
msgstr "ການແປຖືກອະນຸມັດແລ້ວ"

msgid "A translation was marked as needing editing."
msgstr "ການແປຖືກໝາຍວ່າຕ້ອງການການແກ້ໄຂ."

msgid "Marked for edit"
msgstr "ໝາຍໄວ້ເພື່ອແກ້ໄຂ"

msgid "A translation component was removed."
msgstr "ສ່ວນປະກອບການແປຖືກລຶບອອກແລ້ວ."

msgid "Component removed"
msgstr "ລຶບສ່ວນປະກອບອອກແລ້ວ"

msgid "A translation project was removed."
msgstr "ໂຄງການການແປຖືກລຶບອອກແລ້ວ."

msgid "Project removed"
msgstr "ລຶບໂຄງການອອກແລ້ວ"

msgid "A translation project was renamed."
msgstr "ໂຄງການການແປຖືກປ່ຽນຊື່ແລ້ວ."

msgid "Project renamed"
msgstr "ປ່ຽນຊື່ໂຄງການແລ້ວ"

msgid "A translation component was renamed."
msgstr "ສ່ວນປະກອບການແປຖືກປ່ຽນຊື່ແລ້ວ."

msgid "Component renamed"
msgstr "ປ່ຽນຊື່ສ່ວນປະກອບແລ້ວ"

msgid "A component was moved within a project."
msgstr "ສ່ວນປະກອບຖືກຍ້າຍພາຍໃນໂຄງການ."

msgid "Moved component"
msgstr "ຍ້າຍສ່ວນປະກອບແລ້ວ"

msgid "A user made their first contribution to a translation."
msgstr "ຜູ້ໃຊ້ໄດ້ປະກອບສ່ວນເຂົ້າໃນການແປເປັນຄັ້ງທຳອິດ."

msgid "Contributor joined"
msgstr "ຜູ້ປະກອບສ່ວນເຂົ້າຮ່ວມແລ້ວ"

msgid "An announcement was posted."
msgstr "ປະກາດຖືກໂພສແລ້ວ."

msgid "Announcement posted"
msgstr "ໂພສປະກາດແລ້ວ"

msgid "A component alert was triggered."
msgstr "ການແຈ້ງເຕືອນສ່ວນປະກອບຖືກກະຕຸ້ນ."

msgid "Alert triggered"
msgstr "ການແຈ້ງເຕືອນຖືກກະຕຸ້ນແລ້ວ"

msgid "A language translation was added."
msgstr "ພາສາການແປຖືກເພີ່ມແລ້ວ."

msgid "Language added"
msgstr "ເພີ່ມພາສາແລ້ວ"

msgid "A user requested a new language."
msgstr "ຜູ້ໃຊ້ໄດ້ຮ້ອງຂໍພາສາໃໝ່."

msgid "Language requested"
msgstr "ພາສາຖືກຮ້ອງຂໍແລ້ວ"

msgid "A translation project was created."
msgstr "ໂຄງການການແປຖືກສ້າງຂຶ້ນແລ້ວ."

msgid "Project created"
msgstr "ສ້າງໂຄງການແລ້ວ"

msgid "A translation component was created."
msgstr "ສ່ວນປະກອບການແປຖືກສ້າງຂຶ້ນແລ້ວ."

msgid "Component created"
