msgid "Avatars are provided using %(avatar_url_prefix)s."
msgstr "ຮູບແທນຕົວຖືກສະໜອງໃຫ້ໂດຍ %(avatar_url_prefix)s."

msgid "Pending invitation"
msgstr "ຄຳເຊີນທີ່ຍັງຄ້າງຢູ່"

msgid "Description"
msgstr "ຄຳອະທິບາຍ"

msgid ""
"Get in contact immediately if you notice anything suspicious in the audit "
"log."
msgstr "ຕິດຕໍ່ທັນທີຫາກທ່ານພົບເຫັນສິ່ງຜິດປົກກະຕິໃນບັນທຶກການກວດສອບ."

msgid "When"
msgstr "ເມື່ອໃດ"

