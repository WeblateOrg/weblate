"ການຮ້ອງຂໍ API %(service)s ລົ້ມເຫຼວໃນຂະນະທີ່ສ້າງ pull request (%(status)s): %(error)s "
"ກະລຸນາລອງໃໝ່ໃນພາຍຫຼັງ."

msgid "GitHub App repositories must be imported with a branch."
msgstr "ຄັງເກັບຂໍ້ມູນຂອງ GitHub App ຕ້ອງໄດ້ຮັບການນຳເຂົ້າພ້ອມກັບສາຂາ (Branch)."

msgid "Invalid GitHub App installation ID."
msgstr "ID ການຕິດຕັ້ງ GitHub App ບໍ່ຖືກຕ້ອງ."

msgid "No Weblate GitHub app installation available."
msgstr "ບໍ່ມີການຕິດຕັ້ງ Weblate GitHub app ທີ່ພ້ອມໃຊ້ງານ."

#, python-format
msgid "No Weblate GitHub app installation available for %(hostname)s"
msgstr "ບໍ່ມີການຕິດຕັ້ງແອັບ Weblate GitHub ສຳລັບ %(hostname)s"

#, python-format
msgid "Could not obtain GitHub App access token: %(error)s"
msgstr "ບໍ່ສາມາດຂໍລະຫັດເຂົ້າເຖິງ GitHub App: %(error)s"

msgid "GitHub App components require a project with a workspace."
msgstr "ສ່ວນປະກອບຂອງ GitHub App ຕ້ອງການໂຄງການທີ່ມີພື້ນທີ່ເຮັດວຽກ (Workspace)."

#, python-format
msgid "Could not get GitLab project (%(status)s): %(error)s"
msgstr "ບໍ່ສາມາດດຶງຂໍ້ມູນໂຄງການ GitLab ໄດ້ (%(status)s): %(error)s"

#, python-format
msgid "Could not get GitLab project (%(status)s): Unknown error"
msgstr "ບໍ່ສາມາດເຂົ້າເຖິງໂຄງການ GitLab ໄດ້ (%(status)s): ຂໍ້ຜິດພາດທີ່ບໍ່ຮູ້ຈັກ"

#, python-format
msgid "Pull request listing failed: %(error)s"
msgstr "ການສະແດງລາຍການ pull request ລົ້ມເຫຼວ: %(error)s"

#, python-format
msgid "Pull request listing failed: %(error)s Please retry later."
msgstr "ການສະແດງລາຍການ pull request ລົ້ມເຫຼວ: %(error)s ກະລຸນາລອງໃໝ່ໃນພາຍຫຼັງ."

#, python-format
msgid "Could not fork repository at %(hostname)s"
msgstr "ບໍ່ສາມາດແຍກ (fork) ຄັງເກັບຂໍ້ມູນຢູ່ %(hostname)s"

#, python-format
msgid "Could not fork repository at %(hostname)s. Please retry later."
msgstr "ບໍ່ສາມາດແຍກຄັງເກັບຂໍ້ມູນຢູ່ %(hostname)s. ກະລຸນາລອງໃໝ່ໃນພາຍຫຼັງ."

#, python-format
msgid "Could not fork repository at %(hostname)s: %(error)s"
msgstr "ບໍ່ສາມາດແຍກຄັງເກັບຂໍ້ມູນຢູ່ %(hostname)s: %(error)s"

#, python-format
msgid ""
"Could not fork repository at %(hostname)s: %(error)s Please retry later."
msgstr "ບໍ່ສາມາດແຍກຄັງເກັບຂໍ້ມູນຢູ່ %(hostname)s: %(error)s ກະລຸນາລອງໃໝ່ໃນພາຍຫຼັງ."

#, python-format
msgid ""
"Could not fork repository at %(hostname)s: Repository not found. Check "
"whether exists and user '%(username)s' has access to it."
msgstr ""
"ບໍ່ສາມາດແຍກຄັງເກັບຂໍ້ມູນຢູ່ %(hostname)s: ບໍ່ພົບຄັງເກັບຂໍ້ມູນ. ໃຫ້ກວດເບິ່ງວ່າມັນມີຢູ່ແທ້ຫຼືບໍ່ ແລະ ຜູ້ໃຊ້ "
"'%(username)s' ມີສິດເຂົ້າເຖິງຫຼືບໍ່."

#, python-format
msgid "Repository has an interrupted Git %(operation)s operation."
msgstr "ຄັງເກັບມີການດຳເນີນການ Git %(operation)s ທີ່ຖືກຂັດຈັງຫວະ."

#, python-format
msgid "Could not recover interrupted Git %(operation)s operation."
msgstr "ບໍ່ສາມາດກູ້ຄືນການດຳເນີນການ Git %(operation)s ທີ່ຖືກຂັດຈັງຫວະໄດ້."

msgid "The repository URL permanently redirects to a canonical URL."
msgstr "URL ຂອງຄັງເກັບຂໍ້ມູນປ່ຽນເສັ້ນທາງໄປຫາ URL ຫຼັກແບບຖາວອນ."

msgid "The repository HTTP redirect contains credentials and was rejected."
msgstr "ການປ່ຽນເສັ້ນທາງ HTTP ຂອງຄັງເກັບຂໍ້ມູນມີຂໍ້ມູນການເຂົ້າສູ່ລະບົບ ແລະ ຖືກປະຕິເສດ."

msgid ""
"The repository URL redirects to a different host. Automatic cross-host "
"redirects are disabled for security; update the repository URL manually."
msgstr ""
"URL ຂອງຄັງເກັບຂໍ້ມູນປ່ຽນເສັ້ນທາງໄປຫາໂຮສອື່ນ. "
"ການປ່ຽນເສັ້ນທາງຂ້າມໂຮສອັດຕະໂນມັດຖືກປິດໃຊ້ງານເພື່ອຄວາມປອດໄພ; ໃຫ້ອັບເດດ URL "
"ຂອງຄັງເກັບຂໍ້ມູນດ້ວຍຕົນເອງ."

msgid ""
"The repository URL redirects from HTTPS to an insecure URL and was rejected."
msgstr "URL ຂອງຄັງເກັບຂໍ້ມູນປ່ຽນເສັ້ນທາງຈາກ HTTPS ໄປຫາ URL ທີ່ບໍ່ປອດໄພ ແລະ ຖືກປະຕິເສດ."

msgid "The repository returned an invalid HTTP redirect."
msgstr "ຄັງເກັບຂໍ້ມູນສົ່ງຄືນການປ່ຽນເສັ້ນທາງ HTTP ທີ່ບໍ່ຖືກຕ້ອງ."

msgid "The repository returned an HTTP redirect with an invalid hostname."
msgstr "ຄັງເກັບຂໍ້ມູນສົ່ງຄືນການປ່ຽນເສັ້ນທາງ HTTP ທີ່ມີຊື່ໂຮສບໍ່ຖືກຕ້ອງ."

msgid "The repository HTTP redirect contains a loop."
msgstr "ການປ່ຽນເສັ້ນທາງ HTTP ຂອງຄັງເກັບຂໍ້ມູນມີລັກສະນະວົນຊ້ຳ (loop)."

msgid "The repository redirect target has no validated address."
msgstr "ເປົ້າໝາຍການປ່ຽນເສັ້ນທາງຂອງຄັງເກັບຂໍ້ມູນບໍ່ມີທີ່ຢູ່ທີ່ໄດ້ຮັບການຢືນຢັນ."

msgid "The repository returned a permanent HTTP redirect without a target URL."
msgstr "ຄັງເກັບຂໍ້ມູນສົ່ງຄືນການປ່ຽນເສັ້ນທາງ HTTP ແບບຖາວອນໂດຍບໍ່ມີ URL ເປົ້າໝາຍ."

msgid ""
"The repository HTTP redirect does not point to a Git smart HTTP endpoint."
msgstr "ການປ່ຽນເສັ້ນທາງ HTTP ຂອງຄັງເກັບຂໍ້ມູນບໍ່ໄດ້ຊີ້ໄປຫາຈຸດເຊື່ອມຕໍ່ Git smart HTTP."

#, python-format
msgid "Could not probe the repository HTTP redirect: %(error)s"
msgstr "ບໍ່ສາມາດກວດສອບການປ່ຽນເສັ້ນທາງ HTTP ຂອງຄັງເກັບຂໍ້ມູນໄດ້: %(error)s"

msgid "The repository HTTP redirect unexpectedly changed the URL query."
msgstr ""
"ການປ່ຽນເສັ້ນທາງ HTTP ຂອງຄັງເກັບຂໍ້ມູນມີການປ່ຽນແປງຄຳສັ່ງສອບຖາມ (query) ຂອງ URL ໂດຍບໍ່ຄາດຄິດ."

msgid "The repository HTTP redirect target could not be validated."
msgstr "ເປົ້າໝາຍການປ່ຽນເສັ້ນທາງ HTTP ຂອງຄັງເກັບຂໍ້ມູນບໍ່ສາມາດຖືກກວດສອບໄດ້."

msgid ""
"The repository HTTP redirect target could not be verified as a Git "
"repository."
msgstr "ເປົ້າໝາຍການປ່ຽນເສັ້ນທາງ HTTP ຂອງຄັງເກັບຂໍ້ມູນບໍ່ສາມາດຖືກຢືນຢັນວ່າເປັນຄັງເກັບຂໍ້ມູນ Git."

msgid "The repository returned too many HTTP redirects."
msgstr "ຄັງເກັບຂໍ້ມູນສົ່ງຄືນການປ່ຽນເສັ້ນທາງ HTTP ຫຼາຍເກີນໄປ."

msgid "The repository URL redirects to an unsupported URL scheme."
msgstr "URL ຂອງຄັງເກັບຂໍ້ມູນປ່ຽນເສັ້ນທາງໄປຫາຮູບແບບ URL ທີ່ບໍ່ຮອງຮັບ."

msgid ""
"Remote branch could not be verified against the shallow existing repository."
msgstr "ບໍ່ສາມາດກວດສອບສາຂາປາຍທາງ (Remote branch) ທຽບກັບຄັງເກັບແບບ shallow ທີ່ມີຢູ່ໄດ້."

msgid ""
"Remote branch does not share common history with the existing repository."
msgstr "ສາຂາປາຍທາງບໍ່ມີປະຫວັດການປ່ຽນແປງຮ່ວມກັບຄັງເກັບທີ່ມີຢູ່."

msgid "Could not determine the effective SSH destination."
msgstr "ບໍ່ສາມາດລະບຸປາຍທາງ SSH ທີ່ມີຜົນໄດ້."

#, python-format
msgid "Could not determine the effective SSH destination: %(error)s"
msgstr "ບໍ່ສາມາດລະບຸປາຍທາງ SSH ທີ່ມີຜົນໄດ້: %(error)s"

#, python-format
msgid "Unsupported interrupted Git operation: %(operation)s"
msgstr "ບໍ່ຮອງຮັບການດຳເນີນການ Git ທີ່ຖືກຂັດຈັງຫວະ: %(operation)s"

msgid ""
"This VCS backend cannot safely connect to this URL while private address "
"restrictions are enabled."
msgstr ""
"VCS ແບັກເຄນນີ້ບໍ່ສາມາດເຊື່ອມຕໍ່ກັບ URL ນີ້ໄດ້ຢ່າງປອດໄພໃນຂະນະທີ່ການຈຳກັດທີ່ຢູ່ສ່ວນຕົວຖືກເປີດໃຊ້ງານ."

#, python-format
msgid "Fetching VCS repository from %(hostname)s is not allowed."
msgstr "ບໍ່ອະນຸຍາດໃຫ້ດຶງຄັງເກັບຂໍ້ມູນ VCS ຈາກ %(hostname)s."

msgid "Enter a valid URL."
msgstr "ກະລຸນາໃສ່ URL ທີ່ຖືກຕ້ອງ."

#, python-format
msgid "Could not parse URL: %(error)s"
msgstr "ບໍ່ສາມາດວິເຄາະ URL ໄດ້: %(error)s"

#, python-format
msgid "Fetching VCS repository using %(scheme)s is not allowed."
msgstr "ບໍ່ອະນຸຍາດໃຫ້ດຶງຄັງເກັບຂໍ້ມູນ VCS ໂດຍໃຊ້ %(scheme)s."

#, python-format
msgid "Could not resolve the URL domain: %(error)s"
msgstr "ບໍ່ສາມາດລະບຸໂດເມນຂອງ URL ໄດ້: %(error)s"

msgid "This will push changes to the upstream repository."
msgstr "ນີ້ຈະທຳການ Push ການປ່ຽນແປງໄປຍັງຄັງເກັບ (Repository) ຕົ້ນທາງ."

msgid "Enter a valid GitHub host."
msgstr "ກະລຸນາປ້ອນ GitHub host ທີ່ຖືກຕ້ອງ."

msgid ""
"Use github.com for GitHub.com, or the web hostname for GitHub Enterprise "
"Server."
msgstr ""
"ໃຊ້ github.com ສຳລັບ GitHub.com, ຫຼື ໃຊ້ hostname ຂອງເວັບສຳລັບ GitHub Enterprise "
"Server."

msgid "Organization (optional)"
msgstr "ອົງກອນ (ເລືອກໄດ້)"

msgid ""
"Enter a GitHub organization slug to register the App under that organization "
"instead of your personal account."
msgstr ""
"ປ້ອນ slug ຂອງອົງກອນໃນ GitHub ເພື່ອລົງທະບຽນ App ພາຍໃຕ້ອົງກອນນັ້ນແທນບັນຊີສ່ວນຕົວຂອງທ່ານ."

msgid "Leave blank to register on your personal account"
msgstr "ປະວ່າງໄວ້ເພື່ອລົງທະບຽນໃນບັນຊີສ່ວນຕົວຂອງທ່ານ"

#, python-format
msgid ""
"GitHub App names must be unique and at most %(limit)s characters. You will "
"still be able to change the name on GitHub before confirming."
msgstr ""
"ຊື່ GitHub App ຕ້ອງບໍ່ຊ້ຳໃຜ ແລະ ຍາວບໍ່ເກີນ %(limit)s ຕົວອັກສອນ. ທ່ານຍັງສາມາດປ່ຽນຊື່ໃນ GitHub "
"ໄດ້ກ່ອນທີ່ຈະຢືນຢັນ."

msgid "Public (any GitHub account can install it)"
msgstr "ສາທາລະນະ (ບັນຊີ GitHub ໃດກໍສາມາດຕິດຕັ້ງໄດ້)"

msgid ""
"Required to install the App on more than one user or organization. Public "
"here only means the App is not restricted to its owner; it does not list the "
"App on the GitHub Marketplace."
msgstr ""
"ຈຳເປັນຕ້ອງໃຊ້ເພື່ອຕິດຕັ້ງ App ໃນຜູ້ໃຊ້ ຫຼື ອົງກອນຫຼາຍກວ່າໜຶ່ງບ່ອນ. \"ສາທາລະນະ\" ໃນທີ່ນີ້ໝາຍເຖິງ App "
"ບໍ່ໄດ້ຖືກຈຳກັດໄວ້ສະເພາະເຈົ້າຂອງເທົ່ານັ້ນ; ມັນບໍ່ໄດ້ໝາຍເຖິງການເອົາ App ໄປສະແດງໃນ GitHub "
"Marketplace."

msgid "This will force push changes to the upstream repository."
msgstr "ນີ້ຈະທຳການບັງຄັບ Push ການປ່ຽນແປງໄປຍັງຄັງເກັບຕົ້ນທາງ."

msgid "This will push changes to the upstream Git repository."
msgstr "ນີ້ຈະທຳການ Push ການປ່ຽນແປງໄປຍັງຄັງເກັບ Git ຕົ້ນທາງ."

msgid "Possible cleanups:"
msgstr "ການທຳຄວາມສະອາດທີ່ເປັນໄປໄດ້:"

msgid "This will push changes to Gerrit for a review."
msgstr "ນີ້ຈະທຳການ Push ການປ່ຽນແປງໄປຍັງ Gerrit ເພື່ອລໍຖ້າການກວດສອບ."

msgid "This will commit changes to the Subversion repository."
msgstr "ນີ້ຈະທຳການ Commit ການປ່ຽນແປງໄປຍັງຄັງເກັບ Subversion."

msgid "Git with force push"
msgstr "Git ພ້ອມການບັງຄັບ Push (Force push)"

