#, python-format
msgid "Your password must contain at most %(max_length)d character."
msgid_plural "Your password must contain at most %(max_length)d characters."
msgstr[0] "ລະຫັດຜ່ານຂອງທ່ານຕ້ອງມີຢ່າງຫຼາຍບໍ່ເກີນ %(max_length)d ຕົວອັກສອນ."

msgid "Can not reuse previously used password."
msgstr "ບໍ່ສາມາດໃຊ້ລະຫັດຜ່ານທີ່ເຄີຍໃຊ້ແລ້ວໄດ້ອີກ."

msgid "Your password can't match a password you have used in the past."
msgstr "ລະຫັດຜ່ານຂອງທ່ານບໍ່ສາມາດຊ້ຳກັບລະຫັດຜ່ານທີ່ທ່ານເຄີຍໃຊ້ໃນອະດີດ."

msgid "The registration link has been invalidated."
msgstr "ລິ້ງລົງທະບຽນຖືກຍົກເລີກແລ້ວ."

msgid "The invitation link is no longer valid."
msgstr "ລິ້ງຄຳເຊີນບໍ່ສາມາດໃຊ້ງານໄດ້ອີກຕໍ່ໄປ."

msgid "This invitation has expired."
msgstr "ຄຳເຊີນນີ້ໝົດອາຍຸແລ້ວ."

msgid "You can not complete password reset while signed in."
msgstr "ທ່ານບໍ່ສາມາດດຳເນີນການຕັ້ງລະຫັດຜ່ານໃໝ່ໃຫ້ສຳເລັດ ໃນຂະນະທີ່ຍັງຢູ່ໃນລະບົບ."

msgid "You can not complete registration while signed in."
msgstr "ທ່ານບໍ່ສາມາດດຳເນີນການລົງທະບຽນໃຫ້ສຳເລັດ ໃນຂະນະທີ່ຍັງຢູ່ໃນລະບົບ."

msgid "You can confirm your registration only while signed in."
msgstr "ທ່ານສາມາດຢືນຢັນການລົງທະບຽນໄດ້ສະເພາະຕອນທີ່ຢູ່ໃນລະບົບເທົ່ານັ້ນ."

msgid ""
"This invitation can be accepted only by the e-mail address chosen by the "
"inviter; it can't be used by your account."
msgstr ""
"ຄຳເຊີນນີ້ສາມາດຕອບຮັບໄດ້ສະເພາະທີ່ຢູ່ອີເມວທີ່ຜູ້ເຊີນເລືອກໄວ້ເທົ່ານັ້ນ; ມັນບໍ່ສາມາດໃຊ້ກັບບັນຊີຂອງທ່ານໄດ້."

#, python-brace-format
msgid ""
"Your e-mail no longer belongs to verified account, it has been changed to "
"{0}."
msgstr "ອີເມວຂອງທ່ານບໍ່ໄດ້ເປັນຂອງບັນຊີທີ່ຜ່ານການຢືນຢັນແລ້ວ, ມັນຖືກປ່ຽນເປັນ {0}."

msgid "Use security key (WebAuthn)"
msgstr "ໃຊ້ຄີຄວາມປອດໄພ (WebAuthn)"

msgid "Use authentication app (TOTP)"
msgstr "ໃຊ້ແອັບຢືນຢັນຕົວຕົນ (TOTP)"

msgid "Use recovery codes"
msgstr "ໃຊ້ລະຫັດກູ້ຄືນ"

msgctxt "Theme selection"
msgid "Sync with system"
msgstr "ຊິງຄ໌ກັບລະບົບ"

msgctxt "Theme selection"
msgid "Light"
msgstr "ແຈ້ງ"

msgctxt "Theme selection"
msgid "Dark"
msgstr "ມືດ"

#, python-format
msgid "Security key (%s)"
msgstr "ຄີຄວາມປອດໄພ (%s)"

#, python-format
msgid "Authentication app (%s)"
msgstr "ແອັບຢືນຢັນຕົວຕົນ (%s)"

msgid "Password reset"
msgstr "ຕັ້ງລະຫັດຜ່ານໃໝ່"

msgid "Remove account"
msgstr "ລຶບບັນຊີ"

msgid "User registration"
msgstr "ການລົງທະບຽນຜູ້ໃຊ້"

msgid "Could not send message to administrator."
msgstr "ບໍ່ສາມາດສົ່ງຂໍ້ຄວາມຫາຜູ້ດູແລ."

msgid "Your request has been sent, you will shortly hear from us."
msgstr "ຄຳຮ້ອງຂໍຂອງທ່ານຖືກສົ່ງແລ້ວ, ທ່ານຈະໄດ້ຮັບການຕິດຕໍ່ກັບຈາກພວກເຮົາໃນໄວໆນີ້."

msgid "Your profile has been updated."
msgstr "ໂປຣໄຟລ໌ຂອງທ່ານຖືກປັບປຸງແລ້ວ."

msgid "User profile"
msgstr "ໂປຣໄຟລ໌ຜູ້ໃຊ້"

msgid "Your account has been removed."
msgstr "ບັນຊີຂອງທ່ານຖືກລຶບອອກແລ້ວ."

msgid "Too many messages sent, please try again later."
msgstr "ສົ່ງຂໍ້ຄວາມຫຼາຍເກີນໄປ, ກະລຸນາລອງໃໝ່ໃນພາຍຫຼັງ."

msgid "Contact"
msgstr "ຕິດຕໍ່"

msgid "Hosting"
msgstr "ໂຮສຕິ້ງ"

msgid ""
"Seems you've already requested a trial period recently. Please contact us "
"with your inquiry so we can find the best solution for you."
msgstr ""
"ເບິ່ງຄືວ່າທ່ານຫາກໍ່ຮ້ອງຂໍໄລຍະທົດລອງໃຊ້ຫວ່າງບໍ່ດົນມານີ້. ກະລຸນາຕິດຕໍ່ພວກເຮົາພ້ອມກັບຄຳຖາມຂອງທ່ານ "
"ເພື່ອໃຫ້ພວກເຮົາຊອກຫາທາງອອກທີ່ດີທີ່ສຸດໃຫ້ທ່ານ."

msgid ""
"Your trial period is now up and running; create your translation project and "
"start Weblating!"
msgstr "ໄລຍະທົດລອງໃຊ້ຂອງທ່ານເລີ່ມແລ້ວ; ສ້າງໂຄງການການແປຂອງທ່ານ ແລະ ເລີ່ມໃຊ້ Weblate ໄດ້ເລີຍ!"

msgid "Gratis trial"
msgstr "ທົດລອງໃຊ້ຟຣີ"

msgid "This user can not be edited."
msgstr "ຜູ້ໃຊ້ນີ້ບໍ່ສາມາດແກ້ໄຂໄດ້."

#, python-format
msgid "Reverting edits by %(user)s site-wide was scheduled."
msgstr "ກຳນົດເວລາການຍົກເລີກການແກ້ໄຂໂດຍ %(user)s ທົ່ວທັງເວັບໄຊແລ້ວ."

#, python-format
msgid "Cleaning up contributions by %(user)s site-wide was scheduled."
msgstr "ກຳນົດເວລາການລຶບລ້າງການປະກອບສ່ວນໂດຍ %(user)s ທົ່ວທັງເວັບໄຊແລ້ວ."

msgid "No cleanup action was selected."
msgstr "ບໍ່ໄດ້ເລືອກການດຳເນີນການລຶບລ້າງໃດໆ."

msgid "Website"
msgstr "ເວັບໄຊ"

msgid "Code site"
msgstr "ເວັບໄຊເກັບໂຄ້ດ"

msgid "This profile link is no longer available."
msgstr "ລິ້ງໂປຣໄຟລ໌ນີ້ບໍ່ສາມາດໃຊ້ງານໄດ້ອີກຕໍ່ໄປ."

msgid "External profile link"
msgstr "ລິ້ງໂປຣໄຟລ໌ພາຍນອກ"

msgid "Sign in"
msgstr "ເຂົ້າສູ່ລະບົບ"

msgid "Signed out"
msgstr "ອອກຈາກລະບົບແລ້ວ"

msgid "Register e-mail"
msgstr "ລົງທະບຽນອີເມວ"

msgid "Please confirm your identity using a second factor before proceeding."
msgstr "ກະລຸນາຢືນຢັນຕົວຕົນຂອງທ່ານໂດຍໃຊ້ປັດໄຈທີສອງກ່ອນດຳເນີນການຕໍ່."

msgid "Cannot reset password, e-mail authentication is turned off."
msgstr "ບໍ່ສາມາດຕັ້ງລະຫັດຜ່ານໃໝ່ໄດ້, ການຢືນຢັນຕົວຕົນທາງອີເມວຖືກປິດໄວ້."

msgid "Change password"
msgstr "ປ່ຽນລະຫັດຜ່ານ"

msgid "Password reset has been already completed."
msgstr "ການຕັ້ງລະຫັດຜ່ານໃໝ່ສຳເລັດແລ້ວ."

msgid "Could not remove user identity"
msgstr "ບໍ່ສາມາດລຶບຕົວຕົນຜູ້ໃຊ້ອອກໄດ້"

msgid "Add another identity by confirming your e-mail address first."
msgstr "ເພີ່ມຕົວຕົນອື່ນໂດຍການຢືນຢັນທີ່ຢູ່ອີເມວຂອງທ່ານກ່ອນ."

#, python-format
msgid "Could not authenticate: %s"
msgstr "ບໍ່ສາມາດຢືນຢັນຕົວຕົນ: %s"

msgid "Could not complete registration."
msgstr "ບໍ່ສາມາດລົງທະບຽນໃຫ້ສຳເລັດໄດ້."

msgid "Please check if you have already registered an account."
msgstr "ກະລຸນາກວດສອບເບິ່ງວ່າທ່ານໄດ້ລົງທະບຽນບັນຊີໄວ້ແລ້ວຫຼືບໍ່."

msgid "You can also request a new password, if you have lost your credentials."
msgstr "ທ່ານຍັງສາມາດຮ້ອງຂໍລະຫັດຜ່ານໃໝ່ໄດ້ ຫາກທ່ານເສຍຂໍ້ມູນການເຂົ້າສູ່ລະບົບ."

msgid ""
"Try resetting your password again to verify your identity, the confirmation "
"link probably expired."
msgstr "ລອງຕັ້ງລະຫັດຜ່ານໃໝ່ອີກຄັ້ງເພື່ອຢືນຢັນຕົວຕົນຂອງທ່ານ, ລິ້ງຢືນຢັນອາດຈະໝົດອາຍຸ."

msgid ""
"Try registering again to verify your identity, the confirmation link "
"probably expired."
msgstr "ລອງລົງທະບຽນອີກຄັ້ງເພື່ອຢືນຢັນຕົວຕົນຂອງທ່ານ, ລິ້ງຢືນຢັນອາດຈະໝົດອາຍຸ."

msgid "Could not authenticate due to invalid session state."
msgstr "ບໍ່ສາມາດຢືນຢັນຕົວຕົນໄດ້ ເນື່ອງຈາກສະຖານະເຊດຊັນ (session) ບໍ່ຖືກຕ້ອງ."

msgid "Got no e-mail address from third party authentication service."
msgstr "ບໍ່ໄດ້ຮັບທີ່ຢູ່ອີເມວຈາກບໍລິການຢືນຢັນຕົວຕົນພາຍນອກ."

msgid "Please register using e-mail instead."
msgstr "ກະລຸນາລົງທະບຽນໂດຍໃຊ້ອີເມວແທນ."

msgid "Could not parse RelayState from SAML Identity Provider."
msgstr "ບໍ່ສາມາດວິເຄາະ RelayState ຈາກຜູ້ໃຫ້ບໍລິການຕົວຕົນ SAML ໄດ້."

msgid "New registrations are turned off."
msgstr "ການລົງທະບຽນໃໝ່ຖືກປິດໄວ້."

msgid ""
"Could not authenticate, probably due to an expired token or connection error."
msgstr "ບໍ່ສາມາດຢືນຢັນຕົວຕົນໄດ້, ອາດຈະເປັນຍ້ອນໂທເຄັນໝົດອາຍຸ ຫຼື ຂໍ້ຜິດພາດໃນການເຊື່ອມຕໍ່."

msgid "Authentication cancelled."
msgstr "ການຢືນຢັນຕົວຕົນຖືກຍົກເລີກ."

msgid "The server does not allow authentication."
msgstr "ເຊີບເວີບໍ່ອະນຸຍາດໃຫ້ຢືນຢັນຕົວຕົນ."

msgid "The supplied e-mail address is already in use for another account."
msgstr "ທີ່ຢູ່ອີເມວທີ່ລະບຸຖືກໃຊ້ໂດຍບັນຊີອື່ນແລ້ວ."

msgid "The supplied username is already in use for another account."
msgstr "ຊື່ຜູ້ໃຊ້ທີ່ລະບຸຖືກໃຊ້ໂດຍບັນຊີອື່ນແລ້ວ."

#, python-format
msgid "Authentication failed: %s"
msgstr "ການຢືນຢັນຕົວຕົນຜິດພາດ: %s"

msgid "The supplied user identity is already in use for another account."
msgstr "ຕົວຕົນຜູ້ໃຊ້ທີ່ລະບຸຖືກໃຊ້ໂດຍບັນຊີອື່ນແລ້ວ."

msgid "The authentication provider could not be reached."
msgstr "ບໍ່ສາມາດຕິດຕໍ່ຜູ້ໃຫ້ບໍລິການຢືນຢັນຕົວຕົນໄດ້."

msgid "Notification settings adjusted."
msgstr "ປັບແຕ່ງການຕັ້ງຄ່າການແຈ້ງເຕືອນແລ້ວ."

msgid ""
"The notification change link is no longer valid, please sign in to configure "
"notifications."
msgstr "ລິ້ງປ່ຽນການແຈ້ງເຕືອນບໍ່ສາມາດໃຊ້ງານໄດ້ອີກຕໍ່ໄປ, ກະລຸນາເຂົ້າສູ່ລະບົບເພື່ອຕັ້ງຄ່າການແຈ້ງເຕືອນ."

msgid "The security key was removed."
msgstr "ຄີຄວາມປອດໄພຖືກລຶບອອກແລ້ວ."

#, python-format
msgid "The security key %s was registered."
msgstr "ຄີຄວາມປອດໄພ %s ຖືກລົງທະບຽນແລ້ວ."

msgid "The authentication app was removed."
msgstr "ແອັບຢືນຢັນຕົວຕົນຖືກລຶບອອກແລ້ວ."

#, python-format
msgid "The authentication app %s was registered."
msgstr "ແອັບຢືນຢັນຕົວຕົນ %s ຖືກລົງທະບຽນແລ້ວ."

msgid "Second factor sign in"
msgstr "ການເຂົ້າສູ່ລະບົບດ້ວຍປັດໄຈທີສອງ"

msgid "Automatic translation"
msgstr "ການແປອັດຕະໂນມັດ"

msgid ""
"Automatically translates strings using machine translation or other "
"components."
msgstr "ແປຂໍ້ຄວາມໂດຍອັດຕະໂນມັດໂດຍໃຊ້ການແປດ້ວຍເຄື່ອງຈັກ ຫຼື ສ່ວນປະກອບອື່ນໆ."

msgid "enabled"
msgstr "ເປີດໃຊ້ງານ"

msgid ""
"The repository is outdated, you might not get expected results until you "
"update it."
msgstr "ບ່ອນເກັບຂໍ້ມູນເກົ່າເກີນໄປ, ທ່ານອາດຈະບໍ່ໄດ້ຮັບຜົນຕາມທີ່ຄາດຫວັງຈົນກວ່າທ່ານຈະປັບປຸງມັນ."

msgid "JavaScript localization CDN"
msgstr "CDN ສຳລັບການແປພາສາ JavaScript"

msgid ""
"Publishes translations into content delivery network for use in JavaScript "
"or HTML localization."
msgstr ""
"ເຜີຍແຜ່ການແປເຂົ້າໃນເຄືອຂ່າຍການຈັດສົ່ງເນື້ອຫາ (CDN) ເພື່ອໃຊ້ໃນການແປພາສາ JavaScript ຫຼື HTML."

msgid "Translation files CDN"
msgstr "CDN ສຳລັບໄຟລ໌ການແປ"

msgid "Publishes translation files into a content delivery network."
msgstr "ເຜີຍແຜ່ໄຟລ໌ການແປລົງໃນເຄືອຂ່າຍການສົ່ງເນື້ອຫາ."

msgid "The translation files CDN add-on cannot publish weblate.js."
msgstr "ສ່ວນເສີມ CDN ສຳລັບໄຟລ໌ການແປບໍ່ສາມາດເຜີຍແຜ່ weblate.js ໄດ້."

msgid "Cleanup translation files"
msgstr "ລຶບລ້າງໄຟລ໌ການແປ"

msgid ""
"Update all translation files to match the monolingual base file. For most "
"file formats, this means removing stale translation keys no longer present "
"in the base file."
msgstr ""
"ປັບປຸງໄຟລ໌ການແປທັງໝົດໃຫ້ກົງກັບໄຟລ໌ຕົ້ນສະບັບພາສາດຽວ. ສຳລັບຮູບແບບໄຟລ໌ສ່ວນໃຫຍ່, "
"ນີ້ໝາຍເຖິງການລຶບຄີການແປທີ່ເກົ່າ ແລະ ບໍ່ມີຢູ່ໃນໄຟລ໌ຕົ້ນສະບັບອີກຕໍ່ໄປ."

msgid "Remove blank strings"
msgstr "ລຶບຂໍ້ຄວາມວ່າງ"

msgid "Removes strings without a translation from translation files."
msgstr "ລຶບຂໍ້ຄວາມທີ່ບໍ່ມີການແປອອກຈາກໄຟລ໌ການແປ."

msgid "Reset repository to upstream"
msgstr "ຕັ້ງຄ່າບ່ອນເກັບຂໍ້ມູນຄືນໃໝ່ຕາມຕົ້ນນ້ຳ (upstream)"

msgid "Discards all changes in the Weblate repository each night."
msgstr "ຍົກເລີກການປ່ຽນແປງທັງໝົດໃນບ່ອນເກັບຂໍ້ມູນ Weblate ທຸກໆຄືນ."

msgid "Add missing languages"
msgstr "ເພີ່ມພາສາທີ່ຂາດຫາຍໄປ"

msgid ""
"Ensures a consistent set of languages is used for all components within a "
"project."
msgstr "ຮັບປະກັນວ່າຊຸດພາສາທີ່ໃຊ້ແມ່ນຄືກັນສຳລັບທຸກສ່ວນປະກອບພາຍໃນໂຄງການ."

msgid ""
"This add-on affects the whole project and may create translation files "
"across many components or repositories."
msgstr "ສ່ວນເສີມນີ້ມີຜົນຕໍ່ທັງໂຄງການ ແລະ ອາດຈະສ້າງໄຟລ໌ການແປໃນຫຼາຍສ່ວນປະກອບ ຫຼື ຫຼາຍບ່ອນເກັບຂໍ້ມູນ."

msgid ""
"This add-on affects the whole category and may create translation files "
"across many components or repositories."
msgstr "ສ່ວນເສີມນີ້ມີຜົນຕໍ່ທັງໝວດໝູ່ ແລະ ອາດຈະສ້າງໄຟລ໌ການແປໃນຫຼາຍສ່ວນປະກອບ ຫຼື ຫຼາຍບ່ອນເກັບຂໍ້ມູນ."

msgid ""
"This add-on affects all projects and may create translation files across "
"many components or repositories."
msgstr "ສ່ວນເສີມນີ້ມີຜົນຕໍ່ທຸກໂຄງການ ແລະ ອາດຈະສ້າງໄຟລ໌ການແປໃນຫຼາຍສ່ວນປະກອບ ຫຼື ຫຼາຍບ່ອນເກັບຂໍ້ມູນ."

msgid ""
"The given language maps to a different language. Check language aliases "
"settings."
msgstr "ພາສາທີ່ລະບຸຖືກຈັບຄູ່ກັບພາສາອື່ນ. ກະລຸນາກວດສອບການຕັ້ງຄ່າຊື່ແຝງຂອງພາສາ."

msgid "The given language is used as a source language."
msgstr "ພາສາທີ່ລະບຸຖືກໃຊ້ເປັນພາສາຕົ້ນສະບັບ."

msgid "The language filter timed out."
msgstr "ການກອງພາສາໝົດເວລາ."

msgid "The given language is filtered by the language filter."
msgstr "ພາສາທີ່ລະບຸຖືກຄັດອອກໂດຍຕົວຕອງພາສາ."

msgid "Component discovery"
msgstr "ການຄົ້ນຫາສ່ວນປະກອບ"

msgid ""
"Automatically adds or removes project components based on file changes in "
"the version control system."
msgstr ""
"ເພີ່ມ ຫຼື ລຶບສ່ວນປະກອບຂອງໂຄງການໂດຍອັດຕະໂນມັດ ໂດຍອີງຕາມການປ່ຽນແປງຂອງໄຟລ໌ໃນລະບົບຄວບຄຸມເວີຊັນ."

msgid "Pending"
msgstr "ກຳລັງລໍຖ້າ"

msgid "Success"
msgstr "ສຳເລັດ"

msgid "Error"
msgstr "ຂໍ້ຜິດພາດ"

msgid "Skipped"
msgstr "ຂ້າມແລ້ວ"

msgid "The add-on is not compatible with this component."
msgstr "ສ່ວນເສີມນີ້ບໍ່ເຂົ້າກັນກັບສ່ວນປະກອບນີ້."

msgid "There are no compatible components to process."
msgstr "ບໍ່ມີສ່ວນປະກອບທີ່ເຂົ້າກັນໄດ້ເພື່ອປະມວນຜົນ."

msgid "The add-on is not scheduled to run yet."
msgstr "ສ່ວນເສີມຍັງບໍ່ທັນມີກຳນົດເວລາໃຫ້ເຮັດວຽກ."

msgid "There are no relevant changes to process."
msgstr "ບໍ່ມີການປ່ຽນແປງທີ່ກ່ຽວຂ້ອງເພື່ອປະມວນຜົນ."

msgid "Background processing is disabled."
msgstr "ການປະມວນຜົນເບື້ອງຫຼັງຖືກປິດໃຊ້ງານ."

msgid "The component is not scheduled for background processing today."
msgstr "ສ່ວນປະກອບນີ້ບໍ່ມີກຳນົດການປະມວນຜົນເບື້ອງຫຼັງໃນມື້ນີ້."

msgid "There are no eligible strings to process."
msgstr "ບໍ່ມີຂໍ້ຄວາມທີ່ເໝາະສົມເພື່ອປະມວນຜົນ."

msgid "The target no longer exists."
msgstr "ເປົ້າໝາຍບໍ່ມີຢູ່ແລ້ວ."

msgid "A required file is not available."
msgstr "ບໍ່ມີໄຟລ໌ທີ່ຈຳເປັນ."

msgid "There are no outgoing commits to process."
msgstr "ບໍ່ມີການສົ່ງ (commits) ຂາອອກເພື່ອປະມວນຜົນ."

msgid "The add-on does not apply to this event."
msgstr "ສ່ວນເສີມບໍ່ນຳໃຊ້ກັບເຫດການນີ້."

msgid "No source files are configured."
msgstr "ບໍ່ໄດ້ກຳນົດຄ່າໄຟລ໌ຕົ້ນສະບັບ."

msgid "The configured output path is invalid."
msgstr "ເສັ້ນທາງຂາອອກທີ່ກຳນົດຄ່າໄວ້ບໍ່ຖືກຕ້ອງ."

msgid "The add-on execution failed."
msgstr "ການເຮັດວຽກຂອງສ່ວນເສີມຫຼົ້ມເຫຼວ."

msgid "Example add-on"
msgstr "ຕົວຢ່າງສ່ວນເສີມ"

msgid "This add-on does nothing it is just an example."
msgstr "ສ່ວນເສີມນີ້ບໍ່ໄດ້ເຮັດຫຍັງ ມັນເປັນພຽງແຕ່ຕົວຢ່າງເທົ່ານັ້ນ."

msgid "Execute script before commit"
msgstr "ດຳເນີນການສະຄຣິບກ່ອນການຢືນຢັນການປ່ຽນແປງ (commit)"

msgid "This add-on executes a script."
msgstr "ສ່ວນເສີມນີ້ດຳເນີນການສະຄຣິບ."

msgid "Fedora Messaging"
msgstr "ການສົ່ງຂໍ້ຄວາມ Fedora"

msgid "Sends notifications to a Fedora Messaging compatible AMQP exchange."
msgstr "ສົ່ງການແຈ້ງເຕືອນໄປຫາ AMQP exchange ທີ່ຮອງຮັບ Fedora Messaging."

#, python-format
msgid "Message ID: %(message_id)s"
msgstr "ID ຂໍ້ຄວາມ: %(message_id)s"

#, python-format
msgid ""
"Fedora Messaging publish timed out; the broker connection or delivery "
"confirmation did not complete: %(error)s"
msgstr ""
"ການເຜີຍແຜ່ Fedora Messaging ໝົດເວລາ; ການເຊື່ອມຕໍ່ກັບໂບຣກເກີ ຫຼື ການຢືນຢັນການສົ່ງບໍ່ສຳເລັດ: "
"%(error)s"

#, python-format
msgid ""
"Fedora Messaging publisher service was unavailable; the connection will be "
"recreated on the next attempt: %(error)s"
msgstr ""
"ບໍລິການຜູ້ເຜີຍແຜ່ Fedora Messaging ບໍ່ພ້ອມໃຊ້ງານ; ການເຊື່ອມຕໍ່ຈະຖືກສ້າງໃໝ່ໃນການພະຍາຍາມຄັ້ງຕໍ່ໄປ: "
"%(error)s"

#, python-format
msgid "Fedora Messaging broker returned the message: %(error)s"
msgstr "ໂບຣກເກີ Fedora Messaging ສົ່ງຂໍ້ຄວາມກັບຄືນ: %(error)s"

#, python-format
msgid "Fedora Messaging broker rejected the message: %(error)s"
msgstr "ໂບຣກເກີ Fedora Messaging ປະຕິເສດຂໍ້ຄວາມ: %(error)s"

#, python-format
msgid "Fedora Messaging publish failed: %(error)s"
msgstr "ການເຜີຍແຜ່ Fedora Messaging ຜິດພາດ: %(error)s"

msgid "configured"
msgstr "ຕັ້ງຄ່າແລ້ວ"

msgid "Could not reset Fedora Messaging publisher service."
msgstr "ບໍ່ສາມາດຕັ້ງຄ່າບໍລິການຜູ້ເຜີຍແຜ່ Fedora Messaging ໃໝ່ໄດ້."

msgid "CA certificates must be valid PEM encoded X.509 certificates."
msgstr "ໃບຢັ້ງຢືນ CA ຕ້ອງເປັນໃບຢັ້ງຢືນ X.509 ທີ່ເຂົ້າລະຫັດແບບ PEM ທີ່ຖືກຕ້ອງ."

msgid "Client SSL key must be an unencrypted PEM encoded private key."
msgstr "ຄີ SSL ຂອງຄລາຍແອນ (client) ຕ້ອງເປັນຄີສ່ວນຕົວທີ່ເຂົ້າລະຫັດແບບ PEM ທີ່ບໍ່ໄດ້ຖືກເຂົ້າລະຫັດໄວ້."

msgid "Client SSL certificates must be valid PEM encoded X.509 certificates."
msgstr "ໃບຢັ້ງຢືນ SSL ຂອງຄລາຍແອນ ຕ້ອງເປັນໃບຢັ້ງຢືນ X.509 ທີ່ເຂົ້າລະຫັດແບບ PEM ທີ່ຖືກຕ້ອງ."

#, python-format
msgid "Fedora Messaging broker URL is invalid: %(error)s"
msgstr "URL ໂບຣກເກີ Fedora Messaging ບໍ່ຖືກຕ້ອງ: %(error)s"

#, python-format
msgid ""
"Could not verify TLS connection to the Fedora Messaging broker: %(error)s"
msgstr "ບໍ່ສາມາດກວດສອບການເຊື່ອມຕໍ່ TLS ຫາໂບຣກເກີ Fedora Messaging: %(error)s"

msgid "Flag new source strings as \"Needs checking\""
msgstr "ໝາຍຂໍ້ຄວາມຕົ້ນສະບັບໃໝ່ວ່າ \"ຕ້ອງໄດ້ຮັບການກວດສອບ\""

msgid ""
"Whenever a new source string is imported from the VCS, it is flagged as "
"needing checking in Weblate. This way you can easily filter and edit source "
"strings written by the developers."
msgstr ""
"ທຸກຄັ້ງທີ່ມີການນຳເຂົ້າຂໍ້ຄວາມຕົ້ນສະບັບໃໝ່ຈາກ VCS, ມັນຈະຖືກໝາຍວ່າຕ້ອງໄດ້ຮັບການກວດສອບໃນ Weblate. "
"ວິທີນີ້ເຮັດໃຫ້ທ່ານສາມາດຄັດຕອງ ແລະ ແກ້ໄຂຂໍ້ຄວາມຕົ້ນສະບັບທີ່ຂຽນໂດຍນັກພັດທະນາໄດ້ງ່າຍຂຶ້ນ."

msgid "Flag new translations as \"Needs rewriting\""
msgstr "ໝາຍການແປໃໝ່ວ່າ \"ຕ້ອງໄດ້ຮັບການຂຽນໃໝ່\""

msgid ""
"Whenever a new translatable string is imported from the VCS, it is flagged "
"as needing rewriting in Weblate. This way you can easily filter and edit "
"translations created by the developers."
msgstr ""
"ທຸກຄັ້ງທີ່ມີການນຳເຂົ້າຂໍ້ຄວາມທີ່ແປໄດ້ໃໝ່ຈາກ VCS, ມັນຈະຖືກໝາຍວ່າຕ້ອງໄດ້ຮັບການຂຽນໃໝ່ໃນ Weblate. "
"ວິທີນີ້ເຮັດໃຫ້ທ່ານສາມາດຄັດຕອງ ແລະ ແກ້ໄຂການແປທີ່ສ້າງໂດຍນັກພັດທະນາໄດ້ງ່າຍຂຶ້ນ."

msgid "Flag unchanged translations as \"Needs rewriting\""
msgstr "ໝາຍການແປທີ່ບໍ່ປ່ຽນແປງວ່າ \"ຕ້ອງໄດ້ຮັບການຂຽນໃໝ່\""

msgid ""
"Whenever a new translatable string is imported from the VCS and it matches a "
"source string, it is flagged as needing rewriting in Weblate. Especially "
"useful for file formats that include source strings for untranslated strings."
msgstr ""
"ທຸກຄັ້ງທີ່ມີການນຳເຂົ້າຂໍ້ຄວາມທີ່ແປໄດ້ໃໝ່ຈາກ VCS ແລະ ມັນກົງກັບຂໍ້ຄວາມຕົ້ນສະບັບ, "
"ມັນຈະຖືກໝາຍວ່າຕ້ອງໄດ້ຮັບການຂຽນໃໝ່ໃນ Weblate. "
"ມີປະໂຫຍດຫຼາຍສຳລັບຮູບແບບໄຟລ໌ທີ່ລວມຂໍ້ຄວາມຕົ້ນສະບັບໄວ້ສຳລັບຂໍ້ຄວາມທີ່ຍັງບໍ່ທັນແປ."

msgid "Bulk edit"
msgstr "ແກ້ໄຂເປັນຊຸດ"

msgid "Bulk edit flags, labels, or states of strings."
msgstr "ແກ້ໄຂທຸງ, ປ້າຍຊື່ ຫຼື ສະຖານະຂອງຂໍ້ຄວາມເປັນຊຸດ."

msgid "Flag updated translations from repository as \"Needs rewriting\""
msgstr "ໝາຍການແປທີ່ປັບປຸງຈາກບ່ອນເກັບຂໍ້ມູນວ່າ \"ຕ້ອງໄດ້ຮັບການຂຽນໃໝ່\""

msgid ""
"Whenever a string translation is changed from the VCS, it is flagged as "
"needing rewriting in Weblate. Especially useful if translation files are "
"often updated manually or by an external service."
msgstr ""
"ທຸກຄັ້ງທີ່ມີການປ່ຽນແປງການແປຂໍ້ຄວາມຈາກ VCS, ມັນຈະຖືກໝາຍວ່າຕ້ອງໄດ້ຮັບການຂຽນໃໝ່ໃນ Weblate. "
"ມີປະໂຫຍດຫຼາຍຖ້າໄຟລ໌ການແປຖືກປັບປຸງດ້ວຍຕົນເອງ ຫຼື ໂດຍບໍລິການພາຍນອກເລື້ອຍໆ."

msgid "Path of generated MO file"
msgstr "ເສັ້ນທາງຂອງໄຟລ໌ MO ທີ່ສ້າງຂຶ້ນ"

msgid "If not specified, the location of the PO file will be used."
msgstr "ຫາກບໍ່ໄດ້ລະບຸ, ຈະໃຊ້ສະຖານທີ່ດຽວກັບໄຟລ໌ PO."

msgid "Include strings needing editing"
msgstr "ລວມຂໍ້ຄວາມທີ່ຕ້ອງໄດ້ຮັບການແກ້ໄຂ"

msgid ""
"Strings needing editing (fuzzy) are typically not ready for use as "
"translations."
msgstr "ຂໍ້ຄວາມທີ່ຕ້ອງໄດ້ຮັບການແກ້ໄຂ (fuzzy) ປົກກະຕິແລ້ວແມ່ນຍັງບໍ່ພ້ອມທີ່ຈະໃຊ້ເປັນການແປ."

msgid "Update frequency"
msgstr "ຄວາມຖີ່ໃນການປັບປຸງ"

msgid "Daily"
msgstr "ລາຍວັນ"

msgid "Weekly"
msgstr "ລາຍອາທິດ"

msgid "Monthly"
msgstr "ລາຍເດືອນ"

msgid ""
"How often the add-on should update the POT file when the component is "
"refreshed."
msgstr "ຄວາມຖີ່ທີ່ສ່ວນເສີມຄວນປັບປຸງໄຟລ໌ POT ເມື່ອສ່ວນປະກອບຖືກຣີເຟຣຊ (refresh)."

msgid "Normalize POT header"
msgstr "ປັບສ່ວນຫົວ (header) ຂອງ POT ໃຫ້ເປັນມາດຕະຖານ"

msgid "Updates gettext headers and replaces placeholder POT comments."
msgstr "ປັບປຸງສ່ວນຫົວຂອງ gettext ແລະ ແທນທີ່ຄວາມຄິດເຫັນ POT ທີ່ເປັນຕົວແທນ."

msgid "Update PO files using msgmerge"
msgstr "ປັບປຸງໄຟລ໌ PO ໂດຍໃຊ້ msgmerge"

msgid ""
"Ensures the msgmerge add-on is installed and triggers it after the POT file "
"is updated."
msgstr "ຮັບປະກັນວ່າໄດ້ຕິດຕັ້ງສ່ວນເສີມ msgmerge ແລ້ວ ແລະ ກະຕຸ້ນມັນຫຼັງຈາກໄຟລ໌ POT ຖືກປັບປຸງ."

msgid "Source locations"
msgstr "ສະຖານທີ່ຕົ້ນສະບັບ"

msgid "Use file format settings"
msgstr "ໃຊ້ການຕັ້ງຄ່າຮູບແບບໄຟລ໌"

msgid "Extract locations to the POT file"
msgstr "ສະກັດສະຖານທີ່ເຂົ້າໃນໄຟລ໌ POT"

msgid "Do not extract locations"
msgstr "ບໍ່ຕ້ອງສະກັດສະຖານທີ່"

msgid ""
"Choose how extraction writes source locations to the POT file. Use this to "
"keep locations in the template while omitting them from translated PO files."
msgstr ""
"ເລືອກວິທີທີ່ການສະກັດຈະຂຽນສະຖານທີ່ຕົ້ນສະບັບລົງໃນໄຟລ໌ POT. ໃຊ້ສິ່ງນີ້ເພື່ອຮັກສາສະຖານທີ່ໄວ້ໃນແມ່ແບບ "
"ແຕ່ບໍ່ໃຫ້ມີໃນໄຟລ໌ PO ທີ່ແປແລ້ວ."

#, fuzzy
#| msgid "Could not remove the string: %s"
msgid "Keyword entries have to be strings."
msgstr "ບໍ່ສາມາດລຶບຂໍ້ຄວາມໄດ້: %s"

msgid "Do not extract comments"
msgstr "ບໍ່ຕ້ອງສະກັດຄວາມຄິດເຫັນ"

msgid "Extract all comments"
msgstr "ສະກັດຄວາມຄິດເຫັນທັງໝົດ"

msgid "Extract comments with tag"
msgstr "ສະກັດຄວາມຄິດເຫັນທີ່ມີແທັກ (tag)"

msgid "Code comments"
msgstr "ຄວາມຄິດເຫັນໃນໂຄ້ດ"

msgid ""
"Choose whether xgettext should extract no comments, all comments, or only "
"comments marked with a specific tag."
msgstr ""
"ເລືອກວ່າ xgettext ບໍ່ຄວນສະກັດຄວາມຄິດເຫັນເລີຍ, ສະກັດທັງໝົດ ຫຼື "
"ສະກັດສະເພາະຄວາມຄິດເຫັນທີ່ມີແທັກທີ່ກຳນົດໄວ້."

msgid "Comment tag"
msgstr "ແທັກຄວາມຄິດເຫັນ"

msgid ""
"Tag passed to xgettext for comment extraction when using tagged comment mode."
msgstr "ແທັກທີ່ສົ່ງໄປຫາ xgettext ສຳລັບການສະກັດຄວາມຄິດເຫັນ ເມື່ອໃຊ້ໂໝດຄວາມຄິດເຫັນແບບມີແທັກ."

msgid "xgettext checks"
msgstr "ການກວດສອບ xgettext"

msgid "Additional xgettext validation checks to enable for extracted messages."
msgstr "ການກວດສອບຄວາມຖືກຕ້ອງເພີ່ມເຕີມຂອງ xgettext ທີ່ຈະເປີດໃຊ້ງານສຳລັບຂໍ້ຄວາມທີ່ສະກັດມາ."

#, fuzzy
#| msgid "Additional keyword"
msgid "Additional keywords"
msgstr "ຄຳສຳຄັນເພີ່ມເຕີມ"

#, fuzzy
#| msgid "Optional extra keyword passed to xgettext using --keyword."
msgid "Newline-separated extra keywords passed to xgettext using --keyword."
msgstr "ຄຳສຳຄັນເພີ່ມເຕີມທີ່ເລືອກໄດ້ ທີ່ສົ່ງໄປຫາ xgettext ໂດຍໃຊ້ --keyword."

msgid "Use keywords exclusively"
msgstr "ໃຊ້ຄຳສຳຄັນໂດຍສະເພາະ"

msgid ""
"When enabled, passes --keyword without a value to xgettext before the "
"additional keyword, disabling all default keywords so that only the keyword "
"specified above is recognized."
msgstr ""
"ເມື່ອເປີດໃຊ້, ຈະສົ່ງ --keyword ໂດຍບໍ່ມີຄ່າໄປຍັງ xgettext ກ່ອນຄຳສຳຄັນເພີ່ມເຕີມ, "
"ເຮັດໃຫ້ຄຳສຳຄັນເລີ່ມຕົ້ນທັງໝົດຖືກປິດໃຊ້ງານ ເພື່ອໃຫ້ຮັບຮູ້ສະເພາະຄຳສຳຄັນທີ່ລະບຸໄວ້ຂ້າງເທິງເທົັ້ນັ້ນ."

msgid "This field is required."
msgstr "ຊ່ອງຂໍ້ມູນນີ້ແມ່ນຈຳເປັນ."

msgid "An additional keyword is required when using keywords exclusively."
msgstr "ຈຳເປັນຕ້ອງມີຄຳສຳຄັນເພີ່ມເຕີມເມື່ອໃຊ້ຄຳສຳຄັນສະເພາະຢ່າງດຽວ."

msgid "Input source"
msgstr "ແຫຼ່ງຂໍ້ມູນຂາເຂົ້າ"

msgid "Source file patterns"
msgstr "ຮູບແບບໄຟລ໌ຕົ້ນສະບັບ"

msgid "POTFILES manifest"
msgstr "ໄຟລ໌ລາຍການ POTFILES"

msgid ""
"Choose whether xgettext should read source files from glob patterns or from "
"a POTFILES/POTFILES.in manifest."
msgstr ""
"ເລືອກວ່າ xgettext ຄວນອ່ານໄຟລ໌ຕົ້ນສະບັບຈາກຮູບແບບ glob ຫຼື ຈາກລາຍການ POTFILES/"
"POTFILES.in."

msgid "xgettext language"
msgstr "ພາສາ xgettext"

msgid ""
"Programming language passed to xgettext, for example Python or C. Leave "
"blank to let xgettext guess the language from file extensions."
msgstr ""
"ພາສາໂປຣແກຣມທີ່ສົ່ງໄປຫາ xgettext, ເຊັ່ນ Python ຫຼື C. ປະວ່າງໄວ້ເພື່ອໃຫ້ xgettext "
"ຄາດເດົາພາສາຈາກນາມສະກຸນໄຟລ໌."

msgid ""
"Newline-separated repository-relative glob patterns for files to extract "
"with xgettext."
msgstr ""
"ຮູບແບບ glob ຂອງໄຟລ໌ທີ່ຈະສະກັດດ້ວຍ xgettext ໂດຍອ້າງອີງຕາມບ່ອນເກັບຂໍ້ມູນ, ແຍກດ້ວຍການຂຶ້ນແຖວໃໝ່."

msgid "POTFILES path"
msgstr "ເສັ້ນທາງ POTFILES"

msgid ""
"Repository-relative path to POTFILES or POTFILES.in. Entries are resolved "
"relative to the repository root. If present next to the manifest, "
"POTFILES.skip excludes listed files from extraction."
msgstr ""
"ເສັ້ນທາງທີ່ອ້າງອີງຕາມບ່ອນເກັບຂໍ້ມູນໄປຫາ POTFILES ຫຼື POTFILES.in. "
"ລາຍການຕ່າງໆຈະຖືກອ້າງອີງຈາກຮາກ (root) ຂອງບ່ອນເກັບຂໍ້ມູນ. ຖ້າມີໄຟລ໌ POTFILES.skip "
"ຢູ່ຂ້າງລາຍການ, ໄຟລ໌ທີ່ລະບຸໃນນັ້ນຈະບໍ່ຖືກສະກັດ."

msgid "Invalid symbolic link in a repository."
msgstr "ລິ້ງສັນຍະລັກໃນຄັງເກັບບໍ່ຖືກຕ້ອງ."

msgid "POTFILES path has to point to a file."
msgstr "ເສັ້ນທາງ POTFILES ຕ້ອງຊີ້ໄປຫາໄຟລ໌."

msgid "Meson preset"
msgstr "ຄ່າຕັ້ງລ່ວງໜ້າ Meson"

msgid "GLib"
msgstr "GLib"

msgid ""
"Built-in xgettext argument preset matching Meson gettext integration. The "
"GLib preset adds the keyword and format-flag options used by Meson's gettext "
"helper."
msgstr ""
"ຊຸດການຕັ້ງຄ່າ xgettext ທີ່ຕິດຕົ້າມາ ເຊິ່ງກົງກັບການເຮັດວຽກຂອງ Meson gettext. ຊຸດ GLib "
"ຈະເພີ່ມຄຳສຳຄັນ ແລະ ຕົວເລືອກ format-flag ທີ່ໃຊ້ໂດຍຕົວຊ່ວຍ gettext ຂອງ Meson."

msgid ""
"The Meson add-on expects a Meson gettext directory with meson.build and "
"POTFILES or POTFILES.in."
msgstr ""
"ສ່ວນເສີມ Meson ຕ້ອງການໄດເລັກທໍຣີ Meson gettext ທີ່ມີ meson.build ແລະ POTFILES ຫຼື "
"POTFILES.in."

msgid "The component has to define a gettext template for new translations."
msgstr "ສ່ວນປະກອບຕ້ອງກຳນົດແມ່ແບບ gettext ສຳລັບການແປໃໝ່."

msgid ""
"The Django add-on expects the template for new translations to be named "
"\"django.pot\", \"djangojs.pot\", \"django.po\", or \"djangojs.po\"."
msgstr ""
"ສ່ວນເສີມ Django ຕ້ອງການໃຫ້ແມ່ແບບສຳລັບການແປໃໝ່ມີຊື່ວ່າ \"django.pot\", \"djangojs.pot\", "
"\"django.po\", ຫຼື \"djangojs.po\"."

msgid "Filtering"
msgstr "ການກັ່ນຕອງ"

msgctxt "None filtering"
msgid "None"
msgstr "ບໍ່ມີ"

msgid "Weblate documentation"
msgstr "ເອກະສານຂອງ Weblate"

msgid ""
"Optionally remove strings that are not useful to translate after Sphinx "
"extraction."
msgstr "ເລືອກລຶບຂໍ້ຄວາມທີ່ບໍ່ຈຳເປັນໃນການແປຫຼັງຈາກການສະກັດຈາກ Sphinx."

msgid ""
"The Sphinx add-on expects the template for new translations to be a .pot "
"file."
msgstr "ສ່ວນເສີມ Sphinx ຕ້ອງການໃຫ້ແມ່ແບບສຳລັບການແປໃໝ່ເປັນໄຟລ໌ .pot."

msgid ""
"The Sphinx add-on expects the template for new translations to live in a "
"\"locales\" directory."
msgstr "ສ່ວນເສີມ Sphinx ຕ້ອງການໃຫ້ແມ່ແບບສຳລັບການແປໃໝ່ຢູ່ໃນໂຟນເດີ \"locales\"."

msgid "Could not determine Sphinx source directory."
msgstr "ບໍ່ສາມາດກຳນົດໂຟນເດີຕົ້ນສະບັບຂອງ Sphinx ໄດ້."

msgid "Name of generated file"
msgstr "ຊື່ຂອງໄຟລ໌ທີ່ສ້າງຂຶ້ນ"

msgid "Content of generated file"
msgstr "ເນື້ອໃນຂອງໄຟລ໌ທີ່ສ້າງຂຶ້ນ"

msgid "Commit squashing"
msgstr "ການຮວມຄອມມິດ"

msgid "All commits into one"
msgstr "ຮວມທຸກຄອມມິດເປັນອັນດຽວ"

msgid "Per language"
msgstr "ຕາມພາສາ"

msgid "Per file"
msgstr "ຕາມໄຟລ໌"

msgid "Per author"
msgstr "ຕາມຜູ້ຂຽນ"

msgid "Append trailers to squashed commit message"
msgstr "ເພີ່ມສ່ວນທ້າຍ (trailers) ໃສ່ຂໍ້ຄວາມຄອມມິດທີ່ຖືກຮວມ"

msgid ""
"Trailer lines are lines that look similar to RFC 822 e-mail headers, at the "
"end of the otherwise free-form part of a commit message, such as 'Co-"
"authored-by: …'."
msgstr ""
"ແຖວສ່ວນທ້າຍແມ່ນແຖວທີ່ມີລັກສະນະຄ້າຍຄືກັບສ່ວນຫົວອີເມວ RFC 822, ຢູ່ຕອນທ້າຍຂອງຂໍ້ຄວາມຄອມມິດ, ເຊັ່ນ "
"'Co-authored-by: …'."

msgid "Commit message"
msgstr "ຂໍ້ຄວາມຄອມມິດ"

msgid ""
"This commit message will be used instead of the combined commit messages "
"from the squashed commits."
msgstr "ຂໍ້ຄວາມຄອມມິດນີ້ຈະຖືກນຳໃຊ້ແທນຂໍ້ຄວາມທີ່ຮວມມາຈາກຫຼາຍຄອມມິດ."

msgid "Days to keep"
msgstr "ຈຳນວນມື້ທີ່ຈະເກັບໄວ້"

msgid "Voting threshold"
msgstr "ເກນການລົງຄະແນນ"

msgid ""
"Threshold for removal. Leave empty to remove suggestions regardless of "
"votes. This field has no effect with voting turned off."
msgstr ""
"ເກນສຳລັບການລຶບ. ປະວ່າງໄວ້ເພື່ອລຶບຄຳແນະນຳໂດຍບໍ່ສົນໃຈຄະແນນສຽງ. ຫ້ອງນີ້ຈະບໍ່ມີຜົນຫາກປິດການລົງຄະແນນ."

msgid "I confirm the above actions look correct"
msgstr "ຂ້າພະເຈົ້າຢືນຢັນວ່າການດຳເນີນການຂ້າງເທິງນັ້ນຖືກຕ້ອງ"

msgid "Please review and confirm the missing language changes."
msgstr "ກະລຸນາກວດກາ ແລະ ຢືນຢັນການປ່ຽນແປງພາສາທີ່ຂາດຫາຍ."

msgid "Regular expression to match translation files against"
msgstr "Regular expression ສຳລັບໃຊ້ຈັບຄູ່ກັບໄຟລ໌ການແປ"

msgid ""
"The regular expression must define named groups for component and language."
msgstr "Regular expression ຕ້ອງມີການກຳນົດກຸ່ມຊື່ສຳລັບສ່ວນປະກອບ (component) ແລະ ພາສາ."

msgid "File format"
msgstr "ຮູບແບບໄຟລ໌"

msgid "Customize the component name"
msgstr "ປັບແຕ່ງຊື່ສ່ວນປະກອບ"

msgid "Use Django template syntax. This template must include {{ component }}."
msgstr "ໃຊ້ໄວຍາກອນແມ່ແບບ Django. ແມ່ແບບນີ້ຕ້ອງມີ {{ component }}."

msgid "Define the monolingual base filename"
msgstr "ກຳນົດຊື່ໄຟລ໌ພື້ນຖານແບບພາສາເວີຊັນດຽວ"

msgid ""
"Leave empty for bilingual translation files. When set, this template must "
"include {{ component }}."
msgstr "ປະວ່າງໄວ້ສຳລັບໄຟລ໌ການແປສອງພາສາ. ຫາກກຳນົດ, ແມ່ແບບນີ້ຕ້ອງມີ {{ component }}."

msgid "Define the base file for new translations"
msgstr "ກຳນົດໄຟລ໌ພື້ນຖານສຳລັບການແປໃໝ່"

msgid ""
"Filename of file used for creating new translations. For gettext choose .pot "
"file. This template must include {{ component }}."
msgstr ""
"ຊື່ໄຟລ໌ທີ່ໃຊ້ສຳລັບສ້າງການແປໃໝ່. ສຳລັບ gettext ໃຫ້ເລືອກໄຟລ໌ .pot. ແມ່ແບບນີ້ຕ້ອງມີ "
"{{ component }}."

msgid "Intermediate language file"
msgstr "ໄຟລ໌ພາສາກາງ"

msgid ""
"Filename of intermediate translation file. In most cases this is a "
"translation file provided by developers and is used when creating actual "
"source strings. This template must include {{ component }}."
msgstr ""
"ຊື່ໄຟລ໌ຂອງໄຟລ໌ການແປລະດັບກາງ. ສ່ວນຫຼາຍແມ່ນໄຟລ໌ການແປທີ່ນັກພັດທະນາສະໜອງໃຫ້ ແລະ "
"ໃຊ້ເມື່ອສ້າງຂໍ້ຄວາມຕົ້ນສະບັບຕົວຈິງ. ແມ່ແບບນີ້ຕ້ອງມີ {{ component }}."

msgid "Language filter"
msgstr "ຕົວຢັ້ງຢືນພາສາ"

msgid ""
"Regular expression to filter translation files against when scanning for "
"file mask."
msgstr "Regular expression ສຳລັບກັ່ນຕອງໄຟລ໌ການແປເມື່ອສະແກນຫາ file mask."

msgid "Clone add-ons from the main component to the newly created ones"
msgstr "ຄັດລອກສ່ວນເສີມຈາກສ່ວນປະກອບຫຼັກໄປຫາສ່ວນປະກອບທີ່ສ້າງຂຶ້ນໃໝ່"

msgid "Remove components for inexistent files"
msgstr "ລຶບສ່ວນປະກອບສຳລັບໄຟລ໌ທີ່ບໍ່ມີຢູ່ແລ້ວ"

msgid "I confirm the above matches look correct"
msgstr "ຂ້າພະເຈົ້າຢືນຢັນວ່າການຈັບຄູ່ຂ້າງເທິງນັ້ນຖືກຕ້ອງ"

#, python-format
msgid "Generic preset: %(name)s [%(details)s]"
msgstr "ຄ່າທີ່ຕັ້ງໄວ້ທົ່ວໄປ: %(name)s [%(details)s]"

msgid "format not preset"
msgstr "ບໍ່ໄດ້ຕັ້ງຮູບແບບໄວ້"

#, python-format
msgid "monolingual base: %(base)s"
msgstr "ພື້ນຖານພາສາເວີຊັນດຽວ: %(base)s"

msgid "no monolingual base"
msgstr "ບໍ່ມີພື້ນຖານພາສາເວີຊັນດຽວ"

#, python-format
msgid "%(format)s; %(base)s"
msgstr "%(format)s; %(base)s"

msgid "One folder per language"
msgstr "ໜຶ່ງໂຟນເດີຕໍ່ໜຶ່ງພາສາ"

msgid "Matches files like cs/application.po."
msgstr "ກົງກັບໄຟລ໌ເຊັ່ນ cs/application.po."

msgid "Gettext locales layout"
msgstr "ຮູບແບບ Gettext locales"

msgid "Matches files like locale/cs/LC_MESSAGES/application.po."
msgstr "ກົງກັບໄຟລ໌ເຊັ່ນ locale/cs/LC_MESSAGES/application.po."

msgid "Complex filenames"
msgstr "ຊື່ໄຟລ໌ແບບຊັບຊ້ອນ"

msgid "Matches files like src/locale/application.cs.po."
msgstr "ກົງກັບໄຟລ໌ເຊັ່ນ src/locale/application.cs.po."

msgid "Filename-based language variants"
msgstr "ພາສາຍ່ອຍຕາມຊື່ໄຟລ໌"

msgid "Matches files like news_en.md."
msgstr "ກົງກັບໄຟລ໌ເຊັ່ນ news_en.md."

msgid "Repeated language code"
msgstr "ລະຫັດພາສາແບບຊ້ຳ"

msgid "Matches files like locale/cs/application/cs.po."
msgstr "ກົງກັບໄຟລ໌ເຊັ່ນ locale/cs/application/cs.po."

msgid "Split Android strings"
msgstr "ແຍກຂໍ້ຄວາມ Android"

msgid "Matches files like res/values-cs/strings-about.xml."
msgstr "ກົງກັບໄຟລ໌ເຊັ່ນ res/values-cs/strings-about.xml."

msgid "Matching multiple paths"
msgstr "ຈັບຄູ່ຫຼາຍເສັ້ນທາງ"

msgid ""
"Matches nested Java properties layouts and also fills the component name "
"template."
msgstr "ກົງກັບຮູບແບບ Java properties ແບບຊ້ອນກັນ ແລະ ຕື່ມຂໍ້ມູນໃສ່ແມ່ແບບຊື່ສ່ວນປະກອບ."

#, python-format
msgid "Detected: %(pattern)s [%(details)s]"
msgstr "ກວດພົບ: %(pattern)s [%(details)s]"

msgid "Detected from repository"
msgstr "ກວດພົບຈາກຄັງເກັບລະຫັດ"

msgid "Generic presets"
msgstr "ຄ່າທີ່ຕັ້ງໄວ້ທົ່ວໄປ"

msgid "You can not use a monolingual translation without a base file."
msgstr "ທ່ານບໍ່ສາມາດໃຊ້ການແປແບບພາສາເວີຊັນດຽວໂດຍບໍ່ມີໄຟລ໌ພື້ນຖານ."

msgid "You can not use a base file for bilingual translation."
msgstr "ທ່ານບໍ່ສາມາດໃຊ້ໄຟລ໌ພື້ນຖານສຳລັບການແປແບບສອງພາສາ."

msgid "Please review and confirm the matched components."
msgstr "ກະລຸນາກວດກາ ແລະ ຢືນຢັນສ່ວນປະກອບທີ່ຈັບຄູ່ແລ້ວ."

msgid "This template must include {{ component }}."
msgstr "ແມ່ແບບນີ້ຕ້ອງມີ {{ component }}."

msgid "This template must include component markup."
msgstr "ແມ່ແບບນີ້ຕ້ອງມີ markup ຂອງສ່ວນປະກອບ."

msgid "Translation threshold"
msgstr "ເກນການແປ"

msgid ""
"The percentage of translated strings that must be present for translation to "
"be included."
msgstr "ເປີເຊັນຂອງຂໍ້ຄວາມທີ່ແປແລ້ວເຊິ່ງຕ້ອງມີເພື່ອໃຫ້ການແປນັ້ນຖືກລວມເຂົ້າ."

msgid "CSS selector"
msgstr "ຕົວເລືອກ CSS"

msgid "CSS selector to detect localizable elements."
msgstr "CSS selector ສຳລັບກວດຫາອົງປະກອບທີ່ສາມາດແປໄດ້."

msgid "Language cookie name"
msgstr "ຊື່ຄຸກກີ້ພາສາ"

msgid "Name of cookie which stores language preference."
msgstr "ຊື່ຂອງຄຸກກີ້ທີ່ເກັບການຕັ້ງຄ່າພາສາທີ່ມັກ."

msgid "Extract strings from HTML files"
msgstr "ສະກັດຂໍ້ຄວາມຈາກໄຟລ໌ HTML"

msgid ""
"List of filenames in current repository or remote URLs to parse for "
"translatable strings."
msgstr "ລາຍຊື່ໄຟລ໌ໃນຄັງປັດຈຸບັນ ຫຼື URL ທາງໄກ ເພື່ອນຳມາສະກັດຂໍ້ຄວາມທີ່ແປໄດ້."

#, python-format
msgid "Could not parse CSS selector: %s"
msgstr "ບໍ່ສາມາດວິເຄາະ CSS selector: %s"

msgid "Source strings"
msgstr "ຂໍ້ຄວາມຕົ້ນສະບັບ"

msgid "Target translation"
msgstr "ການແປເປົ້າໝາຍ"

msgid "All strings in this translation will be overwritten"
msgstr "ທຸກຂໍ້ຄວາມໃນການແປນີ້ຈະຖືກຂຽນທັບ"

msgid "Prepended static text"
msgstr "ຂໍ້ຄວາມຄົງທີ່ທີ່ຕື່ມໃສ່ທາງໜ້າ"

msgid "Prepended variable text"
msgstr "ຂໍ້ຄວາມປ່ຽນແປງໄດ້ທີ່ຕື່ມໃສ່ທາງໜ້າ"

msgid "Appended static text"
msgstr "ຂໍ້ຄວາມຄົງທີ່ທີ່ຕື່ມໃສ່ທາງທ້າຍ"

msgid "Appended variable text"
msgstr "ຂໍ້ຄວາມປ່ຽນແປງໄດ້ທີ່ຕື່ມໃສ່ທາງທ້າຍ"

msgid "Variable text multiplier"
msgstr "ຕົວຄູນຂໍ້ຄວາມປ່ຽນແປງໄດ້"

msgid ""
"How many times to repeat the variable text depending on the length of the "
"source string."
msgstr "ຈຳນວນຮອບທີ່ຈະເຮັດຊ້ຳຂໍ້ຄວາມປ່ຽນແປງໄດ້ ໂດຍອີງຕາມຄວາມຍາວຂອງຂໍ້ຄວາມຕົ້ນສະບັບ."

msgid "Include read-only strings"
msgstr "ລວມຂໍ້ຄວາມທີ່ອ່ານໄດ້ຢ່າງດຽວ"

msgid "The source and target have to be different languages."
msgstr "ຕົ້ນສະບັບ ແລະ ເປົ້າໝາຍ ຕ້ອງເປັນຄົນລະພາສາກັນ."

msgid "Enable case-sensitive key sorting"
msgstr "ເປີດການນຳໃຊ້ການລຽງລຳດັບຄີແບບແຍກຕົວພິມໃຫຍ່-ນ້ອຍ"

msgid "Change events to trigger"
msgstr "ເຫດການການປ່ຽນແປງທີ່ຈະເປີດການເຮັດວຽກ"

msgid "Translation content events"
msgstr "ເຫດການກ່ຽວກັບເນື້ອໃນການແປ"

msgid "All change events"
msgstr "ເຫດການການປ່ຽນແປງທັງໝົດ"

msgid "Selected change events"
msgstr "ເຫດການການປ່ຽນແປງທີ່ເລືອກ"

msgid "Choose which change events should trigger this add-on."
msgstr "ເລືອກວ່າເຫດການການປ່ຽນແປງໃດຄວນເປີດການເຮັດວຽກຂອງສ່ວນເສີມນີ້."

msgid "Webhook URL"
msgstr "URL ເວັບຮຸກ"

msgid "Webhook secret"
msgstr "ລະຫັດລັບເວັບຮຸກ"

msgid "The Standard Webhooks secret is a base64 encoded string."
msgstr "ລະຫັດລັບ Standard Webhooks ແມ່ນຂໍ້ຄວາມທີ່ເຂົ້າລະຫັດແບບ base64."

msgid "AMQP broker URL"
msgstr "URL ຂອງ AMQP broker"

msgid "The AMQP broker URL to connect to."
msgstr "URL ຂອງ AMQP broker ທີ່ຈະເຊື່ອມຕໍ່."

msgid "Topic prefix"
msgstr "ຄຳນຳໜ້າຫົວຂໍ້ (Topic prefix)"

msgid "Optional prefix to prepend to generated message topics."
msgstr "ຄຳນຳໜ້າທີ່ຈະຕື່ມໃສ່ຫົວຂໍ້ຂໍ້ຄວາມທີ່ສ້າງຂຶ້ນ (ເລືອກໄດ້)."

msgid "CA certificate bundle (PEM)"
msgstr "ຊຸດໃບຢັ້ງຢືນ CA (PEM)"

msgid ""
"Paste only PEM certificate blocks, each starting with \"-----BEGIN "
"CERTIFICATE-----\" and ending with \"-----END CERTIFICATE-----\"."
msgstr ""
"ວາງສະເພາະບລັອກໃບຢັ້ງຢືນ PEM, ແຕ່ລະບລັອກຕ້ອງຂຶ້ນຕົ້ນດ້ວຍ \"-----BEGIN CERTIFICATE-----\" "
"ແລະ ລົງທ້າຍດ້ວຍ \"-----END CERTIFICATE-----\"."

msgid "Client private key (PEM)"
msgstr "ຄີສ່ວນຕົວຂອງໄຄເອັນ (PEM)"

msgid ""
"Paste a single unencrypted PEM private key block. Encrypted private keys are "
"not supported."
msgstr ""
"ວາງບລັອກ PEM private key ທີ່ບໍ່ໄດ້ເຂົ້າລະຫັດພຽງອັນດຽວ. ບໍ່ຮອງຮັບ private key ທີ່ເຂົ້າລະຫັດ."

msgid "Client certificate (PEM)"
msgstr "ໃບຢັ້ງຢືນຂອງໄຄເອັນ (PEM)"

msgid ""
"Paste only the PEM certificate block starting with \"-----BEGIN "
"CERTIFICATE-----\"; do not paste the output from \"openssl x509 -text\"."
msgstr ""
"ວາງສະເພາະບລັອກໃບຢັ້ງຢືນ PEM ທີ່ຂຶ້ນຕົ້ນດ້ວຍ \"-----BEGIN CERTIFICATE-----\"; "
"ຫ້າມວາງຂໍ້ມູນຈາກ \"openssl x509 -text\"."

msgid "Publish timeout"
msgstr "ໝົດເວລາການເຜີຍແຜ່"

msgid "How many seconds to wait for the broker delivery acknowledgement."
msgstr "ຈຳນວນວິນາທີທີ່ຈະລໍຖ້າການຕອບຮັບການສົ່ງຈາກ broker."

msgid "Connection attempts"
msgstr "ຄວາມພະຍາຍາມໃນການເຊື່ອມຕໍ່"

msgid "How many times to try connecting to the broker."
msgstr "ຈຳນວນຮອບທີ່ຈະພະຍາຍາມເຊື່ອມຕໍ່ຫາ broker."

msgid "Retry delay"
msgstr "ໄລຍະເວລາລໍຖ້າກ່ອນລອງໃໝ່"

msgid "How many seconds to wait between connection attempts."
msgstr "ຈຳນວນວິນາທີທີ່ຈະລໍຖ້າລະຫວ່າງການພະຍາຍາມເຊື່ອມຕໍ່."

msgid "Topic prefix can contain only ASCII characters."
msgstr "ຄຳນຳໜ້າຫົວຂໍ້ສາມາດມີໄດ້ສະເພາະຕົວອັກສອນ ASCII ເທົ່ານັ້ນ."

#, python-format
msgid "Topic prefix must not exceed %(limit)d characters."
msgstr "ຄຳນຳໜ້າຫົວຂໍ້ຕ້ອງບໍ່ເກີນ %(limit)d ຕົວອັກສອນ."

msgid "The SSL certificates have to be provided for SSL connection."
msgstr "ຕ້ອງສະໜອງໃບຢັ້ງຢືນ SSL ສຳລັບການເຊື່ອມຕໍ່ແບບ SSL."

msgid "The SSL certificates are not used without a SSL connection."
msgstr "ໃບຢັ້ງຢືນ SSL ຈະບໍ່ຖືກນຳໃຊ້ຫາກບໍ່ມີການເຊື່ອມຕໍ່ແບບ SSL."

msgid "Statistics generator"
msgstr "ຕົວສ້າງສະຖິຕິ"

msgid "Generates a file containing detailed info about the translation status."
msgstr "ສ້າງໄຟລ໌ທີ່ມີຂໍ້ມູນລະອຽດກ່ຽວກັບສະຖານະການແປ."

msgid "Pseudolocale generation"
msgstr "ການສ້າງ Pseudolocale"

msgid ""
"Generates a translation by adding prefix and suffix to source strings "
"automatically."
msgstr "ສ້າງການແປໂດຍການຕື່ມຄຳນຳໜ້າ ແລະ ຄຳລົງທ້າຍໃສ່ຂໍ້ຄວາມຕົ້ນສະບັບໂດຍອັດຕະໂນມັດ."

msgid "Prefill translation with source"
msgstr "ຕື່ມຂໍ້ມູນການແປດ້ວຍຕົ້ນສະບັບໄວ້ກ່ອນ"

msgid "Fills in translation strings with source string."
msgstr "ຕື່ມຂໍ້ຄວາມການແປດ້ວຍຂໍ້ຄວາມຕົ້ນສະບັບ."

msgid "Fill read-only strings with source"
msgstr "ຕື່ມຂໍ້ຄວາມແບບອ່ານໄດ້ຢ່າງດຽວດ້ວຍຕົ້ນສະບັບ"

msgid "Fills in translation of read-only strings with source string."
msgstr "ຕື່ມການແປຂອງຂໍ້ຄວາມແບບອ່ານໄດ້ຢ່າງດຽວດ້ວຍຂໍ້ຄວາມຕົ້ນສະບັບ."

msgid "Generate MO files"
msgstr "ສ້າງໄຟລ໌ MO"

msgid "Automatically generates a MO file for every changed PO file."
msgstr "ສ້າງໄຟລ໌ MO ໂດຍອັດຕະໂນມັດສຳລັບທຸກໄຟລ໌ PO ທີ່ມີການປ່ຽນແປງ."

msgid "Update LINGUAS file"
msgstr "ອັບເດດໄຟລ໌ LINGUAS"

msgid "Updates the LINGUAS file when a translation is added or removed."
msgstr "ອັບເດດໄຟລ໌ LINGUAS ເມື່ອມີການເພີ່ມ ຫຼື ລຶບການແປ."

msgid "Update ALL_LINGUAS variable in the \"configure\" file"
msgstr "ອັບເດດຕົວປ່ຽນ ALL_LINGUAS ໃນໄຟລ໌ \"configure\""

msgid ""
"Updates the ALL_LINGUAS variable in \"configure\", \"configure.in\" or "
"\"configure.ac\" files, when a translation is added or removed."
msgstr ""
"ອັບເດດຕົວປ່ຽນ ALL_LINGUAS ໃນໄຟລ໌ \"configure\", \"configure.in\" ຫຼື "
"\"configure.ac\" ເມື່ອມີການເພີ່ມ ຫຼື ລຶບການແປ."

msgid "Update PO files to match POT (msgmerge)"
msgstr "ອັບເດດໄຟລ໌ PO ໃຫ້ກົງກັບ POT (msgmerge)"

msgid ""
"Updates all PO files (as configured by \"File mask\") to match the POT file "
"(as configured by \"Template for new translations\") using msgmerge."
msgstr ""
"ອັບເດດທຸກໄຟລ໌ PO (ຕາມທີ່ຕັ້ງຄ່າໃນ \"File mask\") ໃຫ້ກົງກັບໄຟລ໌ POT (ຕາມທີ່ຕັ້ງຄ່າໃນ "
"\"ແມ່ແບບສຳລັບການແປໃໝ່\") ໂດຍໃຊ້ msgmerge."

msgid "Update POT file (xgettext)"
msgstr "ອັບເດດໄຟລ໌ POT (xgettext)"

msgid "Updates the gettext template using xgettext on selected source files."
msgstr "ອັບເດດແມ່ແບບ gettext ໂດຍໃຊ້ xgettext ໃນໄຟລ໌ຕົ້ນສະບັບທີ່ເລືອກ."

msgid "Update POT file (Meson)"
msgstr "ອັບເດດໄຟລ໌ POT (Meson)"

msgid "Updates the gettext template using Meson gettext conventions."
msgstr "ອັບເດດແມ່ແບບ gettext ໂດຍໃຊ້ຂໍ້ກຳນົດຂອງ Meson gettext."

msgid "Update gettext template (Django)"
msgstr "ອັບເດດແມ່ແບບ gettext (Django)"

msgid ""
"Updates the gettext template using Django's built-in makemessages command."
msgstr "ອັບເດດແມ່ແບບ gettext ໂດຍໃຊ້ຄຳສັ່ງ makemessages ທີ່ມີມາໃນຕົວຂອງ Django."

msgid "Update POT file (Sphinx)"
msgstr "ອັບເດດໄຟລ໌ POT (Sphinx)"

msgid ""
"Updates the gettext template using Sphinx's gettext builder without loading "
"project configuration."
msgstr ""
"ອັບເດດແມ່ແບບ gettext ໂດຍໃຊ້ gettext builder ຂອງ Sphinx ໂດຍບໍ່ຕ້ອງໂຫຼດການຕັ້ງຄ່າໂຄງການ."

msgid "Contributors in comment"
msgstr "ລາຍຊື່ຜູ້ມີສ່ວນຮ່ວມໃນຄຳເຫັນ"

msgid ""
"Updates the comment part of the PO file header to include contributor names "
"and years of contributions."
msgstr "ອັບເດດສ່ວນຄຳເຫັນຂອງສ່ວນຫົວໄຟລ໌ PO ເພື່ອລວມເອົາຊື່ຜູ້ມີສ່ວນຮ່ວມ ແລະ ປີທີ່ໄດ້ປະກອບສ່ວນ."

msgid "Squash Git commits"
msgstr "ຮວມ Git commits"

msgid "Squash Git commits prior to pushing changes."
msgstr "ຮວມ Git commits ກ່ອນທີ່ຈະ push ການປ່ຽນແປງ."

msgid "This add-on cannot be triggered manually."
msgstr "ສ່ວນເສີມນີ້ບໍ່ສາມາດເປີດເຮັດວຽກດ້ວຍຕົນເອງໄດ້."

msgid "Format the Java properties file"
msgstr "ຈັດຮູບແບບໄຟລ໌ Java properties"

msgid "Formats and sorts the Java properties file."
msgstr "ຈັດຮູບແບບ ແລະ ລຽງລຳດັບໄຟລ໌ Java properties."

msgid "Stale comment removal"
msgstr "ການລຶບຄຳເຫັນທີ່ເກົ່າເກີນໄປ"

msgid "Set a timeframe for removal of comments."
msgstr "ກຳນົດກອບເວລາສຳລັບການລຶບຄຳເຫັນ."

msgid "Stale suggestion removal"
msgstr "ການລຶບຄຳແນະນຳທີ່ເກົ່າເກີນໄປ"

msgid "Set a timeframe for removal of suggestions."
msgstr "ກຳນົດກອບເວລາສຳລັບການລຶບຄຳແນະນຳ."

msgid "Update RESX files"
msgstr "ອັບເດດໄຟລ໌ RESX"

msgid ""
"Update all translation files to match the monolingual upstream base file. "
"Unused strings are removed, and new ones added as copies of the source "
"string."
msgstr ""
"ອັບເດດທຸກໄຟລ໌ການແປໃຫ້ກົງກັບໄຟລ໌ພື້ນຖານແບບພາສາເວີຊັນດຽວຈາກຕົ້ນທາງ. ຂໍ້ຄວາມທີ່ບໍ່ໄດ້ໃຊ້ຈະຖືກລຶບອອກ, "
"ແລະ ຂໍ້ຄວາມໃໝ່ຈະຖືກເພີ່ມໂດຍການຄັດລອກຈາກຂໍ້ຄວາມຕົ້ນສະບັບ."

msgid "site-wide add-ons"
msgstr "ສ່ວນເສີມທົ່ວທັງເວັບໄຊ"

msgctxt "Add-on scope"
msgid "Repository"
msgstr "ຄັງເກັບ (Repository)"

msgctxt "Add-on scope"
msgid "Component"
msgstr "ສ່ວນປະກອບ"

msgctxt "Add-on scope"
msgid "Parent category"
msgstr "ໝວດໝູ່ຫຼັກ"

msgctxt "Add-on scope"
msgid "Category"
msgstr "ໝວດໝູ່"

msgctxt "Add-on scope"
msgid "Project"
msgstr "ໂຄງການ"

msgctxt "Add-on scope"
msgid "Site"
msgstr "ເວັບໄຊ"

#, python-format
msgid "Invalid add-on name: ”%s”"
msgstr "ຊື່ສ່ວນເສີມບໍ່ຖືກຕ້ອງ: ”%s”"

#, python-format
msgid "Add-on cannot be installed: ”%s”"
msgstr "ບໍ່ສາມາດຕິດຕັ້ງສ່ວນເສີມ: ”%s”"

msgid "Add-on installed, please review integration instructions."
msgstr "ຕິດຕັ້ງສ່ວນເສີມແລ້ວ, ກະລຸນາກວດກາຄຳແນະນຳການເຊື່ອມຕໍ່."

msgid "Add-on run has been scheduled."
msgstr "ໄດ້ຕັ້ງກຳນົດເວລາການເຮັດວຽກຂອງສ່ວນເສີມແລ້ວ."

msgid "Webhook"
msgstr "ເວັບຮຸກ"

msgid ""
"Sends notifications to external services based on selected events, following "
"the Standard Webhooks specification."
msgstr ""
"ສົ່ງການແຈ້ງເຕືອນໄປຫາບໍລິການພາຍນອກຕາມເຫດການທີ່ເລືອກ, ໂດຍປະຕິບັດຕາມຂໍ້ກຳນົດ Standard "
"Webhooks."

msgid "Slack Webhooks"
msgstr "Slack Webhooks"

msgid "Sends notification to a Slack channel based on selected events."
msgstr "ສົ່ງການແຈ້ງເຕືອນໄປຫາຊ່ອງ Slack ຕາມເຫດການທີ່ເລືອກ."

msgid "Session-based authentication used when user is signed in."
msgstr "ການຢືນຢັນຕົວຕົນແບບໃຊ້ Session ເມື່ອຜູ້ໃຊ້ເຂົ້າສູ່ລະບົບແລ້ວ."

#, python-format
msgid "Token-based authentication with required prefix `%s`."
msgstr "ການຢືນຢັນຕົວຕົນແບບໃຊ້ Token ໂດຍຕ້ອງມີຄຳນຳໜ້າ `%s`."

msgid ""
"Each user has a personal access token which they can get from their "
"respective user profile. These tokens have the `wlu_` prefix."
msgstr ""
"ຜູ້ໃຊ້ແຕ່ລະຄົນມີ token ການເຂົ້າເຖິງສ່ວນຕົວ ເຊິ່ງສາມາດເອົາໄດ້ຈາກໂປຣໄຟລ໌ຜູ້ໃຊ້. Token "
"ເຫຼົ່ານີ້ມີຄຳນຳໜ້າວ່າ `wlu_`."

msgid ""
"It is possible to create project tokens whose access to the API is limited "
"to operations to their associated project. These tokens have the `wlp_` "
"prefix."
msgstr ""
"ສາມາດສ້າງ project tokens ເຊິ່ງການເຂົ້າເຖິງ API "
"ຈະຖືກຈຳກັດໄວ້ສະເພາະການດຳເນີນການໃນໂຄງການທີ່ກ່ຽວຂ້ອງ. Token ເຫຼົ່ານີ້ມີຄຳນຳໜ້າວ່າ `wlp_`."

msgid "Successful response."
msgstr "ການຕອບສະໜອງສຳເລັດ."

msgid "The resource was created."
msgstr "ຊັບພະຍາກອນຖືກສ້າງຂຶ້ນແລ້ວ."

msgid "The request was accepted for asynchronous processing."
msgstr "ຄຳຮ້ອງຂໍຖືກຍອມຮັບສຳລັບການປະມວນຜົນແບບ asynchronous."

msgid "Successful response without a response body."
msgstr "ການຕອບສະໜອງສຳເລັດໂດຍບໍ່ມີເນື້ອໃນການຕອບສະໜອງ (body)."

msgid "The request was invalid or could not be parsed."
msgstr "ຄຳຮ້ອງຂໍບໍ່ຖືກຕ້ອງ ຫຼື ບໍ່ສາມາດວິເຄາະໄດ້."

msgid "Authentication credentials were missing or invalid."
msgstr "ຂໍ້ມູນການຢືນຢັນຕົວຕົນບໍ່ຄົບຖ້ວນ ຫຼື ບໍ່ຖືກຕ້ອງ."

msgid "The authenticated user does not have permission for this operation."
msgstr "ຜູ້ໃຊ້ທີ່ຢືນຢັນຕົວຕົນແລ້ວບໍ່ມີສິດອະນຸຍາດສຳລັບການດຳເນີນການນີ້."

msgid "The requested resource was not found or is not accessible."
msgstr "ບໍ່ພົບຊັບພະຍາກອນທີ່ຮ້ອງຂໍ ຫຼື ບໍ່ສາມາດເຂົ້າເຖິງໄດ້."

msgid "The HTTP method is not allowed for this resource."
msgstr "ບໍ່ອະນຸຍາດໃຫ້ນຳໃຊ້ວິທີ HTTP ນີ້ສຳລັບຊັບພະຍາກອນນີ້."

msgid "The requested response media type is not available."
msgstr "ປະເພດສື່ (media type) ຂອງການຕອບສະໜອງທີ່ຮ້ອງຂໍບໍ່ພ້ອມໃຊ້ງານ."

msgid "The request media type is not supported."
msgstr "ບໍ່ຮອງຮັບປະເພດສື່ຂອງຄຳຮ້ອງຂໍນີ້."

msgid "The resource is locked."
msgstr "ຊັບພະຍາກອນຖືກລັອກ."

msgid "The API request rate limit was exceeded."
msgstr "ເກີນຂີດຈຳກັດຄວາມຖີ່ຂອງການຮ້ອງຂໍ API."

msgid "An unexpected server error occurred."
msgstr "ເກີດຂໍ້ຜິດພາດທີ່ບໍ່ຄາດຄິດໃນເຊີບເວີ."

msgid ""
"Filter by change action. Repeat this parameter to filter by multiple actions."
msgstr "ກັ່ນຕອງຕາມການດຳເນີນການປ່ຽນແປງ. ສາມາດໃຊ້ພາລາມິເຕີນີ້ຊ້ຳເພື່ອມີຫຼາຍການກັ່ນຕອງ."

msgid "Allowed number of requests to perform"
msgstr "ຈຳນວນຄຳຮ້ອງຂໍທີ່ອະນຸຍາດໃຫ້ດຳເນີນການ"

msgid "Remaining number of requests to perform"
msgstr "ຈຳນວນຄຳຮ້ອງຂໍທີ່ຍັງເຫຼືອ"

msgid "Number of seconds until the rate-limit window resets"
msgstr "ຈຳນວນວິນາທີຈົນກວ່າຂີດຈຳກັດຄວາມຖີ່ຈະຖືກຕັ້ງຄ່າໃໝ່"

msgid "Invalid component path."
msgstr "ເສັ້ນທາງສ່ວນປະກອບບໍ່ຖືກຕ້ອງ."

msgid "URL slug"
msgstr "URL slug"

msgid "Name used in URLs and filenames."
msgstr "ຊື່ທີ່ໃຊ້ໃນ URL ແລະ ຊື່ໄຟລ໌."

msgid "Required for credits, contributor stats, and translator work reports."
msgstr "ຈຳເປັນສຳລັບລາຍຊື່ຜູ້ຮ່ວມງານ, ສະຖິຕິຜູ້ປະກອບສ່ວນ, ແລະ ລາຍງານການເຮັດວຽກຂອງຜູ້ແປ."

msgid "Invalid workspace."
msgstr "ພື້ນທີ່ເຮັດວຽກບໍ່ຖືກຕ້ອງ."

msgid "Invalid project."
msgstr "ໂຄງການບໍ່ຖືກຕ້ອງ."

msgid "Invalid category."
msgstr "ໝວດໝູ່ບໍ່ຖືກຕ້ອງ."

msgid "Do not specify a scope on a scoped reports endpoint."
msgstr "ຫ້າມລະບຸຂອບເຂດໃນຈຸດເຊື່ອມຕໍ່ລາຍງານທີ່ມີຂອບເຂດແລ້ວ."

msgid "Choose at most one report scope."
msgstr "ເລືອກຂອບເຂດລາຍງານໄດ້ຫຼາຍທີ່ສຸດໜຶ່ງອັນ."

msgid "Start and end timestamps are required."
msgstr "ຈຳເປັນຕ້ອງມີເວລາເລີ່ມຕົ້ນ ແລະ ເວລາສິ້ນສຸດ."

msgid "The report start must be before its end."
msgstr "ເວລາເລີ່ມຕົ້ນລາຍງານຕ້ອງມາກ່ອນເວລາສິ້ນສຸດ."

msgid "Minimum changes can not exceed maximum changes."
msgstr "ການປ່ຽນແປງຂັ້ນຕ່ຳບໍ່ສາມາດເກີນການປ່ຽນແປງຂັ້ນສູງສຸດໄດ້."

msgid "This e-mail address has not been verified."
msgstr "ທີ່ຢູ່ອີເມວນີ້ຍັງບໍ່ທັນໄດ້ຮັບການຢືນຢັນ."

msgid "Scope"
msgstr "ຂອບເຂດ"

msgid ""
"Is your comment specific to this translation, or generic for all of them?"
msgstr "ຄຳເຫັນຂອງທ່ານແມ່ນສະເພາະເຈາະຈົງສຳລັບການແປນີ້, ຫຼື ເປັນແບບທົ່ວໄປສຳລັບທັງໝົດ?"

msgid "Comment text"
msgstr "ຂໍ້ຄວາມຄຳເຫັນ"

msgid "You can use Markdown and mention users by @username."
msgstr "ທ່ານສາມາດໃຊ້ Markdown ແລະ ອ້າງເຖິງຜູ້ໃຊ້ດ້ວຍ @username."

msgid "Creation timestamp"
msgstr "ເວລາທີ່ສ້າງ"

msgid ""
"If you’re an admin, you can set the explicit timestamp at which the comment "
"was created."
msgstr "ຫາກທ່ານເປັນຜູ້ດູແລລະບົບ, ທ່ານສາມາດກຳນົດເວລາທີ່ສ້າງຄຳເຫັນໄດ້ຢ່າງຊັດເຈນ."

msgid "Commenter’s email"
msgstr "ອີເມວຂອງຜູ້ອອກຄຳເຫັນ"

msgid ""
"If you’re an admin, you can attribute this comment to another user by their "
"email."
msgstr ""
"ຫາກທ່ານເປັນຜູ້ດູແລລະບົບ, ທ່ານສາມາດກຳນົດໃຫ້ຄຳເຫັນນີ້ເປັນຂອງຜູ້ໃຊ້ອື່ນໄດ້ໂດຍໃຊ້ອີເມວຂອງພວກເຂົາ."

msgid "Cannot change this on a built-in team."
msgstr "ບໍ່ສາມາດປ່ຽນແປງສິ່ງນີ້ໃນທີມທີ່ມີມາໃຫ້ແລ້ວ."

msgid "Cannot change this on an existing team."
msgstr "ບໍ່ສາມາດປ່ຽນແປງສິ່ງນີ້ໃນທີມທີ່ມີຢູ່ແລ້ວ."

msgid "Choose either a project or a workspace."
msgstr "ເລືອກໂຄງການ ຫຼື ພື້ນທີ່ເຮັດວຽກ (workspace) ຢ່າງໃດຢ່າງໜຶ່ງ."

msgid "A team with this name already exists in this workspace."
msgstr "ມີທີມທີ່ໃຊ້ຊື່ນີ້ຢູ່ແລ້ວໃນພື້ນທີ່ເຮັດວຽກນີ້."

msgid "Cannot change this on a scoped team."
msgstr "ບໍ່ສາມາດປ່ຽນແປງສິ່ງນີ້ໃນທີມທີ່ມີການກຳນົດຂອບເຂດ."

msgid "You do not have permission to access this component."
msgstr "ທ່ານບໍ່ມີສິດອະນຸຍາດໃນການເຂົ້າເຖິງສ່ວນປະກອບນີ້."

msgid "You do not have permission to change restricted access."
msgstr "ທ່ານບໍ່ມີສິດອະນຸຍາດໃນການປ່ຽນແປງການຈຳກັດການເຂົ້າເຖິງ."

msgid "Commit"
msgstr "ຄອມມິດ"

msgid "Update"
msgstr "ອັບເດດ"

msgid "Update with rebase"
msgstr "ອັບເດດດ້ວຍ rebase"

msgid "Update with merge"
msgstr "ອັບເດດດ້ວຍ merge"

msgid "Update with merge without fast-forward"
msgstr "ອັບເດດດ້ວຍ merge ແບບບໍ່ມີ fast-forward"

msgid "Push"
msgstr "Push"

msgid "Reset all changes in the Weblate repository"
msgstr "ຣີເຊັດການປ່ຽນແປງທັງໝົດໃນຄັງເກັບລະຫັດຂອງ Weblate"

msgid "Reset the Weblate repository and reapply translations"
msgstr "ຣີເຊັດຄັງເກັບລະຫັດ Weblate ແລະ ນຳໃຊ້ການແປຄືນໃໝ່"

msgid "Cleanup all untracked files in the Weblate repository"
msgstr "ລຶບໄຟລ໌ທີ່ບໍ່ໄດ້ຕິດຕາມ (untracked) ທັງໝົດໃນຄັງເກັບລະຫັດ Weblate"

msgid "Force writing all translations to the Weblate repository"
msgstr "ບັງຄັບການຂຽນການແປທັງໝົດລົງໃນຄັງເກັບລະຫັດ Weblate"

msgid "Rescan all translation files in the Weblate repository"
msgstr "ສະແກນໄຟລ໌ການແປທັງໝົດໃນຄັງເກັບລະຫັດ Weblate ຄືນໃໝ່"

msgid "Please provide a suggestion"
msgstr "ກະລຸນາໃຫ້ຄຳແນະນຳ"

msgid "Translation text too long!"
msgstr "ຂໍ້ຄວາມການແປຍາວເກີນໄປ!"

msgid "Number of plurals does not match"
msgstr "ຈຳນວນຮູບພະຫູພົດບໍ່ກົງກັນ"

msgid "Your suggestion is similar to the current translation!"
msgstr "ຄຳແນະນຳຂອງທ່ານຄ້າຍຄືກັບຄຳແປປັດຈຸບັນ!"

msgid "Your suggestion already exists!"
msgstr "ຄຳແນະນຳຂອງທ່ານມີຢູ່ແລ້ວ!"

msgid "Weblate's REST API"
msgstr "REST API ຂອງ Weblate"

msgid ""
"Could not remove the string because another background operation is in "
"progress. Please try again later."
msgstr ""
"ບໍ່ສາມາດລຶບຂໍ້ຄວາມໄດ້ເນື່ອງຈາກມີການດຳເນີນການອື່ນໃນພື້ນຫຼັງກຳລັງເຮັດວຽກຢູ່. ກະລຸນາລອງໃໝ່ພາຍຫຼັງ."

msgid "Could not obtain the lock to perform the operation."
msgstr "ບໍ່ສາມາດໄດ້ຮັບສິດລັອກ (lock) ເພື່ອດຳເນີນການ."

msgid "Specified unit id is not a translation source unit."
msgstr "Unit id ທີ່ລະບຸບໍ່ແມ່ນ unit ຕົ້ນສະບັບຂອງການແປ."

#, python-format
msgid "Could not obtain the repository lock for %s to perform the operation."
msgstr "ບໍ່ສາມາດໄດ້ຮັບສິດລັອກຄັງເກັບລະຫັດສຳລັບ %s ເພື່ອດຳເນີນການ."

#, python-format
msgid ""
"Could not obtain the update lock for component %s to perform the operation."
msgstr "ບໍ່ສາມາດໄດ້ຮັບສິດລັອກການອັບເດດສຳລັບສ່ວນປະກອບ %s ເພື່ອດຳເນີນການ."

#, python-format
msgid ""
"Could not obtain the %(scope)s lock for %(origin)s to perform the operation."
msgstr "ບໍ່ສາມາດໄດ້ຮັບສິດລັອກ %(scope)s ສຳລັບ %(origin)s ເພື່ອດຳເນີນການ."

msgid "Expected an object."
msgstr "ຕ້ອງການຂໍ້ມູນປະເພດ object."

msgid "At least one team is required for a project token."
msgstr "ຕ້ອງມີຢ່າງໜ້ອຍໜຶ່ງທີມສຳລັບ project token."

msgid "This role cannot be assigned to this team."
msgstr "ບໍ່ສາມາດມອບໝາຍບົດບາດນີ້ໃຫ້ກັບທີມນີ້ໄດ້."

msgid "Cannot change languages on a workspace team."
msgstr "ບໍ່ສາມາດປ່ຽນພາສາໃນທີມຂອງພື້ນທີ່ເຮັດວຽກໄດ້."

msgid "Cannot change projects on a scoped team."
msgstr "ບໍ່ສາມາດປ່ຽນໂຄງການໃນທີມທີ່ມີການກຳນົດຂອບເຂດໄດ້."

msgid "Cannot change component lists on a scoped team."
msgstr "ບໍ່ສາມາດປ່ຽນລາຍຊື່ສ່ວນປະກອບໃນທີມທີ່ມີການກຳນົດຂອບເຂດໄດ້."

msgid "Cannot change components on a workspace team."
msgstr "ບໍ່ສາມາດປ່ຽນສ່ວນປະກອບໃນທີມຂອງພື້ນທີ່ເຮັດວຽກໄດ້."

msgid "Report generation scheduled."
msgstr "ກຳນົດເວລາການສ້າງລາຍງານແລ້ວ."

msgid "Specify a workspace when multiple workspaces can be used."
msgstr "ລະບຸພື້ນທີ່ເຮັດວຽກເມື່ອມີຫຼາຍພື້ນທີ່ທີ່ສາມາດໃຊ້ໄດ້."

msgid "You do not have permission to approve strings."
msgstr "ທ່ານບໍ່ມີສິດອະນຸຍາດໃນການອະນຸມັດຂໍ້ຄວາມ."

msgid "This string seems to already exist."
msgstr "ຂໍ້ຄວາມນີ້ເບິ່ງຄືວ່າຈະມີຢູ່ແລ້ວ."

msgid "Project"
msgstr "ໂຄງການ"

msgid "Category"
msgstr "ໝວດໝູ່"

msgid "Component"
msgstr "ສ່ວນປະກອບ"

msgid "User"
msgstr "ຜູ້ໃຊ້"

msgid "Language"
msgstr "ພາສາ"

msgid "Personal info"
msgstr "ຂໍ້ມູນສ່ວນຕົວ"

msgid "Authentication"
msgstr "ການຢືນຢັນຕົວຕົນ"

msgid "Permissions"
msgstr "ສິດອະນຸຍາດ"

msgid "Important dates"
msgstr "ວັນທີສຳຄັນ"

msgid "This is not used when a component list is selected."
msgstr "ສິ່ງນີ້ຈະບໍ່ຖືກນຳໃຊ້ເມື່ອມີການເລືອກລາຍຊື່ສ່ວນປະກອບ."

msgid "This is not used when a component is selected."
msgstr "ສິ່ງນີ້ຈະບໍ່ຖືກນຳໃຊ້ເມື່ອມີການເລືອກສ່ວນປະກອບ."

#. Translators: Permission name
