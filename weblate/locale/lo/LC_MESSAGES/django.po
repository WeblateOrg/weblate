msgid "Browse all projects"
msgstr "ເບິ່ງໂຄງການທັງໝົດ"

msgid "CSRF verification failed. Request aborted."
msgstr "ການກວດສອບ CSRF ຫຼົ້ມເຫຼວ. ຄຳຮ້ອງຂໍຖືກຍົກເລີກ."

msgid ""
"This HTTPS site requires a 'Referer' header to be sent by your web browser, "
"but none was sent. This header is required for security reasons, ensuring "
"that your browser is not being hijacked by third parties."
msgstr ""
"ເວັບໄຊ HTTPS ນີ້ຕ້ອງການສ່ວນຫົວ 'Referer' ຈາກບຣາວເຊີຂອງທ່ານ, ແຕ່ບໍ່ໄດ້ຮັບຂໍ້ມູນ. "
"ສ່ວນຫົວນີ້ຈຳເປັນເພື່ອຄວາມປອດໄພ ເພື່ອໃຫ້ແນ່ໃຈວ່າບຣາວເຊີຂອງທ່ານບໍ່ໄດ້ຖືກຄວບຄຸມໂດຍບຸກຄົນທີສາມ."

msgid ""
"If you have set up your web browser to not send 'Referer' headers,  you need "
"to turn that on (at least for this site, HTTPS connections, or 'same-origin' "
"requests)."
msgstr ""
"ຖ້າທ່ານຕັ້ງຄ່າບຣາວເຊີບໍ່ໃຫ້ສົ່ງສ່ວນຫົວ 'Referer', ທ່ານຕ້ອງເປີດມັນຄືນ (ຢ່າງໜ້ອຍສຳລັບເວັບໄຊນີ້, "
"ການເຊື່ອມຕໍ່ HTTPS ຫຼື ຄຳຮ້ອງຂໍ 'same-origin')."

msgid ""
"Our site requires a session cookie to make the forms work. This cookie is "
"required for security reasons, ensuring that your browser is not being "
"hijacked by third parties."
msgstr "ເວັບໄຊຂອງພວກເຮົາຕ້ອງການຄຸກກີ້ເຊດຊັນເພື່ອໃຫ້ຟອມເຮັດວຽກໄດ້. ຄຸກກີ້ນີ້ຈຳເປັນເພື່ອຄວາມປອດໄພ."

msgid ""
"It might have happened that your session cookie expired due to inactivity. "
"This can easily happen for unauthenticated requests where session validity "
"is limited. You might want to try your intended action again in such a case."
msgstr ""
"ຄຸກກີ້ເຊດຊັນຂອງທ່ານອາດຈະໝົດອາຍຸເນື່ອງຈາກບໍ່ມີການເຄື່ອນໄຫວ. ນີ້ມັກຈະເກີດຂຶ້ນກັບຄຳຮ້ອງຂໍທີ່ບໍ່ໄດ້ຢືນຢັນຕົວຕົນ. "
"ກະລຸນາລອງໃໝ່ອີກຄັ້ງ."

msgid ""
"If you have set up your browser to not save cookies, you need to enable "
"saving them (at least for this site, or 'same-origin' requests)."
msgstr ""
"ຖ້າທ່ານຕັ້ງຄ່າບຣາວເຊີບໍ່ໃຫ້ບັນທຶກຄຸກກີ້, ທ່ານຕ້ອງເປີດໃຫ້ມີການບັນທຶກ (ຢ່າງໜ້ອຍສຳລັບເວັບໄຊນີ້ ຫຼື ຄຳຮ້ອງຂໍ "
"'same-origin')."

#, python-format
msgid "CSRF failure reason: %(reason)s"
msgstr "ເຫດຜົນທີ່ CSRF ຫຼົ້ມເຫຼວ: %(reason)s"

msgid "Page Not Found"
msgstr "ບໍ່ພົບໜ້ານີ້"

msgid "The page you are looking for was not found."
msgstr "ບໍ່ພົບໜ້າທີ່ທ່ານກຳລັງຊອກຫາ."

msgid ""
"The project you are looking for does not exist or is not publicly available."
msgstr "ໂຄງການທີ່ທ່ານກຳລັງຊອກຫາບໍ່ມີຢູ່ ຫຼື ບໍ່ໄດ້ເປີດເປັນສາທາລະນະ."

msgid "Internal Server Error"
msgstr "ເຊີບເວີພາຍໃນເກີດຂໍ້ຜິດພາດ"

msgid "Server Error"
msgstr "ເຊີບເວີເກີດຂໍ້ຜິດພາດ"

#, python-format
msgid ""
"The server had serious problems serving your request, and this error has "
"been recorded as %(error_id)s."
msgstr ""
"ເຊີບເວີມີບັນຫາຮ້າຍແຮງໃນການປະມວນຜົນຄຳຮ້ອງຂໍຂອງທ່ານ, ແລະ ຂໍ້ຜິດພາດນີ້ຖືກບັນທຶກເປັນ %(error_id)s."

msgid ""
"The server had serious problems serving your request. You might want to "
"contact server admins in case the error persists."
msgstr ""
"ເຊີບເວີມີບັນຫາຮ້າຍແຮງໃນການປະມວນຜົນຄຳຮ້ອງຂໍຂອງທ່ານ. "
"ທ່ານອາດຈະຕ້ອງຕິດຕໍ່ຜູ້ດູແລລະບົບຖ້າບັນຫາຍັງເກີດຂຶ້ນຢູ່."

msgid "About Weblate"
msgstr "ກ່ຽວກັບ Weblate"

msgid "Support Weblate"
msgstr "ສະໜັບສະໜູນ Weblate"

msgid "Help <strong>Weblate</strong> keep thriving"
msgstr "ຊ່ວຍໃຫ້ <strong>Weblate</strong> ເຕີບໃຫຍ່ຂະຫຍາຍຕົວຕໍ່ໄປ"

msgid "Welcome and thank you for supporting Weblate"
msgstr "ຍິນດີຕ້ອນຮັບ ແລະ ຂໍຂອບໃຈທີ່ສະໜັບສະໜູນ Weblate"

msgid "Welcome and thank you for choosing Weblate"
msgstr "ຍິນດີຕ້ອນຮັບ ແລະ ຂໍຂອບໃຈທີ່ເລືອກໃຊ້ Weblate"

msgid ""
"the privacy-respecting localization platform committed to open-source values."
msgstr "ແພລັດຟອມການແປພາສາທີ່ເຄົາລົບຄວາມເປັນສ່ວນຕົວ ແລະ ຍຶດໝັ້ນໃນຄຸນຄ່າຂອງ open-source."

msgctxt "Label on donate page"
msgid "GitHub star"
msgid_plural "GitHub stars"
msgstr[0] "ດາວໃນ GitHub"

msgctxt "Label on donate page"
msgid "Open issue"
msgid_plural "Open issues"
msgstr[0] "ບັນຫາທີ່ເປີດຢູ່"

msgctxt "Label on donate page"
msgid "Recent change"
msgid_plural "Recent changes"
msgstr[0] "ການປ່ຽນແປງຫຼ້າສຸດ"

msgid "Give to Weblate"
msgstr "ບໍລິຈາກໃຫ້ Weblate"

msgid "Hosting translations"
msgstr "ບໍລິການໂຮດຕິ້ງການແປ"

msgid ""
"This Weblate instance hosts translations for various libre software projects."
msgstr "Weblate ອິນສະແຕນຊ໌ນີ້ເປັນບ່ອນເກັບຂໍ້ມູນການແປສຳລັບໂຄງການຊອບແວເສລີຕ່າງໆ."

msgid "Weblate can host your project as well, please get in touch."
msgstr "Weblate ສາມາດໂຮດໂຄງການຂອງທ່ານໄດ້ຄືກັນ, ກະລຸນາຕິດຕໍ່ພວກເຮົາ."

msgid ""
"Start your gratis trial today and explore our competitively priced "
"commercial hosting solutions."
msgstr "ເລີ່ມທົດລອງໃຊ້ຟຣີມື້ນີ້ ແລະ ສຶກສາແຜນບໍລິການໂຮດຕິ້ງແບບທຸລະກິດໃນລາຄາທີ່ຄຸ້ມຄ່າ."

msgid "Ask for Libre hosting"
msgstr "ຂໍໃຊ້ໂຮດຕິ້ງແບບເສລີ (Libre)"

msgid "View hosting plans"
msgstr "ເບິ່ງແຜນໂຮດຕິ້ງ"

msgid "Gratis trial for commercial hosting"
msgstr "ທົດລອງໃຊ້ຟຣີສຳລັບໂຮດຕິ້ງແບບທຸລະກິດ"

msgid "Contact us for commercial hosting"
msgstr "ຕິດຕໍ່ພວກເຮົາສຳລັບໂຮດຕິ້ງແບບທຸລະກິດ"

msgid "Weblate is built on libre software"
msgstr "Weblate ຖືກສ້າງຂຶ້ນດ້ວຍຊອບແວເສລີ"

msgid "Weblate keys"
msgstr "ຄີ (Keys) ຂອງ Weblate"

msgid "Commit signing"
msgstr "ການເຊັນຊື່ Commit"

msgid "Public key copied to clipboard."
msgstr "ຄັດລອກ Public key ໄປທີ່ຄລິບບອດແລ້ວ."

msgid "Copy to clipboard"
msgstr "ຄັດລອກໄປທີ່ຄລິບບອດ"

#, python-format
msgid ""
"All commits made with Weblate are signed with the GPG key %(gpg_key_id)s, "
"for which the corresponding public key is found below."
msgstr ""
"ທຸກໆ Commit ທີ່ເຮັດຜ່ານ Weblate ຈະຖືກເຊັນດ້ວຍ GPG key %(gpg_key_id)s, ເຊິ່ງທ່ານສາມາດເບິ່ງ "
"Public key ທີ່ກ່ຽວຂ້ອງໄດ້ຢູ່ລຸ່ມນີ້."

msgid "Commit signing is not configured."
msgstr "ຍັງບໍ່ໄດ້ຕັ້ງຄ່າການເຊັນຊື່ Commit."

msgid "Statistics"
msgstr "ສະຖິຕິ"

msgid "Second factor sign-in"
msgstr "ການເຂົ້າສູ່ລະບົບດ້ວຍປັດໄຈທີສອງ"

msgid "Please complete your sign-in using second factor credential."
msgstr "ກະລຸນາສຳເລັດການເຂົ້າສູ່ລະບົບໂດຍໃຊ້ຂໍ້ມູນຢືນຢັນຕົວຕົນປັດໄຈທີສອງ."

msgid "Your profile"
msgstr "ໂປຣໄຟລ໌ຂອງທ່ານ"

msgid "Confirm adding user identity"
msgstr "ຢືນຢັນການເພີ່ມຕົວຕົນຜູ້ໃຊ້"

#. Translators: backend_verbose is name of authentication backend, for example GitHub or Facebook, uid is user identifier, it can be username, email, number or URL
#, python-format
msgid ""
"After confirming this, you will be able to authenticate to Weblate using "
"%(backend_verbose)s (%(uid)s)."
msgstr ""
"ຫຼັງຈາກຢືນຢັນສິ່ງນີ້, ທ່ານຈະສາມາດຢືນຢັນຕົວຕົນກັບ Weblate ໂດຍໃຊ້ %(backend_verbose)s "
"(%(uid)s)."

msgid "Confirm"
msgstr "ຢືນຢັນ"

msgid "Contact server administrators"
msgstr "ຕິດຕໍ່ຜູ້ດູແລເຊີບເວີ"

#, python-format
msgid "Use this form to reach the administrators of %(site_title)s."
msgstr "ໃຊ້ຟອມນີ້ເພື່ອຕິດຕໍ່ຜູ້ດູແລລະບົບຂອງ %(site_title)s."

msgid "Use this form to reach the administrators of this server."
msgstr "ໃຊ້ຟອມນີ້ເພື່ອຕິດຕໍ່ຜູ້ດູແລລະບົບຂອງເຊີບເວີນີ້."

msgid "Back"
msgstr "ກັບຄືນ"

msgid "Send"
msgstr "ສົ່ງ"

msgid "How can we help?"
msgstr "ພວກເຮົາສາມາດຊ່ວຍຫຍັງໄດ້ແດ່?"

msgid "Select one of the options below to get help."
msgstr "ເລືອກຕົວເລືອກໃດໜຶ່ງຂ້າງລຸ່ມນີ້ເພື່ອຂໍຄວາມຊ່ວຍເຫຼືອ."

msgid "Question about a translation project"
msgstr "ຄຳຖາມກ່ຽວກັບໂຄງການແປພາສາ"

msgid ""
"Find a specific translation project, refer to the project's Overview tab and "
"contact its maintainers directly."
msgstr ""
"ຄົ້ນຫາໂຄງການແປພາສາທີ່ຕ້ອງການ, ເບິ່ງທີ່ແຖບພາບລວມຂອງໂຄງການ ແລະ ຕິດຕໍ່ຜູ້ດູແລໂຄງການໂດຍກົງ."

msgid "Browse projects"
msgstr "ເບິ່ງໂຄງການ"

msgid "Weblate product feedback"
msgstr "ຄຳຄິດເຫັນກ່ຽວກັບຜະລິດຕະພັນ Weblate"

msgid ""
"Share Weblate development ideas, feature requests, or report bugs in the "
"upstream issue tracker."
msgstr "ແບ່ງປັນແນວຄິດການພັດທະນາ Weblate, ຮ້ອງຂໍຟີເຈີໃໝ່ ຫຼື ລາຍງານບັກໃນລະບົບຕິດຕາມບັນຫາ."

msgid "Open issue tracker"
msgstr "ເປີດລະບົບຕິດຕາມບັນຫາ"

msgid "Support for another Weblate server"
msgstr "ການຊ່ວຍເຫຼືອສຳລັບ Weblate ເຊີບເວີອື່ນ"

#, python-format
msgid ""
"If you seek support for any other Weblate deployment than %(site_title)s, "
"check the available support offerings, or use the contact form on the "
"correct server."
msgstr ""
"ຖ້າທ່ານຕ້ອງການການຊ່ວຍເຫຼືອສຳລັບ Weblate ເຊີບເວີອື່ນທີ່ບໍ່ແມ່ນ %(site_title)s, "
"ກະລຸນາກວດເບິ່ງການບໍລິການທີ່ມີ ຫຼື ໃຊ້ຟອມຕິດຕໍ່ໃນເຊີບເວີທີ່ຖືກຕ້ອງ."

msgid "View support offerings"
msgstr "ເບິ່ງການບໍລິການຊ່ວຍເຫຼືອ"

msgid "Documentation"
msgstr "ເອກະສານແນະນຳ"

msgid ""
"Browse the Weblate documentation for guides on translating, administration, "
"and configuration."
msgstr "ເບິ່ງເອກະສານແນະນຳ Weblate ສຳລັບວິທີການແປ, ການບໍລິຫານຈັດການ ແລະ ການຕັ້ງຄ່າ."

msgid "Read the docs"
msgstr "ອ່ານເອກະສານ"

#, python-format
msgid "Question for %(site_title)s administrators"
msgstr "ຄຳຖາມສຳລັບຜູ້ດູແລ %(site_title)s"

msgid "Question for the server administrators"
msgstr "ຄຳຖາມສຳລັບຜູ້ດູແລເຊີບເວີ"

msgid ""
"Reach out to the administrators of this server about account, registration, "
"or server-wide questions that don't fit the topics above."
msgstr ""
"ຕິດຕໍ່ຜູ້ດູແລເຊີບເວີນີ້ກ່ຽວກັບບັນຊີ, ການລົງທະບຽນ ຫຼື ຄຳຖາມທົ່ວໄປກ່ຽວກັບເຊີບເວີທີ່ບໍ່ກົງກັບຫົວຂໍ້ຂ້າງເທິງ."

msgid "Open contact form"
msgstr "ເປີດຟອມຕິດຕໍ່"

msgid "Registration"
msgstr "ການລົງທະບຽນ"

msgid "Password reset almost complete"
msgstr "ການຕັ້ງຄ່າລະຫັດຜ່ານໃໝ່ເກືອບສຳເລັດແລ້ວ"

msgid "Account removal almost complete"
msgstr "ການລຶບບັນຊີເກືອບສຳເລັດແລ້ວ"

msgid "Registration almost complete"
msgstr "ການລົງທະບຽນເກືອບສຳເລັດແລ້ວ"

msgid "Follow the password recovery instructions sent to your e-mail inbox."
msgstr "ກະລຸນາປະຕິບັດຕາມວິທີການກູ້ຄືນລະຫັດຜ່ານທີ່ສົ່ງໄປຫາອິນບັອກອີເມລຂອງທ່ານ."

msgid ""
"Remove your account by clicking the confirmation link sent to your e-mail "
"inbox."
msgstr "ລຶບບັນຊີຂອງທ່ານໂດຍການຄລິກລິ້ງຢືນຢັນທີ່ສົ່ງໄປຫາອິນບັອກອີເມລຂອງທ່ານ."

msgid ""
"Click the confirmation link sent to your e-mail inbox and start using your "
"account."
msgstr "ຄລິກລິ້ງຢືນຢັນທີ່ສົ່ງໄປຫາອິນບັອກອີເມລຂອງທ່ານເພື່ອເລີ່ມໃຊ້ງານບັນຊີ."

msgid "Please look into your spam folder if you cannot see it in your inbox."
msgstr "ຖ້າທ່ານບໍ່ເຫັນອີເມລໃນອິນບັອກ, ກະລຸນາກວດເບິ່ງໃນໂຟນເດີອີເມລຂີ້ເຫຍື້ອ (Spam)."

#, python-format
msgid "The confirmation link will expire after %(count)s hour."
msgid_plural "The confirmation link will expire after %(count)s hours."
msgstr[0] "ລິ້ງຢືນຢັນຈະໝົດອາຍຸພາຍໃນ %(count)s ຊົ່ວໂມງ."

msgid "Request a new confirmation link if it expires."
msgstr "ຂໍລິ້ງຢືນຢັນໃໝ່ຖ້າລິ້ງເກົ່າໝົດອາຍຸ."

msgid "Register again if the confirmation link expires."
msgstr "ລົງທະບຽນໃໝ່ອີກຄັ້ງຖ້າລິ້ງຢືນຢັນໝົດອາຍຸ."

msgid ""
"E-mail is not an instant technology. Please wait for the confirmation e-mail "
"at least 30 minutes before you write to us about issues."
msgstr ""
"ອີເມລບໍ່ແມ່ນເຕັກໂນໂລຊີທີ່ສົ່ງເຖິງທັນທີ. ກະລຸນາລໍຖ້າອີເມລຢືນຢັນຢ່າງໜ້ອຍ 30 ນາທີກ່ອນຈະແຈ້ງບັນຫາກັບພວກເຮົາ."

msgid "If there is a problem with your registration, please contact us."
msgstr "ຖ້າມີບັນຫາກ່ຽວກັບການລົງທະບຽນຂອງທ່ານ, ກະລຸນາຕິດຕໍ່ພວກເຮົາ."

msgid "Please fix errors in the registration form."
msgstr "ກະລຸນາແກ້ໄຂຂໍ້ຜິດພາດໃນຟອມລົງທະບຽນ."

