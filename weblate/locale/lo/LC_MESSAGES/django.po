msgstr "ລາຍງານການເຄື່ອນໄຫວທີ່ໜ້າສົງໄສ"

msgid ""
"The API key can be used to control Weblate via the HTTP REST API and to "
"access Weblate Git repositories."
msgstr ""
"ຄີ API ສາມາດໃຊ້ເພື່ອຄວບຄຸມ Weblate ຜ່ານ HTTP REST API ແລະ ເຂົ້າເຖິງ Git repositories "
"ຂອງ Weblate."

msgid "Your personal API key:"
msgstr "ຄີ API ສ່ວນຕົວຂອງທ່ານ:"

msgid "Toggle API key visibility"
msgstr "ສະແດງ/ເຊື່ອງ ຄີ API"

msgid "API key copied to clipboard."
msgstr "ຄັດລອກຄີ API ໄປໃສ່ຄລິບບອດແລ້ວ."

msgid "API root URL:"
msgstr "API root URL:"

msgid "API usage example:"
msgstr "ຕົວຢ່າງການໃຊ້ API:"

msgid "CLI usage example:"
msgstr "ຕົວຢ່າງການໃຊ້ CLI:"

msgid "Accessing Git repositories"
msgstr "ການເຂົ້າເຖິງ Git repositories"

msgid ""
"The API key is also used to authenticate to automatically exported Git "
"repositories."
msgstr "ຄີ API ຍັງຖືກໃຊ້ເພື່ອຢືນຢັນຕົວຕົນໃນການສົ່ງອອກ Git repositories ໂດຍອັດຕະໂນມັດ."

msgid ""
"Please pay attention to the licensing info, as this specifies how "
"translations can be used."
msgstr "ກະລຸນາໃສ່ໃຈຂໍ້ມູນໃບອະນຸຍາດ ເນື່ອງຈາກມັນລະບຸວິທີການນຳໃຊ້ຄຳແປ."

msgid ""
"By registering you agree to use your name and e-mail in the commits, and "
"provide your contribution under the license defined by each localization "
"project."
msgstr ""
"ໂດຍການລົງທະບຽນ, ທ່ານຍິນຍອມໃຫ້ໃຊ້ຊື່ ແລະ ອີເມວຂອງທ່ານໃນການຄອມມິດ ແລະ "
"ສະໜອງການປະກອບສ່ວນຂອງທ່ານພາຍໃຕ້ໃບອະນຸຍາດທີ່ກຳນົດໂດຍແຕ່ລະໂຄງການແປພາສາ."

msgid "You have agreed to the following as a contributor:"
msgstr "ທ່ານໄດ້ຕົກລົງເຫັນດີຕໍ່ສິ່ງຕໍ່ໄປນີ້ໃນຖານະຜູ້ປະກອບສ່ວນ:"

msgid "Licenses for individual translations"
msgstr "ໃບອະນຸຍາດສຳລັບການແປແຕ່ລະລາຍການ"

msgid "Two-factor recovery codes"
msgstr "ລະຫັດກູ້ຄືນສອງຊັ້ນ"

msgid ""
"Recovery codes can be used to access your account if you lose access to your "
"device and cannot receive two-factor authentication codes."
msgstr ""
"ລະຫັດກູ້ຄືນສາມາດໃຊ້ເພື່ອເຂົ້າເຖິງບັນຊີຂອງທ່ານໄດ້ ຫາກທ່ານເສຍການເຂົ້າເຖິງອຸປະກອນ ແລະ "
"ບໍ່ສາມາດຮັບລະຫັດຢືນຢັນຕົວຕົນສອງຊັ້ນໄດ້."

msgid ""
"Keep your recovery codes in a safe spot, like in a password manager. These "
"codes are the last resort for accessing your account in case you lose your "
"password and other second factors. If you cannot find these codes when "
"needed, you will lose access to your account."
msgstr ""
"ເກັບລະຫັດກູ້ຄືນຂອງທ່ານໄວ້ໃນບ່ອນທີ່ປອດໄພ ເຊັ່ນ ໃນແອັບຈັດການລະຫັດຜ່ານ. "
"ລະຫັດເຫຼົ່ານີ້ແມ່ນທາງເລືອກສຸດທ້າຍໃນການເຂົ້າເຖິງບັນຊີຂອງທ່ານໃນກໍລະນີທີ່ທ່ານເສຍລະຫັດຜ່ານ ແລະ ປັດໄຈອື່ນໆ. "
"ຫາກທ່ານບໍ່ສາມາດຊອກຫາລະຫັດເຫຼົ່ານີ້ໄດ້ເມື່ອຈຳເປັນ, ທ່ານຈະເສຍການເຂົ້າເຖິງບັນຊີຂອງທ່ານ."

msgid "Recovery codes copied to clipboard."
msgstr "ຄັດລອກລະຫັດກູ້ຄືນໄປໃສ່ຄລິບບອດແລ້ວ."

msgid "There are currently no recovery codes generated."
msgstr "ໃນປັດຈຸບັນຍັງບໍ່ທັນມີການສ້າງລະຫັດກູ້ຄືນ."

msgid ""
"When you generate new recovery codes, you must download or print the new "
"codes."
msgstr "ເມື່ອທ່ານສ້າງລະຫັດກູ້ຄືນໃໝ່, ທ່ານຕ້ອງດາວໂຫຼດ ຫຼື ພິມລະຫັດໃໝ່ອອກມາ."

msgid "Your old codes will become invalid and won't work anymore."
msgstr "ລະຫັດເກົ່າຂອງທ່ານຈະບໍ່ສາມາດໃຊ້ງານໄດ້ອີກຕໍ່ໄປ."

msgid "Back to account settings"
msgstr "ກັບຄືນໄປການຕັ້ງຄ່າບັນຊີ"

msgid "Redirecting you to the authentication provider."
msgstr "ກຳລັງນຳທ່ານໄປຫາຜູ້ໃຫ້ບໍລິການຢືນຢັນຕົວຕົນ."

msgid "Registration without a password:"
msgstr "ການລົງທະບຽນໂດຍບໍ່ມີລະຫັດຜ່ານ:"

msgid ""
"You can set your password later by clicking on the link in the verification "
"email."
msgstr "ທ່ານສາມາດຕັ້ງລະຫັດຜ່ານພາຍຫຼັງໄດ້ ໂດຍຄລິກທີ່ລິ້ງໃນອີເມວຍືນຢັນ."

msgid "Please complete the registration to accept the invitation."
msgstr "ກະລຸນາລົງທະບຽນໃຫ້ສຳເລັດເພື່ອຮັບຄຳເຊີນ."

#, python-format
msgid "Register in %(formatted_site_title)s"
msgstr "ລົງທະບຽນໃນ %(formatted_site_title)s"

msgid "Create an account using:"
msgstr "ສ້າງບັນຊີດ້ວຍ:"

msgid "Sorry, new registrations are turned off on this site."
msgstr "ຂໍອະໄພ, ການລົງທະບຽນໃໝ່ຖືກປິດໃຊ້ງານໃນເວັບໄຊນີ້."

msgid "You can contact us for more details."
msgstr "ທ່ານສາມາດຕິດຕໍ່ພວກເຮົາເພື່ອຂໍລາຍລະອຽດເພີ່ມເຕີມ."

msgid "Account removal"
msgstr "ການລຶບບັນຊີ"

msgid ""
"You will lose access to the projects you manage. Projects themselves will "
"not be removed."
msgstr "ທ່ານຈະເສຍການເຂົ້າເຖິງໂຄງການທີ່ທ່ານຈັດການ. ແຕ່ຕົວໂຄງການຈະບໍ່ຖືກລຶບອອກ."

msgid ""
"Any billing you might have created will not be terminated by this account "
"removal."
msgstr "ການຮຽກເກັບເງິນໃດໆທີ່ທ່ານສ້າງຂຶ້ນຈະບໍ່ຖືກຍົກເລີກໂດຍການລຶບບັນຊີນີ້."

msgid ""
"By pressing the following button, you will no longer be able to use this "
"account."
msgstr "ໂດຍການກົດປຸ່ມຕໍ່ໄປນີ້, ທ່ານຈະບໍ່ສາມາດໃຊ້ບັນຊີນີ້ໄດ້ອີກຕໍ່ໄປ."

msgid ""
"You will have to confirm the account removal by clicking the link in the e-"
"mail you will receive."
msgstr "ທ່ານຕ້ອງຢືນຢັນການລຶບບັນຊີໂດຍຄລິກລິ້ງໃນອີເມວທີ່ທ່ານຈະໄດ້ຮັບ."

msgid "Delete this account"
msgstr "ລຶບບັນຊີນີ້"

msgid "Forgotten your password? You can now set new one."
msgstr "ລືມລະຫັດຜ່ານບໍ? ທ່ານສາມາດຕັ້ງລະຫັດຜ່ານໃໝ່ໄດ້ດຽວນີ້."

msgid ""
"Forgotten your password? Enter your e-mail address below, and we'll e-mail "
"instructions for setting a new one."
msgstr ""
"ລືມລະຫັດຜ່ານບໍ? ປ້ອນທີ່ຢູ່ອີເມວຂອງທ່ານຂ້າງລຸ່ມນີ້, ແລ້ວພວກເຮົາຈະສົ່ງຄຳແນະນຳການຕັ້ງລະຫັດຜ່ານໃໝ່ໄປໃຫ້."

msgid "Set my password"
msgstr "ຕັ້ງລະຫັດຜ່ານຂອງຂ້ອຍ"

msgid "Reset my password"
msgstr "ຕັ້ງລະຫັດຜ່ານໃໝ່"

msgid "Web-based <strong>continuous</strong> localization"
msgstr "ການແປພາສາແບບ <strong>ຕໍ່ເນື່ອງ</strong> ຜ່ານເວັບ"

#. Translators: This is followed by list of legal documents such as Privacy Policy or General Terms and Conditions
msgid "By registering and signing in to this service you accept our:"
msgstr "ໂດຍການລົງທະບຽນ ແລະ ເຂົ້າສູ່ລະບົບ, ທ່ານຍອມຮັບ:"

msgid ""
"Quick overview of the General Terms and Conditions and the Privacy Policy, "
"but you should still read the original documents to fully understand them:"
msgstr ""
"ພາບລວມໂດຍຫຍໍ້ຂອງເງື່ອນໄຂທົ່ວໄປ ແລະ ນະໂຍບາຍຄວາມເປັນສ່ວນຕົວ, "
"ແຕ່ທ່ານຄວນອ່ານເອກະສານຕົ້ນສະບັບເພື່ອຄວາມເຂົ້າໃຈຢ່າງຄົບຖ້ວນ:"

msgid ""
"By registering, you agree that your name and username will be visible "
"publicly as long as your account exists."
msgstr ""
"ໂດຍການລົງທະບຽນ, ທ່ານຍິນຍອມໃຫ້ຊື່ ແລະ ຊື່ຜູ້ໃຊ້ຂອງທ່ານປະກົດຕໍ່ສາທາລະນະຕາບໃດທີ່ບັນຊີຂອງທ່ານຍັງມີຢູ່."

msgid ""
"Additionally, your name and e-mail can be used in version control system "
"commits to author the changes you made; they can be stored there "
"indefinitely."
msgstr ""
"ນອກຈາກນັ້ນ, ຊື່ ແລະ "
"ອີເມວຂອງທ່ານສາມາດຖືກໃຊ້ໃນການຄອມມິດຂອງລະບົບຄວບຄຸມເວີຊັນເພື່ອລະບຸຕົວຕົນຜູ້ແກ້ໄຂ; "
"ເຊິ່ງຂໍ້ມູນເຫຼົ່ານີ້ອາດຖືກເກັບໄວ້ຕະຫຼອດໄປ."

msgid ""
"You can enable the use of a private commit e-mail and name in your profile."
msgstr "ທ່ານສາມາດເປີດໃຊ້ງານການໃຊ້ ອີເມວ ແລະ ຊື່ ສ່ວນຕົວສຳລັບການຄອມມິດໄດ້ໃນໂປຣໄຟລ໌ຂອງທ່ານ."

msgid "You can enable the use of a private commit e-mail in your profile."
msgstr "ທ່ານສາມາດເປີດໃຊ້ງານການໃຊ້ ອີເມວ ສ່ວນຕົວສຳລັບການຄອມມິດໄດ້ໃນໂປຣໄຟລ໌ຂອງທ່ານ."

msgid ""
"Additionally, your name can be used in version control system commits to "
"author the changes you made; it can be stored there indefinitely."
msgstr ""
"ນອກຈາກນັ້ນ, ຊື່ຂອງທ່ານສາມາດຖືກໃຊ້ໃນການຄອມມິດຂອງລະບົບຄວບຄຸມເວີຊັນເພື່ອລະບຸຕົວຕົນຜູ້ແກ້ໄຂ; "
"ເຊິ່ງອາດຖືກເກັບໄວ້ຕະຫຼອດໄປ."

msgid "You can enable the use of a private commit name in your profile."
msgstr "ທ່ານສາມາດເປີດໃຊ້ງານການໃຊ້ ຊື່ ສ່ວນຕົວສຳລັບການຄອມມິດໄດ້ໃນໂປຣໄຟລ໌ຂອງທ່ານ."

msgid ""
"You provide your contribution under the license defined by each project you "
"contributed to."
msgstr "ທ່ານສະໜອງການປະກອບສ່ວນຂອງທ່ານພາຍໃຕ້ໃບອະນຸຍາດທີ່ກຳນົດໂດຍແຕ່ລະໂຄງການທີ່ທ່ານປະກອບສ່ວນ."

msgid "Weblate single sign on"
msgstr "ການລົງຊື່ເຂົ້າໃຊ້ຄັ້ງດຽວຂອງ Weblate"

msgctxt "Badge for site title for Hosted Weblate"
msgid "Cloud"
msgstr "ຄລາວ"

msgctxt "Badge for site title for dedicated instances"
msgid "Dedicated"
msgstr "ແບບສ່ວນຕົວ"

msgctxt "Badge for site title for self-hosted instances"
msgid "Self-hosted"
msgstr "ຕັ້ງໂຮສເອງ"

msgid ""
"Authenticator apps generate time-based one-time passwords that are used as a "
"second factor to verify your identity when prompted during sign-in."
msgstr ""
"ແອັບຢືນຢັນຕົວຕົນຈະສ້າງລະຫັດຜ່ານຄັ້ງດຽວແບບກຳນົດເວລາ "
"ເຊິ່ງໃຊ້ເປັນປັດໄຈທີສອງເພື່ອຢືນຢັນຕົວຕົນຂອງທ່ານເມື່ອມີການຖາມໃນຕອນເຂົ້າສູ່ລະບົບ."

msgid "Scan the QR code"
msgstr "ສະແກນ QR ໂຄ້ດ"

msgid "You can also enter the secret key manually:"
msgstr "ທ່ານຍັງສາມາດປ້ອນຄີລັບດ້ວຍຕົນເອງ:"

msgid "Secret key copied to clipboard."
msgstr "ຄັດລອກຄີລັບໄປໃສ່ຄລິບບອດແລ້ວ."

msgid "Confirm registration"
msgstr "ຢືນຢັນການລົງທະບຽນ"

msgid "Thank you for your interest in trying Weblate!"
msgstr "ຂອບໃຈທີ່ທ່ານສົນໃຈທົດລອງໃຊ້ Weblate!"

msgid "Your trial offer"
msgstr "ຂໍ້ສະເໜີທົດລອງໃຊ້ຂອງທ່ານ"

#, python-format
msgid "Your trial will last %(days)s day."
msgid_plural "Your trial will last %(days)s days."
msgstr[0] "ການທົດລອງໃຊ້ຂອງທ່ານຈະມີກຳນົດ %(days)s ມື້."

msgid "Your trial will run the 640k plan, but you can choose any plan later."
msgstr "ການທົດລອງໃຊ້ຂອງທ່ານຈະເປັນແພັກເກດ 640k, ແຕ່ທ່ານສາມາດເລືອກແພັກເກດອື່ນໄດ້ພາຍຫຼັງ."

msgid "No credit card is needed, but you can set the payment method anytime."
msgstr "ບໍ່ຕ້ອງໃຊ້ບັດເຄຣດິດ, ແຕ່ທ່ານສາມາດຕັ້ງຄ່າວິທີການຊຳລະເງິນໄດ້ທຸກເວລາ."

msgid "All configuration will stay once you start paying."
msgstr "ທຸກການຕັ້ງຄ່າຈະຍັງຄືເກົ່າເມື່ອທ່ານເລີ່ມຊຳລະເງິນ."

msgid "Start the trial!"
msgstr "ເລີ່ມຕົ້ນການທົດລອງໃຊ້!"

msgid "Users"
msgstr "ຜູ້ໃຊ້"

#, python-format
msgid "Joined on %(date)s"
msgstr "ເຂົ້າຮ່ວມເມື່ອ %(date)s"

#, python-format
msgid "Last sign-in on %(date)s"
msgstr "ເຂົ້າສູ່ລະບົບລ່າສຸດເມື່ອ %(date)s"

msgid "Never signed-in"
msgstr "ຍັງບໍ່ເຄີຍເຂົ້າສູ່ລະບົບ"

#, python-format
msgid "Account expires on %(date)s"
msgstr "ບັນຊີຈະໝົດອາຍຸໃນວັນທີ %(date)s"

#, python-format
msgid "%(count)s translation"
msgid_plural "%(count)s translations"
msgstr[0] "%(count)s ຄຳແປ"

#, python-format
msgid "%(count)s suggestion"
msgid_plural "%(count)s suggestions"
msgstr[0] "%(count)s ຄຳແນະນຳ"

#. Translators: e-mail subject
#, python-format
msgid "%(count)s pending suggestion"
msgid_plural "%(count)s pending suggestions"
msgstr[0] "%(count)s ຄຳແນະນຳທີ່ຍັງຄ້າງຢູ່"

#, python-format
msgid "%(count)s screenshot"
msgid_plural "%(count)s screenshots"
msgstr[0] "%(count)s ພາບໜ້າຈໍ"

#, python-format
msgid "%(count)s comment"
msgid_plural "%(count)s comments"
msgstr[0] "%(count)s ຄວາມຄິດເຫັນ"

#. Translators: Name of a tab which lists translations the user has contributed to
msgid "Translates"
msgstr "ລາຍການທີ່ແປ"

msgid "Activity"
msgstr "ການເຄື່ອນໄຫວ"

msgid "Recent changes"
msgstr "ການປ່ຽນແປງເມື່ອໄວໆນີ້"

msgid "User identities"
msgstr "ຕົວຕົນຜູ້ໃຊ້"

msgid "Edit"
msgstr "ແກ້ໄຂ"

msgid "No recent contributions found."
msgstr "ບໍ່ພົບການປະກອບສ່ວນເມື່ອໄວໆນີ້."

msgid "Browse all translations with contribution"
