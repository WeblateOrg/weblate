#. Translators: Permission name
msgid "Edit glossary entry"
msgstr "ແກ້ໄຂລາຍການພົດຈະນານຸກົມ"

#. Translators: Permission name
msgid "Delete glossary entry"
msgstr "ລຶບລາຍການພົດຈະນານຸກົມ"

#. Translators: Permission name
msgid "Upload glossary entries"
msgstr "ອັບໂຫຼດລາຍການພົດຈະນານຸກົມ"

#. Translators: Permission name
msgid "Use automatic suggestions"
msgstr "ໃຊ້ຄຳແນະນຳອັດຕະໂນມັດ"

#. Translators: Permission name
msgid "Edit translation memory"
msgstr "ແກ້ໄຂໜ່ວຍຄວາມຈຳການແປ"

#. Translators: Permission name
msgid "Delete translation memory"
msgstr "ລຶບໜ່ວຍຄວາມຈຳການແປ"

#. Translators: Permission name
msgid "Edit project settings"
msgstr "ແກ້ໄຂການຕັ້ງຄ່າໂຄງການ"

#. Translators: Permission name
msgid "Manage project access"
msgstr "ຈັດການການເຂົ້າເຖິງໂຄງການ"

#. Translators: Permission name
msgid "Download reports"
msgstr "ດາວໂຫຼດລາຍງານ"

#. Translators: Permission name
msgid "Add screenshot"
msgstr "ເພີ່ມພາບຖ່າຍໜ້າຈໍ"

#. Translators: Permission name
msgid "Edit screenshot"
msgstr "ແກ້ໄຂພາບຖ່າຍໜ້າຈໍ"

#. Translators: Permission name
msgid "Delete screenshot"
msgstr "ລຶບພາບຖ່າຍໜ້າຈໍ"

#. Translators: Permission name
msgid "Edit additional string info"
msgstr "ແກ້ໄຂຂໍ້ມູນເພີ່ມເຕີມຂອງຂໍ້ຄວາມ"

#. Translators: Permission name
msgid "Add new string"
msgstr "ເພີ່ມຂໍ້ຄວາມໃໝ່"

#. Translators: Permission name
msgid "Remove a string"
msgstr "ລຶບຂໍ້ຄວາມ"

#. Translators: Permission name
msgid "Dismiss failing check"
msgstr "ຍົກເລີກການກວດສອບທີ່ຜິດພາດ"

