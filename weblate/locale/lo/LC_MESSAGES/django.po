msgctxt "No known user"
msgid "None"
msgstr "ບໍ່ມີ"

msgid "User avatar"
msgstr "ຮູບແທນຕົວຜູ້ໃຊ້"

msgid ""
"This e-mail address is already in use. Please supply a different e-mail "
"address."
msgstr "ທີ່ຢູ່ອີເມວນີ້ມີຜູ້ໃຊ້ແລ້ວ. ກະລຸນາລະບຸທີ່ຢູ່ອີເມວອື່ນ."

msgid "This username is already taken. Please pick something else."
msgstr "ຊື່ຜູ້ໃຊ້ນີ້ມີຜູ້ໃຊ້ແລ້ວ. ກະລຸນາເລືອກຊື່ອື່ນ."

msgid "Full name"
msgstr "ຊື່ເຕັມ"

msgid "Name is also used in version control commits."
msgstr "ຊື່ຍັງຖືກໃຊ້ໃນການຢືນຢັນການປ່ຽນແປງ (commit) ຂອງລະບົບຄວບຄຸມເວີຊັນ."

msgid "Commit e-mail"
msgstr "ອີເມວການຢືນຢັນການປ່ຽນແປງ (Commit)"

msgid "Use account e-mail address"
msgstr "ໃຊ້ທີ່ຢູ່ອີເມວຂອງບັນຊີ"

msgid ""
"Used in version-control commits. The address stays in the repository forever "
"once changes are committed by Weblate."
msgstr ""
"ໃຊ້ໃນການຢືນຢັນການປ່ຽນແປງຂອງລະບົບຄວບຄຸມເວີຊັນ. ທີ່ຢູ່ນີ້ຈະຢູ່ໃນບ່ອນເກັບຂໍ້ມູນ (repository) ຕະຫຼອດໄປ "
"ເມື່ອມີການຢືນຢັນການປ່ຽນແປງໂດຍ Weblate."

msgid "Commit name"
msgstr "ຊື່ການຢືນຢັນການປ່ຽນແປງ (Commit)"

msgid ""
"Used in version control commits. The name stays in the repository forever, "
"once changes are committed by Weblate."
msgstr ""
"ໃຊ້ໃນການຢືນຢັນການປ່ຽນແປງຂອງລະບົບຄວບຄຸມເວີຊັນ. ຊື່ນີ້ຈະຢູ່ໃນບ່ອນເກັບຂໍ້ມູນຕະຫຼອດໄປ "
"ເມື່ອມີການຢືນຢັນການປ່ຽນແປງໂດຍ Weblate."

msgid "Public e-mail"
msgstr "ອີເມວສາທາລະນະ"

msgid "Hide e-mail address from public view"
msgstr "ເຊື່ອງທີ່ຢູ່ອີເມວຈາກການເບິ່ງເຫັນຂອງສາທາລະນະ"

#, python-format
msgid "Component list: %s"
msgstr "ລາຍຊື່ສ່ວນປະກອບ: %s"

msgid "Account e-mail"
msgstr "ອີເມວບັນຊີ"

msgid ""
"Used for e-mail notifications and as a commit e-mail if it is not configured "
"below."
msgstr ""
"ໃຊ້ສຳລັບການແຈ້ງເຕືອນທາງອີເມວ ແລະ ເປັນອີເມວການຢືນຢັນການປ່ຽນແປງ ຖ້າຍັງບໍ່ໄດ້ຕັ້ງຄ່າຢູ່ຂ້າງລຸ່ມນີ້."

msgid "Human verification"
msgstr "ການກວດສອບຄວາມເປັນມະນຸດ"

#, python-format
msgctxt ""
"Question for a mathematics-based CAPTCHA, the %s is an arithmetic problem"
msgid "What is %s?"
msgstr "%s ແມ່ນເທົ່າໃດ?"

#. Translators: Shown on wrong answer to the mathematics-based CAPTCHA
msgid "That was not correct, please try again."
msgstr "ຍັງບໍ່ຖືກຕ້ອງ, ກະລຸນາລອງໃໝ່ອີກຄັ້ງ."

msgid "Validation failed, please try again."
msgstr "ການກວດສອບຂໍ້ມູນຜິດພາດ, ກະລຸນາລອງໃໝ່ອີກຄັ້ງ."

msgid "Subject"
msgstr "ຫົວຂໍ້"

msgid "Your name"
msgstr "ຊື່ຂອງທ່ານ"

msgid "Your e-mail"
msgstr "ອີເມວຂອງທ່ານ"

msgid "Message"
msgstr "ຂໍ້ຄວາມ"

msgid ""
"Please contact us in English. Otherwise, we might not process your request."
msgstr ""
"ກະລຸນາຕິດຕໍ່ພວກເຮົາເປັນພາສາອັງກິດ. ຖ້າບໍ່ດັ່ງນັ້ນ, "
"ພວກເຮົາອາດຈະບໍ່ສາມາດດຳເນີນການຕາມຄຳຮ້ອງຂໍຂອງທ່ານໄດ້."

msgid "E-mail"
msgstr "ອີເມວ"

msgid "An e-mail with a confirmation link will be sent here."
msgstr "ອີເມວພ້ອມກັບລິ້ງຢືນຢັນຈະຖືກສົ່ງໄປທີ່ນີ້."

msgid "New password"
msgstr "ລະຫັດຜ່ານໃໝ່"

msgid "New password confirmation"
msgstr "ຢືນຢັນລະຫັດຜ່ານໃໝ່"

msgid "Regenerate API key"
msgstr "ສ້າງຄີ API ໃໝ່"

msgid ""
"Leave enabled to revoke the current API key and generate a new one. This is "
"recommended if you suspect your password was compromised. Disable it to keep "
"your current API key active after changing your password."
msgstr ""
"ເປີດໄວ້ເພື່ອຍົກເລີກຄີ API ປັດຈຸບັນ ແລະ ສ້າງຄີໃໝ່. "
"ແນະນຳໃຫ້ເຮັດແນວນີ້ຖ້າທ່ານສົງໄສວ່າລະຫັດຜ່ານຂອງທ່ານຖືກບຸກລຸກ. ປິດມັນໄວ້ເພື່ອຮັກສາຄີ API "
"ປັດຈຸບັນໃຫ້ໃຊ້ງານໄດ້ຕໍ່ໄປຫຼັງຈາກປ່ຽນລະຫັດຜ່ານ."

msgid "Your password has been changed."
msgstr "ລະຫັດຜ່ານຂອງທ່ານຖືກປ່ຽນແລ້ວ."

msgid "Current password"
msgstr "ລະຫັດຜ່ານປັດຈຸບັນ"

msgid "Leave empty if you have not set a password yet."
msgstr "ປະວ່າງໄວ້ຖ້າທ່ານຍັງບໍ່ທັນໄດ້ຕັ້ງລະຫັດຜ່ານ."

msgid "You have entered an invalid password."
msgstr "ທ່ານປ້ອນລະຫັດຜ່ານບໍ່ຖືກຕ້ອງ."

msgid "Username or e-mail"
msgstr "ຊື່ຜູ້ໃຊ້ ຫຼື ອີເມວ"

msgid "Password"
msgstr "ລະຫັດຜ່ານ"

msgid "Please enter the correct username and password."
msgstr "ກະລຸນາປ້ອນຊື່ຜູ້ໃຊ້ ແລະ ລະຫັດຜ່ານທີ່ຖືກຕ້ອງ."

msgid "This account is inactive."
msgstr "ບັນຊີນີ້ບໍ່ໄດ້ໃຊ້ງານ."

msgid "Component wide notifications"
msgstr "ການແຈ້ງເຕືອນທົ່ວທັງສ່ວນປະກອບ"

msgid "Translation notifications"
msgstr "ການແຈ້ງເຕືອນການແປ"

msgid "Use default setting"
msgstr "ໃຊ້ການຕັ້ງຄ່າເລີ່ມຕົ້ນ"

msgid "Other projects"
msgstr "ໂຄງການອື່ນໆ"

msgid "Watched projects"
msgstr "ໂຄງການທີ່ຕິດຕາມ"

msgid "Managed projects"
msgstr "ໂຄງການທີ່ຈັດການ"

msgid "Project: {}"
msgstr "ໂຄງການ: {}"

msgid "Component: {}"
msgstr "ສ່ວນປະກອບ: {}"

msgid ""
"You will receive a notification for every such event in non-watched projects."
msgstr "ທ່ານຈະໄດ້ຮັບການແຈ້ງເຕືອນສຳລັບທຸກໆເຫດການດັ່ງກ່າວໃນໂຄງການທີ່ທ່ານບໍ່ໄດ້ຕິດຕາມ."

msgid ""
"You will receive a notification for every such event in your watched "
"projects."
msgstr "ທ່ານຈະໄດ້ຮັບການແຈ້ງເຕືອນສຳລັບທຸກໆເຫດການດັ່ງກ່າວໃນໂຄງການທີ່ທ່ານຕິດຕາມ."

msgid ""
"You will receive a notification for every such event in projects where you "
"have admin permissions."
msgstr "ທ່ານຈະໄດ້ຮັບການແຈ້ງເຕືອນສຳລັບທຸກໆເຫດການດັ່ງກ່າວໃນໂຄງການທີ່ທ່ານມີສິດເປັນຜູ້ດູແລ (admin)."

#, python-format
msgid "You will receive a notification for every such event in %(project)s."
msgstr "ທ່ານຈະໄດ້ຮັບການແຈ້ງເຕືອນສຳລັບທຸກໆເຫດການດັ່ງກ່າວໃນ %(project)s."

#, python-format
msgid "You will receive a notification for every such event in %(component)s."
msgstr "ທ່ານຈະໄດ້ຮັບການແຈ້ງເຕືອນສຳລັບທຸກໆເຫດການດັ່ງກ່າວໃນ %(component)s."

msgid ""
"You will only receive these notifications for your translated languages in "
"non-watched projects."
msgstr "ທ່ານຈະໄດ້ຮັບການແຈ້ງເຕືອນເຫຼົ່ານີ້ສະເພາະພາສາທີ່ທ່ານແປໃນໂຄງການທີ່ທ່ານບໍ່ໄດ້ຕິດຕາມ."

msgid ""
"You will only receive these notifications for your translated languages in "
"your watched projects."
msgstr "ທ່ານຈະໄດ້ຮັບການແຈ້ງເຕືອນເຫຼົ່ານີ້ສະເພາະພາສາທີ່ທ່ານແປໃນໂຄງການທີ່ທ່ານຕິດຕາມ."

msgid ""
"You will only receive these notifications for your translated languages in "
"projects where you have admin permissions."
msgstr "ທ່ານຈະໄດ້ຮັບການແຈ້ງເຕືອນເຫຼົ່ານີ້ສະເພາະພາສາທີ່ທ່ານແປໃນໂຄງການທີ່ທ່ານມີສິດເປັນຜູ້ດູແລ."

#, python-format
msgid ""
"You will only receive these notifications for your translated languages in "
"%(project)s."
msgstr "ທ່ານຈະໄດ້ຮັບການແຈ້ງເຕືອນເຫຼົ່ານີ້ສະເພາະພາສາທີ່ທ່ານແປໃນ %(project)s."

#, python-format
msgid ""
"You will only receive these notifications for your translated languages in "
"%(component)s."
msgstr "ທ່ານຈະໄດ້ຮັບການແຈ້ງເຕືອນເຫຼົ່ານີ້ສະເພາະພາສາທີ່ທ່ານແປໃນ %(component)s."

msgid "Username"
msgstr "ຊື່ຜູ້ໃຊ້"

msgid "Date joined"
msgstr "ວັນທີເຂົ້າຮ່ວມ"

msgid "Translations made"
msgstr "ການແປທີ່ເຮັດແລ້ວ"

msgid "Suggestions made"
msgstr "ຄຳແນະນຳທີ່ສະເໜີ"

msgid "Comments made"
msgstr "ຄວາມຄິດເຫັນທີ່ຂຽນ"

msgid "Screenshots uploaded"
msgstr "ຮູບໜ້າຈໍທີ່ອັບໂຫຼດ"

msgid "The chosen sorting is not supported."
msgstr "ບໍ່ຮອງຮັບການຈັດລຽງທີ່ເລືອກ."

msgid "Team"
msgstr "ທີມ"

msgid "Add to a team"
msgstr "ເພີ່ມເຂົ້າໃນທີມ"

msgid "Name your authentication app"
msgstr "ຕັ້ງຊື່ແອັບຢືນຢັນຕົວຕົນຂອງທ່ານ"

msgid "Verify the code from the app"
msgstr "ກວດສອບລະຫັດຈາກແອັບ"

msgid "Discard previously configured authentication apps"
msgstr "ຍົກເລີກແອັບຢືນຢັນຕົວຕົນທີ່ເຄີຍຕັ້ງຄ່າໄວ້ກ່ອນໜ້ານີ້"

msgid ""
"All previously configured authentication apps will be discarded upon "
"verification of the new app."
msgstr "ແອັບຢືນຢັນຕົວຕົນທັງໝົດທີ່ເຄີຍຕັ້ງຄ່າໄວ້ຈະຖືກຍົກເລີກ ເມື່ອມີການກວດສອບແອັບໃໝ່ສຳເລັດ."

msgid ""
"Other two-factor methods (such as WebAuthn and security keys) won't be "
"affected."
msgstr "ວິທີການຢືນຢັນຕົວຕົນສອງຊັ້ນອື່ນໆ (ເຊັ່ນ WebAuthn ແລະ ຄີຄວາມປອດໄພ) ຈະບໍ່ໄດ້ຮັບຜົນກະທົບ."

msgid "The entered token is not valid."
msgstr "ໂທເຄັນ (token) ທີ່ປ້ອນເຂົ້າບໍ່ຖືກຕ້ອງ."

msgid "Recovery token"
msgstr "ໂທເຄັນກູ້ຄືນ"

msgid ""
"Recovery codes can only be used once. Remember to mark used ones as expired."
msgstr "ລະຫັດກູ້ຄືນສາມາດໃຊ້ໄດ້ພຽງຄັ້ງດຽວ. ຢ່າລືມໝາຍອັນທີ່ໃຊ້ແລ້ວວ່າໝົດອາຍຸ."

msgid "Enter the code from the app"
msgstr "ປ້ອນລະຫັດຈາກແອັບ"

#. Translators: Audit log entry
msgid "Password changed."
msgstr "ປ່ຽນລະຫັດຜ່ານແລ້ວ."

#. Translators: Audit log entry
#, python-brace-format
msgid "Rate limit exceeded for {scope} at {path}."
msgstr "ກາຍຂີດຈຳກັດອັດຕາສຳລັບ {scope} ຢູ່ {path}."

#. Translators: Audit log entry
#, python-brace-format
msgid "Username changed from {old} to {new}."
msgstr "ຊື່ຜູ້ໃຊ້ປ່ຽນຈາກ {old} ເປັນ {new}."

#. Translators: Audit log entry
#, python-brace-format
msgid "E-mail changed from {old} to {new}."
msgstr "ອີເມວປ່ຽນຈາກ {old} ເປັນ {new}."

#. Translators: Audit log entry
#, python-brace-format
msgid "Full name changed from {old} to {new}."
