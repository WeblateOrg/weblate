msgid "Provider ID"
msgstr "Provider ID"

msgid "Repositories"
msgstr "ຄັງເກັບຂໍ້ມູນ"

msgid "Disabled"
msgstr "ປິດໃຊ້ງານ"

msgid "Refresh"
msgstr "ຣີເຟຣຊ"

msgid "No connected accounts yet."
msgstr "ຍັງບໍ່ມີບັນຊີທີ່ເຊື່ອມຕໍ່."

msgid "Register Weblate GitHub App"
msgstr "ລົງທະບຽນ Weblate GitHub App"

msgid ""
"Submit the form below to create a GitHub App with all the permissions and "
"events Weblate needs already filled in. After you confirm the App's name on "
"GitHub, you will be redirected back here and the credentials will be stored "
"automatically."
msgstr ""
"ສົ່ງຟອມລຸ່ມນີ້ເພື່ອສ້າງ GitHub App ພ້ອມສິດທິ ແລະ ເຫດການທີ່ Weblate ຕ້ອງການ. ຫຼັງຈາກຢືນຢັນຊື່ແອັບໃນ "
"GitHub ແລ້ວ, ທ່ານຈະຖືກສົ່ງກັບມາທີ່ນີ້ ແລະ ຂໍ້ມູນຈະຖືກບັນທຶກອັດຕະໂນມັດ."

#, python-format
msgid ""
"The <code>%(host)s</code> host already has stored GitHub App credentials. "
"You can edit the form, but submitting this host again will be rejected."
msgstr ""
"ໂຮສ <code>%(host)s</code> ມີຂໍ້ມູນ GitHub App ຢູ່ແລ້ວ. ທ່ານສາມາດແກ້ໄຂຟອມໄດ້, "
"ແຕ່ການສົ່ງໂຮສນີ້ຊ້ຳອີກຄັ້ງຈະຖືກປະຕິເສດ."

msgid "GitHub hosts that already have a Weblate GitHub App registered:"
msgstr "GitHub ໂຮສທີ່ມີ Weblate GitHub App ລົງທະບຽນແລ້ວ:"

msgid "Subscribed events"
msgstr "ເຫດການທີ່ຕິດຕາມ (subscribed events)"

msgid "Continue to GitHub"
msgstr "ສືບຕໍ່ໄປຍັງ GitHub"

msgid "Cancel"
msgstr "ຍົກເລີກ"

msgid "Manifest preview"
msgstr "ຕົວຢ່າງ Manifest"

msgid ""
"The JSON document below is the manifest that GitHub will use to pre-fill the "
"new App's settings."
msgstr "ເອກະສານ JSON ລຸ່ມນີ້ແມ່ນ manifest ທີ່ GitHub ຈະໃຊ້ເພື່ອປ້ອນຄ່າເລີ່ມຕົ້ນຂອງແອັບໃໝ່."

#, python-format
msgid "Sending you to %(host)s"
msgstr "ກຳລັງພາທ່ານໄປຍັງ %(host)s"

#, python-format
msgid ""
"Click the button below to send the pre-filled GitHub App manifest to "
"%(host)s. You will be redirected back here once GitHub confirms."
msgstr ""
"ຄລິກປຸ່ມລຸ່ມນີ້ເພື່ອສົ່ງ manifest ຂອງ GitHub App ໄປຍັງ %(host)s. ທ່ານຈະຖືກສົ່ງກັບມາທີ່ນີ້ເມື່ອ "
"GitHub ຢືນຢັນແລ້ວ."

msgid "GitHub host"
msgstr "GitHub host"

msgid "Organization"
msgstr "ອົງກອນ"

msgid "App name"
msgstr "ຊື່ແອັບ"

#, python-format
msgid "Continue to %(host)s"
msgstr "ສືບຕໍ່ໄປຍັງ %(host)s"

msgid ""
"GitHub only shows accounts where your GitHub user can install or request "
"this app. If an organization is missing, check your organization role and "
"GitHub App installation restrictions in GitHub."
msgstr ""
"GitHub ຈະສະແດງສະເພາະບັນຊີທີ່ທ່ານສາມາດຕິດຕັ້ງ ຫຼື ຮ້ອງຂໍແອັບນີ້ໄດ້. ຖ້າບໍ່ເຫັນອົງກອນ, "
"ໃຫ້ກວດສອບບົດບາດຂອງທ່ານໃນອົງກອນ ແລະ ຂໍ້ຈຳກັດການຕິດຕັ້ງແອັບໃນ GitHub."

msgid "Choose GitHub host"
msgstr "ເລືອກ GitHub host"

msgid ""
"Select the GitHub or GitHub Enterprise instance where you want to connect "
"the Weblate GitHub App."
msgstr "ເລືອກ GitHub ຫຼື GitHub Enterprise ທີ່ທ່ານຕ້ອງການເຊື່ອມຕໍ່ Weblate GitHub App."

#, python-format
msgid "Install on %(hostname)s"
msgstr "ຕິດຕັ້ງໃນ %(hostname)s"

#, python-format
msgid "Connected GitHub account: %(login)s"
msgstr "ບັນຊີ GitHub ທີ່ເຊື່ອມຕໍ່: %(login)s"

msgid "Refresh repositories"
msgstr "ຣີເຟຣຊຄັງເກັບຂໍ້ມູນ"

#, python-format
msgid ""
"Weblate GitHub app credentials are not registered for %(hostname)s. Token "
"refresh and webhook signature checks will not work until the App credentials "
"are registered again."
msgstr ""
"ຂໍ້ມູນຂອງ Weblate GitHub app ຍັງບໍ່ໄດ້ລົງທະບຽນສຳລັບ %(hostname)s. ການຣີເຟຣຊໂທເຄັນ ແລະ "
"ການກວດສອບລາຍເຊັນ webhook ຈະບໍ່ເຮັດວຽກ ຈົນກວ່າຈະມີການລົງທະບຽນໃໝ່."

msgid "GitHub installation ID"
msgstr "GitHub installation ID"

msgid "Repositories updated"
msgstr "ອັບເດດຄັງເກັບຂໍ້ມູນແລ້ວ"

msgid "Available Repositories"
msgstr "ຄັງເກັບຂໍ້ມູນທີ່ມີໃຫ້ໃຊ້"

msgid "Unavailable"
msgstr "ບໍ່ສາມາດໃຊ້ໄດ້"

msgid ""
"No repositories found. Click 'Refresh repositories' to fetch the list from "
"GitHub."
msgstr "ບໍ່ພົບຄັງເກັບຂໍ້ມູນ. ຄລິກ 'ຣີເຟຣຊຄັງເກັບຂໍ້ມູນ' ເພື່ອດຶງລາຍການຈາກ GitHub."

msgid "Weblate GitHub Apps"
msgstr "ແອັບ Weblate GitHub"

msgid ""
"No code-hosting app is registered yet. Use the button above to create one "
"with the right permissions and webhook URL already filled in — Weblate will "
"store the credentials automatically once GitHub redirects back."
msgstr ""
"ຍັງບໍ່ມີແອັບຝາກໂຄ້ດລົງທະບຽນ. ໃຊ້ປຸ່ມດ້ານເທິງເພື່ອສ້າງແອັບທີ່ມີສິດທິ ແລະ URL ຂອງ webhook ທີ່ຖືກຕ້ອງ — "
"Weblate ຈະບັນທຶກຂໍ້ມູນໃຫ້ອັດຕະໂນມັດ."

msgid ""
"The apps below provide credentials Weblate uses to talk to code hosting "
"providers. Connect an account to each app to import repositories from that "
"account."
msgstr ""
"ແອັບລຸ່ມນີ້ໃຫ້ຂໍ້ມູນທີ່ Weblate ໃຊ້ສື່ສານກັບຜູ້ໃຫ້ບໍລິການຝາກໂຄ້ດ. "
"ໃຫ້ເຊື່ອມຕໍ່ບັນຊີກັບແຕ່ລະແອັບເພື່ອຮຽກຂໍ້ມູນຄັງເກັບຂໍ້ມູນຈາກບັນຊີນັ້ນ."

msgid "Remove app"
msgstr "ລຶບແອັບອອກ"

msgid "Remove connected accounts first."
msgstr "ໃຫ້ລຶບບັນຊີທີ່ເຊື່ອມຕໍ່ອອກກ່ອນ."

msgid "App ID"
msgstr "ໄອດີແອັບ"

msgid "Slug"
msgstr "Slug"

msgid "Remove Weblate GitHub App?"
msgstr "ລຶບ Weblate GitHub App ອອກບໍ່?"

#, python-format
msgid ""
"This deletes the stored credentials for the <code>%(slug)s</code> App on "
"<code>%(host)s</code>."
msgstr "ນີ້ຈະລຶບຂໍ້ມູນທີ່ບັນທຶກໄວ້ສຳລັບແອັບ <code>%(slug)s</code> ໃນ <code>%(host)s</code>."

msgid ""
"The App itself stays installed on GitHub. Delete it from GitHub separately "
"if you no longer need it."
msgstr "ແອັບຈະຍັງຄົງຕິດຕັ້ງຢູ່ໃນ GitHub. ໃຫ້ໄປລຶບອອກຈາກ GitHub ຕ່າງຫາກຖ້າບໍ່ຕ້ອງການໃຊ້ອີກແລ້ວ."

msgid ""
"No connected accounts yet. Use the button above to connect an organization "
"or user account."
msgstr "ຍັງບໍ່ມີບັນຊີທີ່ເຊື່ອມຕໍ່. ໃຊ້ປຸ່ມດ້ານເທິງເພື່ອເຊື່ອມຕໍ່ອົງກອນ ຫຼື ບັນຊີຜູ້ໃຊ້."

msgid "From connected account"
msgstr "ຈາກບັນຊີທີ່ເຊື່ອມຕໍ່"

msgid "Import from connected account"
msgstr "ນຳເຂົ້າຈາກບັນຊີທີ່ເຊື່ອມຕໍ່"

msgid ""
"Select a repository to import. This will pre-fill the component creation "
"form with the repository URL and branch."
msgstr ""
"ເລືອກຄັງເກັບຂໍ້ມູນທີ່ຈະນຳເຂົ້າ. ຂໍ້ມູນ URL ແລະ ສາຂາຈະຖືກປ້ອນໃນຟອມສ້າງສ່ວນປະກອບໃຫ້ອັດຕະໂນມັດ."

msgid "No repositories available from connected accounts."
msgstr "ບໍ່ມີຄັງເກັບຂໍ້ມູນຈາກບັນຊີທີ່ເຊື່ອມຕໍ່."

msgid ""
"Install the Weblate GitHub app to connect an organization or user account."
msgstr "ຕິດຕັ້ງແອັບ Weblate GitHub ເພື່ອເຊື່ອມຕໍ່ອົງກອນ ຫຼື ບັນຊີຜູ້ໃຊ້."

msgid ""
"Select a project with a workspace before connecting an account. Code-hosting "
"accounts are connected to workspaces."
msgstr "ເລືອກໂຄງການທີ່ມີພື້ນທີ່ເຮັດວຽກກ່ອນຈະເຊື່ອມຕໍ່ບັນຊີ. ບັນຊີຝາກໂຄ້ດຈະຖືກເຊື່ອມຕໍ່ກັບພື້ນທີ່ເຮັດວຽກ."

msgid "Weblate GitHub app is not registered on this Weblate instance."
msgstr "Weblate GitHub app ຍັງບໍ່ໄດ້ລົງທະບຽນໃນ Weblate ນີ້."

msgid "Try refreshing the repository list."
msgstr "ລອງຣີເຟຣຊລາຍການຄັງເກັບຂໍ້ມູນ."

msgid "Remove connected account?"
msgstr "ລຶບບັນຊີທີ່ເຊື່ອມຕໍ່ອອກບໍ່?"

#, python-format
msgid "This removes the connected account <code>%(login)s</code> from Weblate."
msgstr "ນີ້ຈະລຶບບັນຊີທີ່ເຊື່ອມຕໍ່ <code>%(login)s</code> ອອກຈາກ Weblate."

msgid ""
"The Weblate GitHub app stays installed on GitHub. Remove it on GitHub "
"separately if you no longer need it."
msgstr ""
"Weblate GitHub app ຈະຍັງຄົງຕິດຕັ້ງຢູ່ໃນ GitHub. ໃຫ້ໄປລຶບອອກຈາກ GitHub "
"ຕ່າງຫາກຖ້າບໍ່ຕ້ອງການໃຊ້ອີກແລ້ວ."

msgid "Invitations"
msgstr "ຄຳເຊີນ"

msgid "Invitation"
msgstr "ຄຳເຊີນ"

msgid "Invitation to Weblate"
msgstr "ຄຳເຊີນເຂົ້າສູ່ Weblate"

msgid "Please sign-in to view this invitation."
msgstr "ກະລຸນາເຂົ້າສູ່ລະບົບເພື່ອເບິ່ງຄຳເຊີນນີ້."

msgid "This invitation belongs to a different user."
msgstr "ຄຳເຊີນນີ້ເປັນຂອງຜູ້ໃຊ້ອື່ນ."

#, python-format
msgid "Invitation to %(project_name)s"
msgstr "ຄຳເຊີນເຂົ້າຮ່ວມ %(project_name)s"

