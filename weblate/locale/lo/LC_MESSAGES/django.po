msgctxt "Automatic suggestion service configuration"
msgid "Source language selection"
msgstr "ການເລືອກພາສາຕົ້ນທາງ"

msgid ""
"Project-level machine translation cannot use internal or non-public "
"addresses."
msgstr "ການແປດ້ວຍຈັກໃນລະດັບໂຄງການບໍ່ສາມາດໃຊ້ທີ່ຢູ່ພາຍໃນ ຫຼື ທີ່ຢູ່ທີ່ບໍ່ແມ່ນສາທາລະນະ."

msgid ""
"Project-level machine translation cannot use internal or non-public "
"addresses. Contact the site administrator if this service should be "
"configured site-wide or allowlisted."
msgstr ""
"ການແປດ້ວຍຈັກໃນລະດັບໂຄງການບໍ່ສາມາດໃຊ້ທີ່ຢູ່ພາຍໃນ ຫຼື ທີ່ຢູ່ທີ່ບໍ່ແມ່ນສາທາລະນະ. "
"ຕິດຕໍ່ຜູ້ດູແລລະບົບຖ້າບໍລິການນີ້ຄວນຖືກຕັ້ງຄ່າທົ່ວເວັບໄຊ ຫຼື ຢູ່ໃນລາຍການທີ່ອະນຸຍາດ."

msgctxt "Automatic suggestion service configuration"
msgid "API key"
msgstr "ລະຫັດ API"

msgctxt "Automatic suggestion service configuration"
msgid "API URL"
msgstr "URL ຂອງ API"

msgctxt "Automatic suggestion service configuration"
msgid "Client ID"
msgstr "ID ຂອງລູກຄ້າ"

msgctxt "Automatic suggestion service configuration"
msgid "Client secret"
msgstr "ລະຫັດລັບຂອງລູກຄ້າ"

msgctxt "Automatic suggestion service configuration"
msgid "Contact e-mail"
msgstr "ອີເມລຕິດຕໍ່"

msgctxt "Automatic suggestion service configuration"
msgid "Username"
msgstr "ຊື່ຜູ້ໃຊ້"

msgctxt "Automatic suggestion service configuration"
msgid "SAP username"
msgstr "ຊື່ຜູ້ໃຊ້ SAP"

msgctxt "Automatic suggestion service configuration"
msgid "SAP password"
msgstr "ລະຫັດຜ່ານ SAP"

msgctxt "Automatic suggestion service configuration"
msgid "Enable machine translation"
msgstr "ເປີດໃຊ້ການແປດ້ວຍຈັກ"

msgctxt "Automatic suggestion service configuration"
msgid "Translation domain"
msgstr "ໂດເມນການແປ"

msgid ""
"The ID of a translation domain, for example, BC. If you do not specify a "
"domain, the method searches for translations in all available domains."
msgstr ""
"ID ຂອງໂດເມນການແປ, ຕົວຢ່າງ: BC. ຖ້າທ່ານບໍ່ລະບຸໂດເມນ, ລະບົບຈະຄົ້ນຫາການແປໃນທຸກໂດເມນທີ່ມີຢູ່."

msgid "Please provide either key or username and password."
msgstr "ກະລຸນາລະບຸລະຫັດ (Key) ຫຼື ຊື່ຜູ້ໃຊ້ ແລະ ລະຫັດຜ່ານ."

msgctxt "Automatic suggestion service configuration"
msgid "Application base URL"
msgstr "URL ພື້ນຖານຂອງແອັບພລິເຄຊັນ"

msgctxt "Automatic suggestion service configuration"
msgid "Authentication service URL"
msgstr "URL ຂອງບໍລິການຢືນຢັນຕົວຕົນ"

msgid "Regional or multi-service can be specified using region field below."
msgstr "ສາມາດລະບຸພາກພື້ນ ຫຼື ຫຼາຍບໍລິການໄດ້ໂດຍໃຊ້ຊ່ອງພາກພື້ນຂ້າງລຸ່ມ."

msgctxt "Automatic suggestion service configuration"
msgid "Authentication service region"
msgstr "ພາກພື້ນຂອງບໍລິການຢືນຢັນຕົວຕົນ"

msgctxt "Automatic suggestion service configuration"
msgid "Category"
msgstr "ໝວດໝູ່"

msgctxt "Automatic suggestion service configuration"
msgid ""
"Specify a customized system category ID to use it instead of general one."
msgstr "ລະບຸ ID ໝວດໝູ່ລະບົບທີ່ກຳນົດເອງເພື່ອໃຊ້ແທນໝວດໝູ່ທົ່ວໄປ."

msgid "Enter a valid Azure region name."
msgstr "ກະລຸນາໃສ່ຊື່ພາກພື້ນ Azure ທີ່ຖືກຕ້ອງ."

msgctxt "Automatic suggestion service configuration"
msgid "Google Translate service account info"
msgstr "ຂໍ້ມູນບັນຊີບໍລິການ Google Translate"

msgctxt "Google Cloud Translation configuration"
msgid "Enter a JSON key for the service account."
msgstr "ໃສ່ລະຫັດ JSON ສຳລັບບັນຊີບໍລິການ."

msgctxt "Automatic suggestion service configuration"
msgid "Google Translate project"
msgstr "ໂຄງການ Google Translate"

msgctxt "Google Cloud Translation configuration"
msgid "Enter the numeric or alphanumeric ID of your Google Cloud project."
msgstr "ໃສ່ ID ຕົວເລກ ຫຼື ຕົວອັກສອນຂອງໂຄງການ Google Cloud ຂອງທ່ານ."

msgctxt "Automatic suggestion service configuration"
msgid "Google Translate location"
msgstr "ສະຖານທີ່ Google Translate"

msgctxt "Google Cloud Translation configuration"
msgid ""
"Choose a Google Cloud Translation region that is used for the Google Cloud "
"project or is closest to you."
msgstr "ເລືອກພາກພື້ນ Google Cloud Translation ທີ່ໃຊ້ສຳລັບໂຄງການ ຫຼື ຢູ່ໃກ້ທ່ານທີ່ສຸດ."

msgctxt "Google Cloud region"
msgid "Global"
msgstr "ທົ່ວໂລກ"

msgctxt "Google Cloud region"
msgid "Europe"
msgstr "ເອີຣົບ"

msgctxt "Google Cloud region"
msgid "US"
msgstr "ສະຫະລັດ"

msgctxt "Automatic suggestion service configuration"
msgid "Google Storage Bucket name"
msgstr "ຊື່ Google Storage Bucket"

msgctxt "Google Cloud Translation configuration"
msgid ""
"Enter the name of the Google Cloud Storage bucket that is used to store the "
"Glossary files."
msgstr "ໃສ່ຊື່ຂອງ Google Cloud Storage bucket ທີ່ໃຊ້ເພື່ອເກັບຮັກສາໄຟລ໌ຄຳສັບສະເພາະ."

#, python-format
msgid "Could not parse JSON: %s"
msgstr "ບໍ່ສາມາດແປງ (Parse) JSON: %s"

msgctxt "AWS Translate configuration"
msgid "Access key ID"
msgstr "ໄອດີຄີການເຂົ້າເຖິງ"

msgctxt "AWS Translate configuration"
msgid "API secret key"
msgstr "ລະຫັດລັບ API"

msgctxt "AWS Translate configuration"
msgid "Region name"
msgstr "ຊື່ພາກພື້ນ"

msgctxt "AWS Translate configuration"
msgid "Formality"
msgstr "ລະດັບຄວາມເປັນທາງການ"

msgctxt "AWS Translate configuration"
msgid "Default"
msgstr "ເລີ່ມຕົ້ນ"

msgctxt "AWS Translate configuration"
msgid "Formal"
msgstr "ເປັນທາງການ"

msgctxt "AWS Translate configuration"
msgid "Informal"
msgstr "ບໍ່ເປັນທາງການ"

msgctxt "AWS Translate configuration"
msgid "Brevity"
msgstr "ຄວາມກະທັດຮັດ"

msgid "Prefer shorter translations when supported."
msgstr "ບຸລິມະສິດການແປທີ່ສັ້ນກວ່າເມື່ອຮອງຮັບ."

msgctxt "AWS Translate configuration"
msgid "Enabled"
msgstr "ເປີດໃຊ້ງານ"

msgctxt "AWS Translate configuration"
msgid "Profanity"
msgstr "ຄຳຫຍາບຄາຍ"

msgid "Mask profane words in translated text."
msgstr "ປິດບັງຄຳຫຍາບຄາຍໃນຂໍ້ຄວາມທີ່ແປ."

msgctxt "AWS Translate configuration"
msgid "Mask profanity"
msgstr "ປິດບັງຄຳຫຍາບຄາຍ"

msgctxt "Alibaba Translate configuration"
msgid "Access key ID"
msgstr "ໄອດີຄີການເຂົ້າເຖິງ"

msgctxt "Alibaba Translate configuration"
msgid "Access key secret"
msgstr "ລະຫັດລັບຄີການເຂົ້າເຖິງ"

msgctxt "Alibaba Translate configuration"
msgid "Region ID"
msgstr "Region ID"

msgctxt "Automatic suggestion service configuration"
msgid "Context vector"
msgstr "Context vector"

msgid "Comma-separated list of memory IDs:weight. e.g: 1234:0.123,4567:0.456"
msgstr "ລາຍການ ID ຄວາມຈຳ:ນ້ຳໜັກ ທີ່ຂັ້ນດ້ວຍຈຸດ. ຕົວຢ່າງ: 1234:0.123,4567:0.456"

#, python-format
msgid "The context vector is not valid: %s"
msgstr "Context vector ບໍ່ຖືກຕ້ອງ: %s"

#, python-format
msgid "The weight value must be between 0 and 1: %s"
msgstr "ຄ່ານ້ຳໜັກຕ້ອງຢູ່ລະຫວ່າງ 0 ຫາ 1: %s"

msgctxt "Automatic suggestion service configuration"
msgid "Formality"
msgstr "ລະດັບຄວາມເປັນທາງການ"

msgid "Uses the specified formality if language is not specified as (in)formal"
msgstr "ໃຊ້ລະດັບຄວາມເປັນທາງການທີ່ລະບຸ ຖ້າພາສານັ້ນບໍ່ໄດ້ຖືກກຳນົດວ່າເປັນແບບທາງການ ຫຼື ບໍ່ເປັນທາງການ"

msgctxt "Automatic suggestion service configuration"
msgid "Translation context"
msgstr "ບໍລິບົດຂອງການແປ"

msgid ""
"Describe the context of the translation to improve the accuracy of the "
"translation."
msgstr "ອະທິບາຍບໍລິບົດຂອງການແປເພື່ອປັບປຸງຄວາມຖືກຕ້ອງຂອງການແປ."

msgctxt "Automatic suggestion service configuration"
msgid "Use next-gen model"
msgstr "ໃຊ້ໂມເດນລຸ້ນໃໝ່ (Next-gen)"

msgid "Prefer next-gen LLM over classic machine translation model."
msgstr "ເລືອກໃຊ້ LLM ລຸ້ນໃໝ່ແທນໂມເດນການແປດ້ວຍຈັກແບບດັ້ງເດີມ."

msgid "DeepL API v1 is no longer supported."
msgstr "ບໍ່ຮອງຮັບ DeepL API v1 ອີກຕໍ່ໄປ."

msgctxt "Automatic suggestion service configuration"
msgid "LLM model"
msgstr "ໂມເດນ LLM"

msgctxt "Automatic suggestion service configuration"
msgid "Translator persona"
msgstr "ບຸກຄະລິກຂອງຜູ້ແປ"

msgid ""
"Describe the persona of translator to improve the accuracy of the "
"translation. For example: “You are a squirrel breeder.”"
msgstr "ອະທິບາຍບຸກຄະລິກຂອງຜູ້ແປເພື່ອປັບປຸງຄວາມຖືກຕ້ອງຂອງການແປ. ຕົວຢ່າງ: “ເຈົ້າເປັນຜູ້ລ້ຽງກະຮອກ.”"

msgctxt "Automatic suggestion service configuration"
msgid "Translator style"
msgstr "ຮູບແບບການແປ"

msgid ""
"Describe the style of translation. For example: “Use informal language.”"
msgstr "ອະທິບາຍຮູບແບບຂອງການແປ. ຕົວຢ່າງ: “ໃຊ້ພາສາທີ່ບໍ່ເປັນທາງການ.”"

msgctxt "Automatic suggestion service configuration"
msgid "Language-specific instructions"
msgstr "ຄຳແນະນຳສະເພາະພາສາ"

#, python-format
msgid ""
"JSON object mapping existing target language codes to extra instructions, up "
"to %(limit)d characters each."
msgstr ""
"JSON object ທີ່ຈັບຄູ່ລະຫັດພາສາເປົ້າໝາຍກັບຄຳແນະນຳເພີ່ມເຕີມ, ບໍ່ເກີນ %(limit)d ຕົວອັກສອນຕໍ່ອັນ."

msgid "Language-specific instructions must be a JSON object."
msgstr "ຄຳແນະນຳສະເພາະພາສາຕ້ອງເປັນ JSON object."

#, python-format
msgid "Language-specific instructions contain invalid language code \"%s\"."
msgstr "ຄຳແນະນຳສະເພາະພາສາມີລະຫັດພາສາທີ່ບໍ່ຖືກຕ້ອງ \"%s\"."

#, python-format
msgid "Language-specific instructions contain unknown language code \"%s\"."
msgstr "ຄຳແນະນຳສະເພາະພາສາມີລະຫັດພາສາທີ່ບໍ່ຮູ້ຈັກ \"%s\"."

#, python-format
msgid ""
"Language-specific instructions for \"%(language)s\" must be at most "
"%(limit)d characters."
msgstr "ຄຳແນະນຳສະເພາະພາສາສຳລັບ \"%(language)s\" ຕ້ອງບໍ່ເກີນ %(limit)d ຕົວອັກສອນ."

msgctxt "OpenAI model selection"
msgid "Automatic selection"
msgstr "ເລືອກອັດຕະໂນມັດ"

msgctxt "OpenAI model selection"
msgid "Custom model"
msgstr "ໂມເດນກຳນົດເອງ"

msgctxt "Automatic suggestion service configuration"
msgid "OpenAI API base URL"
msgstr "URL ພື້ນຖານຂອງ OpenAI API"

msgid "Base URL of the OpenAI API, if it differs from the OpenAI default URL"
msgstr "URL ພື້ນຖານຂອງ OpenAI API, ຖ້າມັນແຕກຕ່າງຈາກ URL ເລີ່ມຕົ້ນຂອງ OpenAI"

msgctxt "Automatic suggestion service configuration"
msgid "OpenAI model"
msgstr "ໂມເດນ OpenAI"

msgctxt "OpenAI model selection"
msgid "Custom model name"
msgstr "ຊື່ໂມເດນກຳນົດເອງ"

msgid "Only needed when model is set to 'Custom model'"
msgstr "ຈຳເປັນເມື່ອຕັ້ງຄ່າໂມເດນເປັນ 'ໂມເດນກຳນົດເອງ' ເທົ່ານັ້ນ"

msgid "Missing custom model name."
msgstr "ຂາດຊື່ໂມເດນກຳນົດເອງ."

msgid "Choose custom model here to enable it."
msgstr "ເລືອກໂມເດນກຳນົດເອງທີ່ນີ້ເພື່ອເປີດໃຊ້ງານ."

msgctxt "Mistral model selection"
msgid "Automatic selection"
msgstr "ເລືອກອັດຕະໂນມັດ"

msgctxt "Mistral model selection"
msgid "Custom model"
msgstr "ໂມເດນກຳນົດເອງ"

msgctxt "Automatic suggestion service configuration"
msgid "Mistral API base URL"
msgstr "URL ພື້ນຖານຂອງ Mistral API"

msgid "Base URL of the Mistral API, if it differs from the Mistral default URL"
msgstr "URL ພື້ນຖານຂອງ Mistral API, ຖ້າມັນແຕກຕ່າງຈາກ URL ເລີ່ມຕົ້ນຂອງ Mistral"

msgctxt "Automatic suggestion service configuration"
msgid "Mistral model"
msgstr "ໂມເດນ Mistral"

msgctxt "Mistral model selection"
msgid "Custom model name"
msgstr "ຊື່ໂມເດນກຳນົດເອງ"

msgctxt "Automatic suggestion service configuration"
msgid "Azure OpenAI endpoint URL"
msgstr "URL ຂອງ Azure OpenAI endpoint"

msgid ""
"Endpoint URL of the instance, e.g: https://my-instance.openai.azure.com."
msgstr "URL Endpoint ຂອງອິນສະແຕນຊ໌, ຕົວຢ່າງ: https://my-instance.openai.azure.com."

msgctxt "Automatic suggestion service configuration"
msgid "Azure OpenAI deployment"
msgstr "ການໃຊ້ງານ (Deployment) Azure OpenAI"

msgid "The model's unique deployment name."
msgstr "ຊື່ການໃຊ້ງານທີ່ເປັນເອກະລັກຂອງໂມເດນ."

msgid "Base URL of the Ollama API, localhost and port 11434 by default."
msgstr "URL ພື້ນຖານຂອງ Ollama API, ເລີ່ມຕົ້ນແມ່ນ localhost ແລະ ພອດ 11434."

msgctxt "Automatic suggestion service configuration"
msgid "Ollama model"
msgstr "ໂມເດນ Ollama"

msgid "Name of the model described in Ollama catalogue."
msgstr "ຊື່ຂອງໂມເດນທີ່ມີຢູ່ໃນລາຍການຂອງ Ollama."

msgctxt "Anthropic model selection"
msgid "Claude Haiku 4.5"
msgstr "Claude Haiku 4.5"

msgctxt "Anthropic model selection"
msgid "Claude Sonnet 5"
msgstr "Claude Sonnet 5"

msgctxt "Anthropic model selection"
msgid "Claude Opus 4.8"
msgstr "Claude Opus 4.8"

msgctxt "Anthropic model selection"
msgid "Claude Fable 5"
msgstr "Claude Fable 5"

msgctxt "Anthropic model selection"
msgid "Custom model"
msgstr "ໂມເດນກຳນົດເອງ"

msgctxt "Automatic suggestion service configuration"
msgid "Anthropic API URL"
msgstr "URL ຂອງ Anthropic API"

msgid "Base URL of the Anthropic API. Leave empty to use the default URL."
msgstr "URL ພື້ນຖານຂອງ Anthropic API. ປ່ອຍຫວ່າງໄວ້ເພື່ອໃຊ້ URL ເລີ່ມຕົ້ນ."

msgctxt "Automatic suggestion service configuration"
msgid "Anthropic model"
msgstr "ໂມເດນ Anthropic"

