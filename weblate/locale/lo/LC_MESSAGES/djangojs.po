msgid ""
"A pull or merge request will be created from a branch in the repository."
msgstr "ການຮ້ອງຂໍ Pull ຫຼື Merge ຈະຖືກສ້າງຂຶ້ນຈາກສາຂາ (Branch) ໃນ Repository."

msgid ""
"A push URL is set but no push branch is given. Set a push branch that "
"differs from the translated branch."
msgstr ""
"ມີການຕັ້ງຄ່າ Push URL ແຕ່ບໍ່ໄດ້ລະບຸ Push branch. ກະລຸນາຕັ້ງຄ່າ Push branch ໃຫ້ຕ່າງຈາກ "
"Branch ທີ່ແປ."

msgid ""
"The push branch must differ from the translated branch when creating a pull "
"or merge request."
msgstr "Push branch ຕ້ອງຕ່າງຈາກ Branch ທີ່ແປ ເວລາສ້າງການຮ້ອງຂໍ Pull ຫຼື Merge."

msgid "A pull or merge request will be created from a fork of the repository."
msgstr "ການຮ້ອງຂໍ Pull ຫຼື Merge ຈະຖືກສ້າງຂຶ້ນຈາກ Fork ຂອງ Repository."

#, javascript-format
msgid ""
"A pull or merge request will be created from the “%s” branch in the "
"repository."
msgstr "ການຮ້ອງຂໍ Pull ຫຼື Merge ຈະຖືກສ້າງຂຶ້ນຈາກ Branch “%s” ໃນ Repository."

#, javascript-format
msgid ""
"Changes will be sent as a Gerrit review request targeting the “%s” branch."
msgstr "ການປ່ຽນແປງຈະຖືກສົ່ງເປັນການຮ້ອງຂໍກວດສອບ Gerrit ໄປຍັງ Branch “%s”."

msgid "Changes will be sent as a Gerrit review request."
msgstr "ການປ່ຽນແປງຈະຖືກສົ່ງເປັນການຮ້ອງຂໍກວດສອບ Gerrit."

msgid ""
"Changes will not be pushed automatically. You can still push them manually "
"from the repository maintenance."
msgstr ""
"ການປ່ຽນແປງຈະບໍ່ຖືກ Push ໂດຍອັດຕະໂນມັດ. ທ່ານສາມາດ Push ດ້ວຍຕົນເອງໄດ້ຈາກການບຳລຸງຮັກສາ "
"Repository."

#, javascript-format
msgid ""
"Changes will be pushed directly to the “%s” branch in the push repository."
msgstr "ການປ່ຽນແປງຈະຖືກ Push ໂດຍກົງໄປຍັງ Branch “%s” ໃນ Push repository."

msgid ""
"Changes will be pushed directly to the default branch of the push repository."
msgstr "ການປ່ຽນແປງຈະຖືກ Push ໂດຍກົງໄປຍັງ Branch ເລີ່ມຕົ້ນຂອງ Push repository."

msgid "Text copied to clipboard."
msgstr "ຄັດລອກຂໍ້ຄວາມໃສ່ຄລິບບອດແລ້ວ."

msgid "Error copying to clipboard."
msgstr "ເກີດຂໍ້ຜິດພາດໃນການຄັດລອກໃສ່ຄລິບບອດ."

msgid "Some source strings could not be assigned."
msgstr "ຂໍ້ຄວາມຕົ້ນສະບັບບາງອັນບໍ່ສາມາດກຳນົດໄດ້."

