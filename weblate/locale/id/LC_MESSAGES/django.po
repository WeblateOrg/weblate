msgid "Requires dedicated reviewers to approve source strings."
msgstr "Membutuhkan peninjau khusus untuk menyetujui string sumber."

msgid ""
"Select which translations should be included when committing changes. More "
"restrictive options will skip translations with potential quality issues."
msgstr ""
"Pilih terjemahan mana yang akan disertakan ketika melakukan komit. Opsi yang "
"lebih ketat akan melewatkan terjemahan dengan potensi masalah kualitas."

msgid "Enable hooks"
msgstr "Aktifkan pengait"

msgid "Whether to allow updating this repository by remote hooks."
msgstr ""
"Jika ingin mengizinkan pembaruan repositori ini melalui pengait jarak jauh."

msgid "Language aliases"
msgstr "Alias bahasa"

msgid ""
"Comma-separated list of language code mappings, for example: "
"en_GB:en,en_US:en"
msgstr ""
"Daftar pemetaan kode bahasa yang dipisahkan koma, misalnya: en_GB:en,en_US:en"

msgid "Use the translation license configured in the workspace."
msgstr "Gunakan lisensi terjemahan yang dikonfigurasi di workspace."

msgid ""
"Contributor license agreement which needs to be approved before a user can "
"translate components in this project."
msgstr ""
"Perjanjian lisensi kontributor yang harus disetujui sebelum pengguna dapat "
"menerjemahkan komponen dalam proyek ini."

msgid "Use the contributor license agreement configured in the workspace."
msgstr ""
"Gunakan perjanjian lisensi kontributor yang dikonfigurasi di workspace."

msgid "Use the adding new translations setting configured in the workspace."
msgstr ""
"Gunakan pengaturan penambahan terjemahan baru yang dikonfigurasi di "
"workspace."

msgid "Use the language code style configured in the workspace."
msgstr "Gunakan gaya kode bahasa yang dikonfigurasi di workspace."

msgid "Use the secondary language configured in the workspace."
msgstr "Gunakan bahasa sekunder yang dikonfigurasi di workspace."

msgid "Use the commit message when translating configured in the workspace."
msgstr ""
"Gunakan pesan commit saat menerjemahkan yang dikonfigurasi di workspace."

msgid ""
