msgid "Prepended static text"
msgstr "Teks statis diisi awal"

msgid "Prepended variable text"
msgstr "Teks variabel diisi awal"

msgid "Appended static text"
msgstr "Ditambahkan teks statis"

msgid "Appended variable text"
msgstr "Teks variabel ditambahkan"

msgid "Variable text multiplier"
msgstr "Pengganda teks variabel"

msgid ""
"How many times to repeat the variable text depending on the length of the "
"source string."
msgstr ""
"Berapa kali mengulang teks variabel tergantung dari panjang string sumber."

msgid "Include read-only strings"
msgstr "Termasuk string hanya baca"

msgid "The source and target have to be different languages."
msgstr "Sumber dan target harus bahasa yang berbeda."

msgid "Enable case-sensitive key sorting"
msgstr "Aktifkan penyortiran tombol yang peka huruf kapital"

msgid "Change events to trigger"
msgstr "Kejadian perubahan yang akan memicu"

msgid "Translation content events"
msgstr "Kejadian konten terjemahan"

