msgstr "Konteks terjemahan"

msgid ""
"Describe the context of the translation to improve the accuracy of the "
"translation."
msgstr "Deskripsikan konteks terjemahan untuk meningkatkan akurasi terjemahan."

msgctxt "Automatic suggestion service configuration"
msgid "Use next-gen model"
msgstr "Gunakan model generasi selanjutnya"

msgid "Prefer next-gen LLM over classic machine translation model."
msgstr "Pilih LLM generasi selanjutnya daripada model terjemahan mesin klasik."

msgid "DeepL API v1 is no longer supported."
msgstr "DeepL API v1 tidak lagi didukung."

msgctxt "Automatic suggestion service configuration"
msgid "LLM model"
msgstr "Model LLM"

msgctxt "Automatic suggestion service configuration"
msgid "Translator persona"
msgstr "Kepribadian penerjemah"

msgid ""
"Describe the persona of translator to improve the accuracy of the "
"translation. For example: “You are a squirrel breeder.”"
msgstr ""
"Deskripsikan persona penerjemah untuk meningkatkan akurasi terjemahan. "
"Misalnya: “Anda adalah peternak tupai.”"

msgctxt "Automatic suggestion service configuration"
msgid "Translator style"
msgstr "Gaya penerjemah"

msgid ""
"Describe the style of translation. For example: “Use informal language.”"
msgstr ""
"Deskripsikan gaya terjemahan. Misalnya: “Gunakan bahasa yang tidak formal.”"

msgctxt "Automatic suggestion service configuration"
msgid "Language-specific instructions"
msgstr "Instruksi khusus bahasa"

#, python-format
msgid ""
"JSON object mapping existing target language codes to extra instructions, up "
"to %(limit)d characters each."
msgstr ""
"Objek JSON memetakan kode bahasa target ada ke instruksi ekstra, hingga "
"setiap %(limit)d karakter."

msgid "Language-specific instructions must be a JSON object."
msgstr "Instruksi khusus bahasa harus berupa objek JSON."

#, python-format
msgid "Language-specific instructions contain invalid language code \"%s\"."
msgstr "Instruksi khusus bahasa berisi kode bahasa tidak valid \"%s\"."

#, python-format
msgid "Language-specific instructions contain unknown language code \"%s\"."
msgstr "Instruksi khusus bahasa berisi kode bahasa tidak diketahui \"%s\"."

#, python-format
msgid ""
"Language-specific instructions for \"%(language)s\" must be at most "
"%(limit)d characters."
msgstr ""
"Instruksi khusus bahasa untuk \"%(language)s\" harus paling banyak %(limit)d "
"karakter."

