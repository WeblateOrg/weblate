msgctxt "No known user"
msgid "None"
msgstr "אין"

msgid "User avatar"
msgstr "תמונה מייצגת למשתמש"

msgid ""
"This e-mail address is already in use. Please supply a different e-mail "
"address."
msgstr "כתובת דוא״ל זו כבר בשימוש. נא לספק כתובת דוא״ל אחרת."

msgid "This username is already taken. Please pick something else."
msgstr "שם משתמש זה כבר תפוס. נא לבחור משהו אחר."

msgid "Full name"
msgstr "שם מלא"

msgid "Name is also used in version control commits."
msgstr "בשם נעשה שימוש גם לקיבועים בבקרת הגרסאות."

msgid "Commit e-mail"
msgstr "כתובת דוא״ל לקיבועים"

msgid "Use account e-mail address"
msgstr "להשתמש בכתובת הדוא״ל של החשבון"

msgid ""
"Used in version-control commits. The address stays in the repository forever "
"once changes are committed by Weblate."
msgstr ""
"משמש בקיבועים למערכת בקרת הגרסאות. הכתובת נשארת במאגר לעד לאחר שהתקבעו "
"שינויים על ידי Weblate."

msgid "Commit name"
msgstr "שם קיבוע"

msgid ""
"Used in version control commits. The name stays in the repository forever, "
"once changes are committed by Weblate."
msgstr ""
"משמש בקיבועים למערכת בקרת הגרסאות. השם נשאר במאגר לעד לאחר שהתקבעו שינויים "
"על ידי Weblate."

msgid "Public e-mail"
msgstr "דוא״ל ציבורי"

msgid "Hide e-mail address from public view"
msgstr "הסתרת כתובת דוא״ל מעיני הציבור"

#, python-format
msgid "Component list: %s"
msgstr "רשימת רכיבים: %s"

msgid "Account e-mail"
msgstr "כתובת דוא״ל של החשבון"

msgid ""
"Used for e-mail notifications and as a commit e-mail if it is not configured "
"below."
msgstr "משמש להודעות דוא״ל וכדוא״ל לקיבוע אם לא מוגדר להלן."

msgid "Human verification"
msgstr "אימות אנושי"

#, python-format
msgctxt ""
"Question for a mathematics-based CAPTCHA, the %s is an arithmetic problem"
msgid "What is %s?"
msgstr "כמה זה %s?"

#. Translators: Shown on wrong answer to the mathematics-based CAPTCHA
msgid "That was not correct, please try again."
msgstr "תשובה שגויה, נא לנסות שוב."

msgid "Validation failed, please try again."
msgstr "האימות נכשל, נא לנסות שוב."

msgid "Subject"
msgstr "נושא"

msgid "Your name"
msgstr "שמך"

msgid "Your e-mail"
msgstr "הדוא״ל שלך"

msgid "Message"
msgstr "הודעה"

msgid ""
"Please contact us in English. Otherwise, we might not process your request."
msgstr "נא ליצור אתנו קשר באנגלית. אחרת כנראה שלא נוכל לעבד את בקשתך."

msgid "E-mail"
msgstr "דוא״ל"

msgid "An e-mail with a confirmation link will be sent here."
msgstr "הודעת אישור בדוא״ל עם קישור תישלח כאן."

msgid "New password"
msgstr "סיסמה חדשה"

msgid "New password confirmation"
msgstr "אימות הסיסמה החדשה"

msgid "Regenerate API key"
msgstr "הפקת מפתח API מחדש"

msgid ""
"Leave enabled to revoke the current API key and generate a new one. This is "
"recommended if you suspect your password was compromised. Disable it to keep "
"your current API key active after changing your password."
msgstr ""

msgid "Your password has been changed."
msgstr "סיסמתך הוחלפה."

msgid "Current password"
msgstr "הסיסמה הנוכחית"

msgid "Leave empty if you have not set a password yet."
msgstr "יש להשאיר ריק אם טרם הגדרת סיסמה."

msgid "You have entered an invalid password."
msgstr "הקלדת סיסמה שגויה."

msgid "Username or e-mail"
msgstr "שם משתמש או דוא״ל"

msgid "Password"
msgstr "סיסמה"

msgid "Please enter the correct username and password."
msgstr "נא להקליד את שם המשתמש והסיסמה הנכונים."

msgid "This account is inactive."
msgstr "חשבון זה רדום."

msgid "Component wide notifications"
msgstr "התרעות למספר רכיבים"

msgid "Translation notifications"
msgstr "התרעות על תרגום"

msgid "Use default setting"
msgstr "שימוש בהגדרות בררת המחדל"

msgid "Other projects"
msgstr "מיזמים אחרים"

msgid "Watched projects"
msgstr "מיזמים במעקב"

msgid "Managed projects"
msgstr "מיזמים מנוהלים"

msgid "Project: {}"
msgstr "מיזם: {}"

msgid "Component: {}"
msgstr "רכיב: {}"

msgid ""
"You will receive a notification for every such event in non-watched projects."
msgstr "אליך יגיעו התראות על כל אירוע שכזה במיזמים שאינם ברשימת המעקב שלך."

msgid ""
"You will receive a notification for every such event in your watched "
"projects."
msgstr "אליך יגיעו התרעות על כל אירוע שכזה במיזמים שברשימת המעקב שלך."

msgid ""
"You will receive a notification for every such event in projects where you "
"have admin permissions."
msgstr "תגענה אליך התראות על כל אירוע שכזה במיזמים שיש לך הרשאות ניהול בהם."

#, python-format
msgid "You will receive a notification for every such event in %(project)s."
msgstr "תגענה אליך התראות על כל אירוע שכזה בתוך %(project)s."

#, python-format
msgid "You will receive a notification for every such event in %(component)s."
msgstr "תגענה אליך התראות על כל אירוע שכזה בתוך %(component)s."

msgid ""
"You will only receive these notifications for your translated languages in "
"non-watched projects."
msgstr ""
"רק ההתראות הנבחרות יגיעו אליך עבור השפות בהן יש לך פעילות במיזמים שאינם "
"ברשימת המעקב שלך."

msgid ""
"You will only receive these notifications for your translated languages in "
"your watched projects."
msgstr ""
"רק ההתרעות הנבחרות יגיעו אליך עבור השפות בהן יש לך פעילות במיזמים שברשימת "
"המעקב שלך."

msgid ""
"You will only receive these notifications for your translated languages in "
"projects where you have admin permissions."
msgstr ""
"ההתראות האלו תישלחנה אליך עבור השפות אליהן תרגמת במיזמים שיש לך הרשאות ניהול "
"בהם."

#, python-format
msgid ""
"You will only receive these notifications for your translated languages in "
"%(project)s."
msgstr "רק ההתרעות הנבחרות תגענה אליך עבור השפות אליהן תרגמת בתוך %(project)s."

#, python-format
msgid ""
"You will only receive these notifications for your translated languages in "
"%(component)s."
msgstr ""
"רק ההתרעות הנבחרות תגענה אליך עבור השפות אליהן תרגמת בתוך %(component)s."

msgid "Username"
msgstr "שם משתמש"

msgid "Date joined"
msgstr "מועד ההצטרפות"

msgid "Translations made"
msgstr "תרגומים שהוגשו"

msgid "Suggestions made"
msgstr "הצעות שהוגשו"

msgid "Comments made"
msgstr "נוספו הערות"

msgid "Screenshots uploaded"
msgstr "צילומי המסך הועלו"

msgid "The chosen sorting is not supported."
msgstr "המיון שנבחר אינו נתמך."

msgid "Team"
msgstr "צוות"

msgid "Add to a team"
msgstr "הוספה לצוות"

msgid "Name your authentication app"
msgstr "מתן שם ליישומון האימות שלך"

msgid "Verify the code from the app"
msgstr "אימות הקוד מהיישומון"

msgid "Discard previously configured authentication apps"
msgstr "התעלמות מיישומי אימות שהוגדרו בעבר"

msgid ""
"All previously configured authentication apps will be discarded upon "
"verification of the new app."
msgstr "כל יישומי האימות שהוגדרו בעבר יוסרו במקרה של אימות של היישום החדש."

msgid ""
"Other two-factor methods (such as WebAuthn and security keys) won't be "
"affected."
msgstr "שיטות אחרות לאימות דו־שלבי (כגון WebAuthn ומפתחות אבטחה) לא תושפענה."

msgid "The entered token is not valid."
msgstr "האסימון שסופק לא תקף."

msgid "Recovery token"
msgstr "אסימון שחזור"

msgid ""
"Recovery codes can only be used once. Remember to mark used ones as expired."
msgstr ""
"אפשר להשתמש בקודים לשחזור פעם אחת, נא לסמן את אלו שהשתמשת בהם לאחר השימוש."

msgid "Enter the code from the app"
msgstr "נא למלא קוד מהיישומון"

