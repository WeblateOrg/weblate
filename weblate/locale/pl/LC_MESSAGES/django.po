msgid "Name"
msgstr "Nazwa"

msgid "Choose permissions granted to this role."
msgstr "Wybierz uprawnienia przyznane tej roli."

msgid "Roles"
msgstr "Role"

msgid "Choose roles granted to this team."
msgstr "Wybierz role przyznane temu zespołowi."

msgid "Project selection"
msgstr "Wybór projektu"

msgid "As defined"
msgstr "Jak zdefiniowano"

msgid "All projects"
msgstr "Wszystkie projekty"

msgid "All public projects"
msgstr "Wszystkie projekty publiczne"

msgid "All protected projects"
msgstr "Wszystkie chronione projekty"

