msgstr ""
"Ile sekund należy odczekać między kolejnymi próbami nawiązania połączenia."

msgid "Topic prefix can contain only ASCII characters."
msgstr "Prefiks tematu może zawierać tylko znaki ASCII."

#, python-format
msgid "Topic prefix must not exceed %(limit)d characters."
msgstr "Prefiks tematu nie może przekraczać %(limit)d znaków."

msgid "The SSL certificates have to be provided for SSL connection."
msgstr "Do połączenia SSL należy dostarczyć certyfikaty SSL."

msgid "The SSL certificates are not used without a SSL connection."
msgstr "Certyfikaty SSL nie są używane bez połączenia SSL."

msgid "Statistics generator"
msgstr "Generator statystyk"

msgid "Generates a file containing detailed info about the translation status."
msgstr "Generuje plik zawierający szczegółowe informacje o stanie tłumaczenia."

msgid "Pseudolocale generation"
msgstr "Generowanie pseudolokalizacji"

msgid ""
"Generates a translation by adding prefix and suffix to source strings "
"automatically."
msgstr ""
"Generuje tłumaczenie poprzez automatyczne dodanie prefiksu i sufiksu do "
"ciągów źródłowych."

msgid "Prefill translation with source"
msgstr "Wypełnij wstępnie tłumaczenie źródłem"

msgid "Fills in translation strings with source string."
msgstr "Wypełnia ciągi tłumaczeń ciągami źródłowymi."

msgid "Fill read-only strings with source"
msgstr "Wypełnij ciągi tylko do odczytu źródłem"

