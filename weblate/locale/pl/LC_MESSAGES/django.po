#, python-format
msgid "Could not clean the repository on %s."
msgstr "Nie udało się wyczyścić repozytorium %s."

#, python-format
msgid "Could not rebase local branch onto remote branch %s."
msgstr "Nie udało się wykonać rebase lokalnej gałęzi na zdalną gałąź %s."

#, python-format
msgid "Could not merge remote branch into %s."
msgstr "Nie udało się scalić zdalnej gałęzi z %s."

msgid "Category does not belong to this project."
msgstr "Kategoria nie należy do tego projektu."

msgid "Invalid link to a Weblate project, use weblate://project/component."
msgstr ""
"Niepoprawny link do projektu Weblate, użyj weblate://project/subproject."

msgid "Invalid link to a Weblate project, cannot link to linked repository!"
msgstr ""
"Nieprawidłowy link do projektu Weblate, nie można połączyć z połączonym "
"repozytorium!"

msgid "Invalid link to a Weblate project, cannot link it to itself!"
msgstr ""
"Nieprawidłowy link do projektu Weblate nie może połączyć go z samym sobą!"

msgid "The file mask did not match any files."
msgstr "Maska pliku nie pasowała do żadnych plików."

#, python-format
msgid ""
"There is more than one file for %(language)s language: %(filename1)s, "
"%(filename2)s Please adjust the file mask and use components for translating "
"different resources."
msgstr ""
"Istnieje więcej niż jeden plik dla języka %(language)s: %(filename1)s, "
"%(filename2)s. Dostosuj maskę pliku i użyj komponentów do tłumaczenia "
"różnych zasobów."

msgid "Could not find any matching language, please check the file mask."
msgstr "Nie udało się znaleźć żadnego pasującego języka, sprawdź maskę pliku."

#, python-brace-format
msgid "Could not parse {file}: {error}"
msgstr "Nie udało się przeanalizować {file}: {error}"

#, python-format
msgid "Could not parse %d matched file."
msgid_plural "Could not parse %d matched files."
msgstr[0] "Nie udało się przeanalizować %d dopasowanego pliku."
msgstr[1] "Nie udało się przeanalizować %d dopasowanych plików."
msgstr[2] "Nie udało się przeanalizować %d dopasowanych plików."

msgid ""
"You have set up Weblate to add new translation files, but did not provide a "
"base file to do that."
msgstr ""
"Skonfigurowałeś Weblate, aby dodawać nowe pliki tłumaczeń, ale nie "
"udostępniłeś pliku bazowego."

msgid "Could not parse base file for new translations:"
msgstr "Nie udało się przeanalizować pliku bazowego dla nowych tłumaczeń:"

msgid "Unrecognized base file for new translations."
msgstr "Nierozpoznany plik podstawowy dla nowych tłumaczeń."

msgid "Adding and removing strings is not supported with this file format."
msgstr "Dodawanie i usuwanie ciągów nie jest obsługiwane w tym formacie pliku."

msgid "Editing template is not supported with this file format."
msgstr "Edycja szablonu nie jest obsługiwana dla tego formatu pliku."

msgid ""
"An intermediate language file can not be used without an editing template."
msgstr "Pośredni plik języka nie może być używany bez szablonu edycji."

msgid ""
"An intermediate language file has to be different from monolingual base "
"language file. You can probably keep it empty."
msgstr ""
"Plik języka pośredniego musi różnić się od jednojęzycznego pliku języka "
"podstawowego. Prawdopodobnie możesz zostawić to puste."

msgid "Using a .pot file as base file is unsupported."
msgstr "Używanie pliku .pot jako pliku podstawowego nie jest obsługiwane."

#, python-format
msgid "Could not parse translation base file: %s"
msgstr "Nie udało się przeanalizować bazowego pliku tłumaczenia: %s"

#, python-brace-format
msgid "Template language ({0}) does not match source language ({1})!"
msgstr "Język szablonu ({0}) nie jest zgodny z językiem źródłowym ({1})!"

msgid "Push URL is not used without a remote repository."
msgstr "Adres URL push nie jest używany bez zdalnego repozytorium."

#, python-format
msgid "Could not validate push URL: %s"
msgstr "Nie można zweryfikować adresu URL push: %s"

msgid ""
"Pull and push branches cannot be the same when using pull/merge requests and "
"not pushing to a fork."
msgstr ""
"Gałęzie pull i push nie mogą być takie same podczas używania pull/merge "
"requestów i braku wypychania do forka."

msgid ""
"Push branch cannot be empty when using pull/merge requests and not pushing "
"to a fork."
msgstr ""
"Gałąź push nie może być pusta podczas używania pull/merge requestów i braku "
"wypychania do forka."

msgid "Choose No remote repository for local: URL."
msgstr "Wybierz Brak zdalnego repozytorium dla lokalnego: URL."

#, python-format
msgid "Could not update repository: %s"
msgstr "Nie udało się zaktualizować repozytorium: %s"

msgid ""
"Your push URL seems to miss credentials. Either provide them in the URL or "
"use SSH with key based authentication."
msgstr ""
"Wygląda na to że, twój adres URL wypychania zmian nie posiada odpowiednich "
"uprawnień. Podaj je w adresie URL lub użyj SSH z uwierzytelnianiem opartym "
"na kluczu."

#, python-format
msgid "Invalid repository branch: %s"
msgstr "Nieprawidłowa gałąź repozytorium: %s"

#, python-format
msgid "Invalid push branch: %s"
msgstr "Nieprawidłowa gałąź push: %s"

#, python-format
msgid ""
"Use %(branch)s instead of %(ref)s; Weblate and git-review add the Gerrit "
"refs automatically."
msgstr ""
"Użyj %(branch)s zamiast %(ref)s; Weblate i git-review dodają odwołania "
"Gerrit automatycznie."

#, python-format
msgid ""
"The parameter '%(param)s' is not applicable for the file format '%(format)s'."
msgstr ""
"Parametr „%(param)s” nie ma zastosowania do formatu pliku „%(format)s”."

#, python-format
msgid ""
"The parameter '%(param)s' is not applicable for the version control system "
"'%(vcs)s'."
msgstr ""
"Parametr „%(param)s” nie ma zastosowania w systemie kontroli wersji „%(vcs)s"
"”."

msgid ""
"Pushing without a merge request needs write access to the repository. "
"Configure a push URL with credentials, or use an SSH repository URL."
msgstr ""
"Przesyłanie bez żądania scalenia wymaga dostępu do zapisu w repozytorium. "
"Skonfiguruj adres URL przesyłania za pomocą danych uwierzytelniających lub "
"użyj adresu URL repozytorium SSH."

msgid ""
"A component can not be restricted while its project uses shared translation "
"memory."
msgstr ""
"Nie można ograniczyć komponentu, jeśli jego projekt korzysta ze "
"współdzielonej pamięci tłumaczeniowej."

msgid ""
"Please either fill in an instruction URL or use a different option for "
"adding a new language."
msgstr "Wpisz adres URL instrukcji lub użyj innej opcji, aby dodać nowy język."

msgid ""
"Source language can not be changed, please recreate the component instead."
msgstr ""
"Nie można zmienić języka źródłowego. Zamiast tego utwórz ponownie komponent."

msgid "Accepting suggestions automatically only works with voting turned on."
msgstr ""
"Akceptowanie sugestii odbywa się automatycznie tylko przy włączonym "
"głosowaniu."

msgid "To use the key filter, the file format must be monolingual."
msgstr "Aby użyć filtra kluczy, format pliku musi być jednojęzyczny."

msgid "Can not validate file matches due to invalid regular expression."
msgstr ""
"Nie można zweryfikować dopasowań pliku z powodu nieprawidłowego wyrażenia "
"regularnego."

msgid "The regular expression is too complex and took too long to evaluate."
msgstr ""
"Wyrażenie regularne jest zbyt złożone i jego wykonanie zajęło zbyt dużo "
"czasu."

msgid "Could not add new translation file."
msgstr "Nie udało się dodać nowego pliku tłumaczenia."

msgid "You do not have permissions to add new translation file."
msgstr "Nie masz uprawnień do dodawania nowego pliku tłumaczenia."

msgid "The monolingual base language file is invalid."
msgstr "Jednojęzyczny bazowy plik języka jest nieprawidłowy."

msgid "The template for new translations is invalid."
msgstr "Szablon dla nowych tłumaczeń jest nieprawidłowy."

msgid "The given language already exists."
msgstr "Podany język już istnieje."

msgid "Translation file already exists!"
msgstr "Plik tłumaczenia już istnieje!"

msgid "The translation will be updated in the background."
msgstr "Tłumaczenie zostanie zaktualizowane w tle."

#. Translators: Translation key for monolingual translations
