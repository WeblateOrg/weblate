msgstr "Powiadomienie o nieaktywnej płatności cyklicznej"

msgid "Latest upstream commit"
msgstr "Ostatni nadrzędny commit"

msgid "Oldest pending Weblate change"
msgstr "Najstarsza oczekująca zmiana Weblate"

msgid "Repository changes alert"
msgstr "Alert o zmianach w repozytorium"

