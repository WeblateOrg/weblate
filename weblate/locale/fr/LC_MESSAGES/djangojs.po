msgstr "Certaines chaînes source n'ont pas pu être attribuées."

msgid "Error loading search results!"
msgstr "Erreur au chargement des résultats de recherche !"

msgid "No new matching source strings found."
msgstr "Aucune nouvelle chaîne source correspondante."

msgid "Sort this column"
msgstr "Trier sur cette colonne"

msgid "Error while loading page:"
msgstr "Erreur lors du chargement de la page :"

msgid "Please press Ctrl+C to copy."
msgstr "Veuillez appuyer sur Ctrl + C pour copier."

