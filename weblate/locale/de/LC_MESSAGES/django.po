msgctxt "Translation key"
msgid "Key"
msgstr "Schlüssel"

msgid "Add new translation string"
msgstr "Neue Übersetzung hinzufügen"

msgid "Could not get repository status!"
msgstr "Der Repository-Status konnte nicht abgerufen werden!"

msgid "File path is in a restricted location in the repository."
