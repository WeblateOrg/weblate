msgid "Ed25519"
msgstr "Ed25519"

#. Translators: placeholder SSH hashed hostname
msgid "[hostname hashed]"
msgstr "[Hostname gehasht]"

#, python-format
msgid "Could not generate key: %s"
msgstr "Der Schlüssel konnte nicht erzeugt werden: %s"

msgid "Created new SSH key."
msgstr "Neuer SSH-Schlüssel wurde erzeugt."

#, python-format
msgid "Could not fetch public key for a host: %s"
msgstr "Der öffentliche Hostschlüssel konnte nicht abgerufen werden: %s"

msgid "Could not fetch public key for a host."
msgstr "Der öffentliche Hostschlüssel konnte nicht abgerufen werden."

#, python-format
msgid ""
"Added host key for %(host)s with fingerprint %(fingerprint)s (%(keytype)s)."
msgstr ""
"Hostschlüssel für %(host)s mit Fingerabdruck %(fingerprint)s (%(keytype)s) "
"hinzugefügt."

#, python-format
msgid ""
"Skipped host key for %(host)s with fingerprint %(fingerprint)s (%(keytype)s)."
msgstr ""
"Hostschlüssel für %(host)s mit Fingerabdruck %(fingerprint)s (%(keytype)s) "
"übersprungen."

#, python-format
msgid ""
"Added host key for %(host)s with fingerprint %(fingerprint)s (%(keytype)s), "
"please verify that it is correct."
msgstr ""
"Hostschlüssel für %(host)s mit Fingerabdruck %(fingerprint)s (%(keytype)s) "
"hinzugefügt, bitte die Korrektheit prüfen."

msgid "No validated SSH addresses available."
msgstr "Es sind keine validierten SSH-Adressen verfügbar."

msgid "Could not read stored host keys."
msgstr "Die gespeicherten Hostschlüssel konnten nicht gelesen werden."

msgid "Could not find the selected host key."
msgstr "Der ausgewählte Hostschlüssel konnte nicht gefunden werden."

msgid "Could not update stored host keys."
msgstr "Die gespeicherten Hostschlüssel konnten nicht aktualisiert werden."

#, python-format
msgid ""
"Removed host key for %(host)s with fingerprint %(fingerprint)s (%(keytype)s)."
msgstr ""
"Hostschlüssel für %(host)s mit Fingerabdruck %(fingerprint)s (%(keytype)s) "
"entfernt."

#, python-format
msgid "Could not determine the effective SSH destination: %s"
msgstr "Das tatsächliche SSH-Ziel konnte nicht ermittelt werden: %s"

msgid ""
"Create a workspace before connecting a GitHub account. GitHub App "
"connections are linked to workspaces."
msgstr ""
"Erstellen Sie einen Arbeitsbereich, bevor Sie ein GitHub-Konto verbinden. "
"GitHub-App-Verbindungen sind mit Arbeitsbereichen verlinkt."

#, python-format
msgid "Removed connected GitHub account %(target)s."
msgstr "Verbundenes GitHub-Konto %(target)s entfernt."

#, python-format
msgid ""
"Remove connected GitHub accounts on %(hostname)s before removing the app "
"credentials."
msgstr ""
"Entfernen Sie die mit %(hostname)s verbundenen GitHub-Konten, bevor Sie die "
"Zugangsdaten der App löschen."

#, python-format
msgid "Removed Weblate GitHub App credentials for %(hostname)s."
msgstr "Die Zugangsdaten der Weblate-GitHub-App für %(hostname)s entfernt."

msgid "Failed to refresh repositories from GitHub."
msgstr "Das Aktualisieren der Repositorys von GitHub ist fehlgeschlagen."

#, python-format
msgid "Refreshed %(count)d repositories from GitHub."
msgstr "%(count)d Repositorys von GitHub aktualisiert."

msgid "Weblate GitHub app is not configured on this Weblate instance."
msgstr ""
"Die Weblate-GitHub-App ist auf dieser Weblate-Instanz nicht konfiguriert."

msgid "Select a workspace before connecting a GitHub account."
msgstr "Wählen Sie einen Arbeitsbereich, bevor Sie ein GitHub-Konto verbinden."

msgid "Weblate GitHub app is not configured for the selected host."
msgstr "Weblate-GitHub-App ist für den ausgewählten Host nicht konfiguriert."

msgid "Connected GitHub account updated."
msgstr "Verbundenes GitHub-Konto aktualisiert."

msgid ""
"The Weblate GitHub app installation link is no longer valid. Start the "
"installation again."
msgstr ""
"Der Installationslink für die Weblate-GitHub-App ist nicht mehr gültig. "
"Starten Sie die Installation erneut."

msgid "You do not have permission to connect GitHub to this workspace."
msgstr ""
"Sie haben keine Berechtigung, GitHub mit diesem Arbeitsbereich zu verbinden."

msgid "GitHub did not return a valid installation ID."
msgstr "GitHub hat keine gültige Installations-ID zurückgegeben."

msgid ""
"Too many GitHub account connection attempts. The GitHub installation was not "
"connected and might still be pending. Try connecting the account again later."
msgstr ""
"Zu viele Verbindungsversuche zum GitHub-Konto. Die GitHub-Installation war "
"nicht verbunden und könnte noch ausstehen. Versuchen Sie später erneut, das "
"Konto zu verbinden."

msgid ""
"Weblate could not confirm that you can administer this GitHub installation. "
"Start the installation again with a GitHub user who owns the account or can "
"administer the organization."
msgstr ""
"Weblate konnte nicht bestätigen, dass Sie diese GitHub-Installation "
"verwalten dürfen. Starten Sie die Installation erneut mit einem GitHub-"
"Benutzer, der Besitzer des Kontos ist oder die Organisation verwalten darf."

msgid ""
"GitHub is still syncing the connected GitHub account. The connection is "
"pending and repositories might not appear yet. Try connecting the account "
"again later if they do not show up."
msgstr ""
"GitHub synchronisiert das verbundene GitHub-Konto derzeit noch. Die "
"Verbindung steht noch aus, daher werden die Repositorys möglicherweise noch "
"nicht angezeigt. Versuchen Sie später erneut, das Konto zu verbinden, falls "
"sie nicht angezeigt werden."

msgid ""
"The connected GitHub account was saved, but refreshing the repository list "
"failed. Try again in a moment."
msgstr ""
"Das verbundene GitHub-Konto wurde gespeichert, aber das Aktualisieren der "
"Repository-Liste ist fehlgeschlagen. Bitte versuchen Sie es in Kürze erneut."

msgid "Connected GitHub account added."
msgstr "Verbundenes GitHub-Konto hinzugefügt."

msgid "Enter a valid GitHub App name and host."
msgstr "Geben Sie einen gültigen GitHub-App-Namen und -Host ein."

#, python-format
msgid ""
"A Weblate GitHub App is already registered for %(hostname)s. Remove it "
"before registering another one."
msgstr ""
"Für %(hostname)s ist bereits eine Weblate-GitHub-App registriert. Entfernen "
"Sie diese, bevor Sie eine weitere registrieren."

msgid "GitHub did not return a valid registration code."
msgstr "GitHub hat keinen gültigen Registrierungscode zurückgegeben."

msgid ""
"The GitHub App registration link is no longer valid. Start the registration "
"again."
msgstr ""
"Der GitHub-App-Einladungslink ist nicht mehr gültig. Bitte starten Sie die "
"Registrierung erneut."

msgid "GitHub rejected the registration code. Start the registration again."
msgstr ""
"GitHub hat den Registrierungscode abgelehnt. Starten Sie die Registrierung "
"erneut."

msgid "GitHub returned an incomplete App registration response."
msgstr ""
"GitHub hat eine unvollständige Antwort zur App-Registrierung zurückgegeben."

msgid "Weblate GitHub App registered. You can now connect a GitHub account."
msgstr ""
"Weblate-GitHub-App registriert. Sie können nun ein GitHub-Konto verbinden."

msgid "Weblate GitHub App credentials updated."
msgstr "Weblate-GitHub-App-Zugangsdaten aktualisiert."

msgid "Activation token"
msgstr "Aktivierungstoken"

msgid ""
"Please enter the activation token obtained when making the subscription."
msgstr ""
"Bitte geben Sie den Aktivierungstoken ein, den Sie bei der Anmeldung "
"erhalten haben."

msgid "Port"
