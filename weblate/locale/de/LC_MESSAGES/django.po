msgstr "Nicht unterstützte unterbrochene Git-Operation: %(operation)s"

msgid ""
"This VCS backend cannot safely connect to this URL while private address "
"restrictions are enabled."
msgstr ""
"Dieses VCS-Backend kann keine sichere Verbindung zu dieser URL herstellen, "
"solange die Einschränkungen für private Adressen aktiviert sind."

#, python-format
msgid "Fetching VCS repository from %(hostname)s is not allowed."
msgstr "Abruf des VCS-Repositorys von %(hostname)s ist nicht erlaubt."

msgid "Enter a valid URL."
msgstr "Geben Sie eine gültige URL ein."

#, python-format
msgid "Could not parse URL: %(error)s"
msgstr "URL konnte nicht analysiert werden: %(error)s"

#, python-format
msgid "Fetching VCS repository using %(scheme)s is not allowed."
msgstr "Abruf des VCS-Repositorys über %(scheme)s ist nicht erlaubt."

