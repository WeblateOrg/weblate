msgstr "Itzulpen lagungarriak Zen moduan erakutsi"

msgid "Hide source if a secondary translation exists"
msgstr "Ezkutatu iturria bigarren itzulpen bat badago"

msgid "Show all columns in lists using horizontal scrolling"
msgstr "Erakutsi zutabe guztiak zerrendetan korritze horizontala erabiliz"

msgid ""
"Instead of hiding columns on narrow screens, keep all columns and scroll the "
"table horizontally."
msgstr ""
"Pantaila estuetan zutabeak ezkutatu beharrean, mantendu zutabe guztiak eta "
"mugitu taula horizontalean."

msgid "Editor link"
msgstr "Editorearen esteka"

msgid ""
"Enter a custom URL to be used as link to the source code. You can use "
"{{branch}} for branch, {{filename}} and {{line}} as filename and line "
"placeholders."
msgstr ""
"Iturburu-kodera eramango duen URL pertsonalizatua sartu. {{branch}} erabil "
"dezakezu adarrentzako, {{filename}} eta {{line}}, aldiz, fitxategi eta "
"lerroen izenentzako."

