msgstr "I futur duke përdorur fjalëkalim që nga një pajisje e re."

#. Translators: Audit log entry
msgid "Could not sign in using password."
msgstr "S’u bë dot hyrja duke përdorur fjalëkalim."

#. Translators: Audit log entry
#, python-brace-format
msgid "Invited to {project} by {username}."
msgstr "Ftuar te {project} nga {username}."

#. Translators: Audit log entry
msgid "Password configured."
msgstr "U formësua fjalëkalim."

msgid "To restore access to your account, please reset your password."
msgstr ""
"Që të rimerrni përdorimin e llogarisë tuaj, ju lutemi, ricaktoni "
"fjalëkalimin tuaj."

msgid "Please contact project maintainers if you feel this is inappropriate."
msgstr ""
"Ju lutemi, lidhuni me mirëmbajtësit e projektit, nëse mendoni se kjo është e "
"papërshtatshme."

msgid "If it was you, reset your password to regain access to your account."
msgstr ""
"Nëse qetë ju, ricaktoni fjalëkalimin, që të rifitoni hyrje te llogaria juaj."

