msgid ""
"No matching flag found for \"%s\"; press Enter to add it as a custom flag."
msgstr ""
"Për %s“” s’u gjet flamur që përkon; shtypni tastin Enter që të shtohet si "
"një flamur vetjak."

msgid "Image Pasted!"
msgstr "U ngjit Figurë!"

msgid "Press Ctrl+V or Command+V to paste an image."
msgstr "Që të ngjitni një figurë, shtypni Ctrl+V, ose Command+V."

