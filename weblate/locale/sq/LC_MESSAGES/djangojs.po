msgstr[0] "%s varg me përkim"
msgstr[1] "%s vargje me përkim"

msgid ""
"Your previous search results are no longer available. Refresh results to "
"continue."
msgstr ""
"Përfundimet e kërkimeve tuaja të mëparshme s’mund të kihen më. Që të "
"vazhdoni, rifreskoni përfundimet."

msgid "There are some unsaved changes, are you sure you want to leave?"
msgstr "Ka disa ndryshime të paruajtura, a jeni i sigurt se doni të largoheni?"

msgid "Save or discard your changes before accepting a suggestion."
msgstr ""
"Para se të pranoni një sugjerim, ruani, ose hidhni tej ndryshimet tuaja."

#, javascript-format
msgid "%s suggestion"
msgid_plural "%s suggestions"
msgstr[0] "%s sugjerim"
msgstr[1] "%s sugjerime"

msgid ""
"The translation was changed while you were editing it, your unsaved changes "
"were kept."
msgstr ""
"Përkthimi qe ndryshuar teksa po e përpunonit, u mbajtën ndryshimet tuaja të "
"paruajtura."

msgid "Hide suggestions"
msgstr "Fshihi sugjerimet"

msgid "Show suggestions"
msgstr "Shfaq sugjerime"

msgid "Processed %(processed)s of %(total)s entries."
msgstr "U përpunuan %(processed)s nga %(total)s zëra gjithsej."

#, javascript-format
msgid "Results of action %s"
msgstr "Përfundime të veprimit %s"

msgid "Not takes exactly one condition."
msgstr ""

msgid "Automations can nest eight levels deep."
msgstr "Automatizimet mund të zbresin deri në tetë nivele thellë."

msgid "Automations can hold one hundred nodes."
msgstr "Automatizimet mund të mbajnë njëqind nyje."

msgid "This workflow is not valid YAML, so the editor cannot show it."
msgstr ""
"Kjo rrjedhë pune s’është YAML i vlefshëm, ndaj përpunuesi s’mund ta shfaqë."

msgid ""
"This workflow has something the editor cannot show, such as an unknown "
"action or a setting that is no longer available. Edit it as YAML."
msgstr ""
"Kjo rrjedhë pune ka diçka që përpunuesi s’mund ta shfaqë, fjala vjen, një "
"veprim të panjohur, ose një rregullim që s’është më i pranishëm. Përpunojeni "
"si YAML."

#, javascript-format
msgid "Added %s."
msgstr "U shtua %s."

#, javascript-format
msgid "Removed %s."
msgstr "U hoq %s."

#, javascript-format
msgid "Moved %s."
msgstr "U lëviz %s."

msgid ""
"An action running on the whole component needs a query. Enter one or pick "
"another scope."
msgstr ""
"Një veprim që po kryhet mbi tërë përbërësin ka nevojë për një kërkesë. Jepni "
"një të tillë, ose zgjidhni tjetër fushëveprim."

msgid "Security token missing. Please reload the page."
msgstr "Mungon token sigurie. Ju lutemi, ringarkoni faqen."

#, javascript-format
msgid "Loading suggestion count for %s"
msgstr "Po ngarkohet numër sugjerimesh për %s"

msgid "Bulk accept cancelled."
msgstr "Pranimi në masë u anulua."

#, javascript-format
msgid "Scheduling bulk accept for %s"
msgstr "Po vihet në plan pranim në masë për %s"

msgid "Unknown error"
msgstr "Gabim i panjohur"

#, javascript-format
msgid "Error: %s"
msgstr "Gabim: %s"

msgid "Network error"
msgstr "Gabim rrjeti"

msgid "Invalid server response"
msgstr "Përgjigje e pavlefshme shërbyesi"

msgid ""
"Accepting the suggestions takes longer than expected, reload the page to see "
"the result."
msgstr ""
"Pranimi i sugjerime po zgjat më tepër seç pritej, që të shihni përfundimet, "
"ringarkoni faqen."

#, javascript-format
msgid "Server error (%s)"
msgstr "Gabim shërbyesi (%s)"

msgid "There are no pending suggestions from %(username)s in %(translation)s."
msgstr "Te %(translation)s s’ka sugjerime pezull nga %(username)s."

msgid ""
"This will accept %(count)s suggestion from %(username)s in %(translation)s."
msgid_plural ""
"This will accept %(count)s suggestions from %(username)s in %(translation)s."
msgstr[0] ""
"Kështu do të pranohet %s(count)s sugjerim nga %s(username)s te %(translation)"
"s."
msgstr[1] ""
"Kështu do të pranohen %s(count)s sugjerime nga %s(username)s te %"
"(translation)s."

msgid "Accept all suggestions?"
msgstr "Të pranohen krejt sugjerimet?"

msgid "Close"
msgstr "Mbylle"

msgid "Cancel"
msgstr "Anuloje"

msgid "Accept suggestions"
msgstr "Prano sugjerimet"

msgid "Accept and approve suggestions"
msgstr "Pranoni dhe miratoni sugjerime"

