msgstr "Predvyplniť preklad zdrojom"

msgid "Fills in translation strings with source string."
msgstr "Vyplňuje reťazce prekladu zdrojovým reťazcom."

msgid "Fill read-only strings with source"
msgstr "Vyplniť reťazce iba na čítanie zdrojom"

msgid "Fills in translation of read-only strings with source string."
msgstr "Vyplňuje preklad reťazcov iba na čítanie zdrojovým reťazcom."

msgid "Generate MO files"
msgstr "Generovať súbory MO"

