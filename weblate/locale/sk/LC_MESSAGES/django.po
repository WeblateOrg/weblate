"Use the merge request message configured in the parent category or project."
msgstr ""
"Použiť správu požiadavky na zlúčenie nakonfigurovanú v nadradenej kategórii "
"alebo projekte."

msgid "Parent category has to be in the same project!"
msgstr "Nadradená kategória musí byť v rovnakom projekte!"

msgid "Parent category has to be different!"
msgstr "Nadradená kategória musí byť iná!"

msgid "Repository path for this category already exists and is not empty."
msgstr "Cesta repozitára pre túto kategóriu už existuje a nie je prázdna."

