#, python-brace-format
msgid ""
"The Fluent reference in {sequence} may expand into an HTML tag. Maybe use "
"{suggestion}."
msgstr ""
"Fluent referencia v {sequence} sa môže rozšíriť na HTML značku. Možno použiť "
"{suggestion}."

#, python-brace-format
msgid ""
"The Fluent reference in {sequence} may expand into an HTML character "
"reference. Maybe use {suggestion}."
msgstr ""
"Fluent referencia v {sequence} sa môže rozbaliť na HTML znakový odkaz. Možno "
"použiť {suggestion}."

#, python-brace-format
msgid ""
"The sequence {sequence} begins with an HTML closing tag, but the name or "
"syntax is not valid. If you do not want a closing tag, use {suggestion}."
msgstr ""
"Sekvencia {sequence} sa začína uzatváracou HTML značkou, ale jej názov alebo "
"syntax nie je platná. Ak nechcete použiť uzatváraciu značku, použite "
"{suggestion}."

#, python-brace-format
msgid ""
"The sequence {sequence} begins with an HTML tag, but the name is not valid. "
"If you do not want to begin an HTML tag, use {suggestion}."
msgstr ""
"Sekvencia {sequence} sa začína HTML značkou, ale jej názov nie je platný. Ak "
"nechcete začínať HTML značku, použite {suggestion}."

#, python-brace-format
msgid ""
"The sequence {sequence} begins with an HTML tag, but the tag is never closed "
"by {close}. If you do not want to begin an HTML tag, use {suggestion}."
msgstr ""
"Sekvencia {sequence} sa začína HTML značkou, ale táto značka nie je nikdy "
"uzatvorená pomocou {close}. Ak nechcete začínať HTML značku, použite "
"{suggestion}."

#, python-brace-format
msgid ""
"Fluent inner HTML should not include {sequence}. Maybe use {suggestion}."
msgstr ""
"Fluent vnútorné HTML by nemalo obsahovať {sequence}. Možno použiť "
"{suggestion}."

#, python-brace-format
msgid ""
"The sequence {sequence} begins with an HTML tag, but the sequence "
"{attribute} is not a valid attribute with a value. If you do not want to "
"begin an HTML tag, use {suggestion}."
msgstr ""
"Sekvencia {sequence} sa začína HTML značkou, ale sekvencia {attribute} nie "
"je platný atribút s hodnotou. Ak nechcete začínať HTML značku, použite "
"{suggestion}."

#, python-brace-format
msgid "The HTML attribute name {name} for the {tag} tag is not valid."
msgstr "Názov HTML atribútu {name} pre tag {tag} nie je platný."

