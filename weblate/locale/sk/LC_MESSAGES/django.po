msgstr ""
"Aktualizuje premennú ALL_LINGUAS v súboroch „configure“, „configure.in“ "
"alebo „configure.ac“, keď sa pridá alebo odstráni preklad."

msgid "Update PO files to match POT (msgmerge)"
msgstr "Aktualizovať súbory PO tak, aby zodpovedali POT (msgmerge)"

msgid ""
"Updates all PO files (as configured by \"File mask\") to match the POT file "
"(as configured by \"Template for new translations\") using msgmerge."
msgstr ""
"Aktualizuje všetky súbory PO (ako nakonfigurované „Maskou súboru“) tak, aby "
"zodpovedali súboru POT (ako nakonfigurované „Šablónou pre nové preklady“) "
"pomocou msgmerge."

msgid "Update POT file (xgettext)"
msgstr "Aktualizovať súbor POT (xgettext)"

msgid "Updates the gettext template using xgettext on selected source files."
msgstr ""
"Aktualizuje šablónu gettextu pomocou xgettext na vybraných zdrojových "
"súboroch."

msgid "Update POT file (Meson)"
msgstr "Aktualizovať súbor POT (Meson)"

msgid "Updates the gettext template using Meson gettext conventions."
msgstr "Aktualizuje šablónu gettextu pomocou konvencií gettextu v Mesone."

msgid "Update gettext template (Django)"
msgstr "Aktualizovať gettext šablónu (Django)"

msgid ""
"Updates the gettext template using Django's built-in makemessages command."
msgstr ""
"Aktualizuje šablónu gettextu pomocou vstavaného príkazu makemessages v "
"Django."

msgid "Update POT file (Sphinx)"
msgstr "Aktualizovať súbor POT (Sphinx)"

msgid ""
"Updates the gettext template using Sphinx's gettext builder without loading "
"project configuration."
msgstr ""
"Aktualizuje šablónu gettextu pomocou nástroja na zostavovanie gettextu v "
"Sphinxe bez načítania konfigurácie projektu."

msgid "Contributors in comment"
msgstr "Prispievatelia v komentári"

msgid ""
"Updates the comment part of the PO file header to include contributor names "
"and years of contributions."
msgstr ""
"Aktualizuje časť komentára v hlavičke súboru PO tak, aby zahŕňala mená "
"prispievateľov a roky ich príspevkov."

msgid "Squash Git commits"
msgstr "Zlúčiť Git zápisy"

