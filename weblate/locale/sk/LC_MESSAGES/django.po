"Paste only the PEM certificate block starting with \"-----BEGIN "
"CERTIFICATE-----\"; do not paste the output from \"openssl x509 -text\"."
msgstr ""
"Vložte iba blok certifikátu PEM začínajúci „-----BEGIN CERTIFICATE-----“; "
"nevkladajte výstup z „openssl x509 -text“."

msgid "Publish timeout"
msgstr "Časový limit publikovania"

