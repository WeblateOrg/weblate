msgstr "Aktualizuje súbor LINGUAS, keď sa pridá alebo odstráni preklad."

msgid "Update ALL_LINGUAS variable in the \"configure\" file"
msgstr "Aktualizovať premennú ALL_LINGUAS v súbore „configure“"

