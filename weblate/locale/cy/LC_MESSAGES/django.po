msgid ""
"You will receive a notification for every such event in non-watched projects."
msgstr ""
"Byddwch yn derbyn hysbysiad ar gyfer pob digwyddiad o'r fath mewn prosiectau "
"nad ydynt yn cael eu gwylio."

msgid ""
"You will receive a notification for every such event in your watched "
"projects."
msgstr ""
"Byddwch yn derbyn hysbysiad ar gyfer pob digwyddiad o'r fath yn eich "
"prosiectau a wyliwyd gennych."

msgid ""
"You will receive a notification for every such event in projects where you "
"have admin permissions."
msgstr ""
"Byddwch yn derbyn hysbysiad am bob digwyddiad o'r fath mewn prosiectau lle "
"mae gennych ganiatâd gweinyddol."

#, python-format
msgid "You will receive a notification for every such event in %(project)s."
msgstr ""
"Byddwch yn derbyn hysbysiad ar gyfer pob digwyddiad o'r fath yn %(project)s."

#, python-format
msgid "You will receive a notification for every such event in %(component)s."
msgstr ""
"Byddwch yn derbyn hysbysiad am bob digwyddiad o'r fath yn %(component)s."

msgid ""
"You will only receive these notifications for your translated languages in "
"non-watched projects."
msgstr ""
"Byddwch yn derbyn hysbysiad ar gyfer eich ieithoedd wedi'u cyfieithu mewn "
"prosiectau nad ydynt yn cael eu gwylio."

msgid ""
"You will only receive these notifications for your translated languages in "
"your watched projects."
msgstr ""
"Byddwch yn derbyn hysbysiad ar gyfer eich ieithoedd wedi'u cyfieithu mewn "
"prosiectau a wylir."

msgid ""
"You will only receive these notifications for your translated languages in "
"projects where you have admin permissions."
msgstr ""
"Byddwch ond yn derbyn yr hysbysiadau hyn ar gyfer eich ieithoedd a "
"gyfieithwyd mewn prosiectau lle mae gennych ganiatâd gweinyddol."

#, python-format
msgid ""
"You will only receive these notifications for your translated languages in "
"%(project)s."
msgstr ""
"Byddwch yn derbyn hysbysiad ar gyfer eich ieithoedd wedi'u cyfieithu yn "
"%(project)s."

#, python-format
msgid ""
"You will only receive these notifications for your translated languages in "
"%(component)s."
msgstr ""
"Byddwch yn derbyn hysbysiad ar gyfer eich ieithoedd wedi'u cyfieithu yn "
"%(component)s."

