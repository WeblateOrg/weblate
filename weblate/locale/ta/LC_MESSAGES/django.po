#, python-format
msgid "Repository for %(component)s"
msgstr "%(component)s இதற்கான களஞ்சியம்"

msgid "Repository details"
msgstr "களஞ்சிய விவரங்கள்"

msgid "Repository changes"
msgstr "களஞ்சிய மாற்றங்கள்"

msgid "Browse all repository changes"
msgstr "அனைத்து களஞ்சிய மாற்றங்களையும் உலாவவும்"

msgid "Shortcut"
msgstr "குறுக்குவழி"

msgid "Action"
msgstr "செயல்"

msgid "Open available keyboard shortcuts."
msgstr "கிடைக்கக்கூடிய விசைப்பலகை குறுக்குவழிகளைத் திறக்கவும்."

msgid "Navigate to the first translation in the current search."
msgstr "தற்போதைய தேடலில் முதல் மொழிபெயர்ப்புக்கு செல்லவும்."

msgid "Navigate to the last translation in the current search."
msgstr "தற்போதைய தேடலில் கடைசி மொழிபெயர்ப்புக்குச் செல்."

msgctxt "between keyboard shortcuts"
msgid "or"
msgstr "அல்லது"

msgid "Navigate to the previous translation in the current search."
msgstr "தற்போதைய தேடலில் முந்தைய மொழிபெயர்ப்புக்கு செல்லவும்."

msgid "Navigate to the next translation in the current search."
msgstr "தற்போதைய தேடலில் அடுத்த மொழிபெயர்ப்புக்கு செல்லவும்."

msgid ""
"Submit current form; this works the same as pressing Save and continue while "
"editing translation."
msgstr ""
"தற்போதைய படிவத்தை சமர்ப்பிக்கவும்; மொழிபெயர்ப்பைத் திருத்தும் போது சேமிப்பதையும் தொடரவும் "
"இது செயல்படுகிறது."

msgid "Unmark translation as Needing edit and submit it."
msgstr "திருத்தி அதைத் திருத்தி சமர்ப்பிக்கவும்."

msgid ""
"Submit the string as a suggestion; this works the same as pressing Suggest "
"while editing translation."
msgstr ""
"சரத்தை ஒரு ஆலோசனையாக சமர்ப்பிக்கவும்; மொழிபெயர்ப்பைத் திருத்தும் போது இது "
"பரிந்துரைப்பதைப் போலவே செயல்படுகிறது."

msgid "Focus on translation editor."
msgstr "மொழிபெயர்ப்பு எடிட்டரில் கவனம் செலுத்துங்கள்."

msgid "Focus on comment editor."
msgstr "கருத்து எடிட்டரில் கவனம் செலுத்துங்கள்."

msgid "Shows Automatic suggestions tab."
msgstr "தானியங்கி பரிந்துரைகள் தாவலைக் காட்டுகிறது."

msgctxt "between keyboard shortcuts"
msgid "to"
msgstr "பெறுநர்"

msgid "Copies placeable of a given number from source string."
msgstr "மூல சரத்திலிருந்து கொடுக்கப்பட்ட எண்ணின் நகல்கள்."

msgid "followed by"
msgstr "அதைத் தொடர்ந்து"

msgid "Copy the machine translation of a given number to current translation."
msgstr ""
"கொடுக்கப்பட்ட எண்ணின் இயந்திர மொழிபெயர்ப்பைத் தற்போதைய மொழிபெயர்ப்புக்கு நகலெடுக்கவும்."

msgid "Ignore one item in the list of failing checks."
msgstr "தோல்வியுற்ற சோதனைகளின் பட்டியலில் ஒரு உருப்படியை புறக்கணிக்கவும்."

msgid "Shows the Nearby strings tab."
msgstr "அருகிலுள்ள சரங்கள் தாவலைக் காட்டுகிறது."

msgid "Focus on search field."
msgstr "தேடல் புலத்தில் கவனம் செலுத்துங்கள்."

msgid "Copy the source string."
