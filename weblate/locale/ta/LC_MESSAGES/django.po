msgstr "வலைபெயர்ப்பு உதவி"

msgid "Repository status"
msgstr "களஞ்சிய நிலை"

#, python-format
msgid "%(total_count)s pending unit"
msgid_plural "%(total_count)s pending units"
msgstr[0] "%(total_count)s நிலுவையில் உள்ள அலகு"
msgstr[1] "%(total_count)s நிலுவையில் உள்ள அலகுகள்"

#, python-format
msgid "%(policy_count)s skipped by the commit policy"
msgid_plural "%(policy_count)s skipped by the commit policy"
msgstr[0] "உறுதி கொள்கையால் %(policy_count)s தவிர்க்கப்பட்டது"
msgstr[1] "உறுதி கொள்கையால் %(policy_count)s தவிர்க்கப்பட்டன"

#, python-format
msgid "%(errors_count)s skipped because of errors"
msgid_plural "%(errors_count)s skipped because of errors"
msgstr[0] "பிழைகள் காரணமாக %(errors_count)s தவிர்க்கப்பட்டது"
msgstr[1] "பிழைகள் காரணமாக %(errors_count)s தவிர்க்கப்பட்டன"

msgid ""
"This will commit any pending changes present in Weblate and not in the "
"repository."
msgstr ""
"இது வலைபெயர்ப்புடில் நிலுவையில் உள்ள எந்த மாற்றங்களையும் வழங்கும், ஆனால் களஞ்சியத்தில் அல்ல."

#, python-format
msgid "%(count)s outgoing commit"
msgid_plural "%(count)s outgoing commits"
msgstr[0] "%(count)s வெளிச்செல்லும் உறுதிமொழி"
msgstr[1] "%(count)s வெளிச்செல்லும் உறுதிமொழிகள்"

#, python-format
msgid "(%(count)s missing in the push branch)"
msgid_plural "(%(count)s missing in the push branch)"
msgstr[0] "(தள்ளு கிளையில் %(count)s காணவில்லை)"
msgstr[1] "(தள்ளு கிளையில் %(count)s காணபடவில்லை)"

#, python-format
msgid "%(count)s missing commit"
msgid_plural "%(count)s missing commits"
msgstr[0] "%(count)s உறுதிமொழி காணவில்லை"
msgstr[1] "%(count)s காணாமல் போன உறுதிமொழிகள்"

msgid "This will update the Weblate repository with the upstream changes."
msgstr "இது மேலோடை மாற்றங்களுடன் வலைபெயர்ப்பு களஞ்சியத்தை புதுப்பிக்கும்."

msgid "Allow changes to the Weblate repository"
msgstr "வலைபெயர்ப்பு களஞ்சியத்தில் மாற்றங்களை அனுமதிக்கவும்"

msgid "Unlock"
msgstr "திறக்க"

msgid "Prevent any changes in the Weblate repository"
msgstr "வலைபெயர்ப்பு களஞ்சியத்தில் ஏதேனும் மாற்றங்களைத் தடுக்கவும்"

msgid "Lock"
msgstr "பூட்டு"

#, python-format
msgid "%(count)s component is locked"
msgid_plural "%(count)s components are locked"
msgstr[0] "%(count)s கூறு பூட்டப்பட்டுள்ளன"
msgstr[1] "%(count)s கூறுகள் பூட்டப்பட்டுள்ளன"

msgctxt "Joins a list of values"
msgid ", "
msgstr ", "

#, python-format
msgid "%(count)s component is unlocked"
msgid_plural "%(count)s components are unlocked"
msgstr[0] "%(count)s கூறு திறக்கப்பட்டுள்ளன"
msgstr[1] "%(count)s கூறுகள் திறக்கப்பட்டுள்ளன"

msgid "Weblate translations are unlocked"
msgstr "வலைபெயர்ப்பு மொழிபெயர்ப்புகள் திறக்கப்பட்டுள்ளன"

msgid "Weblate translations are locked"
msgstr "வலைபெயர்ப்பு மொழிபெயர்ப்புகள் பூட்டப்பட்டுள்ளன"

msgid "Locking prevents translators from doing changes."
msgstr "பூட்டுதல் மொழிபெயர்ப்பாளர்களை மாற்றங்களைச் செய்வதைத் தடுக்கிறது."

msgid "Reset and discard"
msgstr "மீட்டமைத்து நிராகரிக்கவும்"

msgid ""
"Resets Weblate’s repository to match upstream and discards any pending "
"changes in Weblate."
msgstr ""
"வெப்லேட்டின் களஞ்சியத்தை அப்ச்ட்ரீமில் பொருத்துவதற்கு மீட்டமைக்கிறது மற்றும் வெப்லேட்டில் "
"நிலுவையில் உள்ள மாற்றங்களை நிராகரிக்கிறது."

msgid "Use when you want the upstream to be the authority for translations."
msgstr ""
"மேலோடை மொழிபெயர்ப்பிற்கான அதிகாரமாக இருக்க வேண்டும் என நீங்கள் விரும்பும் போது "
"பயன்படுத்தவும்."

msgid ""
"It will discard changes in Weblate repo and bring it in sync with the "
"upstream repository."
msgstr ""
"இது வலைபெயர்ப்பு ரெப்போவில் மாற்றங்களை நிராகரித்து, அதை மேலோடை களஞ்சியத்துடன் "
"ஒத்திசைக்கும்."

msgid "Reset and reapply"
msgstr "மீட்டமைத்து மீண்டும் விண்ணப்பிக்கவும்"

#, fuzzy
#| msgid ""
#| "Resets Weblate’s repository to match upstream and replace upstream "
#| "translations with the current state from Weblate."
msgid ""
"Resets Weblate’s repository to match upstream and reapplies pending "
"translations onto the reset repository state."
msgstr ""
"வெப்லேட்டின் களஞ்சியத்தை அப்ச்ட்ரீமை பொருத்தவும், மேலோடை மொழிபெயர்ப்புகளை வெப்லேட்டிலிருந்து "
"தற்போதைய நிலையுடன் மாற்றவும்."

msgid "Use when you want Weblate to be the authority for translations."
msgstr ""
"மொழிபெயர்ப்புகளுக்கு வலைபெயர்ப்பு அதிகாரமாக இருக்க வேண்டும் என நீங்கள் விரும்பும் போது "
"பயன்படுத்தவும்."

msgid ""
"Missing language files must already exist upstream or Weblate must be able "
"to create them for the component."
msgstr ""

msgid "Cleanup"
msgstr "தூய்மை செய்"

msgid ""
"Cleanup removes all files which are not tracked by the version control from "
"the repository."
msgstr ""
"களஞ்சியத்திலிருந்து பதிப்பு கட்டுப்பாட்டால் கண்காணிக்கப்படாத அனைத்து கோப்புகளையும் "
"தூய்மைப்படுத்துகிறது."

msgid "It also removes stale branches which are not used by Weblate."
msgstr "இது வலைப்பெயர்ப்பு மூலம் பயன்படுத்தப்படாத பழைய கிளைகளையும் நீக்குகிறது."

msgid "Use when there is some garbage left in the Weblate repository."
msgstr "வலைபெயர்ப்பு களஞ்சியத்தில் சில குப்பைகள் இருக்கும்போது பயன்படுத்தவும்."

msgid "Synchronize"
msgstr "ஒத்திசைக்கவும்"

msgid "Forces writing all strings to the translation files."
msgstr "மொழிபெயர்ப்பு கோப்புகளுக்கு அனைத்து சரங்களையும் எழுதுகிறது."

msgid ""
"Use this when repository files became out of sync with Weblate for some "
"reason."
msgstr ""
"சில காரணங்களால் வலைபெயர்ப்புடுடன் களஞ்சியக் கோப்புகள் ஒத்திசைக்கப்படும்போது இதைப் "
"பயன்படுத்தவும்."

msgid "Rescan"
msgstr "ரெச்கான்"

msgid "Loads translations from the files into Weblate."
msgstr "கோப்புகளிலிருந்து மொழிபெயர்ப்புகளை வலைபெயர்ப்புடில் ஏற்றுகிறது."

msgid ""
"Use when Weblate missed some of the strings after updating the repository."
msgstr ""
"களஞ்சியத்தை புதுப்பித்த பிறகு வலைபெயர்ப்பு சில சரங்களை தவறவிட்டபோது பயன்படுத்தவும்."

msgid ""
"This might discard edits that cannot be committed because of the configured "
"commit policy."
msgstr ""
"கட்டமைக்கப்பட்ட உறுதிமொழிக் கொள்கையின் காரணமாகச் செய்ய முடியாத திருத்தங்களை இது "
"நிராகரிக்கக்கூடும்."

msgid "Use these operations with caution, they can lead to data loss."
msgstr ""
"இந்த செயல்பாடுகளை எச்சரிக்கையுடன் பயன்படுத்தவும், அவை தரவு இழப்புக்கு வழிவகுக்கும்."

