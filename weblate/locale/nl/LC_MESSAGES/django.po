msgid "Formality"
msgstr "Formaliteit"

msgid "Uses the specified formality if language is not specified as (in)formal"
msgstr ""
"Gebruik de opgegeven formaliteit als de taal niet is ingesteld als "
"(in)formeel"

msgctxt "Automatic suggestion service configuration"
msgid "Translation context"
msgstr "Context vertaling"

msgid ""
"Describe the context of the translation to improve the accuracy of the "
"translation."
msgstr ""
"Beschrijf de context van de vertaling om de nauwkeurigheid te verbeteren."

msgctxt "Automatic suggestion service configuration"
msgid "Use next-gen model"
msgstr "Next-gen-model gebruiken"

msgid "Prefer next-gen LLM over classic machine translation model."
msgstr ""
"Voorkeur voor next-gen LLM boven klassieke model voor machinevertaling."

msgid "DeepL API v1 is no longer supported."
msgstr "DeepL API v1 wordt niet langer ondersteund."

msgctxt "Automatic suggestion service configuration"
msgid "LLM model"
msgstr "LLM-model"

msgctxt "Automatic suggestion service configuration"
msgid "Translator persona"
msgstr "Vertalerprofiel"

msgid ""
"Describe the persona of translator to improve the accuracy of the "
"translation. For example: “You are a squirrel breeder.”"
msgstr ""
"Beschrijf het profiel van de vertaler om de juistheid te verbeteren. "
"Voorbeeld: “U broedt eieren.”"

msgctxt "Automatic suggestion service configuration"
msgid "Translator style"
msgstr "Vertaalstijl"

msgid ""
"Describe the style of translation. For example: “Use informal language.”"
msgstr ""
"Beschrijf de vertaalstijl. Voorbeeld: “Zorg voor informeel taalgebruik.”"

msgctxt "Automatic suggestion service configuration"
msgid "Language-specific instructions"
msgstr "Taalspecifieke instructies"

#, python-format
msgid ""
"JSON object mapping existing target language codes to extra instructions, up "
"to %(limit)d characters each."
msgstr ""
"JSON-object verbindt bestaande taalcodes aan extra instructies, tot maximaal "
"%(limit)d tekens elk."

msgid "Language-specific instructions must be a JSON object."
msgstr "Taalspecifieke instructies moeten een JSON-object zijn."

#, python-format
msgid "Language-specific instructions contain invalid language code \"%s\"."
msgstr "Taalspecifieke instructies bevatten ongeldige taalcode \"%s\"."

#, python-format
msgid "Language-specific instructions contain unknown language code \"%s\"."
msgstr "Taalspecifieke instructies bevatten onbekende taalcode \"%s\"."

#, python-format
msgid ""
"Language-specific instructions for \"%(language)s\" must be at most "
"%(limit)d characters."
msgstr ""
"Taalspecifieke instructies voor \"%(language)s\" mogen ten hoogste %(limit)d "
"tekens zijn."

