msgstr ""
"Alleen PEM-certificaatblokken plakken, elk beginnend met \"-----BEGIN "
"CERTIFICATE-----\" en eindigend met \"-----END CERTIFICATE-----\"."

msgid "Client private key (PEM)"
msgstr "Cliënt private sleutel (PEM)"

