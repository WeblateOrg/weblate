msgid ""
"A pull or merge request will be created from a branch in the repository."
msgstr "Запрос на извлечение или слияние будет создан из ветки в репозитории."

msgid ""
"A push URL is set but no push branch is given. Set a push branch that "
"differs from the translated branch."
msgstr ""
"URL-адрес отправки установлен, но ветка отправки не указана. Укажите ветку "
"отправки, отличную от переводимой ветки."

msgid ""
"The push branch must differ from the translated branch when creating a pull "
"or merge request."
msgstr ""
"Ветка отправки должна отличаться от переводимой ветки при создании запроса "
"на извлечение или слияние."

msgid "A pull or merge request will be created from a fork of the repository."
msgstr ""
"Запрос на извлечение или слияние будет создан из ответвления (форка) "
"репозитория."

#, javascript-format
msgid ""
"A pull or merge request will be created from the “%s” branch in the "
"repository."
msgstr ""
"Запрос на извлечение или слияние будет создан из ветки «%s» в репозитории."

#, javascript-format
msgid ""
"Changes will be sent as a Gerrit review request targeting the “%s” branch."
msgstr ""
"Изменения будут отправлены как запрос на рецензирование Gerrit, нацеленный "
"на ветку «%s»."

msgid "Changes will be sent as a Gerrit review request."
msgstr "Изменения будут отправлены как запрос на рецензирование Gerrit."

msgid ""
"Changes will not be pushed automatically. You can still push them manually "
"from the repository maintenance."
msgstr ""
"Изменения не будут отправляться автоматически. Вы всё ещё можете отправить "
"их вручную через обслуживание репозитория."

#, javascript-format
msgid ""
"Changes will be pushed directly to the “%s” branch in the push repository."
msgstr ""
"Изменения будут отправлены непосредственно в ветку «%s» в репозитории "
"отправки."

msgid ""
"Changes will be pushed directly to the default branch of the push repository."
msgstr ""
"Изменения будут отправлены непосредственно в ветку по умолчанию репозитория "
"отправки."

