msgstr "Просмотрщик репозитория"

msgid ""
"Link to repository browser, use {{branch}} for branch, {{filename}} and "
"{{line}} as filename and line placeholders. You might want to strip leading "
"directory by using {{filename|parentdir}}."
msgstr ""
"Ссылка на просмотрщик репозитория, вы можете использовать {{branch}}, "
"{{filename}} и {{line}} для подстановки ветки, имени файла и номера строки "
"соответственно. Возможно, вы захотите отделить ведущую директорию, используя "
"{{filename|parentdir}}."

msgid "Exported repository URL"
msgstr "URL экспортированного репозитория"

msgid "URL of repository where users can fetch changes from Weblate"
msgstr ""
"URL репозитория, где пользователи могут делать выборку изменений из Weblate"

