msgid "The filename contains a prohibited folder."
msgstr "Имя файла содержит запрещённую папку."

msgid "No archive can be specified in backup location."
msgstr "В расположении резервного копирования не может быть указан архив."

msgid "Backup location has to be an absolute path."
msgstr "Расположение резервной копии должно быть абсолютным путём."

