#, python-format
msgid "Could not fork repository at %(hostname)s: %(error)s"
msgstr "Не удалось создать форк репозитория на %(hostname)s: %(error)s"

#, python-format
msgid ""
"Could not fork repository at %(hostname)s: %(error)s Please retry later."
msgstr ""
"Не удалось создать форк репозитория на %(hostname)s: %(error)s. Пожалуйста, "
"повторите позже."

#, python-format
msgid ""
"Could not fork repository at %(hostname)s: Repository not found. Check "
