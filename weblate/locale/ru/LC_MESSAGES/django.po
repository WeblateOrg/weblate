msgstr "Имя содержит запрещённые символы."

msgid "The username can not start with a full stop."
msgstr "Имя пользователя не может начинаться с точки."

msgid "This username cannot be registered. Please choose a different one."
msgstr ""
"Это имя пользователя не может быть зарегистрировано. Пожалуйста, выберите "
"другое."

msgid "Enter a valid e-mail address."
msgstr "Введите действительный адрес эл. почты."

