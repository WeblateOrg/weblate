msgctxt "No known user"
msgid "None"
msgstr "Отсутствует"

msgid "User avatar"
msgstr "Аватар пользователя"

msgid ""
"This e-mail address is already in use. Please supply a different e-mail "
"address."
msgstr ""
"Этот адрес электронной почты уже используется. Пожалуйста, укажите другой "
"адрес электронной почты ."

msgid "This username is already taken. Please pick something else."
msgstr "Это имя пользователя уже занято. Пожалуйста, выберите другое."

msgid "Full name"
msgstr "Полное имя"

msgid "Name is also used in version control commits."
msgstr "Имя также используется в коммитах системы управления версиями."

msgid "Commit e-mail"
msgstr "Электронная почта коммита"

msgid "Use account e-mail address"
msgstr "Использовать адрес эл. почты учётной записи"

msgid ""
"Used in version-control commits. The address stays in the repository forever "
"once changes are committed by Weblate."
msgstr ""
"Используется при фиксации изменений в системе управления версиями. После "
"фиксации изменений Weblate адрес навсегда останется в репозитории."

msgid "Commit name"
msgstr "Название коммита"

msgid ""
"Used in version control commits. The name stays in the repository forever, "
"once changes are committed by Weblate."
msgstr ""
"Используется при фиксации изменений в системе управления версиями. После "
"фиксации изменений Weblate название навсегда останется в репозитории."

msgid "Public e-mail"
msgstr "Общедоступная электронная почта"

msgid "Hide e-mail address from public view"
msgstr "Скрыть адрес электронной почты от публичного просмотра"

#, python-format
msgid "Component list: %s"
msgstr "Список компонентов: %s"

msgid "Account e-mail"
msgstr "Электронная почта учётной записи"

msgid ""
"Used for e-mail notifications and as a commit e-mail if it is not configured "
"below."
msgstr ""
"Используется для уведомлений по электронной почте и в качестве сообщения о "
"коммите, если оно не настроено ниже."

msgid "Human verification"
msgstr "Проверка на человека"

#, python-format
msgctxt ""
"Question for a mathematics-based CAPTCHA, the %s is an arithmetic problem"
msgid "What is %s?"
msgstr "Сколько будет %s?"

#. Translators: Shown on wrong answer to the mathematics-based CAPTCHA
msgid "That was not correct, please try again."
msgstr "Неправильный ответ, попробуйте ещё раз."

msgid "Validation failed, please try again."
msgstr "Проверка не прошла, попробуйте ещё раз."

msgid "Subject"
msgstr "Тема"

msgid "Your name"
msgstr "Ваше имя"

msgid "Your e-mail"
msgstr "Ваша эл. почта"

msgid "Message"
msgstr "Сообщение"

msgid ""
"Please contact us in English. Otherwise, we might not process your request."
msgstr ""
"Пожалуйста, пишите нам на по-английски. В противном случае мы не сможем "
"обработать ваш запрос."

msgid "E-mail"
msgstr "Эл. почта"

msgid "An e-mail with a confirmation link will be sent here."
msgstr "Сюда будет отправлено электронное письмо со ссылкой для подтверждения."

msgid "New password"
msgstr "Новый пароль"

msgid "New password confirmation"
msgstr "Подтверждение нового пароля"

msgid "Regenerate API key"
msgstr "Создать заново ключ API"

msgid ""
"Leave enabled to revoke the current API key and generate a new one. This is "
"recommended if you suspect your password was compromised. Disable it to keep "
"your current API key active after changing your password."
msgstr ""
"Оставьте включённым, чтобы отозвать текущий ключ API и сгенерировать новый. "
"Это рекомендуется, если вы подозреваете, что ваш пароль был "
"скомпрометирован. Отключите, чтобы оставить текущий ключ API активным после "
"смены пароля."

msgid "Your password has been changed."
msgstr "Ваш пароль был изменён."

msgid "Current password"
msgstr "Текущий пароль"

msgid "Leave empty if you have not set a password yet."
msgstr "Оставьте пустым, если вы ещё не задали пароль."

msgid "You have entered an invalid password."
msgstr "Вы ввели неверный пароль."

msgid "Username or e-mail"
msgstr "Имя пользователя или эл. почта"

msgid "Password"
msgstr "Пароль"

msgid "Please enter the correct username and password."
msgstr "Введите правильное имя пользователя и пароль."

msgid "This account is inactive."
msgstr "Эта учётная запись неактивна."

msgid "Component wide notifications"
msgstr "Уведомления на уровне компонентов"

msgid "Translation notifications"
msgstr "Уведомления о переводах"

msgid "Use default setting"
msgstr "Использовать настройку по умолчанию"

msgid "Other projects"
msgstr "Другие проекты"

msgid "Watched projects"
msgstr "Отслеживаемые проекты"

msgid "Managed projects"
msgstr "Управляемые проекты"

msgid "Project: {}"
msgstr "Проект: {}"

msgid "Component: {}"
msgstr "Компонент: {}"

msgid ""
"You will receive a notification for every such event in non-watched projects."
msgstr ""
"Вы будете получать уведомление для каждого такого события в проектах, "
"которые вы не отслеживаете."

msgid ""
"You will receive a notification for every such event in your watched "
"projects."
msgstr ""
"Вы будете получать уведомление для каждого такого события в отслеживаемых "
"проектах."

msgid ""
"You will receive a notification for every such event in projects where you "
"have admin permissions."
msgstr ""
"Вы будете получать уведомление для каждого такого события в тех проектах, в "
"которых у вас есть права администратора."

#, python-format
msgid "You will receive a notification for every such event in %(project)s."
msgstr "Вы будете получать уведомление о каждом таком событии в %(project)s."

#, python-format
msgid "You will receive a notification for every such event in %(component)s."
msgstr ""
"Вы будете получать уведомление о каждом таком событии в %(component)s ."

msgid ""
"You will only receive these notifications for your translated languages in "
"non-watched projects."
msgstr ""
"Вы будете получать эти уведомления только для своих языков перевода в "
"проектах, которые вы не отслеживаете."

msgid ""
"You will only receive these notifications for your translated languages in "
"your watched projects."
msgstr ""
"Вы будете получать эти уведомления только для своих языков перевода в "
"отслеживаемых вами проектах."

msgid ""
"You will only receive these notifications for your translated languages in "
"projects where you have admin permissions."
msgstr ""
"Вы будете получать эти уведомления только для своих языков перевода в тех "
"проектах, в которых у вас есть права администратора."

#, python-format
msgid ""
"You will only receive these notifications for your translated languages in "
"%(project)s."
msgstr ""
"Вы будете получать эти уведомления только для переведённых вами языков в "
"%(project)s."

#, python-format
msgid ""
"You will only receive these notifications for your translated languages in "
"%(component)s."
msgstr ""
"Вы будете получать эти уведомления только для переведённых вами языков в "
"%(component)s."

msgid "Username"
msgstr "Имя пользователя"

msgid "Date joined"
msgstr "Дата присоединения"

msgid "Translations made"
msgstr "Сделанные переводы"

msgid "Suggestions made"
msgstr "Сделанные предложения"

msgid "Comments made"
msgstr "Оставлен комментарий"

msgid "Screenshots uploaded"
msgstr "Загруженные снимки экрана"

msgid "The chosen sorting is not supported."
msgstr "Выбранная сортировка не поддерживается."

msgid "Team"
msgstr "Команда"

msgid "Add to a team"
msgstr "Добавить в команду"

msgid "Name your authentication app"
msgstr "Название приложения для авторизации"

msgid "Verify the code from the app"
msgstr "Проверьте код из приложения"

msgid "Discard previously configured authentication apps"
msgstr "Отклонить ранее настроенные приложения для авторизации"

msgid ""
"All previously configured authentication apps will be discarded upon "
"verification of the new app."
msgstr ""
"Все ранее настроенные приложения авторизации будут отклонены после проверки "
"нового приложения."

msgid ""
"Other two-factor methods (such as WebAuthn and security keys) won't be "
"affected."
msgstr ""
"Другие двухфакторные методы (такие как WebAuthn и ключи безопасности) "
"затронуты не будут."

msgid "The entered token is not valid."
msgstr "Введённый токен недействителен."

msgid "Recovery token"
msgstr "Токен восстановления"

msgid ""
"Recovery codes can only be used once. Remember to mark used ones as expired."
msgstr ""
"Коды восстановления можно использовать только один раз. Не забудьте отметить "
"использованные коды как истёкшие."

msgid "Enter the code from the app"
msgstr "Введите код из приложения"

#. Translators: Audit log entry
msgid "Password changed."
msgstr "Пароль изменён."

#. Translators: Audit log entry
#, python-brace-format
msgid "Rate limit exceeded for {scope} at {path}."
msgstr "Превышен лимит запросов для {scope} по адресу {path}."

#. Translators: Audit log entry
#, python-brace-format
msgid "Username changed from {old} to {new}."
msgstr "Имя пользователя изменилось с {old} на {new}."

#. Translators: Audit log entry
#, python-brace-format
msgid "E-mail changed from {old} to {new}."
msgstr "Адрес эл. почты изменился с {old} на {new}."

#. Translators: Audit log entry
#, python-brace-format
msgid "Full name changed from {old} to {new}."
msgstr "Полное имя изменено с {old} на {new}."

#. Translators: Audit log entry
msgid "Password reset requested."
msgstr "Затребован сброс пароля."

#. Translators: Audit log entry
msgid "Password reset confirmed, password turned off."
msgstr "Сброс пароля подтверждён, пароль отключен."

#. Translators: Audit log entry
#, python-brace-format
msgid "Configured sign in using {method} ({name})."
msgstr "Настроен вход с использованием {method} ({name})."

#. Translators: Audit log entry
#, python-brace-format
msgid "Removed sign in using {method} ({name})."
msgstr "Вход с помощью {method} ({name}) удалён."

#. Translators: Audit log entry
#, python-brace-format
msgid "Signed in using {method} ({name})."
msgstr "Вход совершён с помощью {method} ({name})."

#. Translators: Audit log entry
#, python-brace-format
msgid "Signed in using {method} ({name}) from a new device."
msgstr "Вход совершён с помощью {method} ({name}) с нового устройства."

#. Translators: Audit log entry
msgid "Somebody attempted to register with your e-mail."
msgstr "Кто-то попытался зарегистрироваться с помощью вашей электронной почты."

msgid "Somebody attempted to register using your e-mail address."
msgstr ""
"Кто-то попытался зарегистрироваться, используя ваш адрес электронной почты ."

#. Translators: Audit log entry
#, python-brace-format
msgid "Could not sign in using {method} ({name})."
msgstr "Не удалось войти с помощью {method} ({name})."

#. Translators: Audit log entry
msgid "Account locked due to many failed sign in attempts."
msgstr "Учётная запись заблокирована из-за множества неудачных попыток входа."

#. Translators: Audit log entry
msgid "Account locked by the site administrator."
msgstr "Аккаунт заблокирован администратором сайта."

#. Translators: Audit log entry
msgid "Account and all private data removed."
msgstr "Учётная запись и все персональные данные удалены."

#. Translators: Audit log entry
#, python-brace-format
msgid "Account removal confirmation sent to {email}."
msgstr "Подтверждение удаления учётной записи отправлено на {email}."

#. Translators: Audit log entry
#, python-brace-format
msgid "Agreement with General Terms and Conditions {date}."
msgstr "Согласие с общими положениями и условиями {date}."

#. Translators: Audit log entry
#, python-brace-format
msgid "Invited to {site_title} by {username}."
msgstr "Приглашён в {site_title} пользователем {username}."

#. Translators: Audit log entry
#, python-brace-format
msgid "Accepted invitation from {username}."
msgstr "Принято приглашение от {username}."

#. Translators: Audit log entry
msgid "Started trial period."
msgstr "Начался пробный период."

#. Translators: Audit log entry
#, python-brace-format
msgid "Sent confirmation mail to {email}."
msgstr "Отправлено письмо с подтверждением на {email}."

msgid ""
"The system created a user to track authorship of translations uploaded by "
"other user."
msgstr ""
"Система создала пользователя для отслеживания авторства переводов, "
"загруженных другим пользователем."

msgid ""
"Account created externally from weblate.org for access to purchased services."
msgstr ""
"Учётная запись создана вне weblate.org для доступа к приобретённым услугам."

#. Translators: Audit log entry
#, python-brace-format
msgid "Access to project {project} was blocked."
msgstr "Доступ к проекту {project} был заблокирован."

#. Translators: Audit log entry
msgid "User was enabled by administrator."
msgstr "Пользователь был включён администратором."

#. Translators: Audit log entry
msgid "User was disabled by administrator."
msgstr "Пользователь был отключён администратором."

msgid "User was disabled because the access has expired."
msgstr "Пользователь отключен, ибо доступ истёк."

#, python-brace-format
msgid "User was added to the site-wide {team} team by {username}."
msgstr ""
"Пользователь был добавлен в общесайтовую команду {team} пользователем "
"{username}."

#, python-brace-format
msgid "User access to the site-wide {team} team was changed by {username}."
msgstr ""
"Доступ пользователя к общесайтовой команде {team} был изменён пользователем "
"{username}."

#, python-brace-format
msgid "User was removed from the site-wide {team} team by {username}."
msgstr ""
"Пользователь был удалён из общесайтовой команды {team} пользователем "
"{username}."

#. Translators: Audit log entry
msgid "Superuser privileges granted."
msgstr "Предоставлены права суперпользователя."

#. Translators: Audit log entry
msgid "Superuser privileges revoked."
msgstr "Права суперпользователя отозваны."

#. Translators: Audit log entry
msgid "Semiannual support status review was displayed."
msgstr "Был показан полугодовой обзор состояния поддержки."

#. Translators: Audit log entry
#, python-brace-format
msgid "User was added to the {team} team by {username}."
msgstr "Приглашён в {team} пользователем {username}."

#, python-brace-format
msgid "User access to the {team} team was changed by {username}."
msgstr ""
"Доступ пользователя к команде {team} был изменён пользователем {username}."

#. Translators: Audit log entry
#, python-brace-format
msgid "User was removed from the {team} team by {username}."
msgstr "Пользователь был удалён из {team} пользователем {username}."

#. Translators: Audit log entry
#, python-brace-format
msgid "Project token for {project} was created."
msgstr "Создан токен для проекта {project}."

#. Translators: Audit log entry
#, python-brace-format
msgid "Project token for {project} was removed."
msgstr "Токен проекта {project} был удалён."

msgid "Two-factor authentication recovery codes were generated"
msgstr "Коды восстановления двухфакторной авторизации сгенерированы"

msgid "Two-factor authentication recovery codes were viewed"
msgstr "Были просмотрены коды восстановления двухфакторной авторизации"

#. Translators: Audit log entry
#, python-brace-format
msgid "Two-factor authentication added: {device}"
msgstr "Двухфакторная авторизация добавлена: {device}"

#. Translators: Audit log entry
#, python-brace-format
msgid "Two-factor authentication removed: {device}"
msgstr "Двухфакторная авторизация удалена: {device}"

#. Translators: Audit log entry
#, python-brace-format
msgid "Two-factor authentication sign in using {device}"
msgstr "Для входа с двухфакторной авторизацией использован {device}"

#, python-brace-format
msgid "Two-factor authentication failed using {device_type}"
msgstr ""
"Не удалось выполнить двухфакторную аутентификацию с помощью {device_type}"

#. Translators: Audit log entry
msgid "Configured password to sign in."
msgstr "Настроил пароль для входа."

#. Translators: Audit log entry
msgid "Signed in using password."
msgstr "Вход с помощью пароля."

#. Translators: Audit log entry
msgid "Signed in using password from a new device."
msgstr "Вошёл, используя пароль с нового устройства."

#. Translators: Audit log entry
msgid "Could not sign in using password."
msgstr "Неудачная попытка входа с помощью пароля."

#. Translators: Audit log entry
#, python-brace-format
msgid "Invited to {project} by {username}."
msgstr "Приглашение в {project} пользователем {username}."

#. Translators: Audit log entry
msgid "Password configured."
msgstr "Пароль настроен."

msgid "To restore access to your account, please reset your password."
msgstr "Чтобы восстановить доступ к вашей учётной записи, сбросьте пароль."

msgid "Please contact project maintainers if you feel this is inappropriate."
msgstr ""
"Пожалуйста, свяжитесь с кураторами проекта, если вы считаете, что это "
"неуместно."

msgid "If it was you, reset your password to regain access to your account."
msgstr ""
"Если это были вы, сбросьте пароль для восстановления доступа к вашей учётной "
"записи."

