msgstr "Такой адрес эл. почты недопустим."

msgid "Invalid e-mail address: {}"
msgstr "Недействительный адрес эл. почты: {}"

msgid "Disposable e-mail domains are disallowed."
msgstr "Одноразовые домены электронной почты запрещены."

