msgstr ""
"Не удалось создать форк репозитория на %(hostname)s: Репозиторий не найден. "
"Проверьте, существует ли он и имеет ли пользователь '%(username)s' доступ к "
"нему."

#, python-format
msgid "Repository has an interrupted Git %(operation)s operation."
msgstr "В репозитории есть прерванная операция Git %(operation)s."

#, python-format
msgid "Could not recover interrupted Git %(operation)s operation."
msgstr "Не удалось восстановить прерванную операцию Git %(operation)s."

msgid "The repository URL permanently redirects to a canonical URL."
msgstr "URL репозитория постоянно перенаправляет на канонический URL."

msgid "The repository HTTP redirect contains credentials and was rejected."
msgstr ""
"HTTP-перенаправление репозитория содержит учётные данные и было отклонено."

msgid ""
"The repository URL redirects to a different host. Automatic cross-host "
"redirects are disabled for security; update the repository URL manually."
msgstr ""
"URL-адрес репозитория перенаправляет на другой хост. Автоматические "
"перенаправления между хостами отключены из соображений безопасности; "
"обновите URL репозитория вручную."

msgid ""
"The repository URL redirects from HTTPS to an insecure URL and was rejected."
msgstr ""
"URL-адрес репозитория перенаправляет с HTTPS на небезопасный URL и был "
"отклонён."

msgid "The repository returned an invalid HTTP redirect."
msgstr "Репозиторий вернул недействительное HTTP-перенаправление."

msgid "The repository returned an HTTP redirect with an invalid hostname."
msgstr ""
"Репозиторий вернул HTTP-перенаправление с недействительным именем хоста."

msgid "The repository HTTP redirect contains a loop."
msgstr "HTTP-перенаправление репозитория содержит цикл."

msgid "The repository redirect target has no validated address."
msgstr "Цель перенаправления репозитория не имеет проверенного адреса."

msgid "The repository returned a permanent HTTP redirect without a target URL."
msgstr "Репозиторий вернул постоянное HTTP-перенаправление без целевого URL."

msgid ""
"The repository HTTP redirect does not point to a Git smart HTTP endpoint."
msgstr ""
"HTTP-перенаправление репозитория не указывает на конечную точку Git smart "
"HTTP."

#, python-format
msgid "Could not probe the repository HTTP redirect: %(error)s"
msgstr "Не удалось проверить HTTP-перенаправление репозитория: %(error)s"

msgid "The repository HTTP redirect unexpectedly changed the URL query."
msgstr "HTTP-перенаправление репозитория неожиданно изменило запрос URL."

msgid "The repository HTTP redirect target could not be validated."
msgstr "Не удалось проверить цель HTTP-перенаправления репозитория."

msgid ""
"The repository HTTP redirect target could not be verified as a Git "
"repository."
msgstr ""
"Не удалось проверить цель HTTP-перенаправления репозитория как репозиторий "
"Git."

msgid "The repository returned too many HTTP redirects."
msgstr "Репозиторий вернул слишком много HTTP-перенаправлений."

msgid "The repository URL redirects to an unsupported URL scheme."
msgstr "URL репозитория перенаправляет на неподдерживаемую схему URL."

msgid ""
"Remote branch could not be verified against the shallow existing repository."
msgstr ""
"Не удалось проверить удалённую ветку в существующем неполном репозитории."

msgid ""
"Remote branch does not share common history with the existing repository."
msgstr "Удалённая ветка не имеет общей истории с существующим репозиторием."

msgid "Could not determine the effective SSH destination."
msgstr "Не удалось определить фактический SSH-адресат."

#, python-format
msgid "Could not determine the effective SSH destination: %(error)s"
msgstr "Не удалось определить фактический SSH-адресат: %(error)s"

#, python-format
msgid "Unsupported interrupted Git operation: %(operation)s"
msgstr "Неподдерживаемая прерванная операция Git: %(operation)s"

msgid ""
"This VCS backend cannot safely connect to this URL while private address "
"restrictions are enabled."
msgstr ""
"Этот серверный компонент СКВ не может безопасно подключиться к этому URL, "
"пока включены ограничения частных адресов."

#, python-format
