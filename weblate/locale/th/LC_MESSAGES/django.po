msgctxt "No known user"
msgid "None"
msgstr "ตกลง"

msgid "User avatar"
msgstr "รูปประจำตัวผู้ใช้"

msgid ""
"This e-mail address is already in use. Please supply a different e-mail "
"address."
msgstr "ที่อยู่อีเมลนี้ถูกใช้งานอยู่แล้ว โปรดระบุที่อยู่อีเมลอื่น"

msgid "This username is already taken. Please pick something else."
msgstr "ชื่อผู้ใช้นี้ถูกใช้ไปแล้ว โปรดเลือกชื่ออื่น"

msgid "Full name"
msgstr "ชื่อ-นามสกุล"

msgid "Name is also used in version control commits."
msgstr "ใช้ชื่อนี้ใน Commit ของระบบควบคุมเวอร์ชันด้วย"

msgid "Commit e-mail"
msgstr "อีเมลสำหรับ Commit"

msgid "Use account e-mail address"
msgstr "ใช้อีเมลของบัญชี"

msgid ""
"Used in version-control commits. The address stays in the repository forever "
"once changes are committed by Weblate."
msgstr ""
"ใช้ใน Commit ของระบบควบคุมเวอร์ชัน ที่อยู่นี้จะอยู่ในคลังโค้ด (Repository) ตลอดไปเมื่อ "
"Weblate ทำการ Commit การเปลี่ยนแปลง"

msgid "Commit name"
msgstr "ชื่อคอมมิต"

msgid ""
"Used in version control commits. The name stays in the repository forever, "
"once changes are committed by Weblate."
msgstr ""
"ใช้ในการคอมมิตการควบคุมเวอร์ชัน ชื่อนี้จะคงอยู่ในที่เก็บข้อมูลตลอดไป เมื่อ Weblate "
"คอมมิตการเปลี่ยนแปลงแล้ว"

msgid "Public e-mail"
msgstr "อีเมลสาธารณะ"

msgid "Hide e-mail address from public view"
msgstr "ซ่อนที่อยู่อีเมลไม่ให้บุคคลทั่วไปเห็น"

#, python-format
msgid "Component list: %s"
msgstr "รายการคอมโพเนนต์: %s"

msgid "Account e-mail"
msgstr "อีเมลของบัญชี"

msgid ""
"Used for e-mail notifications and as a commit e-mail if it is not configured "
"below."
msgstr "ใช้สำหรับการแจ้งเตือนทางอีเมลและใช้เป็นอีเมลสำหรับ Commit หากไม่ได้กำหนดไว้ด้านล่าง"

msgid "Human verification"
msgstr "การยืนยันความเป็นมนุษย์"

#, python-format
msgctxt ""
"Question for a mathematics-based CAPTCHA, the %s is an arithmetic problem"
msgid "What is %s?"
msgstr "%s คืออะไร"

#. Translators: Shown on wrong answer to the mathematics-based CAPTCHA
msgid "That was not correct, please try again."
msgstr "ไม่ถูกต้อง โปรดลองอีกครั้ง"

msgid "Validation failed, please try again."
msgstr "การตรวจสอบล้มเหลว โปรดลองอีกครั้ง"

msgid "Subject"
msgstr "หัวข้อ"

msgid "Your name"
msgstr "ชื่อของคุณ"

msgid "Your e-mail"
msgstr "อีเมลของคุณ"

msgid "Message"
msgstr "ข้อความ"

msgid ""
"Please contact us in English. Otherwise, we might not process your request."
msgstr "โปรดติดต่อเราเป็นภาษาอังกฤษ มิฉะนั้นเราอาจไม่สามารถดำเนินการตามคำขอของคุณได้"

msgid "E-mail"
msgstr "อีเมล"

msgid "An e-mail with a confirmation link will be sent here."
msgstr "อีเมลที่มีลิงก์ยืนยันจะถูกส่งไปยังที่นี่"

msgid "New password"
msgstr "รหัสผ่านใหม่"

msgid "New password confirmation"
msgstr "ยืนยันรหัสผ่านใหม่"

msgid "Regenerate API key"
msgstr "สร้างคีย์ API ใหม่"

msgid ""
"Leave enabled to revoke the current API key and generate a new one. This is "
"recommended if you suspect your password was compromised. Disable it to keep "
"your current API key active after changing your password."
msgstr ""
"เปิดใช้งานตัวเลือกนี้เพื่อยกเลิกคีย์ API ปัจจุบันและสร้างคีย์ใหม่ "
"แนะนำให้ทำเช่นนี้หากคุณสงสัยว่ารหัสผ่านของคุณถูกบุกรุก ปิดใช้งานตัวเลือกนี้เพื่อคงคีย์ API "
"ปัจจุบันของคุณให้ใช้งานได้หลังจากเปลี่ยนรหัสผ่าน"

msgid "Your password has been changed."
msgstr "รหัสผ่านของคุณถูกเปลี่ยนแล้ว"

msgid "Current password"
msgstr "รหัสผ่านปัจจุบัน"

msgid "Leave empty if you have not set a password yet."
msgstr "เว้นว่างไว้หากคุณยังไม่ได้ตั้งรหัสผ่าน"

msgid "You have entered an invalid password."
msgstr "คุณป้อนรหัสผ่านไม่ถูกต้อง"

msgid "Username or e-mail"
msgstr "ชื่อผู้ใช้หรืออีเมล"

msgid "Password"
msgstr "รหัสผ่าน"

msgid "Please enter the correct username and password."
msgstr "โปรดป้อนชื่อผู้ใช้และรหัสผ่านที่ถูกต้อง"

msgid "This account is inactive."
msgstr "บัญชีนี้ไม่ได้ใช้งานแล้ว"

msgid "Component wide notifications"
msgstr "การแจ้งเตือนระดับคอมโพเนนต์"

msgid "Translation notifications"
msgstr "แจ้งเตือนการแปล"

msgid "Use default setting"
msgstr "ใช้ตั้งค่าเริ่มต้น"

msgid "Other projects"
msgstr "โครงการอื่น ๆ"

msgid "Watched projects"
msgstr "โครงการที่ติดตาม"

msgid "Managed projects"
msgstr "โครงการที่ดูแล"

msgid "Project: {}"
msgstr "โครงการ: {}"

msgid "Component: {}"
msgstr "คอมโพเนนต์: {}"

msgid ""
"You will receive a notification for every such event in non-watched projects."
msgstr "คุณจะได้รับการแจ้งเตือนสำหรับทุกเหตุการณ์ในโครงการที่ไม่ได้ติดตาม"

msgid ""
"You will receive a notification for every such event in your watched "
"projects."
msgstr "คุณจะได้รับการแจ้งเตือนสำหรับทุกเหตุการณ์ในโครงการที่คุณติดตาม"

msgid ""
"You will receive a notification for every such event in projects where you "
"have admin permissions."
msgstr "คุณจะได้รับการแจ้งเตือนสำหรับทุกเหตุการณ์ในโครงการที่คุณมีสิทธิ์ของผู้ดูแล"

#, python-format
msgid "You will receive a notification for every such event in %(project)s."
msgstr "คุณจะได้รับการแจ้งเตือนสำหรับทุกเหตุการณ์ใน %(project)s"

#, python-format
msgid "You will receive a notification for every such event in %(component)s."
msgstr "คุณจะได้รับการแจ้งเตือนสำหรับทุกเหตุการณ์ใน %(component)s"

msgid ""
"You will only receive these notifications for your translated languages in "
"non-watched projects."
msgstr "คุณจะได้รับเฉพาะการแจ้งเตือนเกี่ยวกับภาษาที่คุณแปลในโครงการที่ไม่ได้ติดตาม"

msgid ""
"You will only receive these notifications for your translated languages in "
"your watched projects."
msgstr "คุณจะได้รับเฉพาะการแจ้งเตือนเกี่ยวกับภาษาที่คุณแปลในโครงการที่คุณติดตาม"

msgid ""
"You will only receive these notifications for your translated languages in "
"projects where you have admin permissions."
msgstr "คุณจะได้รับเฉพาะการแจ้งเตือนเกี่ยวกับภาษาที่คุณแปลในโครงการที่คุณมีสิทธิ์ของผู้ดูแล"

#, python-format
msgid ""
"You will only receive these notifications for your translated languages in "
"%(project)s."
msgstr "คุณจะได้รับเฉพาะการแจ้งเตือนเกี่ยวกับภาษาที่คุณแปลใน %(project)s"

#, python-format
msgid ""
"You will only receive these notifications for your translated languages in "
"%(component)s."
msgstr "คุณจะได้รับเฉพาะการแจ้งเตือนเกี่ยวกับภาษาที่คุณแปลใน %(component)s"

msgid "Username"
msgstr "ชื่อผู้ใช้"

msgid "Date joined"
msgstr "วันที่เข้าร่วม"

msgid "Translations made"
msgstr "คำแปลที่สร้าง"

msgid "Suggestions made"
msgstr "คำแนะนำที่เสนอ"

msgid "Comments made"
msgstr "ความคิดเห็นที่แสดง"

msgid "Screenshots uploaded"
msgstr "อัปโหลดภาพหน้าจอแล้ว"

msgid "The chosen sorting is not supported."
msgstr "ระบบไม่รองรับการเรียงลำดับที่เลือกไว้"

msgid "Team"
msgstr "ทีม"

msgid "Add to a team"
msgstr "เพิ่มเข้าสู่ทีม"

msgid "Name your authentication app"
msgstr "ตั้งชื่อแอปตรวจสอบสิทธิ์ของคุณ"

msgid "Verify the code from the app"
msgstr "ตรวจสอบรหัสจากแอป"

msgid "Discard previously configured authentication apps"
msgstr "ยกเลิกแอปการตรวจสอบสิทธิ์ที่กำหนดค่าไว้ก่อนหน้านี้"

msgid ""
"All previously configured authentication apps will be discarded upon "
"verification of the new app."
msgstr "แอปตรวจสอบสิทธิ์ที่ตั้งค่าไว้ก่อนหน้านี้ทั้งหมดจะถูกยกเลิกหลังจากตรวจสอบแอปใหม่เสร็จสิ้น"

msgid ""
"Other two-factor methods (such as WebAuthn and security keys) won't be "
"affected."
msgstr ""
"วิธีตรวจสอบสิทธิ์แบบสองปัจจัยอื่น ๆ (เช่น WebAuthn และคีย์ความปลอดภัย) จะไม่ได้รับผลกระทบ"

msgid "The entered token is not valid."
msgstr "โทเค็นที่ป้อนไม่ถูกต้อง"

msgid "Recovery token"
msgstr "โทเค็นกู้คืน"

msgid ""
"Recovery codes can only be used once. Remember to mark used ones as expired."
msgstr "รหัสกู้คืนใช้ได้เพียงครั้งเดียว อย่าลืมทำเครื่องหมายรหัสที่ใช้แล้วว่าหมดอายุ"

msgid "Enter the code from the app"
msgstr "ป้อนรหัสจากแอป"

#. Translators: Audit log entry
msgid "Password changed."
msgstr "เปลี่ยนรหัสผ่านแล้ว"

#. Translators: Audit log entry
#, fuzzy, python-brace-format
msgid "Rate limit exceeded for {scope} at {path}."
msgstr "เกินขีดจำกัดอัตราสำหรับ {scope} ที่ {path}."

#. Translators: Audit log entry
#, python-brace-format
msgid "Username changed from {old} to {new}."
msgstr "เปลี่ยนชื่อผู้ใช้จาก {old} เป็น {new}"

#. Translators: Audit log entry
#, python-brace-format
msgid "E-mail changed from {old} to {new}."
msgstr "เปลี่ยนอีเมลจาก {old} เป็น {new}"

#. Translators: Audit log entry
#, python-brace-format
msgid "Full name changed from {old} to {new}."
msgstr "เปลี่ยนชื่อ-นามสกุลจาก {old} เป็น {new}"

#. Translators: Audit log entry
msgid "Password reset requested."
msgstr "ส่งคำขอรีเซ็ตรหัสผ่านแล้ว"

#. Translators: Audit log entry
msgid "Password reset confirmed, password turned off."
msgstr "ยืนยันการรีเซ็ตรหัสผ่านแล้ว ปิดการใช้งานรหัสผ่าน"

#. Translators: Audit log entry
#, python-brace-format
msgid "Configured sign in using {method} ({name})."
msgstr "กำหนดค่าการเข้าสู่ระบบโดยใช้ {method} ({name}) แล้ว"

#. Translators: Audit log entry
#, python-brace-format
msgid "Removed sign in using {method} ({name})."
msgstr "ลบการเข้าสู่ระบบโดยใช้ {method} ({name}) แล้ว"

#. Translators: Audit log entry
#, python-brace-format
msgid "Signed in using {method} ({name})."
msgstr "เข้าสู่ระบบโดยใช้ {method} ({name})"

#. Translators: Audit log entry
#, python-brace-format
msgid "Signed in using {method} ({name}) from a new device."
msgstr "เข้าสู่ระบบโดยใช้ {method} ({name}) จากอุปกรณ์ใหม่"

#. Translators: Audit log entry
msgid "Somebody attempted to register with your e-mail."
msgstr "มีผู้อื่นพยายามลงทะเบียนด้วยอีเมลของคุณ"

msgid "Somebody attempted to register using your e-mail address."
msgstr "มีผู้อื่นพยายามลงทะเบียนโดยใช้อีเมลของคุณ"

#. Translators: Audit log entry
#, python-brace-format
msgid "Could not sign in using {method} ({name})."
msgstr "ไม่สามารถเข้าสู่ระบบโดยใช้ {method} ({name})"

#. Translators: Audit log entry
msgid "Account locked due to many failed sign in attempts."
msgstr "บัญชีถูกล็อกเนื่องจากพยายามเข้าสู่ระบบไม่สำเร็จหลายครั้ง"

#. Translators: Audit log entry
msgid "Account locked by the site administrator."
msgstr "บัญชีถูกล็อกโดยผู้ดูแลระบบของไซต์"

#. Translators: Audit log entry
msgid "Account and all private data removed."
msgstr "ลบบัญชีและข้อมูลส่วนตัวทั้งหมดแล้ว"

#. Translators: Audit log entry
#, python-brace-format
msgid "Account removal confirmation sent to {email}."
msgstr "ส่งการยืนยันการลบบัญชีไปยัง {email} แล้ว"

#. Translators: Audit log entry
#, python-brace-format
msgid "Agreement with General Terms and Conditions {date}."
msgstr "ข้อตกลงเกี่ยวกับเงื่อนไขและข้อกำหนดทั่วไป {date}"

#. Translators: Audit log entry
#, python-brace-format
msgid "Invited to {site_title} by {username}."
msgstr "ได้รับเชิญเข้าร่วม {site_title} โดย {username}"

#. Translators: Audit log entry
#, python-brace-format
msgid "Accepted invitation from {username}."
msgstr "ตอบรับคำเชิญจาก {username} แล้ว"

#. Translators: Audit log entry
msgid "Started trial period."
msgstr "เริ่มช่วงทดลองใช้งานแล้ว"

#. Translators: Audit log entry
#, python-brace-format
msgid "Sent confirmation mail to {email}."
msgstr "ส่งเมลยืนยันไปยัง {email} แล้ว"

msgid ""
"The system created a user to track authorship of translations uploaded by "
"other user."
msgstr "ระบบสร้างผู้ใช้เพื่อติดตามความเป็นเจ้าของคำแปลที่อัปโหลดโดยผู้ใช้อื่น"

msgid ""
"Account created externally from weblate.org for access to purchased services."
msgstr ""
"บัญชีนี้ถูกสร้างขึ้นจากภายนอก weblate.org เพื่อเข้าถึงบริการที่สั่งซื้อไว้."

#. Translators: Audit log entry
#, python-brace-format
msgid "Access to project {project} was blocked."
msgstr "การเข้าถึงโครงการ {project} ถูกบล็อก"

#. Translators: Audit log entry
msgid "User was enabled by administrator."
msgstr "ผู้ใช้ถูกเปิดใช้งานโดยผู้ดูแลระบบ"

#. Translators: Audit log entry
msgid "User was disabled by administrator."
msgstr "ผู้ใช้ถูกปิดใช้งานโดยผู้ดูแลระบบ"

msgid "User was disabled because the access has expired."
msgstr "ผู้ใช้ถูกปิดใช้งานเนื่องจากการเข้าถึงหมดอายุ"

#, python-brace-format
msgid "User was added to the site-wide {team} team by {username}."
msgstr "เพิ่มผู้ใช้ลงในทีม {team} โดย {username}"

#, fuzzy, python-brace-format
#| msgid "User was added to the {team} team by {username}."
msgid "User access to the site-wide {team} team was changed by {username}."
msgstr "การเข้าถึงของผู้ใช้สำหรับทีม {team} ถูกเปลี่ยนโดย {username}."

#, python-brace-format
msgid "User was removed from the site-wide {team} team by {username}."
msgstr "ผู้ใช้ถูกลบออกจากทีม {team} โดย {username}"

#. Translators: Audit log entry
msgid "Superuser privileges granted."
msgstr "ได้รับอนุญาตให้ใช้สิทธิ์ระดับผู้ใช้ขั้นสูงสุดแล้ว"

#. Translators: Audit log entry
msgid "Superuser privileges revoked."
msgstr "สิทธิ์ผู้ใช้ระดับสูงสุดถูกเพิกถอนแล้ว"

#. Translators: Audit log entry
msgid "Semiannual support status review was displayed."
msgstr "แสดงการตรวจสอบสถานะการสนับสนุนรายครึ่งปีแล้ว"

#. Translators: Audit log entry
#, python-brace-format
msgid "User was added to the {team} team by {username}."
msgstr "เพิ่มผู้ใช้ลงในทีม {team} โดย {username}"

#, fuzzy, python-brace-format
#| msgid "User was added to the {team} team by {username}."
msgid "User access to the {team} team was changed by {username}."
msgstr "ผู้ใช้ได้รับการเข้าถึงกับทีม {team} ถูกเปลี่ยนโดย {username}"

#. Translators: Audit log entry
#, python-brace-format
msgid "User was removed from the {team} team by {username}."
msgstr "ลบผู้ใช้ออกจากทีม {team} โดย {username}"

#. Translators: Audit log entry
#, python-brace-format
msgid "Project token for {project} was created."
msgstr "สร้างโปรเจกต์โทเค็นสำหรับ {project} เรียบร้อยแล้ว."

#. Translators: Audit log entry
