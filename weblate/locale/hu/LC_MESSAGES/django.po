msgctxt "No known user"
msgid "None"
msgstr "Nincs"

msgid "User avatar"
msgstr "Felhasználó profilképe"

msgid ""
"This e-mail address is already in use. Please supply a different e-mail "
"address."
msgstr ""
"Ez az e-mail-cím már használatban van. Adjon meg egy másik e-mail-címet."

