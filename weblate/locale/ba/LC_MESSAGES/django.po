msgctxt "No known user"
msgid "None"
msgstr "Билдәһеҙ"

msgid "User avatar"
msgstr "Ҡулланыусы аватары"

msgid ""
"This e-mail address is already in use. Please supply a different e-mail "
"address."
msgstr ""
"Был e-mail адрес ҡулланыла инде. Зинһар, икенсе e-mail адрес күрһәтегеҙ."

