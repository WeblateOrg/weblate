msgid "You will receive a notification for every such event in %(component)s."
msgstr ""
"Һеҙ %(component)s компонентындағы һәр ошондай ваҡиға тураһында хәбәр "
"аласаҡһығыҙ."

msgid ""
"You will only receive these notifications for your translated languages in "
"non-watched projects."
msgstr ""
"Был хәбәрҙәрҙе һеҙ күҙәтелмәгән проекттарҙа үҙегеҙ тәржемә иткән телдәр өсөн "
"генә аласаҡһығыҙ."

msgid ""
"You will only receive these notifications for your translated languages in "
"your watched projects."
msgstr ""
"Был хәбәрҙәрҙе һеҙ күҙәтелгән проекттарҙа үҙегеҙ тәржемә иткән телдәр өсөн "
"генә аласаҡһығыҙ."

msgid ""
"You will only receive these notifications for your translated languages in "
"projects where you have admin permissions."
msgstr ""
"Был хәбәрҙәрҙе һеҙ администратор хоҡуғығыҙ булған проекттарҙа үҙегеҙ тәржемә "
"иткән телдәр өсөн генә аласаҡһығыҙ."

#, python-format
msgid ""
"You will only receive these notifications for your translated languages in "
"%(project)s."
msgstr ""
"Был хәбәрҙәрҙе һеҙ %(project)s проектында үҙегеҙ тәржемә иткән телдәр өсөн "
"генә аласаҡһығыҙ."

#, python-format
msgid ""
"You will only receive these notifications for your translated languages in "
"%(component)s."
msgstr ""
"Был хәбәрҙәрҙе һеҙ %(component)s компонентында үҙегеҙ тәржемә иткән телдәр "
"өсөн генә аласаҡһығыҙ."

