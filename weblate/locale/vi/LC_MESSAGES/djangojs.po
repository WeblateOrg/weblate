msgid ""
"A pull or merge request will be created from a branch in the repository."
msgstr ""
"Một yêu cầu kéo hoặc hợp nhất sẽ được tạo từ một nhánh trong kho lưu trữ."

msgid ""
"A push URL is set but no push branch is given. Set a push branch that "
"differs from the translated branch."
msgstr ""
"Một URL đẩy được đặt nhưng không có nhánh đẩy nào được đưa ra. Đặt một nhánh "
"đẩy khác với nhánh đã dịch."

msgid ""
"The push branch must differ from the translated branch when creating a pull "
"or merge request."
msgstr ""
"Nhánh đẩy phải khác với nhánh đã dịch khi tạo yêu cầu kéo hoặc hợp nhất."

msgid "A pull or merge request will be created from a fork of the repository."
msgstr ""
"Một yêu cầu kéo hoặc hợp nhất sẽ được tạo từ một nhánh của kho lưu trữ."

#, javascript-format
msgid ""
"A pull or merge request will be created from the “%s” branch in the "
"repository."
msgstr ""
"Một yêu cầu kéo hoặc hợp nhất sẽ được tạo từ nhánh “%s” trong kho lưu trữ."

#, javascript-format
msgid ""
"Changes will be sent as a Gerrit review request targeting the “%s” branch."
msgstr ""
"Các thay đổi sẽ được gửi dưới dạng yêu cầu xem xét Gerrit nhắm mục tiêu vào "
"nhánh “%s”."

msgid "Changes will be sent as a Gerrit review request."
msgstr "Các thay đổi sẽ được gửi dưới dạng yêu cầu xem xét Gerrit."

msgid ""
"Changes will not be pushed automatically. You can still push them manually "
"from the repository maintenance."
msgstr ""
"Các thay đổi sẽ không được tự động đẩy lên. Bạn vẫn có thể đẩy chúng thủ "
"công từ phần bảo trì kho lưu trữ."

#, javascript-format
msgid ""
"Changes will be pushed directly to the “%s” branch in the push repository."
msgstr ""
"Các thay đổi sẽ được đẩy trực tiếp lên nhánh “%s” trong kho lưu trữ đẩy."

msgid ""
"Changes will be pushed directly to the default branch of the push repository."
msgstr ""
"Các thay đổi sẽ được đẩy trực tiếp lên nhánh mặc định của kho lưu trữ đẩy."

msgid "Text copied to clipboard."
msgstr "Đã sao chép văn bản vào bảng tạm."

msgid "Error copying to clipboard."
msgstr "Lỗi sao chép vào bảng tạm."

msgid "Some source strings could not be assigned."
msgstr "Một số chuỗi nguồn không thể được gán."

msgid "Error loading search results!"
msgstr "Lỗi khi tải kết quả tìm kiếm!"

msgid "No new matching source strings found."
msgstr "Không tìm thấy chuỗi nguồn mới phù hợp."

msgid "Sort this column"
msgstr "Sắp xếp cột này"

msgid "Error while loading page:"
msgstr "Lỗi khi tải trang:"

msgid "Please press Ctrl+C to copy."
msgstr "Vui lòng nhấn Ctrl+C để sao chép."

msgid "Search…"
msgstr "Tìm kiếm…"

msgid "Loading…"
msgstr "Đang tải…"

msgid "Error while loading form:"
msgstr "Lỗi khi tải biểu mẫu:"

msgid "Weblate is now scanning the repository, please be patient."
msgstr "Weblate bây giờ đang quét kho, vui lòng kiên nhẫn."

msgid ""
"Notification settings removed, please do not forget to save the changes."
msgstr "Cài đặt thông báo đã bị xóa, vui lòng đừng quên lưu lại thay đổi."

msgctxt "Alert to user when opening browser developer console"
msgid "Stop!"
msgstr "Dừng!"

msgid ""
"This is a browser feature intended for developers. If someone told you to "
"copy-paste something here, they are likely trying to compromise your Weblate "
"account."
msgstr ""
"Đây là một tính năng trình duyệt dành cho nhà phát triển. Nếu ai đó kêu bạn "
"sao chép-dán thứ gì đó ở đây, có thể họ đang cố gắng xâm phạm tài khoản "
"Weblate của bạn."

msgid "See https://en.wikipedia.org/wiki/Self-XSS for more information."
msgstr "Xem https://en.wikipedia.org/wiki/Self-XSS để biết thêm chi tiết."

msgid "just now"
msgstr "vừa mới bây giờ"

