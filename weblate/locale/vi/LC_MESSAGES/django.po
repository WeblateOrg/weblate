msgstr "Người dùng cần chặn"

msgid "Block expiry"
msgstr "Chặn hết hạn"

msgid "Block note"
msgstr "Ghi chú chặn"

msgid ""
"Internal notes regarding blocking the user that are not visible to the user."
msgstr ""
"Các ghi chú nội bộ liên quan đến việc chặn người dùng mà người dùng không "
"thể nhìn thấy."

msgid "User to add"
msgstr "Người dùng cần thêm"

msgid "Please type in an existing Weblate account name or e-mail address."
msgstr "Vui lòng nhập tên tài khoản Weblate hoặc địa chỉ email hiện có."

msgid "Suggest username for the user. It can be changed later."
msgstr "Đề xuất tên người dùng. Tên này có thể được thay đổi sau."

msgid "Suggest full name for the user. It can be changed later."
msgstr "Đề xuất tên đầy đủ của người dùng. Tên này có thể thay đổi sau."

msgid "You do not have permission to edit glossary entries."
msgstr "Bạn không có quyền chỉnh sửa các mục trong bảng thuật ngữ."

msgid "You do not have permission to add glossary entries."
msgstr "Bạn không có quyền thêm mục từ điển thuật ngữ."

msgid "You do not have permission to delete glossary entries."
msgstr "Bạn không có quyền xóa các mục trong từ điển thuật ngữ."

msgid "You do not have permission to upload glossary entries."
msgstr "Bạn không có quyền tải lên các mục trong bảng thuật ngữ."

msgid ""
"Only privileged users can edit strings directly in this language because of "
"its translation workflow. Add a suggestion instead."
msgstr ""
"Chỉ những người dùng có đặc quyền mới có thể chỉnh sửa chuỗi trực tiếp trong "
"ngôn ngữ này do quy trình dịch thuật của nó. Thay vào đó, hãy thêm một đề "
"xuất."

msgid ""
"Only privileged users can edit strings directly in this language because of "
"its translation workflow. Ask a project administrator for access."
msgstr ""
"Chỉ người dùng có đặc quyền mới có thể chỉnh sửa chuỗi trực tiếp bằng ngôn "
"ngữ này do quy trình dịch thuật của nó. Hãy yêu cầu quản trị viên dự án cấp "
"quyền truy cập."

msgid "Can not perform this operation without an e-mail address."
msgstr "Không thể thực hiện thao tác này mà không có địa chỉ email."

msgid ""
"This project requires two-factor authentication; configure it in your "
"profile."
msgstr ""
"Dự án này yêu cầu xác thực hai yếu tố; định cấu hình trong hồ sơ của bạn."

msgid "This translation is currently locked."
msgstr "Bản dịch này hiện đang bị khóa."

msgid ""
"Contributing to this translation requires agreeing to its contributor "
"license agreement."
msgstr ""
"Đóng góp cho bản dịch này đòi hỏi phải đồng ý với thỏa thuận cấp phép cộng "
"tác viên của nó."

msgid "Sign in to save translations."
msgstr "Đăng nhập để lưu bản dịch."

msgid ""
"You do not have permission to approve translations in this restricted "
"component."
msgstr "Bạn không có quyền phê duyệt bản dịch trong khu vực bị hạn chế này."

msgid ""
"You do not have permission to save translations in this restricted component."
msgstr "Bạn không có quyền lưu bản dịch trong thành phần bị hạn chế này."

msgid "You do not have permission to approve translations."
msgstr "Bạn không có quyền phê duyệt bản dịch."

msgid "You do not have permission to save translations in this project."
msgstr "Bạn không có quyền lưu bản dịch trong dự án này."

msgid "You do not have permission to edit source strings."
msgstr "Bạn không có quyền chỉnh sửa chuỗi nguồn."

msgid "Suggestion voting is disabled."
msgstr "Tính năng bỏ phiếu đề xuất đã bị vô hiệu hóa."

msgid ""
"This translation is configured for suggestion voting. Add a suggestion "
"instead of saving a direct translation."
msgstr ""
"Bản dịch này được cấu hình để bình chọn đề xuất. Hãy thêm đề xuất thay vì "
"lưu bản dịch trực tiếp."

msgid "Pay the bills to unlock this project."
msgstr "Thanh toán hóa đơn để mở khóa dự án này."

msgid "The translation is read-only."
msgstr "Bản dịch chỉ có thể đọc."

msgid "Source-string reviews are turned off."
msgstr "Đánh giá chuỗi nguồn đã bị tắt."

msgid "Translation reviews are turned off."
msgstr "Đánh giá bản dịch đã bị tắt."

msgid "Reviewing is turned off."
msgstr "Đã tắt đánh giá."

msgid "The source string needs review."
msgstr "Chuỗi nguồn cần được đánh giá."

msgid "The string is read-only."
msgstr "Chuỗi này chỉ có thể đọc."

msgid ""
"Only reviewers can change approved strings. Please add a suggestion if you "
"think the string should be changed."
msgstr ""
"Chỉ đánh giá viên mới có quyền thay đổi chuỗi đã được phê duyệt. Vui lòng "
"thêm đề xuất nếu bạn nghĩ chuỗi cần thay đổi."

msgid "Add the string to the source language instead."
msgstr "Thay vào đó, thêm chuỗi vào ngôn ngữ nguồn."

msgid "Adding strings is disabled in the component configuration."
msgstr "Tính năng thêm chuỗi bị vô hiệu hóa trong cấu hình thành phần."

msgid ""
"Cannot remove terminology translation. Remove the source string instead."
msgstr ""
"Không thể loại bỏ bản dịch thuật ngữ. Thay vào đó, hãy loại bỏ chuỗi nguồn."

msgid "The file format does not support this."
msgstr "Định dạng tập tin không hỗ trợ điều này."

msgid "Adding new translations is turned off in the component configuration."
msgstr "Tính năng thêm bản dịch mới bị tắt trong cấu hình thành phần."

msgid "This component is currently locked."
msgstr "Thành phần này hiện đang bị khóa."

msgid ""
"Suggestions are turned off for this language. Ask a project administrator to "
"enable them."
msgstr ""
"Các gợi ý cho ngôn ngữ này đều bị tắt. Hãy yêu cầu quản trị viên dự án kích "
"hoạt chúng."

msgid "The file format does not support updating source strings."
msgstr "Định dạng tệp không hỗ trợ cập nhật chuỗi nguồn."

msgid ""
"Create the component and grant yourself explicit access before enabling "
"restricted access."
msgstr ""
"Tạo thành phần đó và cấp cho mình quyền truy cập rõ ràng trước khi bật quyền "
"truy cập hạn chế."

msgid "The billing plan does not allow private access control."
msgstr "Gói cước này không cho phép kiểm soát truy cập riêng tư."

msgid ""
"You need explicit access to this component before enabling restricted "
"access; otherwise, you would lock yourself out."
msgstr ""
"Bạn cần có quyền truy cập rõ ràng vào thành phần này trước khi bật chế độ "
"truy cập hạn chế; nếu không, bạn sẽ tự khóa mình khỏi hệ thống."

msgid "The anonymous user can not be assigned to teams."
msgstr "Người dùng ẩn danh không thể được chỉ định vào các nhóm."

msgid "Inactive users can not be assigned to teams."
msgstr "Người dùng không hoạt động không thể được chỉ định vào nhóm."

msgid "Project tokens can not be assigned to teams here."
msgstr "Không thể gán mã thông báo dự án cho các nhóm tại đây."

msgid "Cannot remove built-in team!"
msgstr "Không thể xóa nhóm đã tích hợp sẵn!"

msgid "User invitation was removed."
msgstr "Lời mời của người dùng đã bị xóa."

