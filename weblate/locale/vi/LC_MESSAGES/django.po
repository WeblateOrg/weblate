msgstr "Không nhận được địa chỉ e-mail nào từ dịch vụ xác thực của bên thứ ba."

msgid "Please register using e-mail instead."
msgstr "Thay vào đó hãy đăng ký bằng e-mail."

msgid "Could not parse RelayState from SAML Identity Provider."
msgstr "Không thể phân tích RelayState từ Nhà Cung Cấp Danh Tính SAML."

msgid "New registrations are turned off."
msgstr "Các lượt đăng ký mới đã bị tắt."

msgid ""
"Could not authenticate, probably due to an expired token or connection error."
msgstr ""
"Không thể xác thực, có thể là do mã thông báo đã hết hạn hoặc lỗi kết nối."

msgid "Authentication cancelled."
msgstr "Đã huỷ xác thực."

msgid "The server does not allow authentication."
msgstr "Máy chủ không cho phép xác thực."

msgid "The supplied e-mail address is already in use for another account."
msgstr "Địa chỉ e-mail đã cung cấp được một tài khoản khác sử dụng."

msgid "The supplied username is already in use for another account."
msgstr "Tên người dùng đã cung cấp được một tài khoản khác sử dụng."

#, python-format
msgid "Authentication failed: %s"
msgstr "Xác thực thất bại: %s"

msgid "The supplied user identity is already in use for another account."
msgstr "Danh tính người dùng đã cung cấp được một tài khoản khác sử dụng."

msgid "The authentication provider could not be reached."
msgstr "Không thể kết nối với nhà cung cấp xác thực."

msgid "Notification settings adjusted."
msgstr "Đã điều chỉnh cài đặt thông báo."

msgid ""
"The notification change link is no longer valid, please sign in to configure "
"notifications."
msgstr ""
"Liên kết thay đổi thông báo không còn hợp lệ, vui lòng đăng nhập để tùy "
"chỉnh thông báo."

msgid "The security key was removed."
msgstr "Khóa bảo mật đã bị gỡ bỏ."

#, python-format
msgid "The security key %s was registered."
msgstr "Khóa bảo mật %s đã được đăng ký."

msgid "The authentication app was removed."
msgstr "Ứng dụng xác thực đã bị xóa."

#, python-format
msgid "The authentication app %s was registered."
msgstr "Ứng dụng xác thực %s đã được đăng ký."

msgid "Second factor sign in"
msgstr "Đăng nhập hai bước"

msgid "Automatic translation"
msgstr "Dịch tự động"

msgid ""
"Automatically translates strings using machine translation or other "
"components."
msgstr "Tự động dịch các chuỗi sử dụng dịch máy hoặc các thành phần khác."

msgid "enabled"
msgstr "đã bật"

msgid ""
"The repository is outdated, you might not get expected results until you "
"update it."
msgstr ""
"Kho lưu trữ đã bị chậm cập nhật, bạn có thể sẽ không nhận được kết quả mong "
"muốn trừ khi bạn cập nhật nó."

msgid "JavaScript localization CDN"
msgstr "JavaScript cục bộ hóa CDN"

msgid ""
"Publishes translations into content delivery network for use in JavaScript "
"or HTML localization."
msgstr ""
"Đăng tải các bản dịch lên mạng phân phối nội dung để sử dụng trong quá trình "
"bản địa hóa JavaScript hoặc HTML."

msgid "Translation files CDN"
msgstr "CDN tập tin dịch thuật"

msgid "Publishes translation files into a content delivery network."
msgstr "Đăng tải các tệp dịch thuật lên mạng phân phối nội dung."

msgid "The translation files CDN add-on cannot publish weblate.js."
msgstr ""
"Tiện ích bổ sung CDN cho các tệp dịch thuật không thể xuất bản weblate.js."

msgid "Cleanup translation files"
msgstr "Dọn dẹp các tệp bản dịch"

msgid ""
"Update all translation files to match the monolingual base file. For most "
"file formats, this means removing stale translation keys no longer present "
"in the base file."
msgstr ""
"Cập nhật tất cả tệp dịch thuật để hợp với tệp cơ sở đơn ngữ. Cho hầu hết các "
"định dạng tệp, điều này có nghĩa là khi loại bỏ các từ khóa dịch thuật cũ sẽ "
"không còn hiện trên các tệp cơ sở nữa."

msgid "Remove blank strings"
msgstr "Xoá các chuỗi trống"

msgid "Removes strings without a translation from translation files."
msgstr "Xóa các chuỗi không có bản dịch khỏi các tệp dịch."

msgid "Reset repository to upstream"
msgstr "Đặt lại repository về thượng nguồn"

msgid "Discards all changes in the Weblate repository each night."
msgstr "Bỏ tất cả thay đổi trong Weblate repository vào mỗi đêm."

msgid "Add missing languages"
msgstr "Thêm ngôn ngữ thiếu"

msgid ""
"Ensures a consistent set of languages is used for all components within a "
"project."
msgstr ""
"Đảm bảo một bộ ngôn ngữ nhất quán dùng cho tất cả thành phần trong dự án."

msgid ""
"This add-on affects the whole project and may create translation files "
"across many components or repositories."
msgstr ""
"Tiện ích bổ sung này ảnh hưởng đến toàn bộ dự án và có thể tạo ra các tệp "
"dịch thuật trên nhiều thành phần hoặc kho lưu trữ khác nhau."

msgid ""
"This add-on affects the whole category and may create translation files "
"across many components or repositories."
msgstr ""
"Tiện ích bổ sung này ảnh hưởng đến toàn bộ danh mục và có thể tạo ra các tệp "
"dịch thuật trên nhiều thành phần hoặc kho lưu trữ."

msgid ""
"This add-on affects all projects and may create translation files across "
"many components or repositories."
msgstr ""
"Tiện ích bổ sung này ảnh hưởng đến tất cả các dự án và có thể tạo ra các tệp "
"dịch thuật trên nhiều thành phần hoặc kho lưu trữ."

msgid ""
"The given language maps to a different language. Check language aliases "
"settings."
msgstr ""
"Ngôn ngữ được cung cấp tương ứng với một ngôn ngữ khác. Vui lòng kiểm tra "
"cài đặt bí danh ngôn ngữ."

msgid "The given language is used as a source language."
msgstr "Ngôn ngữ được cung cấp được sử dụng làm ngôn ngữ nguồn."

msgid "The language filter timed out."
msgstr "Bộ lọc ngôn ngữ đã hết thời gian chờ."

msgid "The given language is filtered by the language filter."
msgstr "Ngôn ngữ được cung cấp sẽ được lọc bởi bộ lọc ngôn ngữ."

msgid "Component discovery"
msgstr "Khám phá thành phần"

msgid ""
"Automatically adds or removes project components based on file changes in "
"the version control system."
msgstr ""
"Tự động thêm hoặc bỏ đi các thành phần dự án dựa trên các sự điểu chỉnh của "
"tệp trong một phiên bản hệ thống điều khiển."

msgid "Pending"
msgstr "Đang chờ"

msgid "Success"
msgstr "Thành công"

msgid "Error"
msgstr "Lỗi"

msgid "Skipped"
msgstr "Đã bỏ qua"

msgid "The add-on is not compatible with this component."
msgstr "Tiện ích bổ sung này không tương thích với thành phần này."

msgid "There are no compatible components to process."
msgstr "Không có thành phần tương thích để xử lý."

msgid "The add-on is not scheduled to run yet."
msgstr "Tiện ích bổ sung này hiện chưa được lên lịch chạy."

msgid "There are no relevant changes to process."
msgstr "Không có thay đổi nào đáng kể đối với quy trình."

msgid "Background processing is disabled."
msgstr "Quá trình xử lý nền đã bị vô hiệu hóa."

msgid "The component is not scheduled for background processing today."
msgstr "Thành phần này không được lên lịch xử lý nền trong ngày hôm nay."

msgid "There are no eligible strings to process."
msgstr "Không có chuỗi ký tự nào đủ điều kiện để xử lý."

msgid "The target no longer exists."
msgstr "Mục tiêu không còn tồn tại nữa."

msgid "A required file is not available."
msgstr "Tệp được yêu cầu không có sẵn."

msgid "There are no outgoing commits to process."
msgstr "Hiện không có bản ghi nhận gửi đi nào cần xử lý."

msgid "The add-on does not apply to this event."
msgstr "Gói bổ sung này không áp dụng cho sự kiện này."

msgid "No source files are configured."
msgstr "Chưa có tệp nguồn nào được cấu hình."

msgid "The configured output path is invalid."
msgstr "Đường dẫn đầu ra đã cấu hình không hợp lệ."

msgid "The add-on execution failed."
msgstr "Quá trình thực thi tiện ích bổ sung đã thất bại."

msgid "Example add-on"
msgstr "Ví dụ về tiện ích bổ sung"

msgid "This add-on does nothing it is just an example."
msgstr "Add-on này không có tác dụng gì cả, nó chỉ là một ví dụ."

msgid "Execute script before commit"
msgstr "Thực thi tập lệnh trước khi ghi nhận"

msgid "This add-on executes a script."
msgstr "Add-on này sẽ thực thi một tập lệnh."

msgid "Fedora Messaging"
msgstr "Thông Báo Fedora"

msgid "Sends notifications to a Fedora Messaging compatible AMQP exchange."
msgstr ""
"Gửi thông báo đến một cơ chế trao đổi AMQP tương thích với Thông Báo Fedora."

#, python-format
msgid "Message ID: %(message_id)s"
msgstr "ID thông báo: %(message_id)s"

#, python-format
msgid ""
"Fedora Messaging publish timed out; the broker connection or delivery "
"confirmation did not complete: %(error)s"
msgstr ""
"Quá trình gửi tin nhắn Fedora đã hết thời gian chờ; lỗi kết nối với máy chủ "
"trung gian hoặc xác nhận gửi tin nhắn không hoàn tất: %(error)s"

#, python-format
msgid ""
"Fedora Messaging publisher service was unavailable; the connection will be "
"recreated on the next attempt: %(error)s"
msgstr ""
"Dịch vụ gửi tin nhắn Fedora không khả dụng; kết nối sẽ được tạo lại trong "
"lần thử tiếp theo: %(error)s"

#, python-format
msgid "Fedora Messaging broker returned the message: %(error)s"
msgstr "Dịch vụ Thông Báo Fedora trả về thông báo: %(error)s"

#, python-format
msgid "Fedora Messaging broker rejected the message: %(error)s"
msgstr "Dịch vụ Thông Báo Fedora đã từ chối thông báo: %(error)s"

#, python-format
msgid "Fedora Messaging publish failed: %(error)s"
msgstr "Gửi thông báo đến Dịch vụ Thông Báo Fedora thất bại: %(error)s"

msgid "configured"
msgstr "đã cấu hình"

msgid "Could not reset Fedora Messaging publisher service."
msgstr "Không thể đặt lại dịch vụ xuất bản tin nhắn Fedora."

msgid "CA certificates must be valid PEM encoded X.509 certificates."
msgstr "Chứng chỉ CA phải là chứng chỉ X.509 được mã hóa PEM hợp lệ."

msgid "Client SSL key must be an unencrypted PEM encoded private key."
msgstr ""
"Khóa SSL của máy khách phải là khóa riêng được mã hóa PEM mà không qua mã "
"hóa."

msgid "Client SSL certificates must be valid PEM encoded X.509 certificates."
msgstr ""
"Chứng chỉ SSL của máy khách phải là chứng chỉ X.509 được mã hóa PEM hợp lệ."

#, python-format
msgid "Fedora Messaging broker URL is invalid: %(error)s"
msgstr "URL máy trung chuyển Dịch vụ Thông Báo Fedora không hợp lệ: %(error)s"

#, python-format
msgid ""
"Could not verify TLS connection to the Fedora Messaging broker: %(error)s"
msgstr ""
"Không thể xác minh kết nối TLS với máy chủ trung chuyển Dịch vụ Thông báo "
"Fedora: %(error)s"

msgid "Flag new source strings as \"Needs checking\""
msgstr "Đánh dấu các chuỗi nguồn mới là \"Cần kiểm tra\""

msgid ""
"Whenever a new source string is imported from the VCS, it is flagged as "
"needing checking in Weblate. This way you can easily filter and edit source "
"strings written by the developers."
msgstr ""
"Bất cứ khi nào một chuỗi nguồn mới được nhập từ VCS, nó sẽ được đánh dấu là "
"cần chỉnh sửa trong Weblate. Bằng cách này, bạn có thể dễ dàng lọc và chỉnh "
"sửa các chuỗi nguồn do nhà phát triển viết."

msgid "Flag new translations as \"Needs rewriting\""
msgstr "Đánh dấu các bản dịch mới là \"Cần viết lại\""

msgid ""
"Whenever a new translatable string is imported from the VCS, it is flagged "
"as needing rewriting in Weblate. This way you can easily filter and edit "
"translations created by the developers."
msgstr ""
"Bất cứ khi nào một chuỗi dịch mới được nhập từ VCS, nó sẽ được đánh dấu là "
"cần viết lại trong Weblate. Bằng cách này, bạn có thể dễ dàng lọc và chỉnh "
"sửa các bản dịch do nhà phát triển tạo ra."

msgid "Flag unchanged translations as \"Needs rewriting\""
msgstr "Gắn cờ các bản dịch chưa thay đổi là \"Cần viết lại\""

msgid ""
"Whenever a new translatable string is imported from the VCS and it matches a "
"source string, it is flagged as needing rewriting in Weblate. Especially "
"useful for file formats that include source strings for untranslated strings."
msgstr ""
"Bất cứ khi nào một chuỗi dịch mới được nhập từ VCS và khớp với chuỗi nguồn, "
"chuỗi đó sẽ được đánh dấu là cần viết lại trong Weblate. Điều này đặc biệt "
"hữu ích cho các định dạng tệp bao gồm chuỗi nguồn cho các chuỗi chưa dịch."

msgid "Bulk edit"
msgstr "Chỉnh sửa hàng loạt"

msgid "Bulk edit flags, labels, or states of strings."
msgstr "Chỉnh sửa hàng loạt cờ, nhãn hoặc trạng thái của chuỗi."

msgid "Flag updated translations from repository as \"Needs rewriting\""
msgstr "Đánh dấu bản dịch đã cập nhật từ repository là \"Cần sửa\""

msgid ""
"Whenever a string translation is changed from the VCS, it is flagged as "
"needing rewriting in Weblate. Especially useful if translation files are "
"often updated manually or by an external service."
msgstr ""
"Bất cứ khi nào một chuỗi dịch được thay đổi từ VCS, nó sẽ được đánh dấu là "
"cần viết lại trong Weblate. Điều này đặc biệt hữu ích nếu các tệp dịch "
"thường được cập nhật thủ công hoặc bởi một dịch vụ bên ngoài."

msgid "Path of generated MO file"
msgstr "Đường dẫn của tệp MO được tạo"

msgid "If not specified, the location of the PO file will be used."
msgstr "Nếu không chỉ định, vị trí của tệp PO sẽ được sử dụng."

msgid "Include strings needing editing"
msgstr "Bao gồm các chuỗi cần chỉnh sửa"

msgid ""
"Strings needing editing (fuzzy) are typically not ready for use as "
"translations."
msgstr ""
"Các chuỗi cần chỉnh sửa (mờ) thường chưa sẵn sàng để sử dụng làm bản dịch."

msgid "Update frequency"
msgstr "Tần suất cập nhật"

msgid "Daily"
msgstr "Hằng ngày"

msgid "Weekly"
msgstr "Hàng tuần"

msgid "Monthly"
msgstr "Hàng tháng"

msgid ""
"How often the add-on should update the POT file when the component is "
"refreshed."
msgstr ""
"Tần suất cập nhật tệp POT của tiện ích bổ sung khi thành phần được làm mới "
"là bao nhiêu."

msgid "Normalize POT header"
msgstr "Tiêu đề POT bình thường"

msgid "Updates gettext headers and replaces placeholder POT comments."
msgstr "Cập nhật tiêu đề gettext và thay thế các bình luận POT giữ chỗ."

msgid "Update PO files using msgmerge"
msgstr "Cập nhật các tệp PO bằng msgmerge"

msgid ""
"Ensures the msgmerge add-on is installed and triggers it after the POT file "
"is updated."
msgstr ""
"Đảm bảo tiện ích bổ sung msgmerge được cài đặt và kích hoạt nó sau khi tệp "
"POT được cập nhật."

msgid "Source locations"
msgstr "Vị trí nguồn"

msgid "Use file format settings"
msgstr "Sử dụng cài đặt định dạng tệp"

msgid "Extract locations to the POT file"
msgstr "Trích xuất vị trí vào tệp POT"

msgid "Do not extract locations"
msgstr "Không trích xuất vị trí"

msgid ""
"Choose how extraction writes source locations to the POT file. Use this to "
"keep locations in the template while omitting them from translated PO files."
msgstr ""
"Chọn cách thức trích xuất ghi vị trí nguồn vào tệp POT. Sử dụng tùy chọn này "
"để giữ lại các vị trí trong mẫu trong khi loại bỏ chúng khỏi các tệp PO đã "
"dịch."

msgid "Do not extract comments"
msgstr "Không trích xuất bình luận"

msgid "Extract all comments"
msgstr "Trích xuất tất cả bình luận"

msgid "Extract comments with tag"
msgstr "Trích xuất bình luận có gắn thẻ"

msgid "Code comments"
msgstr "Chú thích mã"

msgid ""
"Choose whether xgettext should extract no comments, all comments, or only "
"comments marked with a specific tag."
msgstr ""
"Chọn xem xgettext có nên trích xuất không có bình luận nào, tất cả bình "
"luận, hoặc chỉ những bình luận được đánh dấu bằng một thẻ cụ thể hay không."

msgid "Comment tag"
msgstr "Thẻ bình luận"

msgid ""
"Tag passed to xgettext for comment extraction when using tagged comment mode."
msgstr ""
"Thẻ được truyền đến xgettext để trích xuất bình luận khi sử dụng chế độ bình "
"luận có gắn thẻ."

msgid "xgettext checks"
msgstr "xgettext kiểm tra"

msgid "Additional xgettext validation checks to enable for extracted messages."
msgstr ""
"Thêm các bước kiểm tra xác thực xgettext bổ sung để kích hoạt cho các tin "
"nhắn đã trích xuất."

msgid "Additional keyword"
msgstr "Từ khóa bổ sung"

msgid "Optional extra keyword passed to xgettext using --keyword."
msgstr ""
"Từ khóa bổ sung tùy chọn được truyền cho xgettext bằng cách sử dụng --"
"keyword."

msgid "Use keywords exclusively"
msgstr "Chỉ sử dụng từ khóa"

msgid ""
"When enabled, passes --keyword without a value to xgettext before the "
"additional keyword, disabling all default keywords so that only the keyword "
"specified above is recognized."
msgstr ""
"Khi được bật, tham số này sẽ truyền --keyword không có giá trị cho xgettext "
"trước từ khóa bổ sung, vô hiệu hóa tất cả các từ khóa mặc định để chỉ nhận "
"diện từ khóa được chỉ định ở trên."

msgid "This field is required."
msgstr "Trường này là bắt buộc."

msgid "An additional keyword is required when using keywords exclusively."
msgstr "Khi chỉ sử dụng từ khóa, cần thêm một từ khóa nữa."

msgid "Input source"
msgstr "Nguồn đầu vào"

msgid "Source file patterns"
msgstr "Các mẫu tệp nguồn"

msgid "POTFILES manifest"
msgstr "Tệp kê khai POTFILES"

msgid ""
"Choose whether xgettext should read source files from glob patterns or from "
"a POTFILES/POTFILES.in manifest."
msgstr ""
"Chọn xem xgettext nên đọc các tệp nguồn từ các mẫu glob hay từ tệp kê khai "
"POTFILES/POTFILES.in."

msgid "xgettext language"
msgstr "ngôn ngữ xgettext"

msgid ""
"Programming language passed to xgettext, for example Python or C. Leave "
"blank to let xgettext guess the language from file extensions."
msgstr ""
"Ngôn ngữ lập trình được truyền cho xgettext, ví dụ như Python hoặc C. Để "
"trống để xgettext tự động đoán ngôn ngữ từ phần mở rộng tệp."

msgid ""
"Newline-separated repository-relative glob patterns for files to extract "
"with xgettext."
msgstr ""
"Các mẫu glob tương đối với kho lưu trữ được phân tách bằng dấu xuống dòng "
"dùng để trích xuất tệp bằng xgettext."

msgid "POTFILES path"
msgstr "Đường dẫn POTFILES"

msgid ""
"Repository-relative path to POTFILES or POTFILES.in. Entries are resolved "
"relative to the repository root. If present next to the manifest, "
"POTFILES.skip excludes listed files from extraction."
msgstr ""
"Đường dẫn tương đối so với kho lưu trữ đến POTFILES hoặc POTFILES.in. Các "
"mục được giải quyết tương đối so với thư mục gốc của kho lưu trữ. Nếu có mặt "
"bên cạnh tệp kê khai, POTFILES.skip sẽ loại trừ các tệp được liệt kê khỏi "
"quá trình giải nén."

msgid "Invalid symbolic link in a repository."
msgstr "Liên kết tượng trưng không hợp lệ trong kho lưu trữ."

msgid "POTFILES path has to point to a file."
msgstr "Đường dẫn POTFILES phải trỏ đến một tệp."

msgid "Meson preset"
msgstr "Cài đặt sẵn Meson"

msgid "GLib"
msgstr "GLib"

msgid ""
"Built-in xgettext argument preset matching Meson gettext integration. The "
"GLib preset adds the keyword and format-flag options used by Meson's gettext "
"helper."
msgstr ""
"Thiết lập sẵn đối số xgettext tích hợp phù hợp với tích hợp gettext của "
"Meson. Thiết lập sẵn GLib bổ sung các tùy chọn từ khóa và cờ định dạng được "
"sử dụng bởi trình trợ giúp gettext của Meson."

msgid ""
"The Meson add-on expects a Meson gettext directory with meson.build and "
"POTFILES or POTFILES.in."
msgstr ""
"Tiện ích bổ sung Meson yêu cầu thư mục Meson gettext với các tệp meson.build "
"và POTFILES hoặc POTFILES.in."

msgid "The component has to define a gettext template for new translations."
msgstr "Thành phần này cần định nghĩa một mẫu gettext cho các bản dịch mới."

msgid ""
"The Django add-on expects the template for new translations to be named "
"\"django.pot\", \"djangojs.pot\", \"django.po\", or \"djangojs.po\"."
msgstr ""
"Tiện ích bổ sung Django yêu cầu mẫu cho các bản dịch mới phải được đặt tên "
"là \"django.pot\", \"djangojs.pot\", \"django.po\" hoặc \"djangojs.po\"."

msgid "Filtering"
msgstr "Lọc"

msgctxt "None filtering"
msgid "None"
msgstr "Không"

msgid "Weblate documentation"
msgstr "Tài liệu Weblate"

msgid ""
"Optionally remove strings that are not useful to translate after Sphinx "
"extraction."
msgstr ""
"Tùy chọn loại bỏ các chuỗi không hữu ích cho việc dịch sau khi trích xuất "
"bằng Sphinx."

msgid ""
"The Sphinx add-on expects the template for new translations to be a .pot "
"file."
msgstr ""
"Tiện ích bổ sung Sphinx dự kiến mẫu cho các bản dịch mới sẽ là tệp .pot."

msgid ""
"The Sphinx add-on expects the template for new translations to live in a "
"\"locales\" directory."
msgstr ""
"Tiện ích bổ sung Sphinx mong đợi mẫu cho các bản dịch mới sẽ nằm trong thư "
"mục \"ngôn ngữ\"."

msgid "Could not determine Sphinx source directory."
msgstr "Không thể xác định thư mục nguồn Sphinx."

msgid "Name of generated file"
msgstr "Tên của tệp được tạo"

msgid "Content of generated file"
msgstr "Nội dung của tệp được tạo"

msgid "Commit squashing"
msgstr "Hợp nhất bản ghi nhận"

msgid "All commits into one"
msgstr "Tất cả bản ghi nhận thành một"

msgid "Per language"
msgstr "Theo ngôn ngữ"

msgid "Per file"
msgstr "Theo tập tin"

msgid "Per author"
msgstr "Theo tác giả"

msgid "Append trailers to squashed commit message"
msgstr "Thêm phần cuối vào thông điệp của bản ghi nhận"

msgid ""
"Trailer lines are lines that look similar to RFC 822 e-mail headers, at the "
"end of the otherwise free-form part of a commit message, such as 'Co-"
"authored-by: …'."
msgstr ""
"Dòng cuối phía sau là những dòng trông giống với tiêu đề email RFC 822, nằm "
"ở cuối phần tự do của thông điệp của bản ghi nhận, chẳng hạn như 'Co-"
"authored-by: …'."

msgid "Commit message"
msgstr "Thông điệp bản ghi nhận"

msgid ""
"This commit message will be used instead of the combined commit messages "
"from the squashed commits."
msgstr ""
"Thông báo bản ghi nhận này sẽ được sử dụng thay cho các thông báo bản ghi "
"nhận đã kết hợp từ các bản ghi nhận đã bị nén."

msgid "Days to keep"
msgstr "Số ngày để giữ"

msgid "Voting threshold"
msgstr "Ngưỡng bầu chọn"

msgid ""
"Threshold for removal. Leave empty to remove suggestions regardless of "
"votes. This field has no effect with voting turned off."
msgstr ""
"Ngưỡng để xoá. Để trống để xóa đề xuất bất kể phiếu bầu. Trường này không có "
"hiệu lực khi bình chọn bị tắt."

msgid "I confirm the above actions look correct"
msgstr "Tôi xác nhận các thao tác trên đều chính xác"

msgid "Please review and confirm the missing language changes."
msgstr "Vui lòng xem xét và xác nhận những thay đổi ngôn ngữ còn thiếu."

msgid "Regular expression to match translation files against"
msgstr "Biểu thức chính quy để khớp với các tệp dịch"

msgid ""
"The regular expression must define named groups for component and language."
msgstr ""
"Biểu thức chính quy phải định nghĩa các nhóm được đặt tên cho thành phần và "
"ngôn ngữ."

msgid "File format"
msgstr "Định dạng tệp"

msgid "Customize the component name"
msgstr "Tuỳ biến tên thành phần"

msgid "Use Django template syntax. This template must include {{ component }}."
msgstr "Sử dụng cú pháp mẫu Django. Mẫu này phải bao gồm {{ component }}."

msgid "Define the monolingual base filename"
msgstr "Xác định tên tệp cơ sở đơn ngữ"

msgid ""
"Leave empty for bilingual translation files. When set, this template must "
"include {{ component }}."
msgstr ""
"Để trống đối với các tệp dịch song ngữ. Khi được thiết lập, mẫu này phải bao "
"gồm {{ component }}."

msgid "Define the base file for new translations"
msgstr "Xác định tệp cơ sở cho bản dịch mới"

msgid ""
"Filename of file used for creating new translations. For gettext choose .pot "
"file. This template must include {{ component }}."
msgstr ""
"Tên tệp tin được sử dụng để tạo bản dịch mới. Đối với gettext, hãy chọn "
"tệp .pot. Mẫu này phải bao gồm {{ component }}."

msgid "Intermediate language file"
msgstr "Tệp ngôn ngữ trung gian"

msgid ""
"Filename of intermediate translation file. In most cases this is a "
"translation file provided by developers and is used when creating actual "
"source strings. This template must include {{ component }}."
msgstr ""
"Tên tệp của tệp dịch trung gian. Trong hầu hết các trường hợp, đây là tệp "
"dịch do nhà phát triển cung cấp và được sử dụng khi tạo chuỗi nguồn thực tế. "
"Mẫu này phải bao gồm {{ component }}."

msgid "Language filter"
msgstr "Lọc ngôn ngữ"

msgid ""
"Regular expression to filter translation files against when scanning for "
"file mask."
msgstr "Biểu thức chính quy để lọc các tệp dịch khi quét mẫu tên tệp."

msgid "Clone add-ons from the main component to the newly created ones"
msgstr ""
"Nhân bản các tiện ích bổ sung từ thành phần chính sang các tiện ích mới tạo"

msgid "Remove components for inexistent files"
msgstr "Xóa các thành phần cho các tập tin không tồn tại"

msgid "I confirm the above matches look correct"
msgstr "Tôi xác nhận các kết quả khớp trên có vẻ chính xác"

#, python-format
msgid "Generic preset: %(name)s [%(details)s]"
msgstr "Cài đặt sẵn chung: %(name)s [%(details)s]"

msgid "format not preset"
msgstr "định dạng chưa được thiết lập trước"

#, python-format
msgid "monolingual base: %(base)s"
msgstr "cơ sở đơn ngữ: %(base)s"

msgid "no monolingual base"
msgstr "không có cơ sở đơn ngữ"

#, python-format
msgid "%(format)s; %(base)s"
msgstr "%(format)s; %(base)s"

msgid "One folder per language"
msgstr "Một thư mục cho mỗi ngôn ngữ"

msgid "Matches files like cs/application.po."
msgstr "Phù hợp với các tệp như cs/application.po."

msgid "Gettext locales layout"
msgstr "Bố cục ngôn ngữ Gettext"

msgid "Matches files like locale/cs/LC_MESSAGES/application.po."
msgstr "Phù hợp với các tệp như locale/cs/LC_MESSAGES/application.po."

msgid "Complex filenames"
msgstr "Tên tập tin phức tạp"

msgid "Matches files like src/locale/application.cs.po."
msgstr "Phù hợp với các tệp như src/locale/application.cs.po."

msgid "Filename-based language variants"
msgstr "Các biến thể ngôn ngữ dựa trên tên tệp"

msgid "Matches files like news_en.md."
msgstr "Tìm các tệp có định dạng như news_en.md."

msgid "Repeated language code"
msgstr "Mã ngôn ngữ lặp lại"

msgid "Matches files like locale/cs/application/cs.po."
msgstr "Phù hợp với các tệp như like locale/cs/application/cs.po."

msgid "Split Android strings"
msgstr "Tách chuỗi Android"

msgid "Matches files like res/values-cs/strings-about.xml."
msgstr "Phù hợp với các tệp như res/values-cs/strings-about.xml."

msgid "Matching multiple paths"
msgstr "Ghép nối nhiều đường dẫn"

msgid ""
"Matches nested Java properties layouts and also fills the component name "
"template."
msgstr ""
"Khớp với bố cục thuộc tính Java lồng nhau và cũng điền vào mẫu tên thành "
"phần."

#, python-format
msgid "Detected: %(pattern)s [%(details)s]"
msgstr "Đã phát hiện: %(pattern)s [%(details)s]"

msgid "Detected from repository"
msgstr "Được phát hiện từ kho lưu trữ"

msgid "Generic presets"
msgstr "Các thiết lập sẵn chung"

msgid "You can not use a monolingual translation without a base file."
msgstr "Bạn không thể sử dụng bản dịch đơn ngữ nếu không có tệp cơ sở."

msgid "You can not use a base file for bilingual translation."
msgstr "Bạn không thể sử dụng tệp cơ sở để dịch song ngữ."

msgid "Please review and confirm the matched components."
msgstr "Vui lòng đánh giá và xác nhận các thành phần phù hợp."

msgid "This template must include {{ component }}."
msgstr "Mẫu này phải bao gồm {{ component }}."

msgid "This template must include component markup."
msgstr "Mẫu này phải bao gồm mã đánh dấu thành phần."

msgid "Translation threshold"
msgstr "Ngưỡng dịch thuật"

msgid ""
"The percentage of translated strings that must be present for translation to "
"be included."
msgstr ""
"Tỷ lệ phần trăm các chuỗi đã dịch cần phải có để bản dịch được coi là đã "
"dịch đầy đủ."

msgid "CSS selector"
msgstr "Bộ chọn CSS"

msgid "CSS selector to detect localizable elements."
msgstr "Bộ chọn CSS để phát hiện các thành phần có thể bản địa hóa."

msgid "Language cookie name"
msgstr "Tên cookie ngôn ngữ"

msgid "Name of cookie which stores language preference."
msgstr "Tên cookie lưu trữ tùy chọn ngôn ngữ."

msgid "Extract strings from HTML files"
msgstr "Trích xuất chuỗi từ các tệp HTML"

msgid ""
"List of filenames in current repository or remote URLs to parse for "
"translatable strings."
msgstr ""
"Danh sách tên tệp trong kho lưu trữ hiện tại hoặc URL từ xa để phân tích cú "
"pháp để tìm chuỗi có thể dịch được."

#, python-format
msgid "Could not parse CSS selector: %s"
msgstr "Không thể phân tích bộ chọn CSS: %s"

msgid "Source strings"
msgstr "Chuỗi nguồn"

msgid "Target translation"
msgstr "Bản dịch mục tiêu"

msgid "All strings in this translation will be overwritten"
msgstr "Tất cả các chuỗi trong bản dịch này sẽ bị ghi đè"

msgid "Prepended static text"
msgstr "Văn bản tĩnh được thêm vào trước"

msgid "Prepended variable text"
msgstr "Văn bản biến được thêm vào trước"

msgid "Appended static text"
msgstr "Đã thêm văn bản tĩnh"

msgid "Appended variable text"
msgstr "Văn bản biến được thêm vào"

msgid "Variable text multiplier"
msgstr "Biến số nhân văn bản"

msgid ""
"How many times to repeat the variable text depending on the length of the "
"source string."
msgstr ""
"Số lần lặp lại văn bản biến đổi bao nhiêu lần tùy thuộc vào độ dài của chuỗi "
"nguồn."

msgid "Include read-only strings"
msgstr "Bao gồm các chuỗi chỉ đọc"

msgid "The source and target have to be different languages."
msgstr "Nguồn và đích phải là những ngôn ngữ khác nhau."

msgid "Enable case-sensitive key sorting"
msgstr "Cho phép sắp xếp khóa phân biệt chữ hoa chữ thường"

msgid "Change events to trigger"
msgstr "Thay đổi các sự kiện để kích hoạt"

msgid "Translation content events"
msgstr "Sự kiện nội dung dịch thuật"

msgid "All change events"
msgstr "Tất cả các sự kiện thay đổi"

msgid "Selected change events"
msgstr "Các sự kiện thay đổi được chọn"

msgid "Choose which change events should trigger this add-on."
msgstr "Hãy chọn những sự kiện thay đổi nào sẽ kích hoạt tiện ích bổ sung này."

msgid "Webhook URL"
msgstr "URL Webhook"

msgid "Webhook secret"
msgstr "Webhook bí mật"

msgid "The Standard Webhooks secret is a base64 encoded string."
msgstr "Mã bí mật Webhook Tiêu Chuẩn là một chuỗi base64 được mã hóa."

msgid "AMQP broker URL"
msgstr "URL máy trung gian AMQP"

msgid "The AMQP broker URL to connect to."
msgstr "URL của máy trung gian AMQP cần kết nối."

msgid "Topic prefix"
msgstr "Tiền tố chủ đề"

msgid "Optional prefix to prepend to generated message topics."
msgstr "Tiền tố tùy chọn để thêm vào đầu các chủ đề thông báo được tạo ra."

msgid "CA certificate bundle (PEM)"
msgstr "Gói chứng chỉ CA (PEM)"

msgid ""
"Paste only PEM certificate blocks, each starting with \"-----BEGIN "
"CERTIFICATE-----\" and ending with \"-----END CERTIFICATE-----\"."
msgstr ""
"Chỉ dán các khối chứng chỉ PEM, mỗi khối bắt đầu bằng \"-----BEGIN "
"CERTIFICATE-----\" và kết thúc bằng \"-----END CERTIFICATE-----\"."

msgid "Client private key (PEM)"
msgstr "Khóa riêng tư máy khách (PEM)"

msgid ""
"Paste a single unencrypted PEM private key block. Encrypted private keys are "
"not supported."
msgstr ""
"Dán một khối khóa riêng PEM không mã hóa. Khóa riêng đã mã hóa không được hỗ "
"trợ."

msgid "Client certificate (PEM)"
msgstr "Chứng chỉ máy khách(PEM)"

msgid ""
"Paste only the PEM certificate block starting with \"-----BEGIN "
"CERTIFICATE-----\"; do not paste the output from \"openssl x509 -text\"."
msgstr ""
"Chỉ dán khối chứng chỉ PEM bắt đầu bằng \"-----BEGIN CERTIFICATE-----\"; "
"không dán kết quả từ lệnh \"openssl x509 -text\"."

msgid "Publish timeout"
msgstr "Thời gian chờ xuất bản"

msgid "How many seconds to wait for the broker delivery acknowledgement."
msgstr ""
"Cần chờ bao nhiêu giây để nhận được xác nhận giao hàng từ máy chủ trung gian."

msgid "Connection attempts"
msgstr "Các lần thử kết nối"

msgid "How many times to try connecting to the broker."
msgstr "Cần thử kết nối với máy chủ trung chuyển bao nhiêu lần."

msgid "Retry delay"
msgstr "Độ trễ thử lại"

msgid "How many seconds to wait between connection attempts."
msgstr "Cần chờ bao nhiêu giây giữa các lần thử kết nối."

msgid "Topic prefix can contain only ASCII characters."
msgstr "Tiền tố chủ đề chỉ có thể chứa các ký tự ASCII."

#, python-format
msgid "Topic prefix must not exceed %(limit)d characters."
msgstr "Tiền tố chủ đề không được vượt quá %(limit)d ký tự."

msgid "The SSL certificates have to be provided for SSL connection."
msgstr "Cần phải cung cấp chứng chỉ SSL để thiết lập kết nối SSL."

msgid "The SSL certificates are not used without a SSL connection."
msgstr "Chứng chỉ SSL sẽ không được sử dụng nếu không có kết nối SSL."

msgid "Statistics generator"
msgstr "Trình tạo số liệu thống kê"

msgid "Generates a file containing detailed info about the translation status."
msgstr "Tạo một tệp chứa thông tin chi tiết về trạng thái bản dịch."

msgid "Pseudolocale generation"
msgstr "Tạo ảo ngữ"

msgid ""
"Generates a translation by adding prefix and suffix to source strings "
"automatically."
msgstr "Tạo bản dịch bằng cách tự động thêm tiền tố và hậu tố vào chuỗi nguồn."

msgid "Prefill translation with source"
msgstr "Điền trước bản dịch với nguồn"

msgid "Fills in translation strings with source string."
msgstr "Điền chuỗi bản dịch bằng chuỗi nguồn."

msgid "Fill read-only strings with source"
msgstr "Điền chuỗi chỉ đọc bằng nguồn"

msgid "Fills in translation of read-only strings with source string."
msgstr "Điền vào bản dịch của chuỗi chỉ đọc bằng chuỗi nguồn."

msgid "Generate MO files"
msgstr "Tạo tệp MO"

msgid "Automatically generates a MO file for every changed PO file."
msgstr "Tự động tạo tệp MO cho mỗi tệp PO đã thay đổi."

msgid "Update LINGUAS file"
msgstr "Cập nhật tệp LINGUAS"

msgid "Updates the LINGUAS file when a translation is added or removed."
msgstr "Cập nhật tệp LINGUAS khi có bản dịch được thêm hoặc xóa."

msgid "Update ALL_LINGUAS variable in the \"configure\" file"
msgstr "Cập nhật biến ALL_LINGUAS trong tệp \"cấu hình\""

msgid ""
"Updates the ALL_LINGUAS variable in \"configure\", \"configure.in\" or "
"\"configure.ac\" files, when a translation is added or removed."
msgstr ""
"Cập nhật biến ALL_LINGUAS trong các tệp \"configure\", \"configure.in\" hoặc "
"\"configure.ac\" khi một bản dịch được thêm hoặc xóa."

msgid "Update PO files to match POT (msgmerge)"
msgstr "Cập nhật các tệp PO để phù hợp với POT (msgmerge)"

msgid ""
"Updates all PO files (as configured by \"File mask\") to match the POT file "
"(as configured by \"Template for new translations\") using msgmerge."
msgstr ""
"Cập nhật tất cả các tệp PO (được cấu hình bởi \"Mặt nạ tệp\") để khớp với "
"tệp POT (được cấu hình bởi \"Mẫu cho bản dịch mới\") bằng msgmerge."

msgid "Update POT file (xgettext)"
msgstr "Cập nhật tệp POT (xgettext)"

msgid "Updates the gettext template using xgettext on selected source files."
msgstr ""
"Cập nhật mẫu gettext bằng cách sử dụng xgettext trên các tệp nguồn đã chọn."

msgid "Update POT file (Meson)"
msgstr "Cập nhật tệp POT (Meson)"

msgid "Updates the gettext template using Meson gettext conventions."
msgstr "Cập nhật mẫu gettext bằng cách sử dụng các quy ước gettext của Meson."

msgid "Update gettext template (Django)"
msgstr "Cập nhật mẫu gettext (Django)"

msgid ""
"Updates the gettext template using Django's built-in makemessages command."
msgstr ""
"Cập nhật mẫu gettext bằng cách sử dụng lệnh makemessages tích hợp sẵn của "
"Django."

msgid "Update POT file (Sphinx)"
msgstr "Cập nhật tệp POT (Sphinx)"

msgid ""
"Updates the gettext template using Sphinx's gettext builder without loading "
"project configuration."
msgstr ""
"Cập nhật mẫu gettext bằng trình tạo gettext của Sphinx mà không cần tải cấu "
"hình dự án."

msgid "Contributors in comment"
msgstr "Những người đóng góp trong bình luận"

msgid ""
"Updates the comment part of the PO file header to include contributor names "
"and years of contributions."
msgstr ""
"Cập nhật phần bình luận của tiêu đề tệp PO để bao gồm tên người đóng góp và "
"năm đóng góp."

msgid "Squash Git commits"
msgstr "Hợp nhất các bản ghi nhận Git"

msgid "Squash Git commits prior to pushing changes."
msgstr ""
"Hợp nhất các bản ghi nhận Git trước khi đẩy các thay đổi lên kho lưu trữ."

msgid "This add-on cannot be triggered manually."
