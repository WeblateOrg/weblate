msgid "iOS-Device"
msgstr "Thiết Bị iOS"

msgid "Account activity"
msgstr "Hoạt động tài khoản"

#, python-brace-format
msgid "Triggered by {username}."
msgstr "Được kích hoạt bởi {username}."

msgid "Interface Language"
msgstr "Ngôn ngữ giao diện"

msgid "Translated languages"
msgstr "Ngôn ngữ đã dịch"

msgid ""
"Choose the languages you can translate to. These will be offered to you on "
"the dashboard for easier access to your chosen translations."
msgstr ""
"Chọn các ngôn ngữ bạn có thể dịch ra. Chúng sẽ được hiện lên cho bạn trên "
"bảng điều khiển để truy cập dễ hơn vào những bản dịch đã chọn của bạn."

msgid "Secondary languages"
msgstr "Ngôn ngữ phụ"

msgid ""
"Choose languages you can understand, strings in those languages will be "
"shown in addition to the source string."
msgstr ""
"Chọn các ngôn ngữ bạn có thể hiểu, những chuỗi ở các ngôn ngữ đó sẽ được "
"hiện thêm vào chuỗi nguồn."

msgid "Theme"
msgstr "Chủ đề"

msgid "Hide completed translations on the dashboard"
msgstr "Ẩn các bản dịch đã hoàn thành trên bảng điều khiển"

msgid "Show secondary translations in the Zen mode"
msgstr "Hiện các bản dịch phụ trong chế độ Zen"

msgid "Hide source if a secondary translation exists"
msgstr "Ẩn nguồn nếu một bản dịch phụ đang tồn tại"

msgid "Show all columns in lists using horizontal scrolling"
msgstr "Hiển thị tất cả các cột trong danh sách bằng cách cuộn ngang"

msgid ""
"Instead of hiding columns on narrow screens, keep all columns and scroll the "
"table horizontally."
msgstr ""
"Thay vì ẩn các cột trên màn hình hẹp, hãy giữ nguyên tất cả các cột và cuộn "
"bảng theo chiều ngang."

msgid "Editor link"
msgstr "Liên kết trình chỉnh sửa"

msgid ""
"Enter a custom URL to be used as link to the source code. You can use "
"{{branch}} for branch, {{filename}} and {{line}} as filename and line "
"placeholders."
msgstr ""
"Nhập một URL tuỳ chỉnh sẽ được sử dụng làm liên kết đến mã nguồn. Bạn có thể "
"dùng {{branch}} cho nhánh, {{filename}} và {{line}} làm tên tệp và giữ chỗ "
"cho dòng."

msgid "Translation editor mode"
msgstr "Chế độ chỉnh sửa bản dịch"

msgid "Full editor"
msgstr "Trình chỉnh sửa đầy đủ"

msgid "Zen mode"
msgstr "Chế độ Zen"

msgid "Zen editor mode"
msgstr "Chế độ chỉnh sửa Zen"

msgid "Top to bottom"
msgstr "Trên xuống dưới"

msgid "Side by side"
msgstr "Bên cạnh nhau"

msgid "Special characters"
msgstr "Kí tự đặc biệt"

msgid ""
"You can specify additional special visual keyboard characters to be shown "
"while translating. It can be useful for characters you use frequently, but "
"are hard to type on your keyboard."
msgstr ""
"Bạn có thể chỉ định các ký tự bổ sung của bàn phím trực quan đặc biệt sẽ "
"được hiển thị trong khi dịch. Nó có thể hữu ích cho các ký tự bạn sử dụng "
"thường xuyên nhưng khó gõ trên bàn phím của bạn."

msgid "Number of nearby strings"
msgstr "Số lượng chuỗi lân cận"

msgid "Number of nearby strings to show in each direction in the full editor."
msgstr ""
"Số lượng chuỗi ký tự lân cận cần hiển thị theo mỗi hướng trong trình chỉnh "
"sửa đầy đủ."

