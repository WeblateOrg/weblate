msgid "Translator persona"
msgstr "Vai trò người dịch"

msgid ""
"Describe the persona of translator to improve the accuracy of the "
"translation. For example: “You are a squirrel breeder.”"
msgstr ""
"Mô tả vai trò của người dịch để nâng cao độ chính xác của bản dịch. Ví dụ: "
"“Bạn là người nuôi sóc.”"

msgctxt "Automatic suggestion service configuration"
msgid "Translator style"
msgstr "Phong cách phiên dịch"

msgid ""
"Describe the style of translation. For example: “Use informal language.”"
msgstr ""
"Hãy mô tả phong cách dịch thuật. Ví dụ: “Sử dụng ngôn ngữ không trang trọng.”"

msgctxt "Automatic suggestion service configuration"
msgid "Language-specific instructions"
msgstr "Hướng dẫn cụ thể theo ngôn ngữ"

#, python-format
msgid ""
"JSON object mapping existing target language codes to extra instructions, up "
"to %(limit)d characters each."
msgstr ""
"Ánh xạ đối tượng JSON tới các mã ngôn ngữ đích hiện có thành các hướng dẫn "
"bổ sung, mỗi hướng dẫn có tối đa %(limit)d ký tự."

msgid "Language-specific instructions must be a JSON object."
msgstr "Các hướng dẫn dành riêng cho từng ngôn ngữ phải là một đối tượng JSON."

#, python-format
msgid "Language-specific instructions contain invalid language code \"%s\"."
msgstr ""
"Hướng dẫn dành riêng cho từng ngôn ngữ chứa mã ngôn ngữ không hợp lệ \"%s\"."

#, python-format
msgid "Language-specific instructions contain unknown language code \"%s\"."
msgstr ""
"Hướng dẫn dành riêng cho từng ngôn ngữ có chứa mã ngôn ngữ không xác định "
"\"%s\"."

#, python-format
msgid ""
"Language-specific instructions for \"%(language)s\" must be at most "
"%(limit)d characters."
msgstr ""
"Các hướng dẫn dành riêng cho từng ngôn ngữ đối với \"%(language)s\" phải có "
"tối đa %(limit)d ký tự."

