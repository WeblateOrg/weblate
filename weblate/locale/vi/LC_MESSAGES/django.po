msgctxt "No known user"
msgid "None"
msgstr "Không có"

msgid "User avatar"
msgstr "Ảnh đại diện người dùng"

msgid ""
"This e-mail address is already in use. Please supply a different e-mail "
"address."
msgstr "Địa chỉ email đã được sử dụng. Vui lòng cung cấp địa chỉ email khác."

msgid "This username is already taken. Please pick something else."
msgstr "Tên người dùng này đã được sử dụng. Xin hãy chọn cái khác."

msgid "Full name"
msgstr "Tên đầy đủ"

msgid "Name is also used in version control commits."
msgstr "Tên cũng được sử dụng trong các bản ghi nhận kiểm soát phiên bản."

msgid "Commit e-mail"
msgstr "Email bản ghi nhận"

msgid "Use account e-mail address"
msgstr "Dùng địa chỉ email tài khoản"

msgid ""
"Used in version-control commits. The address stays in the repository forever "
"once changes are committed by Weblate."
msgstr ""
"Dùng cho các bản ghi nhận quản lý phiên bản. Địa chỉ này sẽ được lưu trữ "
"vĩnh viễn trong kho lưu trữ sau khi Weblate ghi nhận các thay đổi."

msgid "Commit name"
msgstr "Tên bản ghi nhận"

msgid ""
"Used in version control commits. The name stays in the repository forever, "
"once changes are committed by Weblate."
msgstr ""
"Dùng cho các bản ghi nhận quản lý phiên bản. Tên này sẽ được lưu giữ vĩnh "
"viễn trong kho lưu trữ sau khi Weblate ghi nhận các thay đổi."

msgid "Public e-mail"
msgstr "Email công khai"

msgid "Hide e-mail address from public view"
msgstr "Không hiển thị địa chỉ email công khai"

#, python-format
msgid "Component list: %s"
msgstr "Danh sách thành phần: %s"

msgid "Account e-mail"
msgstr "Email của tài khoản"

msgid ""
"Used for e-mail notifications and as a commit e-mail if it is not configured "
"below."
msgstr ""
"Dùng cho email thông báo và email bản ghi nhận nếu không được cấu hình bên "
"dưới."

msgid "Human verification"
msgstr "Xác nhận con người"

#, python-format
msgctxt ""
"Question for a mathematics-based CAPTCHA, the %s is an arithmetic problem"
msgid "What is %s?"
msgstr "%s là gì?"

#. Translators: Shown on wrong answer to the mathematics-based CAPTCHA
msgid "That was not correct, please try again."
msgstr "Câu trả lời không chính xác, vui lòng thử lại."

msgid "Validation failed, please try again."
msgstr "Xác thực thất bại, vui lòng thử lại."

msgid "Subject"
msgstr "Tiêu đề"

msgid "Your name"
msgstr "Tên của bạn"

msgid "Your e-mail"
msgstr "Email của bạn"

msgid "Message"
msgstr "Tin nhắn"

msgid ""
"Please contact us in English. Otherwise, we might not process your request."
msgstr ""
"Vui lòng liên hệ với chúng tôi bằng tiếng Anh. Nếu không, chúng tôi có thể "
"sẽ không xử lý yêu cầu của bạn."

msgid "E-mail"
msgstr "E-mail"

msgid "An e-mail with a confirmation link will be sent here."
msgstr "Một email có liên kết xác nhận sẽ được gửi đến đây."

msgid "New password"
msgstr "Mật khẩu mới"

msgid "New password confirmation"
msgstr "Xác nhận mật khẩu mới"

msgid "Regenerate API key"
msgstr "Tạo khóa API"

msgid ""
"Leave enabled to revoke the current API key and generate a new one. This is "
"recommended if you suspect your password was compromised. Disable it to keep "
"your current API key active after changing your password."
msgstr ""
"Hãy để tùy chọn này được bật để thu hồi khóa API hiện tại và tạo khóa mới. "
"Điều này được khuyến nghị nếu bạn nghi ngờ mật khẩu của mình đã bị xâm phạm. "
"Tắt tùy chọn này để giữ cho khóa API hiện tại hoạt động sau khi thay đổi mật "
"khẩu."

msgid "Your password has been changed."
msgstr "Mật khẩu của bạn đã được cập nhật."

msgid "Current password"
msgstr "Mật khẩu hiện tại"

msgid "Leave empty if you have not set a password yet."
msgstr "Để trống nếu bạn chưa đặt mật khẩu."

msgid "You have entered an invalid password."
msgstr "Mật khẩu không đúng."

msgid "Username or e-mail"
msgstr "Tên người dùng hoặc email"

msgid "Password"
msgstr "Mật khẩu"

msgid "Please enter the correct username and password."
msgstr "Vui lòng nhập tên người dùng và mật khẩu đúng."

msgid "This account is inactive."
msgstr "Tài khoản này không hoạt động."

msgid "Component wide notifications"
msgstr "Thông báo trên toàn bộ thành phần"

msgid "Translation notifications"
msgstr "Thông báo bản dịch"

msgid "Use default setting"
msgstr "Dùng cài đặt mặc định"

msgid "Other projects"
msgstr "Các dự án khác"

msgid "Watched projects"
msgstr "Các dự án đã theo dõi"

msgid "Managed projects"
msgstr "Các dự án đã quản lý"

msgid "Project: {}"
msgstr "Dự án: {}"

msgid "Component: {}"
msgstr "Thành phần: {}"

msgid ""
"You will receive a notification for every such event in non-watched projects."
msgstr ""
"Bạn sẽ nhận một thông báo cho mỗi sự việc như vậy trong các dự án không được "
"theo dõi."

msgid ""
"You will receive a notification for every such event in your watched "
"projects."
msgstr ""
"Bạn sẽ nhận một thông báo cho mỗi sự việc như vậy trong các dự án đã theo "
"dõi của bạn."

msgid ""
"You will receive a notification for every such event in projects where you "
"have admin permissions."
msgstr ""
"Bạn sẽ nhận một thông báo cho mỗi sự việc như vậy trong các dự án mà bạn có "
"quyền quản trị viên."

#, python-format
msgid "You will receive a notification for every such event in %(project)s."
msgstr "Bạn sẽ nhận một thông báo cho mỗi sự việc như vậy trong %(project)s."

#, python-format
msgid "You will receive a notification for every such event in %(component)s."
msgstr "Bạn sẽ nhận một thông báo cho mỗi sự việc như vậy trong %(component)s."

msgid ""
"You will only receive these notifications for your translated languages in "
"non-watched projects."
msgstr ""
"Bạn sẽ chỉ nhận các thông báo này cho các ngôn ngữ đã dịch của bạn trong các "
"dự án không được theo dõi."

msgid ""
"You will only receive these notifications for your translated languages in "
"your watched projects."
msgstr ""
"Bạn sẽ chỉ nhận các thông báo này cho các ngôn ngữ đã dịch của bạn trong các "
"dự án đã theo dõi của bạn."

msgid ""
"You will only receive these notifications for your translated languages in "
"projects where you have admin permissions."
msgstr ""
"Bạn sẽ chỉ nhận các thông báo này cho các ngôn ngữ đã dịch của bạn trong các "
"dự án mà bạn có quyền quản trị viên."

#, python-format
msgid ""
"You will only receive these notifications for your translated languages in "
"%(project)s."
msgstr ""
"Bạn sẽ chỉ nhận các thông báo này cho các ngôn ngữ đã dịch của bạn trong "
"%(project)s."

#, python-format
msgid ""
"You will only receive these notifications for your translated languages in "
"%(component)s."
msgstr ""
"Bạn sẽ chỉ nhận các thông báo này cho các ngôn ngữ đã dịch của bạn trong "
"%(component)s."

msgid "Username"
msgstr "Tên người dùng"

msgid "Date joined"
msgstr "Ngày tham gia"

msgid "Translations made"
msgstr "Các bản dịch đã tạo"

msgid "Suggestions made"
msgstr "Các đề xuất đã đưa ra"

msgid "Comments made"
msgstr "Bình luận đã tạo"

msgid "Screenshots uploaded"
msgstr "Các ảnh chụp màn hình đã tải lên"

msgid "The chosen sorting is not supported."
msgstr "Không hỗ trợ cách sắp xếp đã chọn."

msgid "Team"
msgstr "Nhóm"

msgid "Add to a team"
msgstr "Thêm vào nhóm"

msgid "Name your authentication app"
msgstr "Đặt tên cho ứng dụng xác thực của bạn"

msgid "Verify the code from the app"
msgstr "Xác minh mã từ ứng dụng"

msgid "Discard previously configured authentication apps"
msgstr "Loại bỏ các ứng dụng xác thực đã được cấu hình trước đó"

msgid ""
"All previously configured authentication apps will be discarded upon "
"verification of the new app."
msgstr ""
"Tất cả các ứng dụng xác thực đã được cấu hình trước đó sẽ bị loại bỏ sau khi "
"ứng dụng mới được xác minh."

msgid ""
"Other two-factor methods (such as WebAuthn and security keys) won't be "
"affected."
msgstr ""
"Các phương thức xác thực 2 yếu tố khác (chẳng hạn như WebAuthn và mã key bảo "
"mật) sẽ không bị ảnh hưởng."

msgid "The entered token is not valid."
msgstr "Mã token đã nhập không hợp lệ."

msgid "Recovery token"
msgstr "Mã token khôi phục"

msgid ""
"Recovery codes can only be used once. Remember to mark used ones as expired."
msgstr ""
"Mã khôi phục chỉ có thể dùng một lần. Nhớ đánh dấu cái đã dùng rồi là hết "
"hạn."

msgid "Enter the code from the app"
msgstr "Nhập mã từ ứng dụng"

#. Translators: Audit log entry
msgid "Password changed."
msgstr "Mật khẩu đã được thay đổi."

#. Translators: Audit log entry
#, python-brace-format
msgid "Rate limit exceeded for {scope} at {path}."
msgstr "Đã vượt quá giới hạn số lượt truy cập cho {scope} tại {path}."

#. Translators: Audit log entry
#, python-brace-format
msgid "Username changed from {old} to {new}."
msgstr "Tên người dùng đã thay đổi từ {old} thành {new}."

#. Translators: Audit log entry
#, python-brace-format
msgid "E-mail changed from {old} to {new}."
msgstr "E-mail đã thay đổi từ {old} thành {new}."

#. Translators: Audit log entry
#, python-brace-format
msgid "Full name changed from {old} to {new}."
msgstr "Tên đầy đủ đã thay đổi từ {old} thành {new}."

#. Translators: Audit log entry
msgid "Password reset requested."
msgstr "Đã yêu cầu đặt lại mật khẩu."

#. Translators: Audit log entry
msgid "Password reset confirmed, password turned off."
msgstr "Đã xác nhận đặt lại mật khẩu, mật khẩu đã được tắt."

#. Translators: Audit log entry
#, python-brace-format
msgid "Configured sign in using {method} ({name})."
msgstr "Đã thiết lập đăng nhập bằng {method} ({name})."

#. Translators: Audit log entry
#, python-brace-format
msgid "Removed sign in using {method} ({name})."
msgstr "Đã xoá đăng nhập bằng {method} ({name})."

#. Translators: Audit log entry
#, python-brace-format
msgid "Signed in using {method} ({name})."
msgstr "Đã đăng nhập bằng {method} ({name})."

#. Translators: Audit log entry
#, python-brace-format
msgid "Signed in using {method} ({name}) from a new device."
msgstr "Đã đăng nhập bằng {method} ({name}) từ một thiết bị mới."

#. Translators: Audit log entry
msgid "Somebody attempted to register with your e-mail."
msgstr "Ai đó đã cố gắng đăng ký bằng e-mail của bạn."

msgid "Somebody attempted to register using your e-mail address."
msgstr "Ai đó đã cố gắng đăng ký bằng địa chỉ email của bạn."

#. Translators: Audit log entry
#, python-brace-format
msgid "Could not sign in using {method} ({name})."
msgstr "Không thể đăng nhập bằng {method} ({name})."

#. Translators: Audit log entry
msgid "Account locked due to many failed sign in attempts."
msgstr "Tài khoản đã bị khoá vì nhiều lần thử đăng nhập thất bại."

#. Translators: Audit log entry
msgid "Account locked by the site administrator."
msgstr "Tại khoản đã bị khóa bởi quản trị viên của trang."

#. Translators: Audit log entry
msgid "Account and all private data removed."
msgstr "Đã xoá tài khoản và tất cả dữ liệu riêng tư."

#. Translators: Audit log entry
#, python-brace-format
msgid "Account removal confirmation sent to {email}."
msgstr "Xác nhận hủy bỏ tài khoản đã được gửi đến {email}."

#. Translators: Audit log entry
#, python-brace-format
msgid "Agreement with General Terms and Conditions {date}."
msgstr "Đồng ý với Điều khoản và Điều kiện Tổng quát {date}."

#. Translators: Audit log entry
#, python-brace-format
msgid "Invited to {site_title} by {username}."
msgstr "Được mời đến {site_title} bởi {username}."

#. Translators: Audit log entry
#, python-brace-format
msgid "Accepted invitation from {username}."
msgstr "Chấp nhận lời mời từ {username}."

#. Translators: Audit log entry
msgid "Started trial period."
msgstr "Đã bắt đầu khoảng thời gian dùng thử."

#. Translators: Audit log entry
#, python-brace-format
msgid "Sent confirmation mail to {email}."
msgstr "Đã gửi mail xác nhận đến {email}."

msgid ""
"The system created a user to track authorship of translations uploaded by "
"other user."
msgstr ""
"Hệ thống đã tạo một người dùng để theo dõi quyền tác giả của các bản dịch do "
"người dùng khác tải lên."

msgid ""
"Account created externally from weblate.org for access to purchased services."
msgstr ""
"Tài khoản được tạo bên ngoài trang weblate.org để truy cập các dịch vụ đã "
"mua."

#. Translators: Audit log entry
#, python-brace-format
msgid "Access to project {project} was blocked."
msgstr "Truy cập vào dự án {project} đã bị chặn."

#. Translators: Audit log entry
msgid "User was enabled by administrator."
msgstr "Người dùng được quản trị viên kích hoạt."

#. Translators: Audit log entry
msgid "User was disabled by administrator."
msgstr "Người dùng đã bị quản trị viên vô hiệu hóa."

msgid "User was disabled because the access has expired."
msgstr "Người dùng bị vô hiệu hóa vì quyền truy cập đã hết hạn."

#, python-brace-format
msgid "User was added to the site-wide {team} team by {username}."
msgstr "Người dùng được thêm vào nhóm {team} site-wide bởi {username}."

#, python-brace-format
msgid "User access to the site-wide {team} team was changed by {username}."
msgstr ""
"Quyền truy cập của người dùng vào nhóm {team} trên toàn trang web đã được "
"{username} thay đổi."

#, python-brace-format
msgid "User was removed from the site-wide {team} team by {username}."
msgstr "Người dùng đã bị xóa khỏi nhóm {team} site-wide bởi {username}."

#. Translators: Audit log entry
msgid "Superuser privileges granted."
msgstr "Đã cấp quyền Superuser."

#. Translators: Audit log entry
msgid "Superuser privileges revoked."
msgstr "Quyền quản trị viên cấp cao đã bị thu hồi."

#. Translators: Audit log entry
msgid "Semiannual support status review was displayed."
msgstr "Đánh giá tình trạng hỗ trợ nửa năm được hiển thị."

#. Translators: Audit log entry
#, python-brace-format
msgid "User was added to the {team} team by {username}."
msgstr "Người dùng được thêm vào nhóm {team} bởi {username}."

#, python-brace-format
msgid "User access to the {team} team was changed by {username}."
msgstr ""
"Quyền truy cập của người dùng vào nhóm {team} đã được {username} thay đổi."

#. Translators: Audit log entry
#, python-brace-format
msgid "User was removed from the {team} team by {username}."
msgstr "Người dùng đã bị xóa khỏi nhóm {team} bởi {username}."

#. Translators: Audit log entry
#, python-brace-format
msgid "Project token for {project} was created."
msgstr "Mã thông báo dự án cho {project} đã được tạo."

#. Translators: Audit log entry
#, python-brace-format
msgid "Project token for {project} was removed."
msgstr "Mã thông báo dự án cho {project} đã bị xóa."

msgid "Two-factor authentication recovery codes were generated"
msgstr "Mã khôi phục xác thực 2 yếu tố đã được khởi tạo"

msgid "Two-factor authentication recovery codes were viewed"
msgstr "Mã khôi phục xác thực 2 yếu tố đã được xem lại"

#. Translators: Audit log entry
#, python-brace-format
msgid "Two-factor authentication added: {device}"
msgstr "Xác thực 2 yếu tố đã được thêm vào: {device}"

#. Translators: Audit log entry
#, python-brace-format
msgid "Two-factor authentication removed: {device}"
msgstr "Xác thực 2 yếu tố đã được hủy bỏ: {device}"

#. Translators: Audit log entry
#, python-brace-format
msgid "Two-factor authentication sign in using {device}"
msgstr "Đăng nhập qua xác thực 2 yếu tố sử dụng {device}"

#, python-brace-format
msgid "Two-factor authentication failed using {device_type}"
msgstr "Xác thực hai yếu tố thất bại khi dùng {device_type}"

#. Translators: Audit log entry
msgid "Configured password to sign in."
msgstr "Đã thiết lập mật khẩu để đăng nhập."

#. Translators: Audit log entry
msgid "Signed in using password."
msgstr "Đã đăng nhập bằng mật khẩu."

#. Translators: Audit log entry
msgid "Signed in using password from a new device."
msgstr "Đã đăng nhập bằng mật khẩu từ một thiết bị mới."

#. Translators: Audit log entry
msgid "Could not sign in using password."
msgstr "Không thể đăng nhập bằng mật khẩu."

#. Translators: Audit log entry
#, python-brace-format
msgid "Invited to {project} by {username}."
msgstr "Được mời đến {project} bởi {username}."

#. Translators: Audit log entry
msgid "Password configured."
msgstr "Mật khẩu đã thay đổi."

msgid "To restore access to your account, please reset your password."
msgstr ""
"Để khôi phục quyền truy cập vào tài khoản của bạn, vui lòng đặt lại mật khẩu."

msgid "Please contact project maintainers if you feel this is inappropriate."
msgstr ""
"Vui lòng liên hệ với những người duy trì dự án nếu bạn cảm thấy điều này "
"không phù hợp."

msgid "If it was you, reset your password to regain access to your account."
msgstr ""
"Nếu đó là bạn, hãy đặt lại mật khẩu để lấy lại quyền truy cập vào tài khoản "
"của mình."

