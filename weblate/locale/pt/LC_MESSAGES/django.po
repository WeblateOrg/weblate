msgstr "Usar a licença de tradução configurada na categoria ou projeto."

msgid ""
"Contributor license agreement which needs to be approved before a user can "
"translate this component."
msgstr ""
"Acordo da licença do colaborador(a) que tem de ser aprovado antes de um "
"utilizador possa traduzir este componente."

msgid ""
"Use the contributor license agreement configured in the category or project."
msgstr ""
"Utilizar a licença de acordo de contribuidor configurado na categoria ou "
"projeto."

msgid ""
"Use the adding new translations setting configured in the category or "
"project."
msgstr ""
"Usar a definição de adicionar novas traduções configurada na categoria ou "
"projeto."

msgid "Use the language code style configured in the category or project."
msgstr "Usar o estilo de código de idioma configurado na categoria ou projeto."

