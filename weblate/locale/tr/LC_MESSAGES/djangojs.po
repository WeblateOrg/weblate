msgstr "Sunucu yanıtı geçersiz"

msgid ""
"Accepting the suggestions takes longer than expected, reload the page to see "
"the result."
msgstr ""
"Önerilerin kabul edilmesi beklenenden uzun sürüyor. Sonucu görmek için "
"sayfayı yeniden yükleyin."

#, javascript-format
msgid "Server error (%s)"
msgstr "Sunucu sorunu (%s)"

