msgid "Added %s."
msgstr "%s eklendi."

#, javascript-format
msgid "Removed %s."
msgstr "%s kaldırıldı."

#, javascript-format
msgid "Moved %s."
msgstr "%s taşındı."

msgid ""
"An action running on the whole component needs a query. Enter one or pick "
"another scope."
msgstr ""
"Tüm bileşen üzerinde yapılan bir işlem için bir sorgu gereklidir. Bir sorgu "
"yazın ya da başka bir kapsam seçin."

msgid "Security token missing. Please reload the page."
msgstr "Güvenlik kodu eksik. Lütfen sayfayı yeniden yükleyin."

#, javascript-format
msgid "Loading suggestion count for %s"
msgstr "%s için öneri sayısı yükleniyor"

