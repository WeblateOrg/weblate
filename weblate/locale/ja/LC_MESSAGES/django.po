msgstr ""

msgid "Input source"
msgstr "入力ソース"

msgid "Source file patterns"
msgstr "原文ファイルのパターン"

msgid "POTFILES manifest"
msgstr "POTFILES マニフェスト"

msgid ""
"Choose whether xgettext should read source files from glob patterns or from "
"a POTFILES/POTFILES.in manifest."
msgstr ""
"xgettext が原文ファイルを、glob パターンから読み込むか、POTFILES / "
"POTFILES.in マニフェストから読み込むかを選択します。"

