#, python-format
msgid "The confirmation link will expire after %(count)s hour."
msgid_plural "The confirmation link will expire after %(count)s hours."
msgstr[0] "Строк дії посилання підтвердження завершується за %(count)s годину."
msgstr[1] "Строк дії посилання підтвердження завершується за %(count)s години."
msgstr[2] "Строк дії посилання підтвердження завершується за %(count)s годин."
msgstr[3] "Строк дії посилання підтвердження завершується за %(count)s годину."

msgid "Request a new confirmation link if it expires."
msgstr ""
"Запит нового посилання для підтвердження, якщо термін його дії завершується."

