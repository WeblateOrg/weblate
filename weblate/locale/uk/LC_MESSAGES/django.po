#: weblate/accounts/avatar.py:91
msgctxt "No known user"
msgid "None"
msgstr "Невідомо"

#: weblate/accounts/avatar.py:118 weblate/templates/accounts/profile.html:432
#: weblate/templates/accounts/user.html:20 weblate/templates/base.html:338
#: weblate/templates/snippets/user-list.html:15
msgid "User avatar"
msgstr "Аватар користувача"

#: weblate/accounts/forms.py:100
msgid ""
"This e-mail address is already in use. Please supply a different e-mail "
"address."
msgstr ""
"Ця адреса електронної пошти вже використовується. Будь ласка, надайте іншу "
"адресу електронної пошти."

#: weblate/accounts/forms.py:132
msgid "This username is already taken. Please pick something else."
msgstr "Це ім'я користувача вже зайняте. Виберіть щось інше."

#: weblate/accounts/forms.py:145 weblate/accounts/forms.py:1088
#: weblate/auth/models.py:821 weblate/auth/models.py:1969
#: weblate/templates/auth/team.html:126 weblate/templates/manage/users.html:60
#: weblate/templates/trans/project-access.html:59
msgid "Full name"
msgstr "Повне ім’я"

#: weblate/accounts/forms.py:147
msgid "Name is also used in version control commits."
msgstr ""
"Ім'я буде також використано у записах внески системи керування версіями."

#: weblate/accounts/forms.py:212 weblate/accounts/models.py:997
msgid "Commit e-mail"
msgstr "е-пошта для внеску"

#: weblate/accounts/forms.py:213 weblate/accounts/models.py:1344
msgid "Use account e-mail address"
msgstr "Адреса е-пошти облікового запису"

#: weblate/accounts/forms.py:215
msgid ""
"Used in version-control commits. The address stays in the repository forever "
"once changes are committed by Weblate."
msgstr ""
"Використовується в комітах контролю версій. Адреса залишається в репозиторії "
"назавжди, коли Weblate вносить зміни."

#: weblate/accounts/forms.py:222 weblate/accounts/models.py:1008
msgid "Commit name"
msgstr "Ім'я коміту"

#: weblate/accounts/forms.py:225
msgid ""
"Used in version control commits. The name stays in the repository forever, "
"once changes are committed by Weblate."
msgstr ""
"Використовується в комітах контролю версій. Ім'я залишається в репозиторії "
"назавжди, після того як зміни були зафіксовані Weblate."

#: weblate/accounts/forms.py:251 weblate/accounts/models.py:991
msgid "Public e-mail"
msgstr "Загальнодоступна ел. пошта"

#: weblate/accounts/forms.py:252 weblate/accounts/models.py:1360
msgid "Hide e-mail address from public view"
msgstr "Приховати адресу електронної пошти від загального перегляду"

#: weblate/accounts/forms.py:368
#, python-format
msgid "Component list: %s"
msgstr "Списки складників: %s"

#: weblate/accounts/forms.py:395
msgid "Account e-mail"
msgstr "Електронна адреса облікового запису"

#: weblate/accounts/forms.py:397
msgid ""
"Used for e-mail notifications and as a commit e-mail if it is not configured "
"below."
msgstr ""
"Використовується для сповіщень електронною поштою та як електронна пошта для "
"внесків, якщо вона не налаштована нижче."

#: weblate/accounts/forms.py:475
msgid "Human verification"
msgstr "Людська перевірка"

#: weblate/accounts/forms.py:546
#, python-format
msgctxt ""
"Question for a mathematics-based CAPTCHA, the %s is an arithmetic problem"
msgid "What is %s?"
msgstr "Скільки буде %s?"

#. Translators: Shown on wrong answer to the mathematics-based CAPTCHA
#: weblate/accounts/forms.py:565
msgid "That was not correct, please try again."
msgstr "Відповідь неправильна. Будь ласка, спробуйте знову."

#: weblate/accounts/forms.py:579 weblate/accounts/forms.py:586
#: weblate/accounts/forms.py:594 weblate/accounts/forms.py:605
msgid "Validation failed, please try again."
msgstr "Помилка перевірки, повторіть спробу."

#: weblate/accounts/forms.py:624
msgid "Subject"
msgstr "Тема"

#: weblate/accounts/forms.py:627
msgid "Your name"
msgstr "Ваше ім’я"

#: weblate/accounts/forms.py:629
msgid "Your e-mail"
msgstr "Ваша електронна пошта"

#: weblate/accounts/forms.py:631 weblate/templates/manage/performance.html:28
#: weblate/templates/manage/performance.html:81
#: weblate/trans/models/announcement.py:236
msgid "Message"
msgstr "Повідомлення"

#: weblate/accounts/forms.py:634
msgid ""
"Please contact us in English. Otherwise, we might not process your request."
msgstr ""
"Будь ласка, зв'яжіться з нами англійською мовою. Інакше ми можемо не "
"обробити ваш запит."

#: weblate/accounts/forms.py:659 weblate/accounts/templatetags/authnames.py:34
#: weblate/auth/models.py:827 weblate/auth/models.py:1986
#: weblate/templates/accounts/user.html:253
#: weblate/templates/manage/users.html:61
#: weblate/templates/trans/project-access.html:61 weblate/utils/fields.py:40
#: weblate/wladmin/forms.py:58
msgid "E-mail"
msgstr "Електронна пошта"

#: weblate/accounts/forms.py:660
msgid "An e-mail with a confirmation link will be sent here."
msgstr "Сюди буде надіслано електронний лист із посиланням для підтвердження."

#: weblate/accounts/forms.py:723
msgid "New password"
msgstr "Новий пароль"

#: weblate/accounts/forms.py:728
msgid "New password confirmation"
msgstr "Підтвердження нового пароля"

#: weblate/accounts/forms.py:732 weblate/templates/accounts/profile.html:570
#: weblate/templates/accounts/user.html:457
msgid "Regenerate API key"
msgstr "Повторно створити ключ API"

#: weblate/accounts/forms.py:734
msgid ""
"Leave enabled to revoke the current API key and generate a new one. This is "
"recommended if you suspect your password was compromised. Disable it to keep "
"your current API key active after changing your password."
msgstr ""
"Увімкніть цю опцію, щоб скасувати чинний ключ API та згенерувати новий. Це "
"рекомендується зробити, якщо ви підозрюєте, що ваш пароль потрапив до чужих "
"рук. Вимкніть цю опцію, щоб чинний ключ API залишився активним після зміни "
"пароля."

#: weblate/accounts/forms.py:770
msgid "Your password has been changed."
msgstr "Ваш пароль змінено."

#: weblate/accounts/forms.py:784
msgid "Current password"
msgstr "Поточний пароль"

#: weblate/accounts/forms.py:785
msgid "Leave empty if you have not set a password yet."
msgstr "Залиште порожнім, якщо ви ще не встановили пароль."

#: weblate/accounts/forms.py:799
msgid "You have entered an invalid password."
msgstr "Ви ввели неправильний пароль."

#: weblate/accounts/forms.py:812
msgid "Username or e-mail"
msgstr "Імʼя користувача або електронна пошта"

#: weblate/accounts/forms.py:813 weblate/accounts/templatetags/authnames.py:33
msgid "Password"
msgstr "Пароль"

#: weblate/accounts/forms.py:818
msgid "Please enter the correct username and password."
msgstr "Введіть правильне ім’я користувача та пароль."

#: weblate/accounts/forms.py:820
msgid "This account is inactive."
msgstr "Цей обліковий запис не активний."

#: weblate/accounts/forms.py:939
msgid "Component wide notifications"
msgstr "Сповіщення про перекладацькі складники"

#: weblate/accounts/forms.py:944
msgid "Translation notifications"
msgstr "Сповіщення з перекладу"

#: weblate/accounts/forms.py:963
msgid "Use default setting"
msgstr "Використовувати типове значення"

#: weblate/accounts/forms.py:995
msgid "Other projects"
msgstr "Інші проєкти"

#: weblate/accounts/forms.py:997 weblate/accounts/models.py:913
#: weblate/templates/accounts/profile.html:102
#: weblate/templates/accounts/user.html:174
msgid "Watched projects"
msgstr "Відстежувані проєкти"

#: weblate/accounts/forms.py:999 weblate/accounts/models.py:886
#: weblate/templates/accounts/user.html:171
#: weblate/templates/dashboard/user.html:41
msgid "Managed projects"
msgstr "Керовані проєкти"

#: weblate/accounts/forms.py:1001
msgid "Project: {}"
msgstr "Проєкт: {}"

#: weblate/accounts/forms.py:1002
msgid "Component: {}"
msgstr "Складник: {}"

#: weblate/accounts/forms.py:1008
msgid ""
"You will receive a notification for every such event in non-watched projects."
msgstr ""
"Ви отримуватимете сповіщення про кожну з цих подій у проєктах, за якими ви "
"не стежите."

#: weblate/accounts/forms.py:1013
msgid ""
"You will receive a notification for every such event in your watched "
"projects."
msgstr ""
"Ви отримуватимете сповіщення про кожну з цих подій у відстежуваних проєктах."

#: weblate/accounts/forms.py:1018
msgid ""
"You will receive a notification for every such event in projects where you "
"have admin permissions."
msgstr ""
"Ви отримуватимете сповіщення про кожну подію у проєктах, де у вас є права "
"доступу адміністратора."

#: weblate/accounts/forms.py:1023
#, python-format
msgid "You will receive a notification for every such event in %(project)s."
msgstr "Ви будете отримувати повідомлення про кожну таку подію у %(project)s."

#: weblate/accounts/forms.py:1026
#, python-format
msgid "You will receive a notification for every such event in %(component)s."
msgstr ""
"Ви будете отримувати повідомлення про кожну таку подію у %(component)s."

#: weblate/accounts/forms.py:1033
msgid ""
"You will only receive these notifications for your translated languages in "
"non-watched projects."
msgstr ""
"Ви отримуватимете ці сповіщення лише для мов, якими ви перекладаєте, у "
"проєктах, за якими ви не стежите."

#: weblate/accounts/forms.py:1038
msgid ""
"You will only receive these notifications for your translated languages in "
"your watched projects."
msgstr ""
"Ви отримуватимете ці сповіщення лише для мов, на які ви перекладаєте у "
"відстежуваних вами проєктах."

#: weblate/accounts/forms.py:1043
msgid ""
"You will only receive these notifications for your translated languages in "
"projects where you have admin permissions."
msgstr ""
"Ви отримуватимете ці сповіщення лише для ваших мов перекладу у проєктах, де "
"ви маєте права адміністратора."

#: weblate/accounts/forms.py:1048
#, python-format
msgid ""
"You will only receive these notifications for your translated languages in "
"%(project)s."
msgstr ""
"Ви отримуватимете ці сповіщення лише для ваших мов перекладу в %(project)s."

#: weblate/accounts/forms.py:1052
#, python-format
msgid ""
"You will only receive these notifications for your translated languages in "
"%(component)s."
msgstr ""
"Ви отримуватимете ці сповіщення лише для ваших мов перекладу в %(component)s."

#: weblate/accounts/forms.py:1087 weblate/auth/models.py:808
#: weblate/auth/models.py:1960 weblate/templates/auth/team.html:125
#: weblate/templates/manage/users.html:59
#: weblate/templates/trans/project-access.html:58 weblate/utils/forms.py:93
msgid "Username"
msgstr "Імʼя користувача"

#: weblate/accounts/forms.py:1089 weblate/auth/models.py:856
#: weblate/trans/forms.py:1760
msgid "Date joined"
msgstr "Дата приєднання"

#: weblate/accounts/forms.py:1090
msgid "Translations made"
msgstr "Зроблені переклади"

#: weblate/accounts/forms.py:1091
msgid "Suggestions made"
msgstr "Зроблені пропозиції"

#: weblate/accounts/forms.py:1092
msgid "Comments made"
msgstr "Додано коментарі"

#: weblate/accounts/forms.py:1093
msgid "Screenshots uploaded"
msgstr "Знімки вивантажено"

#: weblate/accounts/forms.py:1117 weblate/screenshots/forms.py:242
msgid "The chosen sorting is not supported."
msgstr "Вибране сортування не підтримується."

#: weblate/accounts/forms.py:1134 weblate/auth/forms.py:321
#: weblate/auth/models.py:1979 weblate/templates/accounts/profile.html:448
#: weblate/templates/accounts/user.html:334
#: weblate/templates/trans/project-access-team-form.html:13
msgid "Team"
msgstr "Команда"

#: weblate/accounts/forms.py:1151
msgid "Add to a team"
msgstr "Додати до команди"

#: weblate/accounts/forms.py:1165
msgid "Name your authentication app"
msgstr "Назва вашої програми для розпізнавання"

#: weblate/accounts/forms.py:1168
msgid "Verify the code from the app"
msgstr "Перевірити код з програми"

#: weblate/accounts/forms.py:1184
msgid "Discard previously configured authentication apps"
msgstr "Відхилити раніше налаштовані програми автентифікації"

#: weblate/accounts/forms.py:1188
msgid ""
"All previously configured authentication apps will be discarded upon "
"verification of the new app."
msgstr ""
"Усі раніше налаштовані програми автентифікації будуть відхилені після "
"перевірки нової програми."

#: weblate/accounts/forms.py:1191
msgid ""
"Other two-factor methods (such as WebAuthn and security keys) won't be "
"affected."
msgstr ""
"Інші двофакторні методи (такі як WebAuthn та ключі безпеки) залишаться в "
"силі."

#: weblate/accounts/forms.py:1198
msgid "The entered token is not valid."
msgstr "Введений маркер недійсний."

#: weblate/accounts/forms.py:1268
msgid "Recovery token"
msgstr "Жетон відновлення"

#: weblate/accounts/forms.py:1270
msgid ""
"Recovery codes can only be used once. Remember to mark used ones as expired."
msgstr ""
"Коди відновлення можна використати лише один раз. Не забудьте позначити "
"використані як прострочені."

#: weblate/accounts/forms.py:1328
msgid "Enter the code from the app"
msgstr "Введіть код з програми"

#. Translators: Audit log entry
#: weblate/accounts/models.py:279
msgid "Password changed."
msgstr "Пароль змінено."

#. Translators: Audit log entry
#: weblate/accounts/models.py:281
#, python-brace-format
msgid "Rate limit exceeded for {scope} at {path}."
msgstr "Перевищено обмеження на частоту запитів для {scope} у {path}."

#. Translators: Audit log entry
#: weblate/accounts/models.py:283
#, python-brace-format
msgid "Username changed from {old} to {new}."
msgstr "Імʼя користувача було змінено з {old} на {new}."

#. Translators: Audit log entry
#: weblate/accounts/models.py:285
#, python-brace-format
msgid "E-mail changed from {old} to {new}."
msgstr "Е-пошту змінено з {old} на {new}."

#. Translators: Audit log entry
#: weblate/accounts/models.py:287
#, python-brace-format
msgid "Full name changed from {old} to {new}."
msgstr "Повну назву було змінено з {old} на {new}."

#. Translators: Audit log entry
#: weblate/accounts/models.py:289
msgid "Password reset requested."
msgstr "Подано запит на відновлення пароля."

#. Translators: Audit log entry
#: weblate/accounts/models.py:291
