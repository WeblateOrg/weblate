msgid "No unused strings were found in the translation file."
msgstr "У файлі перекладу не знайдено невикористаних рядків."

msgid "Removing obsolete strings is not supported for this file format."
msgstr ""
"Для цього формату файлів не передбачено підтримки вилучення застарілих "
"рядків."

msgid "No obsolete strings were found in the translation file."
msgstr "У файлі перекладу не знайдено застарілих рядків."

