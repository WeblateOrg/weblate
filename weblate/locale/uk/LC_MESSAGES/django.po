#, python-brace-format
msgid "Unmatched HTML end tag: {tag}."
msgstr "Невідповідний кінцевий теґ HTML: {tag}."

#: weblate/checks/fluent/inner_html.py:300
#, python-brace-format
msgid "The HTML {name} void element should not have an end tag: {end}."
msgstr ""
"Порожній елемент HTML {name} не повинен мати завершального теґу: {end}."

#: weblate/checks/fluent/inner_html.py:313
#, python-brace-format
msgid ""
"The HTML {name} element is not a known void element, so should not have a "
"self-closing tag: {self_close}."
msgstr ""
"Елемент HTML {name} є невідомим порожнім елементом, отже, не повинен мати "
"самозавершального теґу: {self_close}."

