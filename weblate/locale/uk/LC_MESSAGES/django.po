#, python-brace-format
msgid "The HTML {tag} tag is missing a matching end tag: {end}."
msgstr "Теґ HTML {tag} не має відповідного завершального теґу: {end}."

#: weblate/checks/fluent/inner_html.py:343
#, python-brace-format
msgid ""
"The sequence {sequence} will begin an HTML character reference, but does not "
