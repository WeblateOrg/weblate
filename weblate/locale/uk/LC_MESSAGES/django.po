msgstr "Спочатку вилучіть з'єднані облікові записи."

#: weblate/templates/vcs/github_installation_list.html:75
#: weblate/vcs/github.py:478
msgid "App ID"
msgstr "Ід. програми"

#: weblate/templates/vcs/github_installation_list.html:79
msgid "Slug"
msgstr "Ідентифікатор"

#: weblate/templates/vcs/github_installation_list.html:101
