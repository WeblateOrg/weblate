msgstr "Засоби"

msgid "Resolved comment"
msgstr "Вирішений коментар"

msgid "Source string comment"
msgstr "Коментар до початкового рядка"

msgid "Translation comment"
msgstr "Коментар до перекладу"

msgid "Resolve"
msgstr "Вирішити"

msgid "Mark as spam"
msgstr "Позначити як спам"

msgid "This service is installed site wide."
msgstr "Цю службу встановлено на рівні сайта."

