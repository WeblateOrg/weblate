msgid ""
"A pull or merge request will be created from a branch in the repository."
msgstr "З гілки цього сховища буде створено запит на злиття або об'єднання."

msgid ""
"A push URL is set but no push branch is given. Set a push branch that "
"differs from the translated branch."
msgstr ""
"Вказано адресу для запису, але не вказано гілки. Встановіть гілку для "
"запису, яка відрізняється від гілки перекладу."

msgid ""
"The push branch must differ from the translated branch when creating a pull "
"or merge request."
msgstr ""
"Гілка запису має відрізнятися від гілки перекладу при створенні запиту на "
"злиття або об'єднання."

msgid "A pull or merge request will be created from a fork of the repository."
msgstr "Запит щодо злиття або об'єднання буде створено з відгалуження сховища."

#, javascript-format
msgid ""
"A pull or merge request will be created from the “%s” branch in the "
"repository."
msgstr "Запит щодо злиття або об'єднання буде створено з гілки «%s» сховища."

#, javascript-format
msgid ""
"Changes will be sent as a Gerrit review request targeting the “%s” branch."
msgstr ""
"Зміни буде надіслано як запит щодо рецензування Gerrit з призначенням для "
"гілки «%s»."

msgid "Changes will be sent as a Gerrit review request."
msgstr "Зміни буде надіслано як запит щодо рецензування Gerrit."

msgid ""
"Changes will not be pushed automatically. You can still push them manually "
"from the repository maintenance."
msgstr ""
"Зміни не буде записано автоматично. Втім, ви зможете записати їх вручну зі "
"сторінки супроводу сховища."

#, javascript-format
msgid ""
"Changes will be pushed directly to the “%s” branch in the push repository."
msgstr ""
"Зміни буде записано безпосередньо до гілки «%s» у сховищі для записування."

msgid ""
"Changes will be pushed directly to the default branch of the push repository."
msgstr ""
"Зміни буде записано безпосередньо до типової гілки сховища для записування."

msgid "Some source strings could not be assigned."
msgstr "Деякі початкові рядки не вдалося пов'язати."

