msgctxt "No known user"
msgid "None"
msgstr "Cap"

msgid "User avatar"
msgstr "Avatar de l’usuari"

msgid ""
"This e-mail address is already in use. Please supply a different e-mail "
"address."
msgstr ""
"Aquesta adreça de correu electrònic ja és en ús. Proporcioneu-ne una altra."

msgid "This username is already taken. Please pick something else."
msgstr "Aquest nom d’usuari ja és en ús. Trieu-ne un altre."

msgid "Full name"
msgstr "Nom complet"

msgid "Name is also used in version control commits."
msgstr "El nom també s’utilitza a les comissions del control de versions."

msgid "Commit e-mail"
msgstr "Adreça electrònica de la comissió"

msgid "Use account e-mail address"
msgstr "Utilitza l’adreça electrònica del compte"

msgid ""
"Used in version-control commits. The address stays in the repository forever "
"once changes are committed by Weblate."
msgstr ""
"S’utilitza a les comissions del control de versions. L’adreça romandrà al "
"repositori per sempre més una vegada el Weblate cometi els canvis al "
"repositori."

